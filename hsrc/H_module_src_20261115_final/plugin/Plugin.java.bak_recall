            if (!f.exists()) { toast("还没记录到群文件（收到新文件后会自动记录）"); return; }
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            final java.util.ArrayList<String> all = new java.util.ArrayList<String>();
            String ln;
            while ((ln = br.readLine()) != null) {
                if (ln.trim().length() > 0) all.add(ln);
