    /** 生成群运营日报 Markdown，返回路径 */
    private static String buildGroupDaily(String talker) {
        try {
            String gname = displayOfTalker(talker);
            long now = System.currentTimeMillis();
            long s7 = now - 7L * 86400000L;
            long s30 = now - 30L * 86400000L;

            int n7 = 0, n30 = 0, mine7 = 0, members = 0;
            for (Object[] r : queryRows("select count(*) from message where talker='" + escSql(talker)
                    + "' and createTime > " + s7, 1)) {
                try { n7 = Integer.parseInt(String.valueOf(r[0]).trim()); } catch (Throwable ignore) { }
            }
            for (Object[] r : queryRows("select count(*) from message where talker='" + escSql(talker)
                    + "' and createTime > " + s30, 1)) {
                try { n30 = Integer.parseInt(String.valueOf(r[0]).trim()); } catch (Throwable ignore) { }
            }
            for (Object[] r : queryRows("select count(*) from message where talker='" + escSql(talker)
                    + "' and createTime > " + s7 + " and isSend=1", 1)) {
                try { mine7 = Integer.parseInt(String.valueOf(r[0]).trim()); } catch (Throwable ignore) { }
            }
            for (Object[] r : queryRows("select count(distinct substr(content,1,20)) from message where talker='"
                    + escSql(talker) + "' and createTime > " + s7, 1)) {
                try { members = Integer.parseInt(String.valueOf(r[0]).trim()); } catch (Throwable ignore) { }
            }

            // 成员变动（近 7 天）
            int join = 0, quit = 0;
            try {
                java.io.File gf = new java.io.File(DIR, "group_changes.jsonl");
                if (gf.exists()) {
                    java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(gf));
                    String ln;
                    while ((ln = br.readLine()) != null) {
                        try {
                            org.json.JSONObject o = new org.json.JSONObject(ln);
                            if (!talker.equals(o.optString("talker", ""))) continue;
                            if (o.optLong("ts", 0) < s7) continue;
                            String kind = o.optString("kind", "");
                            if (kind.contains("入")) join++;
                            else if (kind.contains("退") || kind.contains("移出")) quit++;
                        } catch (Throwable ignore) { }
                    }
                    br.close();
                }
            } catch (Throwable ignore) { }

            // 高频词 top10
            java.util.LinkedHashMap<String, Integer> wm = wordFreq(talker, 7, 2000);
            java.util.List<java.util.Map.Entry<String, Integer>> wl =
                    new java.util.ArrayList<java.util.Map.Entry<String, Integer>>(wm.entrySet());
            java.util.Collections.sort(wl, new java.util.Comparator<java.util.Map.Entry<String, Integer>>() {
                @Override public int compare(java.util.Map.Entry<String, Integer> x,
                                             java.util.Map.Entry<String, Integer> y) {
                    return y.getValue() - x.getValue();
                }
            });

            // 消息类型分布（近 7 天）
            StringBuilder types = new StringBuilder();
            java.util.LinkedHashMap<String, Integer> typeAgg = new java.util.LinkedHashMap<String, Integer>();
            for (Object[] r : queryRows("select type, count(*) from message where talker='" + escSql(talker)
                    + "' and createTime > " + s7 + " group by type", 2)) {
                int tp = 0, c2 = 0;
                try { tp = Integer.parseInt(String.valueOf(r[0]).trim()); } catch (Throwable ignore) { }
                try { c2 = Integer.parseInt(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                String lb = typeLabel(tp & 0xFFFF);
                if (lb.startsWith("类型")) lb = "其它";
                Integer old2 = typeAgg.get(lb);
                typeAgg.put(lb, old2 == null ? c2 : old2 + c2);
            }
            java.util.List<java.util.Map.Entry<String, Integer>> tl =
                    new java.util.ArrayList<java.util.Map.Entry<String, Integer>>(typeAgg.entrySet());
            java.util.Collections.sort(tl, new java.util.Comparator<java.util.Map.Entry<String, Integer>>() {
                @Override public int compare(java.util.Map.Entry<String, Integer> x,
                                             java.util.Map.Entry<String, Integer> y) {
                    return y.getValue() - x.getValue();
                }
            });
            for (int ti = 0; ti < tl.size() && ti < 8; ti++) {
                types.append(tl.get(ti).getKey()).append(" ").append(tl.get(ti).getValue()).append("、");
            }

            double expect = n30 * 7.0 / 30.0;
            String trend;
            if (n30 < 10) trend = "样本太少";
            else if (n7 > expect * 1.3) trend = "升温 (+" + Math.round((n7 / expect - 1) * 100) + "%)";
            else if (n7 < expect * 0.6) trend = "降温 (-" + Math.round((1 - n7 / expect) * 100) + "%)";
            else trend = "平稳";

            StringBuilder md = new StringBuilder();
            md.append("# 群运营日报：").append(gname).append("\n\n");
            md.append("> 生成于 ").append(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm",
                    java.util.Locale.US).format(new java.util.Date(now))).append("\n\n");
            md.append("## 活跃度\n\n");
            md.append("- 近 7 天：**").append(n7).append("** 条（我发 ").append(mine7).append(" 条）\n");
            md.append("- 近 30 天：").append(n30).append(" 条\n");
            md.append("- 趋势：**").append(trend).append("**（预期 ").append(Math.round(expect)).append(" 条）\n");
            md.append("- 近 7 天发言人数（估算）：").append(members).append("\n\n");
            md.append("## 成员变动（近 7 天）\n\n");
            md.append("- 入群 ").append(join).append(" 人，退群/移出 ").append(quit).append(" 人\n");
            md.append("- 净变化 ").append(join - quit >= 0 ? "+" : "").append(join - quit).append("\n\n");
            md.append("## 高频词 Top10\n\n");
            int k = 0;
            for (java.util.Map.Entry<String, Integer> e : wl) {
                if (e.getValue() < 2) break;
                md.append("- ").append(e.getKey()).append(" ").append(e.getValue()).append("\n");
                if (++k >= 10) break;
            }
            if (k == 0) md.append("- （数据太少）\n");
            md.append("\n## 消息类型（近 7 天）\n\n");
            md.append("- ").append(types.length() == 0 ? "（无）" : types.substring(0, types.length() - 1)).append("\n");

            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            java.io.File f = new java.io.File(dir, "daily_" + gname + "_" + stamp + ".md");
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            fw.write(md.toString());
            fw.close();
            log("GDAILY|talker=" + talker + " n7=" + n7 + " n30=" + n30
                    + " join=" + join + " quit=" + quit + " path=" + f.getAbsolutePath());
            return f.getAbsolutePath();
        } catch (Throwable t) {
            log("GDAILY|err " + t);
            return null;
        }
    }

    /** 中文按 2-gram 切，英文/数字按词切；去标点与停用词 */
    private static java.util.LinkedHashMap<String, Integer> wordFreq(String talker, int days, int maxMsgs) {
        java.util.LinkedHashMap<String, Integer> map = new java.util.LinkedHashMap<String, Integer>();
        try {
            long since = System.currentTimeMillis() - (long) days * 86400000L;
            StringBuilder sql = new StringBuilder(
                    "select ifnull(content,'') from message where type=1 and createTime > " + since);
            if (talker != null && talker.length() > 0)
                sql.append(" and talker='").append(escSql(talker)).append("'");
            sql.append(" order by createTime desc limit ").append(maxMsgs);
            java.util.List<Object[]> rows = queryRows(sql.toString(), 1);
            java.util.HashSet<String> stop = new java.util.HashSet<String>();
            for (String w : new String[]{"我们", "你们", "他们", "这个", "那个", "什么", "怎么", "可以",
                    "就是", "不是", "没有", "还是", "已经", "因为", "所以", "但是", "然后", "现在",
                    "今天", "明天", "昨天", "这样", "那样", "一个", "一下", "知道", "觉得", "真的",
                    "哈哈", "呵呵", "嗯嗯", "好的", "收到"}) stop.add(w);
            for (Object[] r : rows) {
                String c = String.valueOf(r[0]);
                if (c == null || c.length() == 0) continue;
                int p1 = c.indexOf(":\n");            // 去掉群消息的 "wxid:0:0\n" 前缀
                if (p1 > 0 && p1 < 40) c = c.substring(p1 + 2);
                c = c.replaceAll("<[^>]*>", " ");      // XML 片段
                c = c.replaceAll("https?://\\S+", " ");
                StringBuilder run = new StringBuilder();
                java.util.List<String> tokens = new java.util.ArrayList<String>();
                for (int i = 0; i < c.length(); i++) {
                    char ch = c.charAt(i);
                    boolean cjk = (ch >= 0x4E00 && ch <= 0x9FFF);
                    if (cjk) { run.append(ch); continue; }
                    if (run.length() > 0) {
                        String rr = run.toString();
                        for (int k = 0; k + 1 < rr.length(); k++) tokens.add(rr.substring(k, k + 2));
                        run.setLength(0);
                    }
                    if (Character.isLetterOrDigit(ch)) {
                        int j = i;
                        StringBuilder w = new StringBuilder();
                        while (j < c.length() && Character.isLetterOrDigit(c.charAt(j))
                                && !(c.charAt(j) >= 0x4E00 && c.charAt(j) <= 0x9FFF)) {
                            w.append(c.charAt(j)); j++;
                        }
                        if (w.length() >= 2) tokens.add(w.toString().toLowerCase());
                        i = j - 1;
                    }
                }
                if (run.length() > 0) {
                    String rr = run.toString();
                    for (int k = 0; k + 1 < rr.length(); k++) tokens.add(rr.substring(k, k + 2));
                }
                for (String t : tokens) {
                    if (stop.contains(t)) continue;
                    Integer n = map.get(t);
                    map.put(t, n == null ? 1 : n + 1);
                }
            }
        } catch (Throwable t) {
            log("WORDS|err " + t);
        }
        return map;
    }

    private static void showWordCloud(final android.app.Activity a) {
        try {
            final String[] ranges = {"当前会话·近 30 天", "全部会话·近 30 天", "当前会话·近 7 天"};
            new android.app.AlertDialog.Builder(a)
                    .setTitle("高频词统计")
                    .setItems(ranges, new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int which) {
                            final String tk = (which == 1) ? "" : (chatTalker == null ? "" : chatTalker);
                            final int days = which == 2 ? 7 : 30;
                            if (which != 1 && (tk == null || tk.length() == 0)) {
                                toast("请先进入一个聊天"); return;
                            }
                            toast("统计中…");
                            new Thread(new Runnable() { @Override public void run() {
                                int n = buildWordCloud(a, tk, days);
                                log("WORDS|done n=" + n);
                            } }).start();
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) {
            toast("统计面板出错：" + t);
        }
    }

    /** 统计并展示/导出，返回词数 */
    private static int buildWordCloud(final android.app.Activity a, String talker, int days) {
        int out = 0;
        try {
            java.util.LinkedHashMap<String, Integer> map = wordFreq(talker, days, 5000);
            java.util.List<java.util.Map.Entry<String, Integer>> list =
                    new java.util.ArrayList<java.util.Map.Entry<String, Integer>>(map.entrySet());
            java.util.Collections.sort(list, new java.util.Comparator<java.util.Map.Entry<String, Integer>>() {
                @Override public int compare(java.util.Map.Entry<String, Integer> x,
                                             java.util.Map.Entry<String, Integer> y) {
                    return y.getValue() - x.getValue();
                }
            });
            java.util.List<java.util.Map.Entry<String, Integer>> top =
                    new java.util.ArrayList<java.util.Map.Entry<String, Integer>>();
            for (int i = 0; i < list.size() && i < 40; i++) {
                if (list.get(i).getValue() >= 3) top.add(list.get(i));
            }
            out = top.size();
            // 导出 CSV
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            java.io.File f = new java.io.File(dir, "words_" + stamp + ".csv");
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            fw.write("\uFEFF词,出现次数\n");
            StringBuilder show = new StringBuilder();
            for (java.util.Map.Entry<String, Integer> e : top) {
                fw.write(csv(e.getKey()) + "," + e.getValue() + "\n");
                show.append(e.getKey()).append(" ").append(e.getValue()).append("\n");
            }
            fw.close();
            askShare(f);
            log("WORDS|path=" + f.getAbsolutePath() + " n=" + out);
            if (a == null) return out;
            final String txt = show.length() == 0 ? "数据太少（至少要有 3 条以上的重复词）" : show.toString();
            final int fOut = out;
            new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                @Override public void run() {
                    new android.app.AlertDialog.Builder(a)
                            .setTitle("高频词 Top" + fOut)
                            .setMessage(txt)
                            .setPositiveButton("关闭", null)
                            .show();
                }
            });
        } catch (Throwable t) {
            log("WORDS|build err " + t);
        }
        return out;
    }

    /** 写回产品库（列表 -> 配置） */
    private static void saveProducts(java.util.List<String[]> list) {
        try {
            JSONObject o = readCfg();
            org.json.JSONArray arr = new org.json.JSONArray();
            for (String[] p : list) {
                StringBuilder v = new StringBuilder(p[0]);
                v.append('|').append(p[1] == null ? "" : p[1]);
                v.append('|').append(p[2] == null ? "" : p[2]);
                arr.put(v.toString());
            }
            o.put("products", arr);
            writeCfg(o);
            cfg = null; cfgAt = 0; cfgChkAt = 0;
            log("PRODUCT|saved n=" + list.size());
        } catch (Throwable t) {
            log("PRODUCT|err " + t);
        }
    }

    /** 新增或按名称更新 */
    private static boolean productUpsert(String name, String spec, String price) {
        if (name == null || name.trim().length() == 0) return false;
        java.util.List<String[]> list = productList();
        boolean hit = false;
        for (String[] p : list) {
            if (p[0].equals(name.trim())) {
                p[1] = spec == null ? "" : spec.trim();
                p[2] = price == null ? "" : price.trim();
                hit = true;
                break;
            }
        }
        if (!hit) list.add(new String[]{name.trim(),
                spec == null ? "" : spec.trim(), price == null ? "" : price.trim()});
        saveProducts(list);
        return true;
    }

