                .setTitle("入群欢迎语")
                .setMessage("当前：" + (on ? "开" : "关") + "\n模板：" + cfg().optString("welcomeText", "欢迎 {昵称} 加入本群 👋")
                        + "\n\n支持占位符：{昵称} {群名}")
                .setPositiveButton(on ? "关闭" : "开启", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        setOn("welcomeOn", !cfg().optBoolean("welcomeOn", false));
                        showWelcomeSetting(a);
