                        if (text.trim().length() == 0) return;
                        toast("生成中…");
                        new Thread(new Runnable() {
                            @Override public void run() {
                                final java.io.File f = renderTextPng(text);
                                a.runOnUiThread(new Runnable() {
                                    @Override public void run() {
                                        if (f == null) { toast("生成失败"); return; }
                                        askShare(f);
                                    }
                                });
                            }
                        }).start();
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static java.io.File renderTextPng(String text) {
        try {
            int W = 900;
            int pad = 48;
            android.graphics.Paint pt = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
            pt.setTextSize(34);
            pt.setColor(0xFF1A1A1E);
            pt.setTypeface(android.graphics.Typeface.DEFAULT);

            java.util.ArrayList<String> lines = new java.util.ArrayList<String>();
            for (String raw : text.split("\n")) {
                if (raw.length() == 0) { lines.add(""); continue; }
                StringBuilder cur = new StringBuilder();
                for (int i = 0; i < raw.length(); i++) {
                    char ch = raw.charAt(i);
                    cur.append(ch);
                    if (pt.measureText(cur.toString()) > W - pad * 2) {
                        cur.deleteCharAt(cur.length() - 1);
                        if (cur.length() > 0) lines.add(cur.toString());
                        cur.setLength(0);
                        cur.append(ch);
                    }
                }
                if (cur.length() > 0) lines.add(cur.toString());
            }
            int lh = (int) (pt.getFontMetrics().bottom - pt.getFontMetrics().top + 10);
            int H = pad * 2 + Math.max(1, lines.size()) * lh;
            android.graphics.Bitmap bmp = android.graphics.Bitmap.createBitmap(W, H,
                    android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas c = new android.graphics.Canvas(bmp);
            c.drawColor(0xFFFFFFFF);
            float y = pad - pt.getFontMetrics().top;
            for (String l : lines) {
                c.drawText(l, pad, y, pt);
                y += lh;
            }
            java.io.File dir = new java.io.File(android.os.Environment
                    .getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            java.io.File out = new java.io.File(dir, "text_" + System.currentTimeMillis() + ".png");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            bmp.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, fo);
            fo.close();
            bmp.recycle();
            log("T2I|ok " + out.getName() + " " + W + "x" + H);
            return out;
        } catch (Throwable t) {
            log("T2I|err " + t);
            return null;
        }
    }


