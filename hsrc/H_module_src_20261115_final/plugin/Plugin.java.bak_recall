    private static String esc(String s) {
        if (s == null) return "";
        return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
                .replace("\n", "<br>");
    }

    private static String fmt(long sec) {
        if (sec < 100000000000L) sec *= 1000L;
        java.text.SimpleDateFormat f = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
        return f.format(new java.util.Date(sec));
    }

    /** 查看微信各类缓存占用 */
    private static void showCacheInfo(final android.app.Activity a) {
        new Thread(new Runnable() {
            @Override public void run() {
                StringBuilder sb = new StringBuilder();
                String base = mmBase() + "";
                String[][] dirs = {
                        {base + "/MicroMsg", "聊天数据（含图片语音视频）"},
                        {base + "/files", "文件缓存"},
                        {base + "/cache", "缓存"},
                        {base + "/app_auth", "授权"},
                };
                long total = 0;
                for (String[] d : dirs) {
                    long sz = dirSize(new java.io.File(d[0]));
                    total += sz;
                    sb.append(d[1]).append("：").append(human(sz)).append('\n');
                }
                sb.append("\n合计：").append(human(total));
                final String msg = sb.toString();
                toast(msg);
                log("CACHE|" + msg.replace('\n', ' '));
            }
        }).start();
    }

    private static long dirSize(java.io.File f) {
        if (f == null || !f.exists()) return 0;
        if (f.isFile()) return f.length();
        java.io.File[] fs = f.listFiles();
        if (fs == null) return 0;
        long s = 0;
        for (int i = 0; i < fs.length && i < 5000; i++) s += dirSize(fs[i]);
        return s;
    }

    private static String human(long b) {
        if (b > 1024L * 1024 * 1024) return String.format("%.1f GB", b / 1073741824.0);
        if (b > 1024L * 1024) return String.format("%.1f MB", b / 1048576.0);
        return String.format("%.0f KB", b / 1024.0);
    }

    /** 群活跃度排行 */
    /** 群变动记录（过滤提醒日志） */
    private static void showGroupLog(final android.app.Activity a) {
        try {
            java.io.File f = new java.io.File(DIR, "wxh_alerts.log");
            if (!f.isFile()) { toast("还没有记录"); return; }
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.InputStreamReader(
                    new java.io.FileInputStream(f), "UTF-8"));
            java.util.ArrayList<String> keep = new java.util.ArrayList<String>();
            String line;
            while ((line = br.readLine()) != null) {
                if (line.contains("群") || line.contains("加入") || line.contains("退出")
                        || line.contains("移出") || line.contains("公告")) {
                    keep.add(line);
                    if (keep.size() > 400) keep.remove(0);
                }
            }
            br.close();
            if (keep.isEmpty()) { toast("没有群变动记录"); return; }
            StringBuilder sb = new StringBuilder();
            for (int i = keep.size() - 1; i >= 0; i--) sb.append(keep.get(i)).append('\n');
            android.widget.TextView tv = new android.widget.TextView(a);
            tv.setText(sb.toString());
            tv.setTextSize(11);
            tv.setTextColor(0xFF333333);
            tv.setPadding(dp(a, 14), dp(a, 12), dp(a, 14), dp(a, 12));
            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            sv.addView(tv);
            new android.app.AlertDialog.Builder(a)
                    .setTitle("群变动记录（" + keep.size() + " 条）")
                    .setView(sv)
                    .setPositiveButton("关闭", null)
                    .show();
        } catch (Throwable t) { toast("读取失败 " + t); }
    }

    /** 今日消息按会话统计 */
    private static void showTodayByChat(final android.app.Activity a) {
        toast("统计中…");
        new Thread(new Runnable() {
            @Override public void run() {
                StringBuilder sb = new StringBuilder();
                try {
                    java.util.Calendar cal = java.util.Calendar.getInstance();
                    cal.set(java.util.Calendar.HOUR_OF_DAY, 0);
                    cal.set(java.util.Calendar.MINUTE, 0);
                    cal.set(java.util.Calendar.SECOND, 0);
                    cal.set(java.util.Calendar.MILLISECOND, 0);
                    long todayStartMs = cal.getTimeInMillis();
                    // 微信的 createTime 有的版本是秒，有的是毫秒，先探测
                    long maxCt = 0;
                    try {
                        java.util.List<Object[]> mx = queryRows("select max(createTime) from message", 1);
                        if (!mx.isEmpty() && mx.get(0)[0] != null) {
                            maxCt = Long.parseLong(String.valueOf(mx.get(0)[0]).trim());
                        }
                    } catch (Throwable ignore) { }
                    boolean msUnit = maxCt > 100000000000L;
                    long endMs = todayStartMs + 86400000L;
                    long start = msUnit ? todayStartMs : (todayStartMs / 1000L);
                    long end = msUnit ? endMs : (endMs / 1000L);
                    log("TODAYSTAT|unit=" + (msUnit ? "ms" : "s") + " start=" + start + " max=" + maxCt);
                    java.util.List<Object[]> rows = queryRows(
                            "select talker, isSend, count(*) from message where createTime>=" + start
                                    + " and createTime<" + end
                                    + " group by talker, isSend order by count(*) desc limit 80", 3);
                    java.util.LinkedHashMap<String, int[]> per =
                            new java.util.LinkedHashMap<String, int[]>();
                    int myTotal = 0, theirTotal = 0;
                    for (Object[] r : rows) {
                        if (r[0] == null) continue;
                        String tk = String.valueOf(r[0]);
                        int isSend = 0, c = 0;
                        try { isSend = Integer.parseInt(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                        try { c = Integer.parseInt(String.valueOf(r[2]).trim()); } catch (Throwable ignore) { }
                        int[] v = per.get(tk);
                        if (v == null) { v = new int[]{0, 0}; per.put(tk, v); }
                        if (isSend == 1) { v[0] += c; myTotal += c; } else { v[1] += c; theirTotal += c; }
                    }
                    if (per.isEmpty()) {
                        sb.append("今天还没有消息");
                    } else {
                        sb.insert(0, "今日 " + (myTotal + theirTotal) + " 条\n我发 " + myTotal
                                + " 条 · 收到 " + theirTotal + " 条\n\n");
                        java.util.List<java.util.Map.Entry<String, int[]>> list =
                                new java.util.ArrayList<java.util.Map.Entry<String, int[]>>(per.entrySet());
                        java.util.Collections.sort(list,
                                new java.util.Comparator<java.util.Map.Entry<String, int[]>>() {
                                    @Override public int compare(java.util.Map.Entry<String, int[]> x,
                                                                 java.util.Map.Entry<String, int[]> y) {
                                        return (y.getValue()[0] + y.getValue()[1]) - (x.getValue()[0] + x.getValue()[1]);
                                    }
                                });
                        int shown = 0;
                        for (java.util.Map.Entry<String, int[]> e : list) {
                            if (shown++ >= 30) break;
                            int[] v = e.getValue();
                            sb.append(v[0] + v[1]).append("  ").append(resolveName(e.getKey()))
                              .append("   \u53d1").append(v[0]).append(" / \u6536").append(v[1]).append('\n');
                        }
                        // 按小时分布
                        try {
                            java.util.List<Object[]> ts = queryRows(
                                    "select createTime from message where createTime>=" + start
                                            + " and createTime<" + end + " limit 5000", 1);
                            int[] hours = new int[24];
                            for (Object[] r : ts) {
                                try {
                                    long ct = Long.parseLong(String.valueOf(r[0]).trim());
                                    if (!msUnit) ct *= 1000L;
                                    java.util.Calendar c0 = java.util.Calendar.getInstance();
                                    c0.setTimeInMillis(ct);
                                    hours[c0.get(java.util.Calendar.HOUR_OF_DAY)]++;
                                } catch (Throwable ignore) { }
                            }
                            sb.append("\n按小时：\n");
                            for (int h = 0; h < 24; h++) {
                                if (hours[h] == 0) continue;
                                sb.append(String.format("%02d", h)).append("时  ");
                                int bars = Math.min(30, hours[h] / 3 + 1);
                                for (int b = 0; b < bars; b++) sb.append('\u2591');
                                sb.append(' ').append(hours[h]).append('\n');
                            }
                        } catch (Throwable ignore) { }
                    }
                } catch (Throwable t) { sb.append("统计失败: ").append(t); }
                final String out = sb.toString();
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        android.widget.TextView tv = new android.widget.TextView(a);
                        tv.setText(out);
                        tv.setTextSize(12);
                        tv.setTextColor(0xFF333333);
                        tv.setPadding(dp(a, 14), dp(a, 12), dp(a, 14), dp(a, 12));
                        android.widget.ScrollView sv = new android.widget.ScrollView(a);
                        sv.addView(tv);
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("今日消息（我发 / 收到）")
                                .setView(sv)
                                .setPositiveButton("关闭", null)
                                .show();
                    }
                });
            }
        }).start();
    }

    /** 群活跃排行：近 30 天消息数，带成员数和最后活跃，导出 CSV */
    private static java.util.ArrayList<Object[]> buildGroupRank(String[] outPath) {
        java.util.ArrayList<Object[]> out = new java.util.ArrayList<Object[]>();
        try {
            long d30 = System.currentTimeMillis() - 30L * 86400000L;
            java.util.List<Object[]> rows = queryRows(
                    "select talker, count(*) c from message where createTime>=" + sinceRaw(d30)
                            + " and talker like '%@chatroom' group by talker order by c desc", 2);
            long d7 = System.currentTimeMillis() - 7L * 86400000L;
            java.util.HashMap<String, Integer> c7map = new java.util.HashMap<String, Integer>();
            try {
                java.util.List<Object[]> r7 = queryRows(
                        "select talker, count(*) c from message where createTime>=" + sinceRaw(d7)
                                + " and talker like '%@chatroom' group by talker", 2);
                for (Object[] a7 : r7) {
                    if (a7[0] == null) continue;
                    int n7 = 0;
                    try { n7 = Integer.parseInt(String.valueOf(a7[1])); } catch (Throwable ignore) { }
                    c7map.put(String.valueOf(a7[0]), n7);
                }
            } catch (Throwable t) { log("GRANK|7d err " + t); }

            java.util.HashMap<String, Integer> members = new java.util.HashMap<String, Integer>();
            try {
                java.util.List<Object[]> cm = queryRows(
                        "select chatroomname, ifnull(memberCount,0) from chatroom", 2);
                for (Object[] c : cm) {
                    if (c[0] == null) continue;
                    int n = 0;
                    try { n = Integer.parseInt(String.valueOf(c[1])); } catch (Throwable ignore) { }
                    members.put(String.valueOf(c[0]), n);
                }
            } catch (Throwable t) { log("GRANK|member err " + t); }
            java.util.HashMap<String, Long> lastAt = new java.util.HashMap<String, Long>();
            try {
                java.util.List<Object[]> lv = queryRows(
                        "select username, ifnull(conversationTime,0) from rconversation", 2);
                for (Object[] c : lv) {
                    if (c[0] == null) continue;
                    long v = 0;
                    try { v = ctToMs(Long.parseLong(String.valueOf(c[1]))); } catch (Throwable ignore) { }
                    lastAt.put(String.valueOf(c[0]), v);
                }
            } catch (Throwable t) { log("GRANK|last err " + t); }

            StringBuilder csv = new StringBuilder("\uFEFF排名,群名,wxid,成员数,近7天,近30天,趋势,最后活跃\n");
            java.text.SimpleDateFormat f =
                    new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US);
            int rank = 0;
            for (Object[] r : rows) {
                String tk = String.valueOf(r[0]);
                int c = 0;
                try { c = Integer.parseInt(String.valueOf(r[1])); } catch (Throwable ignore) { }
                Integer mc = members.get(tk);
                Long la = lastAt.get(tk);
                String nm = displayOfTalker(tk);
                Integer c7o = c7map.get(tk);
                int c7 = c7o == null ? 0 : c7o;
                // 按 30 天均摊出 7 天应有量，判断升温/降温
                double expect7 = c * 7.0 / 30.0;
                String trend = "平稳";
                if (expect7 >= 3 && c7 > expect7 * 1.3) trend = "升温";
                else if (expect7 >= 3 && c7 < expect7 * 0.6) trend = "降温";
                out.add(new Object[]{nm, tk, mc == null ? 0 : mc, c, la == null ? 0L : la, c7, trend});
                rank++;
                csv.append(rank).append(',').append(nm.replace(",", "，")).append(',')
                   .append(tk).append(',').append(mc == null ? 0 : mc).append(',')
                   .append(c7).append(',').append(c).append(',').append(trend).append(',')
                   .append(la != null && la > 0 ? f.format(new java.util.Date(la)) : "-").append('\n');
            }
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
            dir.mkdirs();
            java.io.File outF = new java.io.File(dir, "group_rank_"
                    + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                    .format(new java.util.Date()) + ".csv");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(outF);
            fo.write(csv.toString().getBytes("UTF-8"));
            fo.close();
            if (outPath != null && outPath.length > 0) outPath[0] = outF.getAbsolutePath();
            log("GRANK|groups=" + out.size() + " top=" + (out.isEmpty() ? "-"
                    : out.get(0)[0] + ":" + out.get(0)[3]) + " path=" + outF.getAbsolutePath());
        } catch (Throwable t) { log("GRANK|err " + t); }
        return out;
    }

    private static void showGroupRank(final android.app.Activity a) {
        new Thread(new Runnable() {
            @Override public void run() {
                final String[] path = new String[1];
                final java.util.ArrayList<Object[]> list = buildGroupRank(path);
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        StringBuilder sb = new StringBuilder();
                        int lim = Math.min(10, list.size());
                        for (int i = 0; i < lim; i++) {
                            Object[] o = list.get(i);
                            sb.append(i + 1).append(". ").append(o[0])
                              .append("（").append(o[2]).append("人） 7天 ")
                              .append(o[5]).append(" / 30天 ").append(o[3])
                              .append(o[6] != null && !"平稳".equals(o[6]) ? "  " + o[6] : "")
                              .append('\n');
                        }
                        if (list.isEmpty()) sb.append("近 30 天没有群消息");
                        sb.append("\n共 ").append(list.size()).append(" 个群\n");
                        if (path[0] != null) sb.append("已导出：\n").append(path[0]);
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("群活跃排行（近 30 天）")
                                .setMessage(sb.toString())
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    private static void applyRowBgOnly(android.view.View v) {
        if (v == null) return;
        try {
            if (!themeOn()) return;
            android.graphics.drawable.Drawable bg = v.getBackground();
            boolean can = (bg == null);
            if (bg instanceof android.graphics.drawable.ColorDrawable) {
                int c = ((android.graphics.drawable.ColorDrawable) bg).getColor();
                if ((c >>> 24) > 200 && android.graphics.Color.red(c) > 230
                        && android.graphics.Color.green(c) > 230 && android.graphics.Color.blue(c) > 230) {
                    can = true;
                }
            }
            if (can) v.setBackgroundColor(0xB3FFFFFF);
        } catch (Throwable ignore) { }
    }

