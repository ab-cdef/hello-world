                        catch (Throwable ignore) { }

                        if (idx >= 0 && idx < pgr.getChildCount()) {
                            clearBgsDeep(pgr.getChildAt(idx));
                        }
                        log("RESUME|reapply page=" + idx);
                    } catch (Throwable ignore) { }
                }
            };
            r.run();
            android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            for (long d : new long[]{150L, 500L, 1200L}) h.postDelayed(r, d);
        } catch (Throwable ignore) { }
    }

    /**
     * 内容区图片覆盖层：decor 上挂一个不可点击的 ImageView，
     * 精确限制在「顶栏下沿 ~ 底栏上沿」，绘制顺序在最上层。
