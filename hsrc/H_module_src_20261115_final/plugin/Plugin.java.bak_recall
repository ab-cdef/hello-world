    private static void runMdExport(final android.app.Activity a, final String talker, final String name) {
        toast("正在导出…");
        new Thread(new Runnable() {
            @Override public void run() {
                final String[] path = new String[1];
                final int n = exportChatMarkdown(talker, path);
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("导出完成")
                                .setMessage(n + " 条消息\n\n" + (path[0] == null ? "写入失败" : path[0]))
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    /** 把会话导出成 Markdown：按天分组，带时间/发送人，媒体用占位符 */
    private static int exportChatMarkdown(String talker, String[] outPath) {
        int n = 0;
        try {
            StringBuilder md = new StringBuilder();
            String title = displayOfTalker(talker);
            md.append("# ").append(title).append("\n\n");
            md.append("> 导出时间：")
              .append(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                      .format(new java.util.Date()))
              .append(" · 会话：`").append(talker).append("`\n\n");
            md.append("---\n\n");

            java.text.SimpleDateFormat dayF =
                    new java.text.SimpleDateFormat("yyyy-MM-dd EEEE", java.util.Locale.CHINA);
            java.text.SimpleDateFormat timeF =
                    new java.text.SimpleDateFormat("HH:mm", java.util.Locale.US);
            String lastDay = "";
            int pageSize = 5000;
            for (int off = 0; ; off += pageSize) {
                java.util.List<Object[]> rows = queryRows(
                        "select ifnull(content,''), createTime, ifnull(isSend,0), ifnull(type,0)"
                                + " from message where talker='" + escSql(talker) + "'"
                                + " order by createTime limit " + pageSize + " offset " + off, 4);
                if (rows.isEmpty()) break;
                for (Object[] r : rows) {
                    String content = r[0] == null ? "" : String.valueOf(r[0]);
                    long ct = 0;
                    try { ct = ctToMs(Long.parseLong(String.valueOf(r[1]))); } catch (Throwable ignore) { }
                    int isSend = 0, type = 0;
                    try { isSend = Integer.parseInt(String.valueOf(r[2])); } catch (Throwable ignore) { }
                    try { type = Integer.parseInt(String.valueOf(r[3])); } catch (Throwable ignore) { }
                    int base = type & 65535;

                    String sid = senderIdOfGroupMsg(content);
                    String body = content;
                    if (sid != null) {
                        int nl = content.indexOf('\n');
                        body = nl >= 0 ? content.substring(nl + 1) : "";
                    }
                    String who;
                    if (isSend != 0) who = "我";
                    else if (sid != null) {
                        who = senderName(sid);
                        if (who == null || who.length() == 0) who = displayOfTalker(sid);
                    } else who = title;

                    String day = dayF.format(new java.util.Date(ct));
                    if (!day.equals(lastDay)) {
                        md.append("\n## ").append(day).append("\n\n");
                        lastDay = day;
                    }
                    String t = timeF.format(new java.util.Date(ct));
                    String text;
                    if (base == 1) text = body.replace("\n", " ").trim();
                    else if (base == 3) text = "🖼 [图片]";
                    else if (base == 34) text = "🎤 [语音]";
                    else if (base == 43) text = "🎬 [视频]";
                    else if (base == 42) text = "👤 [名片]";
                    else if (base == 47) text = "😀 [表情]";
                    else if (base == 48) text = "📍 [位置]";
                    else if (base == 49) {
                        String title2 = cleanXmlText(tagOf(content, "title"));
                        text = "📎 [" + (title2 == null || title2.trim().length() == 0 ? "文件" : title2.trim()) + "]";
                    } else if (base == 10000) text = "· " + body.replace("\n", " ").trim();
                    else text = "[" + base + "]";

                    if (text.length() == 0) text = "[空]";
                    if (text.length() > 2000) text = text.substring(0, 2000) + "…";
                    md.append("- `").append(t).append("` **").append(who).append("**：")
                      .append(text).append('\n');
                    n++;
                }
                if (rows.size() < pageSize) break;
                if (off > 2000000) break;
            }

            java.io.File dir = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                    "Download/wxh/markdown");
            dir.mkdirs();
            java.io.File out = new java.io.File(dir, safeName(title) + "_"
                    + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                    .format(new java.util.Date()) + ".md");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            fo.write(md.toString().getBytes("UTF-8"));
            fo.close();
            if (outPath != null && outPath.length > 0) outPath[0] = out.getAbsolutePath();
            askShare(out);
            log("MD|talker=" + talker + " msgs=" + n + " path=" + out.getAbsolutePath());
        } catch (Throwable t) { log("MD|err " + t); }
        return n;
    }

    /* ================= 群成员发言明细 =================
     * 按发送人聚合：消息数 / 总字数 / 图片 / 语音 / 视频 / 文件 / 最后发言时间，导出 CSV。
     * 群消息 content 形如 "<id>:<x>:<y>\n正文"，自己发的没有前缀（用 isSend 判断）。
     */
    private static int[] memberStatsCore(String talker, String[] outPath) {
        int members = 0;
        long total = 0;
        try {
            // queryRows 内部有 5000 条上限，这里分页拉全量
            java.util.LinkedHashMap<String, long[]> agg = new java.util.LinkedHashMap<String, long[]>();
            final long[] hours = new long[24];
            int pageSize = 5000;
            for (int off = 0; ; off += pageSize) {
              java.util.List<Object[]> rows = queryRows(
                    "select ifnull(content,''), createTime, ifnull(isSend,0), ifnull(type,0)"
                            + " from message where talker='" + escSql(talker) + "'"
                            + " order by createTime limit " + pageSize + " offset " + off, 4);
              if (rows.isEmpty()) break;
              total += rows.size();
            for (Object[] r : rows) {
                String content = r[0] == null ? "" : String.valueOf(r[0]);
                long ct = 0;
                try { ct = Long.parseLong(String.valueOf(r[1])); } catch (Throwable ignore) { }
                long ctMs = ctToMs(ct);
                int isSend = 0, type = 0;
                try { isSend = Integer.parseInt(String.valueOf(r[2])); } catch (Throwable ignore) { }
                try { type = Integer.parseInt(String.valueOf(r[3])); } catch (Throwable ignore) { }
                int base = type & 65535;

                String sid = senderIdOfGroupMsg(content);
                String body = content;
                if (sid != null) {
                    int nl = content.indexOf('\n');
                    body = nl >= 0 ? content.substring(nl + 1) : "";
                } else if (isSend != 0) {
                    sid = "__self__";
                } else if (talker != null && talker.contains("@chatroom")) {
                    sid = "__unknown__";
                } else {
                    sid = talker;
                }
                long[] a2 = agg.get(sid);
                if (a2 == null) { a2 = new long[7]; agg.put(sid, a2); }
                a2[0]++;
                if (base == 1) a2[1] += body.length();
                else if (base == 3) a2[2]++;
                else if (base == 34) a2[3]++;
                else if (base == 43) a2[4]++;
                else if (base == 49) a2[5]++;
                if (ctMs > a2[6]) a2[6] = ctMs;
                try {
                    java.util.Calendar cal = java.util.Calendar.getInstance();
                    cal.setTimeInMillis(ctMs);
                    hours[cal.get(java.util.Calendar.HOUR_OF_DAY)]++;
                } catch (Throwable ignore) { }
            }
              if (rows.size() < pageSize) break;
              if (off > 2000000) break;
            }
            members = agg.size();

            java.util.ArrayList<Object[]> list = new java.util.ArrayList<Object[]>();
            for (java.util.Map.Entry<String, long[]> e : agg.entrySet()) {
                String sid = e.getKey();
                String nm;
                if ("__self__".equals(sid)) nm = "我";
                else if ("__unknown__".equals(sid)) nm = "（无法识别）";
                else {
                    nm = senderName(sid);
                    if (nm == null || nm.length() == 0) nm = displayOfTalker(sid);
                }
                list.add(new Object[]{nm, sid, e.getValue()});
            }
            java.util.Collections.sort(list, new java.util.Comparator<Object[]>() {
                @Override public int compare(Object[] x, Object[] y) {
                    return Long.compare(((long[]) y[2])[0], ((long[]) x[2])[0]);
                }
            });

            java.text.SimpleDateFormat f =
                    new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US);
            StringBuilder csv = new StringBuilder("\uFEFF");
            csv.append("成员,wxid,消息数,字数,图片,语音,视频,文件,最后发言\n");
            StringBuilder top = new StringBuilder();
            for (int i = 0; i < list.size(); i++) {
                Object[] o = list.get(i);
                long[] a2 = (long[]) o[2];
                String nm = String.valueOf(o[0]).replace(",", "，");
                csv.append(nm).append(',').append(o[1]).append(',')
                   .append(a2[0]).append(',').append(a2[1]).append(',')
                   .append(a2[2]).append(',').append(a2[3]).append(',')
                   .append(a2[4]).append(',').append(a2[5]).append(',')
                   .append(a2[6] > 0 ? f.format(new java.util.Date(a2[6])) : "-").append('\n');
                if (i < 5) top.append(nm).append('=').append(a2[0]).append(' ');
            }
            csv.append('\n').append("活跃时段（0-23 点消息数）\n");
            StringBuilder hh = new StringBuilder("时段,");
            StringBuilder hv = new StringBuilder("消息数,");
            int peakH = 0;
            for (int i = 0; i < 24; i++) {
                hh.append(i).append("点").append(i < 23 ? "," : "\n");
                hv.append(hours[i]).append(i < 23 ? "," : "\n");
                if (hours[i] > hours[peakH]) peakH = i;
            }
            csv.append(hh).append(hv);
            log("MSTAT|peakHour=" + peakH + " peakCount=" + hours[peakH]);

            java.io.File dir = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                    "Download/wxh");
            dir.mkdirs();
            String nmSafe = safeName(displayOfTalker(talker));
            java.io.File out = new java.io.File(dir, "member_stats_" + nmSafe + "_"
                    + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                    .format(new java.util.Date()) + ".csv");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            fo.write(csv.toString().getBytes("UTF-8"));
            fo.close();
            if (outPath != null && outPath.length > 0) outPath[0] = out.getAbsolutePath();
            log("MSTAT|talker=" + talker + " msgs=" + total + " members=" + members
                    + " top=" + top);
        } catch (Throwable t) { log("MSTAT|err " + t); }
        return new int[]{(int) total, members};
    }

    private static void runMemberStats(final android.app.Activity a, final String talker, final String name) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final String[] path = new String[1];
                final int[] r = memberStatsCore(talker, path);
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("发言明细：" + name)
                                .setMessage("消息 " + r[0] + " 条 · 发言成员 " + r[1] + " 人\n\n"
                                        + (path[0] == null ? "导出失败" : "已导出：\n" + path[0]))
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    private static void showMemberStatsPicker(final android.app.Activity a) {
        showTalkerPicker(a, "群成员发言明细", true, new ChatPick() {
            @Override public void onPick(final String tk, final String nm) {
                runMemberStats(a, tk, nm);
            }
        });
    }
    private static void dumpConversationSchema() {
        try {
            java.util.List<Object[]> cols = queryRows("pragma table_info(rconversation)", 6);
            StringBuilder sb = new StringBuilder();
            for (Object[] c : cols) {
                if (sb.length() > 0) sb.append(',');
                sb.append(c[1]);
            }
            log("SCHEMA|rconversation cols=" + sb);
            java.util.List<Object[]> rows = queryRowsAll(
                    "select * from rconversation order by conversationTime desc limit 40");
            log("SCHEMA|rows=" + rows.size() + " colCount=" + (rows.isEmpty() ? 0 : rows.get(0).length));
            // 免打扰可能不在 rconversation，看 rcontact 的 flag/type
            try {
                java.util.List<Object[]> jr = queryRowsAll(
                        "select r.username, ifnull(r.customNotify,0), ifnull(r.unReadMuteCount,0),"
                                + " ifnull(r.showTips,0), ifnull(r.status,0), ifnull(r.attrflag,0)"
                                + " from rconversation r left join chatroom c on c.chatroomname=r.username"
                                + " where r.username like '%@chatroom' order by r.conversationTime desc limit 30");
                for (Object[] r2 : jr) {
                    log("MUTE|" + displayOfTalker(String.valueOf(r2[0])) + " notify=" + r2[1]
                            + " muteUnread=" + r2[2] + " showTips=" + r2[3]
                            + " status=" + r2[4] + " attrflag=" + r2[5]);
                }
                String[] tables = {"chatroommember", "rcontact"};
                for (String tb : tables) {
                    try {
                        java.util.List<Object[]> ti = queryRowsAll("pragma table_info(" + tb + ")");
                        if (ti.isEmpty()) { log("TBL|" + tb + " (none)"); continue; }
                        StringBuilder cs = new StringBuilder();
                        for (Object[] c : ti) cs.append(c[1]).append(',');
                        log("TBL|" + tb + " n=" + ti.size() + " cols=" + cs);
                    } catch (Throwable t) { log("TBL|" + tb + " err " + t); }
                }
            } catch (Throwable t) { log("RCFLAG|err " + t); }
            for (Object[] r : rows) {
                StringBuilder line = new StringBuilder("SCHEMA|");
                for (int i = 0; i < r.length && i < cols.size(); i++) {
                    String cn = String.valueOf(cols.get(i)[1]);
                    if (!(cn.equals("username") || cn.equals("flag") || cn.equals("unReadCount")
                            || cn.equals("conversationTime") || cn.equals("status") || cn.equals("attrflag")
                            || cn.equals("isSend") || cn.equals("showTips") || cn.equals("digest"))) continue;
                    Object v = r[i];
                    if (cn.equals("digest")) { v = "…"; }
                    line.append(cn).append('=').append(v).append(' ');
                }
                log(line.toString());
            }
        } catch (Throwable t) { log("SCHEMA|err " + t); }
    }

    private static int[] healthReportCore(final String[] outPath) {
        int rows = 0, unreadSessions = 0, silentGroups = 0, bigSessions = 0;
        int staleUnread = 0, newChats = 0;
        try {
            java.util.List<Object[]> conv = queryRows(
                    "select username, ifnull(unReadCount,0), ifnull(conversationTime,0)"
                            + " from rconversation where username is not null and username != ''", 3);
            rows = conv.size();
            long now = System.currentTimeMillis();
            long d7 = now - 7L * 86400000L;
            long d30 = now - 30L * 86400000L, d90 = now - 90L * 86400000L;

            // 每个会话的首条消息时间，用来识别「最近一周新增的会话」
            java.util.HashMap<String, Long> firstMs = new java.util.HashMap<String, Long>();
            try {
                java.util.List<Object[]> fm = queryRows(
                        "select talker, min(createTime) from message group by talker", 2);
                for (Object[] a3 : fm) {
                    if (a3[0] == null || a3[1] == null) continue;
                    long v = 0;
                    try { v = ctToMs(Long.parseLong(String.valueOf(a3[1]))); } catch (Throwable ignore) { }
                    firstMs.put(String.valueOf(a3[0]), v);
                }
            } catch (Throwable t) { log("HEALTH|first err " + t); }

            // 近 30 天每个会话的消息数
            java.util.HashMap<String, Integer> cnt30 =
                    new java.util.HashMap<String, Integer>();
            try {
                java.util.List<Object[]> agg = queryRows(
                        "select talker, count(*) c from message where createTime>=" + sinceRaw(d30)
                                + " group by talker", 2);
                for (Object[] a2 : agg) {
                    if (a2[0] == null) continue;
                    int n = 0;
                    try { n = Integer.parseInt(String.valueOf(a2[1])); } catch (Throwable ignore) { }
                    cnt30.put(String.valueOf(a2[0]), n);
                }
            } catch (Throwable t) { log("HEALTH|agg err " + t); }

            java.util.ArrayList<String[]> lines = new java.util.ArrayList<String[]>();
            lines.add(new String[]{"会话", "wxid", "未读", "近30天消息", "最后活跃", "类型", "提示"});

            final java.util.ArrayList<Object[]> unread = new java.util.ArrayList<Object[]>();
            final java.util.ArrayList<Object[]> silent = new java.util.ArrayList<Object[]>();
            final java.util.ArrayList<Object[]> busy = new java.util.ArrayList<Object[]>();

            for (Object[] r : conv) {
                String tk = String.valueOf(r[0]);
                int un = 0, c30 = 0;
                long ct = 0;
                try { un = Integer.parseInt(String.valueOf(r[1])); } catch (Throwable ignore) { }
                try { ct = Long.parseLong(String.valueOf(r[2])); } catch (Throwable ignore) { }
                Integer c = cnt30.get(tk);
                if (c != null) c30 = c;
                boolean grp = tk.endsWith("@chatroom");
                long ctMs = ct > 0 ? ctToMs(ct) : 0;
                String name = displayOfTalker(tk);
                String tip = "";
                if (un >= 100) { tip = "未读堆积"; unread.add(new Object[]{name, un, tk}); unreadSessions++; }
                if (grp && ctMs > 0 && ctMs < d90) { tip = (tip.length() > 0 ? tip + "/" : "") + "90 天没动静"; silent.add(new Object[]{name, ctMs, tk}); silentGroups++; }
                if (c30 >= 500) { tip = (tip.length() > 0 ? tip + "/" : "") + "消息量大"; busy.add(new Object[]{name, c30, tk}); bigSessions++; }
                if (un > 0 && ctMs > 0 && ctMs < d7) { tip = (tip.length() > 0 ? tip + "/" : "") + "长期未读"; staleUnread++; }
                Long fmv = firstMs.get(tk);
                if (fmv != null && fmv > 0 && fmv > d7) { tip = (tip.length() > 0 ? tip + "/" : "") + "本周新增"; newChats++; }
                lines.add(new String[]{name, tk, String.valueOf(un), String.valueOf(c30),
                        ctMs > 0 ? new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                                .format(new java.util.Date(ctMs)) : "-",
                        grp ? "群" : "私聊", tip});
            }

            java.util.Collections.sort(unread, new java.util.Comparator<Object[]>() {
                @Override public int compare(Object[] a2, Object[] b2) {
                    return ((Integer) b2[1]) - ((Integer) a2[1]);
                }
            });
            java.util.Collections.sort(busy, new java.util.Comparator<Object[]>() {
                @Override public int compare(Object[] a2, Object[] b2) {
                    return ((Integer) b2[1]) - ((Integer) a2[1]);
                }
            });

            StringBuilder csv = new StringBuilder("\uFEFF");
            csv.append("会话,wxid,未读,近30天消息,最后活跃,类型,提示\n");
            for (String[] l : lines.subList(1, lines.size())) {
                for (int i = 0; i < l.length; i++) {
                    String v = l[i] == null ? "" : l[i].replace(",", "，").replace("\n", " ");
                    csv.append(v);
                    if (i < l.length - 1) csv.append(',');
                }
                csv.append('\n');
            }
            java.io.File dir = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                    "Download/wxh");
            dir.mkdirs();
            java.io.File f = new java.io.File(dir, "session_health_"
                    + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                    .format(new java.util.Date()) + ".csv");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
            fo.write(csv.toString().getBytes("UTF-8"));
            fo.close();
            if (outPath != null && outPath.length > 0) outPath[0] = f.getAbsolutePath();

            // 摘要写日志，便于无界面验证
            StringBuilder top = new StringBuilder();
            for (int i = 0; i < Math.min(5, unread.size()); i++) {
                Object[] x = unread.get(i);
                top.append(x[0]).append('=').append(x[1]).append(' ');
            }
            log("HEALTH|rows=" + rows + " unread99=" + unreadSessions + " silent90=" + silentGroups
                    + " busy500=" + bigSessions + " staleUnread=" + staleUnread
                    + " newChats=" + newChats + " top=" + top);
        } catch (Throwable t) { log("HEALTH|err " + t); }
        return new int[]{rows, unreadSessions, silentGroups, bigSessions, staleUnread, newChats};
    }

    private static void runHealthReport(final android.app.Activity a) {
        toast("正在体检…");
        new Thread(new Runnable() {
            @Override public void run() {
                final String[] path = new String[1];
                final int[] r = healthReportCore(path);
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("会话体检")
                                .setMessage("会话 " + r[0] + " 个\n"
                                        + "未读 >99 的 " + r[1] + " 个\n"
                                        + "群 90 天没动静 " + r[2] + " 个\n"
                                        + "近 30 天消息 >500 条 " + r[3] + " 个\n"
                                        + "长期未读（>7 天）" + (r.length > 4 ? r[4] : 0) + " 个\n"
                                        + "本周新增会话 " + (r.length > 5 ? r[5] : 0) + " 个\n\n"
                                        + (path[0] == null ? "报告写入失败" : "已导出：" + path[0]))
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    /* ================= 解除转发人数上限 =================
     * 逆向：com.tencent.mm.ui.transmit.SelectConversationUI#M8(Z)Z 里
     *   const/16 v0, 0x9
     *   if (列表.size() >= 9) 弹「最多只能选择 N 个」
     * 上限是硬编码常量。这里 hook M8：未超过自定义上限时直接返回 false（不拦截）。
     * 列表字段名 Q1（8.0.80）。
     */
    private static volatile boolean fwdLimitHooked = false;

    /** 转发上限循环：9(默认) → 50 → 100 → 200 */
    private static void cycleFwdMax() {
        try {
            int cur = readCfg().optInt("fwdMax", 100);
            int[] vals = {9, 50, 100, 200};
            int idx = 0;
            for (int i = 0; i < vals.length; i++) if (vals[i] == cur) { idx = i; break; }
            idx = (idx + 1) % vals.length;
            setIntCfg("fwdMax", vals[idx]);
            toast(vals[idx] <= 9 ? "转发人数上限：微信默认 9"
                    : "转发人数上限：" + vals[idx] + " 个");
        } catch (Throwable t) { toast("设置失败"); }
    }

    private static void installForwardLimit(final ClassLoader app) {
        if (fwdLimitHooked) return;
        fwdLimitHooked = true;
        try {
            // A) 新版 MVVM 转发选人：Intent extra "max_limit_num" 决定上限（实测 8.0.80 走这条）
            try {
                Class<?> q = Class.forName("vg0.q0", false, app);
                int qn = 0;
                for (final java.lang.reflect.Method m : q.getDeclaredMethods()) {
                    if (m.getReturnType() != android.content.Intent.class) continue;
                    Class<?>[] qps = m.getParameterTypes();
                    if (qps.length == 0 || qps[0] != android.content.Context.class) continue;
                    m.setAccessible(true);
                    XposedBridge.hookMethod(m, new XC_MethodHook() {
                        @Override protected void afterHookedMethod(MethodHookParam pm) {
                            try {
                                Object r = pm.getResult();
                                if (!(r instanceof android.content.Intent)) return;
                                android.content.Intent it = (android.content.Intent) r;
                                int max = cfg().optInt("fwdMax", 100);
                                if (max <= 9) return;
                                it.putExtra("max_limit_num", max);
                                it.putExtra("too_many_member_tip_string",
                                        "最多选择" + max + "个联系人和群组");
                                log("FWD|intent patched max=" + max + " by " + pm.method.getName());
                            } catch (Throwable t) { log("FWD|patch err " + t); }
                        }
                    });
                    qn++;
                }
                log("FWD|mvvm hooked=" + qn);
            } catch (Throwable t) { log("FWD|mvvm err " + t); }

            // B) 老版选人界面（SelectConversationUI）保留
            Class<?> c = Class.forName("com.tencent.mm.ui.transmit.SelectConversationUI", false, app);
            int n = 0;
            for (final java.lang.reflect.Method m : c.getDeclaredMethods()) {
                if (!m.getName().equals("M8")) continue;
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length != 1 || ps[0] != boolean.class) continue;
                if (m.getReturnType() != boolean.class) continue;
                m.setAccessible(true);
                XposedBridge.hookMethod(m, new XC_MethodHook() {
                    @Override protected void beforeHookedMethod(MethodHookParam pm) {
                        try {
                            int max = cfg().optInt("fwdMax", 100);
                            if (max <= 0) return;
                            int size = -1;
                            try {
                                java.lang.reflect.Field f = pm.thisObject.getClass()
                                        .getDeclaredField("Q1");
                                f.setAccessible(true);
                                Object list = f.get(pm.thisObject);
                                if (list instanceof java.util.List) size = ((java.util.List) list).size();
                            } catch (Throwable ignore) { }
                            if (size >= 0 && size <= max) {
                                pm.setResult(Boolean.FALSE);
                                log("FWD|allow n=" + size + " max=" + max);
                            } else if (size > max) {
                                log("FWD|block n=" + size + " max=" + max);
                            }
                        } catch (Throwable t) { log("FWD|err " + t); }
                    }
                });
                n++;
            }
            log("FWD|hooked=" + n);
        } catch (Throwable t) { log("FWD|install err " + t); }
    }

    private static void installMaxSelect(final ClassLoader app) {
        if (maxSelHooked) return;
        maxSelHooked = true;
        String[] cands = {
                "com.tencent.mm.plugin.gallery.ui.AlbumPreviewUI",
                "com.tencent.mm.plugin.gallery.ui.MMAlbumPreviewUI"
        };
        for (String cn : cands) {
            try {
                Class<?> c = Class.forName(cn, false, app);
                XposedBridge.hookAllMethods(c, "onCreate", new XC_MethodHook() {
                    @Override protected void beforeHookedMethod(MethodHookParam pm) {
                        try {
                            if (!cfg().optBoolean("maxMediaSel", false)) return;
                            if (!(pm.thisObject instanceof android.app.Activity)) return;
                            android.app.Activity a = (android.app.Activity) pm.thisObject;
                            android.content.Intent it = a.getIntent();
                            if (it == null) return;
                            int old = it.getIntExtra("max_select_count", 9);
                            it.putExtra("max_select_count", 99);
                            // 顺手解除文件大小限制（0 = 不限）
                            long sz = it.getLongExtra("key_wedrop_select_size_limit", 0L);
                            it.putExtra("key_wedrop_select_size_limit", 0L);
                            log("MAXSEL|patched " + old + " -> 99, sizeLimit " + sz);
                        } catch (Throwable ignore) { }
                    }
                });
                log("MAXSEL|hooked " + cn);
            } catch (Throwable ignore) { }
        }
                String[] cands2 = {"com.tencent.mm.plugin.finder.ui.FinderAlbumUI"};
                for (String cn2 : cands2) {
                    try {
                        Class<?> c2 = Class.forName(cn2, false, app);
                        XposedBridge.hookAllMethods(c2, "onCreate", new XC_MethodHook() {
                            @Override protected void beforeHookedMethod(MethodHookParam pm) {
                                try {
                                    if (!cfg().optBoolean("maxMediaSel", false)) return;
                                    if (!(pm.thisObject instanceof android.app.Activity)) return;
                                    android.content.Intent it = ((android.app.Activity) pm.thisObject).getIntent();
                                    if (it == null) return;
                                    it.putExtra("max_select_count", 99);
                                    it.putExtra("min_select_count", 1);
                                    log("MAXSEL|finder patched");
                                } catch (Throwable ignore) { }
                            }
                        });
                        log("MAXSEL|hooked " + cn2);
                    } catch (Throwable ignore) { }
                }
    }

    /* ================= 导出本会话语音（原始 SILK 文件） ================= */
    private static void exportVoicesRaw() {
        try {
            String tk = chatTalker;
            if (tk == null || tk.length() == 0) { toast("请先进入要导出的聊天"); return; }
            java.util.List<Object[]> rows = queryRows(
                    "select msgId, createTime from message where talker='" + tk.replace("'", "''")
                            + "' and type=34 order by createTime desc limit 300", 2);
            if (rows.isEmpty()) { toast("本会话没有语音消息"); return; }
            java.io.File outDir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh/voice");
            if (!outDir.exists()) outDir.mkdirs();
            java.util.ArrayList<java.io.File> bases = new java.util.ArrayList<java.io.File>();
            java.io.File mm = new java.io.File(mmBase() + "/MicroMsg");
            java.io.File[] subs = mm.listFiles();
            if (subs != null) for (java.io.File f : subs) {
                if (f.isDirectory() && new java.io.File(f, "voice2").isDirectory()) bases.add(f);
            }
            int ok = 0, miss = 0;
            java.text.SimpleDateFormat fmt = new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US);
            for (Object[] r : rows) {
                try {
                    long mid = r[0] instanceof Number ? ((Number) r[0]).longValue() : 0;
                    long ct = r[1] instanceof Number ? ((Number) r[1]).longValue() : 0;
                    if (mid == 0) continue;
                    String md5 = null;
                    java.util.List<Object[]> p = queryRows(
                            "select ifnull(imgPath,'') from message where msgId=" + mid + " limit 1", 1);
                    if (!p.isEmpty() && p.get(0)[0] != null) {
                        String ip = String.valueOf(p.get(0)[0]);
                        int k = ip.indexOf("msg_");
                        if (k >= 0) md5 = ip.substring(k + 4).replace(".amr", "").trim();
                        else if (ip.length() >= 32) md5 = ip.substring(ip.length() - 32);
                    }
                    if (md5 == null || md5.length() < 32) { miss++; continue; }
                    java.io.File src = null;
                    for (java.io.File b : bases) {
                        java.io.File f = new java.io.File(b, "voice2/" + md5.substring(0, 2) + "/msg_" + md5 + ".amr");
                        if (f.isFile()) { src = f; break; }
                    }
                    if (src == null) { miss++; continue; }
                    java.io.File dst = new java.io.File(outDir,
                            (ct > 0 ? fmt.format(new java.util.Date(ct)) : String.valueOf(mid)) + "_" + md5.substring(0, 8) + ".amr");
                    copyFile(src, dst);
                    ok++;
                } catch (Throwable ignore) { miss++; }
            }
            toast("语音导出完成：成功 " + ok + "，未找到 " + miss + "\n目录：Download/wxh/voice");
            log("EXPVC|ok=" + ok + " miss=" + miss);
        } catch (Throwable t) { toast("导出失败：" + t); log("EXPVC|err " + t); }
    }

    /* ================= 自动同意好友申请 ================= */
    private static volatile boolean acceptHooked = false;

    private static void installAutoAcceptFriend(final ClassLoader app) {
        if (acceptHooked) return;
        acceptHooked = true;
        try {
            Class<?> c = Class.forName("com.tencent.mm.plugin.subapp.ui.friend.FMessageConversationUI", false, app);
            XposedBridge.hookAllMethods(c, "onResume", new XC_MethodHook() {
                @Override protected void afterHookedMethod(final MethodHookParam pm) {
                    try {
                        if (!cfg().optBoolean("autoAcceptFriend", false)) return;
                        if (!(pm.thisObject instanceof android.app.Activity)) return;
                        final android.app.Activity a = (android.app.Activity) pm.thisObject;
                        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
                        for (final long d : new long[]{800L, 1800L}) {
                            h.postDelayed(new Runnable() {
                                @Override public void run() { try { tapAcceptButtons(a); } catch (Throwable ignore) { } }
                            }, d);
                        }
                    } catch (Throwable ignore) { }
                }
            });
            log("ACCEPT|hooked");
        } catch (Throwable t) { log("ACCEPT|err " + t); }
    }

    /** 「新的朋友」页里，把每个「接受」按钮点一遍 */
    private static void tapAcceptButtons(android.app.Activity a) {
        try {
            android.view.View decor = a.getWindow().getDecorView();
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(decor, all, 0);
            int n = 0;
            for (android.view.View v : all) {
                CharSequence tx = null;
                if (v instanceof android.widget.TextView) tx = ((android.widget.TextView) v).getText();
                if (tx == null) continue;
                String t = tx.toString().trim();
                if (!t.equals("接受") && !t.equals("通过验证") && !t.equals("同意")) continue;
                if (v.getTag(0x0f0f0f93) != null) continue;
                v.setTag(0x0f0f0f93, "done");
                v.performClick();
                n++;
            }
            if (n > 0) log("ACCEPT|clicked " + n);
        } catch (Throwable ignore) { }
    }

    /* ================= 群成员实名显示：消息行前加发送人备注首字 ================= */
    private static void applyGroupRealName(android.view.View row, boolean mine) {
        try {
            if (!cfg().optBoolean("groupRealName", false)) return;
            if (mine) return;
            String tk0 = chatTalker;
            if (tk0 == null || !tk0.endsWith("@chatroom")) return;
            if (row.getTag(0x0f0f0f94) != null) return;
            row.setTag(0x0f0f0f94, "named");
            Object t = row.getTag(0x0f0f0f06);
            if (!(t instanceof Long)) return;
            String who = senderOfTs(((Long) t).longValue());
            if (who == null || who.length() == 0) return;
            String nm = displayOfTalker(who);
            if (nm == null || nm.length() == 0) return;
            CharSequence cd = row.getContentDescription();
            String cdS = cd == null ? "" : cd.toString();
            row.setContentDescription(cdS + " · " + nm);
        } catch (Throwable ignore) { }
    }

