    /** 从最近的消息里统计该会话出现过的发送人（群聊按发言计数） */
    private static java.util.List<Object[]> recentSenders(String talker) {
        java.util.List<Object[]> out = new java.util.ArrayList<Object[]>();
        try {
            java.util.List<Object[]> rows = queryRows(
                    "select ifnull(content,'') from message where talker='" + escSql(talker)
                            + "' order by createTime desc limit 3000", 1);
            java.util.LinkedHashMap<String, Integer> cnt = new java.util.LinkedHashMap<String, Integer>();
            for (Object[] r : rows) {
                String c = r[0] == null ? "" : String.valueOf(r[0]);
                String sid = senderIdOfGroupMsg(c);
                if (sid == null) continue;
                Integer n = cnt.get(sid);
                cnt.put(sid, n == null ? 1 : n + 1);
            }
            java.util.ArrayList<String> ids = new java.util.ArrayList<String>(cnt.keySet());
            java.util.Collections.sort(ids, new java.util.Comparator<String>() {
                @Override public int compare(String x, String y) {
                    int a1 = cntOf(cnt, x), b1 = cntOf(cnt, y);
                    return b1 - a1;
                }
                private int cntOf(java.util.LinkedHashMap<String, Integer> m, String k) {
                    Integer v = m.get(k);
                    return v == null ? 0 : v;
                }
            });
            int max = Math.min(ids.size(), 60);
            for (int i = 0; i < max; i++) {
                String id = ids.get(i);
                out.add(new Object[]{id, senderName(id), cnt.get(id)});
            }
        } catch (Throwable t) { log("MEXP|senders err " + t); }
        return out;
    }

