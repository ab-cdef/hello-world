    /* ---- 入群欢迎语 ---- */
    private static void maybeWelcome(String talker, String content) {
        try {
            if (!cfg().optBoolean("welcomeOn", false)) return;
            if (talker == null || !talker.endsWith("@chatroom") || content == null) return;
            if (!content.contains("加入了群聊")) return;
            org.json.JSONArray only = cfg().optJSONArray("welcomeOnly");
            if (only != null && only.length() > 0) {
                boolean ok = false;
                for (int i = 0; i < only.length(); i++) if (talker.equals(only.optString(i))) { ok = true; break; }
                if (!ok) return;
            }
            String who = "";
            int p1 = content.indexOf("邀请");
            int p2 = content.indexOf("加入了群聊");
            if (p2 > 0) {
                String pre = content.substring(0, p2);
                int q = pre.lastIndexOf("\"，");
                if (q < 0) q = pre.lastIndexOf("\"");
                who = q >= 0 ? pre.substring(q + 1) : pre;
            }
            if (p1 > 0 && content.contains("通过")) {
                int a1 = content.indexOf("\"，");
                if (a1 > 0 && a1 < p2) who = content.substring(a1 + 1, p2);
            }
            who = who.replace("「", "").replace("」", "").trim();
            String tpl = cfg().optString("welcomeText", "欢迎 {昵称} 加入本群 👋");
            final String msg = tpl.replace("{昵称}", who).replace("{群名}", displayOfTalker(talker));
            final String tk = talker;
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() {
                    try { sendTextTo(mainAct, tk, msg); log("WELCOME|" + tk + " " + msg); }
                    catch (Throwable t) { log("WELCOME|err " + t); }
                }
            }, 2500L);
        } catch (Throwable t) { log("WELCOME|err " + t); }
    }

    /* ---- 文字转图片 ---- */
    private static void showTextToImage(final android.app.Activity a) {
        final android.widget.EditText et = new android.widget.EditText(a);
        et.setHint("输入要转成图片的文字");
        et.setMinLines(4);
