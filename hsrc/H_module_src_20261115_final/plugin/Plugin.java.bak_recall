    /** 群聊归拢：会话列表里把群聊项压成 0 高度 */
    private static void installGroupFold(ClassLoader app) {
        try {
            Class<?> ad = Class.forName("cp5.a1", false, app);
            XposedBridge.hookAllMethods(ad, "getView", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        Object rv = p.getResult();
                        if (rv instanceof android.view.View) applyRowTheme((android.view.View) rv);
                    } catch (Throwable ignore) { }
                    try {
                        if (!cfg().optBoolean("groupFold", false)) return;
                        Object self = p.thisObject;
                        lastConvAdapter = self;
                        Object v = p.getResult();
                        if (!(v instanceof android.view.View)) return;
                        android.view.View item = (android.view.View) v;
                        if ("wxhGroupRow".equals(item.getTag())) return;
                        int pos = (Integer) p.args[0];
                        boolean isGroup = false;
                        String u = null;
                        String cachedName = null;
                        try {
                            Object conv = null;
                            for (Method m : self.getClass().getMethods()) {
                                if (m.getName().equals("getItem") && m.getParameterTypes().length == 1
                                        && m.getParameterTypes()[0] == int.class) {
                                    m.setAccessible(true);
                                    conv = m.invoke(self, pos);
                                    break;
                                }
                            }
                            if (conv != null) {
                                try { u = (String) conv.getClass().getMethod("h1").invoke(conv); } catch (Throwable ignore) { }
                                isGroup = u != null && u.endsWith("@chatroom");
                            }
                        } catch (Throwable ignore) { }
                        if (isGroup) {
                            try {
                                java.util.List<android.widget.TextView> tvx = new java.util.ArrayList<android.widget.TextView>();
                                collectTexts(item, tvx, 0);
                                StringBuilder tb = new StringBuilder();
                                for (android.widget.TextView a0 : tvx) tb.append('[').append(a0.getText()).append('/').append((int)a0.getTextSize()).append(']');
                                log("GNDBG|" + u + "|" + tb);
                            } catch (Throwable ignore) { }
                            final android.view.View fitem = item;
                            final String ftalker = u;
                            try {
                                java.util.List<android.widget.TextView> tvs = new java.util.ArrayList<android.widget.TextView>();
                                collectTexts(fitem, tvs, 0);
                                float best = -1f;
                                String nm = null;
                                for (android.widget.TextView tv0 : tvs) {
                                    String t = tv0.getText() == null ? "" : tv0.getText().toString().trim();
                                    if (t.length() == 0 || t.contains("@chatroom")) continue;
                                    if (t.matches("\\d+")) continue;
                                    if (t.matches(".*(昨天|周.|月.*日|\\d{1,2}:\\d{2}).*")) continue;
                                    if (t.contains("折叠") || t.contains("置顶")) continue;
                                    if (tv0.getTextSize() > best && t.length() <= 30) { best = tv0.getTextSize(); nm = t; }
                                }
                                if (nm != null) { groupNames.put(ftalker, nm); log("GN|" + ftalker + "=" + nm); }
                            } catch (Throwable ignore) { }
                            try {
                                fitem.setVisibility(android.view.View.GONE);
                                android.view.ViewGroup.LayoutParams lp = fitem.getLayoutParams();
                                if (lp != null && lp.height != 0) { lp.height = 0; fitem.setLayoutParams(lp); }
                            } catch (Throwable ignore) { }
                            android.view.ViewGroup.LayoutParams lp = item.getLayoutParams();
                            if (lp != null && lp.height != 0) { lp.height = 0; item.setLayoutParams(lp); }
                        } else {
                            if (item.getVisibility() != android.view.View.VISIBLE)
                                item.setVisibility(android.view.View.VISIBLE);
                            android.view.ViewGroup.LayoutParams lp = item.getLayoutParams();
                            if (lp != null && lp.height == 0) {
                                lp.height = android.view.ViewGroup.LayoutParams.WRAP_CONTENT;
                                item.setLayoutParams(lp);
                            }
                        }
                    } catch (Throwable t) { }
                }
            });
            log("hooked cp5.a1.getView (groupFold)");
        } catch (Throwable t) { log("groupFold err " + t); }
    }




    /** 会话列表第 2 位插入「群聊」入口 */
    private static void installConvInsert(ClassLoader app) {
        try {
            Class<?> ad = Class.forName("cp5.a1", false, app);
            XposedBridge.hookAllMethods(ad, "getCount", new XC_MethodHook() {
