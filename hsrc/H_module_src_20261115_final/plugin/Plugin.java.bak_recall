    }

    private static void putInt(String k, int v) {
        try { JSONObject o = readCfg(); o.put(k, v); writeCfg(o); cfg = null; cfgAt = 0; } catch (Throwable ignore) { }
    }

    private static void putStr(String k, String v) {
        try { JSONObject o = readCfg(); o.put(k, v); writeCfg(o); cfg = null; cfgAt = 0; } catch (Throwable ignore) { }
    }

    /** 消息详情：类型 / 时间 / 发送人 / 本地ID / 服务器ID / 长度 */
    private static void showMsgDetail(final android.app.Activity a, final String talker,
                                      final long ts, final String text) {
        if (a == null) return;
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    StringBuilder sb = new StringBuilder();
                    long sec = ts > 100000000000L ? ts / 1000L : ts;
                    sb.append("会话：").append(displayOfTalker(talker)).append('\n');
                    sb.append("时间：").append(fmtTs(ts)).append('\n');
                    Object h = msgDbHandle();
                    if (h != null) {
                        Object cur = h.getClass().getMethod("B", String.class, String[].class)
                                .invoke(h, "select msgId, msgSvrId, type, isSend, createTime, length(content) from message"
                                        + " where talker='" + (talker == null ? "" : talker.replace("'", "''"))
                                        + "' and createTime between " + (sec - 2) + " and " + (sec + 2)
                                        + " order by createTime desc limit 1", new String[0]);
                        if (cur != null) {
                            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                            java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                            if ((Boolean) mv.invoke(cur)) {
                                long mid = (Long) gl.invoke(cur, 0);
                                long svr = (Long) gl.invoke(cur, 1);
                                long ty = (Long) gl.invoke(cur, 2);
                                long mine = (Long) gl.invoke(cur, 3);
                                long len = (Long) gl.invoke(cur, 5);
                                sb.append("类型：").append(ty).append("（").append(typeLabel((int) ty)).append("）\n");
                                sb.append("方向：").append(mine > 0 ? "我发出" : "对方发来").append('\n');
                                sb.append("本地 msgId：").append(mid).append('\n');
                                sb.append("服务器 msgSvrId：").append(svr).append('\n');
                                sb.append("内容长度：").append(len).append('\n');
                            }
                            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                        }
                    }
                    String t = text == null ? "" : text.trim();
                    if (t.length() > 0) {
                        sb.append('\n').append(t.length() > 300 ? t.substring(0, 300) + "…" : t);
                    }
                    final String msg = sb.toString();
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("消息详情")
                                    .setMessage(msg)
                                    .setPositiveButton("好", null)
                                    .show();
                        }
                    });
                } catch (Throwable t) { log("MSGDETAIL|err " + t); }
            }
        }).start();
    }

    // ================= 导出本会话全部图片 =================
    private static void exportChatImages(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || tk.length() == 0) { toast("请先在要导出的聊天里执行"); return; }
        new android.app.AlertDialog.Builder(a)
                .setTitle("导出 " + displayOfTalker(tk) + " 的全部图片？")
                .setMessage("会解密并把最近 200 张图片保存到相册 Pictures/wxh")
                .setPositiveButton("开始", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) { doExportChatImages(a, tk); }
                })
                .setNegativeButton("取消", null).show();
    }

    private static void doExportChatImages(final android.app.Activity a, final String tk) {
        final Object h = msgDbHandle();
        if (h == null) { toast("数据库未就绪"); return; }
        new Thread(new Runnable() {
            @Override public void run() {
                int ok = 0, fail = 0;
                try {
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select msgSvrId, imgPath, content from message where talker='"
                                    + tk.replace("'", "''") + "' and type=3 order by createTime desc limit 200",
                                    new String[0]);
                    if (cur == null) return;
                    java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                    java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                    java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                    while ((Boolean) mv.invoke(cur)) {
                        long svr = (Long) gl.invoke(cur, 0);
                        String path = (String) gs.invoke(cur, 1);
                        String body = (String) gs.invoke(cur, 2);
                        try {
                            android.graphics.Bitmap bm = loadImageThumb2(h, svr, attrOf(body, "aeskey"),
                                    path, attrOf(body, "cdnthumbaeskey"));
                            if (bm != null && saveBitmapQuiet(bm)) ok++; else fail++;
                        } catch (Throwable t) { fail++; }
                    }
                    try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                } catch (Throwable t) { log("EXPIMG|err " + t); }
                final int fo = ok, ff = fail;
                log("EXPIMG|ok=" + fo + " fail=" + ff);
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        toast("已导出 " + fo + " 张（失败 " + ff + "）到相册 Pictures/wxh");
                    }
                });
            }
        }).start();
    }

    /** 定位这条消息所属会话：优先用「消息时间」反查，其次实时会话 */
    private static String resolveRowTalker() {
        try {
            String byTs = talkerByTs(lastLongPressTs);
            if (byTs != null && byTs.length() > 0) return byTs;
        } catch (Throwable ignore) { }
        String t = currentTalker();
        if (t != null && t.length() > 0) return t;
        return lastKnownTalker;
    }

    /** 长按行的精确时间：优先按"内容"在库里核对，其次行 tag，最后按行偏移 */
    private static long tsForPressedRow(android.view.View anchor, String text) {
        String tk = chatTalker;
        long best = 0;
        try {
            String t = text == null ? "" : text.trim();
            if (tk != null && t.length() >= 2) {
                String safe = t.replace("'", "''").replace("%", "").replace("_", "");
                if (safe.length() > 60) safe = safe.substring(0, 60);
                java.util.List<Object[]> rr = queryRows("select createTime, content from message where talker='"
                        + tk.replace("'", "''") + "' and content like '%" + safe + "%'"
                        + " order by createTime desc limit 5", 2);
                for (Object[] r : rr) {
                    long ct = 0;
                    try { ct = Long.parseLong(String.valueOf(r[0]).trim()); } catch (Throwable ignore) { }
                    String c = String.valueOf(r[1]);
                    if (ct > 0 && c.contains(t)) {
                        best = ct < 100000000000L ? ct * 1000L : ct;
                        break;
                    }
                }
            }
        } catch (Throwable ignore) { }
        if (best <= 0) {
            try { best = tsOfAnchor(anchor); } catch (Throwable ignore) { }
        }
        if (best <= 0) {
            try {
                int pfb = rowIndexFromBottomByContainment(anchor);
                if (pfb >= 0 && chatTalker != null) {
                    java.util.List<Object[]> rr = queryRows("select createTime from message where talker='"
                            + chatTalker.replace("'", "''") + "' order by createTime desc limit 1 offset " + pfb, 1);
                    if (!rr.isEmpty()) {
                        long ct = Long.parseLong(String.valueOf(rr.get(0)[0]).trim());
                        best = ct < 100000000000L ? ct * 1000L : ct;
                    }
                }
            } catch (Throwable ignore) { }
        }
        return best;
    }

    /** 以某条消息为中心取上文（targetMsg 单条分析用） */
    private static String buildChatContextAround(String talker, long tsMs, int before) {
        try {
            if (talker == null) return "";
            long sec = tsMs > 100000000000L ? tsMs / 1000L : tsMs;
            if (sec <= 0) return buildChatContext(talker, 20);
            java.util.List<Object[]> rr = queryRows("select content, isSend, type, createTime from message where talker='"
                    + talker.replace("'", "''") + "' and createTime<=" + sec
                    + " order by createTime desc limit " + Math.max(1, before), 4);
            java.util.ArrayList<String> lines = new java.util.ArrayList<String>();
            for (int i = rr.size() - 1; i >= 0; i--) {
                Object[] r = rr.get(i);
                long ty = 0;
                try { ty = Long.parseLong(String.valueOf(r[2]).trim()); } catch (Throwable ignore) { }
                long mine = 0;
                try { mine = Long.parseLong(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                String body = prettyContent(String.valueOf(r[0] == null ? "" : r[0]));
                if (body == null || body.length() == 0) continue;
                long ct = 0;
                try { ct = Long.parseLong(String.valueOf(r[3]).trim()); } catch (Throwable ignore) { }
                if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                String when = ct > 0 ? fmtTs(ct).substring(5, 16) : "";
                lines.add("[" + when + "] " + (mine > 0 ? "我" : "对方") + "：" + body);
            }
            StringBuilder sb = new StringBuilder();
            for (String l : lines) sb.append(l).append('\n');
            return sb.toString();
        } catch (Throwable t) { return ""; }
    }

    /** 判断这条消息是不是自己发的（内容 + 时间双条件，取最近一条） */
    private static boolean isMyMessage(String talker, long tsMs, String text) {
        try {
            String tk = talker == null ? "" : talker.replace("'", "''");
            long sec = tsMs > 100000000000L ? tsMs / 1000L : tsMs;
            String sql = null;
            String t = text == null ? "" : text.trim();
            if (t.length() >= 2) {
                String safe = t.replace("'", "''").replace("%", "").replace("_", "");
                if (safe.length() > 60) safe = safe.substring(0, 60);
                sql = "select isSend from message where talker='" + tk + "' and content like '%"
                        + safe + "%' order by createTime desc limit 1";
            } else if (sec > 0) {
                sql = "select isSend from message where talker='" + tk + "' and createTime between "
                        + (sec - 2) + " and " + (sec + 2) + " limit 1";
            }
            if (sql == null) return false;
            java.util.List<Object[]> rr = queryRows(sql, 1);
            if (!rr.isEmpty() && rr.get(0)[0] != null) {
                return Long.parseLong(String.valueOf(rr.get(0)[0]).trim()) > 0;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    /** 渲染候选回复（支持"性格|内容"格式，性格用小标签显示） */
    private static void renderReplyOptions(final android.app.Activity a,
                                           final android.widget.LinearLayout box,
                                           final android.widget.EditText et,
                                           final java.util.List<String> opts,
                                           final android.app.Dialog[] holder) {
        try {
            box.removeAllViews();
            for (int i = 0; i < opts.size(); i++) {
                String raw = opts.get(i);
                String tag = null, txt = raw;
                int p = raw.indexOf('|');
                if (p > 0 && p <= 6) { tag = raw.substring(0, p).trim(); txt = raw.substring(p + 1).trim(); }
                if (txt.length() == 0) continue;
                final String fTxt = txt;

                android.widget.LinearLayout row = new android.widget.LinearLayout(a);
                row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                row.setPadding(dp(a, 12), dp(a, 11), dp(a, 12), dp(a, 11));
                android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
                bg.setColor(0xFFF7F7FA);
                bg.setCornerRadius(dp(a, 12));
                bg.setStroke(dp(a, 1), 0xFFEDEDF1);
                row.setBackground(bg);

                if (tag != null && tag.length() > 0) {
                    android.widget.TextView tg = new android.widget.TextView(a);
                    tg.setText(tag);
                    tg.setTextSize(10);
                    tg.setTextColor(0xFFC8102E);
                    tg.setPadding(dp(a, 6), dp(a, 2), dp(a, 6), dp(a, 2));
                    android.graphics.drawable.GradientDrawable tbg = new android.graphics.drawable.GradientDrawable();
                    tbg.setColor(0x14C8102E);
                    tbg.setCornerRadius(dp(a, 6));
                    tg.setBackground(tbg);
                    android.widget.LinearLayout.LayoutParams tlp =
                            new android.widget.LinearLayout.LayoutParams(-2, -2);
                    tlp.rightMargin = dp(a, 8);
                    row.addView(tg, tlp);
                }
                android.widget.TextView tv = new android.widget.TextView(a);
                tv.setText(txt);
                tv.setTextSize(14);
                tv.setTextColor(0xFF1A1A1F);
                tv.setLineSpacing(0, 1.15f);
                row.addView(tv, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));

                android.widget.LinearLayout.LayoutParams lp = new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                lp.topMargin = dp(a, 6);
                row.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        if (!fillInput(et, fTxt)) copyText(a, fTxt);
                        try { if (holder[0] != null) holder[0].dismiss(); } catch (Throwable ignore) { }
                    }
                });
                row.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                    @Override public boolean onLongClick(android.view.View v) {
                        copyText(a, fTxt);
                        try { if (holder[0] != null) holder[0].dismiss(); } catch (Throwable ignore) { }
                        return true;
                    }
                });
                box.addView(row, lp);
            }
        } catch (Throwable t) { log("AI|render err " + t); }
    }

    /** 只重新生成候选回复，不动分析卡片 */
    private static volatile boolean uiBlocked = false;   // 有非主界面 Activity 在前台
    private static volatile boolean lastAiMine = false;
    private static volatile String lastAiFocus = null;
    private static volatile String lastAiAnalysis = null;
    private static volatile String aiExtraNote = "";

    private static void regenReplies(final android.app.Activity a, final android.widget.EditText et,
                                     final String talker, final String targetMsg,
                                     final android.widget.LinearLayout box,
                                     final android.app.Dialog[] holder) {
        if (box == null) return;
        try {
            android.widget.TextView loading = new android.widget.TextView(a);
            loading.setText("正在换一批…");
            loading.setTextSize(12);
            loading.setTextColor(0xFF9A9AA2);
            loading.setPadding(dp(a, 12), dp(a, 10), 0, dp(a, 6));
            box.removeAllViews();
            box.addView(loading);
        } catch (Throwable ignore) { }
        new Thread(new Runnable() {
            @Override public void run() {
                java.util.ArrayList<String> out = new java.util.ArrayList<String>();
                try {
                    String focus = targetMsg == null ? "" : targetMsg.trim();
                    if (focus.length() == 0 && lastAiFocus != null) focus = lastAiFocus.trim();
                    boolean mine = lastAiMine || isMyMessage(talker, lastLongPressTs, focus);
                    String prompt = mine
                            ? "你在帮用户补一句话。下面是用户自己刚发出的消息，请给出几条【接着补充】的候选，"
                              + "语气要像同一个人继续说。每条不同性格，条数 2~4 条，按下面格式逐行输出，不要多余内容：\n"
                              + "候选|稳重：<不超过25字>\n候选|直接：<...>\n候选|幽默：<...>"
                            : "你在帮用户回复微信。下面是对方发来的一句话，请给出几条候选回复。"
                              + "每条用不同性格和语气，条数 2~4 条，按下面格式逐行输出，不要多余内容：\n"
                              + "候选|稳重：<不超过25字>\n候选|热情：<...>\n候选|幽默：<...>\n候选|简短：<...>";
                    log("AI|regen mine=" + mine + " focus=" + focus);
                    String note2 = aiExtraNote == null ? "" : aiExtraNote.trim();
                    String ui2 = (mine ? "我发的：" : "对方发的：") + focus;
                    if (note2.length() > 0) ui2 = "用户补充说明（优先遵守）：" + note2 + "\n" + ui2;
                    String raw = callAiRaw(prompt, ui2);
                    for (String ln : raw.split("\n")) {
                        String v = ln.trim();
                        if (v.length() == 0) continue;
                        if (v.startsWith("-") || v.startsWith("•")) v = v.substring(1).trim();
                        int c = v.indexOf("候选");
                        if (c == 0) v = v.substring(2).trim();
                        if (v.startsWith("|")) v = v.substring(1).trim();
                        if (v.indexOf('：') < 0 && v.indexOf(':') < 0) continue;
                        String t = v.replace("：", "|").replaceFirst(":", "|");
                        if (t.indexOf('|') > 0) out.add(t);
                    }
                    if (out.isEmpty()) {
                        for (String ln : raw.split("\n")) {
                            String v = ln.trim();
                            if (v.length() > 4 && v.length() < 90) out.add("候选|" + v);
                        }
                    }
                } catch (Throwable t) { log("AI|regen err " + t); }
                final java.util.ArrayList<String> res = out;
                new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                    @Override public void run() {
                        if (res.isEmpty()) {
                            try {
                                box.removeAllViews();
                                android.widget.TextView tv = new android.widget.TextView(a);
                                tv.setText("换一批失败，请重试");
                                tv.setTextSize(12);
                                tv.setTextColor(0xFF9A9AA2);
                                box.addView(tv);
                            } catch (Throwable ignore) { }
                            return;
                        }
                        renderReplyOptions(a, box, et, res, holder);
                    }
                });
            }
        }).start();
    }

    /** 按分组生成 5 条候选 */
    private static void fetchCat(final android.app.Activity a, final android.widget.EditText et,
                                 final String talker, final String targetMsg, final String cat,
                                 final java.util.HashMap<String, java.util.ArrayList<String>> cache,
                                 final android.widget.LinearLayout box,
                                 final android.app.Dialog[] holder, final Runnable refresh) {
        new Thread(new Runnable() {
            @Override public void run() {
                java.util.ArrayList<String> out = new java.util.ArrayList<String>();
                try {
                    String focus = targetMsg == null ? "" : targetMsg.trim();
                    if (focus.length() == 0 && lastAiFocus != null) focus = lastAiFocus.trim();
                    boolean mine = lastAiMine || isMyMessage(talker, lastLongPressTs, focus);
                    String ana = lastAiAnalysis == null ? "" : lastAiAnalysis;
                    String catDesc;
                    if ("稳重".equals(cat)) catDesc = "沉稳、有分寸、给对方确定性";
                    else if ("热情".equals(cat)) catDesc = "热情、积极、有情绪温度";
                    else if ("幽默".equals(cat)) catDesc = "幽默、俏皮、轻松化解";
                    else if ("共情".equals(cat)) catDesc = "先理解对方感受、有共情";
                    else if ("专业".equals(cat)) catDesc = "专业、条理清楚、信息完整";
                    else catDesc = "委婉拒绝、不伤和气、给出替代方案";

                    String prompt = (mine
                            ? "下面是我自己刚发出的一条微信消息，请给出 5 条我可以接着补充的说法。"
                            : "下面是对方发来的一条微信消息，请给出 5 条我可以回复的说法。")
                            + "\n风格要求：" + catDesc + "。"
                            + "\n每条不超过 30 字，口语化，必须紧扣原句里的具体内容（人、事、地点、数字、物品）。"
                            + "\n严格每行一条，格式：候选|<内容>，共 5 行，不要编号、不要解释。";
                    String userIn = (mine ? "我发的：" : "对方发的：") + focus;
                    String note = aiExtraNote == null ? "" : aiExtraNote.trim();
                    if (ana.length() > 0 || note.length() > 0) {
                        StringBuilder ub = new StringBuilder();
                        if (note.length() > 0) {
                            ub.append("用户补充说明（优先遵守）：").append(note).append('\n');
                        }
                        if (ana.length() > 0) {
                            ub.append("已确定的分析结论（与之保持一致）：\n").append(ana).append('\n');
                        }
                        ub.append("原句：").append(focus);
                        userIn = ub.toString();
                    }
                    String raw = callAiRaw(prompt, userIn);
                    for (String ln : raw.split("\n")) {
                        String v = ln.trim();
                        if (v.length() == 0) continue;
                        if (v.startsWith("-") || v.startsWith("•") || v.startsWith("*")) v = v.substring(1).trim();
                        if (v.startsWith("候选")) v = v.substring(2).trim();
                        if (v.startsWith("|")) v = v.substring(1).trim();
                        v = v.replaceFirst("^[0-9]+[.、)]\\s*", "").trim();
                        v = v.replaceFirst("^[\"“]", "").replaceFirst("[\"”]$", "");
                        if (v.length() < 3) continue;
                        int c = v.indexOf('|');
                        if (c >= 0) v = v.substring(c + 1).trim();
                        v = v.replace("：", "").trim();
                        if (v.length() < 3) continue;
                        out.add(v);
                        if (out.size() >= 5) break;
                    }
                } catch (Throwable t) { log("AI|fetchCat err " + t); }
                final java.util.ArrayList<String> res = out;
                new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                    @Override public void run() {
                        if (!res.isEmpty()) cache.put(cat, res);
                        if (refresh != null) refresh.run();
                    }
                });
            }
        }).start();
    }

    /** 兜底：直接把聊天页当前可见的消息行拼成上下文 */
    private static String contextFromVisibleRows() {
        StringBuilder sb = new StringBuilder();
        try {
            android.app.Activity ca = chatAct;
            if (ca == null) return "";
            android.view.View decor = ca.getWindow().getDecorView();
            android.view.ViewGroup list = findMsgList(decor);
            if (list == null) return "";
            for (int i = 0; i < list.getChildCount(); i++) {
                android.view.View row = list.getChildAt(i);
                if (row == null) continue;
                String t = renderedTextOf(row);
                if (t == null) continue;
                t = t.replace("\n", " ").trim();
                if (t.length() == 0) continue;
                boolean left = leftByAvatar(row, row);
                if (t.length() > 200) t = t.substring(0, 200);
                sb.append(left ? "对方: " : "我: ").append(t).append('\n');
            }
        } catch (Throwable ignore) { }
        return sb.toString().trim();
    }

