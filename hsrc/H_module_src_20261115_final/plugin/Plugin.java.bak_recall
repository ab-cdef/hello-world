    /** 消息入库后尽快刷新一次气泡与时间（下一帧执行，避免在 DB 回调里做视图操作） */
    /** 是否是微信自带的时间分隔行（开启增强时间后要隐藏，避免两个时间重复） */
    /** 这一行有没有头像 —— 有头像说明是真人消息，绝不能因为文案像时间/提示就隐藏 */
    private static boolean rowHasAvatar(android.view.View row) {
        try {
            java.util.ArrayList<android.widget.ImageView> ivs = new java.util.ArrayList<android.widget.ImageView>();
            collectImages(row, ivs, 0);
            for (android.widget.ImageView iv : ivs) {
                String cn = iv.getClass().getName();
                if (cn.contains("Avatar") || cn.contains("avatar")) return true;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    private static boolean isNativeTimeRow(String t) {
        if (t == null) return false;
        String s = t.trim();
        if (s.length() == 0 || s.length() > 24) return false;
        try {
            if (s.matches("\\d{1,2}:\\d{2}")) return true;
            if (s.matches("(昨天|前天)\\s*\\d{1,2}:\\d{2}")) return true;
            if (s.matches("星期[一二三四五六日天]\\s*\\d{1,2}:\\d{2}")) return true;
            if (s.matches("\\d{4}年\\d{1,2}月\\d{1,2}日\\s*\\d{1,2}:\\d{2}")) return true;
            if (s.matches("\\d{1,2}月\\d{1,2}日\\s*\\d{1,2}:\\d{2}")) return true;
            // 带秒/点分的长格式（用户以前设过「原生时间格式」会变成这样）
            if (s.matches("\\d{4}[./-]\\d{1,2}[./-]\\d{1,2}\\s*\\d{1,2}:\\d{2}(:\\d{2})?")) return true;
            if (s.matches("\\d{1,2}[./-]\\d{1,2}\\s*\\d{1,2}:\\d{2}(:\\d{2})?")) return true;
        } catch (Throwable ignore) { }
        return false;
    }

    private static void kickStyleSoon() {
        try {
            android.app.Activity tmp = chatAct;
            if (tmp == null) tmp = lastAct;             // 8.0.80 部分聊天页 chatAct 为空，用 lastAct 兜底
            // 会话已解析出来也算在聊天页（同工具栏门控的修法）
            if (tmp == null || (!inChat && chatTalker == null && !isInChatUi())) return;
            final android.app.Activity a = tmp;
            new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                @Override public void run() {
                    try { if (isInChatUi()) styleChatRowsByAdapter(a); } catch (Throwable ignore) { }
                }
            });
        } catch (Throwable ignore) { }
    }

    /** 结果判定：0 正常 / 1 僵尸 / -1 未知（宁可未知，不误判僵尸） */
    private static int zJudge(int errType, int errCode, String text) {
        String t = text == null ? "" : text;
        if (t.contains("不是你的好友") || t.contains("还不是你的好友") || t.contains("你还不是")
                || t.contains("对方不是") || t.contains("已删除")
                || t.contains("非好友") || t.contains("不是好友")) return 1;
        if (errType == 0 && errCode == 0) return 0;
        if (errType == 4 || errType == -1) return -1;
        if (t.contains("好友") && (t.contains("不存在") || t.contains("无效"))) return 1;
        return -1;
    }

    /** 把位图裁成圆形 drawable（与微信会话列表头像形状一致） */
    private static android.graphics.drawable.Drawable circleBitmap(android.content.Context ctx,
                                                                   android.graphics.Bitmap src) {
        try {
            int sz = Math.min(src.getWidth(), src.getHeight());
            android.graphics.Bitmap out = android.graphics.Bitmap.createBitmap(sz, sz,
                    android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas cv = new android.graphics.Canvas(out);
            android.graphics.Paint pt = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
            pt.setColor(0xFFFFFFFF);
            cv.drawCircle(sz / 2f, sz / 2f, sz / 2f, pt);
            pt.setXfermode(new android.graphics.PorterDuffXfermode(
                    android.graphics.PorterDuff.Mode.SRC_IN));
            cv.drawBitmap(src, new android.graphics.Rect(0, 0, sz, sz),
                    new android.graphics.Rect(0, 0, sz, sz), pt);
            android.graphics.drawable.BitmapDrawable bd =
                    new android.graphics.drawable.BitmapDrawable(ctx.getResources(), out);
            bd.setAntiAlias(true);
            return bd;
        } catch (Throwable t) {
            android.graphics.drawable.BitmapDrawable bd =
                    new android.graphics.drawable.BitmapDrawable(ctx.getResources(), src);
            bd.setAntiAlias(true);
            return bd;
        }
    }

    /** 把一行里所有「像头像」的 ImageView 裁成圆形（跟随 thRoundAvatar 开关） */
    private static void roundAvatarsInRow(android.view.View row) {
        try {
            if (!cfg().optBoolean("thRoundAvatar", true)) return;
            java.util.ArrayList<android.view.View> vs = new java.util.ArrayList<android.view.View>();
            collectImageViews(row, vs, 0);
            for (android.view.View v : vs) {
                if (!(v instanceof android.widget.ImageView)) continue;
                int w = v.getWidth() > 0 ? v.getWidth() : v.getLayoutParams() == null ? 0 : v.getLayoutParams().width;
                int h = v.getHeight() > 0 ? v.getHeight() : v.getLayoutParams() == null ? 0 : v.getLayoutParams().height;
                if (w <= 0 || h <= 0) continue;
                float dpw = w / v.getResources().getDisplayMetrics().density;
                if (dpw < 28 || dpw > 96) continue;
                if (w * 1.0f / h < 0.78f || w * 1.0f / h > 1.28f) continue;
                makeRound(v);
            }
        } catch (Throwable ignore) { }
    }

    private static void collectImageViews(android.view.View v, java.util.List<android.view.View> out, int d) {
        if (v == null || d > 4) return;
        if (v instanceof android.widget.ImageView) out.add(v);
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) collectImageViews(g.getChildAt(i), out, d + 1);
        }
    }

    /* === 性能：时间数组缓存（避免 250ms 一次数据库查询） === */
    private static long[] ctCache = null;
    private static String ctCacheTalker = null;
    private static long ctCacheAt = 0;
    private static int ctCacheCnt = -1;

    private static boolean[] ctSend = null;
    private static long ctSendAt = 0;
    private static String ctSendTalker = null;

    /** 与 cachedTimes() 同序的 isSend 数组：true=我发的 */
    private static boolean[] cachedIsSend() {
        try {
            if (!cfg().optBoolean("msgTimeEnh", false) || chatTalker == null) return null;
            long now = System.currentTimeMillis();
            if (ctSend != null && ctSendTalker != null && ctSendTalker.equals(chatTalker)
                    && now - ctSendAt < 3000) return ctSend;
            java.util.List<Object[]> rr = queryRows(
                    "select isSend from message where talker='" + chatTalker.replace("'", "''")
                            + "' order by createTime desc limit 200", 1);
            boolean[] arr = new boolean[rr.size()];
            for (int k = 0; k < rr.size(); k++) {
                try { arr[k] = "1".equals(String.valueOf(rr.get(k)[0]).trim()); } catch (Throwable ignore) { }
            }
            ctSend = arr; ctSendTalker = chatTalker; ctSendAt = now;
            return arr;
        } catch (Throwable t) {
            return ctSend;
        }
    }

    private static long[] cachedTimes() {
        try {
            boolean any = cfg().optBoolean("msgTimeEnh", false);
            if (!any || chatTalker == null) return null;
            long now = System.currentTimeMillis();
            boolean sameTalker = ctCacheTalker != null && ctCacheTalker.equals(chatTalker);
            // 2 秒内 && 同一会话 && 消息条数没变 → 直接复用
            if (ctCache != null && sameTalker && now - ctCacheAt < 2000) return ctCache;
            int cnt = -1;
            try {
                java.util.List<Object[]> c1 = queryRows(
                        "select count(*) from message where talker='" + chatTalker.replace("'", "''") + "'", 1);
                if (!c1.isEmpty()) cnt = Integer.parseInt(String.valueOf(c1.get(0)[0]).trim());
            } catch (Throwable ignore) { }
            if (ctCache != null && sameTalker && cnt == ctCacheCnt) { ctCacheAt = now; return ctCache; }
            java.util.List<Object[]> rr = queryRows(
                    "select createTime from message where talker='" + chatTalker.replace("'", "''")
                            + "' order by createTime desc limit 200", 1);
            long[] arr = new long[rr.size()];
            for (int k = 0; k < rr.size(); k++) {
                try { arr[k] = Long.parseLong(String.valueOf(rr.get(k)[0]).trim()); } catch (Throwable ignore) { }
            }
            ctCache = arr; ctCacheTalker = chatTalker; ctCacheAt = now; ctCacheCnt = cnt;
            return arr;
        } catch (Throwable t) {
            return ctCache;
        }
    }

    /* === UI 统一：把所有原生 AlertDialog 套成 H 设置的白色圆角卡片风格 === */
    private static void installDialogSkin(ClassLoader app) {
        try {
            XC_MethodHook hook = new XC_MethodHook() {
                @Override
                protected void afterHookedMethod(MethodHookParam p) {
                    try { skinDialog((android.app.Dialog) p.thisObject); } catch (Throwable ignore) { }
                }
            };
            // AlertDialog 自己实现了 show()，普通 Dialog 走 Dialog.show()，两边都要钩
            XposedBridge.hookAllMethods(android.app.AlertDialog.class, "show", hook);
            XposedBridge.hookAllMethods(android.app.Dialog.class, "show", hook);
            log("hooked dialog skin");
        } catch (Throwable t) {
            log("dialog skin err " + t);
        }
    }

    private static void skinDialog(final android.app.Dialog d) {
        if (d == null) return;
        // H 面板自己有深色科技配色，别被统一弹窗皮肤刷成深色字
        if (d == settingsDlg) return;
        // 群聊总览弹窗自带磨砂卡 + 头图白标题，同样不套统一皮肤
        if (d == hubDialog) return;
        // 密友面板自带红白卡配色，也不套皮肤
        if (d == miyouDialog) return;
        final android.view.Window w = d.getWindow();
        if (w == null) return;
        if (!cfg().optBoolean("uiSkin", true)) return;
        try {
            float r = 20 * d.getContext().getResources().getDisplayMetrics().density;
            float rim = 1.2f * d.getContext().getResources().getDisplayMetrics().density;
            // 实底浅色卡 + 主题红描边（去掉原来的图片磨砂层）
            android.graphics.drawable.Drawable bg = techCard(0xF7FFFFFF, 0x55E2231A, r, rim);
            w.setBackgroundDrawable(bg);
        } catch (Throwable ignore) { }
        // 按 H 设置配色重刷文字
        final android.view.View decor = w.getDecorView();
        decor.post(new Runnable() {
            @Override public void run() {
                try {
                    paintDialogText(decor, 0);
                    // 宽度收到 86%
                    android.util.DisplayMetrics dm = d.getContext().getResources().getDisplayMetrics();
                    int want = (int) (dm.widthPixels * 0.86f);
                    if (want > 0) {
                        android.view.ViewGroup.LayoutParams lp = decor.getLayoutParams();
                        if (lp != null) { lp.width = want; decor.setLayoutParams(lp); }
                    }
                } catch (Throwable ignore) { }
            }
        });
    }

    private static void paintDialogText(android.view.View v, int depth) {
        if (v == null || depth > 14) return;
        try {
            if (v instanceof android.widget.TextView) {
                android.widget.TextView tv = (android.widget.TextView) v;
                android.content.Context c = tv.getContext();
                boolean btn = false;
                try {
                    android.view.ViewParent pp = tv.getParent();
                    if (pp instanceof android.view.ViewGroup) {
                        String cn = pp.getClass().getName();
                        if (cn.contains("button") || cn.contains("Button")) btn = true;
                    }
                } catch (Throwable ignore) { }
                float sp = tv.getTextSize() / c.getResources().getDisplayMetrics().scaledDensity;
                if (btn) tv.setTextColor(0xFFC8102E);                 // 按钮：主题红
                else if (sp >= 16) tv.setTextColor(0xFF141418);       // 标题：深色
                else tv.setTextColor(0xFF6B6B76);                     // 正文：灰
            } else if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) paintDialogText(g.getChildAt(i), depth + 1);
            }
        } catch (Throwable ignore) { }
    }

    /** 取控件里真正的文本：优先用 MMNeat 记录值，其次 TextView，再反射 CharSequence 字段 */
    private static String textOfView(android.view.View v) {
        if (v == null) return null;
        try {
            Object t0 = v.getTag(0x0f0f0f05);
            if (t0 instanceof CharSequence && ((CharSequence) t0).length() > 0) return t0.toString();
        } catch (Throwable ignore) { }
        if (v instanceof android.widget.TextView) {
            CharSequence cs = ((android.widget.TextView) v).getText();
            if (cs != null && cs.length() > 0) return cs.toString();
        }
        try {
            Class<?> k = v.getClass();
            while (k != null && k != Object.class) {
                for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                    if (!CharSequence.class.isAssignableFrom(f.getType())) continue;
                    f.setAccessible(true);
                    Object val = f.get(v);
                    if (val instanceof CharSequence) {
                        String s2 = val.toString();
                        if (s2.length() > 0 && !s2.startsWith("View.Content")) return s2;
                    }
                }
                k = k.getSuperclass();
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 在可见行上主动应用文本替换规则（不依赖微信重新 setText） */
    private static void applyReplacementsFile(android.view.View row) {
        try {
            org.json.JSONArray rules = cfg().optJSONArray("textReplace");
            if (rules == null || rules.length() == 0) return;
            java.util.ArrayList<android.view.View> vs = new java.util.ArrayList<android.view.View>();
            collectNeat(row, vs, 0);
            for (android.view.View v : vs) {
                Object tg = v.getTag(0x0f0f0f05);
                if (!(tg instanceof CharSequence)) continue;
                String cur = tg.toString();
                String hit = liveReplace(cur);
                for (int i = 0; hit == null && i < rules.length(); i++) {
                    String rule = rules.optString(i, "");
                    int eq = rule.indexOf('=');
                    if (eq <= 0) continue;
                    if (cur.equals(rule.substring(0, eq))) hit = rule.substring(eq + 1);
                }
                if (hit == null) continue;
                {
                    String to = expandPhrase(hit);
                    boolean ok = false;
                    try {
                        java.lang.reflect.Method m = v.getClass().getMethod("c", CharSequence.class,
                                android.widget.TextView.BufferType.class, Boolean.class);
                        m.invoke(v, to, android.widget.TextView.BufferType.NORMAL, Boolean.FALSE);
                        ok = true;
                    } catch (Throwable ignore) { }
                    if (!ok) {
                        try {
                            java.lang.reflect.Method m2 = v.getClass().getMethod("b", CharSequence.class);
                            m2.invoke(v, to);
                            ok = true;
                        } catch (Throwable ignore) { }
                    }
                    try { v.setTag(0x0f0f0f05, to); } catch (Throwable ignore) { }
                    log("TXTREPL2|" + cur + "->" + to + " ok=" + ok);
                }
            }
        } catch (Throwable ignore) { }
    }

    private static void collectNeat(android.view.View v, java.util.List<android.view.View> out, int d) {
        if (v == null || d > 5) return;
        if (v.getClass().getName().contains("MMNeat7extView")) out.add(v);
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) collectNeat(g.getChildAt(i), out, d + 1);
        }
    }

    /* 内存规则：保存配置失败时也能立即生效 */
    private static final java.util.Map<String, String> liveRules =
            new java.util.concurrent.ConcurrentHashMap<String, String>();

    private static String liveReplace(String txt) {
        if (txt == null) return null;
        String to = liveRules.get(txt);
        if (to != null) return to;
        try {
            org.json.JSONArray rules = cfg().optJSONArray("textReplace");
            if (rules == null) return null;
            for (int i = 0; i < rules.length(); i++) {
                String rule = rules.optString(i, "");
                int eq = rule.indexOf('=');
                if (eq <= 0) continue;
                if (txt.equals(rule.substring(0, eq))) return rule.substring(eq + 1);
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /* 精确改字：只作用于某一条消息（按 会话+从底部数的位置 定位） */
    private static final java.util.Map<String, String> liveRulesAt =
            new java.util.concurrent.ConcurrentHashMap<String, String>();

    private static String atKey(String talker, int posFromBottom) {
        return (talker == null ? "" : talker) + "|" + posFromBottom;
    }

    /** 这条 row 在消息列表里从底部数是第几条（0=最新一条） */
    private static int rowIndexFromBottom(android.view.View row) {
        try {
            if (row == null) return -1;
            android.view.ViewParent par = row.getParent();
            if (!(par instanceof android.view.ViewGroup)) return -1;
            android.view.ViewGroup g = (android.view.ViewGroup) par;
            int idx = -1;
            for (int i = 0; i < g.getChildCount(); i++) {
                if (g.getChildAt(i) == row) { idx = i; break; }
            }
            if (idx < 0) return -1;
            return g.getChildCount() - 1 - idx;
        } catch (Throwable t) { return -1; }
    }

    /** 把这一行的消息文本改成 to（只作用于这一条） */
    private static void applyOneReplacement(android.view.View row, String to) {
        try {
            java.util.ArrayList<android.view.View> vs = new java.util.ArrayList<android.view.View>();
            collectNeat(row, vs, 0);
            for (android.view.View v : vs) {
                Object tg = v.getTag(0x0f0f0f05);
                String cur = renderedTextOf(v);
                if (cur == null && tg instanceof CharSequence) cur = tg.toString();
                if (cur != null && to.equals(cur)) continue;

                boolean ok = false;
                // ① c(CharSequence, BufferType, Boolean=false)
                ok = invokeSetText(v, "c", new Class<?>[]{CharSequence.class,
                        android.widget.TextView.BufferType.class, Boolean.class},
                        new Object[]{to, android.widget.TextView.BufferType.NORMAL, Boolean.FALSE});
                String after = renderedTextOf(v);
                // ② 没生效则 b(CharSequence)
                if (!ok || (after != null && !to.equals(after))) {
                    boolean ok2 = invokeSetText(v, "b", new Class<?>[]{CharSequence.class}, new Object[]{to});
                    after = renderedTextOf(v);
                    if (ok2) ok = true;
                }
                // ③ 还不行，第三个参数换 true（解析表情模式）
                if (after != null && !to.equals(after)) {
                    try {
                        java.lang.reflect.Method m3 = v.getClass().getMethod("c", CharSequence.class,
                                android.widget.TextView.BufferType.class, Boolean.class);
                        m3.invoke(v, to, android.widget.TextView.BufferType.NORMAL, Boolean.TRUE);
                        after = renderedTextOf(v);
                    } catch (Throwable ignore) { }
                }
                try { v.setTag(0x0f0f0f05, to); } catch (Throwable ignore) { }
                log("TXTREPL_ONE|" + cur + "->" + to + " ok=" + ok + " after=" + after);
                // 微信对纯英文/数字的设文本会被吞掉 → 改用覆盖绘制
                if (after == null || !to.equals(after)) {
                    try { overlayTextReplace(v, to); } catch (Throwable ignore) { }
                }
                break;
            }
        } catch (Throwable ignore) { }
    }

    private static boolean invokeSetText(android.view.View v, String name, Class<?>[] types, Object[] args) {
        try {
            java.lang.reflect.Method m = v.getClass().getMethod(name, types);
            m.invoke(v, args);
            return true;
        } catch (Throwable t) {
            try {
                java.lang.reflect.Method m = v.getClass().getDeclaredMethod(name, types);
                m.setAccessible(true);
                m.invoke(v, args);
                return true;
            } catch (Throwable t2) { return false; }
        }
    }

    /** 读控件当前实际渲染的文字（MMNeat7extView 没有 getText，靠反射 CharSequence 字段） */
    private static String renderedTextOf(android.view.View v) {
        try {
            java.lang.reflect.Method m = v.getClass().getMethod("getText");
            Object r = m.invoke(v);
            if (r instanceof CharSequence) return r.toString();
        } catch (Throwable ignore) { }
        try {
            java.lang.reflect.Method mw = v.getClass().getMethod("getWrappedTextView");
            Object rw = mw.invoke(v);
            if (rw instanceof android.widget.TextView) {
                CharSequence cs = ((android.widget.TextView) rw).getText();
                if (cs != null) return cs.toString();
            }
        } catch (Throwable ignore) { }
        try {
            Class<?> k = v.getClass();
            while (k != null && k != Object.class) {
                for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                    if (!CharSequence.class.isAssignableFrom(f.getType())) continue;
                    f.setAccessible(true);
                    Object val = f.get(v);
                    if (val instanceof CharSequence) {
                        String s2 = val.toString();
                        if (s2.length() > 0 && !s2.startsWith("View.Content")) return s2;
                    }
                }
                k = k.getSuperclass();
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 从锚点向外找消息列表的那一行（列表的直接子项） */
    private static android.view.View rowOf(android.view.View v) {
        try {
            android.view.View cur = v;
            for (int d = 0; d < 8 && cur != null; d++) {
                android.view.ViewParent p = cur.getParent();
                if (p instanceof android.view.ViewGroup) {
                    String cn = p.getClass().getName();
                    if (cn.contains("RecyclerView") || cn.contains("ScrollControl")) return cur;
                }
                if (!(p instanceof android.view.View)) break;
                cur = (android.view.View) p;
            }
            return cur;
        } catch (Throwable t) { return null; }
    }

    /** 只改这一条消息：talker + 从底部数的位置 定位 */
    private static void askReplaceAt(final android.app.Activity act, final String orig,
                                     final String talker, final int pfb, final long ts) {
        try {
            if (ts <= 0) {
                toast("没定位到这一条，未修改（请重新长按再试）");
                log("TXTREPL|abort no ts orig=" + orig);
                return;
            }
            final android.widget.EditText et = new android.widget.EditText(act);
            et.setText("");
            et.setHint("新的文字");
            new android.app.AlertDialog.Builder(act)
                    .setTitle("只改这一条")
                    .setMessage("原文：" + orig + (ts > 0 ? "\n" + fmtTs(ts) : ""))
                    .setView(et)
                    .setPositiveButton("保存并生效", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                String neu = et.getText().toString();
                                if (neu.length() == 0 || neu.equals(orig)) return;
                                boolean done = false;
                                if (ts > 0) {
                                    saveTsRule(ts, neu);
                                    clearOverlayMetaNear(ts);
                                    done = true;
                                }
                                if (done) {
                                    refreshChatList();
                                    toast("已修改这一条");
                                } else if (pfb >= 0) {
                                    liveRulesAt.put(atKey(talker, pfb), neu);
                                    log("TXTREPL_AT|" + talker + "#" + pfb + " " + orig + "->" + neu);
                                    toast("已即时替换（未改数据库）");
                                } else {
                                    log("TXTREPL_AT_NOTS|" + orig);
                                    toast("未定位到这一条，未修改");
                                }
                            } catch (Throwable t) { toast("保存失败：" + t); }
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) { }
    }

    /** 永久修改某一条消息（直接改数据库 content），带内容校验，避免改错人 */
    private static boolean dbReplaceOne(String talker, int pfb, long ts, String orig, String neu) {
        try {
            if (talker == null || talker.length() == 0) return false;
            String tk = talker.replace("'", "''");

            // ① 最精确：按「会话 + 消息时间戳」定位唯一一条
            if (ts > 0) {
                try {
                    java.util.List<Object[]> ex = queryRows(
                            "select msgId, content from message where talker='" + tk
                                    + "' and createTime=" + ts + " limit 1", 2);
                    if (ex.isEmpty()) {
                        // 秒/毫秒兜底
                        long alt = ts > 100000000000L ? ts / 1000L : ts * 1000L;
                        ex = queryRows("select msgId, content from message where talker='" + tk
                                + "' and createTime=" + alt + " limit 1", 2);
                    }
                    if (!ex.isEmpty()) {
                        String mid = ex.get(0)[0] == null ? "" : ex.get(0)[0].toString();
                        String oc = ex.get(0)[1] == null ? "" : ex.get(0)[1].toString();
                        String nc = (orig != null && oc.contains(orig.trim())) ? oc.replace(orig.trim(), neu) : neu;
                        if (updateMsgContent(mid, nc)) {
                            log("DBREPL|ts ok msgId=" + mid + " old=" + oc + " new=" + nc);
                            return true;
                        }
                    }
                } catch (Throwable ignore) { }
            }
            int lim = Math.max(pfb + 8, 16);
            java.util.List<Object[]> rows = queryRows(
                    "select msgId, content from message where talker='" + tk
                            + "' order by createTime desc limit " + lim, 2);
            if (rows.isEmpty()) return false;
            // 没有精确时间戳时：只有「全文里唯一一条匹配」才敢改，否则放弃，避免改错
            int hit = -1;
            int matches = 0;
            int exact = -1;
            int exactN = 0;
            if (orig != null) {
                String o = orig.trim();
                for (int i = 0; i < rows.size(); i++) {
                    String c0 = rows.get(i)[1] == null ? "" : rows.get(i)[1].toString();
                    if (c0.equals(o)) { exactN++; if (exact < 0) exact = i; }
                    if (c0.contains(o)) { matches++; if (hit < 0) hit = i; }
                }
            }
            if (exactN == 1) { hit = exact; matches = 1; }
            else if (exactN > 1) { log("DBREPL|ambiguous exact n=" + exactN + " ts=0 -> abort"); return false; }
            if (hit < 0) { log("DBREPL|no match"); return false; }
            if (matches > 1) { log("DBREPL|ambiguous n=" + matches + " ts=0 -> abort"); return false; }

            String msgId = rows.get(hit)[0] == null ? "" : rows.get(hit)[0].toString();
            String oldC = rows.get(hit)[1] == null ? "" : rows.get(hit)[1].toString();
            String newC = oldC.replace(orig.trim(), neu);
            Object h = msgDbHandle();
            if (h == null) { log("DBREPL|no db"); return false; }
            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, "update message set content='" + newC.replace("'", "''")
                            + "' where msgId='" + msgId.replace("'", "''") + "'", new String[0]);
            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
            log("DBREPL|ok msgId=" + msgId + " old=" + oldC + " new=" + newC);
            return true;
        } catch (Throwable t) {
            log("DBREPL|err " + t);
            return false;
        }
    }

    /** 通知聊天列表重绘 */
    private static void refreshChatList() {
        try {
            android.app.Activity act = chatAct;
            if (act == null) return;
            android.view.ViewGroup list = findMsgList(act.getWindow().getDecorView());
            if (list == null) return;
            Object ad = list.getClass().getMethod("getAdapter").invoke(list);
            if (ad instanceof android.widget.BaseAdapter) {
                ((android.widget.BaseAdapter) ad).notifyDataSetChanged();
            } else {
                ad.getClass().getMethod("notifyDataSetChanged").invoke(ad);
            }
        } catch (Throwable ignore) { }
    }

    /** 用屏幕坐标判断锚点落在消息列表的第几个子项；返回从底部数的索引 */
    private static int rowIndexFromBottomByPoint(android.view.View anchor) {
        try {
            if (anchor == null) return -1;
            android.app.Activity act = chatAct;
            if (act == null) return -1;
            android.view.ViewGroup list = findMsgList(act.getWindow().getDecorView());
            if (list == null) return -1;
            int[] loc = new int[2];
            anchor.getLocationOnScreen(loc);
            int ax = loc[0] + Math.max(1, anchor.getWidth() / 2);
            int ay = loc[1] + Math.max(1, anchor.getHeight() / 2);
            int[] ll = new int[2];
            list.getLocationOnScreen(ll);
            for (int i = 0; i < list.getChildCount(); i++) {
                android.view.View ch = list.getChildAt(i);
                if (ch == null || ch.getVisibility() != android.view.View.VISIBLE) continue;
                int top = ll[1] + ch.getTop();
                int bot = ll[1] + ch.getBottom();
                if (ay >= top && ay < bot) {
                    int left = ll[0] + ch.getLeft();
                    int right = ll[0] + ch.getRight();
                    if (ax >= left && ax <= right) return list.getChildCount() - 1 - i;
                }
            }
            return -1;
        } catch (Throwable t) { return -1; }
    }

    /** 取从底部第 pfb 条消息的时间戳（用于精确定位数据库行） */
    private static long tsOfRow(int pfb) {
        try {
            long[] arr = cachedTimes();
            if (arr == null || pfb < 0 || pfb >= arr.length) return 0;
            long v = arr[pfb];
            return v < 100000000000L ? v * 1000L : v;
        } catch (Throwable t) { return 0; }
    }

    private static boolean updateMsgContent(String msgId, String newC) {
        try {
            Object h = msgDbHandle();
            if (h == null) return false;
            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, "update message set content='" + newC.replace("'", "''")
                            + "' where msgId='" + msgId.replace("'", "''") + "'", new String[0]);
            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
            return true;
        } catch (Throwable t) { log("DBREPL|upd err " + t); return false; }
    }

    /** 从锚点向上找该行的消息时间戳（行扫描时打在 0x0f0f0f06 上） */
    private static long tsOfAnchor(android.view.View v) {
        try {
            android.view.View cur = v;
            for (int d = 0; d < 10 && cur != null; d++) {
                Object t = cur.getTag(0x0f0f0f06);
                if (t instanceof Long) return ((Long) t).longValue();
                android.view.ViewParent p = cur.getParent();
                if (!(p instanceof android.view.View)) break;
                cur = (android.view.View) p;
            }
        } catch (Throwable ignore) { }
        return 0;
    }

    private static String fmtTs(long ms) {
        try { return new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date(ms)); }
        catch (Throwable t) { return ""; }
    }

    /** 按「包含关系」判断锚点属于列表的哪一行（不依赖父类名） */
    private static int rowIndexFromBottomByContainment(android.view.View anchor) {
        try {
            if (anchor == null || chatAct == null) return -1;
            android.view.ViewGroup list = findMsgList(chatAct.getWindow().getDecorView());
            if (list == null) return -1;
            for (int i = 0; i < list.getChildCount(); i++) {
                android.view.View child = list.getChildAt(i);
                android.view.View cur = anchor;
                for (int d = 0; d < 12 && cur != null; d++) {
                    if (cur == child) return list.getChildCount() - 1 - i;
                    android.view.ViewParent p = cur.getParent();
                    if (!(p instanceof android.view.View)) break;
                    cur = (android.view.View) p;
                }
            }
            return -1;
        } catch (Throwable t) { return -1; }
    }

    /* 按消息时间戳的显示层替换（只作用于那一条，不写数据库） */
    private static final java.util.Map<Long, String> liveRulesTs =
            new java.util.concurrent.ConcurrentHashMap<Long, String>();
    private static boolean tsRulesLoaded = false;

    private static void loadTsRules() {
        if (tsRulesLoaded) return;
        tsRulesLoaded = true;
        try {
            org.json.JSONArray arr = cfg().optJSONArray("textReplaceTs");
            if (arr == null) return;
            for (int i = 0; i < arr.length(); i++) {
                String rule = arr.optString(i, "");
                int eq = rule.indexOf('=');
                if (eq <= 0) continue;
                try { liveRulesTs.put(Long.parseLong(rule.substring(0, eq)), rule.substring(eq + 1)); } catch (Throwable ignore) { }
            }
        } catch (Throwable ignore) { }
    }

    private static void saveTsRule(long ts, String to) {
        liveRulesTs.put(ts, to);
        try {
            JSONObject o = readCfg();
            org.json.JSONArray arr = o.optJSONArray("textReplaceTs");
            org.json.JSONArray out = new org.json.JSONArray();
            if (arr != null) {
                for (int i = 0; i < arr.length(); i++) {
                    String r = arr.optString(i, "");
                    if (!r.startsWith(ts + "=")) out.put(r);
                }
            }
            out.put(ts + "=" + to);
            o.put("textReplaceTs", out);
            writeCfg(o);
            log("TXTSAVE|ts=" + ts + " -> " + to + " n=" + out.length());
        } catch (Throwable t) { log("TXTSAVE|err " + t); }
    }

    /** 兜底：直接在气泡上盖一层同色圆角 + 新文字（适用于英文/数字被微信吞掉的情况） */
    private static void overlayTextReplace(final android.view.View v, final String txt) {
        try {
            final android.view.ViewOverlay ov = v.getOverlay();
            Object old = v.getTag(0x0f0f0f07);
            if (old instanceof android.graphics.drawable.Drawable) {
                // 已经用相同的文字、相同的尺寸画过 → 不重复处理（避免每 400ms 重画造成闪烁/耗电）
                Object meta = v.getTag(0x0f0f0f08);
                String want = txt + "@" + v.getWidth() + "x" + v.getHeight();
                if (want.equals(meta)) return;
                try { ov.remove((android.graphics.drawable.Drawable) old); } catch (Throwable ignore) { }
            }
            int bgColor = 0xFFFFFFFF;
            android.graphics.drawable.Drawable bg = v.getBackground();
            if (bg instanceof android.graphics.drawable.GradientDrawable) {
                try {
                    android.graphics.drawable.GradientDrawable g = (android.graphics.drawable.GradientDrawable) bg;
                    java.lang.reflect.Method m = android.graphics.drawable.GradientDrawable.class.getMethod("getColor");
                    Object c = m.invoke(g);
                    if (c instanceof android.content.res.ColorStateList) {
                        bgColor = ((android.content.res.ColorStateList) c).getDefaultColor();
                    } else if (c instanceof Integer) {
                        bgColor = (Integer) c;
                    }
                } catch (Throwable ignore) { }
            }
            final int fill = bgColor;
            // 探原控件的字号与文字颜色
            float tsz = 0;
            int tcol = 0;
            try {
                Class<?> k = v.getClass();
                while (k != null && k != Object.class) {
                    for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                        if (!android.graphics.Paint.class.isAssignableFrom(f.getType())) continue;
                        f.setAccessible(true);
                        Object pv = f.get(v);
                        if (pv instanceof android.graphics.Paint) {
                            android.graphics.Paint pt = (android.graphics.Paint) pv;
                            if (pt.getTextSize() > 0) tsz = pt.getTextSize();
                            tcol = pt.getColor();
                            if (tsz > 0) break;
                        }
                    }
                    if (tsz > 0) break;
                    k = k.getSuperclass();
                }
            } catch (Throwable ignore) { }
            final float txtSize = tsz;
            final int txtColor = tcol;
            android.graphics.drawable.Drawable d = new android.graphics.drawable.Drawable() {
                private final android.graphics.Paint p = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
                private final android.graphics.RectF rf = new android.graphics.RectF();
                @Override public void draw(android.graphics.Canvas c) {
                    try {
                        android.graphics.Rect b = getBounds();
                        float r = Math.min(b.height(), b.width()) * 0.18f;
                        if (r > 26) r = 26;
                        rf.set(b.left + 1, b.top + 1, b.right - 1, b.bottom - 1);
                        p.setColor(fill);
                        p.setStyle(android.graphics.Paint.Style.FILL);
                        c.drawRoundRect(rf, r, r, p);
                        // 文字：沿用原控件的字号/颜色/居中方式
                        int lum = (((fill >> 16) & 0xff) * 299 + ((fill >> 8) & 0xff) * 587
                                + (fill & 0xff) * 114) / 1000;
                        p.setColor(txtColor != 0 ? txtColor : (lum > 150 ? 0xFF1A1E2B : 0xFFFFFFFF));
                        p.setTextSize(txtSize > 0 ? txtSize : Math.max(12f, b.height() * 0.34f));
                        p.setTextAlign(android.graphics.Paint.Align.CENTER);
                        float maxW = b.width() - 24;
                        float tw = p.measureText(txt);
                        if (tw > maxW && maxW > 10) p.setTextSize(p.getTextSize() * maxW / tw);
                        android.graphics.Paint.FontMetrics fm = p.getFontMetrics();
                        float baseY = b.top + (b.height() - (fm.descent - fm.ascent)) / 2f - fm.ascent;
                        c.drawText(txt, b.centerX(), baseY, p);
                    } catch (Throwable ignore) { }
                }
                @Override public void setAlpha(int alpha) { }
                @Override public void setColorFilter(android.graphics.ColorFilter cf) { }
                @Override public int getOpacity() { return android.graphics.PixelFormat.TRANSLUCENT; }
            };
            d.setBounds(0, 0, v.getWidth() > 0 ? v.getWidth() : 200, v.getHeight() > 0 ? v.getHeight() : 100);
            ov.add(d);
            v.setTag(0x0f0f0f07, d);
            v.setTag(0x0f0f0f08, txt + "@" + v.getWidth() + "x" + v.getHeight());
            log("TXTREPL_OVERLAY|" + txt + " size=" + v.getWidth() + "x" + v.getHeight() + " bg=" + Integer.toHexString(fill));
        } catch (Throwable t) { log("TXTREPL_OVERLAY|err " + t); }
    }

    /** 清除所有改字（显示层规则 + 覆盖层），恢复原文 */
    private static void clearAllEdits(final android.app.Activity act) {
        new android.app.AlertDialog.Builder(act)
                .setTitle("清除修改")
                .setMessage("恢复所有被改过的消息原文？")
                .setPositiveButton("清除", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        try {
                            liveRulesTs.clear();
                            liveRulesAt.clear();
                            liveRules.clear();
                            tsRulesLoaded = true;
                            JSONObject o = readCfg();
                            o.remove("textReplaceTs");
                            o.put("textReplace", new org.json.JSONArray());
                            writeCfg(o);
                            removeOverlays();
                            refreshChatList();
                            log("CLEAREDIT|done");
                            toast("已清除，恢复原文");
                        } catch (Throwable t) { toast("清除失败：" + t); }
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    /** 移除所有气泡上的覆盖绘制，并把 tag 清掉 */
    private static void removeOverlays() {
        try {
            android.app.Activity act = chatAct;
            if (act == null) return;
            android.view.ViewGroup list = findMsgList(act.getWindow().getDecorView());
            if (list == null) return;
            for (int i = 0; i < list.getChildCount(); i++) {
                android.view.View row = list.getChildAt(i);
                java.util.ArrayList<android.view.View> vs = new java.util.ArrayList<android.view.View>();
                collectNeatFrom(row, vs, 0);
                for (android.view.View v : vs) {
                    Object d0 = v.getTag(0x0f0f0f07);
                    if (d0 instanceof android.graphics.drawable.Drawable) {
                        try { v.getOverlay().remove((android.graphics.drawable.Drawable) d0); } catch (Throwable ignore) { }
                    }
                    v.setTag(0x0f0f0f07, null);
                    v.setTag(0x0f0f0f08, null);
                }
            }
        } catch (Throwable ignore) { }
    }

    private static void collectNeatFrom(android.view.View v, java.util.List<android.view.View> out, int d) {
        if (v == null || d > 6) return;
        if (v.getClass().getName().contains("MMNeat7extView")) out.add(v);
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) collectNeatFrom(g.getChildAt(i), out, d + 1);
        }
    }

    /** 保存新内容后，清掉该行覆盖层的去重标记，保证能重新绘制 */
    private static void clearOverlayMetaNear(long ts) {
        try {
            android.app.Activity act = chatAct;
            if (act == null) return;
            android.view.ViewGroup list = findMsgList(act.getWindow().getDecorView());
            if (list == null) return;
            for (int i = 0; i < list.getChildCount(); i++) {
                android.view.View row = list.getChildAt(i);
                Object t = row.getTag(0x0f0f0f06);
                if (!(t instanceof Long) || ((Long) t).longValue() != ts) continue;
                java.util.ArrayList<android.view.View> vs = new java.util.ArrayList<android.view.View>();
                collectNeatFrom(row, vs, 0);
                for (android.view.View v : vs) v.setTag(0x0f0f0f08, null);
            }
        } catch (Throwable ignore) { }
    }

    /** 在输入框右侧找发送按钮（微信 8.0.80 的发送是图标，不是「发送」文字） */
    private static android.view.View findSendNear(android.view.View et) {
        try {
            if (et == null) return null;
            int[] el = new int[2];
            et.getLocationOnScreen(el);
            int etRight = el[0] + et.getWidth();
            int etMidY = el[1] + et.getHeight() / 2;
            android.view.ViewParent p = et.getParent();
            for (int up = 0; up < 5 && p instanceof android.view.ViewGroup; up++) {
                android.view.ViewGroup g = (android.view.ViewGroup) p;
                android.view.View best = null;
                int bestDx = Integer.MAX_VALUE;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.view.View c = g.getChildAt(i);
                    if (c == et || c.getVisibility() != android.view.View.VISIBLE) continue;
                    if (!c.isClickable() && !(c instanceof android.widget.ImageView)) continue;
                    int[] cl = new int[2];
                    c.getLocationOnScreen(cl);
                    if (c.getWidth() <= 0 || c.getHeight() <= 0) continue;
                    int cx = cl[0] + c.getWidth() / 2;
                    int cy = cl[1] + c.getHeight() / 2;
                    if (cx <= etRight - 4) continue;                        // 必须在输入框右侧
                    if (Math.abs(cy - etMidY) > et.getHeight()) continue;    // 同一行
                    int dx = cx - etRight;
                    if (dx < bestDx) { bestDx = dx; best = c; }
                }
                if (best != null) return best;
                p = g.getParent();
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 点一下发送按钮（常用语自动发送用） */
    private static boolean sendNow(android.app.Activity act) {
        try {
            if (act == null) return false;
            android.widget.EditText et = currentInput();
            android.view.View btn = findSendNear(et);
            if (btn == null) btn = findSendButton(act.getWindow().getDecorView());
            if (btn == null) { log("SENDNOW|no button"); return false; }
            tapView(btn);
            boolean ok = true;
            log("SENDNOW|" + ok + " btn=" + btn.getClass().getName()
                    + " " + btn.getWidth() + "x" + btn.getHeight());
            return ok;
        } catch (Throwable t) { log("SENDNOW|err " + t); return false; }
    }

    /** 复读：把这条消息原样再发一次 */
    private static void echoMessage(final String text) {
        try {
            if (text == null || text.trim().length() == 0) { toast("这条没有可复读的文字"); return; }
            final android.app.Activity act = chatAct;
            if (act == null) return;
            final android.widget.EditText et = currentInput();
            if (et == null) { toast("没找到输入框"); return; }
            et.setText(text);
            et.setSelection(et.getText().length());
            log("ECHO|" + text);
            et.postDelayed(new Runnable() {
                @Override public void run() { sendNow(act); }
            }, 200);
        } catch (Throwable t) { log("ECHO|err " + t); }
    }

    /** 与微信网格项完全一致的布局参数：同 weight 均分，或同固定宽高 */
    private static android.widget.LinearLayout.LayoutParams gridLp(android.view.View ref, int refW, int refH) {
        android.widget.LinearLayout.LayoutParams lp;
        float w = ref != null && ref.getLayoutParams() instanceof android.widget.LinearLayout.LayoutParams
                ? ((android.widget.LinearLayout.LayoutParams) ref.getLayoutParams()).weight : 0f;
        int hgt = refH > 0 ? refH : android.view.ViewGroup.LayoutParams.WRAP_CONTENT;
        if (w > 0f) {
            lp = new android.widget.LinearLayout.LayoutParams(0, hgt, w);
        } else if (refW > 0) {
            lp = new android.widget.LinearLayout.LayoutParams(refW, hgt);
        } else {
            lp = new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, hgt);
        }
        lp.gravity = android.view.Gravity.CENTER_VERTICAL;
        return lp;
    }

    /** 图片复读：把气泡里的图抓下来，存成文件，走系统「发送给朋友」 */
    private static void echoImage() {
        try {
            android.app.Activity act = chatAct;
            if (act == null) return;
            android.view.View pressed = lastLongPressView == null ? null : lastLongPressView.get();
            android.view.View row = rowOf(pressed);
            if (row == null) row = pressed;
            android.view.View img = findBigImageView(row);
            if (img == null) { toast("没找到图片"); return; }
            android.graphics.drawable.Drawable d = ((android.widget.ImageView) img).getDrawable();
            if (d == null) { toast("图片还没加载好"); return; }
            int w = d.getIntrinsicWidth() > 0 ? d.getIntrinsicWidth() : img.getWidth();
            int h = d.getIntrinsicHeight() > 0 ? d.getIntrinsicHeight() : img.getHeight();
            android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(w, h, android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas c = new android.graphics.Canvas(bm);
            d.setBounds(0, 0, w, h);
            d.draw(c);
            java.io.File out = new java.io.File(DIR, "wxh_echo.png");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 95, fo);
            fo.close();
            log("ECHOIMG|" + w + "x" + h + " -> " + out);
            android.content.Intent it = new android.content.Intent(android.content.Intent.ACTION_SEND);
            it.setType("image/png");
            it.putExtra(android.content.Intent.EXTRA_STREAM,
                    android.net.Uri.fromFile(out));
            it.setPackage(wxPkg());
            it.addFlags(android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION);
            act.startActivity(it);
            toast("已拉起发送，选择这个聊天即可");
        } catch (Throwable t) { log("ECHOIMG|err " + t); toast("图片复读失败：" + t); }
    }

    /** 等宽一格（内部行用） */
    private static android.widget.LinearLayout.LayoutParams weightLp() {
        android.widget.LinearLayout.LayoutParams lp = new android.widget.LinearLayout.LayoutParams(
                0, android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
        lp.gravity = android.view.Gravity.CENTER_VERTICAL;
        return lp;
    }

    private static android.view.View firstImageView(android.view.View v) {
        if (v == null) return null;
        if (v instanceof android.widget.ImageView) return v;
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View r = firstImageView(g.getChildAt(i));
                if (r != null) return r;
            }
        }
        return null;
    }

    /* 探针：抓「发图片消息」事件的真实字段，用于实现原生复读 */
    private static void probeImageEvent(ClassLoader app) {
        try {
            final Class<?> ev = Class.forName("com.tencent.mm.autogen.events.SendImageMsgEvent", false, app);
            XposedBridge.hookAllMethods(ev, "<init>", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        Object o = p.thisObject;
                        final java.lang.reflect.Field f = ev.getDeclaredField("g");
                        f.setAccessible(true);
                        log("IMGEV|new");
                        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                            @Override public void run() {
                                try {
                                    Object pl = f.get(o);
                                    log("IMGEV|payload=" + dumpObj(pl));
                                } catch (Throwable ignore) { }
                            }
                        }, 120);
                    } catch (Throwable ignore) { }
                }
            });
            try {
                Class<?> mu = Class.forName("im.mu", false, app);
                XposedBridge.hookAllMethods(mu, "<init>", new XC_MethodHook() {
                    @Override protected void afterHookedMethod(MethodHookParam p) {
                        log("IMGEV|mu new " + dumpObj(p.thisObject));
                    }
                });
                for (final java.lang.reflect.Method m : mu.getDeclaredMethods()) {
                    XposedBridge.hookMethod(m, new XC_MethodHook() {
                        @Override protected void afterHookedMethod(MethodHookParam p) {
                            StringBuilder sb = new StringBuilder("IMGEV|mu." + m.getName() + "(");
                            if (p.args != null) for (Object a0 : p.args) sb.append(a0).append(',');
                            sb.append(") -> ").append(dumpObj(p.thisObject));
                            log(sb.toString());
                        }
                    });
                }
            } catch (Throwable ignore) { }
            log("IMGEV|probe installed");
        } catch (Throwable t) { log("IMGEV|err " + t); }
    }

    private static String dumpObj(Object o) {
        if (o == null) return "null";
        StringBuilder sb = new StringBuilder(o.getClass().getName()).append('{');
        try {
            Class<?> k = o.getClass();
            while (k != null && k != Object.class) {
                for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                    f.setAccessible(true);
                    Object v = f.get(o);
                    if (v == null) continue;
                    String sv = String.valueOf(v);
                    if (sv.length() > 60) sv = sv.substring(0, 60) + "…";
                    sb.append(f.getName()).append('=').append(sv).append(' ');
                }
                k = k.getSuperclass();
            }
        } catch (Throwable ignore) { }
        return sb.append('}').toString();
    }

    /** 在微信菜单里找到某个文字项并点它（用于走微信原生转发） */
    private static boolean clickMenuText(android.view.View root, String label) {
        try {
            android.widget.TextView tv = findTextNode(root, label, 0);
            if (tv == null) { log("MENUCLICK|no " + label); return false; }
            android.view.View target = tv;
            int guard = 0;
            while (target != null && !target.isClickable() && guard++ < 5) {
                android.view.ViewParent pv = target.getParent();
                if (!(pv instanceof android.view.View)) break;
                target = (android.view.View) pv;
            }
            tapView(target);
            log("MENUCLICK|" + label + " ok=" + (target != null));
            return true;
        } catch (Throwable t) { log("MENUCLICK|err " + t); return false; }
    }

    private static android.widget.TextView findTextNode(android.view.View v, String label, int d) {
        if (v == null || d > 12) return null;
        if (v instanceof android.widget.TextView) {
            CharSequence cs = ((android.widget.TextView) v).getText();
            if (cs != null && label.equals(cs.toString().trim())) return (android.widget.TextView) v;
        }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.widget.TextView r = findTextNode(g.getChildAt(i), label, d + 1);
                if (r != null) return r;
            }
        }
        return null;
    }

    /* === 自动把「转发」选到当前会话 === */
    private static void installForwardAutoPick(ClassLoader app) {
        try {
            String[] names = {"com.tencent.mm.ui.transmit.SelectConversationUI",
                    "com.tencent.mm.ui.transmit.SelectConversationDirectSelectUI"};
            for (final String cn : names) {
                try {
                    Class<?> c = Class.forName(cn, false, app);
                    XposedBridge.hookAllMethods(c, "onResume", new XC_MethodHook() {
                        @Override protected void afterHookedMethod(MethodHookParam p) {
                            if (System.currentTimeMillis() - autoForwardAt > 20000) return;
                            if (autoForwardTalker == null) return;
                            final Object actO = p.thisObject;
                            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                @Override public void run() { autoPickForward(actO); }
                            }, 900);
                        }
                    });
                } catch (Throwable ignore) { }
            }
            log("FWD|auto pick installed");
        } catch (Throwable t) { log("FWD|err " + t); }
    }

    private static void autoPickForward(Object uiObj) {
        try {
            if (System.currentTimeMillis() - autoForwardAt > 20000) return;
            android.app.Activity act = (android.app.Activity) uiObj;
            String tk = autoForwardTalker;
            if (tk == null) return;
            String name = resolveName(tk);
            android.view.View decor = act.getWindow().getDecorView();
            android.widget.TextView hit = name == null ? null : findTextNode(decor, name, 0);
            if (hit == null && name != null) hit = findNodeByRenderedText(decor, name, 0);
            if (hit != null) {
                android.view.View row = hit;
                if (hit.getTag() instanceof android.view.View) row = (android.view.View) hit.getTag();
                int g = 0;
                while (row != null && !row.isClickable() && g++ < 6) {
                    android.view.ViewParent pv = row.getParent();
                    if (!(pv instanceof android.view.View)) break;
                    row = (android.view.View) pv;
                }
                android.view.View rowRoot = row.getRootView();
                boolean tapped = tapAtScreen(rowRoot == null ? decor : rowRoot, row);
                if (!tapped) tapView(row);
                autoForwardAt = 0;
                log("FWD|picked " + name + " tap=" + tapped);
                scheduleForwardConfirm();
                return;
            }
            log("FWD|not found " + name + " :: " + dumpTexts(decor));
        } catch (Throwable t) { log("FWD|pick err " + t); }
    }

    /** 非阻塞轮询点击：找到标签就点，最多 16 次 × 250ms */
    private static void pollClick(final android.os.Handler h, final String[] labels, final int round) {
        try {
            for (android.view.View r : allRoots()) {
                for (String lb : labels) {
                    android.widget.TextView tv = findTextNode(r, lb, 0);
                    if (tv == null) continue;
                    android.view.View tgt = tv;
                    int g = 0;
                    while (tgt != null && !tgt.isClickable() && g++ < 6) {
                        android.view.ViewParent pv = tgt.getParent();
                        if (!(pv instanceof android.view.View)) break;
                        tgt = (android.view.View) pv;
                    }
                    boolean ok = tapAtScreen(r, tgt == null ? tv : tgt);
                    log("POLLCLICK|" + lb + " ok=" + ok + " round=" + round);
                    if (ok) return;
                }
            }
            if (round >= 16) { log("POLLCLICK|giveup"); return; }
            h.postDelayed(new Runnable() {
                @Override public void run() { pollClick(h, labels, round + 1); }
            }, 250L);
        } catch (Throwable t) { log("POLLCLICK|err " + t); }
    }

    /** 过滤掉误读出来的类名等垃圾文本（如 ViewGroup） */
    private static boolean badMsgText(String t) {
        if (t == null) return true;
        String v = t.trim();
        // 把正则表达式误当成消息文字（例如 [\u0001-\u00b7...]）
        if (v.startsWith("[") && (v.contains("\\u00") || v.contains("\\ud83"))) return true;
        if (v.contains("\\u4E00") || v.contains("\\u9FA5") || v.contains("\\uff01")) return true;
        if (v.contains("\\ud83c") || v.contains("\\ud83d")) return true;
        if (v.length() == 0) return true;
        if (v.startsWith("android.") || v.startsWith("java.") || v.startsWith("com.tencent")) return true;
        if (v.contains("ViewGroup") || v.equals("View") || v.equals("null")) return true;
        // 单个 CamelCase 标识符（无空格、无中文、无标点）通常是类名
        if (v.matches("[A-Z][A-Za-z0-9_$]{2,}")) return true;
        return false;
    }

    /** 生成一个和现有菜单项同样样式的功能块 */
    /** 把一个已经建好的 View 放进 5 列网格 */
    private static void addGridChipView(android.content.Context ctx, android.widget.LinearLayout box,
                                        int[] counter, android.widget.LinearLayout[] curRow,
                                        android.view.View v) {
        try {
            box.addView(v, weightLp());
            counter[0]++;
        } catch (Throwable ignore) { }
    }

    /** 每行 5 个的 chip 网格 */
    private static void addGridChip(android.content.Context ctx, android.widget.LinearLayout box,
                                    int[] counter, android.widget.LinearLayout[] curRow,
                                    String icon, String label, android.view.View.OnClickListener l) {
        try {
            box.addView(makeChip(ctx, icon, label, l), weightLp());
            counter[0]++;
        } catch (Throwable ignore) { }
    }

    private static android.widget.LinearLayout makeChip(android.content.Context ctx, String iconTxt,
                                                        String labelTxt, android.view.View.OnClickListener l) {
        android.widget.LinearLayout item = new android.widget.LinearLayout(ctx);
        item.setOrientation(android.widget.LinearLayout.VERTICAL);
        item.setGravity(android.view.Gravity.TOP | android.view.Gravity.CENTER_HORIZONTAL);
        item.setPadding(0, dp(ctx, 4), 0, dp(ctx, 4));
        android.widget.TextView icon = new android.widget.TextView(ctx);
        icon.setText(iconTxt);
        icon.setTextSize(13);
        icon.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
        icon.setTextColor(0xFFFFFFFF);
        icon.setGravity(android.view.Gravity.CENTER);
        try {
            android.graphics.drawable.GradientDrawable ib = new android.graphics.drawable.GradientDrawable();
            ib.setCornerRadius(dp(ctx, 8));
            ib.setColor(0x1AFFFFFF);      // 10% 白，让所有图标视觉重量一致
            icon.setBackground(ib);
        } catch (Throwable ignore) { icon.setBackground(null); }
        item.addView(icon, new android.widget.LinearLayout.LayoutParams(dp(ctx, 26), dp(ctx, 26)));
        android.widget.TextView lb = new android.widget.TextView(ctx);
        lb.setText(labelTxt);
        lb.setTextSize(12);
        lb.setTextColor(0xFFD9D9DE);
        lb.setGravity(android.view.Gravity.CENTER);
        lb.setSingleLine(true);
        lb.setIncludeFontPadding(false);
        android.widget.LinearLayout.LayoutParams lp = new android.widget.LinearLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
        lp.topMargin = dp(ctx, 3);
        item.addView(lb, lp);
        item.setOnClickListener(l);
        return item;
    }

    /** 保存/复制这一条消息里的图片（表情包同样适用） */
    private static void saveImageOfMessage(final boolean alsoCopy) {
        try {
            android.view.View pressed = lastLongPressView == null ? null : lastLongPressView.get();
            log("SAVEIMG|pressed=" + cn(pressed));
            android.view.View row = walkUpToItem(pressed);
            if (row == null) row = pressed;
            log("SAVEIMG|row=" + cn(row));
            if (row == null) { toast("没找到这条消息"); return; }
            android.graphics.Bitmap bm = renderPressedImage(pressed);
            if (bm == null) bm = renderBestImage(row);
            if (bm == null) { toast("没找到图片"); return; }
            int w = bm.getWidth(), h = bm.getHeight();
            String name = "wxh_" + System.currentTimeMillis() + ".png";
            android.net.Uri uri = null;
            try {
                android.content.ContentValues cv = new android.content.ContentValues();
                cv.put(android.provider.MediaStore.Images.Media.DISPLAY_NAME, name);
                cv.put(android.provider.MediaStore.Images.Media.MIME_TYPE, "image/png");
                if (android.os.Build.VERSION.SDK_INT >= 29) {
                    cv.put(android.provider.MediaStore.Images.Media.RELATIVE_PATH, "Pictures/wxh");
                }
                uri = chatAct.getContentResolver().insert(
                        android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI, cv);
                if (uri != null) {
                    java.io.OutputStream os = chatAct.getContentResolver().openOutputStream(uri);
                    bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, os);
                    os.flush(); os.close();
                }
            } catch (Throwable t) { log("SAVEIMG|media err " + t); }
            if (uri == null) {
                java.io.File f = new java.io.File(DIR, name);
                java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
                bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, fo);
                fo.flush(); fo.close();
                uri = android.net.Uri.fromFile(f);
            }
            log("SAVEIMG|ok " + w + "x" + h + " uri=" + uri + " copy=" + alsoCopy);
            if (alsoCopy) {
                try {
                    android.content.ClipboardManager cm = (android.content.ClipboardManager)
                            chatAct.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                    cm.setPrimaryClip(android.content.ClipData.newUri(
                            chatAct.getContentResolver(), "wxh_image", uri));
                    toast("已复制，正在粘贴发送");
                    try { pasteAndSend(chatAct, false); } catch (Throwable ignore) { }
                } catch (Throwable t) { toast("复制失败：" + t); }
            } else {
                toast("已保存到相册 Pictures/wxh");
            }
        } catch (Throwable t) { log("SAVEIMG|err " + t); toast("失败：" + t); }
    }

    private static String cn(android.view.View v) {
        return v == null ? "null" : v.getClass().getName();
    }

    /** 从长按锚点向上爬到消息 itemView */
    private static android.view.View walkUpToItem(android.view.View v) {
        android.view.View cur = v;
        for (int i = 0; i < 24 && cur != null; i++) {
            android.view.ViewParent p = cur.getParent();
            if (!(p instanceof android.view.View)) return cur;
            String n = p.getClass().getName();
            if (n.contains("RecyclerView") || p instanceof android.widget.AbsListView) return cur;
            cur = (android.view.View) p;
        }
        return cur;
    }

    /** 在消息行里找出可保存的图片；找不到 ImageView 就把自绘控件直接画出来（表情包是自绘的） */
    private static android.graphics.Bitmap renderBestImage(android.view.View root) {
        android.view.View bestIv = null; int bestIvArea = 0;
        android.view.View bestView = null; int bestViewArea = 0;
        java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
        q.add(root);
        int scanned = 0, imgs = 0;
        while (!q.isEmpty() && scanned < 600) {
            android.view.View v = q.poll(); scanned++;
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.view.View ch = g.getChildAt(i);
                    if (ch != null && ch.getVisibility() == android.view.View.VISIBLE) q.add(ch);
                }
            }
            if (v == root) continue;
            if (v instanceof android.widget.ImageView && !v.getClass().getName().contains("Avatar")) {
                android.graphics.drawable.Drawable d = ((android.widget.ImageView) v).getDrawable();
                if (d != null) {
                    imgs++;
                    int dw = d.getIntrinsicWidth() > 0 ? d.getIntrinsicWidth() : v.getWidth();
                    int dh = d.getIntrinsicHeight() > 0 ? d.getIntrinsicHeight() : v.getHeight();
                    if (dw * dh > bestIvArea) { bestIvArea = dw * dh; bestIv = v; }
                }
            }
            String cn2 = v.getClass().getName();
            boolean isText = v instanceof android.widget.TextView;
            if (!isText && !cn2.contains("wxh")
                    && !cn2.contains("NeatTextView") && !cn2.contains("Avatar")
                    && v.getWidth() >= 60 && v.getHeight() >= 60) {
                int a = v.getWidth() * v.getHeight();
                if (a > bestViewArea) { bestViewArea = a; bestView = v; }
            }
        }
        log("SAVEIMG|scan scanned=" + scanned + " imgs=" + imgs
                + " bestIv=" + cn(bestIv) + " bestView=" + cn(bestView));
        try {
            if (bestIv != null) {
                android.graphics.drawable.Drawable d = ((android.widget.ImageView) bestIv).getDrawable();
                int w = d.getIntrinsicWidth() > 0 ? d.getIntrinsicWidth() : bestIv.getWidth();
                int h = d.getIntrinsicHeight() > 0 ? d.getIntrinsicHeight() : bestIv.getHeight();
                if (w > 0 && h > 0) {
                    android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(w, h,
                            android.graphics.Bitmap.Config.ARGB_8888);
                    android.graphics.Canvas c = new android.graphics.Canvas(bm);
                    d.setBounds(0, 0, w, h);
                    d.draw(c);
                    log("SAVEIMG|fromDrawable " + w + "x" + h);
                    return bm;
                }
            }
            if (bestView != null) {
                int w = bestView.getWidth(), h = bestView.getHeight();
                android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(w, h,
                        android.graphics.Bitmap.Config.ARGB_8888);
                android.graphics.Canvas c = new android.graphics.Canvas(bm);
                bestView.draw(c);
                log("SAVEIMG|fromView " + w + "x" + h);
                return bm;
            }
        } catch (Throwable t) { log("SAVEIMG|render err " + t); }
        return null;
    }

    /** 优先取"长按的那个控件"：表情是自绘、图片是 ImageView 或其祖先 */
    private static android.graphics.Bitmap renderPressedImage(android.view.View pressed) {
        if (pressed == null) return null;
        android.view.View cur = pressed;
        for (int i = 0; i < 6 && cur != null; i++) {
            String n = cur.getClass().getName();
            if (n.contains("Avatar") || n.contains("wxh") || n.contains("NeatTextView")) {
                // 跳过，往上继续
            } else if (cur instanceof android.widget.ImageView) {
                android.graphics.drawable.Drawable d = ((android.widget.ImageView) cur).getDrawable();
                if (d != null) {
                    int w = d.getIntrinsicWidth() > 0 ? d.getIntrinsicWidth() : cur.getWidth();
                    int h = d.getIntrinsicHeight() > 0 ? d.getIntrinsicHeight() : cur.getHeight();
                    if (w > 0 && h > 0) {
                        android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(w, h,
                                android.graphics.Bitmap.Config.ARGB_8888);
                        android.graphics.Canvas c = new android.graphics.Canvas(bm);
                        d.setBounds(0, 0, w, h);
                        d.draw(c);
                        log("SAVEIMG|fromPressedDrawable " + n + " " + w + "x" + h);
                        return bm;
                    }
                }
            } else if (n.contains("Emoji") || n.contains("Sticker") || n.contains("Emotion")) {
                // 先试着从控件字段里翻出原始 drawable（比屏幕上画出来的清晰）
                android.graphics.drawable.Drawable big = findBigDrawable(cur, cur.getWidth(), 0);
                if (big != null) {
                    int dw = big.getIntrinsicWidth(), dh = big.getIntrinsicHeight();
                    if (dw > 0 && dh > 0) {
                        android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(dw, dh,
                                android.graphics.Bitmap.Config.ARGB_8888);
                        android.graphics.Canvas c = new android.graphics.Canvas(bm);
                        big.setBounds(0, 0, dw, dh);
                        big.draw(c);
                        log("SAVEIMG|fromEmojiFieldDrawable " + dw + "x" + dh);
                        return bm;
                    }
                }
                int w = cur.getWidth(), h = cur.getHeight();
                if (w > 0 && h > 0) {
                    android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(w, h,
                            android.graphics.Bitmap.Config.ARGB_8888);
                    android.graphics.Canvas c = new android.graphics.Canvas(bm);
                    cur.draw(c);
                    log("SAVEIMG|fromPressedView " + n + " " + w + "x" + h);
                    return bm;
                }
            }
            android.view.ViewParent p = cur.getParent();
            if (!(p instanceof android.view.View)) break;
            cur = (android.view.View) p;
        }
        return null;
    }

    /** 在控件（含其字段里的对象）中找最大的 Drawable */
    private static android.graphics.drawable.Drawable findBigDrawable(Object o, int minW, int depth) {
        if (o == null || depth > 2) return null;
        android.graphics.drawable.Drawable best = null;
        Class<?> c = o.getClass();
        for (int lv = 0; lv < 6 && c != null; lv++, c = c.getSuperclass()) {
            java.lang.reflect.Field[] fs;
            try { fs = c.getDeclaredFields(); } catch (Throwable t) { break; }
            for (java.lang.reflect.Field f : fs) {
                try {
                    f.setAccessible(true);
                    Object v = f.get(o);
                    if (v == null) continue;
                    if (v instanceof android.graphics.drawable.Drawable) {
                        android.graphics.drawable.Drawable d = (android.graphics.drawable.Drawable) v;
                        if (d.getIntrinsicWidth() > minW
                                && (best == null || d.getIntrinsicWidth() > best.getIntrinsicWidth())) best = d;
                    } else if (depth < 2 && !(v instanceof String) && !(v instanceof Number)
                            && !(v instanceof Boolean) && v.getClass().getName().startsWith("com.tencent")) {
                        android.graphics.drawable.Drawable d2 = findBigDrawable(v, minW, depth + 1);
                        if (d2 != null && (best == null || d2.getIntrinsicWidth() > best.getIntrinsicWidth())) best = d2;
                    }
                } catch (Throwable ignore) { }
            }
        }
        return best;
    }

    /** 图片/表情复读：存相册 → 复制到剪贴板 → 粘贴进输入框 → 发送 */
    private static void echoImageFlow() {
        final android.app.Activity act = chatAct;
        if (act == null) { toast("不在聊天页"); return; }
        long t0 = System.currentTimeMillis();
        boolean copied = saveImageToClipboard();
        log("ECHOIMG|step1 copy=" + copied + " 耗时=" + (System.currentTimeMillis() - t0) + "ms");
        if (!copied) { toast("复制失败，改用转发"); fallbackForward(); return; }
        pasteAndSend(act, true);
    }

    /** 粘贴 → 等图出现在输入框 → 点发送；失败则转发兜底 */
    private static void pasteAndSend(final android.app.Activity act, final boolean allowFallback) {
        final android.widget.EditText et = currentInput();
        if (et == null) {
            log("PASTESEND|no input");
            if (allowFallback) fallbackForward(); else toast("没找到输入框");
            return;
        }
        et.requestFocus();
        boolean pasted = false;
        try {
            java.lang.reflect.Method m = android.widget.EditText.class
                    .getMethod("onTextContextMenuItem", int.class);
            m.setAccessible(true);
            Object r = m.invoke(et, 16908322);   // android.R.id.paste
            pasted = Boolean.TRUE.equals(r);
            log("PASTESEND|paste=" + pasted + " ret=" + r);
        } catch (Throwable t) { log("PASTESEND|paste err " + t); }
        // 粘贴后微信会弹出预览窗（发送到当前聊天 / 取消 + 发送），自动点「发送」
        scheduleForwardConfirm();
    }

    /** 兜底：走微信原生「转发」自动选当前会话 */
    private static void fallbackForward() {
        autoForwardAt = System.currentTimeMillis();
        autoForwardTalker = chatTalker;
        echoImage();
    }

    /** 存图并复制到剪贴板，返回是否成功 */
    private static boolean saveImageToClipboard() {
        try {
            android.view.View pressed = lastLongPressView == null ? null : lastLongPressView.get();
            android.view.View row = walkUpToItem(pressed);
            if (row == null) row = pressed;
            android.graphics.Bitmap bm = renderPressedImage(pressed);
            if (bm == null) bm = renderBestImage(row);
            if (bm == null) return false;
            String name = "wxh_" + System.currentTimeMillis() + ".png";
            android.net.Uri uri = null;
            try {
                android.content.ContentValues cv = new android.content.ContentValues();
                cv.put(android.provider.MediaStore.Images.Media.DISPLAY_NAME, name);
                cv.put(android.provider.MediaStore.Images.Media.MIME_TYPE, "image/png");
                if (android.os.Build.VERSION.SDK_INT >= 29) {
                    cv.put(android.provider.MediaStore.Images.Media.RELATIVE_PATH, "Pictures/wxh");
                }
                uri = chatAct.getContentResolver().insert(
                        android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI, cv);
                if (uri != null) {
                    java.io.OutputStream os = chatAct.getContentResolver().openOutputStream(uri);
                    bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, os);
                    os.flush(); os.close();
                }
            } catch (Throwable t) { log("ECHOIMG|media err " + t); }
            if (uri == null) return false;
            android.content.ClipboardManager cm = (android.content.ClipboardManager)
                    chatAct.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
            cm.setPrimaryClip(android.content.ClipData.newUri(
                    chatAct.getContentResolver(), "wxh_image", uri));
            log("ECHOIMG|clip uri=" + uri + " size=" + bm.getWidth() + "x" + bm.getHeight());
            return true;
        } catch (Throwable t) { log("ECHOIMG|err " + t); return false; }
    }

    /** 转发确认页（发送到当前聊天）自动点右下角「发送」 */
    private static int fwdTries = 0;
    private static void scheduleForwardConfirm() {
        fwdTries = 0;
        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
            @Override public void run() {
                try {
                    java.util.List<android.view.View> roots = allRoots();
            StringBuilder rs = new StringBuilder();
            for (android.view.View r0 : roots) rs.append(r0.getClass().getSimpleName())
                    .append('(').append(r0.getWidth()).append(')').append(' ');
            log("PLUSINJ|roots " + rs);
                    android.app.Activity a = topAct != null ? topAct : (lastAct != null ? lastAct : chatAct);
                    if (roots.isEmpty() && a != null) roots.add(a.getWindow().getDecorView());
                    android.view.View hitRoot = null, btn0 = null;
                    boolean confirmPage = false;
                    for (android.view.View r : roots) {
                        boolean cp = findTextNode(r, "取消", 0) != null
                                || findTextNode(r, "发送到当前聊天", 0) != null
                                || findNodeByRenderedText(r, "发送到当前聊天", 0) != null;
                        android.view.View b1 = findSendBtnBig(r);
                        if (fwdTries <= 2) {
                            log("FWDC|poll#" + fwdTries + " root=" + r.getClass().getSimpleName()
                                    + " btn=" + b1 + " confirm=" + cp);
                        }
                        if (b1 != null && cp) { hitRoot = r; btn0 = b1; confirmPage = true; break; }
                    }
                    if (btn0 == null) {
                        fwdTries++;
                        if (fwdTries < 250) {
                            new android.os.Handler(android.os.Looper.getMainLooper())
                                    .postDelayed(this, 30L);
                        } else {
                            log("FWDC|give up roots=" + roots.size() + " confirm=" + confirmPage
                                    + " act=" + (a == null ? "null" : a.getClass().getSimpleName()));
                        }
                        return;
                    }
                    // 静默：先把弹窗藏成全透明，再点
                    final android.view.View root2 = hitRoot;
                    final android.view.View btnF = btn0;
                    if (cfg().optBoolean("echoSilent", true)) {
                        try { if (root2 != null) root2.setAlpha(0f); } catch (Throwable ignore) { }
                    }
                    new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                        @Override public void run() {
                            boolean ok = tapAtScreen(root2, btnF);
                            log("FWDC|clicked=" + ok + " silent");
                            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                @Override public void run() {
                                    try { if (root2 != null && root2.getParent() != null) root2.setAlpha(1f); }
                                    catch (Throwable ignore) { }
                                }
                            }, 300L);
                        }
                    }, 20L);
                } catch (Throwable t) { log("FWDC|err " + t); }
            }
        }, 1200L);
    }


    /** 按"真实画出来的文字"找控件（微信 8.0.80 大量文字是自绘的，getText 拿不到） */
    private static android.widget.TextView findNodeByRenderedText(android.view.View v, String label, int d) {
        if (v == null || d > 30) return null;
        try {
            if (v.getVisibility() != android.view.View.VISIBLE) return null;
            String t = null;
            try { t = renderedTextOf(v); } catch (Throwable ignore) { }
            if (t == null) { try { t = findTextIn(v); } catch (Throwable ignore) { } }
            if (t != null) {
                t = t.trim();
                if (t.equals(label) || (t.startsWith(label) && t.length() <= label.length() + 2)) {
                    if (v instanceof android.widget.TextView) return (android.widget.TextView) v;
                    android.widget.TextView wrap = new android.widget.TextView(v.getContext());
                    wrap.setTag(v);
                    return wrap;
                }
            }
        } catch (Throwable ignore) { }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.widget.TextView r = findNodeByRenderedText(g.getChildAt(i), label, d + 1);
                if (r != null) return r;
            }
        }
        return null;
    }

    /** 把一屏里的文字收集成一行，方便排查 */
    private static String dumpTexts(android.view.View root) {
        final StringBuilder sb = new StringBuilder();
        try {
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            q.add(root);
            int n = 0;
            while (!q.isEmpty() && n < 30) {
                android.view.View v = q.poll();
                if (v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) q.add(g.getChildAt(i));
                }
                String t = null;
                try { t = renderedTextOf(v); } catch (Throwable ignore) { }
                if (t == null && v instanceof android.widget.TextView) {
                    CharSequence cs = ((android.widget.TextView) v).getText();
                    if (cs != null) t = cs.toString();
                }
                if (t != null) {
                    t = t.trim().replace('\n', '|');
                    if (t.length() > 0 && t.length() < 20 && sb.indexOf(t) < 0) {
                        sb.append(t).append('/');
                        n++;
                    }
                }
            }
        } catch (Throwable ignore) { }
        return sb.toString();
    }

    /** 在窗口根 View 上按目标控件的屏幕坐标派发一次真实点击 */
    private static boolean tapAtScreen(android.view.View root, android.view.View target) {
        try {
            if (root == null || target == null) return false;
            int[] t = new int[2];
            target.getLocationOnScreen(t);
            int w = target.getWidth() > 0 ? target.getWidth() : 1;
            int h = target.getHeight() > 0 ? target.getHeight() : 1;
            int[] r = new int[2];
            root.getLocationOnScreen(r);
            float x = t[0] - r[0] + w / 2f;
            float y = t[1] - r[1] + h / 2f;
            long now = android.os.SystemClock.uptimeMillis();
            android.view.MotionEvent down = android.view.MotionEvent.obtain(now, now,
                    android.view.MotionEvent.ACTION_DOWN, x, y, 0);
            android.view.MotionEvent up = android.view.MotionEvent.obtain(now, now + 60,
                    android.view.MotionEvent.ACTION_UP, x, y, 0);
            try {
                down.setSource(android.view.InputDevice.SOURCE_TOUCHSCREEN);
                up.setSource(android.view.InputDevice.SOURCE_TOUCHSCREEN);
            } catch (Throwable ignore) { }
            root.dispatchTouchEvent(down);
            root.postDelayed(new Runnable() {
                @Override public void run() { }
            }, 1L);
            root.dispatchTouchEvent(up);
            down.recycle();
            up.recycle();
            log("TAPS|" + x + "," + y + " on " + root.getClass().getSimpleName());
            return true;
        } catch (Throwable t) { log("TAPS|err " + t); return false; }
    }

    /** 找右下角那个"发送"大按钮（排除左侧小字、隐藏节点） */
    private static android.view.View findSendBtnBig(android.view.View root) {
        android.view.View best = null; int bestArea = 0;
        java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
        q.add(root);
        int scanned = 0;
        int[] loc = new int[2];
        while (!q.isEmpty() && scanned < 800) {
            android.view.View v = q.poll(); scanned++;
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) q.add(g.getChildAt(i));
            }
            String t = null;
            if (v instanceof android.widget.TextView) {
                CharSequence cs = ((android.widget.TextView) v).getText();
                if (cs != null) t = cs.toString().trim();
            }
            if (t == null) { try { t = renderedTextOf(v); } catch (Throwable ignore) { } }
            if (t == null || !"发送".equals(t.trim())) continue;
            v.getLocationOnScreen(loc);
            int w = v.getWidth(), h = v.getHeight();
            if (w < 60 || h < 20) continue;                     // 太小，是标签不是按钮
            int cx = loc[0] + w / 2;
            if (cx < 540) continue;                             // 必须在屏幕右半
            if (w * h > bestArea) { bestArea = w * h; best = v; }
            log("FWDC|cand 发送 rect=" + loc[0] + "," + loc[1] + " " + w + "x" + h);
        }
        return best;
    }
    /** 我的图库：底部表情面板样式，支持长按进入多选、滑动批量选、删除 */
    private static void openGalleryPanel(final android.app.Activity a) {
        try {
            String[] dirs = {"/sdcard/Pictures/wxh", "/sdcard/Pictures/WeiXin",
                    "/sdcard/DCIM/WeChat", "/sdcard/DCIM/WeiXin"};
            final java.util.ArrayList<java.io.File> arr = new java.util.ArrayList<java.io.File>();
            java.util.HashSet<String> seen = new java.util.HashSet<String>();
            for (String dn : dirs) {
                java.io.File[] all = new java.io.File(dn).listFiles();
                if (all == null) continue;
                for (java.io.File f : all) {
                    String n = f.getName().toLowerCase();
                    if (!f.isFile()) continue;
                    if (!(n.endsWith(".png") || n.endsWith(".jpg") || n.endsWith(".jpeg")
                            || n.endsWith(".gif") || n.endsWith(".webp"))) continue;
                    String key = n + "_" + f.length();
                    if (!seen.add(key)) continue;
                    arr.add(f);
                }
            }
            java.util.Collections.sort(arr, new java.util.Comparator<java.io.File>() {
                @Override public int compare(java.io.File x, java.io.File y) {
                    return Long.compare(y.lastModified(), x.lastModified());
                }
            });

            int w = a.getResources().getDisplayMetrics().widthPixels;
            int h = a.getResources().getDisplayMetrics().heightPixels;

            final android.widget.LinearLayout wrap = new android.widget.LinearLayout(a);
            wrap.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
            bg.setColor(0xFFF7F7F7);
            float r = dp(a, 16);
            bg.setCornerRadii(new float[]{r, r, r, r, 0, 0, 0, 0});
            wrap.setBackground(bg);

            // 顶部：标题 + 全选 / 删除 / 关闭
            android.widget.LinearLayout head = new android.widget.LinearLayout(a);
            head.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            head.setGravity(android.view.Gravity.CENTER_VERTICAL);
            head.setPadding(dp(a, 16), dp(a, 12), dp(a, 10), dp(a, 6));
            final android.widget.TextView title = new android.widget.TextView(a);
            title.setTextSize(15);
            title.setTextColor(0xFF1A1A1A);
            title.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
            head.addView(title, new android.widget.LinearLayout.LayoutParams(0,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));

            final android.widget.TextView btnAll = new android.widget.TextView(a);
            btnAll.setText("全选");
            btnAll.setTextSize(14);
            btnAll.setTextColor(0xFF576B95);
            btnAll.setPadding(dp(a, 10), dp(a, 6), dp(a, 10), dp(a, 6));
            btnAll.setVisibility(android.view.View.GONE);
            head.addView(btnAll);
            final android.widget.TextView btnDel = new android.widget.TextView(a);
            btnDel.setText("删除");
            btnDel.setTextSize(14);
            btnDel.setTextColor(0xFFD93A3A);
            btnDel.setPadding(dp(a, 10), dp(a, 6), dp(a, 10), dp(a, 6));
            btnDel.setVisibility(android.view.View.GONE);
            head.addView(btnDel);
            final android.widget.TextView btnClose = new android.widget.TextView(a);
            btnClose.setText("关闭");
            btnClose.setTextSize(14);
            btnClose.setTextColor(0xFF8A8A8A);
            btnClose.setPadding(dp(a, 10), dp(a, 6), dp(a, 6), dp(a, 6));
            head.addView(btnClose);
            wrap.addView(head);

            final java.util.LinkedHashSet<java.io.File> sel = new java.util.LinkedHashSet<java.io.File>();
            final boolean[] selecting = {false};
            final java.util.ArrayList<android.widget.ImageView> cells = new java.util.ArrayList<android.widget.ImageView>();

            final android.widget.GridLayout grid = new android.widget.GridLayout(a) {
                private android.widget.ImageView hitCell(float x, float y) {
                    for (int i = 0; i < getChildCount(); i++) {
                        android.view.View c = getChildAt(i);
                        if (c.getVisibility() != android.view.View.VISIBLE) continue;
                        if (x >= c.getLeft() && x <= c.getRight() && y >= c.getTop() && y <= c.getBottom()) {
                            return (android.widget.ImageView) c;
                        }
                    }
                    return null;
                }
                @Override public boolean dispatchTouchEvent(android.view.MotionEvent e) {
                    if (!selecting[0]) return super.dispatchTouchEvent(e);
                    int act = e.getActionMasked();
                    if (act == android.view.MotionEvent.ACTION_DOWN
                            || act == android.view.MotionEvent.ACTION_MOVE) {
                        android.widget.ImageView c = hitCell(e.getX(), e.getY());
                        if (c != null && c.getTag() instanceof java.io.File) {
                            java.io.File f = (java.io.File) c.getTag();
                            if (act == android.view.MotionEvent.ACTION_DOWN) {
                                if (!sel.remove(f)) sel.add(f);
                            } else if (!sel.contains(f)) {
                                sel.add(f);
                                updateCell(c, true, a);
                            }
                            updateCell(c, sel.contains(f), a);
                            refreshHead();
                        }
                    }
                    return true;
                }
                private void refreshHead() {
                    title.setText(selecting[0] ? ("已选 " + sel.size() + " 张") : ("我的图库 · " + arr.size() + " 张"));
                }
            };
            grid.setColumnCount(4);
            int pad = dp(a, 6);
            int cell = (w - pad * 10) / 4;
            grid.setPadding(pad, 0, pad, dp(a, 10));

            if (arr.isEmpty()) {
                android.widget.TextView empty = new android.widget.TextView(a);
                empty.setText("还没有存过图\n长按聊天里的图片或表情 → 「存图 / 复读」就会存到这里");
                empty.setTextSize(14);
                empty.setTextColor(0xFF999999);
                empty.setGravity(android.view.Gravity.CENTER);
                empty.setPadding(0, dp(a, 60), 0, dp(a, 60));
                wrap.addView(empty, new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
                title.setText("我的图库 · 0 张");
            } else {
                for (int i = 0; i < arr.size() && i < 400; i++) {
                    final java.io.File f = arr.get(i);
                    final android.widget.ImageView iv = new android.widget.ImageView(a);
                    iv.setScaleType(android.widget.ImageView.ScaleType.CENTER_CROP);
                    android.graphics.BitmapFactory.Options o = new android.graphics.BitmapFactory.Options();
                    o.inSampleSize = 4;
                    try { iv.setImageBitmap(android.graphics.BitmapFactory.decodeFile(f.getAbsolutePath(), o)); }
                    catch (Throwable ignore) { }
                    iv.setTag(f);
                    updateCell(iv, false, a);
                    android.widget.GridLayout.LayoutParams glp = new android.widget.GridLayout.LayoutParams();
                    glp.width = cell; glp.height = cell;
                    glp.setMargins(pad, pad, pad, pad);
                    iv.setLayoutParams(glp);
                    iv.setOnClickListener(new android.view.View.OnClickListener() {
                        @Override public void onClick(android.view.View v) {
                            if (selecting[0]) {
                                if (!sel.remove(f)) sel.add(f);
                                updateCell(iv, sel.contains(f), a);
                                title.setText("已选 " + sel.size() + " 张");
                            } else {
                                sendFileToChat(f);
                            }
                        }
                    });
                    iv.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                        @Override public boolean onLongClick(android.view.View v) {
                            if (!selecting[0]) {
                                selecting[0] = true;
                                sel.clear();
                                sel.add(f);
                                updateCell(iv, true, a);
                                btnAll.setVisibility(android.view.View.VISIBLE);
                                btnDel.setVisibility(android.view.View.VISIBLE);
                                title.setText("已选 " + sel.size() + " 张");
                                log("GALLERY|select mode on");
                            } else {
                                confirmDelete(sel, grid, cells, btnAll, btnDel, title, arr, selecting);
                            }
                            return true;
                        }
                    });
                    cells.add(iv);
                    grid.addView(iv);
                }
                android.widget.ScrollView sv = new android.widget.ScrollView(a);
                sv.setVerticalScrollBarEnabled(false);
                sv.addView(grid);
                wrap.addView(sv, new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
            }

            final android.app.Dialog d = new android.app.Dialog(a, android.R.style.Theme_Translucent_NoTitleBar);
            d.setContentView(wrap);
            android.view.Window win = d.getWindow();
            if (win != null) {
                win.setGravity(android.view.Gravity.BOTTOM);
                win.setLayout(w, (int) (h * 0.62));
                win.setDimAmount(0.35f);
                win.addFlags(android.view.WindowManager.LayoutParams.FLAG_DIM_BEHIND);
            }
            btnAll.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    if (sel.size() == arr.size()) {
                        sel.clear();
                        for (android.widget.ImageView iv : cells) updateCell(iv, false, a);
                    } else {
                        sel.clear();
                        for (android.widget.ImageView iv : cells) {
                            if (iv.getTag() instanceof java.io.File) {
                                sel.add((java.io.File) iv.getTag());
                                updateCell(iv, true, a);
                            }
                        }
                    }
                    title.setText("已选 " + sel.size() + " 张");
                }
            });
            btnDel.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    confirmDelete(sel, grid, cells, btnAll, btnDel, title, arr, selecting);
                }
            });
            btnClose.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) { d.dismiss(); }
            });
            d.show();
            log("GALLERY|panel n=" + arr.size());
        } catch (Throwable t) { toast("打开图库失败：" + t); }
    }

    private static void updateCell(android.widget.ImageView iv, boolean selected, android.content.Context ctx) {
        android.graphics.drawable.GradientDrawable b = new android.graphics.drawable.GradientDrawable();
        b.setColor(0xFFEDEDED);
        b.setCornerRadius(dp(ctx, 6));
        if (selected) {
            b.setStroke(dp(ctx, 3), 0xFF07C160);
        }
        iv.setBackground(b);
        iv.setAlpha(selected ? 0.75f : 1f);
    }

    private static void confirmDelete(final java.util.Set<java.io.File> sel,
                                      final android.view.ViewGroup grid,
                                      final java.util.List<android.widget.ImageView> cells,
                                      final android.widget.TextView btnAll,
                                      final android.widget.TextView btnDel,
                                      final android.widget.TextView title,
                                      final java.util.List<java.io.File> arr,
                                      final boolean[] selecting) {
        if (sel.isEmpty()) { toast("还没选"); return; }
        final android.app.Activity a = chatAct;
        if (a == null) return;
        new android.app.AlertDialog.Builder(a).setTitle("删除选中的 " + sel.size() + " 张？")
                .setPositiveButton("删除", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) {
                        int n = 0;
                        for (java.io.File f : sel) { if (f.delete()) n++; }
                        toast("已删除 " + n + " 张");
                        for (android.widget.ImageView iv : cells) {
                            if (iv.getTag() instanceof java.io.File && sel.contains((java.io.File) iv.getTag())) {
                                grid.removeView(iv);
                            }
                        }
                        sel.clear();
                        selecting[0] = false;
                        btnAll.setVisibility(android.view.View.GONE);
                        btnDel.setVisibility(android.view.View.GONE);
                        title.setText("我的图库 · " + grid.getChildCount() + " 张");
                        log("GALLERY|deleted " + n);
                    }
                })
                .setNegativeButton("取消", null).show();
    }

    /** 把本地文件当图片发到当前聊天（存相册 + 剪贴板 + 粘贴 + 发送） */
    private static void sendFileToChat(final java.io.File f) {
        try {
            byte[] data = readAll(f);
            if (data == null) { toast("读取失败"); return; }
            String name = f.getName();
            if (!name.endsWith(".png") && !name.endsWith(".jpg")) name = name + ".png";
            android.content.ContentValues cv = new android.content.ContentValues();
            cv.put(android.provider.MediaStore.Images.Media.DISPLAY_NAME, name);
            cv.put(android.provider.MediaStore.Images.Media.MIME_TYPE,
                    name.endsWith(".jpg") ? "image/jpeg" : "image/png");
            if (android.os.Build.VERSION.SDK_INT >= 29) {
                cv.put(android.provider.MediaStore.Images.Media.RELATIVE_PATH, "Pictures/wxh");
            }
            android.net.Uri uri = chatAct.getContentResolver().insert(
                    android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI, cv);
            if (uri == null) { toast("写入失败"); return; }
            java.io.OutputStream os = chatAct.getContentResolver().openOutputStream(uri);
            os.write(data);
            os.flush(); os.close();
            android.content.ClipboardManager cm = (android.content.ClipboardManager)
                    chatAct.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
            cm.setPrimaryClip(android.content.ClipData.newUri(chatAct.getContentResolver(), "wxh", uri));
            log("GALLERY|send " + f.getName() + " " + data.length + "B");
            pasteAndSend(chatAct, false);
        } catch (Throwable t) { toast("发送失败：" + t); }
    }

    private static byte[] readAll(java.io.File f) {
        try {
            java.io.FileInputStream in = new java.io.FileInputStream(f);
            java.io.ByteArrayOutputStream bo = new java.io.ByteArrayOutputStream();
            byte[] buf = new byte[8192];
            int n;
            while ((n = in.read(buf)) > 0) bo.write(buf, 0, n);
            in.close();
            return bo.toByteArray();
        } catch (Throwable t) { return null; }
    }

    /** 长按的是不是聊天底部栏里的按钮（表情/加号） */
    private static boolean inChatFooter(android.view.View v) {
        android.view.View cur = v;
        for (int i = 0; i < 10 && cur != null; i++) {
            if (cur.getClass().getName().contains("ChatFooter")
                    || cur.getClass().getName().contains("ChattingFooter")) return true;
            android.view.ViewParent p = cur.getParent();
            if (!(p instanceof android.view.View)) return false;
            cur = (android.view.View) p;
        }
        return false;
    }

    private static final int TAG_FTR_HOT = 0x0f0f0f31;

    /** 给聊天底部栏的表情/加号按钮挂长按 → 打开「我的图库」 */
    private static void attachFooterLongPress(final android.app.Activity a) {
        try {
            android.view.View footer = null;
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            q.add(a.getWindow().getDecorView());
            int scanned = 0;
            while (!q.isEmpty() && scanned < 3000) {
                android.view.View v = q.poll(); scanned++;
                if (v instanceof android.view.ViewGroup) {
                    String cn = v.getClass().getName();
                    if (cn.contains("ChatFooter") || cn.contains("ChattingFooter")) { footer = v; break; }
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) {
                        android.view.View ch = g.getChildAt(i);
                        if (ch != null) q.add(ch);
                    }
                }
            }
            if (footer == null) return;
            int n = attachHotRec(footer, a, 0);
            if (n > 0) log("FTRHOT|attached " + n);
        } catch (Throwable ignore) { }
    }

    private static int attachHotRec(android.view.View v, final android.app.Activity a, int d) {
        if (v == null || d > 8) return 0;
        int n = 0;
        try {
            if (v instanceof android.widget.ImageView && v.getWidth() >= 30 && v.getHeight() >= 30
                    && v.getTag(TAG_FTR_HOT) == null) {
                v.setTag(TAG_FTR_HOT, Boolean.TRUE);
                v.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                    @Override public boolean onLongClick(android.view.View vv) {
                        log("FTRHOT|long " + vv.getClass().getSimpleName());
                        try { openGalleryPanel(a); } catch (Throwable ignore) { }
                        return true;
                    }
                });
                n++;
            }
        } catch (Throwable ignore) { }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) n += attachHotRec(g.getChildAt(i), a, d + 1);
        }
        return n;
    }

    /** 清空我的图库 */
    private static void clearGallery(final android.app.Activity a) {
        final java.io.File dir = new java.io.File("/sdcard/Pictures/wxh");
        java.io.File[] fs = dir.listFiles();
        final int n = fs == null ? 0 : fs.length;
        if (n == 0) { toast("图库已经是空的"); return; }
        new android.app.AlertDialog.Builder(a).setTitle("清空我的图库？")
                .setMessage("共 " + n + " 个文件，删除后不可恢复")
                .setPositiveButton("清空", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        java.io.File[] fs2 = dir.listFiles();
                        int del = 0;
                        if (fs2 != null) for (java.io.File f : fs2) if (f.delete()) del++;
                        toast("已清空 " + del + " 个");
                    }
                })
                .setNegativeButton("取消", null).show();
    }
    /** 消息统计面板：总览 / 按会话 / Top20，全部区分发出与接收 */
    private static void openStatsPanel(final android.app.Activity a) {
        final android.widget.LinearLayout wrap = new android.widget.LinearLayout(a);
        wrap.setOrientation(android.widget.LinearLayout.VERTICAL);
        wrap.setPadding(dp(a, 14), dp(a, 10), dp(a, 14), dp(a, 6));

        final android.widget.LinearLayout chips = new android.widget.LinearLayout(a);
        chips.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        wrap.addView(chips);

        final android.widget.ScrollView sv = new android.widget.ScrollView(a);
        final android.widget.TextView tv = new android.widget.TextView(a);
        tv.setTextSize(13);
        tv.setTextColor(0xFF222222);
        tv.setPadding(dp(a, 4), dp(a, 12), dp(a, 4), dp(a, 16));
        sv.addView(tv);
        wrap.addView(sv, new android.widget.LinearLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(a, 380)));

        final String[] tabs = {"总览", "按会话", "Top20"};
        final int[] cur = {0};
        final String[] cache = new String[3];
        tv.setText("统计中…");

        for (int i = 0; i < tabs.length; i++) {
            final int idx = i;
            android.widget.TextView chip = new android.widget.TextView(a);
            chip.setText(tabs[i]);
            chip.setTextSize(13);
            chip.setGravity(android.view.Gravity.CENTER);
            chip.setPadding(dp(a, 16), dp(a, 7), dp(a, 16), dp(a, 7));
            android.widget.LinearLayout.LayoutParams lp = new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
            lp.rightMargin = dp(a, 8);
            chip.setLayoutParams(lp);
            chip.setTag("chip" + i);
            chips.addView(chip);
            chip.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    cur[0] = idx;
                    paintChips(chips, idx);
                    if (cache[idx] != null) { tv.setText(cache[idx]); return; }
                    tv.setText("统计中…");
                    loadStats(a, idx, tv, cache);
                }
            });
        }
        paintChips(chips, 0);

        new android.app.AlertDialog.Builder(a).setTitle("消息统计")
                .setView(wrap).setPositiveButton("关闭", null).show();
        loadStats(a, 0, tv, cache);
    }

    private static void paintChips(android.widget.LinearLayout chips, int active) {
        for (int i = 0; i < chips.getChildCount(); i++) {
            android.widget.TextView c = (android.widget.TextView) chips.getChildAt(i);
            boolean on = i == active;
            android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
            g.setCornerRadius(dp(chips.getContext(), 16));
            g.setColor(on ? 0xFF07C160 : 0xFFF0F0F2);
            c.setBackground(g);
            c.setTextColor(on ? 0xFFFFFFFF : 0xFF55555A);
        }
    }

    /** idx: 0 总览 / 1 按会话 / 2 Top20 */
    private static void loadStats(final android.app.Activity a, final int idx,
                                  final android.widget.TextView tv, final String[] cache) {
        new Thread(new Runnable() {
            @Override public void run() {
                final StringBuilder sb = new StringBuilder();
                try {
                    Object h = msgDbHandle();
                    if (h == null) { tv.post(new Runnable() { public void run() { tv.setText("数据库未就绪"); } }); return; }
                    // 先判断 createTime 是秒还是毫秒，再算今天 0 点（避免统计错）
                    long maxT = maxCreateTime(h);
                    boolean ms = maxT > 100000000000L;
                    long nowSec = System.currentTimeMillis() / 1000L;
                    long todayStartSec = (nowSec / 86400L) * 86400L - 8 * 3600L;   // 北京时间当天 0 点
                    long todayStart = ms ? todayStartSec * 1000L : todayStartSec;
                    log("STATS|maxT=" + maxT + " ms=" + ms + " start=" + todayStart);
                    if (idx == 0) {
                        long[] all = countPair(h, "select sum(isSend), count(*) from message", null);
                        long[] td = countPair(h, "select sum(isSend), count(*) from message where createTime>="
                                + todayStart, null);
                        long allSend = all[0], allRecv = all[1] - all[0];
                        long tdSend = td[0], tdRecv = td[1] - td[0];
                        sb.append("【全部】\n");
                        sb.append("  发出  ").append(allSend).append(" 条\n");
                        sb.append("  接收  ").append(allRecv).append(" 条\n");
                        sb.append("  合计  ").append(allSend + allRecv).append(" 条\n\n");
                        sb.append("【今天】\n");
                        sb.append("  发出  ").append(tdSend).append(" 条\n");
                        sb.append("  接收  ").append(tdRecv).append(" 条\n");
                        sb.append("  合计  ").append(tdSend + tdRecv).append(" 条\n");
                    } else {
                        boolean todayOnly = idx == 1;
                        String sql = "select talker, sum(isSend), count(*) from message "
                                + (todayOnly ? ("where createTime>=" + todayStart + " ") : "")
                                + "group by talker order by count(*) desc limit 20";
                        sb.append(todayOnly ? "【今天 · 按会话】\n" : "【全部 · 消息量 Top20】\n");
                        java.util.List<String> rows = talkerPairs(h, sql, null);
                        if (rows.isEmpty()) sb.append("  没有数据\n");
                        for (String r : rows) sb.append(r).append('\n');
                    }
                } catch (Throwable t) {
                    sb.append("统计失败：").append(t);
                    log("STATS|err " + t);
                }
                tv.post(new Runnable() {
                    @Override public void run() {
                        String s2 = sb.toString();
                        cache[idx] = s2;
                        tv.setText(s2);
                    }
                });
            }
        }).start();
    }

    /** 返回 [发出, 总数] */
    private static long[] countPair(Object h, String sql, String[] args) throws Exception {
        Object cur = h.getClass().getMethod("B", String.class, String[].class)
                .invoke(h, sql, args == null ? new String[0] : args);
        long send = 0, total = 0;
        if (cur != null) {
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
            if ((Boolean) mv.invoke(cur)) {
                try { send = (Long) gl.invoke(cur, 0); } catch (Throwable ignore) { }
                total = (Long) gl.invoke(cur, 1);
            }
            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
        }
        return new long[]{send, total};
    }

    private static java.util.List<String> talkerPairs(Object h, String sql, String[] args) throws Exception {
        java.util.List<String> out = new java.util.ArrayList<String>();
        Object cur = h.getClass().getMethod("B", String.class, String[].class)
                .invoke(h, sql, args == null ? new String[0] : args);
        if (cur == null) return out;
        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
        java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
        while ((Boolean) mv.invoke(cur)) {
            String talker = (String) gs.invoke(cur, 0);
            long send = (Long) gl.invoke(cur, 1);
            long total = (Long) gl.invoke(cur, 2);
            out.add("  " + displayOfTalker(talker) + "  发 " + send + " / 收 " + (total - send)
                    + " / 共 " + total);
        }
        try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
        return out;
    }

    private static long maxCreateTime(Object h) {
        try {
            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, "select max(createTime) from message", new String[0]);
            if (cur != null) {
                java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                if ((Boolean) mv.invoke(cur)) {
                    long v = (Long) gl.invoke(cur, 0);
                    try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                    return v;
                }
            }
        } catch (Throwable t) { log("STATS|max err " + t); }
        return 0;
    }
    /** 点头像 → 看和 TA 的聊天记录 */
    private static void installAvatarClick(final ClassLoader app) {
        try {
            Class<?> v = Class.forName("android.view.View", false, app);
            XposedBridge.hookAllMethods(v, "performClick", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        android.view.View av = (android.view.View) o;
                        String cn = av.getClass().getName();
                        if (!cn.contains("Avatar")) return;
                        if (av.getWidth() < 20 || av.getHeight() < 20) return;
                        // 头像点击完全让给微信原生（打开资料卡）；本功能改到长按消息菜单
                        if (true) return;
                        String who = null;
                        android.app.Activity top = topAct;
                        boolean inChatNow = (top != null && top.getClass().getName().contains("ChattingUI"))
                                || isInChatUi()
                                || (findMsgList(top == null ? null : top.getWindow().getDecorView()) != null);
                        log("AVHIST|top=" + (top == null ? "null" : top.getClass().getSimpleName())
                                + " inChat=" + inChatNow);
                        if (inChatNow) {
                            // 用当前聊天页标题反查 wxid：这是用户眼里最准的
                            String fromAdapter = talkerFromAdapter(av);
                            String fromRow = fromAdapter != null ? fromAdapter : talkerOfRow(av);
                            String live = liveTalker(top);
                            String title3 = chatNameOfActivity(top);
                            String byName = title3 == null ? null : wxidByName(title3);
                            String tk = fromRow != null && fromRow.length() > 0 ? fromRow
                                    : (live != null && live.length() > 0 ? live : null);
                            if (tk == null) {
                                // 标题和当前静态 talker 的显示名一致，就直接用它
                                String dn = null;
                                try { dn = displayOfTalker(chatTalker); } catch (Throwable ignore) { }
                                if (title3 != null && dn != null && title3.equals(dn)) tk = chatTalker;
                                else if (byName != null && byName.length() > 0) tk = byName;
                                else tk = andByTitle(null, top);
                            }
                            log("AVHIST|fromRow=" + fromRow + " live=" + live + " title=" + title3 + " byName=" + byName);
                            if (tk == null || tk.length() == 0) tk = chatTalker;
                            log("AVHIST|chat title=" + title3 + " byName=" + byName + " tk=" + tk);
                            if (tk == null || tk.length() == 0) return;
                            who = tk.endsWith("@chatroom") ? senderOfRow(av, tk) : tk;
                        } else {
                            // 会话列表：先按行号取 wxid，再退回名字反查
                            who = talkerAtListRow(av);
                            if (who == null || who.length() == 0) {
                                String name = nameOfRow(av);
                                who = wxidByName(name);
                                log("AVHIST|list click name=" + name + " who=" + who);
                            }
                        }
                        log("AVHIST|click who=" + who + " tk=" + chatTalker);
                        if (who == null || who.length() == 0) return;
                        p.setResult(Boolean.TRUE);
                        openHistoryWith(who);
                    } catch (Throwable t) { log("AVHIST|click err " + t); }
                }
            });
            XposedBridge.hookAllMethods(v, "performLongClick", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        android.view.View av = (android.view.View) o;
                        if (!av.getClass().getName().contains("Avatar")) return;
                        if (av.getWidth() < 20 || av.getHeight() < 20) return;
                        avatarFromLongPress = true;
                        try { av.performClick(); } catch (Throwable ignore) { }
                        avatarFromLongPress = false;
                        p.setResult(Boolean.TRUE);
                        log("AVHIST|longpress");
                    } catch (Throwable ignore) { }
                }
            });
            log("AVHIST|installed");
        } catch (Throwable t) { log("AVHIST|install err " + t); }
    }

    /** 从这一行的消息内容里解析发送人 wxid（群聊消息格式 wxid_xxx:\n正文） */
    private static String senderOfRow(android.view.View anchor) {
        return senderOfRow(anchor, chatTalker);
    }

    private static String senderOfRow(android.view.View anchor, String talker) {
        try {
            if (talker == null || talker.length() == 0) return null;
            Object h = msgDbHandle();
            if (h == null) return null;
            String content = null;
            // 1) 用时间戳匹配这一条
            long ts = tsOfAnchor(anchor);
            if (ts > 0) {
                long sec = ts > 100000000000L ? ts / 1000L : ts;
                content = queryContent(h, "select content from message where talker='"
                        + talker.replace("'", "''") + "' and createTime between "
                        + (sec - 2) + " and " + (sec + 2) + " limit 1");
            }
            // 2) 没 tag 就按行位置推断（从下往上数第几条）
            if (content == null) {
                int pfb = rowIndexFromBottomByContainment(anchor);
                log("AVHIST|sender by row pfb=" + pfb);
                if (pfb >= 0) {
                    content = queryContent(h, "select content from message where talker='"
                            + talker.replace("'", "''") + "' order by createTime desc limit 1 offset " + pfb);
                }
            }
            if (content != null) {
                int idx = content.indexOf(':');
                if (idx > 0 && idx < 64) {
                    String head = content.substring(0, idx).trim();
                    if (head.startsWith("wxid_") || head.startsWith("wxid") || head.endsWith("@chatroom")
                            || head.endsWith("@openim")) {
                        log("SENDER|by content " + head);
                        return head;
                    }
                }
            }
            // 3) 群聊里消息行上方会显示发送人昵称，用它反查（比 offset 猜位置准）
            if (talker.endsWith("@chatroom")) {
                String nm = senderNameNearRow(anchor);
                if (nm != null && nm.length() > 0) {
                    String w = wxidByName(nm);
                    log("SENDER|by name " + nm + " -> " + w);
                    if (w != null && w.length() > 0) return w;
                }
            }
            // 4) 兜底：就是当前会话对象
            return talker;
        } catch (Throwable t) { log("AVHIST|sender err " + t); return null; }
    }

    /** 群聊：消息行里气泡上方那一小段文字就是发送人昵称 */
    private static String senderNameNearRow(android.view.View anchor) {
        try {
            android.view.View row = anchor;
            int guard = 0;
            while (row != null && guard++ < 8) {
                android.view.ViewParent p = row.getParent();
                if (!(p instanceof android.view.View)) break;
                String cn = p.getClass().getName();
                if (cn.contains("RecyclerView") || cn.contains("ListView")) break;
                row = (android.view.View) p;
            }
            if (row == null) return null;
            java.util.ArrayList<android.widget.TextView> tvs = new java.util.ArrayList<android.widget.TextView>();
            collectTexts(row, tvs, 0);
            if (tvs.isEmpty()) return null;
            // 最长的那个是气泡正文，其余短文字里取「位置最靠上、且不是时间/状态」的
            android.widget.TextView body = null;
            int bodyLen = -1;
            for (android.widget.TextView tv : tvs) {
                String t = tv.getText() == null ? "" : tv.getText().toString().trim();
                if (t.length() > bodyLen) { bodyLen = t.length(); body = tv; }
            }
            android.widget.TextView best = null;
            int bestTop = Integer.MAX_VALUE;
            for (android.widget.TextView tv : tvs) {
                if (tv == body) continue;
                String t = tv.getText() == null ? "" : tv.getText().toString().trim();
                if (t.length() == 0 || t.length() > 24) continue;
                if (t.matches("[\\d:\\-/\\. ]+")) continue;          // 时间
                if (t.startsWith("已撤回") || t.contains("撤回了一条")) continue;
                if (tv.getTop() < bestTop) { bestTop = tv.getTop(); best = tv; }
            }
            if (best == null) return null;
            return best.getText().toString().trim();
        } catch (Throwable t) { return null; }
    }

    private static String queryContent(Object h, String sql) {        try {
            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, sql, new String[0]);
            String out = null;
            if (cur != null) {
                java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                if ((Boolean) mv.invoke(cur)) out = (String) gs.invoke(cur, 0);
                try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
            }
            return out;
        } catch (Throwable t) { return null; }
    }

    /** 点击头像 → QQ 分类查找式的聊天记录 */
    private static final java.util.HashMap<String, Object[]> histCache =
            new java.util.HashMap<String, Object[]>();

    private static void openHistoryWith(final String wxid) {
        final android.app.Activity a = chatAct;
        if (a == null) return;
        try { new Thread(new Runnable() { public void run() { diagEmojiOnce(); } }).start(); } catch (Throwable ignore) { }
        final Object[] cached = histCache.get(wxid);
        if (cached != null && System.currentTimeMillis() - ((Long) cached[3]).longValue() < 120000L) {
            @SuppressWarnings("unchecked")
            java.util.ArrayList<long[]> cm = (java.util.ArrayList<long[]>) cached[0];
            @SuppressWarnings("unchecked")
            java.util.ArrayList<String> cr = (java.util.ArrayList<String>) cached[1];
            @SuppressWarnings("unchecked")
            java.util.ArrayList<String> cp = (java.util.ArrayList<String>) cached[2];
            log("AVHIST|cache hit " + wxid + " n=" + cm.size());
            showHistoryUi(a, wxid, displayOfTalker(wxid), cm, cr, cp);
            return;
        }
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<long[]> meta = new java.util.ArrayList<long[]>();
                final java.util.ArrayList<String> raw = new java.util.ArrayList<String>();
                final java.util.ArrayList<String> paths = new java.util.ArrayList<String>();
                final String title2 = displayOfTalker(wxid);
                try {
                    Object h = msgDbHandle();
                    if (h != null) {
                        Object cur = h.getClass().getMethod("B", String.class, String[].class)
                                .invoke(h, "select msgId, msgSvrId, createTime, isSend, type, content, imgPath"
                                        + " from message where talker='" + wxid.replace("'", "''")
                                        + "' order by createTime desc limit 300", new String[0]);
                        if (cur != null) {
                            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                            java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                            while ((Boolean) mv.invoke(cur)) {
                                long mid = (Long) gl.invoke(cur, 0);
                                long svrId = (Long) gl.invoke(cur, 1);
                                long t = (Long) gl.invoke(cur, 2);
                                long send = (Long) gl.invoke(cur, 3);
                                long type = (Long) gl.invoke(cur, 4);
                                String c = (String) gs.invoke(cur, 5);
                                String imgPath = null;
                                try { imgPath = (String) gs.invoke(cur, 6); } catch (Throwable ignore) { }
                                if (t < 100000000000L) t *= 1000L;
                                meta.add(new long[]{t, send, type, mid, svrId});
                                raw.add(c == null ? "" : c);
                                paths.add(imgPath == null ? "" : imgPath);
                            }
                            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                        }
                    }
                } catch (Throwable t) { log("AVHIST|query err " + t); }

                histCache.put(wxid, new Object[]{meta, raw, paths, Long.valueOf(System.currentTimeMillis())});
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        showHistoryUi(a, wxid, title2, meta, raw, paths);
                    }
                });
            }
        }).start();
    }

    private static void showHistoryUi(final android.app.Activity a, final String wxid, final String title2,
                                      final java.util.List<long[]> meta, final java.util.List<String> raw,
                                      final java.util.List<String> paths) {
        try {
            final android.widget.LinearLayout root = new android.widget.LinearLayout(a);
            root.setOrientation(android.widget.LinearLayout.VERTICAL);
            root.setBackgroundColor(0x00000000);

            // 顶栏
            android.widget.LinearLayout bar = new android.widget.LinearLayout(a);
            bar.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            bar.setGravity(android.view.Gravity.CENTER_VERTICAL);
            bar.setPadding(dp(a, 20), dp(a, 18), dp(a, 16), dp(a, 4));
            android.widget.TextView head = new android.widget.TextView(a);
            head.setText(title2 + " · 聊天记录");
            head.setTextSize(19);
            head.setTextColor(0xFF141418);
            head.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
            bar.addView(head, new android.widget.LinearLayout.LayoutParams(0,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
            final android.widget.TextView selBtn = new android.widget.TextView(a);
            selBtn.setText("选择");
            selBtn.setTextSize(14);
            selBtn.setTextColor(0xFF3A7AFE);
            selBtn.setPadding(dp(a, 10), dp(a, 6), dp(a, 10), dp(a, 6));
            bar.addView(selBtn);
            android.widget.TextView closeBtn = new android.widget.TextView(a);
            closeBtn.setText("关闭");
            closeBtn.setTextSize(14);
            closeBtn.setTextColor(0xFF8A8A8A);
            closeBtn.setPadding(dp(a, 10), dp(a, 6), dp(a, 4), dp(a, 6));
            bar.addView(closeBtn);
            root.addView(bar);

            final int[] tab = {0};
            // 搜索
            final android.widget.EditText search = new android.widget.EditText(a);
            search.setSingleLine();
            search.setTextSize(13);
            search.setHint("搜索聊天记录");
            search.setBackground(roundRect(0x14000000, dp(a, 20)));
            search.setPadding(dp(a, 18), dp(a, 10), dp(a, 18), dp(a, 10));
            android.widget.LinearLayout.LayoutParams slp = new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
            slp.setMargins(dp(a, 12), dp(a, 6), dp(a, 12), dp(a, 6));
            root.addView(search, slp);

            final android.widget.ScrollView sv = new android.widget.ScrollView(a);
            sv.setBackground(roundRect(0xE2FFFFFF, dp(a, 18)));
            android.widget.LinearLayout.LayoutParams svlp = new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f);
            svlp.setMargins(dp(a, 10), dp(a, 4), dp(a, 10), dp(a, 8));
            final android.widget.LinearLayout content = new android.widget.LinearLayout(a);
            content.setOrientation(android.widget.LinearLayout.VERTICAL);
            content.setPadding(dp(a, 10), dp(a, 6), dp(a, 10), dp(a, 20));
            sv.addView(content);
            root.addView(sv, svlp);

            // 多选操作栏
            final android.widget.LinearLayout bottom = new android.widget.LinearLayout(a);
            bottom.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            bottom.setGravity(android.view.Gravity.CENTER_VERTICAL);
            bottom.setPadding(dp(a, 12), dp(a, 10), dp(a, 12), dp(a, 10));
            bottom.setBackgroundColor(0xFFFFFFFF);
            bottom.setVisibility(android.view.View.GONE);
            final android.widget.TextView cntTxt = new android.widget.TextView(a);
            cntTxt.setText("已选 0");
            cntTxt.setTextSize(14);
            cntTxt.setTextColor(0xFF1A1A1A);
            bottom.addView(cntTxt, new android.widget.LinearLayout.LayoutParams(0,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
            android.widget.TextView allBtn = new android.widget.TextView(a);
            allBtn.setText("全选");
            allBtn.setTextSize(14);
            allBtn.setTextColor(0xFF3A7AFE);
            allBtn.setPadding(dp(a, 12), dp(a, 6), dp(a, 12), dp(a, 6));
            bottom.addView(allBtn);
            android.widget.TextView saveBtn = new android.widget.TextView(a);
            saveBtn.setText("保存到图库");
            saveBtn.setTextSize(14);
            saveBtn.setTextColor(0xFF07C160);
            saveBtn.setPadding(dp(a, 12), dp(a, 6), dp(a, 12), dp(a, 6));
            bottom.addView(saveBtn);
            root.addView(bottom);

            final boolean[] selecting = historySelecting;
            final java.util.LinkedHashSet<Long> sel = historySel;
            historySelecting[0] = false;
            histLimit = 120;
            sel.clear();
            final Runnable refreshSel = new Runnable() {
                @Override public void run() {
                    cntTxt.setText("已选 " + sel.size());
                    bottom.setVisibility(selecting[0] ? android.view.View.VISIBLE : android.view.View.GONE);
                    selBtn.setText(selecting[0] ? "取消" : "选择");
                }
            };
            historySelRefresh = refreshSel;
            final Runnable[] rebuild = new Runnable[1];
            historyRebuild = new Runnable() {
                @Override public void run() {
                    try { if (rebuild[0] != null) rebuild[0].run(); } catch (Throwable ignore) { }
                }
            };

            rebuild[0] = new Runnable() {
                @Override public void run() {
                    content.removeAllViews();
                    String q = search.getText() == null ? "" : search.getText().toString().trim();
                    buildChatList(a, content, wxid, meta, raw, paths, q, selecting, sel);
                }
            };

            final android.app.Dialog[] dRef = new android.app.Dialog[1];
            selBtn.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    selecting[0] = !selecting[0];
                    sel.clear();
                    refreshSel.run();
                    rebuild[0].run();
                }
            });
            allBtn.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    for (int i = 0; i < meta.size(); i++) {
                        sel.add(Long.valueOf(meta.get(i)[3]));
                    }
                    refreshSel.run();
                    rebuild[0].run();
                }
            });
            saveBtn.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    saveSelectedToGallery(a, meta, raw, paths, sel, refreshSel);
                }
            });
            search.addTextChangedListener(new android.text.TextWatcher() {
                @Override public void beforeTextChanged(CharSequence s1, int a1, int b1, int c1) { }
                @Override public void onTextChanged(CharSequence s1, int a1, int b1, int c1) { }
                @Override public void afterTextChanged(android.text.Editable e1) { rebuild[0].run(); }
            });

            buildChatList(a, content, wxid, meta, raw, paths, "", selecting, sel);
            try {
                android.app.Dialog old = historyDialog == null ? null : historyDialog.get();
                if (old != null && old.isShowing()) old.dismiss();
            } catch (Throwable ignore) { }
            dRef[0] = new android.app.Dialog(a, android.R.style.Theme_Translucent_NoTitleBar);
            historyDialog = new java.lang.ref.WeakReference<android.app.Dialog>(dRef[0]);
            dRef[0].setContentView(withBackdrop(a, root, 0x99F7F7FA, dp(a, 20)));
            android.view.Window w = dRef[0].getWindow();
            if (w != null) {
                w.setBackgroundDrawable(glassDrawable(a, 20));
                w.setLayout((int) (a.getResources().getDisplayMetrics().widthPixels * 0.94f),
                        (int) (a.getResources().getDisplayMetrics().heightPixels * 0.84f));
            }
            closeBtn.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) { dRef[0].dismiss(); }
            });
            dRef[0].show();
            int sendN = 0;
            for (long[] m : meta) if (m[1] > 0) sendN++;
            log("AVHIST|open " + title2 + " wxid=" + wxid + " n=" + meta.size()
                    + " 我发=" + sendN + " 收到=" + (meta.size() - sendN));
        } catch (Throwable t) { log("AVHIST|ui err " + t); }
    }

    private static String monthOf(long ts) {
        return new java.text.SimpleDateFormat("yyyy年M月", java.util.Locale.CHINA)
                .format(new java.util.Date(ts));
    }

    /** 日期 tab：气泡列表 */
    private static boolean histOnlyPeer = false;
    private static int histLimit = 120;        // 首屏渲染条数，点"加载更多"递增
    private static String histDay = "";        // 选中的日期 yyyy-MM-dd，空=全部
    private static String histMonth = "";      // 日历显示的月份 yyyy-MM

    /** 日期 tab：日历 + 消息流（选中某天则只显示那天，从最早开始） */
    private static void buildChatList(final android.app.Activity a, final android.widget.LinearLayout content,
                                      final String wxid, java.util.List<long[]> meta, java.util.List<String> raw,
                                      java.util.List<String> paths,
                                      String q, boolean[] selecting, java.util.Set<Long> sel) {

        String dayFilter = histDay == null ? "" : histDay;
        String lastDay = "";
        int shown = 0;
        // 未选日期：从旧到新；选了某天：也只那天、从最早开始
        for (int i = meta.size() - 1; i >= 0; i--) {
            long type = meta.get(i)[2];
            String body = bodyOf(type, raw.get(i));
            if (body == null) continue;
            if (q.length() > 0 && !body.contains(q)) continue;
            long t = meta.get(i)[0];
            String day = fmtTs(t).substring(0, 10);
            if (dayFilter.length() > 0 && !day.equals(dayFilter)) continue;
            boolean mine = meta.get(i)[1] > 0;
            if (mine) continue;                       // 只看对方说的
            if (!day.equals(lastDay)) {
                lastDay = day;
                content.addView(dayHeader(a, day));
            }
            if (type == 3) {
                final android.widget.ImageView iv = new android.widget.ImageView(a);
                iv.setScaleType(android.widget.ImageView.ScaleType.CENTER_CROP);
                android.graphics.drawable.GradientDrawable gb = new android.graphics.drawable.GradientDrawable();
                gb.setColor(mine ? 0xFF95EC69 : 0xFFE8E8EA);
                gb.setCornerRadius(dp(a, 8));
                iv.setBackground(gb);
                android.widget.LinearLayout holder = new android.widget.LinearLayout(a);
                holder.setGravity(android.view.Gravity.CENTER_VERTICAL);
                holder.setPadding(0, dp(a, 4), 0, dp(a, 4));
                holder.addView(iv, new android.widget.LinearLayout.LayoutParams(dp(a, 140), dp(a, 140)));
                holder.addView(new android.view.View(a), new android.widget.LinearLayout.LayoutParams(0, 1, 1f));
                android.widget.TextView imgTime = new android.widget.TextView(a);
                imgTime.setText(fmtTs(t).substring(5, 19));
                imgTime.setTextSize(10);
                imgTime.setTextColor(0x66808080);
                imgTime.setPadding(dp(a, 6), 0, dp(a, 2), 0);
                holder.addView(imgTime);
                content.addView(holder);
                final long fsvr = meta.get(i)[4];
                final int i2 = i;
                final String fak = attrOf(raw.get(i), "aeskey");
                final long fts2 = t;
                final long fmid2 = meta.get(i)[3];
                final android.graphics.Bitmap[] bmRef = new android.graphics.Bitmap[1];
                new Thread(new Runnable() {
                    @Override public void run() {
                        final String fpath = paths.size() > i2 ? paths.get(i2) : null;
                        final String alt = attrOf(raw.get(i2), "cdnthumbaeskey");
                        final android.graphics.Bitmap bm = loadImageThumb2(msgDbHandle(), fsvr, fak, fpath, alt);
                        a.runOnUiThread(new Runnable() {
                            @Override public void run() {
                                if (bm != null) { iv.setImageBitmap(bm); bmRef[0] = bm; }
                                else iv.setBackgroundColor(0xFFE8E8EA);
                            }
                        });
                    }
                }).start();
                iv.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        if (historySelecting[0]) {
                            if (!historySel.remove(Long.valueOf(fmid2))) historySel.add(Long.valueOf(fmid2));
                            v.setAlpha(historySel.contains(Long.valueOf(fmid2)) ? 0.55f : 1f);
                            if (historySelRefresh != null) historySelRefresh.run();
                            return;
                        }
                        if (bmRef[0] != null) showImageDialog(a, bmRef[0], wxid, fts2, fmid2);
                    }
                });
                android.view.View.OnLongClickListener lpImg = new android.view.View.OnLongClickListener() {
                    @Override public boolean onLongClick(android.view.View v) {
                        jumpToMessage(wxid, fts2, fmid2);
                        return true;
                    }
                };
                iv.setOnLongClickListener(lpImg);
                holder.setOnLongClickListener(lpImg);
                shown++;
                continue;
            }
            if (type == 47) {
                // 表情：有缓存就显示小图
                String md5 = emojiMd5(raw.get(i));
                android.graphics.Bitmap eb = loadEmojiBitmap(md5, attrOf(raw.get(i), "aeskey"));
                if (eb != null) {
                    final android.widget.ImageView eiv = new android.widget.ImageView(a);
                    eiv.setImageBitmap(eb);
                    eiv.setScaleType(android.widget.ImageView.ScaleType.FIT_CENTER);
                    android.widget.LinearLayout eh = new android.widget.LinearLayout(a);
                    eh.setGravity(android.view.Gravity.CENTER_VERTICAL);
                    eh.setPadding(0, dp(a, 4), 0, dp(a, 4));
                    eh.addView(eiv, new android.widget.LinearLayout.LayoutParams(dp(a, 96), dp(a, 96)));
                    eh.addView(new android.view.View(a), new android.widget.LinearLayout.LayoutParams(0, 1, 1f));
                    android.widget.TextView emTime = new android.widget.TextView(a);
                    emTime.setText(fmtTs(t).substring(5, 19));
                    emTime.setTextSize(10);
                    emTime.setTextColor(0x66808080);
                    emTime.setPadding(dp(a, 6), 0, dp(a, 2), 0);
                    eh.addView(emTime);
                    content.addView(eh);
                    final long emid = meta.get(i)[3];
                    final long ets = t;
                    android.view.View.OnLongClickListener lpe = new android.view.View.OnLongClickListener() {
                        @Override public boolean onLongClick(android.view.View v) {
                            jumpToMessage(wxid, ets, emid);
                            return true;
                        }
                    };
                    eiv.setOnLongClickListener(lpe);
                    eh.setOnLongClickListener(lpe);
                    shown++;
                    continue;
                }
            }
            android.view.View bub = bubble(a, body, false, fmtTs(t).substring(5, 19), null, null);
            attachHistoryActions(a, bub, null, wxid, t, meta.get(i)[3], body, type, meta.get(i)[4]);
            content.addView(bub);
            shown++;
            if (shown >= histLimit) break;
        }
        if (shown >= histLimit) {
            android.widget.TextView more = new android.widget.TextView(a);
            more.setText("加载更多…");
            more.setTextSize(13);
            more.setTextColor(0xFF07C160);
            more.setGravity(android.view.Gravity.CENTER);
            more.setPadding(0, dp(a, 14), 0, dp(a, 14));
            more.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    histLimit += 150;
                    if (historyRebuild != null) historyRebuild.run();
                }
            });
            content.addView(more);
        }
        if (shown == 0) content.addView(emptyHint(a, q.length() > 0 ? "没有匹配的记录" : "没有聊天记录"));
    }

    /** 月历：有聊天记录的日子高亮，点一天就筛选那天 */
    private static void buildCalendar(final android.app.Activity a, final android.widget.LinearLayout content,
                                      final java.util.List<long[]> meta) {
        try {
            java.util.HashMap<String, Integer> byDay = new java.util.HashMap<String, Integer>();
            for (long[] m : meta) {
                String d = fmtTs(m[0]).substring(0, 10);
                Integer v = byDay.get(d);
                byDay.put(d, Integer.valueOf(v == null ? 1 : v.intValue() + 1));
            }
            if (histMonth == null || histMonth.length() == 0) {
                histMonth = fmtTs(meta.isEmpty() ? System.currentTimeMillis() : meta.get(0)[0]).substring(0, 7);
            }
            final android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setBackgroundColor(0xFFFFFFFF);
            box.setPadding(dp(a, 8), dp(a, 6), dp(a, 8), dp(a, 8));

            // 月份切换
            android.widget.LinearLayout top = new android.widget.LinearLayout(a);
            top.setGravity(android.view.Gravity.CENTER_VERTICAL);
            android.widget.TextView prev = new android.widget.TextView(a);
            prev.setText("‹");
            prev.setTextSize(20);
            prev.setTextColor(0xFF666666);
            prev.setPadding(dp(a, 12), 0, dp(a, 12), 0);
            final android.widget.TextView mon = new android.widget.TextView(a);
            mon.setText(histMonth);
            mon.setTextSize(15);
            mon.setTextColor(0xFF1A1A1A);
            mon.setGravity(android.view.Gravity.CENTER);
            mon.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
            android.widget.TextView next = new android.widget.TextView(a);
            next.setText("›");
            next.setTextSize(20);
            next.setTextColor(0xFF666666);
            next.setPadding(dp(a, 12), 0, dp(a, 12), 0);
            top.addView(prev);
            top.addView(mon, new android.widget.LinearLayout.LayoutParams(0,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
            top.addView(next);
            box.addView(top);

            // 星期表头
            android.widget.LinearLayout wk = new android.widget.LinearLayout(a);
            String[] names = {"日", "一", "二", "三", "四", "五", "六"};
            for (String n : names) {
                android.widget.TextView tv = new android.widget.TextView(a);
                tv.setText(n);
                tv.setTextSize(11);
                tv.setTextColor(0xFF9A9A9E);
                tv.setGravity(android.view.Gravity.CENTER);
                tv.setLayoutParams(new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
                wk.addView(tv);
            }
            box.addView(wk);

            final android.widget.LinearLayout grid = new android.widget.LinearLayout(a);
            grid.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.addView(grid);
            content.addView(box);

            final android.widget.LinearLayout[] gridRef = new android.widget.LinearLayout[]{grid};
            final android.widget.TextView[] monRef = new android.widget.TextView[]{mon};
            final java.util.HashMap<String, Integer> days = byDay;
            final Runnable paint = new Runnable() {
                @Override public void run() {
                    android.widget.LinearLayout g = gridRef[0];
                    g.removeAllViews();
                    monRef[0].setText(histMonth);
                    java.util.Calendar cal = java.util.Calendar.getInstance();
                    String[] ym = histMonth.split("-");
                    cal.set(Integer.parseInt(ym[0]), Integer.parseInt(ym[1]) - 1, 1);
                    int firstDow = cal.get(java.util.Calendar.DAY_OF_WEEK) - 1;
                    int maxDay = cal.getActualMaximum(java.util.Calendar.DAY_OF_MONTH);
                    android.widget.LinearLayout row = null;
                    int col = 0;
                    for (int i = 0; i < firstDow; i++) {
                        if (col == 0) { row = newRow(a); g.addView(row); }
                        android.widget.TextView sp = new android.widget.TextView(a);
                        sp.setLayoutParams(new android.widget.LinearLayout.LayoutParams(0, dp(a, 36), 1f));
                        row.addView(sp);
                        col++;
                    }
                    for (int d = 1; d <= maxDay; d++) {
                        if (col == 0) { row = newRow(a); g.addView(row); }
                        final String key = histMonth + "-" + (d < 10 ? "0" + d : String.valueOf(d));
                        int cnt = days.containsKey(key) ? days.get(key).intValue() : 0;
                        android.widget.TextView cell = new android.widget.TextView(a);
                        cell.setText(String.valueOf(d));
                        cell.setGravity(android.view.Gravity.CENTER);
                        cell.setTextSize(13);
                        boolean on = key.equals(histDay);
                        cell.setTextColor(on ? 0xFFFFFFFF : (cnt > 0 ? 0xFF1A1A1A : 0xFFBBBBBB));
                        if (on) {
                            android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
                            gd.setCornerRadius(dp(a, 18));
                            gd.setColor(0xFF07C160);
                            cell.setBackground(gd);
                        } else if (cnt > 0) {
                            android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
                            gd.setCornerRadius(dp(a, 18));
                            gd.setColor(0xFFEAF7EF);
                            cell.setBackground(gd);
                        }
                        cell.setLayoutParams(new android.widget.LinearLayout.LayoutParams(0, dp(a, 36), 1f));
                        final boolean hasRec = cnt > 0;
                        cell.setOnClickListener(new android.view.View.OnClickListener() {
                            @Override public void onClick(android.view.View v) {
                                if (!hasRec) return;
                                histDay = key.equals(histDay) ? "" : key;
                                if (historyRebuild != null) historyRebuild.run();
                            }
                        });
                        row.addView(cell);
                        col = (col + 1) % 7;
                    }
                }
            };
            historyCalendarRepaint = paint;
            paint.run();

            prev.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    shiftMonth(-1);
                    if (historyCalendarRepaint != null) historyCalendarRepaint.run();
                }
            });
            next.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    shiftMonth(1);
                    if (historyCalendarRepaint != null) historyCalendarRepaint.run();
                }
            });
            if (histDay != null && histDay.length() > 0) {
                android.widget.TextView tip = new android.widget.TextView(a);
                tip.setText("只看 " + histDay + " · 点日历再点一次取消");
                tip.setTextSize(11);
                tip.setTextColor(0xFF07C160);
                tip.setPadding(0, dp(a, 6), 0, 0);
                content.addView(tip);
            }
        } catch (Throwable t) { log("CAL|err " + t); }
    }

    private static android.widget.LinearLayout newRow(android.app.Activity a) {
        android.widget.LinearLayout r = new android.widget.LinearLayout(a);
        r.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        return r;
    }

    private static void shiftMonth(int delta) {
        try {
            java.util.Calendar cal = java.util.Calendar.getInstance();
            String[] ym = histMonth.split("-");
            cal.set(Integer.parseInt(ym[0]), Integer.parseInt(ym[1]) - 1, 1);
            cal.add(java.util.Calendar.MONTH, delta);
            histMonth = new java.text.SimpleDateFormat("yyyy-MM", java.util.Locale.CHINA).format(cal.getTime());
        } catch (Throwable ignore) { }
    }

    private static android.widget.TextView dayHeader(android.content.Context ctx, String day) {
        android.widget.TextView dt = new android.widget.TextView(ctx);
        dt.setText(day);
        dt.setTextSize(11);
        dt.setTextColor(0xFF999999);
        dt.setGravity(android.view.Gravity.CENTER);
        dt.setPadding(0, dp(ctx, 12), 0, dp(ctx, 10));
        return dt;
    }

    private static android.widget.TextView emptyHint(android.content.Context ctx, String s2) {
        android.widget.TextView tv = new android.widget.TextView(ctx);
        tv.setText(s2);
        tv.setTextSize(13);
        tv.setTextColor(0xFF999999);
        tv.setGravity(android.view.Gravity.CENTER);
        tv.setPadding(0, dp(ctx, 60), 0, dp(ctx, 60));
        return tv;
    }

    /** 图片/视频、表情：按月分组的网格 */
    private static void buildMediaGrid(final android.app.Activity a, android.widget.LinearLayout content,
                                       final String wxid, java.util.List<long[]> meta, java.util.List<String> raw,
                                       java.util.List<String> paths,
                                       String q, boolean emojiOnly, final boolean[] selecting,
                                       final java.util.Set<Long> sel, android.widget.TextView selBtn) {
        final java.util.List<Integer> idxs = new java.util.ArrayList<Integer>();
        for (int i = meta.size() - 1; i >= 0; i--) {
            long type = meta.get(i)[2];
            if (!emojiOnly) {
            int vlog = 0;
            for (Integer ii : idxs) {
                if (meta.get(ii.intValue())[2] == 43 && vlog++ < 1) log("VIDEO|" + raw.get(ii.intValue()));
            }
        }
        if (emojiOnly) {
                if (type != 47) continue;
            } else {
                if (type != 3 && type != 43) continue;
            }
            if (q.length() > 0) {
                String b = bodyOf(type, raw.get(i));
                if (b == null || !b.contains(q)) continue;
            }
            idxs.add(Integer.valueOf(i));
        }
        if (emojiOnly) {
            int shownLog = 0;
            for (Integer ii : idxs) {
                if (shownLog++ >= 2) break;
                log("EMOJI|" + raw.get(ii.intValue()));
            }
        }
        if (idxs.isEmpty()) { content.addView(emptyHint(a, emojiOnly ? "没有表情" : "没有图片/视频")); return; }

        int w = a.getResources().getDisplayMetrics().widthPixels;
        int cell = (int) ((w * 0.96f - dp(a, 60)) / 3f);
        String lastMonth = "";
        android.widget.GridLayout grid = null;
        int col = 0;
        for (Integer ii : idxs) {
            int i = ii.intValue();
            long t = meta.get(i)[0];
            String m = monthOf(t);
            if (!m.equals(lastMonth)) {
                lastMonth = m;
                android.widget.TextView mh = new android.widget.TextView(a);
                mh.setText("▾ " + m);
                mh.setTextSize(12);
                mh.setTextColor(0xFF8A8A8E);
                mh.setPadding(0, dp(a, 12), 0, dp(a, 6));
                content.addView(mh);
                grid = new android.widget.GridLayout(a);
                grid.setColumnCount(3);
                content.addView(grid, new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT));
                col = 0;
            }
            android.widget.FrameLayout cellView = new android.widget.FrameLayout(a);
            android.widget.GridLayout.LayoutParams glp = new android.widget.GridLayout.LayoutParams();
            glp.width = cell; glp.height = cell;
            int gap = dp(a, 3);
            glp.setMargins(gap, gap, gap, gap);
            cellView.setLayoutParams(glp);
            android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
            bg.setColor(0xFFE8E8EA);
            bg.setCornerRadius(dp(a, 4));
            cellView.setBackground(bg);

            if (emojiOnly) {
                String md5 = emojiMd5(raw.get(i));
                android.graphics.Bitmap eb = loadCachedEmoji(md5);
                if (eb != null) {
                    android.widget.ImageView eiv = new android.widget.ImageView(a);
                    eiv.setImageBitmap(eb);
                    eiv.setScaleType(android.widget.ImageView.ScaleType.FIT_CENTER);
                    eiv.setPadding(dp(a, 8), dp(a, 8), dp(a, 8), dp(a, 8));
                    cellView.addView(eiv);
                } else {
                    android.widget.TextView tv = new android.widget.TextView(a);
                    tv.setText("[表情]\n" + fmtTs(t).substring(5, 10));
                    tv.setTextSize(11);
                    tv.setTextColor(0xFF888888);
                    tv.setGravity(android.view.Gravity.CENTER);
                    cellView.addView(tv);
                }
            } else {
                long type = meta.get(i)[2];
                if (type == 3) {
                    android.graphics.Bitmap bm = loadImageThumb2(msgDbHandle(), meta.get(i)[4],
                            attrOf(raw.get(i), "aeskey"), paths.size() > i ? paths.get(i) : null,
                            attrOf(raw.get(i), "cdnthumbaeskey"));
                    if (bm != null) {
                        android.widget.ImageView iv = new android.widget.ImageView(a);
                        iv.setImageBitmap(bm);
                        iv.setScaleType(android.widget.ImageView.ScaleType.CENTER_CROP);
                        cellView.addView(iv);
                    } else {
                        android.widget.TextView tv = new android.widget.TextView(a);
                        tv.setText("[图片]");
                        tv.setTextSize(11);
                        tv.setTextColor(0xFF888888);
                        tv.setGravity(android.view.Gravity.CENTER);
                        cellView.addView(tv);
                    }
                } else {
                    android.widget.TextView tv = new android.widget.TextView(a);
                    tv.setText("▶ " + attrOf(raw.get(i), "playlength") + "″");
                    tv.setTextSize(12);
                    tv.setTextColor(0xFFFFFFFF);
                    tv.setGravity(android.view.Gravity.CENTER);
                    android.graphics.drawable.GradientDrawable vb = new android.graphics.drawable.GradientDrawable();
                    vb.setColor(0xFF3A3A44);
                    vb.setCornerRadius(dp(a, 4));
                    cellView.setBackground(vb);
                    cellView.addView(tv);
                }
            }
            final int idx = i;
            final long cellMid = meta.get(idx)[3];
            cellView.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    if (historySelecting[0]) {
                        if (!historySel.remove(Long.valueOf(cellMid))) historySel.add(Long.valueOf(cellMid));
                        v.setAlpha(historySel.contains(Long.valueOf(cellMid)) ? 0.55f : 1f);
                        if (historySelRefresh != null) historySelRefresh.run();
                        return;
                    }
                    final android.graphics.Bitmap gbm = (meta.get(idx)[2] == 3)
                            ? loadImageThumb2(msgDbHandle(), meta.get(idx)[4],
                                attrOf(raw.get(idx), "aeskey"),
                                paths.size() > idx ? paths.get(idx) : null,
                                attrOf(raw.get(idx), "cdnthumbaeskey"))
                            : null;
                    if (gbm != null) showImageDialog(a, gbm, wxid, meta.get(idx)[0], cellMid);
                    else jumpToMessage(wxid, meta.get(idx)[0], cellMid);
                }
            });
            cellView.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                @Override public boolean onLongClick(android.view.View v) {
                    jumpToMessage(wxid, meta.get(idx)[0], meta.get(idx)[3]);
                    return true;
                }
            });
            if (grid != null) { grid.addView(cellView); col++; }
        }
    }

    /** 文件 / 链接 / 语音：列表行 */
    private static void buildRows(final android.app.Activity a, android.widget.LinearLayout content,
                                  final String wxid, java.util.List<long[]> meta, java.util.List<String> raw,
                                  String q, int tab, boolean[] selecting, java.util.Set<Long> sel) {
        int shown = 0;
        String lastMonth = "";
        for (int i = meta.size() - 1; i >= 0; i--) {
            long type = meta.get(i)[2];
            String c = raw.get(i);
            int appType = 0;
            try { appType = Integer.parseInt(tagOf(c, "type")); } catch (Throwable ignore) { }
            boolean ok;
            if (tab == 3) ok = (type == 49 && appType == 6);
            else if (tab == 4) ok = (type == 49 && (appType == 5));
            else ok = (type == 34 || type == 64);
            if (!ok) continue;
            String name;
            String sub;
            long t = meta.get(i)[0];
            if (tab == 3) {
                name = tagOf(c, "title");
                long total = 0;
                try { total = Long.parseLong(tagOf(c, "totallen")); } catch (Throwable ignore) { }
                sub = fmtTs(t).substring(0, 10) + "  " + (total > 0 ? (total / 1024) + "KB" : "");
            } else if (tab == 4) {
                name = tagOf(c, "title");
                sub = tagOf(c, "url");
            } else {
                int vl = 0;
                try { vl = Integer.parseInt(attrOf(c, "voicelength")) / 1000; } catch (Throwable ignore) { }
                name = "[语音] " + Math.max(1, vl) + "″";
                sub = fmtTs(t).substring(0, 10);
            }
            if (q.length() > 0 && !(name.contains(q) || sub.contains(q))) continue;
            String m = monthOf(t);
            if (!m.equals(lastMonth)) {
                lastMonth = m;
                android.widget.TextView mh = new android.widget.TextView(a);
                mh.setText("▾ " + m);
                mh.setTextSize(12);
                mh.setTextColor(0xFF8A8A8E);
                mh.setPadding(0, dp(a, 12), 0, dp(a, 6));
                content.addView(mh);
            }
            content.addView(rowItem(a, wxid, meta.get(i), name, sub, tab,
                    tab == 4 ? tagOf(c, "url") : null));
            shown++;
        }
        if (shown == 0) content.addView(emptyHint(a, "没有符合条件的记录"));
    }

    private static android.view.View rowItem(final android.app.Activity a, final String wxid,
                                             final long[] m, String name, String sub, final int tab,
                                             final String url) {
        android.widget.LinearLayout row = new android.widget.LinearLayout(a);
        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        row.setGravity(android.view.Gravity.CENTER_VERTICAL);
        row.setPadding(dp(a, 4), dp(a, 10), dp(a, 4), dp(a, 10));
        android.widget.TextView icon = new android.widget.TextView(a);
        icon.setText(tab == 3 ? "📄" : (tab == 4 ? "🔗" : "🎤"));
        icon.setTextSize(22);
        row.addView(icon);
        android.widget.LinearLayout col = new android.widget.LinearLayout(a);
        col.setOrientation(android.widget.LinearLayout.VERTICAL);
        col.setPadding(dp(a, 10), 0, 0, 0);
        android.widget.TextView t1 = new android.widget.TextView(a);
        t1.setText(name);
        t1.setTextSize(14);
        t1.setTextColor(0xFF1A1A1A);
        t1.setSingleLine(true);
        t1.setEllipsize(android.text.TextUtils.TruncateAt.END);
        col.addView(t1);
        android.widget.TextView t2 = new android.widget.TextView(a);
        t2.setText(sub);
        t2.setTextSize(11);
        t2.setTextColor(0xFF9A9A9E);
        t2.setSingleLine(true);
        t2.setEllipsize(android.text.TextUtils.TruncateAt.END);
        col.addView(t2);
        row.addView(col, new android.widget.LinearLayout.LayoutParams(0,
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
        row.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                if (historySelecting[0]) {
                    if (!historySel.remove(Long.valueOf(m[3]))) historySel.add(Long.valueOf(m[3]));
                    v.setAlpha(historySel.contains(Long.valueOf(m[3])) ? 0.55f : 1f);
                    if (historySelRefresh != null) historySelRefresh.run();
                    return;
                }
                if (tab == 4 && url != null && url.startsWith("http")) {
                    try {
                        android.content.Intent it = new android.content.Intent(
                                android.content.Intent.ACTION_VIEW, android.net.Uri.parse(url));
                        it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
                        a.startActivity(it);
                        log("LINK|open " + url);
                        return;
                    } catch (Throwable t) { log("LINK|err " + t); }
                }
                jumpToMessage(wxid, m[0], m[3]);
            }
        });
        return row;
    }

    private static android.view.View bubble(android.content.Context ctx, String text,
                                             boolean mine, String hhmm) {
        return bubble(ctx, text, mine, hhmm, null, null);
    }

    private static android.view.View bubble(final android.content.Context ctx, String text,
                                             boolean mine, String hhmm,
                                             final android.graphics.Bitmap thumb,
                                             final android.view.View.OnLongClickListener longPress) {
        android.widget.LinearLayout row = new android.widget.LinearLayout(ctx);
        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        row.setGravity(mine ? android.view.Gravity.END : android.view.Gravity.START);
        row.setPadding(0, dp(ctx, 4), 0, dp(ctx, 4));

        android.widget.TextView tv = new android.widget.TextView(ctx);
        tv.setText(text);
        tv.setTextSize(14);
        tv.setTextColor(0xFF1A1A1A);
        tv.setTextIsSelectable(true);
        tv.setLineSpacing(dp(ctx, 2), 1f);
        tv.setPadding(dp(ctx, 10), dp(ctx, 7), dp(ctx, 10), dp(ctx, 7));
        android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
        g.setColor(mine ? 0xFF95EC69 : 0xFFFFFFFF);
        g.setCornerRadius(dp(ctx, 8));
        tv.setBackground(g);
        int max = (int) (ctx.getResources().getDisplayMetrics().widthPixels * 0.66f);
        tv.setMaxWidth(max);
        if (thumb != null) {
            // 图片消息：显示缩略图，点击放大
            android.widget.ImageView iv = new android.widget.ImageView(ctx);
            iv.setImageBitmap(thumb);
            iv.setScaleType(android.widget.ImageView.ScaleType.FIT_CENTER);
            int dpMax = dp(ctx, 170);
            int w2 = thumb.getWidth(), h2 = thumb.getHeight();
            int vw = w2, vh = h2;
            if (w2 > dpMax || h2 > dpMax) {
                if (w2 >= h2) { vw = dpMax; vh = Math.max(dp(ctx, 40), h2 * dpMax / w2); }
                else { vh = dpMax; vw = Math.max(dp(ctx, 40), w2 * dpMax / h2); }
            }
            android.graphics.drawable.GradientDrawable gb = new android.graphics.drawable.GradientDrawable();
            gb.setColor(mine ? 0xFF95EC69 : 0xFFFFFFFF);
            gb.setCornerRadius(dp(ctx, 8));
            iv.setBackground(gb);
            iv.setPadding(1, 1, 1, 1);
            row.addView(iv, new android.widget.LinearLayout.LayoutParams(vw, vh));
            iv.setLongClickable(true);
            iv.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                @Override public boolean onLongClick(android.view.View v) {
                    try { if (longPress != null) return longPress.onLongClick(v); } catch (Throwable ignore) { }
                    return false;
                }
            });
            iv.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    try {
                        android.app.Dialog big = new android.app.Dialog(ctx,
                                android.R.style.Theme_Translucent_NoTitleBar);
                        android.widget.ImageView full = new android.widget.ImageView(ctx);
                        full.setImageBitmap(thumb);
                        full.setScaleType(android.widget.ImageView.ScaleType.FIT_CENTER);
                        big.setContentView(full);
                        android.view.Window w = big.getWindow();
                        if (w != null) {
                            w.setLayout((int) (ctx.getResources().getDisplayMetrics().widthPixels * 0.94f),
                                    (int) (ctx.getResources().getDisplayMetrics().heightPixels * 0.8f));
                        }
                        big.show();
                    } catch (Throwable ignore) { }
                }
            });
        } else {
            row.addView(tv);
        }

        // 时间统一放最右边
        android.view.View spacer = new android.view.View(ctx);
        row.addView(spacer, new android.widget.LinearLayout.LayoutParams(0, 1, 1f));
        android.widget.TextView time = new android.widget.TextView(ctx);
        time.setText(hhmm);
        time.setTextSize(10);
        time.setTextColor(0x66808080);
        android.widget.LinearLayout.LayoutParams lp = new android.widget.LinearLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
        lp.leftMargin = dp(ctx, 6);
        lp.rightMargin = dp(ctx, 2);
        lp.gravity = android.view.Gravity.BOTTOM;
        row.addView(time, lp);
        return row;
    }

    /** XML 属性 */
    private static String attrOf(String xml, String name) {
        try {
            int i = xml.indexOf(name + "=\"");
            if (i < 0) return "";
            int s0 = i + name.length() + 2;
            int e0 = xml.indexOf('"', s0);
            return e0 > s0 ? xml.substring(s0, e0) : "";
        } catch (Throwable t) { return ""; }
    }

    /** 是不是系统消息（撤回/入群/拍一拍等），这类要居中灰字 */
    private static boolean isSystemMsg(long type, String c) {
        if (type == 10000 || type == 10002) return true;
        if (c == null) return false;
        String s0 = c.trim();
        return s0.startsWith("<sysmsg");
    }

    /** 所有消息类型都翻译成可读内容 */
    private static String bodyOf(long type, String c) {
        if (c == null) return null;
        String s2 = c;
        if (isSystemMsg(type, c)) {
            String t = s2;
            if (t.startsWith("<sysmsg")) {
                t = t.replaceAll("<[^>]*>", " ").replaceAll("\\s+", " ").trim();
            }
            if (t.length() == 0) t = "系统消息";
            return t.length() > 300 ? t.substring(0, 300) + "…" : t;
        }
        int idx = s2.indexOf(':');
        if (idx > 0 && idx < 64) {
            String head = s2.substring(0, idx).trim();
            if (head.startsWith("wxid_") || head.endsWith("@chatroom") || head.endsWith("@openim")) {
                s2 = s2.substring(idx + 1).trim();
            }
        }
        if (type == 1) return s2.length() > 400 ? s2.substring(0, 400) + "…" : s2;
        if (type == 3) {
            String len = attrOf(s2, "length");
            String hd = attrOf(s2, "cdnthumbwidth"), hi = attrOf(s2, "cdnthumbheight");
            String sz = "";
            try {
                long l = Long.parseLong(len);
                if (l > 0) sz = String.format(" %dKB", l / 1024);
            } catch (Throwable ignore) { }
            return "[图片" + (hd.length() > 0 ? " " + hd + "×" + hi : "") + sz + "]";
        }
        if (type == 34) {
            String vl = attrOf(s2, "voicelength");
            try { return "[语音 " + Math.max(1, Integer.parseInt(vl) / 1000) + "″]"; }
            catch (Throwable t) { return "[语音]"; }
        }
        if (type == 43) {
            String pl = attrOf(s2, "playlength");
            return pl.length() > 0 ? "[视频 " + pl + "″]" : "[视频]";
        }
        if (type == 47) {
            String md5 = attrOf(s2, "md5");
            return "[表情" + (md5.length() > 8 ? " " + md5.substring(0, 8) : "") + "]";
        }
        if (type == 48) {
            String label = attrOf(s2, "label");
            String x = attrOf(s2, "x"), y = attrOf(s2, "y");
            return "[位置] " + label + (x.length() > 0 ? " (" + x + "," + y + ")" : "");
        }
        if (type == 42) {
            String nn = attrOf(s2, "nickname");
            return "[名片] " + nn;
        }
        if (type == 49) {
            String title = tagOf(s2, "title");
            String des = tagOf(s2, "des");
            String atype = tagOf(s2, "type");
            String url = tagOf(s2, "url");
            String app = tagOf(s2, "appname");
            String total = tagOf(s2, "totallen");
            try {
                int at = Integer.parseInt(atype);
                if (at == 2001) return "[红包] " + title;
                if (at == 2000) {
                    String fee = tagOf(s2, "feedesc");
                    return "[转账] " + (fee.length() > 0 ? fee : title);
                }
                if (at == 6) {
                    long tl = 0;
                    try { tl = Long.parseLong(total); } catch (Throwable ignore) { }
                    return "[文件] " + title + (tl > 0 ? "  " + (tl / 1024) + "KB" : "");
                }
                if (at == 5) return "[链接] " + title + (des.length() > 0 ? "\n" + des : "")
                        + (url.length() > 0 ? "\n" + url : "");
                if (at == 19) return "[聊天记录] " + title;
                if (at == 33 || at == 36) return "[小程序] " + title;
                if (at == 57) return "[引用] " + (title.length() > 0 ? title : des);
                if (at == 51 || at == 63) return "[视频号] " + title;
                if (at == 40) return "[聊天记录] " + title;
                if (at == 62) return "[表情包] " + title;
            } catch (Throwable ignore) { }
            return "[链接/文件] " + title + (des.length() > 0 ? " · " + des : "")
                    + (app.length() > 0 ? " (" + app + ")" : "");
        }
        if (type == 50) return "[语音通话]";
        if (type == 53) return "[视频号/直播]";
        if (type == 62) return "[视频号]";
        if (type == 64) return "[语音]";
        if (type == 10000 || type == 10002) return "[系统]";
        if (type == 436207665 || type == 469762097) return "[收付款]";
        if (type == 268445456) return "[拍一拍]";
        if (type == 285212721) return "[接龙]";
        if (type == 1048625009) return "[直播]";
        if (type == 419430449) return "[语音]" ;
        String plain = s2.replaceAll("<[^>]*>", "").replaceAll("\\s+", " ").trim();
        if (plain.length() > 200) plain = plain.substring(0, 200) + "…";
        return "[" + type + "] " + plain;
    }

    /** 分类：1 文字 / 2 图片 / 3 语音 / 4 视频 / 5 文件链接 / 6 其他 */
    private static int catOf(long type) {
        if (type == 1) return 1;
        if (type == 3) return 2;
        if (type == 34 || type == 64 || type == 419430449) return 3;
        if (type == 43) return 4;
        if (type == 49) return 5;
        return 6;
    }

    private static volatile boolean autoPlay = false;

    /** 长按历史里的一条 → 直达聊天中的那一条 */
    private static void jumpToMessage(final String wxid, final long tsMs, final long msgId) {
        jumpToMessage(wxid, tsMs, msgId, null);
    }

    private static void jumpToMessage(final String wxid, final long tsMs, final long msgId, final String text) {
        jumpToMessage(wxid, tsMs, msgId, text, 0);
    }

    private static void jumpToMessage(final String wxid, final long tsMs, final long msgId,
                                      final String text, final long svrId) {
        try {
            android.app.Activity a = chatAct;
            if (a == null) { toast("不在聊天页"); return; }
            final boolean sameChat = wxid != null && wxid.equals(chatTalker);
            if (!sameChat) {
                android.content.Intent it = new android.content.Intent();
                it.setClassName(a.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
                it.putExtra("Chat_User", resolveTalker(wxid));
                if (svrId > 0) it.putExtra("Chat_Msg_Id", svrId);
                else if (msgId > 0) it.putExtra("Chat_Msg_Id", msgId);
                it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
                android.content.Intent _csw = prepareChatSwitch(a, it);
                if (_csw != null) a.startActivity(_csw);
                toast("正在定位那条消息…");
                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                    @Override public void run() { locateByTime(wxid, tsMs, text); }
                }, 1400L);
            } else {
                // 先试微信自己的跳转（重新进入会话带 msg id），再退回按时间翻页
                try {
                    android.content.Intent it = new android.content.Intent();
                    it.setClassName(a.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
                    it.putExtra("Chat_User", resolveTalker(wxid));
                    if (svrId > 0) it.putExtra("Chat_Msg_Id", svrId);
                    it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
                    android.content.Intent _csw = prepareChatSwitch(a, it);
                    if (_csw != null) a.startActivity(_csw);
                    new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                        @Override public void run() { locateByTime(wxid, tsMs, text); }
                    }, 1500L);
                } catch (Throwable t) { locateByTime(wxid, tsMs, text); }
            }
            log("JUMP|to " + wxid + " ts=" + tsMs + " id=" + msgId + " same=" + sameChat);
        } catch (Throwable t) { log("JUMP|err " + t); }
    }

    /** 在当前聊天列表里找时间戳匹配的行并高亮，找不到就向上翻页 */
    private static void findAndFlashTs(final long tsMs, final String text) {
        new Thread(new Runnable() {
            @Override public void run() {
                for (int round = 0; round < 25; round++) {
                    final int rnd = round;
                    final boolean[] hit = new boolean[]{false};
                    final java.util.concurrent.CountDownLatch latch =
                            new java.util.concurrent.CountDownLatch(1);
                    new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                        @Override public void run() {
                            try {
                                if (chatAct == null || chatAct.getWindow() == null) return;
                                android.view.ViewGroup list =
                                        findMsgList(chatAct.getWindow().getDecorView());
                                if (list == null) return;
                                StringBuilder dbg = new StringBuilder();
                                for (int i = 0; i < list.getChildCount(); i++) {
                                    android.view.View row = list.getChildAt(i);
                                    if (row == null) continue;
                                    long t = tsOfAnchor(row);
                                    if (rnd == 0 && i < 4) dbg.append(t).append(',');
                                    if (rnd == 0 && i == Math.min(3, list.getChildCount() - 1)) {
                                        log("JUMP|tags " + dbg + " target=" + tsMs);
                                    }
                                    boolean match = t > 0 && Math.abs(t - tsMs) <= 1500;
                                    if (!match && text != null && text.length() > 0) {
                                        android.widget.TextView mtv = mainTextOf(row);
                                        if (mtv != null && mtv.getText() != null) {
                                            String rt = mtv.getText().toString().trim();
                                            String tt = text.trim();
                                            if (tt.length() > 12) tt = tt.substring(0, 12);
                                            match = rt.length() > 0 && (rt.contains(tt) || tt.contains(rt));
                                        }
                                    }
                                    if (match) {
                                        final android.view.View frow = row;
                                        frow.setBackgroundColor(0x55E23636);
                                        list.requestChildFocus(frow, frow);
                                        new android.os.Handler(android.os.Looper.getMainLooper())
                                                .postDelayed(new Runnable() {
                                                    @Override public void run() {
                                                        frow.setBackgroundColor(0x00000000);
                                                    }
                                                }, 3000);
                                        hit[0] = true;
                                        log("JUMP|found round=" + rnd + " ts=" + tsOfAnchor(row));
                                        if (autoPlay) {
                                            autoPlay = false;
                                            android.view.View target = clickableInside(frow);
                                            if (target != null) {
                                                tapAtScreen(list.getRootView(), target);
                                                log("JUMP|autoplay " + target.getClass().getSimpleName());
                                            }
                                        }
                                        return;
                                    }
                                }
                            } finally { latch.countDown(); }
                        }
                    });
                    try { latch.await(2, java.util.concurrent.TimeUnit.SECONDS); } catch (Throwable ignore) { }
                    if (hit[0]) return;
                    final java.util.concurrent.CountDownLatch l2 =
                            new java.util.concurrent.CountDownLatch(1);
                    new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                        @Override public void run() {
                            try {
                                if (chatAct == null || chatAct.getWindow() == null) return;
                                android.view.ViewGroup list =
                                        findMsgList(chatAct.getWindow().getDecorView());
                                if (list != null) {
                                    int step = Math.max(dp(chatAct, 400), list.getHeight());
                                    scrollListBy(list, -step);
                                }
                            } catch (Throwable ignore) { } finally { l2.countDown(); }
                        }
                    });
                    try { l2.await(2, java.util.concurrent.TimeUnit.SECONDS); } catch (Throwable ignore) { }
                    try { Thread.sleep(450); } catch (Throwable ignore) { }
                }
                log("JUMP|giveup ts=" + tsMs);
            }
        }).start();
    }
    /** 从 ImgInfo2 找图片路径并按微信的 AES/XOR 规则解密成缩略图 */
    private static final java.util.HashMap<Long, android.graphics.Bitmap> thumbCache =
            new java.util.HashMap<Long, android.graphics.Bitmap>();

    private static boolean imgDbDiag = false;
    private static int imgMiss = 0;

    private static void diagImgDb(Object h) {
        if (imgDbDiag || h == null) return;
        imgDbDiag = true;
        try {
            for (String sql : new String[]{
                    "select count(*) from ImgInfo2",
                    "pragma table_info(ImgInfo2)",
                    "select count(*) from message where imgPath is not null and imgPath<>''"}) {
                try {
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, sql, new String[0]);
                    StringBuilder sb = new StringBuilder();
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gc = cur.getClass().getMethod("getColumnCount");
                        java.lang.reflect.Method gn = cur.getClass().getMethod("getColumnName", int.class);
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        int cols = (Integer) gc.invoke(cur);
                        while ((Boolean) mv.invoke(cur)) {
                            for (int i = 0; i < cols && i < 6; i++) {
                                String nm = (String) gn.invoke(cur, i);
                                String v = null;
                                try { v = (String) gs.invoke(cur, i); } catch (Throwable ignore) { }
                                sb.append(nm).append('=').append(v).append(' ');
                            }
                            sb.append(" | ");
                            if (sb.length() > 600) break;
                        }
                        try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                    }
                    log("IMGDB|" + sql + " => " + sb);
                } catch (Throwable t) { log("IMGDB|" + sql + " err " + t); }
            }
        } catch (Throwable t) { log("IMGDB|err " + t); }
    }

    private static android.graphics.Bitmap loadImageThumb(Object h, long msgSvrId, String aeskey, String imgPath) {
        return loadImageThumb2(h, msgSvrId, aeskey, imgPath, null);
    }

    private static volatile boolean preferBigImg = false;

    private static android.graphics.Bitmap loadImageThumb2(Object h, long msgSvrId, String aeskey,
                                                           String imgPath, String altKey) {
        try {
            diagImgDb(h);
            if (thumbCache.containsKey(Long.valueOf(msgSvrId)) && h == null) return thumbCache.get(Long.valueOf(msgSvrId));
            String path = null;
            if (h == null) return null;
            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, "select bigImgPath, thumbImgPath from ImgInfo2 where msgSvrId=" + msgSvrId + " limit 1",
                            new String[0]);
            if (cur != null) {
                java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                if ((Boolean) mv.invoke(cur)) {
                    String big = (String) gs.invoke(cur, 0);
                    String th = (String) gs.invoke(cur, 1);
                    boolean thOk = th != null && new java.io.File(th).isFile();
                    boolean bigOk = big != null && new java.io.File(big).isFile();
                    path = (preferBigImg && bigOk) ? big : (thOk ? th : (bigOk ? big : null));
                }
                try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
            }
            if ((path == null || !new java.io.File(path).isFile())
                    && imgPath != null && imgPath.length() > 0) {
                java.io.File p2 = new java.io.File(imgPath);
                if (p2.isFile()) path = imgPath;
                else if (imgPath.contains("th_")) {
                    String md5 = imgPath.substring(imgPath.indexOf("th_") + 3);
                    int cut = md5.indexOf('/');
                    if (cut > 0) md5 = md5.substring(0, cut);
                    path = resolveThumbPath(md5);
                }
            }
            log("AVHIST|img svr=" + msgSvrId + " path=" + path + " key=" + (aeskey == null ? 0 : aeskey.length())
                    + " imgPath=" + imgPath);
            if (path == null && imgMiss < 3) {
                imgMiss++;
                try {
                    Object c1 = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select count(*) from ImgInfo2 where msgSvrId=" + msgSvrId, new String[0]);
                    java.lang.reflect.Method mv1 = c1.getClass().getMethod("moveToNext");
                    java.lang.reflect.Method gl1 = c1.getClass().getMethod("getLong", int.class);
                    long hitN = 0;
                    if ((Boolean) mv1.invoke(c1)) hitN = (Long) gl1.invoke(c1, 0);
                    try { c1.getClass().getMethod("close").invoke(c1); } catch (Throwable ignore) { }
                    StringBuilder sb = new StringBuilder();
                    Object c2 = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select msgSvrId, bigImgPath, thumbImgPath from ImgInfo2 order by id desc limit 2",
                                    new String[0]);
                    java.lang.reflect.Method mv2 = c2.getClass().getMethod("moveToNext");
                    java.lang.reflect.Method gl2 = c2.getClass().getMethod("getLong", int.class);
                    java.lang.reflect.Method gs2 = c2.getClass().getMethod("getString", int.class);
                    while ((Boolean) mv2.invoke(c2)) {
                        sb.append(gl2.invoke(c2, 0)).append(" -> ").append(gs2.invoke(c2, 1))
                                .append(" / ").append(gs2.invoke(c2, 2)).append(" ;; ");
                    }
                    try { c2.getClass().getMethod("close").invoke(c2); } catch (Throwable ignore) { }
                    log("IMGDB|match=" + hitN + " sample=" + sb);
                } catch (Throwable t) { log("IMGDB|probe err " + t); }
            }
            if (path == null) return null;
            java.io.File f = new java.io.File(path);
            if (!f.isFile()) { log("AVHIST|img nofile " + path); return null; }
            byte[] raw = readAll(f);
            if (raw == null || raw.length < 32) return null;
            byte[] body = raw;
            if ((raw[0] & 0xFF) == 0x07 && (raw[1] & 0xFF) == 0x08) {
                body = java.util.Arrays.copyOfRange(raw, 15, raw.length);
            }
            android.graphics.BitmapFactory.Options o = new android.graphics.BitmapFactory.Options();
            o.inSampleSize = cfg().optInt("pageBgSample", 1);
            android.graphics.Bitmap bm = decodeWithKey(body, aeskey, o);
            if (bm == null) bm = decodeWithKey(body, altKey, o);
            if (bm == null) {
                // 也许根本没加密
                bm = android.graphics.BitmapFactory.decodeByteArray(body, 0, body.length, o);
            }
            if (bm == null) {
                java.util.Arrays.fill(body, (byte) 0);
            }
            log("AVHIST|img " + (bm == null ? "FAIL" : ("ok " + bm.getWidth() + "x" + bm.getHeight()))
                    + " raw=" + (body == null ? 0 : body.length));
            return bm;
        } catch (Throwable t) {
            log("AVHIST|img err " + t);
            return null;
        }
    }

    /** 在消息行里找可点的气泡控件（语音/视频） */
    private static android.view.View clickableInside(android.view.View row) {
        try {
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            q.add(row);
            android.view.View best = null;
            int scanned = 0;
            while (!q.isEmpty() && scanned < 200) {
                android.view.View v = q.poll(); scanned++;
                if (v != row && v.isClickable() && v.getWidth() > 40 && v.getHeight() > 20) {
                    String cn = v.getClass().getName();
                    if (cn.contains("Voice") || cn.contains("Video") || cn.contains("Play")) return v;
                    if (best == null) best = v;
                }
                if (v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) q.add(g.getChildAt(i));
                }
            }
            return best;
        } catch (Throwable t) { return null; }
    }

    private static String mmImageBase = null;

    private static String resolveThumbPath(String md5) {
        try {
            if (mmImageBase == null) {
                java.io.File mm = new java.io.File("/data/user/0/com.tencent.mm/MicroMsg");
                java.io.File[] ds = mm.listFiles();
                if (ds != null) {
                    for (java.io.File d : ds) {
                        if (new java.io.File(d, "image2").isDirectory()) {
                            mmImageBase = new java.io.File(d, "image2").getAbsolutePath();
                            break;
                        }
                    }
                }
            }
            if (mmImageBase == null || md5 == null || md5.length() < 5) return null;
            String p = mmImageBase + "/" + md5.substring(0, 2) + "/" + md5.substring(2, 4) + "/th_" + md5;
            java.io.File fhd = new java.io.File(p + "hd");
            if (fhd.isFile() && fhd.length() > 4096) return p + "hd";   // 优先高清版
            java.io.File f = new java.io.File(p);
            if (f.isFile()) return p;
            // 有些版本主图不带 th_
            java.io.File f3 = new java.io.File(mmImageBase + "/" + md5.substring(0, 2) + "/"
                    + md5.substring(2, 4) + "/" + md5);
            if (f3.isFile()) return f3.getAbsolutePath();
            return null;
        } catch (Throwable t) { return null; }
    }

    private static final boolean[] historySelecting = {false};
    private static final java.util.LinkedHashSet<Long> historySel = new java.util.LinkedHashSet<Long>();
    private static Runnable historySelRefresh = null;
    private static Runnable historyRebuild = null;
    private static java.lang.ref.WeakReference<android.app.Dialog> historyDialog = null;
    private static Runnable historyCalendarRepaint = null;

    /** 历史记录：单击直达、长按出菜单 */
    private static void attachHistoryActions(final android.app.Activity a, final android.view.View row,
                                             final android.view.View imageView, final String wxid,
                                             final long ts, final long mid, final String text,
                                             final long type, final long svrId) {
        android.view.View.OnClickListener cl = new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                if (historySelecting[0]) {
                    if (!historySel.remove(Long.valueOf(mid))) historySel.add(Long.valueOf(mid));
                    v.setAlpha(historySel.contains(Long.valueOf(mid)) ? 0.55f : 1f);
                    if (historySelRefresh != null) historySelRefresh.run();
                    return;
                }
                // 单击：语音/视频 → 跳到聊天并自动播放；文字/其他不动作
                if (type == 34 || type == 43) {
                    autoPlay = true;
                    jumpToMessage(wxid, ts, mid, text, svrId);
                }
            }
        };
        android.view.View.OnLongClickListener lc = new android.view.View.OnLongClickListener() {
            @Override public boolean onLongClick(android.view.View v) {
                jumpToMessage(wxid, ts, mid, text, svrId);   // 长按 = 定位
                return true;
            }
        };
        row.setOnClickListener(cl);
        row.setOnLongClickListener(lc);
        row.setLongClickable(true);
        if (imageView != null) {
            imageView.setOnClickListener(cl);
            imageView.setOnLongClickListener(lc);
            imageView.setLongClickable(true);
        }
    }

    private static void showHistoryMenu(final android.app.Activity a, final String wxid, final long ts,
                                        final long mid, final String text, long type, final long svrId) {
        final java.util.List<String> items = new java.util.ArrayList<String>();
        items.add("定位到聊天");
        if (text != null && text.trim().length() > 0 && type == 1) items.add("复制文字");
        if (type == 3) items.add("存到我的图库");
        final String[] arr = items.toArray(new String[0]);
        new android.app.AlertDialog.Builder(a).setTitle("这一条")
                .setItems(arr, new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) {
                        String pick = arr[which];
                        if ("定位到聊天".equals(pick)) { jumpToMessage(wxid, ts, mid, text, svrId); }
                        else if ("复制文字".equals(pick)) {
                            try {
                                android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                        a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", text));
                                toast("已复制");
                            } catch (Throwable t) { toast("复制失败"); }
                        } else if ("存到我的图库".equals(pick)) {
                            jumpToMessage(wxid, ts, mid);
                            toast("已跳到聊天，可长按图片存图");
                        }
                    }
                }).show();
    }

    private static android.graphics.Bitmap decodeWithKey(byte[] body, String keyHex,
                                                         android.graphics.BitmapFactory.Options o) {
        if (keyHex == null || keyHex.length() != 32) return null;
        try {
            byte[] key = new byte[16];
            for (int i = 0; i < 16; i++) key[i] = (byte) Integer.parseInt(keyHex.substring(i * 2, i * 2 + 2), 16);
            javax.crypto.Cipher c = javax.crypto.Cipher.getInstance("AES/ECB/NoPadding");
            c.init(javax.crypto.Cipher.DECRYPT_MODE, new javax.crypto.spec.SecretKeySpec(key, "AES"));
            int len = body.length - (body.length % 16);
            if (len <= 0) return null;
            byte[] plain = c.doFinal(body, 0, len);
            android.graphics.Bitmap bm = android.graphics.BitmapFactory.decodeByteArray(plain, 0, plain.length, o);
            if (bm != null) return bm;
            // 去掉尾部 0 再试
            int end = plain.length;
            while (end > 8 && plain[end - 1] == 0) end--;
            return android.graphics.BitmapFactory.decodeByteArray(plain, 0, end, o);
        } catch (Throwable t) { return null; }
    }
    /** 功能自检：把能自动验的项跑一遍，结果写日志并弹窗 */
    private static void runSelfCheck(final android.app.Activity a) {
        final StringBuilder sb = new StringBuilder();
        final StringBuilder logLines = new StringBuilder();

        // 1 配置读写
        try {
            org.json.JSONObject o = readCfg();
            o.put("_selftest", System.currentTimeMillis());
            writeCfg(o);
            cfg = null;
            cfgAt = 0;
            org.json.JSONObject o2 = readCfg();
            boolean ok = o2.optLong("_selftest", 0) > 0;
            line(sb, ok, "配置读写", ok ? "正常" : "写不进去（检查 wxh_config.json 权限 666）");
        } catch (Throwable t) {
            line(sb, false, "配置读写", String.valueOf(t));
        }

        // 2 数据库
        try {
            Object h = msgDbHandle();
            if (h == null) {
                line(sb, false, "数据库", "未拿到句柄（重启微信后再试）");
            } else {
                long msgs = scCount(h, "select count(*) from message");
                long imgs = scCount(h, "select count(*) from ImgInfo2");
                line(sb, true, "数据库", "消息 " + msgs + " 条 / 图片索引 " + imgs + " 条");
            }
        } catch (Throwable t) {
            line(sb, false, "数据库", String.valueOf(t));
        }

        // 3 图库目录
        try {
            java.io.File dir = new java.io.File("/sdcard/Pictures/wxh");
            java.io.File[] fs = dir.listFiles();
            int n = fs == null ? 0 : fs.length;
            boolean w = dir.exists() ? dir.canWrite() : dir.mkdirs();
            line(sb, true, "我的图库", n + " 个文件" + (w ? "" : "（目录不可写）"));
        } catch (Throwable t) {
            line(sb, false, "我的图库", String.valueOf(t));
        }

        // 4 悬浮窗权限
        try {
            boolean can = android.provider.Settings.canDrawOverlays(a);
            line(sb, can, "悬浮窗权限", can ? "已授权" : "未授权（主题悬浮球不可用）");
        } catch (Throwable t) {
            line(sb, false, "悬浮窗权限", String.valueOf(t));
        }

        // 5 主题包
        try {
            JSONObject pack = themePack();
            line(sb, pack != null, "主题包", pack == null ? "未导入" : "已加载 " + pack.length() + " 项配置");
        } catch (Throwable t) {
            line(sb, false, "主题包", String.valueOf(t));
        }

        // 6 日志里的报错统计（最能说明哪些功能在出错）
        try {
            java.io.File lf = new java.io.File(DIR, "wxh_plugin.log");
            java.util.HashMap<String, Integer> errs = new java.util.HashMap<String, Integer>();
            if (lf.isFile()) {
                java.io.BufferedReader br = new java.io.BufferedReader(
                        new java.io.InputStreamReader(new java.io.FileInputStream(lf), "UTF-8"));
                String l;
                int total = 0;
                while ((l = br.readLine()) != null) {
                    total++;
                    String low = l.toLowerCase();
                    if (low.contains("err") || low.contains("exception") || low.contains("giveup")
                            || low.contains("fail") || low.contains("失败")) {
                        int idx = l.indexOf('|');
                        String key = idx > 0 ? l.substring(0, idx) : l.substring(0, Math.min(18, l.length()));
                        Integer v = errs.get(key);
                        errs.put(key, Integer.valueOf(v == null ? 1 : v.intValue() + 1));
                    }
                }
                br.close();
                java.util.List<java.util.Map.Entry<String, Integer>> list =
                        new java.util.ArrayList<java.util.Map.Entry<String, Integer>>(errs.entrySet());
                java.util.Collections.sort(list, new java.util.Comparator<java.util.Map.Entry<String, Integer>>() {
                    @Override public int compare(java.util.Map.Entry<String, Integer> x,
                                                 java.util.Map.Entry<String, Integer> y) {
                        return y.getValue().intValue() - x.getValue().intValue();
                    }
                });
                StringBuilder eb = new StringBuilder("日志 " + total + " 行，异常项：");
                int shown = 0;
                for (java.util.Map.Entry<String, Integer> e : list) {
                    if (shown++ >= 6) break;
                    eb.append("\n   ").append(e.getKey()).append(" × ").append(e.getValue());
                }
                if (list.isEmpty()) eb.append(" 无");
                line(sb, list.isEmpty(), "运行日志", eb.toString());
                logLines.append(eb);
            } else {
                line(sb, false, "运行日志", "没有日志文件");
            }
        } catch (Throwable t) {
            line(sb, false, "运行日志", String.valueOf(t));
        }

        // 7 已加载的关键钩子
        try {
            StringBuilder hb = new StringBuilder();
            hb.append("菜单注入 ").append(menuInjectCount.get())
                    .append(" / 长按锚点 ").append(longPressCount.get())
                    .append(" / 转发定位 ").append(fwdCount.get());
            line(sb, true, "钩子计数", hb.toString());
        } catch (Throwable t) {
            line(sb, false, "钩子计数", String.valueOf(t));
        }

        log("SELFCHECK|\n" + sb.toString());
        final String txt = sb.toString();
        a.runOnUiThread(new Runnable() {
            @Override public void run() {
                android.widget.ScrollView sv = new android.widget.ScrollView(a);
                android.widget.TextView tv = new android.widget.TextView(a);
                tv.setText(txt);
                tv.setTextSize(13);
                tv.setTextIsSelectable(true);
                tv.setPadding(dp(a, 16), dp(a, 12), dp(a, 16), dp(a, 12));
                sv.addView(tv);
                new android.app.AlertDialog.Builder(a).setTitle("功能自检")
                        .setView(sv).setPositiveButton("关闭", null).show();
            }
        });
    }

    private static void line(StringBuilder sb, boolean ok, String name, String detail) {
        sb.append(ok ? "✅ " : "❌ ").append(name).append("：").append(detail).append('\n');
    }

    private static long scCount(Object h, String sql) {
        try {
            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, sql, new String[0]);
            if (cur == null) return 0;
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
            long v = 0;
            if ((Boolean) mv.invoke(cur)) v = (Long) gl.invoke(cur, 0);
            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
            return v;
        } catch (Throwable t) { return -1; }
    }

    /** 把选中的图片保存到相册 Pictures/wxh */
    private static void saveSelectedToGallery(final android.app.Activity a,
                                              final java.util.List<long[]> meta,
                                              final java.util.List<String> raw,
                                              final java.util.List<String> paths,
                                              final java.util.Set<Long> sel,
                                              final Runnable refresh) {
        if (sel.isEmpty()) { toast("还没选"); return; }
        final java.util.List<Integer> idxs = new java.util.ArrayList<Integer>();
        for (int i = 0; i < meta.size(); i++) {
            if (sel.contains(Long.valueOf(meta.get(i)[3]))) idxs.add(Integer.valueOf(i));
        }
        toast("正在保存 " + idxs.size() + " 张…");
        new Thread(new Runnable() {
            @Override public void run() {
                int ok = 0;
                Object h = msgDbHandle();
                for (Integer ii : idxs) {
                    int i = ii.intValue();
                    if (meta.get(i)[2] != 3) continue;
                    try {
                        android.graphics.Bitmap bm = loadImageThumb2(h, meta.get(i)[4],
                                attrOf(raw.get(i), "aeskey"), paths.size() > i ? paths.get(i) : null,
                                attrOf(raw.get(i), "cdnthumbaeskey"));
                        if (bm == null) continue;
                        String name = "wxh_" + System.currentTimeMillis() + ".png";
                        android.content.ContentValues cv = new android.content.ContentValues();
                        cv.put(android.provider.MediaStore.Images.Media.DISPLAY_NAME, name);
                        cv.put(android.provider.MediaStore.Images.Media.MIME_TYPE, "image/png");
                        if (android.os.Build.VERSION.SDK_INT >= 29) {
                            cv.put(android.provider.MediaStore.Images.Media.RELATIVE_PATH, "Pictures/wxh");
                        }
                        android.net.Uri uri = a.getContentResolver().insert(
                                android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI, cv);
                        if (uri == null) continue;
                        java.io.OutputStream os = a.getContentResolver().openOutputStream(uri);
                        bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, os);
                        os.flush(); os.close();
                        ok++;
                    } catch (Throwable t) { log("SAVESEL|err " + t); }
                }
                final int n = ok;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        toast("已保存 " + n + " 张到图库");
                        sel.clear();
                        if (refresh != null) refresh.run();
                    }
                });
                log("SAVESEL|saved " + ok);
            }
        }).start();
    }

    /** 大图查看：可保存到相册 / 定位到聊天 */
    private static void showImageDialog(final android.app.Activity a, final android.graphics.Bitmap bm,
                                        final String wxid, final long ts, final long mid) {
        try {
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setBackgroundColor(0xFF000000);
            android.widget.ImageView iv = new android.widget.ImageView(a);
            iv.setImageBitmap(bm);
            iv.setScaleType(android.widget.ImageView.ScaleType.FIT_CENTER);
            box.addView(iv, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
            android.widget.LinearLayout ops = new android.widget.LinearLayout(a);
            ops.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            ops.setGravity(android.view.Gravity.CENTER);
            ops.setPadding(0, dp(a, 10), 0, dp(a, 18));
            android.widget.TextView save = new android.widget.TextView(a);
            save.setText("保存到相册");
            save.setTextSize(15);
            save.setTextColor(0xFFFFFFFF);
            save.setPadding(dp(a, 18), dp(a, 10), dp(a, 18), dp(a, 10));
            android.widget.TextView locate = new android.widget.TextView(a);
            locate.setText("定位到聊天");
            locate.setTextSize(15);
            locate.setTextColor(0xFFFFFFFF);
            locate.setPadding(dp(a, 18), dp(a, 10), dp(a, 18), dp(a, 10));
            ops.addView(save);
            ops.addView(locate);
            box.addView(ops);

            final android.app.Dialog d = new android.app.Dialog(a, android.R.style.Theme_Translucent_NoTitleBar);
            d.setContentView(box);
            android.view.Window w = d.getWindow();
            if (w != null) {
                w.setLayout((int) (a.getResources().getDisplayMetrics().widthPixels * 0.96f),
                        (int) (a.getResources().getDisplayMetrics().heightPixels * 0.86f));
            }
            save.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    try {
                        String name = "wxh_" + System.currentTimeMillis() + ".png";
                        android.content.ContentValues cv = new android.content.ContentValues();
                        cv.put(android.provider.MediaStore.Images.Media.DISPLAY_NAME, name);
                        cv.put(android.provider.MediaStore.Images.Media.MIME_TYPE, "image/png");
                        if (android.os.Build.VERSION.SDK_INT >= 29) {
                            cv.put(android.provider.MediaStore.Images.Media.RELATIVE_PATH, "Pictures/wxh");
                        }
                        android.net.Uri uri = a.getContentResolver().insert(
                                android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI, cv);
                        java.io.OutputStream os = a.getContentResolver().openOutputStream(uri);
                        bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, os);
                        os.flush(); os.close();
                        toast("已保存到相册");
                        log("IMGDL|saved " + name);
                    } catch (Throwable t) { toast("保存失败：" + t); }
                }
            });
            locate.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    d.dismiss();
                    jumpToMessage(wxid, ts, mid);
                }
            });
            iv.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) { d.dismiss(); }
            });
            d.show();
        } catch (Throwable t) { log("IMGDL|err " + t); }
    }
    /** 抓取聊天里渲染出来的表情，按 md5 缓存成 PNG */
    private static void installEmojiCapture(final ClassLoader app) {
        try {
            String[] classes = {
                    "com.tencent.mm.pluginsdk.ui.emoji.RTChattingEmojiView",
                    "com.tencent.mm.pluginsdk.ui.emoji.ChattingEmojiView",
                    "com.tencent.mm.pluginsdk.ui.emoji.EmojiView",
                    "com.tencent.mm.emoji.emoji.EmojiView",
                    "com.tencent.mm.pluginsdk.ui.emoji.MMEmojiView",
                    "com.tencent.mm.emoji.view.AbsEmojiView",
                    "com.tencent.mm.emoji.view.BaseEmojiView",
                    "com.tencent.mm.emoji.view.RoundEmojiView"};
            int hooked = 0;
            for (String cn : classes) {
                try {
                    Class<?> c = Class.forName(cn, false, app);
                    XC_MethodHook emHook = new XC_MethodHook() {
                        @Override protected void afterHookedMethod(MethodHookParam p) {
                            try {
                                Object o = p.thisObject;
                                if (!(o instanceof android.view.View)) return;
                                final android.view.View v = (android.view.View) o;
                                if (!v.getClass().getName().contains("Emoji")) return;
                                android.os.Handler hh = new android.os.Handler(android.os.Looper.getMainLooper());
                                for (long delay : new long[]{300L, 900L, 2000L}) {
                                    hh.postDelayed(new Runnable() {
                                        @Override public void run() { captureEmojiView(v); }
                                    }, delay);
                                }
                            } catch (Throwable ignore) { }
                        }
                    };
                    // 只钩本类自己声明的方法，避免落到 View 上变成全局钩子
                    for (java.lang.reflect.Method mm : c.getDeclaredMethods()) {
                        String mn = mm.getName();
                        if (mn.equals("onAttachedToWindow") || mn.equals("onDraw")
                                || mn.equals("setImageDrawable") || mn.equals("setImageBitmap")) {
                            try { XposedBridge.hookMethod(mm, emHook); hooked++; } catch (Throwable ignore) { }
                        }
                    }
                } catch (Throwable ignore) { }
            }
            log("EMOJI|hook installed " + hooked);
        } catch (Throwable t) { log("EMOJI|hook err " + t); }
    }

    private static int emojiNoMd5 = 0;

    private static java.io.File emojiCacheDir() {
        java.io.File d = new java.io.File(new java.io.File(DIR, "emoji_cache"), "");
        if (!d.isDirectory()) d.mkdirs();
        return d;
    }

    /** 尝试把表情控件画出来，并用控件里的 md5 命名存盘 */
    private static void captureEmojiView(android.view.View v) {
        try {
            if (v == null || v.getWidth() <= 0 || v.getHeight() <= 0) return;
            String md5 = findMd5In(v);
            if (md5 == null) {
                if (emojiNoMd5++ < 3) {
                    StringBuilder fb = new StringBuilder();
                    try {
                        java.lang.reflect.Field[] fs = v.getClass().getDeclaredFields();
                        for (int i = 0; i < fs.length && i < 12; i++) {
                            fb.append(fs[i].getName()).append(':' + "" + fs[i].getType().getSimpleName()).append(' ');
                        }
                    } catch (Throwable ignore) { }
                    log("EMOJI|nomd5 " + v.getClass().getSimpleName() + " " + v.getWidth() + "x" + v.getHeight()
                            + " fields=" + fb);
                }
                return;
            }
            java.io.File out = new java.io.File(emojiCacheDir(), "emoji_" + md5 + ".png");
            if (out.isFile() && out.length() > 100) return;
            android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(
                    v.getWidth(), v.getHeight(), android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas c = new android.graphics.Canvas(bm);
            v.draw(c);
            if (isBlank(bm)) return;
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, fo);
            fo.flush();
            fo.close();
            log("EMOJI|saved " + md5 + " " + bm.getWidth() + "x" + bm.getHeight());
        } catch (Throwable t) { log("EMOJI|capture err " + t); }
    }

    private static boolean isBlank(android.graphics.Bitmap bm) {
        try {
            int w = bm.getWidth(), h = bm.getHeight();
            for (int y = 0; y < h; y += Math.max(1, h / 8)) {
                for (int x = 0; x < w; x += Math.max(1, w / 8)) {
                    if (android.graphics.Color.alpha(bm.getPixel(x, y)) > 20) return false;
                }
            }
        } catch (Throwable ignore) { }
        return true;
    }

    /** 从控件的字段里找 32 位十六进制 md5 */
    private static String findMd5In(Object o) {
        try {
            Class<?> c = o.getClass();
            for (int lv = 0; lv < 6 && c != null; lv++, c = c.getSuperclass()) {
                java.lang.reflect.Field[] fs = c.getDeclaredFields();
                for (java.lang.reflect.Field f : fs) {
                    try {
                        f.setAccessible(true);
                        Object val = f.get(o);
                        if (val != null && val.getClass().getName().contains("EmojiInfo")) {
                            try {
                                java.lang.reflect.Method gm = val.getClass().getMethod("getMd5");
                                gm.setAccessible(true);
                                Object r = gm.invoke(val);
                                if (r instanceof String && ((String) r).matches("[0-9a-f]{32}")) {
                                    return (String) r;
                                }
                            } catch (Throwable ignore) { }
                            try {
                                java.lang.reflect.Field mf = val.getClass().getField("md5");
                                mf.setAccessible(true);
                                Object r2 = mf.get(val);
                                if (r2 instanceof String && ((String) r2).matches("[0-9a-f]{32}")) return (String) r2;
                            } catch (Throwable ignore) { }
                        }
                        if (val instanceof String) {
                            String s2 = ((String) val).trim();
                            if (s2.matches("[0-9a-f]{32}")) return s2;
                            int i = s2.indexOf("emoji/");
                            if (i >= 0) {
                                String tail = s2.substring(i + 6);
                                if (tail.matches("[0-9a-f]{32}.*")) return tail.substring(0, 32);
                            }
                        }
                    } catch (Throwable ignore) { }
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 表情 tab 用：找已缓存的表情图 */
    private static android.graphics.Bitmap loadCachedEmoji(String md5) {
        try {
            if (md5 == null || md5.length() < 32) return null;
            java.io.File f = new java.io.File(emojiCacheDir(), "emoji_" + md5 + ".png");
            if (!f.isFile()) return null;
            android.graphics.BitmapFactory.Options o = new android.graphics.BitmapFactory.Options();
            o.inSampleSize = 2;
            return android.graphics.BitmapFactory.decodeFile(f.getAbsolutePath(), o);
        } catch (Throwable t) { return null; }
    }

    /** 表情消息内容格式：发送人:时间:1:md5::0 —— 抠出 md5 */
    private static String emojiMd5(String raw) {
        try {
            if (raw == null) return null;
            String[] parts = raw.split(":");
            for (int i = parts.length - 1; i >= 0; i--) {
                String p = parts[i].trim();
                if (p.matches("[0-9a-f]{32}")) return p;
                if (p.matches("[0-9a-f]{32}.*")) return p.substring(0, 32);
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 按数据库序号直接滚到那条消息（不依赖 tag） */
    private static boolean scrollToByTs(final String wxid, final long tsMs) {
        try {
            Object h = msgDbHandle();
            if (h == null) { log("JUMP|index no db"); return false; }
            long sec = tsMs > 100000000000L ? tsMs / 1000L : tsMs;
            long newer = scCount(h, "select count(*) from message where talker='" + wxid.replace("'", "''")
                    + "' and createTime > " + sec);
            if (newer < 0) { log("JUMP|index count fail"); return false; }
            android.view.ViewGroup list = findMsgList(chatAct == null ? null : chatAct.getWindow().getDecorView());
            log("JUMP|index list=" + (list == null ? "null" : list.getClass().getSimpleName()) + " newer=" + newer);
            if (list == null) return false;
            int total = 0;
            if (list instanceof android.widget.AbsListView) {
                android.widget.ListAdapter ad = ((android.widget.AbsListView) list).getAdapter();
                if (ad != null) total = ad.getCount();
            } else {
                Object lm0 = callAny(list, "getLayoutManager", new Class<?>[]{}, new Object[]{});
                if (lm0 != null) {
                    Object n = callAny(lm0, "getItemCount", new Class<?>[]{}, new Object[]{});
                    if (n instanceof Integer) total = (Integer) n;
                }
                if (total == 0) {
                    Object adapt = callAny(list, "getAdapter", new Class<?>[]{}, new Object[]{});
                    Object n2 = callAny(adapt, "getItemCount", new Class<?>[]{}, new Object[]{});
                    if (n2 instanceof Integer) total = (Integer) n2;
                }
            }
            log("JUMP|index total=" + total + " newer=" + newer + " list=" + list.getClass().getSimpleName());
            if (total <= 0) return false;
            int pos = total - 1 - (int) newer;
            log("JUMP|index total=" + total + " newer=" + newer + " pos=" + pos);
            if (pos < 0) pos = 0;
            if (pos >= total) pos = total - 1;
            final int fpos = pos;
            if (list instanceof android.widget.AbsListView) {
                ((android.widget.AbsListView) list).setSelectionFromTop(fpos, dp(chatAct, 80));
            } else {
                try {
                    Object lm = list.getClass().getMethod("getLayoutManager").invoke(list);
                    java.lang.reflect.Method m2 = lm.getClass().getMethod("scrollToPositionWithOffset",
                            int.class, int.class);
                    m2.invoke(lm, fpos, dp(chatAct, 80));
                } catch (Throwable t) {
                    list.getClass().getMethod("scrollToPosition", int.class).invoke(list, fpos);
                }
            }
            return true;
        } catch (Throwable t) { log("JUMP|index err " + t); return false; }
    }

    /** 沿父类找方法（ScrollControlRecyclerView 之类包装类很多方法在父类上） */
    private static Object callAny(Object obj, String name, Class<?>[] sig, Object[] args) {
        if (obj == null) return null;
        Class<?> c = obj.getClass();
        for (int i = 0; i < 8 && c != null; i++, c = c.getSuperclass()) {
            try {
                java.lang.reflect.Method m = c.getDeclaredMethod(name, sig);
                m.setAccessible(true);
                return m.invoke(obj, args);
            } catch (NoSuchMethodException ignore) {
            } catch (Throwable t) { return null; }
        }
        return null;
    }

    private static boolean scrollListBy(android.view.ViewGroup list, int dy) {
        try {
            callAny(list, "scrollBy", new Class<?>[]{int.class, int.class}, new Object[]{0, dy});
            return true;
        } catch (Throwable t) { return false; }
    }

    private static int lmCount(android.view.ViewGroup list) {
        try {
            Object lm = callAny(list, "getLayoutManager", new Class<?>[]{}, new Object[]{});
            if (lm != null) {
                Object n = callAny(lm, "getItemCount", new Class<?>[]{}, new Object[]{});
                if (n instanceof Integer) return (Integer) n;
            }
            Object ad = callAny(list, "getAdapter", new Class<?>[]{}, new Object[]{});
            Object n2 = callAny(ad, "getItemCount", new Class<?>[]{}, new Object[]{});
            if (n2 instanceof Integer) return (Integer) n2;
        } catch (Throwable ignore) { }
        return 0;
    }

    private static boolean scrollToPos(android.view.ViewGroup list, int pos) {
        try {
            if (list instanceof android.widget.AbsListView) {
                ((android.widget.AbsListView) list).setSelectionFromTop(pos, dp(chatAct, 60));
                return true;
            }
            Object lm = callAny(list, "getLayoutManager", new Class<?>[]{}, new Object[]{});
            if (lm != null) {
                Object r = callAny(lm, "scrollToPositionWithOffset",
                        new Class<?>[]{int.class, int.class}, new Object[]{pos, dp(chatAct, 60)});
                if (r != null || true) return true;
            }
            Object r2 = callAny(list, "scrollToPosition", new Class<?>[]{int.class}, new Object[]{pos});
            return true;
        } catch (Throwable t) { log("JUMP|scrollpos err " + t); return false; }
    }

    /** 边加载边逼近：先把更老的消息翻出来，再滚到目标位置 */
    private static void loadAndLocate(final String wxid, final long tsMs, final String text) {
        new Thread(new Runnable() {
            @Override public void run() {
                long sec = tsMs > 100000000000L ? tsMs / 1000L : tsMs;
                Object h = msgDbHandle();
                if (h == null) return;
                long newer = scCount(h, "select count(*) from message where talker='"
                        + wxid.replace("'", "''") + "' and createTime > " + sec);
                log("JUMP|load newer=" + newer);
                for (int round = 0; round < 40; round++) {
                    final int[] info = new int[2];
                    final java.util.concurrent.CountDownLatch latch =
                            new java.util.concurrent.CountDownLatch(1);
                    final int rnd = round;
                    new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                        @Override public void run() {
                            try {
                                if (chatAct == null || chatAct.getWindow() == null) return;
                                android.view.ViewGroup list =
                                        findMsgList(chatAct.getWindow().getDecorView());
                                if (list == null) return;
                                int total = lmCount(list);
                                info[0] = total;
                                long pos = (long) total - 1 - newer;
                                info[1] = (int) pos;
                                if (pos >= 0 && pos < total) {
                                    scrollToPos(list, (int) pos);
                                    log("JUMP|scrollpos pos=" + pos + " total=" + total);
                                } else if (pos < 0) {
                                    boolean ok = scrollListBy(list, -Math.max(dp(chatAct, 500), list.getHeight()));
                                    long topTs = 0;
                                    for (int i = 0; i < list.getChildCount(); i++) {
                                        long tt = tsOfAnchor(list.getChildAt(i));
                                        if (tt > 0 && (topTs == 0 || tt < topTs)) topTs = tt;
                                    }
                                    log("JUMP|round#" + rnd + " total=" + total + " pos=" + pos
                                            + " scrollBy=" + ok + " topTs=" + topTs);
                                } else {
                                    scrollListBy(list, Math.max(dp(chatAct, 500), list.getHeight()));
                                }
                            } catch (Throwable t) { log("JUMP|round err " + t); }
                            finally { latch.countDown(); }
                        }
                    });
                    try { latch.await(2, java.util.concurrent.TimeUnit.SECONDS); } catch (Throwable ignore) { }
                    if (info[0] > 0 && info[1] >= 0 && info[1] < info[0]) break;
                    try { Thread.sleep(420); } catch (Throwable ignore) { }
                }
                try { Thread.sleep(500); } catch (Throwable ignore) { }
                findAndFlashTs(tsMs, text);
            }
        }).start();
    }

    /** 列表里最上面一行的时间戳 */
    private static long topTagOf(android.view.ViewGroup list) {
        long best = 0;
        try {
            for (int i = 0; i < list.getChildCount(); i++) {
                long t = tsOfAnchor(list.getChildAt(i));
                if (t > 0 && (best == 0 || t < best)) best = t;
            }
        } catch (Throwable ignore) { }
        return best;
    }

    /** 真正把列表往上翻一屏（scrollBy 不行就用触摸事件） */
    private static boolean scrollUpHard(android.view.ViewGroup list, int dy) {
        try {
            long before = topTagOf(list);
            callAny(list, "scrollBy", new Class<?>[]{int.class, int.class}, new Object[]{0, -dy});
            long after = topTagOf(list);
            if (after != before) return true;
            // 触摸模拟
            int w = list.getWidth(), h = list.getHeight();
            if (w <= 0 || h <= 0) return false;
            long now = android.os.SystemClock.uptimeMillis();
            float x = w / 2f;
            list.dispatchTouchEvent(android.view.MotionEvent.obtain(now, now,
                    android.view.MotionEvent.ACTION_DOWN, x, h * 0.25f, 0));
            for (int k = 1; k <= 12; k++) {
                list.dispatchTouchEvent(android.view.MotionEvent.obtain(now, now + k * 16L,
                        android.view.MotionEvent.ACTION_MOVE, x, h * 0.25f + (h * 0.55f) * k / 12f, 0));
            }
            list.dispatchTouchEvent(android.view.MotionEvent.obtain(now, now + 220L,
                    android.view.MotionEvent.ACTION_UP, x, h * 0.8f, 0));
            return topTagOf(list) != before;
        } catch (Throwable t) { log("JUMP|scrollUp err " + t); return false; }
    }

    /** 按时间从新往旧翻页，直到目标时间进入可见范围 */
    private static void locateByTime(final String wxid, final long tsMs, final String text) {
        new Thread(new Runnable() {
            @Override public void run() {
                long target = tsMs;
                long sec = target > 100000000000L ? target / 1000L : target;
                Object h = msgDbHandle();
                for (int round = 0; round < 40; round++) {
                    final java.util.concurrent.CountDownLatch latch =
                            new java.util.concurrent.CountDownLatch(1);
                    final int rnd = round;
                    final boolean[] done = new boolean[]{false};
                    new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                        @Override public void run() {
                            try {
                                if (chatAct == null || chatAct.getWindow() == null) return;
                                android.view.ViewGroup list =
                                        findMsgList(chatAct.getWindow().getDecorView());
                                if (list == null) return;
                                long top = topTagOf(list);
                                if (top > 0 && Math.abs(top - target) <= 1500) { done[0] = true; return; }
                                if (top > 0 && top <= target + 1000) {
                                    // 目标在下面，已经翻过头了
                                    done[0] = true;
                                    return;
                                }
                                boolean moved = scrollUpHard(list, Math.max(dp(chatAct, 400), list.getHeight() * 2 / 3));
                                log("JUMP|time#" + rnd + " top=" + top + " target=" + target
                                        + " moved=" + moved);
                                if (!moved) {
                                    // 换用 LM 大步退
                                    int total = lmCount(list);
                                    scrollToPos(list, Math.max(0, total - 60));
                                }
                            } catch (Throwable t) { log("JUMP|time err " + t); }
                            finally { latch.countDown(); }
                        }
                    });
                    try { latch.await(3, java.util.concurrent.TimeUnit.SECONDS); } catch (Throwable ignore) { }
                    if (done[0]) break;
                    try { Thread.sleep(450); } catch (Throwable ignore) { }
                }
                findAndFlashTs(tsMs, text);
            }
        }).start();
    }

    private static final java.util.HashSet<String> preFetching = new java.util.HashSet<String>();

    /** 进聊天页就预取这个人的聊天记录，点头像时直接命中缓存 */
    private static void prefetchHistory(final String talker) {
        try {
            if (talker == null || talker.length() == 0) return;
            if (talker.endsWith("@chatroom")) return;       // 群聊记录不可预取，靠点头像取名
            Object[] cached = histCache.get(talker);
            if (cached != null && System.currentTimeMillis() - ((Long) cached[3]).longValue() < 120000L) return;
            synchronized (preFetching) {
                if (preFetching.contains(talker)) return;
                preFetching.add(talker);
            }
            new Thread(new Runnable() {
                @Override public void run() {
                    try {
                        java.util.ArrayList<long[]> meta = new java.util.ArrayList<long[]>();
                        java.util.ArrayList<String> raw = new java.util.ArrayList<String>();
                        java.util.ArrayList<String> paths = new java.util.ArrayList<String>();
                        Object h = msgDbHandle();
                        if (h != null) {
                            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                                    .invoke(h, "select msgId, msgSvrId, createTime, isSend, type, content, imgPath"
                                            + " from message where talker='" + talker.replace("'", "''")
                                            + "' order by createTime desc limit 300", new String[0]);
                            if (cur != null) {
                                java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                                java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                                java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                                while ((Boolean) mv.invoke(cur)) {
                                    long mid = (Long) gl.invoke(cur, 0);
                                    long svrId = (Long) gl.invoke(cur, 1);
                                    long t = (Long) gl.invoke(cur, 2);
                                    long send = (Long) gl.invoke(cur, 3);
                                    long type = (Long) gl.invoke(cur, 4);
                                    String c = (String) gs.invoke(cur, 5);
                                    String ipath = null;
                                    try { ipath = (String) gs.invoke(cur, 6); } catch (Throwable ignore) { }
                                    if (t < 100000000000L) t *= 1000L;
                                    meta.add(new long[]{t, send, type, mid, svrId});
                                    raw.add(c == null ? "" : c);
                                    paths.add(ipath == null ? "" : ipath);
                                }
                                try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                            }
                        }
                        if (!meta.isEmpty()) {
                            histCache.put(talker, new Object[]{meta, raw, paths, Long.valueOf(System.currentTimeMillis())});
                            log("AVHIST|prefetch " + talker + " n=" + meta.size());
                        }
                    } catch (Throwable t) { log("AVHIST|prefetch err " + t); }
                    finally {
                        synchronized (preFetching) { preFetching.remove(talker); }
                    }
                }
            }).start();
        } catch (Throwable ignore) { }
    }

    /** 从当前聊天页的 intent 里取会话 id（比静态 chatTalker 更及时） */
    private static String talkerOfActivity(android.app.Activity a) {
        try {
            if (a == null) return null;
            android.content.Intent it = a.getIntent();
            if (it == null) return null;
            for (String k : new String[]{"Chat_User", "chat_User", "talker", "Chat_UserName"}) {
                String v = it.getStringExtra(k);
                if (v != null && v.length() > 0) return v;
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 取一行里显示的名字 */
    private static String nameOfRow(android.view.View v) {
        try {
            android.view.View row = walkUpToItem(v);
            if (row == null) return null;
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            q.add(row);
            int n = 0;
            while (!q.isEmpty() && n++ < 60) {
                android.view.View c = q.poll();
                if (c instanceof android.widget.TextView) {
                    CharSequence cs = ((android.widget.TextView) c).getText();
                    if (cs == null) continue;
                    String t = cs.toString().trim();
                    if (t.length() == 0 || t.length() > 30) continue;
                    if (t.contains("消息") || t.contains("更多") || t.contains("时间")
                            || t.matches("[0-9:./ -]+") || t.contains(":")) continue;
                    return t;
                }
                if (c instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) c;
                    for (int i = 0; i < g.getChildCount(); i++) q.add(g.getChildAt(i));
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 按 备注/昵称/微信号 反查 wxid */
    private static String wxidByName(String name) {
        try {
            if (name == null || name.length() == 0) return null;
            Object h = msgDbHandle();
            if (h == null) return null;
            String esc = name.replace("'", "''");
            String sql = "select username from rcontact where conRemark='" + esc
                    + "' or nickname='" + esc + "' or alias='" + esc + "' limit 1";
            String r = queryContent(h, sql);
            if (r != null && r.length() > 0) return r;
            // 模糊匹配兜底
            r = queryContent(h, "select username from rcontact where conRemark like '%" + esc
                    + "%' or nickname like '%" + esc + "%' limit 1");
            return r;
        } catch (Throwable t) { return null; }
    }

    /** 会话列表里点头像：按行号从 rconversation 取 wxid（最准） */
    private static String talkerAtListRow(android.view.View avatar) {
        try {
            android.view.View row = walkUpToItem(avatar);
            android.view.ViewParent par = row == null ? null : row.getParent();
            if (!(par instanceof android.view.ViewGroup)) return null;
            android.view.ViewGroup list = (android.view.ViewGroup) par;
            int pos = -1;
            Object p2 = callAny(list, "getChildAdapterPosition",
                    new Class<?>[]{android.view.View.class}, new Object[]{row});
            if (p2 instanceof Integer && ((Integer) p2).intValue() >= 0) pos = (Integer) p2;
            if (pos < 0) {
                Object fvp = callAny(list, "getFirstVisiblePosition", new Class<?>[]{}, new Object[]{});
                int first = fvp instanceof Integer ? (Integer) fvp : 0;
                pos = first + list.indexOfChild(row);
            }
            if (pos < 0) return null;
            Object h = msgDbHandle();
            if (h == null) return null;
            String sql = "select username from rconversation order by conversationTime desc limit 1 offset " + pos;
            String r = queryContent(h, sql);
            log("AVHIST|listrow pos=" + pos + " -> " + r);
            return r;
        } catch (Throwable t) { log("AVHIST|listrow err " + t); return null; }
    }

    /** 标题反查优先，其次 Activity intent，最后静态字段 */
    private static String andByTitle(String byName, android.app.Activity a) {
        if (byName != null && byName.length() > 0) return byName;
        String tk = talkerOfActivity(a);
        if (tk != null && tk.length() > 0) return tk;
        return chatTalker;
    }

    /** 取指定 Activity 的标题栏名字（自绘文字也能取到） */
    private static String chatNameOfActivity(android.app.Activity ca) {
        try {
            if (ca == null) return null;
            android.view.View decor = ca.getWindow().getDecorView();
            int limitY = (int) (ca.getResources().getDisplayMetrics().heightPixels * 0.16f);
            String best = null;
            float bestSize = -1;
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            q.add(decor);
            int[] loc = new int[2];
            int scanned = 0;
            while (!q.isEmpty() && scanned++ < 400) {
                android.view.View v = q.poll();
                if (v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) q.add(g.getChildAt(i));
                    continue;
                }
                try {
                    v.getLocationOnScreen(loc);
                    if (loc[1] > limitY) continue;
                    if (v.getVisibility() != android.view.View.VISIBLE) continue;
                    String tx = null;
                    if (v instanceof android.widget.TextView) {
                        CharSequence cs = ((android.widget.TextView) v).getText();
                        if (cs != null) tx = cs.toString();
                    }
                    if (tx == null || tx.trim().length() == 0) {
                        try { tx = renderedTextOf(v); } catch (Throwable ignore) { }
                    }
                    if (tx == null) continue;
                    tx = tx.trim();
                    if (tx.length() == 0 || tx.length() > 30) continue;
                    if (tx.contains("消息") || tx.contains("微信") || tx.matches("[0-9:./ -]+")) continue;
                    float size = v instanceof android.widget.TextView
                            ? ((android.widget.TextView) v).getTextSize() : 14f;
                    if (size > bestSize) { bestSize = size; best = tx; }
                } catch (Throwable ignore) { }
            }
            return best;
        } catch (Throwable t) { return null; }
    }

    /** 从这一行消息反查它属于哪个会话（最可靠） */
    private static String talkerOfRow(android.view.View anchor) {
        try {
            long ts = tsOfAnchor(anchor);
            if (ts <= 0) return null;
            long sec = ts > 100000000000L ? ts / 1000L : ts;
            Object h = msgDbHandle();
            if (h == null) return null;
            return queryContent(h, "select talker from message where createTime between "
                    + (sec - 2) + " and " + (sec + 2) + " limit 1");
        } catch (Throwable t) { return null; }
    }

    /** 直接从当前 Activity 里的 ChattingUI Fragment 读会话 id（每次点击现取） */
    private static String liveTalker(android.app.Activity a) {
        if (a == null) return null;
        String[] fmMethods = {"getFragmentManager", "getSupportFragmentManager"};
        for (String fmName : fmMethods) {
            try {
                Object fm = callAny(a, fmName, new Class<?>[]{}, new Object[]{});
                if (fm == null) continue;
                Object list = callAny(fm, "getFragments", new Class<?>[]{}, new Object[]{});
                if (!(list instanceof java.util.List)) continue;
                for (Object frag : (java.util.List<?>) list) {
                    if (frag == null) continue;
                    if (!frag.getClass().getName().contains("ChattingUI")) continue;
                    Object args = callAny(frag, "getArguments", new Class<?>[]{}, new Object[]{});
                    if (args instanceof android.os.Bundle) {
                        android.os.Bundle b = (android.os.Bundle) args;
                        for (String k : new String[]{"Chat_User", "chat_User", "talker", "Chat_UserName"}) {
                            String v = b.getString(k);
                            if (v != null && v.length() > 0) {
                                log("AVHIST|liveTalker args=" + v + " via " + fmName);
                                return v;
                            }
                        }
                    }
                    // 字段兜底
                    Class<?> c = frag.getClass();
                    for (int lv = 0; lv < 4 && c != null; lv++, c = c.getSuperclass()) {
                        for (java.lang.reflect.Field f : c.getDeclaredFields()) {
                            if (f.getType() != String.class) continue;
                            String n = f.getName().toLowerCase();
                            if (!n.contains("talker") && !n.contains("username") && !n.contains("chatuser")) continue;
                            try {
                                f.setAccessible(true);
                                Object v = f.get(frag);
                                if (v instanceof String && ((String) v).length() > 0) {
                                    log("AVHIST|liveTalker field=" + v);
                                    return (String) v;
                                }
                            } catch (Throwable ignore) { }
                        }
                    }
                    log("AVHIST|liveTalker fragment found but no talker: " + frag.getClass().getName());
                }
            } catch (Throwable t) { log("AVHIST|liveTalker err " + t); }
        }
        return null;
    }

    /** 从聊天列表的 adapter item 直接取会话（最可靠，一次到位） */
    private static String talkerFromAdapter(android.view.View avatar) {
        try {
            android.view.View row = walkUpToItem(avatar);
            if (row == null) return null;
            android.view.ViewParent par = row.getParent();
            if (!(par instanceof android.view.ViewGroup)) return null;
            android.view.ViewGroup list = (android.view.ViewGroup) par;
            Object pos = callAny(list, "getChildAdapterPosition", new Class<?>[]{android.view.View.class}, new Object[]{row});
            if (!(pos instanceof Integer)) return null;
            Object adapter = callAny(list, "getAdapter", new Class<?>[]{}, new Object[]{});
            if (adapter == null) return null;
            Object item = callAny(adapter, "getItem", new Class<?>[]{int.class}, new Object[]{pos});
            if (item == null) {
                log("AVHIST|adapter item null pos=" + pos);
                return null;
            }
            Object t = callAny(item, "getTalker", new Class<?>[]{}, new Object[]{});
            if (t instanceof String && ((String) t).length() > 0) {
                log("AVHIST|adapter getTalker=" + t);
                return (String) t;
            }
            // 字段兜底
            Class<?> c = item.getClass();
            for (int lv = 0; lv < 5 && c != null; lv++, c = c.getSuperclass()) {
                for (java.lang.reflect.Field f : c.getDeclaredFields()) {
                    if (f.getType() != String.class) continue;
                    String n = f.getName().toLowerCase();
                    if (!n.contains("talker") && !n.contains("username")) continue;
                    try {
                        f.setAccessible(true);
                        Object v = f.get(item);
                        if (v instanceof String && ((String) v).length() > 0) {
                            log("AVHIST|adapter field " + f.getName() + "=" + v);
                            return (String) v;
                        }
                    } catch (Throwable ignore) { }
                }
            }
        } catch (Throwable t) { log("AVHIST|adapter err " + t); }
        return null;
    }

    private static String emojiBaseDir = null;

    /** 找表情原始文件：MicroMsg/<hash>/emoji/<表情包目录>/<md5> */
    private static String findEmojiFile(String md5) {
        try {
            if (md5 == null || md5.length() < 32) return null;
            if (emojiBaseDir == null) {
                java.io.File mm = new java.io.File("/data/user/0/com.tencent.mm/MicroMsg");
                java.io.File[] ds = mm.listFiles();
                if (ds != null) {
                    for (java.io.File d : ds) {
                        if (new java.io.File(d, "emoji").isDirectory()) {
                            emojiBaseDir = new java.io.File(d, "emoji").getAbsolutePath();
                            break;
                        }
                    }
                }
            }
            if (emojiBaseDir == null) return null;
            java.io.File direct = new java.io.File(emojiBaseDir, md5);
            if (direct.isFile()) return direct.getAbsolutePath();
            java.io.File[] packs = new java.io.File(emojiBaseDir).listFiles();
            if (packs != null) {
                for (java.io.File p : packs) {
                    if (!p.isDirectory()) continue;
                    java.io.File f = new java.io.File(p, md5);
                    if (f.isFile()) return f.getAbsolutePath();
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 表情：先读缓存，再解密原始文件（用消息 XML 里的 aeskey） */
    private static android.graphics.Bitmap loadEmojiBitmap(String md5, String aeskey) {
        android.graphics.Bitmap bm = loadCachedEmoji(md5);
        if (bm != null) return bm;
        try {
            if (aeskey == null || aeskey.length() != 32) {
                Object h = msgDbHandle();
                if (h != null) {
                    String k = queryContent(h, "select aeskey from EmojiInfo where md5='" + md5.replace("'", "''") + "' limit 1");
                    if (k != null && k.length() == 32) {
                        aeskey = k;
                        log("EMOJI|key from db " + k);
                    }
                }
            }
            String path = findEmojiFile(md5);
            if (path == null) return null;
            byte[] raw = readAll(new java.io.File(path));
            if (raw == null || raw.length < 64) return null;
            android.graphics.BitmapFactory.Options o = new android.graphics.BitmapFactory.Options();
            o.inSampleSize = 2;
            bm = decodeWithKey(raw, aeskey, o);
            if (bm == null) bm = android.graphics.BitmapFactory.decodeByteArray(raw, 0, raw.length, o);
            if (bm != null) {
                try {
                    java.io.File out = new java.io.File(emojiCacheDir(), "emoji_" + md5 + ".png");
                    java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
                    bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, fo);
                    fo.flush(); fo.close();
                } catch (Throwable ignore) { }
                log("EMOJI|decoded " + md5 + " " + bm.getWidth() + "x" + bm.getHeight());
            } else {
                log("EMOJI|decode fail " + md5 + " path=" + path + " key=" + aeskey);
            }
            return bm;
        } catch (Throwable t) { log("EMOJI|load err " + t); return null; }
    }

    private static boolean emoDiagDone = false;

    /** 一次性诊断：找出某个表情消息的 aeskey，并试各种密钥解密 */
    private static void diagEmojiOnce() {
        Object h = msgDbHandle();
        if (h == null) { log("EMODIAG|no db"); return; }
        if (emoDiagDone) return;
        emoDiagDone = true;
        try {
            String md5 = "ebe47bd373b1ab82c3fcf42ee98fefd2";
            String content = queryContent(h, "select content from message where content like '%" + md5 + "%' limit 1");
            log("EMODIAG|content=" + (content == null ? "null" : content.substring(0, Math.min(300, content.length()))));
            try {
                Object cur = h.getClass().getMethod("B", String.class, String[].class)
                        .invoke(h, "select name from sqlite_master where type='table' and name like '%moji%'", new String[0]);
                StringBuilder tb = new StringBuilder();
                if (cur != null) {
                    java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                    java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                    while ((Boolean) mv.invoke(cur)) tb.append(gs.invoke(cur, 0)).append(',');
                    try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                }
                log("EMODIAG|tables=" + tb);
            } catch (Throwable t) { log("EMODIAG|tbl err " + t); }
            String aes = content == null ? null : attrOf(content, "aeskey");
            log("EMODIAG|aes=" + aes);
            String path = findEmojiFile(md5);
            log("EMODIAG|path=" + path);
            if (path != null) {
                byte[] raw = readAll(new java.io.File(path));
                log("EMODIAG|raw=" + (raw == null ? 0 : raw.length) + " head="
                        + (raw == null || raw.length < 4 ? "" : String.format("%02x%02x%02x%02x", raw[0], raw[1], raw[2], raw[3])));
                android.graphics.BitmapFactory.Options o = new android.graphics.BitmapFactory.Options();
                o.inSampleSize = 1;
                if (raw != null) {
                    android.graphics.Bitmap bm = decodeWithKey(raw, aes, o);
                    log("EMODIAG|aesdecode=" + (bm == null ? "fail" : bm.getWidth() + "x" + bm.getHeight()));
                    if (bm == null) {
                        bm = android.graphics.BitmapFactory.decodeByteArray(raw, 0, raw.length, o);
                        log("EMODIAG|plaindecode=" + (bm == null ? "fail" : bm.getWidth() + "x" + bm.getHeight()));
                    }
                }
            }
        } catch (Throwable t) { log("EMODIAG|err " + t); }
    }

    private static boolean emoInfoDiag = false;

    private static void diagEmojiInfo() {
        if (emoInfoDiag) return;
        Object h = msgDbHandle();
        if (h == null) return;
        emoInfoDiag = true;
        try {
            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, "pragma table_info(EmojiInfo)", new String[0]);
            StringBuilder cols = new StringBuilder();
            if (cur != null) {
                java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                while ((Boolean) mv.invoke(cur)) cols.append(gs.invoke(cur, 1)).append(',');
                try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
            }
            log("EMOINFO|cols=" + cols);
            Object c2 = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, "select * from EmojiInfo where md5='ebe47bd373b1ab82c3fcf42ee98fefd2' limit 1",
                            new String[0]);
            if (c2 != null) {
                java.lang.reflect.Method mv = c2.getClass().getMethod("moveToNext");
                java.lang.reflect.Method gc = c2.getClass().getMethod("getColumnCount");
                java.lang.reflect.Method gn = c2.getClass().getMethod("getColumnName", int.class);
                java.lang.reflect.Method gs2 = c2.getClass().getMethod("getString", int.class);
                int n = (Integer) gc.invoke(c2);
                if ((Boolean) mv.invoke(c2)) {
                    StringBuilder row = new StringBuilder();
                    for (int i = 0; i < n; i++) {
                        String nm = (String) gn.invoke(c2, i);
                        String v = null;
                        try { v = (String) gs2.invoke(c2, i); } catch (Throwable ignore) { }
                        if ("reserved4".equals(nm) || "reserved3".equals(nm)) continue;
                        row.append(nm).append('=').append(v).append(" | ");
                    }
                    log("EMOINFO|row=" + row);
                } else {
                    log("EMOINFO|no row");
                }
                try { c2.getClass().getMethod("close").invoke(c2); } catch (Throwable ignore) { }
            }
        } catch (Throwable t) { log("EMOINFO|err " + t); }
    }

    private static android.graphics.Bitmap weldBgCache = null;
    private static String weldBgPath = null;

    /** 主题背景：解码一次，之后直接复用（避免每页重新 decode 造成卡顿/闪白） */
    private static android.graphics.Bitmap weldBg(android.app.Activity a) {
        try {
            if (a == null) a = topAct;
            String path = themeBg("MainFragmentBackground");
            if (path == null) return null;
            if (weldBgCache != null && path.equals(weldBgPath)) return weldBgCache;
            android.graphics.BitmapFactory.Options o = new android.graphics.BitmapFactory.Options();
            o.inSampleSize = 2;
            android.graphics.Bitmap bm = android.graphics.BitmapFactory.decodeFile(path, o);
            if (bm == null) return null;
            try {
                int wa = cfg().optInt("pageBgWhite", 105);
                if (wa > 0) bm = frostWith(bm, wa);
            } catch (Throwable ignore) { }
            weldBgCache = bm;
            weldBgPath = path;
            log("WELD|decoded " + bm.getWidth() + "x" + bm.getHeight());
            return bm;
        } catch (Throwable t) { return null; }
    }

    /** 把主题背景焊到 decor 的 background（不新增子 View，避免微信 getChildAt(0) 强转崩溃） */
    private static void weldTheme(final android.app.Activity a) {
        try {
            // 聊天页绝不套主题：否则 decor 壁纸 + 清底会让聊天框（气泡/输入栏）变透明
            if (a != null) {
                String anc0 = a.getClass().getName();
                if (anc0.contains("Chatting") || anc0.contains("chatting")) {
                    try {
                        android.view.View dc0 = a.getWindow().getDecorView();
                        if ("wxhWeld".equals(String.valueOf(dc0.getTag()))) {
                            dc0.setBackground(null);
                            dc0.setTag(null);
                        }
                    } catch (Throwable ignore) { }
                    return;
                }
            }
            // 四页主题已删除：不做任何窗口背景/叠层处理
            if (!themeOn()) return;
            if (a == null) return;
            if (TABS_THEME_OFF) return;   // 四页主题已按要求关闭
            if (!themeOn()) return;
            final android.view.View decor = a.getWindow().getDecorView();
            if ("wxhWeld".equals(String.valueOf(decor.getTag()))) return;
            final android.graphics.Bitmap bm = weldBg(a);
            if (bm == null) return;
            if (themeOn()) {
                // 四页主题：装回主题壁纸（不再压成纯白），页面内白底由 pageWallPulse 周期清掉
                try {
                    decor.setBackgroundDrawable(new android.graphics.drawable.BitmapDrawable(a.getResources(), bm));
                    pageWallTicks = 0;
                    pageWallPulse(a);
                } catch (Throwable t0) { decor.setBackgroundColor(0xFFF7F7F9); }
            } else {
                decor.setBackground(null);
                decor.setTag(null);
                try { decor.getOverlay().clear(); } catch (Throwable ignore) { }
            }
            if (themeOn()) decor.setTag("wxhWeld");
            // 叠一层主题染色到 overlay：白底区域也会被染成主题色（11-07 老包同款）
            try {
                int tintA = cfg().optInt("tintAlpha", 96);
                // 叠图会盖住四页各自的背景（旧浮窗方案产物），默认关闭
                boolean tintOn = cfg().optBoolean("tintOverlay", false);
                if (!tintOn) {
                    try { decor.getOverlay().clear(); } catch (Throwable ignore) { }
                    tintRef = null;
                }
                if (tintOn && tintA > 0 && !"wxhTint".equals(String.valueOf(decor.getTag(0x0f0f0f52)))) {
                    android.graphics.drawable.BitmapDrawable tint =
                            new android.graphics.drawable.BitmapDrawable(a.getResources(), bm);
                    tint.setAlpha(tintA);
                    android.view.ViewOverlay ov = decor.getOverlay();
                    if (ov != null) {
                        ov.add(tint);
                        tintRef = tint;
                        decor.setTag(0x0f0f0f52, "wxhTint");
                        log("WELD|tint ok a=" + tintA);
                    }
                }
            } catch (Throwable t) { log("WELD|tint err " + t); }
            log("WELD|bg " + a.getClass().getSimpleName());
        } catch (Throwable t) { log("WELD|err " + t); }
    }

    private static android.os.Handler pageWallH = null;
    private static java.lang.ref.WeakReference<android.app.Activity> pageWallAct = null;

    /** 四页壁纸可见性维护：清掉 pager / 列表 / 行里的不透明白底，让 decor 上的壁纸透出来 */
    private static void pageWallPulse(final android.app.Activity a) {
        if (a == null) return;
        if (pageWallH != null && pageWallAct != null && pageWallAct.get() == a) return;
        pageWallAct = new java.lang.ref.WeakReference<android.app.Activity>(a);
        pageWallH = new android.os.Handler(android.os.Looper.getMainLooper());
        pageWallH.post(new Runnable() {
            @Override public void run() {
                try {
                    android.app.Activity cur = topAct;
                    if (cur == null) cur = pageWallAct == null ? null : pageWallAct.get();
                    boolean ok = cur != null && cur.getClass().getName().endsWith("LauncherUI")
                            && themeOn() && themeOn();
                    if (!ok) {
                        // 不是聊天首页这一拍：不清扫，但继续排队，等回首页立刻生效
                        if (pageWallH != null) pageWallH.postDelayed(this, 800L);
                        return;
                    }
                    android.view.View decor = cur.getWindow().getDecorView();
                    android.view.ViewGroup pager = findPager(decor);
                    if (pager != null) {
                        weldPagerRef = new java.lang.ref.WeakReference<android.view.ViewGroup>(pager);
                    }
                    if (!pageWallDumped) { pageWallDumped = true; pageWallDump(decor, 0, 18); }
                    // 只在进场前几拍清扫：清太多会逼微信重新画白纱，反而看不到图
                    if (pageWallTicks > 9) { if (pageWallH != null) pageWallH.postDelayed(this, 1500L); return; }
                    pageWallTicks++;
                    // 先保证 decor 底就是壁纸（微信可能自己换掉），再清扫整窗
                    int n = 0;
                    try {
                        android.graphics.drawable.Drawable bd0 = decor.getBackground();
                        if (!(bd0 instanceof android.graphics.drawable.BitmapDrawable)) {
                            android.graphics.Bitmap bm2 = weldBg(cur);
                            if (bm2 != null) {
                                decor.setBackgroundDrawable(new android.graphics.drawable.BitmapDrawable(
                                        cur.getResources(), bm2));
                                n++;
                            }
                        }
                    } catch (Throwable ignore) { }
                    if (decor instanceof android.view.ViewGroup) {
                        android.view.ViewGroup dg = (android.view.ViewGroup) decor;
                        for (int i = 0; i < dg.getChildCount(); i++) {
                            n += pageWallClearStrong(dg.getChildAt(i), 0, 26);
                        }
                    }
                    if (n > 0 && System.currentTimeMillis() - pageWallLogAt > 3000) {
                        pageWallLogAt = System.currentTimeMillis();
                        log("PAGEWALL|cleared " + n);
                    }
                } catch (Throwable ignore) { }
                if (pageWallH != null) pageWallH.postDelayed(this, 900L);
            }
        });
    }

    /** 四页强透明：pager 子树里所有"实底背景"一律去掉，让 decor 壁纸露出来 */
    private static int pageWallClearStrong(android.view.View v, int d, int maxD) {
        int n = 0;
        if (v == null || d > maxD) return 0;
        try {
            String cn = v.getClass().getName();
            android.graphics.drawable.Drawable bg = v.getBackground();
            if (bg != null && !(bg instanceof android.graphics.drawable.BitmapDrawable)
                    && !cn.contains("ImageView")) {
                v.setBackground(null);
                n++;
            }
        } catch (Throwable ignore) { }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                n += pageWallClearStrong(g.getChildAt(i), d + 1, maxD);
            }
        }
        return n;
    }

    private static boolean pageWallDumped = false;
    private static int pageWallTicks = 0;
    /** 一次性 dump 四页里还带背景的 View（类名/背景类型/颜色/位置），定位谁还在挡壁纸 */
    private static void pageWallDump(android.view.View v, int d, int maxD) {
        if (v == null || d > maxD) return;
        try {
            android.graphics.drawable.Drawable bg = v.getBackground();
            if (bg != null) {
                String info = bg.getClass().getSimpleName();
                if (bg instanceof android.graphics.drawable.ColorDrawable) {
                    info += String.format(" #%08X", ((android.graphics.drawable.ColorDrawable) bg).getColor());
                }
                int[] loc = new int[2];
                v.getLocationInWindow(loc);
                log("PWDUMP|" + v.getClass().getSimpleName() + " " + info
                        + " @" + loc[0] + "," + loc[1] + " " + v.getWidth() + "x" + v.getHeight());
            }
        } catch (Throwable ignore) { }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) pageWallDump(g.getChildAt(i), d + 1, maxD);
        }
    }

    private static long pageWallLogAt = 0;

    /** 深度清扫纯白/近白实底（不动图片和渐变），最多 depth 层 */
    private static int clearWhiteBgDeep(android.view.View v, int d, int maxD) {
        int n = 0;
        if (v == null || d > maxD) return 0;
        try {
            android.graphics.drawable.Drawable bg = v.getBackground();
            if (bg instanceof android.graphics.drawable.ColorDrawable) {
                int c = ((android.graphics.drawable.ColorDrawable) bg).getColor();
                if (android.graphics.Color.alpha(c) > 200
                        && android.graphics.Color.red(c) > 235
                        && android.graphics.Color.green(c) > 235
                        && android.graphics.Color.blue(c) > 235) {
                    v.setBackground(null);
                    n++;
                }
            }
        } catch (Throwable ignore) { }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                n += clearWhiteBgDeep(g.getChildAt(i), d + 1, maxD);
            }
        }
        return n;
    }

    /** 把历史遗留的透明页面恢复成不透明白底 */
    private static void restoreTabTransparency(android.app.Activity a) {
        try {
            if (a == null) return;
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(a.getWindow().getDecorView(), all, 0);
            int n = 0;
            for (android.view.View v : all) {
                Object tg = v.getTag();
                if (!"wxhTrans".equals(String.valueOf(tg))) continue;
                v.setBackgroundColor(0xFFFFFFFF);
                v.setTag(null);
                n++;
            }
            if (n > 0) log("WELDTAB|restore " + n);
        } catch (Throwable ignore) { }
    }

    private static void unweldTheme(android.app.Activity a) {
        try {
            if (a == null) return;
            android.view.View decor = a.getWindow().getDecorView();
            if (!"wxhWeld".equals(String.valueOf(decor.getTag()))) return;
            decor.setBackground(null);
            decor.setTag(null);
        } catch (Throwable ignore) { }
    }

    /** 四个 tab 页（微信/通讯录/发现/我）铺透明，让 decor 上的主题背景透出来 */

    /** 页面重建会盖回白底：短时间内反复补几次，避免切换 tab 时闪白 */
    private static void scheduleWeld(final android.app.Activity a) {
        try {
            if (!themeOn()) return;
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            for (int i = 1; i <= 12; i++) {
                h.postDelayed(new Runnable() {
                    @Override public void run() {
                        try {
                            weldTheme(a);
                        } catch (Throwable ignore) { }
                    }
                }, i * 400L);
            }
        } catch (Throwable ignore) { }
    }

    private static android.os.Handler weldPulseH = null;
    private static Runnable weldPulseR = null;
    private static java.lang.ref.WeakReference<android.app.Activity> weldAct = null;





    /** 关掉 ViewPager 的切页滑动：没有过渡动画就不会露出中间态白底 */
    private static void installPagerNoAnim(ClassLoader app) {
        try {
            String[] names = new String[]{
                "android.support.v4.view.ViewPager",
                "androidx.viewpager.widget.ViewPager"
            };
            int n = 0;
            for (String nm : names) {
                try {
                    Class<?> c = Class.forName(nm, false, app);
                    if (c == null) continue;
                    try {
                        XposedBridge.hookAllMethods(c, "setCurrentItem", new XC_MethodHook() {
                            @Override protected void beforeHookedMethod(MethodHookParam p) {
                                try {
                                    if (p.args != null && p.args.length == 2 && (p.args[1] instanceof Boolean)
                                            && Boolean.TRUE.equals(p.args[1])) {
                                        p.args[1] = Boolean.FALSE;
                                    }
                                } catch (Throwable ignore) { }
                            }
                        });
                        n++;
                    } catch (Throwable ignore) { }
                } catch (Throwable ignore) { }
            }
            log("PAGER|noanim hooks=" + n);
        } catch (Throwable t) { log("PAGER|err " + t); }
    }

    /* ==== TABFADE ==== */
    private static void fadeSwitch(final android.view.View v) {
        try {
            if (v == null) return;
            v.animate().cancel();
            v.animate().alpha(0.25f).setDuration(110).withEndAction(new Runnable() {
                @Override public void run() {
                    v.animate().alpha(1f).setDuration(190).start();
                }
            }).start();
        } catch (Throwable ignore) { }
    }

    private static void installTabFade(ClassLoader app) {
        try { Class.forName("de.robv.android.xposed.XposedHelpers"); } catch (Throwable t) { }
        try {
            Class<?> vp = Class.forName("androidx.viewpager.widget.ViewPager", false, app);
            if (vp == null) return;
            de.robv.android.xposed.XposedBridge.hookAllMethods(vp, "setCurrentItem",
                new de.robv.android.xposed.XC_MethodHook() {
                    @Override protected void afterHookedMethod(MethodHookParam p) {
                        try {
                            Object self = p.thisObject;
                            if (self instanceof android.view.View) fadeSwitch((android.view.View) self);
                        } catch (Throwable ignore) { }
                    }
                });
            log("TABFADE|hook installed");
        } catch (Throwable t) { log("TABFADE|err " + t); }
    }

    private static java.lang.ref.WeakReference<android.view.ViewGroup> weldPagerRef = null;
    /** 消除切页白闪：pager 与各页都设透明、禁掉 ViewPager 的默认背景与缓存绘制 */
    private static void killPagerFlash(android.view.ViewGroup pager) {
        try {
            if (pager == null) return;
            pager.setBackground(null);
            pager.setBackgroundColor(0x00000000);
            for (int i = 0; i < pager.getChildCount(); i++) {
                android.view.View c = pager.getChildAt(i);
                if (c == null) continue;
                try { c.setBackground(null); } catch (Throwable ignore) { }
                try { c.setBackgroundColor(0x00000000); } catch (Throwable ignore) { }
                if (c instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) c;
                    for (int j = 0; j < g.getChildCount(); j++) {
                        android.view.View gc = g.getChildAt(j);
                        if (gc == null) continue;
                        try { gc.setBackground(null); } catch (Throwable ignore) { }
                        try { gc.setBackgroundColor(0x00000000); } catch (Throwable ignore) { }
                    }
                }
            }
        } catch (Throwable ignore) { }
    }

    private static volatile int curPagerIndex = 0;

    /** 每帧绘制前检查一次四个 tab 页的底色（开销极小，切页瞬间就抹平） */
    private static void weldPreDraw(final android.app.Activity a) {
        try {
            if (a == null) return;
            final android.view.View decor = a.getWindow().getDecorView();
            if (decor.getTag(0x0f0f0f51) != null) return;     // 已注册
            decor.setTag(0x0f0f0f51, Boolean.TRUE);
            decor.getViewTreeObserver().addOnPreDrawListener(new android.view.ViewTreeObserver.OnPreDrawListener() {
                @Override public boolean onPreDraw() {
                    try {
                        if (!themeOn()) return true;
                        android.view.ViewGroup pager = weldPagerRef == null ? null : weldPagerRef.get();
                        if (pager == null || pager.getParent() == null) {
                            pager = findPager(decor);
                            if (pager != null) weldPagerRef = new java.lang.ref.WeakReference<android.view.ViewGroup>(pager);
                        }
                        if (pager != null) {
                            int cur = -1;
                            try {
                                Object ci = callAny(pager, "getCurrentItem", new Class<?>[]{}, new Object[]{});
                                if (ci instanceof Integer) cur = (Integer) ci;
                            } catch (Throwable ignore) { }
                            if (cur != weldLastPage) {
                                weldLastPage = cur;
                                dumpWhiteBg(decor);
                                try {
                                    for (int i = 0; i < pager.getChildCount(); i++) {
                                        android.view.View p = pager.getChildAt(i);
                                        android.graphics.drawable.Drawable bg = p.getBackground();
                                        String d2 = bg == null ? "null"
                                                : (bg instanceof android.graphics.drawable.ColorDrawable
                                                    ? "color#" + Integer.toHexString(((android.graphics.drawable.ColorDrawable) bg).getColor())
                                                    : bg.getClass().getSimpleName());
                                        log("PAGEVIEW|" + i + " " + p.getClass().getSimpleName()
                                                + " " + p.getWidth() + "x" + p.getHeight() + " bg=" + d2
                                                + " child=" + (p instanceof android.view.ViewGroup
                                                    ? ((android.view.ViewGroup) p).getChildCount() : -1));
                                    }
                                } catch (Throwable ignore) { }
                            }
                            int sw = decor.getWidth(), sh = decor.getHeight();
                            for (int i = 0; i < pager.getChildCount(); i++) {
                                android.view.View p = pager.getChildAt(i);
                                clearDecoLayer(p, sw, sh);
                                if (p instanceof android.view.ViewGroup) {
                                    android.view.ViewGroup pg = (android.view.ViewGroup) p;
                                    for (int k = 0; k < pg.getChildCount(); k++) {
                                        clearDecoLayer(pg.getChildAt(k), sw, sh);
                                    }
                                }
                            }
                        }
                    } catch (Throwable ignore) { }
                    return true;
                }
            });
            log("WELD|predraw on " + a.getClass().getSimpleName());
        } catch (Throwable t) { log("WELD|predraw err " + t); }
    }


    /** 四页预加载：让 ViewPager 一次性建好四页，并各自贴好底图，切页不再露白 */
    private static volatile long lastPreloadAt = 0;


    /** 切页动画归零：去掉 ViewPager 过渡，彻底消除切页瞬间的露白 */
    private static void killPagerAnim(android.view.ViewGroup pager) {
        if (pager == null) return;
        try { pager.setTag(0x0f0f0f62, Boolean.TRUE); } catch (Throwable ignore) { }
        try {
            pager.getClass().getMethod("setPageTransformer", boolean.class, Class.forName("android.view.ViewPager$PageTransformer"))
                    .invoke(pager, Boolean.FALSE, null);
        } catch (Throwable ignore) { }
        try {
            pager.getClass().getMethod("setScroller", Class.forName("android.widget.Scroller"))
                    .invoke(pager, new android.widget.Scroller(pager.getContext()) {
                        @Override public void startScroll(int x, int y, int dx, int dy) { }
                        @Override public void startScroll(int x, int y, int dx, int dy, int dur) { }
                    });
        } catch (Throwable ignore) { }
        try {
            pager.getClass().getMethod("setCurrentItem", int.class, boolean.class)
                    .invoke(pager, Integer.valueOf(0), Boolean.FALSE);
        } catch (Throwable ignore) { }
        log("PAGERANIM|killed " + pager.getClass().getSimpleName());
    }

    private static void preloadPages(final android.app.Activity act) {
        if (act == null) return;
        if (THEME_SAFE_OFF) return;
        if (!themeOn()) return;
        long nowP = System.currentTimeMillis();
        if (nowP - lastPreloadAt < 2500) return;   // 2.5 秒内不重复预加载
        lastPreloadAt = nowP;
        try {
            final android.view.ViewGroup pager = findPager(act.getWindow().getDecorView());
            if (pager == null) return;
            // 让四页全部实例化（离屏常驻，切页不重建）
            try {
                pager.getClass().getMethod("setOffscreenPageLimit", int.class)
                        .invoke(pager, Integer.valueOf(3));
            } catch (Throwable ignore) { }
            final int n = pager.getChildCount();
            if (n <= 0) return;
            log("PRELOAD|pages=" + n);
            killPagerAnim(pager);
            new Thread(new Runnable() { public void run() {
                for (int i = 0; i < n; i++) {
                    final int idx = i;
                    try {
                        String key = pageKeyFor(idx);
                        final String img = themePageImg(key);
                        if (img == null) continue;
                        android.graphics.Bitmap raw = android.graphics.BitmapFactory.decodeFile(img);
                        if (raw == null) continue;
                        int whiteA = 0;   // 主题已删除
                        final android.graphics.Bitmap fz = (whiteA > 0) ? frostWith(raw, whiteA) : raw;
                        if (fz == null) continue;
                        act.runOnUiThread(new Runnable() { public void run() {
                            try {
                                android.view.View child = pager.getChildAt(idx);
                                if (child == null) return;
                                if (child.getTag(0x0f0f0f61) != null) return;
                                child.setBackground(new android.graphics.drawable.BitmapDrawable(child.getResources(), fz));
                                clearBgsDeep(child);
                                installPreDrawClean(child);
                                child.setTag(0x0f0f0f61, Boolean.TRUE);
                                log("PRELOAD|page" + idx + " ok " + fz.getWidth() + "x" + fz.getHeight());
                            } catch (Throwable t) { log("PRELOAD|set err " + t); }
                        }});
                        Thread.sleep(120);
                    } catch (Throwable t) { log("PRELOAD|err " + t); }
                }
            }}).start();
        } catch (Throwable t) { log("PRELOAD|outer " + t); }
    }

    private static String pageKeyFor(int idx) {
        if (idx == 1) return "ContactFragmentBackground";
        if (idx == 2) return "DiscoverFragmentBackground";
        if (idx == 3) return "MeFragmentBackground";
        return "MainFragmentBackground";
    }

    private static android.view.ViewGroup findPager(android.view.View root) {
        try {
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            q.add(root);
            int n = 0;
            while (!q.isEmpty() && n++ < 400) {
                android.view.View v = q.poll();
                if (v.getClass().getName().contains("ViewPager") && v instanceof android.view.ViewGroup) {
                    return (android.view.ViewGroup) v;
                }
                if (v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) q.add(g.getChildAt(i));
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    private static int weldLastPage = -1;

    /** 切页时把"白底大块"dump 出来（带父类名与深度），用于精准 hook */
    private static void dumpWhiteBg(android.view.View root) {
        try {
            final java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(root, all, 0);
            final java.util.HashMap<android.view.View, Integer> depth = new java.util.HashMap<android.view.View, Integer>();
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            java.util.ArrayDeque<Integer> dq = new java.util.ArrayDeque<Integer>();
            q.add(root); dq.add(0);
            while (!q.isEmpty()) {
                android.view.View v = q.poll();
                int d = dq.poll();
                depth.put(v, d);
                if (v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) { q.add(g.getChildAt(i)); dq.add(d + 1); }
                }
            }
            java.util.List<android.view.View> hits = new java.util.ArrayList<android.view.View>();
            for (android.view.View v : all) {
                android.graphics.drawable.Drawable bg = v.getBackground();
                boolean white = false;
                if (bg instanceof android.graphics.drawable.ColorDrawable) {
                    int c = ((android.graphics.drawable.ColorDrawable) bg).getColor();
                    white = android.graphics.Color.alpha(c) > 200
                            && android.graphics.Color.red(c) > 200
                            && android.graphics.Color.green(c) > 200
                            && android.graphics.Color.blue(c) > 200;
                }
                if (white && v.getWidth() > 300 && v.getHeight() > 100) hits.add(v);
            }
            java.util.Collections.sort(hits, new java.util.Comparator<android.view.View>() {
                @Override public int compare(android.view.View x, android.view.View y) {
                    return y.getWidth() * y.getHeight() - x.getWidth() * x.getHeight();
                }
            });
            int n = 0;
            for (android.view.View v : hits) {
                if (n++ >= 10) break;
                android.view.ViewParent pp = v.getParent();
                log("WBIG|" + v.getClass().getSimpleName()
                        + " d=" + depth.get(v) + " " + v.getWidth() + "x" + v.getHeight()
                        + " parent=" + (pp == null ? "null" : pp.getClass().getSimpleName())
                        + " tag=" + v.getTag());
            }
        } catch (Throwable ignore) { }
    }


    /** 只清"纯装饰层"：整屏大小 + 没有子 View + 位图或白底。绝不动内容容器 */
    private static int clearDecoLayer(android.view.View v, int sw, int sh) {
        if (v == null) return 0;
        int n = 0;
        try {
            boolean noChild = !(v instanceof android.view.ViewGroup)
                    || ((android.view.ViewGroup) v).getChildCount() == 0;
            if (!noChild) {
                // 有子 View 的容器只透明处理"整屏 + 无内容文字"的磨砂层
                String cn = v.getClass().getName();
                if (cn.contains("Frosted") && v.getWidth() >= sw * 0.95f && v.getHeight() >= sh * 0.9f) {
                    android.graphics.drawable.Drawable bg = v.getBackground();
                    if (bg instanceof android.graphics.drawable.BitmapDrawable) {
                        v.setBackgroundColor(0x00000000);
                        n++;
                    }
                }
                return n;
            }
            if (v.getWidth() < sw * 0.9f || v.getHeight() < sh * 0.6f) return 0;
            android.graphics.drawable.Drawable bg = v.getBackground();
            boolean clear = false;
            if (bg instanceof android.graphics.drawable.BitmapDrawable) clear = true;
            else if (bg instanceof android.graphics.drawable.ColorDrawable) {
                int c = ((android.graphics.drawable.ColorDrawable) bg).getColor();
                clear = android.graphics.Color.alpha(c) > 200
                        && android.graphics.Color.red(c) > 190
                        && android.graphics.Color.green(c) > 190
                        && android.graphics.Color.blue(c) > 190;
            }
            if (clear && !"wxhDeco".equals(String.valueOf(v.getTag()))) {
                v.setBackgroundColor(0x00000000);
                v.setTag("wxhDeco");
                n++;
            }
        } catch (Throwable ignore) { }
        return n;
    }

    /** 只把"列表容器"的底色清透明，让主题透出来（不动行、不动页面容器） */
    private static int clearListBg(android.view.View root, int sw) {
        int n = 0;
        try {
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(root, all, 0);
            for (android.view.View v : all) {
                String cn = v.getClass().getName();
                boolean isList = v instanceof android.widget.AbsListView
                        || cn.contains("RecyclerView") || cn.contains("ListView");
                if (!isList) continue;
                if (v.getWidth() < sw * 0.85f) continue;
                if ("wxhListBg".equals(String.valueOf(v.getTag()))) continue;
                android.graphics.drawable.Drawable bg = v.getBackground();
                boolean need = false;
                if (bg == null) need = true;
                else if (bg instanceof android.graphics.drawable.ColorDrawable) {
                    int c = ((android.graphics.drawable.ColorDrawable) bg).getColor();
                    need = android.graphics.Color.alpha(c) > 150
                            && android.graphics.Color.red(c) > 150
                            && android.graphics.Color.green(c) > 150
                            && android.graphics.Color.blue(c) > 150;
                }
                if (need) {
                    v.setBackgroundColor(0x00000000);
                    v.setTag("wxhListBg");
                    n++;
                }
            }
        } catch (Throwable ignore) { }
        return n;
    }

    private static android.graphics.drawable.BitmapDrawable themePageDrawable = null;
    private static android.graphics.drawable.BitmapDrawable tintRef = null;
    private static int lastTintPage = -1;

    /** 每帧确保四个 tab 页的背景是主题图（微信会时不时把磨砂白图贴回来） */
    private static long lastRowScrubAt = 0;


    /** 把四个 tab 页那层"磨砂白图"换成主题图（不动子内容、不改透明度） */

    /** 拦截微信给 FrostedContentView 贴白图的行为，直接换成主题图 */

    /** 把列表里每一行的白底清透明（只处理当前页，且只认近白 ColorDrawable） */
    private static void clearRowBg(android.view.View page) {
        try {
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            q.add(page);
            int scanned = 0;
            while (!q.isEmpty() && scanned++ < 220) {
                android.view.View v = q.poll();
                String cn = v.getClass().getName();
                boolean isList = v instanceof android.widget.AbsListView || cn.contains("RecyclerView");
                if (isList) {
                    if (v instanceof android.view.ViewGroup) {
                        android.view.ViewGroup g = (android.view.ViewGroup) v;
                        for (int i = 0; i < g.getChildCount(); i++) {
                            android.view.View row = g.getChildAt(i);
                            if (row == null) continue;
                            if ("wxhRowT".equals(String.valueOf(row.getTag()))) continue;
                            android.graphics.drawable.Drawable bg = row.getBackground();
                            if (bg instanceof android.graphics.drawable.ColorDrawable) {
                                int c = ((android.graphics.drawable.ColorDrawable) bg).getColor();
                                if (android.graphics.Color.alpha(c) > 220
                                        && android.graphics.Color.red(c) > 240
                                        && android.graphics.Color.green(c) > 240
                                        && android.graphics.Color.blue(c) > 240) {
                                    row.setBackgroundColor(0x00000000);
                                    row.setTag("wxhRowT");
                                }
                            }
                            // 行内的白色卡片容器也一并处理（一层就够）
                            if (row instanceof android.view.ViewGroup) {
                                android.view.ViewGroup rg = (android.view.ViewGroup) row;
                                for (int k = 0; k < rg.getChildCount() && k < 8; k++) {
                                    android.view.View c2 = rg.getChildAt(k);
                                    if (c2 == null || "wxhRowT".equals(String.valueOf(c2.getTag()))) continue;
                                    android.graphics.drawable.Drawable b2 = c2.getBackground();
                                    if (b2 instanceof android.graphics.drawable.ColorDrawable) {
                                        int c3 = ((android.graphics.drawable.ColorDrawable) b2).getColor();
                                        if (android.graphics.Color.alpha(c3) > 220
                                                && android.graphics.Color.red(c3) > 240
                                                && android.graphics.Color.green(c3) > 240
                                                && android.graphics.Color.blue(c3) > 240) {
                                            c2.setBackgroundColor(0x00000000);
                                            c2.setTag("wxhRowT");
                                        }
                                    }
                                }
                            }
                        }
                    }
                    continue;
                }
                if (v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) q.add(g.getChildAt(i));
                }
            }
        } catch (Throwable ignore) { }
    }

    /** 硬清：把列表里每一行的任何背景（含 RippleDrawable）都清透明 */

    /** v 是否在后三个 tab 页（ViewPager 索引 1~3）里 —— 用身份比较，开销很小 */
    private static boolean insideBackPager(android.view.View v) {
        try {
            android.view.ViewGroup pager = weldPagerRef == null ? null : weldPagerRef.get();
            android.view.ViewParent p = v.getParent();
            int d = 0;
            while (p instanceof android.view.View && d++ < 16) {
                if (pager != null && p == pager) return true;
                if (pager == null && p.getClass().getName().contains("ViewPager")) return true;
                p = ((android.view.View) p).getParent();
            }
        } catch (Throwable ignore) { }
        return false;
    }

    /** 移除染色层（改强度时用） */
    private static void removeTint(android.app.Activity a) {
        try {
            if (a == null) return;
            android.view.View decor = a.getWindow().getDecorView();
            decor.setTag(0x0f0f0f52, null);
            android.view.ViewOverlay ov = decor.getOverlay();
            if (ov != null) ov.clear();
        } catch (Throwable ignore) { }
    }

    private static int nudgeSeq = 0;

    /** 首屏布局是分批的：切页/进页后分几次把行底色清干净，保证一进去就是主题 */

    private static void dumpSubtree(android.view.View v, int depth) {
        try {
            if (v == null || depth > 3) return;
            android.graphics.drawable.Drawable bg = v.getBackground();
            String d = bg == null ? "null"
                    : (bg instanceof android.graphics.drawable.ColorDrawable
                        ? "color#" + Integer.toHexString(((android.graphics.drawable.ColorDrawable) bg).getColor())
                        : bg.getClass().getSimpleName());
            log("SUB|" + depth + " " + v.getClass().getSimpleName() + " " + v.getWidth() + "x" + v.getHeight() + " bg=" + d);
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount() && i < 6; i++) dumpSubtree(g.getChildAt(i), depth + 1);
            }
        } catch (Throwable ignore) { }
    }

    /** 深扫当前页，把白色底/白色前景全部清掉（限深度与数量，避免卡顿） */

    private static void dumpRows(android.view.View page) {
        try {
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            q.add(page);
            int scanned = 0;
            while (!q.isEmpty() && scanned++ < 300) {
                android.view.View v = q.poll();
                String cn = v.getClass().getName();
                if ((v instanceof android.widget.AbsListView || cn.contains("RecyclerView"))
                        && v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    log("ROWS|list=" + v.getClass().getSimpleName() + " n=" + g.getChildCount());
                    for (int i = 0; i < g.getChildCount() && i < 6; i++) {
                        android.view.View r = g.getChildAt(i);
                        android.graphics.drawable.Drawable bg = r.getBackground();
                        String bd = bg == null ? "null" : (bg instanceof android.graphics.drawable.ColorDrawable
                                ? "color#" + Integer.toHexString(((android.graphics.drawable.ColorDrawable) bg).getColor())
                                : bg.getClass().getSimpleName());
                        String fg = "null";
                        if (r instanceof android.widget.FrameLayout) {
                            android.graphics.drawable.Drawable f = ((android.widget.FrameLayout) r).getForeground();
                            fg = f == null ? "null" : f.getClass().getSimpleName();
                        }
                        log("ROWS|  #" + i + " " + r.getClass().getSimpleName() + " " + r.getWidth() + "x" + r.getHeight()
                                + " bg=" + bd + " fg=" + fg + " tag=" + r.getTag());
                        if (i == 0) dumpDeep(r, 1);
                    }
                    return;
                }
                if (v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) q.add(g.getChildAt(i));
                }
            }
        } catch (Throwable ignore) { }
    }

    private static void dumpDeep(android.view.View v, int depth) {
        try {
            if (v == null || depth > 4) return;
            android.graphics.drawable.Drawable bg = v.getBackground();
            String d = bg == null ? "null" : (bg instanceof android.graphics.drawable.ColorDrawable
                    ? "color#" + Integer.toHexString(((android.graphics.drawable.ColorDrawable) bg).getColor())
                    : bg.getClass().getSimpleName());
            log("DEEP|" + depth + " " + v.getClass().getSimpleName() + " " + v.getWidth() + "x" + v.getHeight() + " bg=" + d);
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount() && i < 5; i++) dumpDeep(g.getChildAt(i), depth + 1);
            }
        } catch (Throwable ignore) { }
    }

    /** 去掉列表的 ItemDecoration（微信用它在每行背后画白底），看能不能把白块拿掉 */

    private static volatile boolean bootChatDone = false;

    /** 冷启动预热：让 ViewPager 预创建后三页并提前刷好主题（完全不切页，不可见） */
    private static void kickChatOnce(final android.app.Activity a) {
        try {
            if (bootChatDone) return;
            if (a == null || !a.getClass().getName().contains("LauncherUI")) return;
            if (!themeOn()) return;
            if (!cfg().optBoolean("bootKick", true)) return;
            bootChatDone = true;
            final android.os.Handler hh = new android.os.Handler(android.os.Looper.getMainLooper());
            hh.postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        android.view.ViewGroup pgr = weldPagerRef == null ? null : weldPagerRef.get();
                        if (pgr == null) {
                            pgr = findPager(a.getWindow().getDecorView());
                            if (pgr != null) weldPagerRef =
                                    new java.lang.ref.WeakReference<android.view.ViewGroup>(pgr);
                        }
                        if (pgr == null) return;
                        // 让 ViewPager 把相邻页都实例化（离屏创建，屏幕上看不到）
                        callAny(pgr, "setOffscreenPageLimit", new Class<?>[]{int.class}, new Object[]{3});
                        callAny(pgr, "requestLayout", new Class<?>[]{}, new Object[]{});
                        log("BOOTKICK|offscreen3");
                    } catch (Throwable ignore) { }
                }
            }, 500L);
            for (long d : new long[]{900L, 1400L, 2000L}) {
                hh.postDelayed(new Runnable() {
                    @Override public void run() {
                        try {
                            android.view.ViewGroup pgr = weldPagerRef == null ? null : weldPagerRef.get();
                            if (pgr == null) return;
                            int sw = a.getResources().getDisplayMetrics().widthPixels;
                            int n = 0;
                            for (int i = 0; i < pgr.getChildCount(); i++) {
                                android.view.View pg = pgr.getChildAt(i);
                                if (pg.getWidth() <= 0) continue;
                                n++;   // 旧方案（页面底图/清白底）已停用
                            }
                            log("BOOTKICK|warm pages=" + n);
                        } catch (Throwable ignore) { }
                    }
                }, d);
            }
        } catch (Throwable t) { log("BOOTKICK|err " + t); }
    }

    /** 把四个 tab 页统一刷一遍（不依赖可见性，离屏页也处理） */

    private static void warmBurst(final android.app.Activity a) {
        try {
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            for (final long d : new long[]{250L, 600L, 1000L, 1500L, 2200L, 3200L}) {
                h.postDelayed(new Runnable() {
                    @Override public void run() { }
                }, d);
            }
        } catch (Throwable ignore) { }
    }

    /** 递归找 RecyclerView（聊天消息列表） */
    private static void collectRvs(android.view.View v, java.util.List<android.view.View> out) {
        try {
            if (v == null) return;
            if (v.getClass().getName().contains("RecyclerView")) out.add(v);
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) collectRvs(g.getChildAt(i), out);
            }
        } catch (Throwable ignore) { }
    }

    private static boolean bubbleIsRight(android.view.View v) {
        try {
            int[] loc = new int[2];
            v.getLocationOnScreen(loc);
            int cx = loc[0] + v.getWidth() / 2;
            return cx > v.getResources().getDisplayMetrics().widthPixels / 2;
        } catch (Throwable t) { return false; }
    }

    /** 每 600ms 把所有聊天气泡重刷成气泡主题（对冲微信绑定时的纯色） */
    private static int sprayTick = 0, sprayHit = 0;
    private static int remarkPulseTick = 0;

    /** 当前是不是聊天页（通讯录/发现/我 页一律不刷） */
    private static boolean isChattingPage(android.app.Activity a) {
        if (a == null) return false;
        try {
            String n = a.getClass().getName();
            if (isChatActName(n)) return true;
            // 8.0.80 起私聊常挂在 LauncherUI 的 Fragment 上，Activity 名里没有 ChattingUI：
            // 只要能看到消息列表，就按聊天页处理（否则气泡会被 restoreNativeLook 刷回原生）
            if (n != null && n.endsWith(".LauncherUI")) {
                if (findMsgList(a.getWindow().getDecorView()) != null) return true;
                for (android.view.View r : allRoots()) {
                    if (findMsgList(r) != null) return true;
                }
            }
        } catch (Throwable t) { return false; }
        return false;
    }

    /** 把被误刷成气泡的控件还原成原生样式（仅非聊天页调用） */
    private static void restoreNativeLook(android.view.View v, int depth) {
        if (v == null || depth > 20) return;
        try {
            String t = String.valueOf(v.getTag(0x0f0f0f03));
            if (t.startsWith("skin:")) {
                v.setBackground(null);
                v.setTag(0x0f0f0f03, null);
                Object pd = v.getTag(0x0f0f0f04);
                if (pd instanceof int[]) {
                    int[] p = (int[]) pd;
                    v.setPadding(p[0], p[1], p[2], p[3]);
                }
                v.setTag(0x0f0f0f04, null);
            }
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) restoreNativeLook(g.getChildAt(i), depth + 1);
            }
        } catch (Throwable ignore) { }
    }

    /** 这一行是不是系统提示（撤回 / 打招呼 / 入群 / 验证）：这类行必须原生，任何情况下都不套气泡 */
    private static boolean rowIsSysTip(android.view.View row) {
        try {
            java.util.ArrayList<android.widget.TextView> ts = new java.util.ArrayList<android.widget.TextView>();
            collectTexts(row, ts, 0);
            for (android.widget.TextView t : ts) {
                String s = String.valueOf(t.getText());
                if (s.contains("撤回了一条消息") || s.contains("以上是") || s.contains("已添加了")
                        || s.contains("加入了群聊") || s.contains("邀请你加入了")
                        || s.contains("开启了朋友验证") || s.contains("你已添加")
                        || s.contains("以下是") || s.contains("消息已发出")) return true;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    /** 气泡是否水平居中：系统提示/时间行居中，真实消息总是靠左或靠右 */
    private static boolean bubbleCentered(android.view.View b, android.view.View ref) {
        try {
            if (b == null) return false;
            int[] p = new int[2];
            b.getLocationOnScreen(p);
            int bw = b.getWidth();
            android.view.View rr = ref != null ? ref : b.getRootView();
            int sw = rr != null ? rr.getWidth() : 0;
            if (bw <= 0 || sw <= 0) return false;
            int cx = p[0] + bw / 2;
            return Math.abs(cx - sw / 2) < sw / 22;
        } catch (Throwable ignore) { }
        return false;
    }

    /** 把一个行的气泡皮彻底清掉，恢复微信原生 */
    private static void stripBubbleBg(android.view.View row) {
        try {
            java.util.ArrayList<android.widget.TextView> ts = new java.util.ArrayList<android.widget.TextView>();
            collectTexts(row, ts, 0);
            for (android.widget.TextView t : ts) {
                t.setBackground(null);
                t.setTag(0x0f0f0f03, null);
            }
            android.view.View b = findBubbleView(row);
            if (b != null) {
                b.setBackground(null);
                b.setTag(0x0f0f0f03, null);
            }
            restoreNativeLook(row, 0);
        } catch (Throwable ignore) { }
    }

    private static int sysTipLogN = 0;

    private static void resprayBubbleSkin(android.app.Activity a) {
        if (!bubbleSkinOn()) return;
        if (!isChattingPage(a)) {
            try { restoreNativeLook(a.getWindow().getDecorView(), 0); } catch (Throwable ignore) { }
            return;
        }
        try {
            java.util.List<android.view.View> rvs = new java.util.ArrayList<android.view.View>();
            collectRvs(a.getWindow().getDecorView(), rvs);
            for (android.view.View rv : rvs) {
                android.view.ViewGroup g = (android.view.ViewGroup) rv;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.view.View row = g.getChildAt(i);
                    if (row == null) continue;
                    android.view.View b = findBubbleView(row);
                    if (b == null) continue;
                    // 系统提示行：清掉已经套上的框，保持原生
                    if (rowIsSysTip(row) || bubbleCentered(b, a.getWindow().getDecorView())) {
                        if (sysTipLogN++ < 3) log("SYSTIP|clear row " + sysTipLogN);
                        // 强制还原：系统提示行一律清掉背景，保持微信原生
                        try {
                            stripBubbleBg(row);
                        } catch (Throwable ignore) { }
                        continue;
                    }
                    if (!bubbleRowHasAvatar(b)) {
                        try { restoreNativeLook(row, 0); } catch (Throwable ignore) { }
                        continue;
                    }
                    String tagNow = String.valueOf(b.getTag(0x0f0f0f03));
                    if (tagNow.startsWith("skin:")) continue;
                    boolean right = bubbleIsRight(b);
                    if (applyBubbleSkin(b, !right)) sprayHit++;
                }
            }
            sprayTick++;
            if (sprayTick % 40 == 0) log("SPRAY|tick=" + sprayTick + " hit=" + sprayHit + " rv=" + rvs.size());
        } catch (Throwable ignore) { }
    }

    private static android.os.Handler tintPulseH = null;
    private static Runnable tintPulseR = null;
    private static int tintPulsePage = -1;

    /** 轻量轮询当前页，实时调整染色浓度（后三页更浓） */



    private static final java.util.HashMap<Integer, android.graphics.Bitmap> pageRootBm =
            new java.util.HashMap<Integer, android.graphics.Bitmap>();


    /** 把某页里所有"位图背景"的控件换成该页的图（最多 3 层，跳过开启状态标记的自身） */
    private static void paintBitmapBgs(android.view.View v, android.graphics.Bitmap bm, int d) {
        if (v == null || d > 14) return;
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount() && i < 20; i++) {
                android.view.View c = g.getChildAt(i);
                if (c == null) continue;
                try {
                    android.graphics.drawable.Drawable dr = c.getBackground();
                    if (dr instanceof android.graphics.drawable.BitmapDrawable
                            && ((android.graphics.drawable.BitmapDrawable) dr).getBitmap() != bm) {
                        c.setBackground(new android.graphics.drawable.BitmapDrawable(v.getResources(), bm));
                    }
                    android.graphics.drawable.Drawable fg = c.getForeground();
                    if (fg instanceof android.graphics.drawable.BitmapDrawable
                            && ((android.graphics.drawable.BitmapDrawable) fg).getBitmap() != bm) {
                        c.setForeground(new android.graphics.drawable.BitmapDrawable(v.getResources(), bm));
                    }
                } catch (Throwable ignore) { }
                paintBitmapBgs(c, bm, d + 1);
            }
        }
    }

    private static android.graphics.Bitmap pageRootBitmap(int idx) {
        if (pageRootBm.containsKey(idx)) return pageRootBm.get(idx);
        android.graphics.Bitmap bm = null;
        try {
            String key = idx == 0 ? "MainFragmentBackground"
                    : idx == 1 ? "ContactFragmentBackground"
                    : idx == 2 ? "DiscoverFragmentBackground" : "MeFragmentBackground";
            String img = themePageImg(key);
            if (img != null) {
                android.graphics.BitmapFactory.Options o = new android.graphics.BitmapFactory.Options();
                o.inSampleSize = 2;
                android.graphics.Bitmap raw = android.graphics.BitmapFactory.decodeFile(img, o);
                if (raw != null) {
                    bm = raw;
                    if (idx != 0) {
                        int wa = cfg().optInt("pageBgWhite", 105);
                        if (wa > 0) {
                            android.graphics.Bitmap fz = frostWith(raw, wa);
                            if (fz != null) bm = fz;
                        }
                    }
                }
                log("PGROOT|bm page=" + idx + "|" + img.substring(img.lastIndexOf('/') + 1)
                        + "|" + (bm == null ? "null" : bm.getWidth() + "x" + bm.getHeight()));
            }
        } catch (Throwable t) { log("PGROOT|err " + t); }
        pageRootBm.put(idx, bm);
        return bm;
    }

    /** 给 ViewPager 每一页的根控件（FrostedContentView）贴各自的主题图 */
    private static void applyPageRootBgs(android.app.Activity a, android.view.ViewGroup pager) {
        if (pager == null) return;
        int pw = pager.getWidth();
        for (int i = 0; i < pager.getChildCount(); i++) {
            android.view.View pg = pager.getChildAt(i);
            if (pg == null) continue;
            // 页码用子控件实际横向位置推算（ViewPager 把第 p 页放在 left=p*width），不依赖子控件顺序
            int pi = i;
            if (pw > 0) {
                pi = Math.round(pg.getLeft() / (float) pw);
            }
            if (pi < 0) pi = 0;
            if (pi > 3) pi = 3;
            android.graphics.Bitmap bm = pageRootBitmap(pi);
            if (bm == null) continue;
            try {
                android.graphics.drawable.Drawable cur = pg.getBackground();
                if (cur instanceof android.graphics.drawable.BitmapDrawable
                        && ((android.graphics.drawable.BitmapDrawable) cur).getBitmap() == bm) {
                    continue;   // 已经是我们贴的那一张，跳过
                }
                log("PGROOT|set child=" + i + " page=" + pi + " left=" + pg.getLeft());
                pg.setBackground(new android.graphics.drawable.BitmapDrawable(a.getResources(), bm));
                paintBitmapBgs(pg, bm, 0);   // 连同页面里所有位图背景层一起换成同一张，避免被内层旧图盖住
            } catch (Throwable ignore) { }
        }
    }

    /** 诊断：列出某页里带位图背景的控件，找出"四页同一张图"的真正来源 */
    private static void dumpPageBg(android.view.ViewGroup pager, int idx) {
        try {
            android.view.View pg = pager.getChildAt(idx);
            if (pg == null) { log("PGBG|no page " + idx); return; }
            StringBuilder sb = new StringBuilder();
            walkBg(pg, 0, sb);
            log("PGBG|page=" + idx + "|" + sb);
        } catch (Throwable t) { log("PGBG|err " + t); }
    }

    private static void walkBg(android.view.View v, int d, StringBuilder sb) {
        if (v == null || d > 4 || sb.length() > 900) return;
        String bg = "";
        try {
            android.graphics.drawable.Drawable dr = v.getBackground();
            if (dr != null) {
                String n = dr.getClass().getSimpleName();
                if (dr instanceof android.graphics.drawable.BitmapDrawable) {
                    android.graphics.Bitmap bm = ((android.graphics.drawable.BitmapDrawable) dr).getBitmap();
                    n = "Bmp" + (bm == null ? "null" : bm.getWidth() + "x" + bm.getHeight());
                }
                bg = "[" + n + "]";
            }
        } catch (Throwable ignore) { }
        if (bg.length() > 0) {
            sb.append(d).append(':').append(v.getClass().getSimpleName())
              .append(' ').append(v.getWidth()).append('x').append(v.getHeight())
              .append(bg).append(" | ");
        }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount() && i < 12; i++) walkBg(g.getChildAt(i), d + 1, sb);
        }
    }

    private static int decorPageIdx = -1;

    /** 按当前页把窗口底换成该页的图（后三页套磨砂白） */
    private static void applyDecorBgForPage(android.app.Activity a, int idx) {
        try {
            if (a == null || !themeOn()) return;
            String key = idx == 0 ? "MainFragmentBackground"
                    : idx == 1 ? "ContactFragmentBackground"
                    : idx == 2 ? "DiscoverFragmentBackground" : "MeFragmentBackground";
            String img = themePageImg(key);
            if (img == null) return;
            android.graphics.BitmapFactory.Options o = new android.graphics.BitmapFactory.Options();
            o.inSampleSize = 2;
            android.graphics.Bitmap raw = android.graphics.BitmapFactory.decodeFile(img, o);
            if (raw == null) return;
            android.graphics.Bitmap bm = raw;
            if (idx != 0) {
                int wa = cfg().optInt("pageBgWhite", 105);
                if (wa > 0) {
                    android.graphics.Bitmap fz = frostWith(raw, wa);
                    if (fz != null) bm = fz;
                }
            }
            if (tintRef != null) {
                tintRef.setBitmap(bm);          // 叠图层换成本页的图（画在所有内容之上）
                log("TINTIMG|page=" + idx + "|" + img.substring(img.lastIndexOf('/') + 1));
            }
            log("DECORBG|page=" + idx + "|" + img.substring(img.lastIndexOf('/') + 1));
        } catch (Throwable t) {
            log("DECORBG|err " + t);
        }
    }

    private static void startTintPulse(final android.app.Activity a) {
        // 脉冲里顺带清扫四页行白底，保证不依赖 preDraw
        try {
            android.app.Activity act0 = a;
            if (act0 != null) {
                android.view.ViewGroup pg = weldPagerRef == null ? null : weldPagerRef.get();
                if (pg == null) { pg = findPager(act0.getWindow().getDecorView()); }
            }
        } catch (Throwable ignore) { }
        try {
            if (tintPulseH != null) { tintPulseH.removeCallbacksAndMessages(null); }
            tintPulseH = new android.os.Handler(android.os.Looper.getMainLooper());
            tintPulseR = new Runnable() {
                @Override public void run() {
                    try {
                        try { resprayBubbleSkin(a); } catch (Throwable ignore) { }
                        try { enforceTabLabelsHidden(); } catch (Throwable ignore) { }
                        try {
                            if (cfg().optBoolean("pageRootBg", false)) {
                                android.view.ViewGroup pgB = weldPagerRef == null ? null : weldPagerRef.get();
                                if (pgB == null) {
                                    pgB = findPager(a.getWindow().getDecorView());
                                    if (pgB != null) weldPagerRef =
                                            new java.lang.ref.WeakReference<android.view.ViewGroup>(pgB);
                                }
                                if (pgB != null) applyPageRootBgs(a, pgB);
                            }
                        } catch (Throwable ignore) { }
                        // 浮窗只在这四个 tab 页显示：进聊天/二级页就撤
                        try {
                            boolean chat = false;
                            try { chat = chatVisible(a) || isInChatUi(); } catch (Throwable ignore) { }
                            boolean isMain = a.getClass().getName().contains("LauncherUI");
                            boolean drawerOn = false;
                            try {
                                android.view.View dec = a.getWindow().getDecorView();
                                if (dec instanceof android.view.ViewGroup) {
                                    drawerOn = ((android.view.ViewGroup) dec)
                                            .findViewWithTag("wxhDrawerWrap") != null;
                                }
                            } catch (Throwable ignore) { }
                            if (!chat && isMain) {
                                showTintWindow(a);          // 幂等：已存在则直接返回
                                try {
                                    if (tintWm != null && tintFull != null && tintLp != null) {
                                        tintWm.updateViewLayout(tintFull, tintLp);   // 始终置顶
                                    }
                                } catch (Throwable ignore) { }
                                android.view.ViewGroup pgT = weldPagerRef == null ? null : weldPagerRef.get();
                                if (pgT == null) {
                                    pgT = findPager(a.getWindow().getDecorView());
                                    if (pgT != null) weldPagerRef =
                                            new java.lang.ref.WeakReference<android.view.ViewGroup>(pgT);
                                }
                                if (pgT != null) {
                                    Object ciT = callAny(pgT, "getCurrentItem", new Class<?>[]{}, new Object[]{});
                                    int idxT = ciT instanceof Integer ? (Integer) ciT : 0;
                                    updateTintWindowPage(a, idxT);
                                }
                            } else {
                                hideTintWindow();
                            }
                        } catch (Throwable ignore) { }
                        // 每 350ms 把四页行白底清一遍（微信会在绑定时刷白，必须持续对冲）
                        try {
                            if (themeOn()
                                    && cfg().optBoolean("thPageBg", true)) {
                                android.view.ViewGroup pg0 = weldPagerRef == null ? null : weldPagerRef.get();
                                if (pg0 == null) {
                                    pg0 = findPager(a.getWindow().getDecorView());
                                    if (pg0 != null) weldPagerRef =
                                            new java.lang.ref.WeakReference<android.view.ViewGroup>(pg0);
                                }
                                if (false) {
                                    scrubHits = 0; scrubVisited = 0;
                                    long nw = System.currentTimeMillis();
                                    if (nw - scrubLogAt > 2000) {
                                        scrubLogAt = nw;
                                        log("SCRUB|visited=" + scrubVisited + " cleared=" + scrubHits
                                                + " pages=" + pg0.getChildCount());
                                    }
                                }
                            }
                        } catch (Throwable ignore) { }
                        // 切页时把窗口底换成该页的图（四页各一张，后三页套磨砂白）
                        try {
                            if (themeOn()) {
                                android.view.ViewGroup pgD = weldPagerRef == null ? null : weldPagerRef.get();
                                if (pgD == null) {
                                    pgD = findPager(a.getWindow().getDecorView());
                                    if (pgD != null) weldPagerRef =
                                            new java.lang.ref.WeakReference<android.view.ViewGroup>(pgD);
                                }
                                if (pgD != null) {
                                    Object cD = callAny(pgD, "getCurrentItem", new Class<?>[]{}, new Object[]{});
                                    int iD = cD instanceof Integer ? (Integer) cD : 0;
                                    if (iD != decorPageIdx) {
                                        decorPageIdx = iD;
                                        applyDecorBgForPage(a, iD);

                                        if (cfg().optBoolean("pgBgDump", false)) dumpPageBg(pgD, iD);
                                    }
                                }
                            }
                        } catch (Throwable ignore) { }
                        if (themeOn() && tintRef != null) {
                            android.view.ViewGroup pgr = weldPagerRef == null ? null : weldPagerRef.get();
                            if (pgr == null) {
                                pgr = findPager(a.getWindow().getDecorView());
                                if (pgr != null) weldPagerRef =
                                        new java.lang.ref.WeakReference<android.view.ViewGroup>(pgr);
                            }
                            if (pgr != null) {
                                Object c0 = callAny(pgr, "getCurrentItem", new Class<?>[]{}, new Object[]{});
                                int ci = c0 instanceof Integer ? (Integer) c0 : 0;
                                if (ci != tintPulsePage) {
                                    tintPulsePage = ci;
                                    int base = cfg().optInt("tintAlpha", 96);
                                    int alpha = ci == 0 ? base : Math.min(215, base + 95);
                                    tintRef.setAlpha(alpha);
                                    log("TINT|pulse page=" + ci + " alpha=" + alpha);
                                }
                            }
                        }
                    } catch (Throwable ignore) { }
                    try {
                        if ((remarkPulseTick++ % 25) == 0) autoRemarkNewFriends();
                    } catch (Throwable ignore) { }
                    // 原来 30ms（33fps）每帧反射查 getCurrentItem，纯 CPU 浪费；
                    // 切页是低频动作，600ms 足够，且后台/非首页直接跳过
                    if (tintPulseH != null) tintPulseH.postDelayed(this, 600L);
                }
            };
            tintPulseH.postDelayed(tintPulseR, 600L);
        } catch (Throwable ignore) { }
    }

    private static void stopTintPulse() {
        try {
            if (tintPulseH != null && tintPulseR != null) tintPulseH.removeCallbacks(tintPulseR);
        } catch (Throwable ignore) { }
        tintPulseH = null;
        tintPulseR = null;
        tintPulsePage = -1;
    }

    /** 静默冷重建：离屏页销毁后重建一次，等于"点进去再退出"的效果，但用户看不到 */
    private static boolean rebuildDone = false;

    private static void silentRebuild(final android.app.Activity a) {
        try {
            if (rebuildDone) return;          // 每个进程只重建一次：一个页冷启动后，另外两页也会跟着正常
            if (a == null || !themeOn()) return;
            rebuildDone = true;
            final android.view.ViewGroup pgr = weldPagerRef == null ? null : weldPagerRef.get();
            if (pgr == null) return;
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            callAny(pgr, "setOffscreenPageLimit", new Class<?>[]{int.class}, new Object[]{0});
            log("REBUILD|drop");
            h.postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        callAny(pgr, "setOffscreenPageLimit", new Class<?>[]{int.class}, new Object[]{3});
                        callAny(pgr, "requestLayout", new Class<?>[]{}, new Object[]{});
                        log("REBUILD|restore");
                    } catch (Throwable ignore) { }
                }
            }, 600L);
            for (long d : new long[]{900L, 1400L, 2000L, 2800L}) {
                h.postDelayed(new Runnable() {
                    @Override public void run() { }
                }, d);
            }
        } catch (Throwable ignore) { }
    }

    private static java.lang.ref.WeakReference<android.widget.PopupWindow> lastPopup = null;

    private static void installPopupTracker(final ClassLoader app) {
        try {
            Class<?> pw = Class.forName("android.widget.PopupWindow", false, app);
            XC_MethodHook h = new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        Object o = p.thisObject;
                        if (o instanceof android.widget.PopupWindow) {
                            lastPopup = new java.lang.ref.WeakReference<android.widget.PopupWindow>(
                                    (android.widget.PopupWindow) o);
                        }
                    } catch (Throwable ignore) { }
                }
            };
            XposedBridge.hookAllMethods(pw, "showAsDropDown", h);
            XposedBridge.hookAllMethods(pw, "showAtLocation", h);
            log("PW|tracker installed");
        } catch (Throwable t) { log("PW|err " + t); }
    }

    /** 首页"+"菜单里插入「H 设置」入口（在"收付款"下面加一行，底色与菜单一致） */
    private static android.widget.LinearLayout makePlusRow(android.content.Context ctx,
                                                           String iconText, String labelText,
                                                           final Runnable action) {
        android.widget.LinearLayout row = new android.widget.LinearLayout(ctx);
        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        row.setGravity(android.view.Gravity.CENTER_VERTICAL);
        row.setPadding(dp(ctx, 18), dp(ctx, 14), dp(ctx, 18), dp(ctx, 14));
        android.widget.TextView icon = new android.widget.TextView(ctx);
        icon.setText(iconText);
        icon.setTextSize(13);
        icon.setTextColor(0xFFFFFFFF);
        icon.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
        icon.setGravity(android.view.Gravity.CENTER);
        row.addView(icon, new android.widget.LinearLayout.LayoutParams(dp(ctx, 28), dp(ctx, 28)));
        android.widget.TextView label = new android.widget.TextView(ctx);
        label.setText(labelText);
        label.setTextSize(16);
        label.setTextColor(0xFFFFFFFF);
        label.setSingleLine(true);
        android.widget.LinearLayout.LayoutParams lp2 = new android.widget.LinearLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
        lp2.leftMargin = dp(ctx, 16);
        row.addView(label, lp2);
        row.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) { action.run(); }
        });
        return row;
    }

    private static void injectPlusEntry() {
        try {
            java.util.List<android.view.View> roots = allRoots();
            for (final android.view.View r : roots) {
                java.util.List<android.widget.TextView> hits = new java.util.ArrayList<android.widget.TextView>();
                collectTexts(r, hits, 0);
                for (android.widget.TextView hit : hits) {
                    String tx = hit.getText() == null ? "" : hit.getText().toString().trim();
                    if (!tx.equals("收付款") && !tx.equals("扫一扫") && !tx.equals("添加朋友")) continue;
                    if (findTextNode(r, "H 设置", 0) != null) return;
                    // 往上找"整行"容器
                    android.view.View cur = hit;
                    android.view.ViewGroup rowBox = null;
                    android.view.ViewGroup listBox = null;
                    for (int i = 0; i < 8 && cur != null; i++) {
                        android.view.ViewParent pp = cur.getParent();
                        if (!(pp instanceof android.view.ViewGroup)) break;
                        android.view.ViewGroup g = (android.view.ViewGroup) pp;
                        if (rowBox == null) rowBox = g;
                        if (g.getChildCount() >= 3) { listBox = g; break; }
                        cur = g;
                    }
                    if (listBox == null || rowBox == null) continue;
                    // 新行：外层与"收付款"那一行同宽同底色
                    final android.view.ViewGroup ctn = listBox;
                    android.content.Context ctx = hit.getContext();
                    android.widget.LinearLayout row = new android.widget.LinearLayout(ctx);
                    row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                    row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                    row.setPadding(dp(ctx, 18), dp(ctx, 14), dp(ctx, 18), dp(ctx, 14));
                    android.graphics.drawable.Drawable menuBg = ctn.getBackground();
                    if (menuBg != null) {
                        try { row.setBackground(menuBg.getConstantState() != null
                                ? menuBg.getConstantState().newDrawable() : menuBg); } catch (Throwable ignore) { }
                    }
                    android.widget.TextView icon = new android.widget.TextView(ctx);
                    icon.setText("H");
                    icon.setTextSize(15);
                    icon.setTextColor(0xFFFFFFFF);
                    icon.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
                    icon.setGravity(android.view.Gravity.CENTER);
                    row.addView(icon, new android.widget.LinearLayout.LayoutParams(dp(ctx, 28), dp(ctx, 28)));
                    android.widget.TextView label = new android.widget.TextView(ctx);
                    label.setText("H 设置");
                    label.setTextSize(16);
                    label.setTextColor(0xFFFFFFFF);
                    label.setSingleLine(true);
                    android.widget.LinearLayout.LayoutParams lp2 = new android.widget.LinearLayout.LayoutParams(
                            android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                            android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                    lp2.leftMargin = dp(ctx, 16);
                    row.addView(label, lp2);
                    row.setOnClickListener(new android.view.View.OnClickListener() {
                        @Override public void onClick(android.view.View v) {
                            try { if (topAct != null) showSettings(topAct); } catch (Throwable ignore) { }
                        }
                    });
                    // 插到"收付款"那一行的下面
                    int idx = ctn.indexOfChild(rowBox);
                    int rowH = rowBox.getHeight() > 0 ? rowBox.getHeight() : dp(ctx, 52);
                    try {
                        android.view.ViewGroup.LayoutParams nlp = new android.view.ViewGroup.LayoutParams(
                                android.view.ViewGroup.LayoutParams.MATCH_PARENT, rowH);
                        if (idx >= 0) ctn.addView(row, idx + 1, nlp);
                        else ctn.addView(row, nlp);
                    } catch (Throwable ignore) { ctn.addView(row); }
                    android.widget.LinearLayout rowClear = makePlusRow(ctx, "清", "清空列表",
                            new Runnable() {
                                @Override public void run() {
                                    try {
                                        execSqlRaw("delete from rconversation");
                                        toast("已清空会话列表（聊天记录保留）");
                                        refreshConvList();
                                    } catch (Throwable t) { toast("清空失败"); }
                                }
                            });
                    android.widget.LinearLayout rowUnread = makePlusRow(ctx, "未", "清空未读",
                            new Runnable() {
                                @Override public void run() {
                                    try {
                                        execSqlRaw("update rconversation set unReadCount=0");
                                        toast("已清空全部未读");
                                        refreshConvList();
                                    } catch (Throwable t) { toast("清空失败"); }
                                }
                            });
                    try {
                        int at2 = idx >= 0 ? idx + 2 : ctn.getChildCount();
                        ctn.addView(rowClear, at2, new android.view.ViewGroup.LayoutParams(
                                android.view.ViewGroup.LayoutParams.MATCH_PARENT, rowH));
                        ctn.addView(rowUnread, at2 + 1, new android.view.ViewGroup.LayoutParams(
                                android.view.ViewGroup.LayoutParams.MATCH_PARENT, rowH));
                    } catch (Throwable ignore) { ctn.addView(rowClear); ctn.addView(rowUnread); }
                    // 逐级把固定高度的祖先容器加高，保证新行有位置
                    try {
                        android.view.View up = ctn;
                        int guard = 0;
                        while (up != null && guard++ < 6) {
                            android.view.ViewParent pp = up.getParent();
                            if (!(pp instanceof android.view.View)) break;
                            android.view.View pv = (android.view.View) pp;
                            android.view.ViewGroup.LayoutParams lp = pv.getLayoutParams();
                            if (lp != null && lp.height > 0) {
                                lp.height += rowH * 3;   // H 设置 + 清空聊天 + 清空未读
                                pv.setLayoutParams(lp);
                                log("PLUSINJ|grow " + pv.getClass().getSimpleName() + " h=" + lp.height);
                            }
                            pv.requestLayout();
                            up = pv;
                        }
                    } catch (Throwable ignore) { }
                    try {
                        ctn.requestLayout();
                        android.view.View rootV = row.getRootView();
                        if (rootV != null) {
                            rootV.requestLayout();
                            rootV.invalidate();
                        }
                    } catch (Throwable ignore) { }
                    log("PLUSINJ|added idx=" + idx + " ctn=" + ctn.getChildCount()
                            + " rowW=" + rowBox.getWidth() + "x" + rowBox.getHeight());
                    return;
                }
            }
        } catch (Throwable t) { log("PLUSINJ|err " + t); }
    }

    /** 不拦截原生菜单，只在它弹出后追加「H 设置」 */
    private static void installPlusEntryHook(final ClassLoader app) {
        try {
            Class<?> v = Class.forName("android.view.View", false, app);
            XposedBridge.hookAllMethods(v, "performClick", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        CharSequence d = ((android.view.View) o).getContentDescription();
                        String ds = d == null ? "" : d.toString();
                        int[] lxy = new int[2];
                        ((android.view.View) o).getLocationOnScreen(lxy);
                        if (probeClicks < 40) {
                            probeClicks++;
                            log("CLICK|" + ((android.view.View) o).getClass().getSimpleName()
                                    + " desc=" + ds + " xy=" + lxy[0] + "," + lxy[1]
                                    + " size=" + ((android.view.View) o).getWidth() + "x" + ((android.view.View) o).getHeight());
                        }
                        if (!ds.contains("更多")) return;
                        // 自绘菜单停用（会与原生菜单抢焦点），改成长按「＋」弹快捷菜单
                        if (false) {
                            android.app.Activity act0 = topAct;
                            if (act0 != null) {
                                android.view.View pv0 = (android.view.View) o;
                                showCustomPlusMenu(act0, pv0);
                                p.setResult(Boolean.TRUE);
                            }
                        }
                        android.os.Handler hh = new android.os.Handler(android.os.Looper.getMainLooper());
                        for (long dl : new long[]{150L, 450L, 900L}) {
                            hh.postDelayed(new Runnable() {
                                @Override public void run() {
                                    try {
                                        android.app.Activity act = topAct;
                                        if (act == null) return;
                                        android.view.View decor = act.getWindow().getDecorView();
                                        java.util.ArrayList<android.widget.TextView> tvs =
                                                new java.util.ArrayList<android.widget.TextView>();
                                        collectTexts(decor, tvs, 0);
                                        for (android.widget.TextView tv : tvs) {
                                            if (tv.getText() == null) continue;
                                            if (!"收付款".equals(tv.getText().toString().trim())) continue;
                                            android.view.View up = tv;
                                            for (int i = 0; i < 8; i++) {
                                                android.view.ViewParent pp = up.getParent();
                                                if (!(pp instanceof android.view.View)) break;
                                                android.view.View pv = (android.view.View) pp;
                                                if (pv.getWidth() > act.getResources()
                                                        .getDisplayMetrics().widthPixels * 0.5f
                                                        && pv.getHeight() > dp(act, 200)) break;
                                                up = pv;
                                            }
                                            // 菜单注入方案停用（会与原生 PopupWindow 冲突）
                                            return;
                                        }
                                    } catch (Throwable ignore) { }
                                }
                            }, dl);
                        }
                    } catch (Throwable ignore) { }
                }
            });
            log("PLUSINJ|hook installed");
        } catch (Throwable t) { log("PLUSINJ|install err " + t); }
    }

    /** 尽量沿用原生菜单的背景色，保证拼接后看不出接缝 */
    private static int menuBgColor(android.view.View menuRoot) {
        try {
            android.graphics.drawable.Drawable d = menuRoot.getBackground();
            if (d instanceof android.graphics.drawable.GradientDrawable) {
                android.graphics.drawable.GradientDrawable g = (android.graphics.drawable.GradientDrawable) d;
                // GradientDrawable 没有 getColor()，只能靠常量比对；拿不到就走默认
            }
            if (d != null) {
                android.graphics.Bitmap bmp = android.graphics.Bitmap.createBitmap(4, 4,
                        android.graphics.Bitmap.Config.ARGB_8888);
                android.graphics.Canvas c = new android.graphics.Canvas(bmp);
                d.setBounds(0, 0, 4, 4);
                d.draw(c);
                int px = bmp.getPixel(2, 2);
                bmp.recycle();
                if ((px >>> 24) > 200) return px | 0xFF000000;
            }
        } catch (Throwable ignore) { }
        return 0xFF3B3B40;
    }

