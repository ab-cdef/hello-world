    private static void runCalendar(final String talker, final String sid, final String whoLabel) {
        toast("统计中…");
        new Thread(new Runnable() { @Override public void run() {
            final String txt = buildCalendar(talker, sid, whoLabel, 30);
            new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                @Override public void run() {
                    new android.app.AlertDialog.Builder(ctxAny())
                            .setTitle("发言日历 · " + whoLabel)
                            .setMessage(txt)
                            .setPositiveButton("关闭", null)
                            .show();
                }
            });
        } }).start();
    }

    /** 生成 30 天发言日历文本（字符画 + 峰值），同时导出 CSV */
    private static String buildCalendar(String talker, String sid, String whoLabel, int days) {
        StringBuilder sb = new StringBuilder();
        try {
            long now = System.currentTimeMillis();
            long since = now - (long) days * 86400000L;
            java.text.SimpleDateFormat df = new java.text.SimpleDateFormat("MM-dd", java.util.Locale.US);
            java.text.SimpleDateFormat dfFull = new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
            java.util.LinkedHashMap<String, Integer> cnt = new java.util.LinkedHashMap<String, Integer>();
            for (int i = days - 1; i >= 0; i--) {
                cnt.put(dfFull.format(new java.util.Date(now - (long) i * 86400000L)), Integer.valueOf(0));
            }
            boolean group = talker.endsWith("@chatroom");
            boolean all = (sid == null || sid.length() == 0);
            java.util.List<Object[]> rows = queryRows(
                    "select createTime, ifnull(content,''), ifnull(isSend,0) from message where talker='"
                            + escSql(talker) + "' and createTime > " + since
                            + " order by createTime desc limit 5000", 3);
            int hit = 0;
            for (Object[] r : rows) {
                long ct = 0;
                try { ct = Long.parseLong(String.valueOf(r[0]).trim()); } catch (Throwable ignore) { }
                if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                if (ct <= 0) continue;
                boolean mine = "1".equals(String.valueOf(r[2]).trim());
                if (!all) {
                    String thisSid = mine ? "__me__" : (group ? senderIdOfGroupMsg(String.valueOf(r[1])) : null);
                    if (thisSid == null || !thisSid.equals(sid)) continue;
                }
                String day = dfFull.format(new java.util.Date(ct));
                Integer c0 = cnt.get(day);
                if (c0 != null) { cnt.put(day, Integer.valueOf(c0.intValue() + 1)); hit++; }
            }
            java.util.List<Integer> vals = new java.util.ArrayList<Integer>(cnt.values());
            java.util.List<String> keys = new java.util.ArrayList<String>(cnt.keySet());
            int mx = 0, mn = Integer.MAX_VALUE;
            for (int v : vals) { if (v > mx) mx = v; if (v < mn) mn = v; }
            if (mn == Integer.MAX_VALUE) mn = 0;
            String ramp = "▁▂▃▄▅▆▇█";
            StringBuilder line = new StringBuilder();
            String peakDay = "";
            int peakVal = 0;
            for (int i = 0; i < vals.size(); i++) {
                int v = vals.get(i);
                int idx = (mx == mn) ? 3 : (int) Math.round((double) v * 7.0 / Math.max(mx, 1));
                if (idx < 0) idx = 0;
                if (idx > 7) idx = 7;
                line.append(ramp.charAt(idx));
                if (v > peakVal) { peakVal = v; peakDay = keys.get(i); }
            }
            sb.append("`").append(line).append("`\n\n");
            sb.append("范围 ").append(keys.get(0)).append(" ~ ").append(keys.get(keys.size() - 1)).append("\n");
            sb.append("总计 ").append(hit).append(" 条，峰值 ").append(peakDay).append("（").append(peakVal).append(" 条）\n\n");
            // 最近 7 天明细
            sb.append("最近 7 天：\n");
            for (int i = Math.max(0, keys.size() - 7); i < keys.size(); i++) {
                sb.append(keys.get(i).substring(5)).append("  ")
                  .append(vals.get(i)).append(" 条\n");
            }
            // CSV
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            def: {
                java.io.File f = new java.io.File(dir, "calendar_" + csv(displayOfTalker(talker)) + "_"
                        + csv(whoLabel) + "_" + stamp + ".csv");
                java.io.FileWriter fw = new java.io.FileWriter(f, false);
                fw.write("\uFEFF日期,发言数\n");
                for (int i = 0; i < keys.size(); i++) fw.write(keys.get(i) + "," + vals.get(i) + "\n");
                fw.close();
                log("CAL|talker=" + talker + " who=" + sid + " days=" + days + " total=" + hit
                        + " peak=" + peakDay + "/" + peakVal + " path=" + f.getAbsolutePath());
            }
        } catch (Throwable t) {
            log("CAL|err " + t);
            sb.append("统计失败：").append(t);
        }
        return sb.toString();
    }

