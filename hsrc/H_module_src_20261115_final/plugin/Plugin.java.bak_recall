                        switch (idx) {
                            case 0:
                                pickStr(a, "提醒范围", new String[]{"1 天", "3 天", "7 天", "15 天", "30 天"},
                                        "bdayRangeTxt", bdayRange() + " 天", new Runnable() {
                                            @Override public void run() {
                                                try {
                                                    String v2 = cfg().optString("bdayRangeTxt", "3 天").replace(" 天", "").trim();
                                                    JSONObject o = readCfg();
                                                    o.put("bdayRange", Integer.parseInt(v2));
                                                    writeCfg(o);
                                                    cfg = null; cfgAt = 0;
                                                } catch (Throwable ignore) { }
                                                showBirthdayPanel(a);
                                            }
                                        });
                                break;
                            case 1: {
                                boolean nv = !bdayDailyOn();
                                JSONObject o = readCfg();
                                try { o.put("bdayDaily", nv); } catch (Throwable ignore) { }
                                writeCfg(o);
                                cfg = null; cfgAt = 0;
                                toast(nv ? "每天提醒：开" : "每天提醒：关");
                                showBirthdayPanel(a);
                                break;
                            }
                            case 2:
                                pickStr(a, "提醒时间", new String[]{"07:00", "08:00", "09:00", "10:00",
                                                "12:00", "18:00", "20:00", "21:00"},
                                        "bdayTime", cfg().optString("bdayTime", "08:00"), new Runnable() {
                                            @Override public void run() { showBirthdayPanel(a); }
                                        });
                                break;
                            case 3:
                                showBirthday(a);
                                break;
                            case 4:
                                exportBirthday(birthdayScan(bdayRange()));
                                break;
                            default: break;
                        }
                    }
                });
                box.addView(card);
            }

            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            sv.addView(box);
            ref[0] = new android.app.AlertDialog.Builder(a)
                    .setTitle("生日提醒")
                    .setView(sv)
                    .setNegativeButton("关闭", null)
                    .create();
            ref[0].show();
        } catch (Throwable t) {
            toast("打开失败 " + t);
        }
    }

    /** 提前几天提醒（默认 3） */
    private static int bdayRange() {
        try {
            int v = cfg().optInt("bdayRange", 0);
            if (v > 0) return Math.min(v, 60);
        } catch (Throwable ignore) { }
        return 3;
    }

    /** 是否每天推送 */
    private static boolean bdayDailyOn() {
        try {
            Object o = cfg().opt("bdayDaily");
            if (o instanceof Boolean) return ((Boolean) o).booleanValue();
            if (o instanceof String) {
                String v = ((String) o).trim();
                return !("0".equals(v) || "false".equalsIgnoreCase(v));
            }
        } catch (Throwable ignore) { }
        return true;
    }

    private static void showBirthday(final android.app.Activity a) {
        final java.util.List<String[]> hits = birthdayScan(bdayRange());
        StringBuilder sb = new StringBuilder();
        String[] buckets = {"今天", "3 天内", "7 天内", "30 天内", "更远"};
        int curBucket = -1;
        for (int i = 0; i < hits.size() && i < 60; i++) {
            String[] h = hits.get(i);
            int d = 0;
            try { d = Integer.parseInt(h[3]); } catch (Throwable ignore) { }
            int b = d == 0 ? 0 : (d <= 3 ? 1 : (d <= 7 ? 2 : (d <= 30 ? 3 : 4)));
            if (b != curBucket) {
                curBucket = b;
                if (b == 0) {
                    sb.append(sb.length() == 0 ? "" : "\n").append("── 今天 ──\n");
                } else {
                    sb.append(sb.length() == 0 ? "" : "\n").append("── ").append(buckets[b]).append(" ──\n");
                }
            }
            sb.append(d == 0 ? "今天　" : ("还有 " + d + " 天")).append("　").append(h[2]).append("　").append(h[0]);
            if (h[1].length() > 0 && !h[1].equals(h[0])) sb.append("（").append(h[1]).append("）");
            sb.append('\n');
        }
        if (hits.isEmpty()) sb.append("未来 30 天没有识别到生日。\n\n在好友备注里写「10-12」这种日期即可。");
        new android.app.AlertDialog.Builder(a)
                .setTitle("生日提醒（未来 " + bdayRange() + " 天 " + hits.size() + " 位）")
                .setMessage(sb.toString())
                .setPositiveButton("导出 CSV", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        exportBirthday(hits);
                    }
                })
                .setNegativeButton("关闭", null)
                .show();
        log("BDAY|near30=" + hits.size());
    }

    private static void exportBirthday(java.util.List<String[]> hits) {
        try {
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            java.io.File f = new java.io.File(dir, "birthdays_" + stamp + ".csv");
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            fw.write("\uFEFF昵称,备注,生日,还有几天\n");
            for (String[] h : hits) {
                fw.write(csv(h[0]) + "," + csv(h[1]) + "," + h[2] + "," + h[3] + "\n");
            }
            fw.close();
            toast("已导出 " + hits.size() + " 条\nDownload/wxh/" + f.getName());
            log("BDAY|export n=" + hits.size() + " path=" + f.getAbsolutePath());
        } catch (Throwable t) { log("BDAY|exp err " + t); }
    }

    /** 每天一次：3 天内过生日的人推通知 */
    private static long bdayAt = 0;

    /** 生日提醒开关：兼容旧配置里被写成日期字符串的情况 */
    private static boolean bdayOn() {
        try {
            Object o = cfg().opt("birthday");
            if (o instanceof Boolean) return ((Boolean) o).booleanValue();
            if (o instanceof Number) return ((Number) o).intValue() != 0;
            if (o instanceof String) {
                String v = ((String) o).trim();
                if (v.length() == 0) return true;
                if ("0".equals(v) || "false".equalsIgnoreCase(v) || "off".equalsIgnoreCase(v)) return false;
                return true;                       // 例如旧的 "20261111"，视为开启
            }
        } catch (Throwable ignore) { }
        return true;
    }

    private static void notifyBirthdayIfDue() {
        try {
            if (!bdayOn()) return;
            // 同一天只提醒一次（持久化，重启微信也不重复）
            String today = new java.text.SimpleDateFormat("yyyyMMdd", java.util.Locale.US)
                    .format(new java.util.Date());
            if (today.equals(cfg().optString("bdayLast", ""))) return;
            long now = System.currentTimeMillis();
            if (now - bdayAt < 3600L * 1000L) return;
            bdayAt = now;
            if (inQuietHours()) { log("BDAY|quiet"); return; }
            if (!bdayDailyOn()) { log("BDAY|daily off"); return; }
            try {
                String setT = cfg().optString("bdayTime", "08:00");
                String nowT = new java.text.SimpleDateFormat("HH:mm", java.util.Locale.US)
                        .format(new java.util.Date());
                if (nowT.compareTo(setT) < 0) { log("BDAY|before " + setT); return; }
            } catch (Throwable ignore) { }
            java.util.List<String[]> hits = birthdayScan(bdayRange());
            if (hits.isEmpty()) { log("BDAY|none"); return; }
            StringBuilder body = new StringBuilder();
            for (int i = 0; i < hits.size() && i < 3; i++) {
                if (body.length() > 0) body.append('、');
                body.append(hits.get(i)[0]);
                if ("0".equals(hits.get(i)[3])) body.append("（今天）");
                else body.append("（").append(hits.get(i)[3]).append("天后）");
            }
            notifyLocal(mainAct != null ? mainAct : chatAct,
                    "生日提醒 " + hits.size() + " 位", body.toString());
            try {
                JSONObject o2 = readCfg();
                o2.put("bdayLast", today);
                writeCfg(o2);
            } catch (Throwable ignore) { }
            log("BDAY|notify n=" + hits.size() + " body=" + body);
        } catch (Throwable t) { log("BDAY|err " + t); }
    }

    /** 联系人备注批量导出（CRM 用）：昵称/备注/微信号/别名/最后互动/多少天没联系 */
    private static void runContactExport(final android.app.Activity a) {
        new Thread(new Runnable() {
            @Override public void run() {
                final int n = exportContacts();
                if (a != null) {
                    new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                        @Override public void run() {
                            toast(n <= 0 ? "导出失败" : ("已导出 " + n + " 位联系人到 Download/wxh"));
                        }
                    });
                }
            }
        }).start();
    }

    private static int exportContacts() {
        int n = 0;
        try {
            java.util.HashMap<String, Long> lastMap = new java.util.HashMap<String, Long>();
            for (Object[] r : queryRows("select talker, max(createTime) from message group by talker", 2)) {
                long ct = 0;
                try { ct = Long.parseLong(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                if (ct > 0) lastMap.put(String.valueOf(r[0]), Long.valueOf(ct));
            }
            java.util.List<Object[]> rows = queryRows(
                    "select username, ifnull(nickname,''), ifnull(conRemark,''), ifnull(alias,'')"
                            + " from rcontact where (type & 1) != 0"
                            + " and username not like '%@chatroom' and username not like 'gh_%'"
                            + " and username not like '%@openim' order by nickname", 4);
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            java.io.File f = new java.io.File(dir, "contacts_" + stamp + ".csv");
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            fw.write("\uFEFF昵称,备注,微信号,别名,最后互动,多久没联系(天),有备注\n");
            long now = System.currentTimeMillis();
            for (Object[] r : rows) {
                String uid = String.valueOf(r[0]);
                String nick = String.valueOf(r[1]);
                String remark = String.valueOf(r[2]);
                String alias = String.valueOf(r[3]);
                Long lt = lastMap.get(uid);
                String ltS = "";
                String days = "";
                if (lt != null && lt.longValue() > 0) {
                    ltS = new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US)
                            .format(new java.util.Date(lt.longValue()));
                    days = String.valueOf((now - lt.longValue()) / 86400000L);
                }
                fw.write(csv(nick) + "," + csv(remark) + "," + csv(uid) + "," + csv(alias) + ","
                        + ltS + "," + days + "," + (remark.trim().length() > 0 ? "是" : "") + "\n");
                n++;
            }
            fw.close();
            askShare(f);
            log("CEXPORT|n=" + n + " path=" + f.getAbsolutePath());
        } catch (Throwable t) {
            log("CEXPORT|err " + t);
        }
        return n;
    }

    /* ================= 消息收藏夹 ================= */
    private static void addFavorite(String talker, String text) {
        try {
            if (text == null || text.trim().length() == 0) { toast("这条没有可收藏的文字"); return; }
            org.json.JSONObject o = new org.json.JSONObject();
            o.put("ts", System.currentTimeMillis());
            o.put("talker", talker == null ? "" : talker);
            o.put("name", talker == null ? "" : displayOfTalker(talker));
            String t = text.trim();
            if (t.length() > 1000) t = t.substring(0, 1000);
            o.put("text", t);
            java.io.FileWriter fw = new java.io.FileWriter(
                    new java.io.File(DIR + "/favorites.jsonl"), true);
            fw.write(o.toString() + "\n");
            fw.close();
            toast("已收藏");
            log("FAV|add " + (talker == null ? "" : talker));
        } catch (Throwable t) { log("FAV|err " + t); }
    }

    private static void showFavorites(final android.app.Activity a) {
        try {
            final java.io.File f = new java.io.File(DIR + "/favorites.jsonl");
            final java.util.ArrayList<org.json.JSONObject> all =
                    new java.util.ArrayList<org.json.JSONObject>();
            if (f.isFile()) {
                java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
                String ln;
                while ((ln = br.readLine()) != null) {
                    if (ln.trim().length() == 0) continue;
                    try { all.add(new org.json.JSONObject(ln)); } catch (Throwable ignore) { }
                }
                br.close();
            }

            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));

            final android.widget.EditText search = new android.widget.EditText(a);
            search.setHint("搜索收藏内容 / 群名");
            search.setTextSize(14);
            search.setSingleLine();
            box.addView(search);

            final android.widget.TextView cnt = new android.widget.TextView(a);
            cnt.setTextSize(12);
            cnt.setTextColor(0xFF888888);
            cnt.setPadding(0, dp(a, 6), 0, dp(a, 4));
            box.addView(cnt);

            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            final android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 400)));

            final android.app.Dialog[] dd = new android.app.Dialog[1];
            final Runnable[] rebuild = new Runnable[1];
            rebuild[0] = new Runnable() {
                @Override public void run() {
                    list.removeAllViews();
                    String q = search.getText() == null ? "" : search.getText().toString().trim().toLowerCase();
                    int shown = 0;
                    for (int i = all.size() - 1; i >= 0; i--) {
                        final org.json.JSONObject o = all.get(i);
                        String body = o.optString("text", "");
                        String nm = o.optString("name", "");
                        String blob = (body + " " + nm + " " + o.optString("tags", "")).toLowerCase();
                        if (q.length() > 0 && blob.indexOf(q) < 0) continue;
                        if (shown >= 200) break;
                        shown++;
                        android.widget.TextView tv = new android.widget.TextView(a);
                        String when = "";
                        try { when = fmtTs(o.optLong("ts", 0)); } catch (Throwable ignore) { }
                        String tg = o.optString("tags", "");
                        tv.setText(nm + "  " + when + (tg.length() > 0 ? "  #" + tg.replace(",", " #") : "")
                                + "\n" + body);
                        tv.setTextSize(13);
                        tv.setTextColor(0xFF1A1A1E);
                        tv.setPadding(dp(a, 10), dp(a, 8), dp(a, 10), dp(a, 8));
                        android.graphics.drawable.GradientDrawable g =
                                new android.graphics.drawable.GradientDrawable();
                        g.setColor(0xF7FFFFFF);
                        g.setCornerRadius(dp(a, 10));
                        tv.setBackground(g);
                        android.widget.LinearLayout.LayoutParams lp =
                                new android.widget.LinearLayout.LayoutParams(-1, -2);
                        lp.bottomMargin = dp(a, 5);
                        tv.setLayoutParams(lp);
                        final String tk = o.optString("talker", "");
                        tv.setOnClickListener(new android.view.View.OnClickListener() {
                            @Override public void onClick(android.view.View v) {
                                if (tk.length() > 0) {
                                    if (dd[0] != null) { try { dd[0].dismiss(); } catch (Throwable ignore) { } }
                                    openAndCopy(a, tk, o.optString("text", ""));
                                } else toast("这条没记录到会话");
                            }
                        });
                        tv.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                            @Override public boolean onLongClick(android.view.View v) {
                                try {
                                    new android.app.AlertDialog.Builder(a)
                                            .setTitle("收藏项")
                                            .setItems(new String[]{"复制", "设置标签", "修正所属会话", "删除", "取消"}, new android.content.DialogInterface.OnClickListener() {
                                                @Override public void onClick(android.content.DialogInterface d, int w) {
                                                    if (w == 1) {
                                                        final android.widget.EditText etg = new android.widget.EditText(a);
                                                        etg.setHint("多个标签用逗号分隔，如 工作,待办");
                                                        etg.setText(o.optString("tags", ""));
                                                        new android.app.AlertDialog.Builder(a)
                                                                .setTitle("设置标签")
                                                                .setView(etg)
                                                                .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                                                                    @Override public void onClick(android.content.DialogInterface d, int w2) {
                                                                        try {
                                                                            o.put("tags", etg.getText().toString().trim());
                                                                            saveFavorites(all);
                                                                            rebuild[0].run();
                                                                            toast("标签已保存");
                                                                        } catch (Throwable ignore) { }
                                                                    }
                                                                })
                                                                .setNegativeButton("取消", null).show();
                                                        return;
                                                    }
                                                    if (w == 2) {
                                                        String real = guessTalkerByText(o.optString("text", ""));
                                                        if (real == null) { toast("数据库里找不到这条，无法修正"); return; }
                                                        try {
                                                            o.put("talker", real);
                                                            o.put("name", displayOfTalker(real));
                                                            saveFavorites(all);
                                                            rebuild[0].run();
                                                            toast("已修正为：" + displayOfTalker(real));
                                                        } catch (Throwable ignore) { }
                                                        return;
                                                    }
                                                    if (w == 3) {
                                                        all.remove(o);
                                                        saveFavorites(all);
                                                        rebuild[0].run();
                                                        toast("已删除");
                                                        return;
                                                    }
                                                    if (w == 0) {
                                                        try {
                                                            android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                                                    a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                                            cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", o.optString("text", "")));
                                                            toast("已复制");
                                                        } catch (Throwable ignore) { }
                                                    }
                                                }
                                            }).show();
                                } catch (Throwable ignore) { }
                                return true;
                            }
                        });
                        list.addView(tv);
                    }
                    cnt.setText("共 " + all.size() + " 条收藏" + (q.length() > 0 ? " · 命中 " + shown : ""));
                    if (shown == 0) {
                        android.widget.TextView empty = new android.widget.TextView(a);
                        empty.setText("还没有收藏。\n聊天里长按任意消息 → ☆ 收藏，就会进到这里。");
                        empty.setTextSize(13);
                        empty.setTextColor(0xFF999999);
                        empty.setPadding(dp(a, 10), dp(a, 20), dp(a, 10), dp(a, 20));
                        list.addView(empty);
                    }
                }
            };
            search.addTextChangedListener(new android.text.TextWatcher() {
                @Override public void beforeTextChanged(CharSequence s, int st, int c, int af) { }
                @Override public void onTextChanged(CharSequence s, int st, int b, int c) { }
                @Override public void afterTextChanged(android.text.Editable e) { rebuild[0].run(); }
            });

            dd[0] = new android.app.AlertDialog.Builder(a)
                    .setTitle("收藏夹")
                    .setView(box)
                    .setPositiveButton("导出", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("导出格式")
                                    .setItems(new String[]{"CSV 表格", "Markdown（便于阅读）"},
                                            new android.content.DialogInterface.OnClickListener() {
                                                @Override public void onClick(android.content.DialogInterface d2, int which) {
                                                    if (which == 0) exportFavorites(all);
                                                    else exportFavoritesMd(all);
                                                }
                                            })
                                    .show();
                        }
                    })
                    .setNeutralButton("清空", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            if (all.isEmpty()) { toast("已经是空的"); return; }
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("清空收藏夹？")
                                    .setMessage("共 " + all.size() + " 条，清空后不可恢复")
                                    .setPositiveButton("清空", new android.content.DialogInterface.OnClickListener() {
                                        @Override public void onClick(android.content.DialogInterface d2, int w2) {
                                            all.clear();
                                            saveFavorites(all);
                                            rebuild[0].run();
                                            toast("已清空");
                                        }
                                    })
                                    .setNegativeButton("取消", null).show();
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .create();
            dd[0].show();
            rebuild[0].run();
        } catch (Throwable t) {
            log("FAV|ui err " + t);
            toast("打开失败：" + t);
        }
    }


    /** 按正文反查这条消息真正的会话（用于修正旧收藏的错误归属） */
    private static String guessTalkerByText(String text) {
        try {
            if (text == null) return null;
            String t = text.trim().replace("'", "''");
            if (t.length() == 0) return null;
            if (t.length() > 40) t = t.substring(0, 40);
            java.util.List<Object[]> r = queryRows(
                    "select talker from message where content like '%" + t
                            + "%' order by createTime desc limit 3", 1);
            for (Object[] o : r) {
                if (o[0] == null) continue;
                String k = String.valueOf(o[0]);
                if (k.length() > 0) return k;
            }
        } catch (Throwable t2) { log("FAV|guess err " + t2); }
        return null;
    }

    private static void saveFavorites(java.util.List<org.json.JSONObject> all) {
        try {
            java.io.File f = new java.io.File(DIR + "/favorites.jsonl");
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            for (org.json.JSONObject o : all) fw.write(o.toString() + "\n");
            fw.close();
        } catch (Throwable t) { log("FAV|save err " + t); }
    }

    /** 收藏夹导出为 Markdown（按日期分组） */
    private static void exportFavoritesMd(final java.util.List<org.json.JSONObject> all) {
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    StringBuilder sb = new StringBuilder();
                    sb.append("# 消息收藏夹\n\n> 共 ").append(all.size()).append(" 条 · 导出 ")
                      .append(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                              .format(new java.util.Date())).append("\n");
                    String curDay = "";
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
                    java.text.SimpleDateFormat tf =
                            new java.text.SimpleDateFormat("HH:mm", java.util.Locale.US);
                    for (org.json.JSONObject o : all) {
                        long ts = o.optLong("ts", 0);
                        String day = df.format(new java.util.Date(ts));
                        if (!day.equals(curDay)) {
                            curDay = day;
                            sb.append("\n## ").append(day).append("\n\n");
                        }
                        String nm = o.optString("name", "");
                        sb.append("- `").append(tf.format(new java.util.Date(ts))).append("`");
                        if (nm.length() > 0) sb.append(" **").append(nm).append("**");
                        sb.append("：").append(o.optString("text", "").replace("\n", " ⏎ ")).append('\n');
                    }
                    android.content.Context ctx = ctxAny();
                    if (ctx == null) { toast("没有上下文"); return; }
                    String name = "wxh_favorites_" + System.currentTimeMillis() + ".md";
                    android.content.ContentValues v = new android.content.ContentValues();
                    v.put(android.provider.MediaStore.MediaColumns.DISPLAY_NAME, name);
                    v.put(android.provider.MediaStore.MediaColumns.MIME_TYPE, "text/markdown");
                    v.put(android.provider.MediaStore.MediaColumns.RELATIVE_PATH, "Download/wxh");
                    android.net.Uri uri = ctx.getContentResolver()
                            .insert(android.provider.MediaStore.Downloads.EXTERNAL_CONTENT_URI, v);
                    if (uri == null) { toast("写入失败"); return; }
                    java.io.OutputStream os = ctx.getContentResolver().openOutputStream(uri);
                    os.write(sb.toString().getBytes("UTF-8"));
                    os.flush();
                    os.close();
                    log("FAV|md path=Download/wxh/" + name + " n=" + all.size());
                    toast("已导出：Download/wxh/" + name);
                } catch (Throwable t) { log("FAV|md err " + t); toast("导出失败"); }
            }
        }).start();
    }

    private static void exportFavorites(final java.util.List<org.json.JSONObject> all) {
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    StringBuilder sb = new StringBuilder();
                    sb.append("时间,会话,标签,内容\n");
                    java.text.SimpleDateFormat f =
                            new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss", java.util.Locale.US);
                    for (org.json.JSONObject o : all) {
                        sb.append(f.format(new java.util.Date(o.optLong("ts", 0)))).append(',')
                          .append(csvCell(o.optString("name", ""))).append(',')
                          .append(csvCell(o.optString("tags", ""))).append(',')
                          .append(csvCell(o.optString("text", ""))).append('\n');
                    }
                    android.content.Context ctx = ctxAny();
                    if (ctx == null) { toast("没有上下文"); return; }
                    String name = "wxh_favorites_" + System.currentTimeMillis() + ".csv";
                    android.content.ContentValues v = new android.content.ContentValues();
                    v.put(android.provider.MediaStore.MediaColumns.DISPLAY_NAME, name);
                    v.put(android.provider.MediaStore.MediaColumns.MIME_TYPE, "text/csv");
                    v.put(android.provider.MediaStore.MediaColumns.RELATIVE_PATH, "Download/wxh");
                    android.net.Uri uri = ctx.getContentResolver()
                            .insert(android.provider.MediaStore.Downloads.EXTERNAL_CONTENT_URI, v);
                    if (uri == null) { toast("写入失败"); return; }
                    java.io.OutputStream os = ctx.getContentResolver().openOutputStream(uri);
                    os.write(("\ufeff" + sb.toString()).getBytes("UTF-8"));
                    os.flush();
                    os.close();
                    toast("已导出：Download/wxh/" + name);
                } catch (Throwable t) { log("FAV|exp err " + t); toast("导出失败"); }
            }
        }).start();
    }

    /* ================= 通用列表编辑面板（逗号分隔配置项） ================= */
    private static void showListEditor(final android.app.Activity a, String title,
                                       final String cfgKey, String hint) {
        try {
            final java.util.ArrayList<String> items = new java.util.ArrayList<String>();
            String cur = cfg().optString(cfgKey, "");
            for (String w : cur.split("[,，]")) {
                String t = w.trim();
                if (t.length() > 0) items.add(t);
            }
            final String ftitle = title;

            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));

            android.widget.TextView tip = new android.widget.TextView(a);
            tip.setText(hint == null ? "" : hint);
            tip.setTextSize(12);
            tip.setTextColor(0xFF888888);
            box.addView(tip);

            android.widget.LinearLayout addRow = new android.widget.LinearLayout(a);
            addRow.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            addRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
            addRow.setPadding(0, dp(a, 8), 0, dp(a, 8));
            final android.widget.EditText et = new android.widget.EditText(a);
            et.setHint("输入后点「添加」");
            et.setTextSize(14);
            et.setSingleLine();
            addRow.addView(et, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
            android.widget.TextView add = new android.widget.TextView(a);
            add.setText("添加");
            add.setTextSize(13);
            add.setTextColor(0xFF2E7D32);
            add.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));
            addRow.addView(add);
            box.addView(addRow);

            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            final android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 300)));

            final Runnable[] rebuild = new Runnable[1];
            rebuild[0] = new Runnable() {
                @Override public void run() {
                    list.removeAllViews();
                    if (items.isEmpty()) {
                        android.widget.TextView empty = new android.widget.TextView(a);
                        empty.setText("（空）");
                        empty.setTextSize(13);
                        empty.setTextColor(0xFF999999);
                        empty.setPadding(dp(a, 8), dp(a, 10), dp(a, 8), dp(a, 10));
                        list.addView(empty);
                        return;
                    }
                    for (int i = 0; i < items.size(); i++) {
                        final int idx = i;
                        android.widget.LinearLayout row = new android.widget.LinearLayout(a);
                        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                        row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                        row.setPadding(dp(a, 10), dp(a, 9), dp(a, 6), dp(a, 9));
                        android.graphics.drawable.GradientDrawable g =
                                new android.graphics.drawable.GradientDrawable();
                        g.setColor(0xF7FFFFFF);
                        g.setCornerRadius(dp(a, 8));
                        row.setBackground(g);
                        android.widget.LinearLayout.LayoutParams lp =
                                new android.widget.LinearLayout.LayoutParams(-1, -2);
                        lp.bottomMargin = dp(a, 4);
                        row.setLayoutParams(lp);
                        android.widget.TextView tv = new android.widget.TextView(a);
                        tv.setText(items.get(idx));
                        tv.setTextSize(14);
                        tv.setTextColor(0xFF1A1A1E);
                        row.addView(tv, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
                        android.widget.TextView del = new android.widget.TextView(a);
                        del.setText("×");
                        del.setTextSize(17);
                        del.setTextColor(0xFF07C160);
                        del.setPadding(dp(a, 10), 0, dp(a, 10), 0);
                        del.setOnClickListener(new android.view.View.OnClickListener() {
                            @Override public void onClick(android.view.View v) {
                                items.remove(idx);
                                rebuild[0].run();
                            }
                        });
                        row.addView(del);
                        list.addView(row);
                    }
                }
            };

            add.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    String t = et.getText() == null ? "" : et.getText().toString().trim();
                    if (t.length() == 0) return;
                    if (t.indexOf(',') >= 0 || t.indexOf('，') >= 0) {
                        for (String p : t.split("[,，]")) {
                            String q = p.trim();
                            if (q.length() > 0 && !items.contains(q)) items.add(q);
                        }
                    } else if (!items.contains(t)) {
                        items.add(t);
                    }
                    et.setText("");
                    rebuild[0].run();
                }
            });

            new android.app.AlertDialog.Builder(a)
                    .setTitle(ftitle)
                    .setView(box)
                    .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            StringBuilder sb = new StringBuilder();
                            for (String s : items) {
                                if (sb.length() > 0) sb.append(',');
                                sb.append(s);
                            }
                            setStrCfg(cfgKey, sb.toString());
                            toast(items.isEmpty() ? "已清空" : "已保存 " + items.size() + " 项");
                            if (settingsRefresher != null) settingsRefresher.run();
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
            rebuild[0].run();
        } catch (Throwable t) {
            log("LISTED|err " + t);
            toast("打开失败：" + t);
        }
    }

