                            });
                        } }).start();
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static int exportGroupRoster(String talker, String gname) {
        int n = 0;
        try {
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            java.io.File out = new java.io.File(dir, "roster_" + csv(gname) + "_" + stamp + ".csv");
            java.io.FileWriter fw = new java.io.FileWriter(out, false);
            fw.write("\uFEFF昵称,微信号,备注,已是好友,发言数,最后发言\n");

            java.util.LinkedHashMap<String, int[]> cnt = new java.util.LinkedHashMap<String, int[]>();
            java.util.LinkedHashMap<String, Long> last = new java.util.LinkedHashMap<String, Long>();
            java.util.List<Object[]> msgs = queryRows(
                    "select ifnull(content,''), createTime from message where talker='" + escSql(talker)
                            + "' order by createTime desc limit 5000", 2);
            int cntAll = 0;
            for (Object[] r : msgs) {
                if (++cntAll > 5000) break;
                String c = String.valueOf(r[0]);
                String sid = senderIdOfGroupMsg(c);
                if (sid == null || sid.length() == 0) continue;
                int[] c1 = cnt.get(sid);
                if (c1 == null) cnt.put(sid, new int[]{1}); else c1[0]++;
                if (!last.containsKey(sid)) {
                    long ct = 0;
                    try { ct = Long.parseLong(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                    if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                    last.put(sid, Long.valueOf(ct));
                }
            }
            for (String uid : cnt.keySet()) {
                String nick = displayOfTalker(uid);
                String remark = "";
                boolean friend = false;
                try {
                    java.util.List<Object[]> rc = queryRows(
                            "select ifnull(conRemark,''), ifnull(type,0) from rcontact where username='"
                                    + escSql(uid) + "' limit 1", 2);
                    if (!rc.isEmpty()) {
                        remark = String.valueOf(rc.get(0)[0]);
                        int tp = 0;
                        try { tp = Integer.parseInt(String.valueOf(rc.get(0)[1]).trim()); } catch (Throwable ignore) { }
                        friend = (tp & 1) != 0;      // rcontact.type 最低位 = 好友
                    }
                } catch (Throwable ignore) { }
                Long lt = last.get(uid);
                String ltS = lt == null || lt.longValue() <= 0 ? "" :
                        new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US)
                                .format(new java.util.Date(lt.longValue()));
                fw.write(csv(nick) + "," + csv(uid) + "," + csv(remark) + ","
                        + (friend ? "是" : "否") + "," + cnt.get(uid)[0] + "," + ltS + "\n");
                n++;
            }
            fw.close();
            askShare(out);
            log("ROSTER|talker=" + talker + " n=" + n + " path=" + out.getAbsolutePath());
        } catch (Throwable t) {
            log("ROSTER|err " + t);
        }
        return n;
    }

    /**
     * 客户未回复跟进清单（销售用）
     * 找出「最后一条消息是我发的」且超过 N 小时的会话 —— 这些就是等回复/该催的客户。
     */
    private static int followUpHours = 6;

    private static void showFollowUp(final android.app.Activity a) {
        final String[] opts = {"6 小时未回", "12 小时未回", "24 小时未回", "3 天未回"};
        final int[] vals = {6, 12, 24, 72};
        int cur = 0;
        for (int i = 0; i < vals.length; i++) if (vals[i] == followUpHours) cur = i;
        final int[] pick = {cur};
        new android.app.AlertDialog.Builder(a)
                .setTitle("客户未回复跟进清单")
                .setSingleChoiceItems(opts, cur, new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) { pick[0] = which; }
                })
                .setPositiveButton("生成清单", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) {
                        followUpHours = vals[pick[0]];
                        new Thread(new Runnable() { @Override public void run() { buildFollowUp(followUpHours, a); } }).start();
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

