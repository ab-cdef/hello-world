    private static void onSettingClick(final android.app.Activity a, int which) {
        try {
            if (which < 0 || which >= SETTING_KEYS.length) return;
            String key = SETTING_KEYS[which];
            JSONObject c = cfg();
            if ("menuCompact".equals(key)) { setOn("menuCompact", !c.optBoolean("menuCompact", true));
                toast(c.optBoolean("menuCompact", true) ? "长按菜单：完整显示" : "长按菜单：精简显示");
                if (settingsRefresher != null) settingsRefresher.run(); return; }
            if ("menuAvoidMsg".equals(key)) { setOn("menuAvoidMsg", !c.optBoolean("menuAvoidMsg", true));
                toast(c.optBoolean("menuAvoidMsg", true) ? "菜单避让：关" : "菜单避让：开");
                if (settingsRefresher != null) settingsRefresher.run(); return; }
            if ("unrecall".equals(key)) { setOn("unrecallPlugin", !c.optBoolean("unrecallPlugin", true)); }
            else if ("unrecallPrefix".equals(key)) { setOn("unrecallPrefix", !c.optBoolean("unrecallPrefix", false)); }
            else if ("unrecallMark".equals(key)) { setOn("unrecallSysMsg", !c.optBoolean("unrecallSysMsg", true)); }
            else if ("keywords".equals(key)) { askKeywords(a); return; }
            else if ("redpacket".equals(key)) { setOn("redPacketAlert", !c.optBoolean("redPacketAlert", true)); }
            else if ("redpacketOpen".equals(key)) { toggleAutoGrab(a, c); return; }
            else if ("groupChange".equals(key)) { setOn("groupAlert", !c.optBoolean("groupAlert", true)); }
            else if ("groupNotice".equals(key)) { setOn("groupNoticeAlert", !c.optBoolean("groupNoticeAlert", true)); }
            else if ("atMe".equals(key)) { setOn("atMeAlert", !c.optBoolean("atMeAlert", true)); }
            else if ("groupQuiet".equals(key)) { setOn("groupQuiet", !c.optBoolean("groupQuiet", false)); }
            else if ("noPat".equals(key)) { setOn("noPatAlert", !c.optBoolean("noPatAlert", false)); }
            else if ("noSeenTip".equals(key)) { setOn("noSeenTip", !c.optBoolean("noSeenTip", true)); }
            else if ("bdayFloat".equals(key)) {
                setOn("bdayFloat", !c.optBoolean("bdayFloat", true));
                boolean onB = cfg().optBoolean("bdayFloat", true);
                toast(onB ? "列表生日球：开（只在聊天首页显示）" : "列表生日球：关");
                try {
                    if (a != null && a.getClass().getName().contains("LauncherUI")) ensureBdayPill(a);
                } catch (Throwable ignore) { }
            }
            else if ("showClearUnread".equals(key)) {
                setOn("showClearUnread", !c.optBoolean("showClearUnread", false));
                toast(cfg().optBoolean("showClearUnread", false) ? "菜单·清未读：显示" : "菜单·清未读：隐藏");
            }
            else if ("showClearList".equals(key)) {
                setOn("showClearList", !c.optBoolean("showClearList", false));
                toast(cfg().optBoolean("showClearList", false) ? "菜单·清列表：显示" : "菜单·清列表：隐藏");
            }
            else if ("tabThemeSave".equals(key)) { askText(a, "保存为主题", "输入主题名称，如 蜘蛛侠", "tabThemeNameTmp"); return; }
            else if ("tabThemeApply".equals(key)) {
                final String[] ts = tabThemeNames();
                if (ts.length == 0) { toast("还没有保存的主题"); return; }
                pickStr(a, "选择主题", ts, "tabThemeNameTmp", ts[0], new Runnable() {
                    @Override public void run() { applyTabTheme(cfg().optString("tabThemeNameTmp", "")); }
                });
                return;
            }
            else if ("tabThemeDelete".equals(key)) {
                final String[] ts2 = tabThemeNames();
                if (ts2.length == 0) { toast("还没有保存的主题"); return; }
                pickStr(a, "删除主题", ts2, "tabThemeNameTmp", ts2[0], new Runnable() {
                    @Override public void run() { deleteTabTheme(cfg().optString("tabThemeNameTmp", "")); }
                });
                return;
            }
            else if ("hideSysTips".equals(key)) { setOn("hideSysTips", !c.optBoolean("hideSysTips", false)); }
            else if ("fwdMax".equals(key)) { cycleFwdMax(); return; }
            else if ("exportBundle".equals(key)) { showBundlePick(a); return; }
            else if ("followUp".equals(key)) { showFollowUp(a); return; }
            else if ("groupRoster".equals(key)) { showGroupRosterPick(a); return; }
            else if ("groupProfile".equals(key)) { showGroupProfilePick(a); return; }
            else if ("fwOn".equals(key)) { showForwardSetting(a); return; }
            else if ("autoRemarkFmt".equals(key)) { showAutoRemarkFmt(a); return; }
        else if ("hideOn".equals(key)) { showHideFriendsSetting(a); return; }
            else if ("quoteGen".equals(key)) { showQuoteGen(a); return; }
            else if ("dealLog".equals(key)) { showDealLog(a); return; }
            else if ("advSearch".equals(key)) { showAdvSearch(a); return; }
            else if ("productMgr".equals(key)) { showProductMgr(a); return; }
            else if ("wordCloud".equals(key)) { showWordCloud(a); return; }
            else if ("groupDaily".equals(key)) { showGroupDailyPick(a); return; }
