                    {"群公告变更记录", "nchg"},
                    {"群成员进出趋势（Markdown）", "trend"},
                    {"一键生成全部报表（5 份）", "allstats"},
                    {"导出功能自检", "selfcheck"},
                    {"消息类型分布（选会话）", "mtype"},
                    {"群 @我 汇总（近 7 天）", "atme"},
                    {"本周回顾（近 7 天）", "week"},
                    {"会话体检报告（未读/沉默/消息量）", "health"},
                    {"备份与归档", "sec"},
                    {"全量媒体归档（图片/语音/视频）", "archive"},
                    {"导出好友 / 群 / 标签 / 全量 zip", "all"},
                    {"每日自动备份全部聊天", "auto"},
                    {"客户与销售", "sec"},
                    {"客户未回复跟进清单（选阈值）", "followUp"},
                    {"群客户名单（谁还没加我）", "roster"},
                    {"联系人备注导出（CRM）", "contacts"},
                    {"成交记录导出（CSV）", "deals"},
                    {"记录与文件", "sec"},
                    {"按人导出聊天记录（我/对方/群成员）", "bysender"},
                    {"群文件清单（文件名/大小/谁发的）", "filelist"},
                    {"高频词统计（看群里在聊什么）", "words"},
                    {"群运营日报（活跃+变动+热词）", "daily"},
                    {"群成员活跃趋势（谁在变冷）", "mtrend"},
