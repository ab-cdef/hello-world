    /* ================= 按月拆分导出 ================= */

    /* ================= 便捷入口：「我」页长按「设置」行 ================= */
    private static volatile long setEntryAt = 0;

    private static void installSettingsEntry(android.app.Activity act) {
        try {
            if (act == null) return;
            if (System.currentTimeMillis() - setEntryAt < 1500) return;
            android.view.View decor = act.getWindow().getDecorView();
            android.view.ViewGroup pager = findPager(decor);
            android.view.View mePage = null;
            if (pager != null) {
                try {
                    int cur = (Integer) pager.getClass().getMethod("getCurrentItem").invoke(pager);
                    if (cur != 3) return;                     // 只在「我」页
                } catch (Throwable t) { return; }
                mePage = pager.getChildAt(3);
            }
            if (mePage == null) return;

            java.util.List<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(mePage, all, 0);
            android.view.View target = null;
            for (android.view.View v : all) {
                if (v.getTag() == Integer.valueOf(0x0f0f0f95)) continue;
                String tx = null;
                if (v instanceof android.widget.TextView) {
                    CharSequence cs = ((android.widget.TextView) v).getText();
                    if (cs != null) tx = cs.toString();
                }
                if (tx == null || tx.trim().length() == 0) {
                    tx = renderedTextOf(v);
                }
                if (tx == null) continue;
                String t = tx.trim();
                if (!"设置".equals(t) && !"Settings".equalsIgnoreCase(t)) continue;
                // 向上找可点的整行
                android.view.View row = v;
                for (int i = 0; i < 4; i++) {
                    if (row.getParent() instanceof android.view.View) row = (android.view.View) row.getParent();
                    else break;
                    if (row.isClickable() && row.getHeight() > dp(act, 30)) break;
                }
                if (row.getWidth() < dp(act, 180)) continue;
                target = row;
                v.setTag(Integer.valueOf(0x0f0f0f95));
                break;
            }
            if (target == null) return;                       // 没找到就什么都不做（不乱挂）
            if (target.getTag() == Integer.valueOf(0x0f0f0f96)) return;
            target.setTag(Integer.valueOf(0x0f0f0f96));
            final android.app.Activity fa = act;
            target.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                @Override public boolean onLongClick(android.view.View x) {
                    try { log("ENTRY|longpress settings row"); showSettings(fa); } catch (Throwable t) { }
                    return true;
                }
            });
            setEntryAt = System.currentTimeMillis();
            log("SETENTRY|installed on " + target.getClass().getSimpleName()
                    + " h=" + target.getHeight());
        } catch (Throwable t) { log("SETENTRY|err " + t); }
    }

