    /** 把 ActionBar / Toolbar / TitleBar 这类标题栏的背景抠成透明，并记录以便拦截重设 */

    /* ============ 朋友圈防删除：把被删除的 Sns 行追加备份到本地 ============ */
    private static synchronized void backupSnsRow(Object db, String table, Object[] args) {
        try {
            if (!cfg().optBoolean("snsAntiDelete", true)) return;
            String where = args.length > 1 && args[1] != null ? String.valueOf(args[1]) : "";
            // 不带条件的删除（清表/整表刷新）也抓前 5 行：朋友圈撤回有时走这种写法，漏了就看不到

            String[] wargs = null;
            if (args.length > 2 && args[2] instanceof String[]) wargs = (String[]) args[2];
            String sql = "select * from " + table + (where.length() > 0 ? " where " + where : "") + " limit 5";
            java.lang.reflect.Method m = null;
            for (java.lang.reflect.Method mm : db.getClass().getMethods()) {
                if (mm.getName().equals("rawQuery") && mm.getParameterTypes().length == 2) { m = mm; break; }
            }
            if (m == null) return;
            Object curObj = m.invoke(db, sql, wargs);
            if (!(curObj instanceof android.database.Cursor)) return;
            android.database.Cursor c = (android.database.Cursor) curObj;
            StringBuilder sb = new StringBuilder();
            int cols = c.getColumnCount();
            int rows = 0;
            while (c.moveToNext() && rows < 5) {
                java.util.HashMap<String, String> kv = new java.util.HashMap<String, String>();
                sb.append("{\"t\":").append(System.currentTimeMillis())
                  .append(",\"table\":\"").append(table).append("\",\"row\":{");
                for (int i = 0; i < cols; i++) {
                    String cn = c.getColumnName(i);
                    String val;
                    try { val = c.getString(i); } catch (Throwable t) { val = ""; }
                    if (val == null) val = "";
                    kv.put(cn.toLowerCase(), val);
                    if (i > 0) sb.append(',');
                    sb.append('"').append(cn).append("\":\"")
                      .append(val.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", ""))
                      .append('"');
                }
                sb.append("}}\n");
                rows++;
                // 朋友圈行被删 = 作者撤回了这条动态：抽作者 + 正文，记成"已撤回"
                if (table.toLowerCase().contains("sns")) snsRecallFromRow(kv);
            }
            c.close();
            if (rows == 0) return;
            java.io.File f = new java.io.File(DIR + "/sns_deleted.jsonl");
            java.io.FileOutputStream os = new java.io.FileOutputStream(f, true);
            os.write(sb.toString().getBytes("UTF-8"));
            os.close();
            log("SNSDEL|backup " + table + " rows=" + rows + " where=" + where);
        } catch (Throwable t) { log("SNSDEL|err " + t); }
    }

    private static java.io.File snsRecallFile() {
        return new java.io.File(DIR + "/sns_recalled.jsonl");
    }

    /** 朋友圈某行被删 = 作者撤回了这条动态：抽作者 + 正文记成"已撤回"，并当场提示 */
    private static void snsRecallFromRow(java.util.HashMap<String, String> kv) {
        try {
            if (kv == null) return;
            String content = kv.get("content");
            if (content == null) content = kv.get("contentxml");
            if (content == null) content = kv.get("attr");
            if (content == null) return;
            String txt = tagOf(content, "contentDesc");
            if (txt.length() == 0) txt = tagOf(content, "title");
            if (txt.length() == 0) {
                String s = content.replaceAll("<[^>]*>", " ").replaceAll("[ \\t\\r\\n]+", " ").trim();
                txt = s;
            }
            if (txt.length() > 200) txt = txt.substring(0, 200);
            int mediaN = 0;
            try {
                int p = 0;
                while ((p = content.indexOf("<media", p)) >= 0) { mediaN++; p += 6; }
            } catch (Throwable ignore) { }
            String who = kv.get("username");
            if (who == null) who = kv.get("user_name");
            if (who == null) who = "";
            long create = 0;
            try { create = Long.parseLong(kv.get("createtime")); } catch (Throwable ignore) { }
            // 同一条动态微信会反复删几次：作者 + 原始发布时间相同就只记一次
            if (dupRecall(who, create, txt)) return;
            StringBuilder line = new StringBuilder();
            line.append("{\"t\":").append(System.currentTimeMillis())
                .append(",\"who\":\"").append(who.replace("\\", "\\\\").replace("\"", "'"))
                .append("\",\"c\":").append(create)
                .append(",\"med\":").append(mediaN)
                .append(",\"x\":\"")
                .append(txt.replace("\\", "\\\\").replace("\"", "'").replace("\n", " ").replace("\r", ""))
                .append("\"}");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(snsRecallFile(), true);
            fo.write((line.toString() + "\n").getBytes("UTF-8"));
            fo.flush();
            fo.close();
            String name = who.length() == 0 ? "对方" : displayOfTalker(who);
            log("SNSRECALL|row " + who + " | " + txt);
            toast(name + " 撤回了朋友圈：" + (txt.length() > 24 ? txt.substring(0, 24) + "…" : txt));
        } catch (Throwable t) { log("SNSRECALL|err " + t); }
    }

    /** 这条撤回记录是否已经记过 */
    private static boolean dupRecall(String who, long create, String txt) {
        try {
            java.io.File f = snsRecallFile();
            if (!f.isFile() || f.length() == 0) return false;
            java.io.BufferedReader br = new java.io.BufferedReader(
                    new java.io.InputStreamReader(new java.io.FileInputStream(f), "UTF-8"));
            String ln;
            while ((ln = br.readLine()) != null) {
                try {
                    org.json.JSONObject o = new org.json.JSONObject(ln);
                    if (who == null || !who.equals(o.optString("who"))) continue;
                    long oc = o.optLong("c");
                    boolean sameTxt = txt == null || txt.equals(o.optString("x"));
                    if (create > 0 && sameTxt && Math.abs(create - oc) <= 3600000L) { br.close(); return true; }
                    if (create <= 0 && sameTxt) { br.close(); return true; }
                } catch (Throwable ignore) { }
            }
            br.close();
        } catch (Throwable ignore) { }
        return false;
    }

    /** 朋友圈已撤回记录 */
    private static void showSnsRecall(final android.app.Activity a) {
        try {
            final java.io.File f = snsRecallFile();
            final java.util.ArrayList<String[]> rows = new java.util.ArrayList<String[]>();
            final java.util.HashSet<String> seen = new java.util.HashSet<String>();
            if (f.isFile() && f.length() > 0) {
                java.io.BufferedReader br = new java.io.BufferedReader(
                        new java.io.InputStreamReader(new java.io.FileInputStream(f), "UTF-8"));
                String ln;
                while ((ln = br.readLine()) != null) {
                    try {
                        org.json.JSONObject o = new org.json.JSONObject(ln);
                        String who = o.optString("who");
                        long c = o.optLong("c");
                        seen.add(who + "|" + c);
                        rows.add(new String[]{who, o.optString("x"),
                                String.valueOf(o.optLong("t")), String.valueOf(o.optInt("med"))});
                    } catch (Throwable ignore) { }
                }
                br.close();
            }
            // 兜底数据源：朋友圈整行备份里同样留着被撤回的内容，记录文件丢了也不至于什么都看不到
            java.io.File del = new java.io.File(DIR + "/sns_deleted.jsonl");
            if (del.isFile() && del.length() > 0) {
                java.io.BufferedReader br2 = new java.io.BufferedReader(
                        new java.io.InputStreamReader(new java.io.FileInputStream(del), "UTF-8"));
                String ln;
                while ((ln = br2.readLine()) != null) {
                    try {
                        org.json.JSONObject o = new org.json.JSONObject(ln);
                        org.json.JSONObject row = o.optJSONObject("row");
                        if (row == null) continue;
                        String table = o.optString("table").toLowerCase();
                        if (!table.contains("sns")) continue;
                        String content = row.optString("content");
                        if (content.length() == 0) content = row.optString("attr");
                        String txt = tagOf(content, "contentDesc");
                        if (txt.length() == 0) txt = tagOf(content, "title");
                        if (txt.length() == 0) {
                            txt = content.replaceAll("<[^>]*>", " ").replaceAll("[ \\t\\r\\n]+", " ").trim();
                        }
                        if (txt.length() > 200) txt = txt.substring(0, 200);
                        String who = row.optString("username");
                        long c = 0;
                        try { c = Long.parseLong(row.optString("createtime")); } catch (Throwable ignore) { }
                        String key = who + "|" + c;
                        if (seen.contains(key)) continue;
                        seen.add(key);
                        int mediaN2 = 0;
                        int p2 = 0;
                        while ((p2 = content.indexOf("<media", p2)) >= 0) { mediaN2++; p2 += 6; }
                        rows.add(new String[]{who, txt, String.valueOf(o.optLong("t")), String.valueOf(mediaN2)});
                    } catch (Throwable ignore) { }
                }
                br2.close();
            }
            if (rows.isEmpty()) {
                alert("朋友圈已撤回", "还没有记录。\n\n保持「圈防删」开启，好友删掉自己的朋友圈时这里会自动记下作者和正文。");
                return;
            }
            java.util.Collections.sort(rows, new java.util.Comparator<String[]>() {
                @Override public int compare(String[] a, String[] b) {
                    long x = 0, y = 0;
                    try { x = Long.parseLong(a[2]); } catch (Throwable ignore) { }
                    try { y = Long.parseLong(b[2]); } catch (Throwable ignore) { }
                    return y > x ? 1 : (y < x ? -1 : 0);
                }
            });
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 14), dp(a, 8), dp(a, 14), dp(a, 8));
            android.widget.TextView head = new android.widget.TextView(a);
            head.setText("已撤回 " + rows.size() + " 条（长按清空）");
            head.setTextSize(12);
            head.setTextColor(0xFF888888);
            box.addView(head);
            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            for (int i = 0; i < rows.size() && i < 200; i++) {
                String[] r = rows.get(i);
                android.widget.TextView tv = new android.widget.TextView(a);
                String who = r[0].length() == 0 ? "对方" : displayOfTalker(r[0]);
                int med = 0;
                try { med = Integer.parseInt(r[3]); } catch (Throwable ignore) { }
                String body = r[1];
                if (body.length() == 0) {
                    body = med > 0 ? "（配图 " + med + " 张，没有文字）" : "（纯图片/链接动态，没有文字）";
                } else if (med > 0) {
                    body = body + "\n（配图 " + med + " 张）";
                }
                tv.setText(fmtTs(Long.parseLong(r[2])).substring(5, 16) + "　" + who + " 已撤回\n" + body);
                tv.setTextSize(13);
                tv.setTextColor(0xFF222222);
                tv.setPadding(0, dp(a, 8), 0, dp(a, 8));
                list.addView(tv);
                android.view.View div = new android.view.View(a);
                div.setBackgroundColor(0x1A000000);
                list.addView(div, new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT, 1));
            }
            list.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                @Override public boolean onLongClick(android.view.View v) {
                    new android.app.AlertDialog.Builder(a).setTitle("清空已撤回记录？")
                            .setPositiveButton("清空", new android.content.DialogInterface.OnClickListener() {
                                @Override public void onClick(android.content.DialogInterface d, int w) {
                                    f.delete();
                                    toast("已清空");
                                }
                            }).setNegativeButton("取消", null).show();
                    return true;
                }
            });
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(a, 470)));
            new android.app.AlertDialog.Builder(a).setTitle("朋友圈已撤回").setView(box)
                    .setPositiveButton("关闭", null).show();
            log("SNSRECALL|view n=" + rows.size());
        } catch (Throwable t) { log("SNSRECALL|view err " + t); }
    }

    /** 查看朋友圈删除备份 */
    private static void showSnsDeleted(android.app.Activity a) {        try {
            java.io.File f = new java.io.File(DIR + "/sns_deleted.jsonl");
            if (!f.isFile() || f.length() == 0) { toast("暂无删除记录"); return; }
            java.io.BufferedReader br = new java.io.BufferedReader(
                    new java.io.InputStreamReader(new java.io.FileInputStream(f), "UTF-8"));
            java.util.ArrayList<String> lines = new java.util.ArrayList<String>();
            String ln;
            while ((ln = br.readLine()) != null) lines.add(ln);
            br.close();
            StringBuilder sb = new StringBuilder();
            int start = Math.max(0, lines.size() - 30);
            for (int i = lines.size() - 1; i >= start; i--) {
                String l = lines.get(i);
                sb.append(l.length() > 220 ? l.substring(0, 220) + "…" : l).append("\n\n");
            }
            alert("朋友圈删除备份（" + lines.size() + " 条）", sb.toString());
        } catch (Throwable t) { toast("读取失败：" + t); }
    }


    /** 拦截微信对已抠过的标题栏重设底色 */
    private static void installBarGuard() {
        if (barGuardInstalled) return;
        barGuardInstalled = true;
        try {
            XC_MethodHook h = new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam pm) {
                    try {
                        Object o = pm.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        if (barCleared.get((android.view.View) o) == Boolean.TRUE) pm.setResult(null);
                    } catch (Throwable ignore) { }
                }
            };
            XposedBridge.hookAllMethods(android.view.View.class, "setBackgroundColor", h);
            XposedBridge.hookAllMethods(android.view.View.class, "setBackgroundResource", h);
            XposedBridge.hookAllMethods(android.view.View.class, "setBackgroundDrawable", h);
            log("BAR|guard installed");
        } catch (Throwable t) { log("BAR|guard err " + t); }
    }


    /* ---------- 四页背景图：从相册选图（WCX pickImageForTab 同款） ---------- */
    private static final int REQ_PICK_TAB = 0x7A10;
    private static volatile boolean pickHookInstalled = false;

    private static void installPickHook() {
        if (pickHookInstalled) return;
        pickHookInstalled = true;
        try {
            XposedBridge.hookAllMethods(android.app.Activity.class, "onActivityResult", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam pm) {
                    try {
                        int req = (Integer) pm.args[0];
                        int res = (Integer) pm.args[1];
                        Object data = pm.args[2];
                        if (req < REQ_PICK_TAB || req > REQ_PICK_TAB + 3) return;
                        if (res != android.app.Activity.RESULT_OK || data == null) return;
                        final int idx = req - REQ_PICK_TAB;
                        android.content.Intent it = (android.content.Intent) data;
                        android.net.Uri uri = it.getData();
                        if (uri == null) return;
                        android.content.Context ctx = (android.content.Context) pm.thisObject;
                        java.io.InputStream in = ctx.getContentResolver().openInputStream(uri);
                        if (in == null) return;
                        java.io.File out = new java.io.File(DIR + "/tab_bg_" + idx + ".jpg");
                        java.io.FileOutputStream fos = new java.io.FileOutputStream(out, false);
                        byte[] buf = new byte[16384];
                        int n;
                        while ((n = in.read(buf)) > 0) fos.write(buf, 0, n);
                        fos.close();
                        in.close();
                        toast("第 " + (idx + 1) + " 页背景已设置");
                        log("PICKBG|page" + idx + " " + out.length() + "B");
                        tabBgBm.clear();
                        android.app.Activity a = (android.app.Activity) pm.thisObject;
                        decorateAllTabs(a);
                    } catch (Throwable t) { log("PICKBG|err " + t); }
                }
            });
            log("PICKBG|hook installed");
        } catch (Throwable t) { log("PICKBG|hook err " + t); }
    }

    private static void pickTabImage(android.app.Activity a, int idx) {
        try {
            installPickHook();
            android.content.Intent it = new android.content.Intent(android.content.Intent.ACTION_GET_CONTENT);
            it.setType("image/*");
            it.addCategory(android.content.Intent.CATEGORY_OPENABLE);
            a.startActivityForResult(android.content.Intent.createChooser(it, "选择第 " + (idx + 1) + " 页背景"), REQ_PICK_TAB + idx);
        } catch (Throwable t) {
            try { toast("打开相册失败：" + t); } catch (Throwable ignore) { }
        }
    }

    private static void clearTabImage(int idx) {
        try {
            new java.io.File(DIR + "/tab_bg_" + idx + ".jpg").delete();
            tabBgBm.clear();
            toast("第 " + (idx + 1) + " 页已恢复主题包图片");
        } catch (Throwable ignore) { }
    }








    /** 隐藏发现页里指定的入口行（默认 直播/购物/游戏） */
    private static void hideDiscoverItems(android.app.Activity a) {
        try {
            String raw = cfg().optString("hideDiscItems", "直播,购物,游戏");
            if (raw == null || raw.trim().length() == 0) return;
            if (a == null || !a.getClass().getName().endsWith("LauncherUI")) return;
            if (isInChatUi()) return;
            android.view.ViewGroup pager = tabPager;
            if (pager == null) { pager = findPager(a.getWindow().getDecorView()); tabPager = pager; }
            if (pager == null) return;
            int pg;
            try { pg = (Integer) pager.getClass().getMethod("getCurrentItem").invoke(pager); }
            catch (Throwable t) { return; }
            if (pg != 2) return;                      // 只在「发现」页
            String[] words = raw.split("[,，]");
            android.view.View page = pager.getChildAt(2);
            if (page == null) return;
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(page, all, 0);
            for (android.view.View v : all) {
                if (!(v instanceof android.widget.TextView)) continue;
                CharSequence tx = ((android.widget.TextView) v).getText();
                if (tx == null) continue;
                String t = tx.toString().trim();
                if (t.length() == 0 || t.length() > 10) continue;
                for (String w : words) {
                    String ww = w.trim();
                    if (ww.length() > 0 && t.equals(ww)) {
                        android.view.View row = (android.view.View) v.getParent();
                        if (row != null && row.getTag(0x0f0f0f72) == null) {
                            row.setTag(0x0f0f0f72, "hide");
                            row.setVisibility(android.view.View.GONE);
                            log("HIDEDISC|" + t);
                        }
                        break;
                    }
                }
            }
        } catch (Throwable ignore) { }
    }










    /* ================= 解除语音录制时长（逆向依据） =================
     * ChatFooter 静态方法 c(ChatFooter) 里：
     *     const/16 v2, 0x3c
     *     iput v2, v0, ChatFooter;->k6:I        // 语音最长 60 秒
     * hook 该方法 after，把字段 k6 改成 300。
     */
    private static volatile boolean longVoiceHooked = false;

    private static void installLongVoice(final ClassLoader app) {
        if (longVoiceHooked) return;
        longVoiceHooked = true;
        try {
            final Class<?> c = Class.forName("com.tencent.mm.pluginsdk.ui.chat.ChatFooter", false, app);
            // 静态方法 c(ChatFooter)：初始化语音参数
            for (java.lang.reflect.Method m : c.getDeclaredMethods()) {
                if (!"c".equals(m.getName())) continue;
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length != 1 || ps[0] != c) continue;
                XposedBridge.hookMethod(m, new XC_MethodHook() {
                    @Override protected void afterHookedMethod(MethodHookParam pm) {
                        try {
                            if (!cfg().optBoolean("longVoice", false)) return;
                            Object footer = pm.args[0];
                            if (footer == null) return;
                            java.lang.reflect.Field k6 = c.getDeclaredField("k6");
                            k6.setAccessible(true);
                            k6.setInt(footer, 300);
                        } catch (Throwable ignore) { }
                    }
                });
                log("LONGVOICE|hooked c(ChatFooter)");
            }
        } catch (Throwable t) { log("LONGVOICE|err " + t); }
    }


    /* ================= 解除媒体发送数量限制 =================
     * 逆向结论：AlbumPreviewUI 的数量上限来自 Intent extra "max_select_count"（默认 9），
     * 不是硬编码常量。所以在 onCreate 之前把 extra 改大即可。
     */
    private static volatile boolean maxSelHooked = false;

    /* ================= 会话体检报告 =================
     * 纯只读：扫 rconversation + message，输出未读堆积、长期沉默、消息量排行，
     * 存 CSV 到 Download/wxh/session_health_<时间>.csv，并在弹窗里给摘要。
     */
    static volatile String healthStage = "";

    /** 只读调研：rconversation 表结构 + 每个会话的 flag 值 */
    /* ================= 群成员进出趋势 ================= */
    private static int buildMemberTrend(String[] outPath) {
        int n = 0;
        try {
            java.io.File f = new java.io.File(DIR + "/group_changes.jsonl");
            java.util.ArrayList<org.json.JSONObject> all = new java.util.ArrayList<org.json.JSONObject>();
            if (f.isFile()) {
                java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
                String ln;
                while ((ln = br.readLine()) != null) {
                    if (ln.trim().length() == 0) continue;
                    try { all.add(new org.json.JSONObject(ln)); } catch (Throwable ignore) { }
                }
                br.close();
            }
            n = all.size();
            java.text.SimpleDateFormat dayF =
                    new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
            java.util.TreeMap<String, int[]> byDay = new java.util.TreeMap<String, int[]>();
            java.util.LinkedHashMap<String, int[]> byGroup = new java.util.LinkedHashMap<String, int[]>();
            for (org.json.JSONObject o : all) {
                String kind = o.optString("kind", "");
                long ts = o.optLong("ts", 0);
                if (ts <= 0) continue;
                boolean join = kind.contains("入群") || kind.contains("新人");
                boolean quit = kind.contains("退群") || kind.contains("移出") || kind.contains("移出群聊");
                if (!join && !quit) continue;
                String day = dayF.format(new java.util.Date(ts));
                int[] d = byDay.get(day);
                if (d == null) { d = new int[2]; byDay.put(day, d); }
                String nm = o.optString("name", "");
                if (nm.length() == 0) nm = o.optString("talker", "");
                int[] g = byGroup.get(nm);
                if (g == null) { g = new int[2]; byGroup.put(nm, g); }
                if (join) { d[0]++; g[0]++; } else { d[1]++; g[1]++; }
            }

            StringBuilder md = new StringBuilder();
            md.append("# 群成员进出趋势\n\n> 生成时间 ")
              .append(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                      .format(new java.util.Date()))
              .append(" · 数据源 group_changes.jsonl（共 ").append(n).append(" 条记录）\n\n");

            int tj = 0, tq = 0;
            for (int[] v : byDay.values()) { tj += v[0]; tq += v[1]; }
            md.append("合计：入群 **").append(tj).append("** 人次 · 退群 **").append(tq)
              .append("** 人次 · 净变化 ").append(tj - tq >= 0 ? "+" : "").append(tj - tq).append("\n\n");

            md.append("## 按天\n\n| 日期 | 入群 | 退群 | 净 |\n|---|---|---|---|\n");
            for (java.util.Map.Entry<String, int[]> e : byDay.entrySet()) {
                int[] v = e.getValue();
                md.append("| ").append(e.getKey()).append(" | ").append(v[0]).append(" | ")
                  .append(v[1]).append(" | ").append(v[0] - v[1] >= 0 ? "+" : "").append(v[0] - v[1])
                  .append(" |\n");
            }
            if (byDay.isEmpty()) md.append("| —— | 0 | 0 | 0 |\n");

            // 近 14 天净变化文本曲线
            try {
                java.util.ArrayList<String> days = new java.util.ArrayList<String>(byDay.keySet());
                int from = Math.max(0, days.size() - 14);
                java.util.ArrayList<Integer> vals = new java.util.ArrayList<Integer>();
                java.util.ArrayList<String> labels = new java.util.ArrayList<String>();
                for (int i = from; i < days.size(); i++) {
                    String d0 = days.get(i);
                    int[] v0 = byDay.get(d0);
                    vals.add(v0[0] - v0[1]);
                    labels.add(d0.length() >= 10 ? d0.substring(5) : d0);
                }
                if (!vals.isEmpty()) {
                    int mn = vals.get(0), mx = vals.get(0);
                    for (int v0 : vals) { if (v0 < mn) mn = v0; if (v0 > mx) mx = v0; }
                    String ramp = "▁▂▃▄▅▆▇█";
                    StringBuilder line = new StringBuilder();
                    for (int v0 : vals) {
                        int idx = (mx == mn) ? 3 : (int) Math.round((v0 - mn) * 7.0 / (mx - mn));
                        if (idx < 0) idx = 0;
                        if (idx > 7) idx = 7;
                        line.append(ramp.charAt(idx));
                    }
                    md.append("\n## 净增曲线（最近 ").append(vals.size()).append(" 天）\n\n");
                    md.append("`").append(line).append("`\n\n");
                    md.append("范围：").append(labels.get(0)).append(" ~ ")
                      .append(labels.get(labels.size() - 1))
                      .append(" · 最低 ").append(mn).append(" / 最高 ").append(mx).append("\n");
                }
            } catch (Throwable ignore) { }

            md.append("\n## 按群\n\n| 群 | 入群 | 退群 | 净 |\n|---|---|---|---|\n");
            java.util.ArrayList<java.util.Map.Entry<String, int[]>> gl =
                    new java.util.ArrayList<java.util.Map.Entry<String, int[]>>(byGroup.entrySet());
            java.util.Collections.sort(gl, new java.util.Comparator<java.util.Map.Entry<String, int[]>>() {
                @Override public int compare(java.util.Map.Entry<String, int[]> x,
                                             java.util.Map.Entry<String, int[]> y) {
                    return (y.getValue()[0] + y.getValue()[1]) - (x.getValue()[0] + x.getValue()[1]);
                }
            });
            for (java.util.Map.Entry<String, int[]> e : gl) {
                int[] v = e.getValue();
                md.append("| ").append(e.getKey().replace("|", "/")).append(" | ").append(v[0])
                  .append(" | ").append(v[1]).append(" | ")
                  .append(v[0] - v[1] >= 0 ? "+" : "").append(v[0] - v[1]).append(" |\n");
            }
            if (gl.isEmpty()) md.append("| —— | 0 | 0 | 0 |\n");

            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
            dir.mkdirs();
            java.io.File out = new java.io.File(dir, "member_trend_"
                    + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                    .format(new java.util.Date()) + ".md");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            fo.write(md.toString().getBytes("UTF-8"));
            fo.close();
            if (outPath != null && outPath.length > 0) outPath[0] = out.getAbsolutePath();
            log("MTREND|records=" + n + " join=" + tj + " quit=" + tq + " days=" + byDay.size()
                    + " groups=" + byGroup.size() + " path=" + out.getAbsolutePath());
        } catch (Throwable t) { log("MTREND|err " + t); }
        return n;
    }

    private static void runMemberTrend(final android.app.Activity a) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final String[] path = new String[1];
                final int n = buildMemberTrend(path);
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("群成员进出趋势")
                                .setMessage("记录 " + n + " 条\n\n"
                                        + (path[0] == null ? "生成失败" : path[0]))
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    /* ================= 群公告变更记录 =================
     * 每次进微信（30 分钟内只跑一次）对比 chatroom.chatroomnotice 的哈希，
     * 变了就往 files/notice_changes.jsonl 追加一条（时间/群/新公告前 600 字）。
     */
    private static String md5Of(String s) {
        try {
            java.security.MessageDigest md = java.security.MessageDigest.getInstance("MD5");
            byte[] d = md.digest(s.getBytes("UTF-8"));
            StringBuilder sb = new StringBuilder();
            for (byte b : d) sb.append(String.format("%02x", b & 0xFF));
            return sb.toString();
        } catch (Throwable t) { return ""; }
    }

    private static void checkNoticeChanges() {
        try {
            java.io.File snap = new java.io.File(DIR, "notice_snapshot.json");
            java.io.File logF = new java.io.File(DIR, "notice_changes.jsonl");
            long now = System.currentTimeMillis();
            if (snap.isFile() && now - snap.lastModified() < 30L * 60000L) return;
            java.util.List<Object[]> rows = queryRowsAll(
                    "select chatroomname, ifnull(chatroomnotice,'') from chatroom");
            org.json.JSONObject old = new org.json.JSONObject();
            if (snap.isFile()) {
                try {
                    byte[] b = readAllBytes(snap);
                    if (b != null) old = new org.json.JSONObject(new String(b, "UTF-8"));
                } catch (Throwable ignore) { }
            }
            org.json.JSONObject cur = new org.json.JSONObject();
            int changed = 0;
            java.util.ArrayList<String> changedNames = new java.util.ArrayList<String>();
            for (Object[] r : rows) {
                String tk = r[0] == null ? "" : String.valueOf(r[0]);
                String notice = r[1] == null ? "" : String.valueOf(r[1]);
                if (tk.length() == 0) continue;
                String h = md5Of(notice);
                cur.put(tk, h);
                if (!old.has(tk)) continue;
                String oh = old.optString(tk, "");
                if (oh.length() == 0 || oh.equals(h)) continue;
                // 公告变了
                String nm = displayOfTalker(tk);
                org.json.JSONObject rec = new org.json.JSONObject();
                rec.put("ts", now);
                rec.put("talker", tk);
                rec.put("name", nm);
                String txt = notice.replace("\r", "");
                // 保留完整公告（最多 8000 字），并记下上一版用于 diff
                String prev = "";
                try {
                    java.util.List<Object[]> pr = queryRows(
                            "select ifnull(chatroomnotice,'') from chatroom where chatroomname='"
                                    + escSql(tk) + "' limit 1", 1);
                    // 库里只有"当前值"，上一版只能从我们自己的记录里取
                } catch (Throwable ignore) { }
                java.util.List<org.json.JSONObject> hist = readNoticeHist(tk, 1);
                if (!hist.isEmpty()) prev = hist.get(0).optString("text", "");
                if (txt.length() > 8000) txt = txt.substring(0, 8000) + "…";
                rec.put("text", txt);
                if (prev.length() > 0 && prev.length() <= 8000) rec.put("prev", prev);
                java.io.FileWriter fw = new java.io.FileWriter(logF, true);
                fw.write(rec.toString() + "\n");
                fw.close();
                changed++;
                changedNames.add(nm);
                log("NCHG|" + nm + " changed");
            }
            if (changed > 0 && cfg().optBoolean("noticeNotify", true)) {
                try {
                    android.app.Activity ta = topAct;
                    if (ta != null) {
                        StringBuilder nb = new StringBuilder();
                        for (int i = 0; i < Math.min(3, changedNames.size()); i++) {
                            if (i > 0) nb.append("、");
                            nb.append(changedNames.get(i));
                        }
                        if (changed > 3) nb.append(" 等 ").append(changed).append(" 个群");
                        notifyLocal(ta, "群公告变更", nb.toString());
                        log("NCHG|notify " + nb);
                    }
                } catch (Throwable ignore) { }
            }
            java.io.FileOutputStream fo = new java.io.FileOutputStream(snap);
            fo.write(cur.toString().getBytes("UTF-8"));
            fo.close();
            log("NCHG|checked=" + rows.size() + " changed=" + changed
                    + " first=" + (old.length() == 0));
        } catch (Throwable t) { log("NCHG|err " + t); }
    }

    private static java.util.ArrayList<org.json.JSONObject> readNoticeChanges() {
        java.util.ArrayList<org.json.JSONObject> out = new java.util.ArrayList<org.json.JSONObject>();
        try {
            java.io.File f = new java.io.File(DIR, "notice_changes.jsonl");
            if (!f.isFile()) return out;
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            String ln;
            while ((ln = br.readLine()) != null) {
                if (ln.trim().length() == 0) continue;
                try { out.add(new org.json.JSONObject(ln)); } catch (Throwable ignore) { }
            }
            br.close();
        } catch (Throwable ignore) { }
        return out;
    }

    /** 读某群的公告变更历史（ts 倒序），n<=0 表示全部 */
    private static java.util.List<org.json.JSONObject> readNoticeHist(String talker, int n) {
        java.util.List<org.json.JSONObject> out = new java.util.ArrayList<org.json.JSONObject>();
        try {
            java.io.File f = new java.io.File(DIR, "notice_changes.jsonl");
            if (!f.isFile()) return out;
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            String ln;
            while ((ln = br.readLine()) != null) {
                ln = ln.trim();
                if (ln.length() == 0) continue;
                try {
                    org.json.JSONObject o = new org.json.JSONObject(ln);
                    if (talker.equals(o.optString("talker", ""))) out.add(o);
                } catch (Throwable ignore) { }
            }
            br.close();
            java.util.Collections.sort(out, new java.util.Comparator<org.json.JSONObject>() {
                @Override public int compare(org.json.JSONObject a, org.json.JSONObject b) {
                    return Long.compare(b.optLong("ts", 0), a.optLong("ts", 0));
                }
            });
            if (n > 0 && out.size() > n) return new java.util.ArrayList<org.json.JSONObject>(out.subList(0, n));
        } catch (Throwable ignore) { }
        return out;
    }

    /** 简易 diff：按行比对，输出 +新增 / -删除 行 */
    private static String diffText(String oldT, String newT) {
        try {
            java.util.List<String> a = new java.util.ArrayList<String>();
            java.util.List<String> b = new java.util.ArrayList<String>();
            for (String x : (oldT == null ? "" : oldT).split("\n")) if (x.trim().length() > 0) a.add(x.trim());
            for (String x : (newT == null ? "" : newT).split("\n")) if (x.trim().length() > 0) b.add(x.trim());
            StringBuilder sb = new StringBuilder();
            for (String x : b) if (!a.contains(x)) sb.append("+ ").append(x).append('\n');
            for (String x : a) if (!b.contains(x)) sb.append("- ").append(x).append('\n');
            if (sb.length() == 0) sb.append("（仅空格/换行变化）\n");
            return sb.toString();
        } catch (Throwable t) { return "(diff 失败)\n"; }
    }

    /** 只看某群公告的完整变更历史（带 diff） */
    private static void showNoticeHistory(final android.app.Activity a) {
        final java.util.List<String[]> gs = convGroups();
        if (gs.isEmpty()) { toast("没有群聊"); return; }
        String[] names = new String[gs.size()];
        for (int i = 0; i < gs.size(); i++) names[i] = displayOfTalker(gs.get(i)[0]);
        new android.app.AlertDialog.Builder(a)
                .setTitle("看哪个群的公告历史")
                .setItems(names, new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) {
                        String tk = gs.get(which)[0];
                        java.util.List<org.json.JSONObject> hist = readNoticeHist(tk, 0);
                        StringBuilder sb = new StringBuilder();
                        if (hist.isEmpty()) sb.append("这个群还没有记录到公告变更。");
                        for (int i = 0; i < hist.size(); i++) {
                            org.json.JSONObject o = hist.get(i);
                            sb.append(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                                    .format(new java.util.Date(o.optLong("ts", 0))));
                            sb.append(hist.size() > 1 ? ("  #" + (hist.size() - i)) : "");
                            sb.append('\n');
                            String prev = o.optString("prev", "");
                            if (prev.length() > 0) {
                                sb.append(diffText(prev, o.optString("text", "")));
                            } else {
                                sb.append("（最早一版，无对比）\n").append(o.optString("text", "")).append('\n');
                            }
                            sb.append("────────\n");
                            if (sb.length() > 3000) { sb.append("… 更多记录请导出 CSV"); break; }
                        }
                        new android.app.AlertDialog.Builder(a)
                                .setTitle(displayOfTalker(tk) + " · 公告变更 " + hist.size() + " 次")
                                .setMessage(sb.toString())
                                .setPositiveButton("关闭", null)
                                .show();
                        log("NHIST|" + tk + " n=" + hist.size());
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static void showNoticeChanges(final android.app.Activity a) {
        final java.util.ArrayList<org.json.JSONObject> all = readNoticeChanges();
        try {
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 10), dp(a, 8), dp(a, 10), dp(a, 8));

            android.widget.TextView head = new android.widget.TextView(a);
            head.setText(all.isEmpty() ? "还没有记录到公告变更（每次进微信会检查一次，首次只建立基线）"
                    : "共 " + all.size() + " 条公告变更，最新的在最上面");
            head.setTextSize(12);
            head.setTextColor(0xFF888888);
            head.setPadding(dp(a, 6), dp(a, 4), dp(a, 6), dp(a, 10));
            box.addView(head);

            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 460)));
            java.text.SimpleDateFormat f =
                    new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US);
            for (int i = all.size() - 1; i >= 0 && i >= all.size() - 50; i--) {
                org.json.JSONObject o = all.get(i);
                android.widget.TextView tv = new android.widget.TextView(a);
                long ts = o.optLong("ts", 0);
                String txt = o.optString("text", "");
                if (txt.length() > 160) txt = txt.substring(0, 160) + "…";
                tv.setText((ts > 0 ? f.format(new java.util.Date(ts)) : "") + "  "
                        + o.optString("name", "") + "\n" + txt);
                tv.setTextSize(13);
                tv.setTextColor(0xFF1A1A1E);
                tv.setPadding(dp(a, 10), dp(a, 8), dp(a, 10), dp(a, 8));
                android.graphics.drawable.GradientDrawable g =
                        new android.graphics.drawable.GradientDrawable();
                g.setColor(0xF7FFFFFF);
                g.setCornerRadius(dp(a, 10));
                tv.setBackground(g);
                android.widget.LinearLayout.LayoutParams lp =
                        new android.widget.LinearLayout.LayoutParams(-1, -2);
                lp.bottomMargin = dp(a, 6);
                tv.setLayoutParams(lp);
                list.addView(tv);
            }

            new android.app.AlertDialog.Builder(a)
                    .setTitle("群公告变更记录")
                    .setView(box)
                    .setPositiveButton("导出 Markdown", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            exportNoticeChanges(a);
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { toast("打开失败"); }
    }

    private static void exportNoticeChanges(final android.app.Activity a) {
        try {
            java.util.ArrayList<org.json.JSONObject> all = readNoticeChanges();
            StringBuilder md = new StringBuilder("# 群公告变更记录\n\n> 生成时间 ")
                    .append(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                            .format(new java.util.Date()))
                    .append(" · 共 ").append(all.size()).append(" 条\n\n");
            java.text.SimpleDateFormat f =
                    new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US);
            for (int i = all.size() - 1; i >= 0; i--) {
                org.json.JSONObject o = all.get(i);
                long ts = o.optLong("ts", 0);
                md.append("## ").append(o.optString("name", "")).append("\n\n")
                  .append("> ").append(ts > 0 ? f.format(new java.util.Date(ts)) : "")
                  .append(" · `").append(o.optString("talker", "")).append("`\n\n");
                for (String line : o.optString("text", "").split("\n")) {
                    md.append("> ").append(line).append('\n');
                }
                md.append('\n');
            }
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
            dir.mkdirs();
            java.io.File out = new java.io.File(dir, "notice_changes_"
                    + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                    .format(new java.util.Date()) + ".md");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            fo.write(md.toString().getBytes("UTF-8"));
            fo.close();
            toast("已导出：\n" + out.getAbsolutePath());
            log("NCHG|export n=" + all.size() + " path=" + out.getAbsolutePath());
        } catch (Throwable t) { toast("导出失败"); }
    }

    /* ================= 会话体检 Markdown ================= */
    private static int buildHealthMd(String[] outPath) {
        int rows = 0;
        try {
            java.util.List<Object[]> conv = queryRows(
                    "select username, ifnull(unReadCount,0), ifnull(conversationTime,0)"
                            + " from rconversation where username is not null and username != ''", 3);
            rows = conv.size();
            long now = System.currentTimeMillis();
            long d7 = now - 7L * 86400000L;
            long d30 = now - 30L * 86400000L;
            long d90 = now - 90L * 86400000L;

            java.util.HashMap<String, Integer> c30 = new java.util.HashMap<String, Integer>();
            try {
                for (Object[] a2 : queryRows("select talker, count(*) c from message where createTime>="
                        + sinceRaw(d30) + " group by talker", 2)) {
                    if (a2[0] == null) continue;
                    try { c30.put(String.valueOf(a2[0]), Integer.parseInt(String.valueOf(a2[1]))); }
                    catch (Throwable ignore) { }
                }
            } catch (Throwable ignore) { }
            java.util.HashMap<String, Long> firstMs = new java.util.HashMap<String, Long>();
            try {
                for (Object[] a3 : queryRows("select talker, min(createTime) from message group by talker", 2)) {
                    if (a3[0] == null || a3[1] == null) continue;
                    long v = 0;
                    try { v = ctToMs(Long.parseLong(String.valueOf(a3[1]))); } catch (Throwable ignore) { }
                    firstMs.put(String.valueOf(a3[0]), v);
                }
            } catch (Throwable ignore) { }

            java.util.ArrayList<Object[]> unread = new java.util.ArrayList<Object[]>();
            java.util.ArrayList<Object[]> busy = new java.util.ArrayList<Object[]>();
            java.util.ArrayList<Object[]> silent = new java.util.ArrayList<Object[]>();
            java.util.ArrayList<Object[]> stale = new java.util.ArrayList<Object[]>();
            java.util.ArrayList<Object[]> fresh = new java.util.ArrayList<Object[]>();

            for (Object[] r : conv) {
                String tk = String.valueOf(r[0]);
                int un = 0;
                long ct = 0;
                try { un = Integer.parseInt(String.valueOf(r[1])); } catch (Throwable ignore) { }
                try { ct = ctToMs(Long.parseLong(String.valueOf(r[2]))); } catch (Throwable ignore) { }
                Integer c = c30.get(tk);
                int c30v = c == null ? 0 : c;
                String nm = displayOfTalker(tk);
                boolean grp = tk.endsWith("@chatroom");
                if (un >= 100) unread.add(new Object[]{nm, un, tk});
                if (c30v >= 500) busy.add(new Object[]{nm, c30v, tk});
                if (grp && ct > 0 && ct < d90) silent.add(new Object[]{nm, ct, tk});
                if (un > 0 && ct > 0 && ct < d7) stale.add(new Object[]{nm, un, tk});
                Long f = firstMs.get(tk);
                if (f != null && f > 0 && f > d7) fresh.add(new Object[]{nm, f, tk});
            }
            java.text.SimpleDateFormat fd =
                    new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US);
            java.util.Comparator<Object[]> byNum = new java.util.Comparator<Object[]>() {
                @Override public int compare(Object[] x, Object[] y) {
                    return ((Integer) y[1]) - ((Integer) x[1]);
                }
            };
            java.util.Collections.sort(unread, byNum);
            java.util.Collections.sort(busy, byNum);
            java.util.Collections.sort(stale, byNum);

            StringBuilder md = new StringBuilder();
            md.append("# 会话体检报告\n\n> 生成时间 ")
              .append(fd.format(new java.util.Date()))
              .append(" · 共 ").append(rows).append(" 个会话\n\n");
            md.append("- 未读堆积（≥100）：").append(unread.size()).append("\n")
              .append("- 近30天消息量大（≥500）：").append(busy.size()).append("\n")
              .append("- 群 90 天没动静：").append(silent.size()).append("\n")
              .append("- 长期未读（>7天还有未读）：").append(stale.size()).append("\n")
              .append("- 本周新增会话：").append(fresh.size()).append("\n\n");

            String[][] secs = {{"未读堆积", "0"}, {"近30天消息量大", "1"}, {"长期未读", "3"}};
            Object[][] datas = {{unread}, {busy}, {stale}};
            for (int si = 0; si < secs.length; si++) {
                java.util.ArrayList<Object[]> list = (java.util.ArrayList<Object[]>) datas[si][0];
                md.append("## ").append(secs[si][0]).append("（").append(list.size()).append("）\n\n");
                if (list.isEmpty()) { md.append("无\n\n"); continue; }
                for (int i = 0; i < Math.min(20, list.size()); i++) {
                    Object[] o = list.get(i);
                    md.append("- **").append(o[0]).append("** ");
                    if (si == 1) md.append(o[1]).append(" 条");
                    else md.append("未读 ").append(o[1]);
                    md.append(" · `").append(o[2]).append("`\n");
                }
                if (list.size() > 20) md.append("- … 还有 ").append(list.size() - 20).append(" 个\n");
                md.append('\n');
            }
            md.append("## 群 90 天没动静（").append(silent.size()).append("）\n\n");
            if (silent.isEmpty()) md.append("无\n");
            else for (int i = 0; i < Math.min(20, silent.size()); i++) {
                Object[] o = silent.get(i);
                md.append("- ").append(o[0]).append(" · 最后 ")
                  .append(fd.format(new java.util.Date((Long) o[1]))).append('\n');
            }
            md.append("\n## 本周新增会话（").append(fresh.size()).append("）\n\n");
            if (fresh.isEmpty()) md.append("无\n");
            else for (int i = 0; i < Math.min(20, fresh.size()); i++) {
                Object[] o = fresh.get(i);
                md.append("- ").append(o[0]).append(" · 首条 ")
                  .append(fd.format(new java.util.Date((Long) o[1]))).append('\n');
            }

            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
            dir.mkdirs();
            java.io.File out = new java.io.File(dir, "session_health_"
                    + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                    .format(new java.util.Date()) + ".md");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            fo.write(md.toString().getBytes("UTF-8"));
            fo.close();
            if (outPath != null && outPath.length > 0) outPath[0] = out.getAbsolutePath();
            log("HMARK|rows=" + rows + " unread=" + unread.size() + " busy=" + busy.size()
                    + " silent=" + silent.size() + " stale=" + stale.size()
                    + " fresh=" + fresh.size() + " path=" + out.getAbsolutePath());
        } catch (Throwable t) { log("HMARK|err " + t); }
        return rows;
    }

    private static void runHealthMd(final android.app.Activity a) {
        toast("正在生成体检报告…");
        new Thread(new Runnable() {
            @Override public void run() {
                final String[] path = new String[1];
                final int n = buildHealthMd(path);
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("会话体检")
                                .setMessage("会话 " + n + " 个\n\n"
                                        + (path[0] == null ? "生成失败" : path[0]))
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    /* ================= 导出功能自检 ================= */
    private static java.util.ArrayList<String> selfCheckExports() {
        java.util.ArrayList<String> r = new java.util.ArrayList<String>();
        int ok = 0, fail = 0;
        String[] p = new String[1];
        try {
            p[0] = null;
            healthReportCore(p);
            r.add((p[0] != null ? "✅ " : "❌ ") + "会话体检");
            if (p[0] != null) ok++; else fail++;
        } catch (Throwable t) { r.add("❌ 会话体检 " + t); fail++; }
        try {
            p[0] = null;
            buildWeeklyReview();
            r.add((weekMdPath != null ? "✅ " : "❌ ") + "本周回顾");
            if (weekMdPath != null) ok++; else fail++;
        } catch (Throwable t) { r.add("❌ 本周回顾 " + t); fail++; }
        try {
            p[0] = null;
            buildGroupNotices(p);
            r.add((p[0] != null ? "✅ " : "❌ ") + "群公告汇总");
            if (p[0] != null) ok++; else fail++;
        } catch (Throwable t) { r.add("❌ 群公告 " + t); fail++; }
        try {
            p[0] = null;
            buildGroupChangesMd(p);
            if (p[0] != null) { r.add("✅ 群成员变动"); ok++; }
            else { r.add("⚪ 群成员变动（暂无记录，跳过）"); }
        } catch (Throwable t) { r.add("❌ 群变动 " + t); fail++; }
        try {
            p[0] = null;
            buildExportIndex(p);
            r.add((p[0] != null ? "✅ " : "❌ ") + "文件索引");
            if (p[0] != null) ok++; else fail++;
        } catch (Throwable t) { r.add("❌ 索引 " + t); fail++; }
        try {
            p[0] = null;
            buildGroupRank(p);
            r.add((p[0] != null ? "✅ " : "❌ ") + "群活跃排行");
            if (p[0] != null) ok++; else fail++;
        } catch (Throwable t) { r.add("❌ 群排行 " + t); fail++; }

        // 挑一个消息量较小的会话做逐会话功能的冒烟测试
        String small = null;
        try {
            java.util.List<Object[]> sm = queryRows(
                    "select talker, count(*) c from message group by talker"
                            + " having c between 3 and 300 order by c limit 1", 2);
            if (!sm.isEmpty() && sm.get(0)[0] != null) small = String.valueOf(sm.get(0)[0]);
        } catch (Throwable ignore) { }
        if (small != null) {
            try {
                p[0] = null;
                msgTypeStats(small, p);
                r.add((p[0] != null ? "✅ " : "❌ ") + "类型分布");
                if (p[0] != null) ok++; else fail++;
            } catch (Throwable t) { r.add("❌ 类型分布 " + t); fail++; }
            try {
                p[0] = null;
                memberStatsCore(small, p);
                r.add((p[0] != null ? "✅ " : "❌ ") + "发言明细");
                if (p[0] != null) ok++; else fail++;
            } catch (Throwable t) { r.add("❌ 发言明细 " + t); fail++; }
            try {
                p[0] = null;
                exportChatMarkdown(small, p);
                r.add((p[0] != null ? "✅ " : "❌ ") + "聊天 Markdown");
                if (p[0] != null) ok++; else fail++;
            } catch (Throwable t) { r.add("❌ Markdown " + t); fail++; }
            try {
                p[0] = null;
                buildGroupReport(small, p);
                r.add((p[0] != null ? "✅ " : "❌ ") + "群活跃报告");
                if (p[0] != null) ok++; else fail++;
            } catch (Throwable t) { r.add("❌ 活跃报告 " + t); fail++; }
        }
        r.add("—— 通过 " + ok + " · 失败 " + fail);
        log("SELFCHK|ok=" + ok + " fail=" + fail + " sample=" + small);
        return r;
    }

