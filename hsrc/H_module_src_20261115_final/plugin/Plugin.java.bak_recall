            android.widget.TextView t1 = new android.widget.TextView(a);
            t1.setText("时间范围");
            t1.setTextSize(13);
            t1.setTextColor(0xFF888888);
            t1.setPadding(0, dp(a, 10), 0, 0);
            box.addView(t1);

            final android.widget.RadioGroup rg = new android.widget.RadioGroup(a);
            String[] rl = {"全部", "近 30 天", "近 90 天", "近一年"};
            for (int i = 0; i < rl.length; i++) {
                android.widget.RadioButton rb = new android.widget.RadioButton(a);
                rb.setId(100 + i);
                rb.setText(rl[i]);
                if (i == 1) rb.setChecked(true);
                rg.addView(rb);
            }
            box.addView(rg);

            // 发送人筛选（仅群聊）
            final String[] selId = {null};
