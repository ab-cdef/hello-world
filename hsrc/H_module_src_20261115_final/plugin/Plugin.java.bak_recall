    // ================= 正则搜索 =================
    private static void showRegexSearch(final android.app.Activity a) {
        final android.widget.LinearLayout box = new android.widget.LinearLayout(a);
        box.setOrientation(android.widget.LinearLayout.VERTICAL);
        box.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));
        final android.widget.EditText kw = new android.widget.EditText(a);
        kw.setHint("正则，如 ^(订单|发票) 「(?i)已发货」");
        kw.setTextSize(14);
        final android.widget.EditText sc = new android.widget.EditText(a);
        sc.setHint("可选：只看这个会话（备注名/群名）");
        sc.setTextSize(14);
        final android.widget.EditText ex = new android.widget.EditText(a);
        ex.setHint("可选：排除词，逗号分隔");
        ex.setTextSize(14);
        box.addView(kw); box.addView(sc); box.addView(ex);
        new android.app.AlertDialog.Builder(a)
                .setTitle("正则搜索")
                .setView(box)
                .setPositiveButton("搜索", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        runRegexSearch(a, kw.getText().toString(), sc.getText().toString(), ex.getText().toString());
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static void runRegexSearch(final android.app.Activity a, final String pattern,
                                       final String scope, final String exclude) {
        final Object h = msgDbHandle();
        if (h == null) { toast("数据库未就绪"); return; }
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    java.util.regex.Pattern pat;
                    try { pat = java.util.regex.Pattern.compile(pattern); }
                    catch (Throwable t) { toast("正则有误：" + t.getMessage()); return; }
                    String where = "content is not null";
                    if (scope != null && scope.trim().length() > 0) {
                        String tk = wxidByName(scope.trim());
                        if (tk != null) where += " and talker='" + tk.replace("'", "''") + "'";
                    }
                    java.util.ArrayList<String[]> hits = new java.util.ArrayList<String[]>();
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select talker, type, content, createTime from message where " + where
                                    + " order by createTime desc limit 4000", new String[0]);
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                        String[] ex = exclude == null ? new String[0] : exclude.split(",");
                        while ((Boolean) mv.invoke(cur)) {
                            String tk = (String) gs.invoke(cur, 0);
                            long ty = (Long) gl.invoke(cur, 1);
                            String c = (String) gs.invoke(cur, 2);
                            long t = (Long) gl.invoke(cur, 3);
                            if (c == null) continue;
                            if (!pat.matcher(c).find()) continue;
                            boolean skip = false;
                            for (String e : ex) {
                                String ee = e.trim();
                                if (ee.length() > 0 && c.contains(ee)) { skip = true; break; }
                            }
                            if (skip) continue;
                            hits.add(new String[]{tk, String.valueOf(t), bodyOf(ty, c)});
                            if (hits.size() >= 300) break;
                        }
                        try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                    }
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() { showHitList(a, "正则搜索", hits); }
                    });
                } catch (Throwable t) { log("REGEX|err " + t); }
            }
        }).start();
    }

