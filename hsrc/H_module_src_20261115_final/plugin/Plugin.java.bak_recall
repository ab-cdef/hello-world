                                .setPositiveButton("好", null)
                                .setNeutralButton(zf == null ? "无压缩包" : "分享 ZIP", new android.content.DialogInterface.OnClickListener() {
                                    @Override public void onClick(android.content.DialogInterface d, int w) {
                                        if (zf != null) shareExported(a, zf);
                                    }
                                }).show();
                    }
                });
            }
        }).start();
    }

