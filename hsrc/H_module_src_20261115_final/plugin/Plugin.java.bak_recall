    /** 未授权则弹框并返回 false */
    private static boolean licGate(android.app.Activity a, String k) {
        try {
            if (wxh.License.isOk()) return true;
        } catch (Throwable t) { return true; }
        try {
            wxh.License.askCode(a, "此功能需要激活后才能使用");
        } catch (Throwable t) {
            toast("需要激活卡密");
        }
        log("LIC|gate block " + k);
        return false;
    }

    private static boolean needLic(String k) {
        if (k == null) return false;
        for (int i = 0; i < LIC_GATED.length; i++) {
            if (LIC_GATED[i].equals(k)) return true;
        }
        return false;
    }

    private static void runSettingAction(android.app.Activity a, String k) {
        if (needLic(k) && !licGate(a, k)) return;
        if ("chatStats".equals(k)) { showChatStats(a); return; }
        if ("msgStats".equals(k)) { openStatsPanel(a); return; }
        if ("regexSearch".equals(k)) { showRegexSearch(a); return; }
        if ("todoPanel".equals(k)) { showTodoPanel(a); return; }
        if ("exportCenter".equals(k)) { showExportCenter(a); return; }
        if ("msgTimePanel".equals(k)) { showTimePanel(a); return; }
        if ("clearUnread".equals(k)) { clearUnread(a); return; }
        if ("monitor".equals(k)) { showMonitor(a); return; }
        if ("monWords".equals(k)) { editMonitorWords(a); return; }
        if ("groupActive".equals(k)) { showGroupActive(a); return; }
        if ("groupDivers".equals(k)) { showGroupDivers(a); return; }
        if ("exportGroupMembers".equals(k)) { exportGroupMembers(a); return; }
        if ("viewFilterLog".equals(k)) { viewFilterLog(a); return; }
        if ("snsDelView".equals(k)) { showSnsDeleted(a); return; }
        if ("qrView".equals(k)) { showQrLog(a); return; }
        if ("clearLogs".equals(k)) { clearLogs(a); return; }
        if ("emojiExport".equals(k)) { exportEmojis(a); return; }
        if ("emojiList".equals(k)) { listEmojis(a); return; }
        if ("exportChatImages".equals(k)) { exportChatImages(a); return; }
        if ("voiceExport".equals(k)) { exportChatVoice(a); return; }
        if ("dailySum".equals(k)) { showDailySummary(a); return; }
        if ("grpFiles".equals(k)) { showGroupFiles(a); return; }
        if ("remindList".equals(k)) { showReminders(a); return; }
        if ("dailyAdd".equals(k)) { addDailyGroup(a); return; }
        if ("dailyList".equals(k)) { listDailyGroups(a); return; }
        if ("status".equals(k)) { showStatus(a); return; }
        log("XCTR|no action " + k);
    }

    private static void showCenter(final android.app.Activity a, String title,
                                   String[] labels, final String[] keys, String tip) {
        try {
            final android.widget.LinearLayout box = new android.widget.LinearLayout(a);
