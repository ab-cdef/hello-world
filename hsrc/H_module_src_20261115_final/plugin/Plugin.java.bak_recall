                            toast("已保存，下次生成生效");
                        } catch (Throwable t) { log("DAILYW|err " + t); }
                    }
                })
                .setNegativeButton("取消", null).show();
    }

    private static void doDailySummary(final android.app.Activity a, final String tk) {
        final Object h = msgDbHandle();
        if (h == null) { toast("数据库未就绪"); return; }
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    Object probe = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select max(createTime) from message", new String[0]);
                    boolean ms = false;
                    if (probe != null) {
                        java.lang.reflect.Method mv = probe.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gl = probe.getClass().getMethod("getLong", int.class);
                        if ((Boolean) mv.invoke(probe)) ms = (Long) gl.invoke(probe, 0) > 100000000000L;
                        try { probe.getClass().getMethod("close").invoke(probe); } catch (Throwable ignore) { }
                    }
                    long now = System.currentTimeMillis();
                    java.util.Calendar c0 = java.util.Calendar.getInstance();
                    c0.set(java.util.Calendar.HOUR_OF_DAY, 0);
                    c0.set(java.util.Calendar.MINUTE, 0);
                    c0.set(java.util.Calendar.SECOND, 0);
                    long dayStart = c0.getTimeInMillis();
                    long f = ms ? dayStart : dayStart / 1000L;
                    java.text.SimpleDateFormat hf = new java.text.SimpleDateFormat("HH:mm");
                    java.text.SimpleDateFormat df = new java.text.SimpleDateFormat("yyyy-MM-dd");

                    java.util.LinkedHashMap<String, java.util.ArrayList<String>> byWho =
                            new java.util.LinkedHashMap<String, java.util.ArrayList<String>>();
                    java.util.ArrayList<String> keyLines = new java.util.ArrayList<String>();
                    int total = 0;
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select type, content, createTime, isSend from message where talker='"
                                    + tk.replace("'", "''") + "' and createTime>=" + f
                                    + " order by createTime asc", new String[0]);
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            long ty = (Long) gl.invoke(cur, 0);
                            String c = (String) gs.invoke(cur, 1);
                            long t = (Long) gl.invoke(cur, 2);
                            long mine = (Long) gl.invoke(cur, 3);
                            if (!ms) t *= 1000L;
                            String body = bodyOf(ty, c);
                            if (body == null || body.trim().length() == 0) continue;
                            body = body.replace('\n', ' ').trim();
                            String who = mine > 0 ? "我" : senderOfGroupMsg(c, tk);
                            if (who == null || who.length() == 0) who = "成员";
                            java.util.ArrayList<String> arr = byWho.get(who);
                            if (arr == null) { arr = new java.util.ArrayList<String>(); byWho.put(who, arr); }
                            String line = hf.format(new java.util.Date(t)) + "  " + body;
                            arr.add(line);
                            total++;
                            if (isKeyLine(body)) keyLines.add(hf.format(new java.util.Date(t)) + "  " + who + "：" + body);
                        }
                        try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                    }
                    StringBuilder sb = new StringBuilder();
                    sb.append("【").append(displayOfTalker(tk)).append("】今日消息摘要\n");
                    sb.append("日期：").append(df.format(new java.util.Date(now))).append('\n');
                    sb.append("消息：").append(total).append(" 条，参与：").append(byWho.size()).append(" 人\n");
                    sb.append("================================\n\n");
                    if (!keyLines.isEmpty()) {
                        sb.append("【关键消息】\n");
                        int lim = Math.min(40, keyLines.size());
                        for (int i = 0; i < lim; i++) sb.append("· ").append(keyLines.get(i)).append('\n');
                        sb.append('\n');
                    }
                    sb.append("【按成员】\n");
                    for (java.util.Map.Entry<String, java.util.ArrayList<String>> e : byWho.entrySet()) {
                        sb.append("\n▌").append(e.getKey()).append("（").append(e.getValue().size()).append(" 条）\n");
                        int lim = Math.min(30, e.getValue().size());
                        for (int i = 0; i < lim; i++) sb.append("  ").append(e.getValue().get(i)).append('\n');
                    }
                    sb.append(dailyRuleNote());
                    java.io.File dir = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                            "Download/wxh/daily");
                    dir.mkdirs();
                    String safe = displayOfTalker(tk).replaceAll("[\\\\/:*?\"<>|]", "_");
                    java.io.File out = new java.io.File(dir, safe + "_" + df.format(new java.util.Date(now)) + ".txt");
                    java.io.FileWriter fw = new java.io.FileWriter(out);
                    fw.write(sb.toString());
                    fw.close();
                    final int fTotal = total;
                    final String path = out.getAbsolutePath();
                    log("DAILY|n=" + total + " " + path);
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("摘要已生成")
                                    .setMessage("今日 " + fTotal + " 条消息\n\n" + path)
                                    .setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) { log("DAILY|err " + t); }
            }
        }).start();
    }

    private static final String DAILY_KEY_DEFAULT =
            "完成,问题,需要,注意,安排,明天,今天,地址,电话,单号,数量,发货,装船,开会";
    private static final String DAILY_SKIP_DEFAULT = "收到,好的,嗯,哦,谢谢";

    private static boolean isKeyLine(String body) {
        if (body.length() < 4) return false;
        // 反例词：命中即丢弃
        String skips = cfg().optString("dailySkipWords", DAILY_SKIP_DEFAULT);
        for (String w : skips.split("[,，]")) {
            String ww = w.trim();
            if (ww.length() > 0 && body.indexOf(ww) >= 0) return false;
        }
        // 固定规则：链接/文件/位置/时间
        if (body.indexOf("http") >= 0 || body.contains("[文件]") || body.contains("[链接]")
                || body.contains("[位置]")) return true;
        if (body.matches(".*\\d{2}:\\d{2}.*")) return true;
        // 业务词表：可配置
        String keys = cfg().optString("dailyKeyWords", DAILY_KEY_DEFAULT);
        for (String w : keys.split("[,，]")) {
            String ww = w.trim();
            if (ww.length() > 0 && body.indexOf(ww) >= 0) return true;
        }
        return false;
    }

    /** 在摘要里追加"用了哪些规则"，方便对照与调整 */
    private static String dailyRuleNote() {
        String keys = cfg().optString("dailyKeyWords", DAILY_KEY_DEFAULT);
        String skips = cfg().optString("dailySkipWords", DAILY_SKIP_DEFAULT);
        return "\n================================\n"
                + "【筛选说明】（可在「今日消息摘要 → 修改词表」里调整）\n"
                + "关键消息命中任一即收录：\n"
                + "  · 含链接 http / [文件] / [链接] / [位置]\n"
                + "  · 含时间格式 12:30\n"
                + "  · 含业务词：" + keys + "\n"
                + "命中以下任一即排除：" + skips + "\n"
                + "每人最多 30 条，关键消息最多 40 条。\n";
    }

    private static String senderOfGroupMsg(String content, String talker) {
        try {
            if (content == null) return null;
            int idx = content.indexOf(':');
            if (idx <= 0 || idx > 64) return null;
            String head = content.substring(0, idx).trim();
            if (!head.endsWith("@chatroom") && !head.startsWith("wxid_")
                    && !head.endsWith("@openim")) return null;
            return displayOfTalker(head);
        } catch (Throwable t) { return null; }
    }

    private static void exportChatCsv(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || tk.length() == 0) { toast("请先在要导出的聊天里执行"); return; }
        final Object h = msgDbHandle();
        if (h == null) { toast("数据库未就绪"); return; }
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    Object probe = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select max(createTime) from message", new String[0]);
                    boolean ms = false;
                    if (probe != null) {
                        java.lang.reflect.Method mv = probe.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gl = probe.getClass().getMethod("getLong", int.class);
                        if ((Boolean) mv.invoke(probe)) ms = (Long) gl.invoke(probe, 0) > 100000000000L;
                        try { probe.getClass().getMethod("close").invoke(probe); } catch (Throwable ignore) { }
                    }
                    StringBuilder sb = new StringBuilder();
                    sb.append('\uFEFF');                       // Excel 识别 UTF-8
                    sb.append("时间,发送者,类型,内容,是否我发\n");
                    int n = 0;
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select type, content, createTime, isSend from message where talker='"
                                    + tk.replace("'", "''") + "' order by createTime asc", new String[0]);
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            long ty = (Long) gl.invoke(cur, 0);
                            String c = (String) gs.invoke(cur, 1);
                            long t = (Long) gl.invoke(cur, 2);
                            long mine = (Long) gl.invoke(cur, 3);
                            if (!ms) t *= 1000L;
                            String body = bodyOf(ty, c);
                            if (body == null) body = "";
                            sb.append(csvEsc(fmtTs(t))).append(',')
                              .append(csvEsc(mine > 0 ? "我" : displayOfTalker(tk))).append(',')
                              .append(typeNameOf(ty)).append(',')
                              .append(csvEsc(body.replace('\n', ' ').replace('\r', ' '))).append(',')
                              .append(mine > 0 ? "是" : "否").append('\n');
                            n++;
                        }
                        try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                    }
                    java.io.File dir = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                            "Download/wxh");
                    dir.mkdirs();
                    java.io.File out = new java.io.File(dir, "chat_" + Math.abs(tk.hashCode()) + "_"
                            + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss").format(new java.util.Date()) + ".csv");
                    java.io.FileWriter fw = new java.io.FileWriter(out);
                    fw.write(sb.toString());
                    fw.close();
                    final int fn = n;
                    final String path = out.getAbsolutePath();
                    log("EXPCSV|n=" + n + " " + path);
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("导出完成（CSV）")
                                    .setMessage("共 " + fn + " 条，可用 Excel / WPS 直接打开\n\n" + path)
                                    .setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) { log("EXPCSV|err " + t); }
            }
        }).start();
    }

    private static String typeNameOf(long ty) {
        if (ty == 1) return "文字";
        if (ty == 3) return "图片";
        if (ty == 34) return "语音";
        if (ty == 43) return "视频";
        if (ty == 42) return "名片";
        if (ty == 47) return "表情";
        if (ty == 48) return "位置";
        if (ty == 49) return "链接/文件";
        if (ty == 10000) return "系统";
        return String.valueOf(ty);
    }

