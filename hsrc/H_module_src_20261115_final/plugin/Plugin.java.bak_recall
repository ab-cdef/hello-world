    /* ================= 群公告汇总导出 ================= */
    private static int buildGroupNotices(String[] outPath) {
        int n = 0;
        try {
            java.util.List<Object[]> rows = queryRowsAll(
                    "select chatroomname, ifnull(displayname,''), ifnull(chatroomnotice,''),"
                            + " ifnull(memberCount,0), ifnull(modifytime,0) from chatroom"
                            + " where chatroomnotice is not null and chatroomnotice != ''"
                            + " order by modifytime desc");
            StringBuilder md = new StringBuilder();
            md.append("# 群公告汇总\n\n> 生成时间 ")
              .append(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                      .format(new java.util.Date()))
              .append(" · 共 ").append(rows.size()).append(" 个群有公告\n\n");
            java.text.SimpleDateFormat f =
                    new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US);
            for (Object[] r : rows) {
                String tk = r[0] == null ? "" : String.valueOf(r[0]);
                String dn = r[1] == null ? "" : String.valueOf(r[1]).trim();
                String notice = r[2] == null ? "" : String.valueOf(r[2]);
                int mc = 0;
                try { mc = Integer.parseInt(String.valueOf(r[3])); } catch (Throwable ignore) { }
                long mt = 0;
                try { mt = ctToMs(Long.parseLong(String.valueOf(r[4]))); } catch (Throwable ignore) { }
                String name = displayOfTalker(tk);
                if (name == null || name.trim().length() == 0) name = dn;
                notice = notice.replace("\r", "");
                if (notice.length() > 4000) notice = notice.substring(0, 4000) + "…";
                md.append("## ").append(name).append("\n\n");
                md.append("> 成员 ").append(mc).append(" · ")
                  .append(mt > 0 ? f.format(new java.util.Date(mt)) : "时间未知")
                  .append(" · `").append(tk).append("`\n\n");
                for (String line : notice.split("\n")) {
                    md.append("> ").append(line).append('\n');
                }
                md.append('\n');
                n++;
            }
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
            dir.mkdirs();
            java.io.File out = new java.io.File(dir, "group_notices_"
                    + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                    .format(new java.util.Date()) + ".md");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            fo.write(md.toString().getBytes("UTF-8"));
            fo.close();
            if (outPath != null && outPath.length > 0) outPath[0] = out.getAbsolutePath();
            askShare(out);
            log("NOTICES|groups=" + n + " path=" + out.getAbsolutePath());
        } catch (Throwable t) { log("NOTICES|err " + t); }
        return n;
    }

    private static void runGroupNotices(final android.app.Activity a) {
        toast("正在汇总公告…");
        new Thread(new Runnable() {
            @Override public void run() {
                final String[] path = new String[1];
                final int n = buildGroupNotices(path);
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("群公告汇总")
                                .setMessage(n + " 个群有公告\n\n"
                                        + (path[0] == null ? "生成失败" : path[0]))
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    /* ================= 群成员变动导出 Markdown ================= */
    private static int buildGroupChangesMd(String[] outPath) {
        int n = 0;
        try {
            java.io.File f = new java.io.File(DIR + "/group_changes.jsonl");
            if (!f.isFile()) { log("CHGMD|no file"); return 0; }
            java.util.ArrayList<org.json.JSONObject> all =
                    new java.util.ArrayList<org.json.JSONObject>();
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            String ln;
            while ((ln = br.readLine()) != null) {
                if (ln.trim().length() == 0) continue;
                try { all.add(new org.json.JSONObject(ln)); } catch (Throwable ignore) { }
            }
            br.close();
            n = all.size();

            java.text.SimpleDateFormat dayF =
                    new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
            java.text.SimpleDateFormat timeF =
                    new java.text.SimpleDateFormat("HH:mm", java.util.Locale.US);
            StringBuilder md = new StringBuilder();
            md.append("# 群成员变动记录\n\n> 生成时间 ")
              .append(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                      .format(new java.util.Date()))
              .append(" · 共 ").append(n).append(" 条（按时间倒序）\n\n");

            String lastDay = "";
            for (int i = all.size() - 1; i >= 0; i--) {
                org.json.JSONObject o = all.get(i);
                long ts = o.optLong("ts", 0);
                String day = ts > 0 ? dayF.format(new java.util.Date(ts)) : "未知日期";
                if (!day.equals(lastDay)) {
                    md.append("\n## ").append(day).append("\n\n");
                    lastDay = day;
                }
                String kind = o.optString("kind", "");
                String nm = o.optString("name", "");
                if (nm.length() == 0) nm = o.optString("talker", "");
                String text = o.optString("text", "").replace("\n", " ").trim();
                md.append("- `").append(ts > 0 ? timeF.format(new java.util.Date(ts)) : "--:--")
                  .append("` **").append(kind).append("**")
                  .append(nm.length() > 0 ? " · " + nm : "")
                  .append(text.length() > 0 ? "： " + text : "").append('\n');
            }

            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
            dir.mkdirs();
            java.io.File out = new java.io.File(dir, "group_changes_"
                    + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                    .format(new java.util.Date()) + ".md");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            fo.write(md.toString().getBytes("UTF-8"));
            fo.close();
            if (outPath != null && outPath.length > 0) outPath[0] = out.getAbsolutePath();
            askShare(out);
            log("CHGMD|n=" + n + " path=" + out.getAbsolutePath());
        } catch (Throwable t) { log("CHGMD|err " + t); }
        return n;
    }

    private static void runGroupChangesMd(final android.app.Activity a) {
        toast("正在导出…");
        new Thread(new Runnable() {
            @Override public void run() {
                final String[] path = new String[1];
                final int n = buildGroupChangesMd(path);
                a.runOnUiThread(new Runnable() {
