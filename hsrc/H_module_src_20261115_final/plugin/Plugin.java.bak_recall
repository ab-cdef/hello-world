    }

    private static android.widget.PopupWindow extraRowPw = null;
    private static android.view.View extraRowOverlay = null;
    private static long extraRowAt = 0;
    private static int probeClicks = 0;

    /* ---- 自绘「＋」菜单（不动原生，避免浮层冲突） ---- */
    private static android.widget.PopupWindow customPlusPw = null;

    private static void showCustomPlusMenu(final android.app.Activity act, final android.view.View plusView) {
        try {
            if (customPlusPw != null) { try { customPlusPw.dismiss(); } catch (Throwable ignore) { } customPlusPw = null; }
            if (act == null) return;

            int w = (int) (act.getResources().getDisplayMetrics().widthPixels * 0.42f);
            android.widget.LinearLayout box = new android.widget.LinearLayout(act);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
            bg.setColor(0xFF3B3B40);
            float r = dp(act, 10);
            bg.setCornerRadius(r);
            box.setBackground(bg);
            box.setPadding(0, dp(act, 6), 0, dp(act, 6));

            // 原生四项（尽力复用微信自己的入口）
            box.addView(plusRow(act, "发起群聊", new Runnable() {
                @Override public void run() { clickNativePlusItem(plusView, "发起群聊"); }
            }));
            box.addView(plusRow(act, "添加朋友", new Runnable() {
                @Override public void run() { openWeChatUi(act, "com.tencent.mm.plugin.fts.ui.FTSAddFriendUI",
                        "com.tencent.mm.plugin.fts.ui.FTSAddFriendUI", null); }
            }));
            box.addView(plusRow(act, "扫一扫", new Runnable() {
                @Override public void run() { openWeChatUi(act, "com.tencent.mm.plugin.scanner.ui.BaseScanUI",
                        "com.tencent.mm.plugin.scanner.ui.BaseScanUI", null); }
            }));
            box.addView(plusRow(act, "收付款", new Runnable() {
                @Override public void run() { openWeChatUi(act, "com.tencent.mm.plugin.offline.ui.WalletOfflineCoinPurseUI",
                        "com.tencent.mm.plugin.offline.ui.WalletOfflineCoinPurseUI", null); }
            }));

            android.view.View line = new android.view.View(act);
            line.setBackgroundColor(0x1FFFFFFF);
            box.addView(line, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(act, 1)));

            box.addView(plusRow(act, "清空列表", new Runnable() {
                @Override public void run() {
                    execSqlRaw("delete from rconversation");
                    toast("已清空会话列表（记录保留）");
                    refreshConvList();
                }
            }));
            box.addView(plusRow(act, "清空未读", new Runnable() {
                @Override public void run() {
                    execSqlRaw("update rconversation set unReadCount=0");
                    toast("已清空全部未读");
                    refreshConvList();
                }
            }));

            final android.widget.PopupWindow pw = new android.widget.PopupWindow(box, w,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, true);
            pw.setBackgroundDrawable(new android.graphics.drawable.ColorDrawable(0x00000000));
            pw.setOutsideTouchable(true);
            int[] loc = new int[2];
            plusView.getLocationOnScreen(loc);
            int x = loc[0] + plusView.getWidth() - w;
            int y = loc[1] + plusView.getHeight() + dp(act, 6);
            pw.showAtLocation(act.getWindow().getDecorView(), android.view.Gravity.NO_GRAVITY, x, y);
            customPlusPw = pw;
            log("CPLUS|show x=" + x + " y=" + y + " w=" + w);
        } catch (Throwable t) { log("CPLUS|err " + t); }
    }

    /** 长按「＋」：直接进 H 功能面板（原来先弹「快捷操作」再点 H 设置，那一步省掉） */
    /** 记录已经挂过监听的「＋」view（微信自己会 setTag，不能占用 tag） */
    private static final java.util.WeakHashMap<android.view.View, Boolean> plusHooked =
            new java.util.WeakHashMap<android.view.View, Boolean>();

    private static volatile long plusPanelAt = 0;
    private static boolean plusPopupKillInstalled = false;

    /**
     * 长按「＋」时微信自己的四项菜单（发起群聊/添加朋友/扫一扫/收付款）会紧跟着弹出，抢走窗口焦点，
     * 把我们刚开的面板顶到下面（面板随之被 activity pause 掉）。
     * 直接吞掉长按那一刻冒出来的 PopupWindow，面板就能稳稳显示在最上层。
     */
    private static void installPlusPopupKillOnce() {
        if (plusPopupKillInstalled) return;
        plusPopupKillInstalled = true;
        log("PLUSMENU|popup kill start");
        try {
            de.robv.android.xposed.XposedBridge.hookAllMethods(android.widget.PopupWindow.class, "showAsDropDown",
                    new de.robv.android.xposed.XC_MethodHook() {
                        @Override protected void beforeHookedMethod(MethodHookParam param) {
                            try {
                                if (System.currentTimeMillis() - plusPanelAt < 1500) {
                                    param.setResult(null);
                                    log("PLUSMENU|popup killed");
                                }
                            } catch (Throwable ignore) { }
                        }
                    });
            de.robv.android.xposed.XposedBridge.hookAllMethods(android.widget.PopupWindow.class, "showAtLocation",
                    new de.robv.android.xposed.XC_MethodHook() {
                        @Override protected void beforeHookedMethod(MethodHookParam param) {
                            try {
                                if (System.currentTimeMillis() - plusPanelAt < 1500) {
                                    param.setResult(null);
                                    log("PLUSMENU|popup killed");
                                }
                            } catch (Throwable ignore) { }
                        }
                    });
            log("PLUSMENU|popup kill installed");
        } catch (Throwable t) { log("PLUSMENU|popup kill err " + t); }
    }

    private static void showPlusQuickMenu(final android.app.Activity a) {
        try {
            // 去重：两条触发链相隔 90ms 左右先后调用，800ms 内只认第一次
            long now = System.currentTimeMillis();
            if (now - plusQuickAt < 800) {
                log("PLUSMENU|dup skip");
                return;
            }
            plusQuickAt = now;
            plusPanelAt = now;
            installPlusPopupKillOnce();
            try { if (customPlusPw != null) customPlusPw.dismiss(); } catch (Throwable ignore) { }
            // 微信自身的「＋」菜单会在长按后紧跟着弹出，会盖在面板上；延后 320ms 再开面板，保证面板在最上层
            final android.app.Activity act = a;
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        showSettings(act);
                        log("PLUSMENU|longpress -> settings");
                    } catch (Throwable t) { log("PLUSMENU|quick err " + t); }
                }
            }, 320L);
        } catch (Throwable t) { log("PLUSMENU|quick err " + t); }
    }

    /** 旧的「快捷操作」菜单（清空未读/清空聊天列表/H 设置），长按已改直达面板，保留备用 */
    private static void showPlusQuickMenuOld(final android.app.Activity a) {
        try {
            // 去重：两条触发链相隔 90ms 左右先后调用，800ms 内只认第一次
            long now = System.currentTimeMillis();
            if (now - plusQuickAt < 800) {
                log("PLUSMENU|dup skip");
                return;
            }
            plusQuickAt = now;
            boolean cu = cfg().optBoolean("showClearUnread", false);
            boolean cl = cfg().optBoolean("showClearList", false);
            java.util.ArrayList<String> arr = new java.util.ArrayList<String>();
            if (cu) arr.add("清空未读");
            if (cl) arr.add("清空聊天列表");
            arr.add("H 设置");
            final String[] items = arr.toArray(new String[0]);
            final android.app.AlertDialog dlg = new android.app.AlertDialog.Builder(a)
                    .setTitle("快捷操作")
                    .setItems(items, new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int which) {
                            if (which >= 0 && which < items.length && "清空未读".equals(items[which])) {
                                boolean ok = execSqlRaw("update rconversation set unReadCount=0");
                                toast(ok ? "已清空全部未读" : "清空失败");
                                if (ok) refreshConvList();
                            } else if (which >= 0 && which < items.length && "清空聊天列表".equals(items[which])) {
                                new android.app.AlertDialog.Builder(a)
                                        .setTitle("清空聊天列表")
                                        .setMessage("会话将从列表移除，聊天记录保留。\n\n不可撤销，确定？")
                                        .setPositiveButton("确定清空", new android.content.DialogInterface.OnClickListener() {
                                            @Override public void onClick(android.content.DialogInterface d2, int w2) {
                                                boolean ok = execSqlRaw("delete from rconversation");
                                                toast(ok ? "已清空会话列表" : "清空失败");
                                                if (ok) refreshConvList();
                                            }
                                        })
                                        .setNegativeButton("取消", null).show();
                            } else {
                                showSettings(a);
                            }
                        }
                    })
                    .setNegativeButton("取消", null)
                    .create();
            plusQuickDlg = dlg;
            dlg.show();
            log("PLUSMENU|quick shown");
        } catch (Throwable t) { log("PLUSMENU|quick err " + t); }
    }

    /** 重开原生「＋」菜单并点掉指定项，保证和微信行为完全一致 */
    private static void clickNativePlusItem(final android.view.View plusView, final String label) {
        try {
            if (customPlusPw != null) { try { customPlusPw.dismiss(); } catch (Throwable ignore) { } }
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            h.postDelayed(new Runnable() {
                @Override public void run() {
                    try { plusView.performClick(); } catch (Throwable ignore) { }
                }
            }, 250L);
            h.postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        for (android.view.View root : allRoots()) {
                            if (findTextNode(root, "发起群聊", 0) == null) continue;
                            android.widget.TextView tv = findTextNode(root, label, 0);
                            if (tv == null) continue;
                            android.view.View clickable = tv;
                            for (int i = 0; i < 5 && clickable != null && !clickable.isClickable(); i++) {
                                android.view.ViewParent pp = clickable.getParent();
                                clickable = (pp instanceof android.view.View) ? (android.view.View) pp : null;
                            }
                            if (clickable != null && clickable.isClickable()) {
                                clickable.performClick();
                                log("CPLUS|native click " + label);
                                return;
                            }
                        }
                        log("CPLUS|native miss " + label);
                    } catch (Throwable ignore) { }
                }
            }, 700L);
        } catch (Throwable t) { log("CPLUS|clickNative err " + t); }
    }

    private static android.widget.LinearLayout plusRow(android.content.Context ctx, String label, final Runnable action) {
        android.widget.LinearLayout row = new android.widget.LinearLayout(ctx);
        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        row.setGravity(android.view.Gravity.CENTER_VERTICAL);
        row.setPadding(dp(ctx, 20), dp(ctx, 15), dp(ctx, 16), dp(ctx, 15));
        android.widget.TextView tv = new android.widget.TextView(ctx);
        tv.setText(label);
        tv.setTextSize(16);
        tv.setTextColor(0xFFEDEDED);
        row.addView(tv, new android.widget.LinearLayout.LayoutParams(-1, -2));
        row.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                try { if (customPlusPw != null) customPlusPw.dismiss(); } catch (Throwable ignore) { }
                action.run();
            }
        });
        return row;
    }

    /** 打开微信自己的页面；类不存在就提示 */
    private static void openWeChatUi(android.app.Activity act, String cls, String fallbackCls,
                                      String extra) {
        try {
            Class.forName(cls, false, appCl);
            android.content.Intent it = new android.content.Intent();
            it.setClassName(act.getPackageName(), cls);
            if (extra != null) it.putExtra("Chat_User", resolveTalker(extra));
            android.content.Intent _csw = prepareChatSwitch(act, it);
            if (_csw != null) act.startActivity(_csw);
            log("CPLUS|open " + cls);
        } catch (Throwable t) {
            toast("这个入口暂不支持，请用原生菜单");
            log("CPLUS|no " + cls + " " + t);
        }
    }

    /** 在真实"+菜单"下方贴一块同宽同色的"H 设置"行，看起来就是菜单第五行 */
    private static void showExtraRow(final android.app.Activity act, android.view.View menuRoot) {
        try {
            if (act == null || menuRoot == null) return;
            if (findTextNode(menuRoot, "H 设置", 0) != null) return;
            int[] loc = new int[2];
            menuRoot.getLocationOnScreen(loc);
            int w = menuRoot.getWidth();
            int h = menuRoot.getHeight();
            if (w < 200 || h < 100) return;

            android.widget.LinearLayout box = new android.widget.LinearLayout(act);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
            bg.setColor(menuBgColor(menuRoot));
            float r = dp(act, 10);
            bg.setCornerRadii(new float[]{0, 0, 0, 0, r, r, r, r});
            box.setBackground(bg);
            // 顶部不再画分割线，和上方菜单无缝拼接

            box.addView(extraMenuRow(act, "清", "清空列表", new Runnable() {
                @Override public void run() {
                    try {
                        execSqlRaw("delete from rconversation");
                        toast("已清空会话列表（聊天记录保留）");
                        refreshConvList();
                    } catch (Throwable t) { toast("清空失败"); }
                }
            }));
            box.addView(extraMenuRow(act, "未", "清空未读", new Runnable() {
                @Override public void run() {
                    try {
                        execSqlRaw("update rconversation set unReadCount=0");
                        toast("已清空全部未读");
                        refreshConvList();
                    } catch (Throwable t) { toast("清空失败"); }
                }
            }));

            // 关键：不用 PopupWindow（会抢焦点让原生菜单淡出），直接把两块贴到 Activity 的 decor 上
            final android.view.ViewGroup decorV = (android.view.ViewGroup) act.getWindow().getDecorView();
            if (extraRowOverlay != null && extraRowOverlay.getParent() instanceof android.view.ViewGroup) {
                try { ((android.view.ViewGroup) extraRowOverlay.getParent()).removeView(extraRowOverlay); } catch (Throwable ignore) { }
            }
            android.widget.FrameLayout wrap = new android.widget.FrameLayout(act);
            wrap.setClipChildren(false);
            wrap.addView(box, new android.widget.FrameLayout.LayoutParams(w,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT));
            android.widget.FrameLayout.LayoutParams flp = new android.widget.FrameLayout.LayoutParams(
                    w, android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
            flp.gravity = android.view.Gravity.TOP | android.view.Gravity.LEFT;
            flp.leftMargin = loc[0];
            flp.topMargin = loc[1] + h;
            decorV.addView(wrap, flp);
            extraRowOverlay = wrap;
            extraRowAt = System.currentTimeMillis();
            // 原生菜单一关，这块跟着移除
            final android.view.View menuRootF = menuRoot;
            final android.os.Handler mh = new android.os.Handler(android.os.Looper.getMainLooper());
            mh.postDelayed(new Runnable() {
                int ticks = 0;
                @Override public void run() {
                    try {
                        if (extraRowOverlay != wrap) return;
                        if (!menuRootF.isShown() || ++ticks > 40) {
                            android.view.ViewParent pp = wrap.getParent();
                            if (pp instanceof android.view.ViewGroup) ((android.view.ViewGroup) pp).removeView(wrap);
                            if (extraRowOverlay == wrap) extraRowOverlay = null;
                            return;
                        }
                    } catch (Throwable ignore) { }
                    mh.postDelayed(this, 250L);
                }
            }, 250L);
            log("EXTRAROW|show y=" + (loc[1] + h) + " w=" + w);
        } catch (Throwable t) { log("EXTRAROW|err " + t); }
    }

    /** 顶栏右上角点按检测：微信的"+"不走 performClick，只能从触摸事件判断 */
    private static volatile int plusHookDbg = 0;
    private static volatile int plusRectMiss = 0;
    private static volatile long plusDownAt = 0;
    private static volatile float plusDownX = 0, plusDownY = 0;
    private static volatile boolean plusLongFired = false;
    /** 命中「＋」后整段手势被我们吞掉（防止原生长按菜单抢在面板前弹出） */
    private static volatile boolean plusConsume = false;
    private static android.os.Handler plusH = null;
    private static Runnable plusPending = null;
    /** 快捷菜单去重：长按「＋」有 setOnLongClickListener 与 dispatchTouchEvent 两条触发链，会各弹一次 */
    private static volatile long plusQuickAt = 0;
    private static android.app.AlertDialog plusQuickDlg = null;

    private static void cancelPlusPending() {
        try { if (plusH != null && plusPending != null) plusH.removeCallbacks(plusPending); } catch (Throwable ignore) { }
        plusPending = null;
    }

    /**
     * 长按「＋」弹快捷菜单。
     * 关键改动：不再用 DOWN/UP 时间差判断（UP 常被微信吞掉或变 CANCEL，导致时灵时不灵），
     * 改成 DOWN 时挂一个 380ms 的定时器，到点就弹；MOVE 超阈值或 UP 早于 380ms 才取消。
     */
    /** 直接在「＋」按钮上挂长按监听：不依赖触摸拦截与时间判定，最稳 */
    private static void ensurePlusLongClick(final android.app.Activity a) {
        // 不再接管「＋」的触摸：会把微信原生【发起群聊/添加朋友/扫一扫/收付款】菜单整条吞掉。
        // 改为在原生菜单里注入「H 设置」行（attachExtraToRealMenu），短按「＋」即可进入。
        if (true) { log("PLUSLC|off, native menu injection only"); return; }
        try {
            final android.view.View root = a.getWindow().getDecorView();
            // 用资源 id 精确定位首页「＋」（com.tencent.mm:id/plus_icon），不会像 content-desc 那样挂到聊天页「…」
            android.view.View plus = null;
            try {
                int pid = a.getResources().getIdentifier("plus_icon", "id", a.getPackageName());
                if (pid != 0) plus = root.findViewById(pid);
            } catch (Throwable ignore) { }
            if (plus == null) plus = findPlusByPos(a, root);
            if (plus == null) { log("PLUSLC|no plus view"); return; }
            if (plusHooked.get(plus) != null) { log("PLUSLC|already hooked"); return; }   // 已挂过
            plusHooked.put(plus, Boolean.TRUE);
            plus.setLongClickable(false);
            // 直接接管「＋」的触摸：短按=微信原生菜单（自己调 performClick），长按=模块面板。
            // 用 OnTouchListener 而不是 OnLongClickListener，是因为微信自己也挂了长按监听，
            // 两条链会同时触发，原生四项菜单会盖在面板上。这里把整段手势吃掉，原生就抢不到。
            plus.setOnTouchListener(new android.view.View.OnTouchListener() {
                private long downAt = 0;
                private boolean moved = false;
                private float y0 = 0, x0 = 0;
                @Override public boolean onTouch(android.view.View v, android.view.MotionEvent e) {
                    try {
                        int act = e.getActionMasked();
                        if (act == android.view.MotionEvent.ACTION_DOWN) {
                            downAt = System.currentTimeMillis();
                            moved = false;
                            x0 = e.getX();
                            y0 = e.getY();
                            return true;
                        }
                        if (act == android.view.MotionEvent.ACTION_MOVE) {
                            if (Math.abs(e.getY() - y0) > 40 || Math.abs(e.getX() - x0) > 40) moved = true;
                            return true;
                        }
                        if (act == android.view.MotionEvent.ACTION_UP) {
                            long dur = System.currentTimeMillis() - downAt;
                            if (!moved && dur >= 480) {
                                showPlusQuickMenu(a);
                                log("PLUSLC|longpress panel");
                            } else if (!moved && dur < 480) {
                                v.performClick();
                            }
                            return true;
                        }
                        if (act == android.view.MotionEvent.ACTION_CANCEL) return true;
                    } catch (Throwable t) { log("PLUSLC|err " + t); }
                    return false;
                }
            });
            log("PLUSLC|installed");
        } catch (Throwable ignore) { }
    }

    /** 按屏幕位置找聊天页右下角的「＋」（微信用自定义控件，content-desc 常常只挂在顶部「…」上） */
    private static android.view.View findPlusByPos(android.app.Activity a, android.view.View root) {
        try {
            android.util.DisplayMetrics dm = a.getResources().getDisplayMetrics();
            int W = dm.widthPixels, H = dm.heightPixels;
            java.util.ArrayList<android.view.View> cand = new java.util.ArrayList<android.view.View>();
            collectClickable(root, cand);
            android.view.View best = null;
            int bestScore = -1;
            for (int i = 0; i < cand.size(); i++) {
                android.view.View v = cand.get(i);
                int[] loc = new int[2];
                v.getLocationOnScreen(loc);
                int w = v.getWidth(), h = v.getHeight();
                if (w <= 0 || h <= 0) continue;
                if (w > W / 3 || h > H / 6) continue;
                int cx = loc[0] + w / 2, cy = loc[1] + h / 2;
                if (cy < H * 0.80) continue;          // 必须在屏幕底部
                if (cx < W * 0.76) continue;          // 必须靠右
                if (cx > bestScore) { bestScore = cx; best = v; }
            }
            if (best != null) log("PLUSLC|pick pos cx=" + bestScore + " of " + cand.size());
            else log("PLUSLC|pos miss cand=" + cand.size() + " W=" + W + " H=" + H);
            return best;
        } catch (Throwable t) { log("PLUSLC|pos err " + t); return null; }
    }

    private static void collectClickable(android.view.View v, java.util.List<android.view.View> out) {
        try {
            if (v == null || out == null) return;
            if (v.isClickable()) out.add(v);
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) collectClickable(g.getChildAt(i), out);
            }
        } catch (Throwable ignore) { }
    }

    /** 多个同名描述时取屏幕最下方那个（底部「＋」vs 顶部「…」） */
    private static android.view.View findLowestViewByDesc(android.view.View v, String desc) {
        try {
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectViewsByDesc(v, desc, all);
            android.view.View best = null;
            int bestY = -1;
            for (int i = 0; i < all.size(); i++) {
                android.view.View x = all.get(i);
                int[] loc = new int[2];
                x.getLocationOnScreen(loc);
                if (loc[1] > bestY) { bestY = loc[1]; best = x; }
            }
            if (best != null) log("PLUSLC|pick desc=" + desc + " y=" + bestY + " of " + all.size());
            return best;
        } catch (Throwable t) { return findViewByDesc(v, desc); }
    }

    private static void collectViewsByDesc(android.view.View v, String desc, java.util.List<android.view.View> out) {
        try {
            if (v == null || out == null) return;
            CharSequence d = v.getContentDescription();
            if (d != null && d.toString().contains(desc)) out.add(v);
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) collectViewsByDesc(g.getChildAt(i), desc, out);
            }
        } catch (Throwable ignore) { }
    }

    private static android.view.View findViewByDesc(android.view.View v, String desc) {
        if (v == null) return null;
        try {
            CharSequence cd = v.getContentDescription();
            if (cd != null && cd.toString().contains(desc)) return v;
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.view.View r = findViewByDesc(g.getChildAt(i), desc);
                    if (r != null) return r;
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    private static void installPlusTouchHook(final ClassLoader app) {
        try {
            Class<?> act = Class.forName("android.app.Activity", false, app);
            XposedBridge.hookAllMethods(act, "dispatchTouchEvent", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        Object o = p.thisObject;
                        if (!(o instanceof android.app.Activity)) return;
                        final android.app.Activity a = (android.app.Activity) o;
                        if (!a.getClass().getName().contains("LauncherUI")) return;
                        Object ev = p.args != null && p.args.length > 0 ? p.args[0] : null;
                        if (!(ev instanceof android.view.MotionEvent)) return;
                        final android.view.MotionEvent e = (android.view.MotionEvent) ev;
                        int ac = e.getActionMasked();

                        if (ac == android.view.MotionEvent.ACTION_DOWN) {
                            plusLongFired = false;
                            plusConsume = false;
                            cancelPlusPending();
                            plusDownAt = System.currentTimeMillis();
                            plusDownX = e.getRawX(); plusDownY = e.getRawY();
                            final int wchk = a.getResources().getDisplayMetrics().widthPixels;
                            final int hchk = a.getResources().getDisplayMetrics().heightPixels;
                            // 首页「＋」不再吞 DOWN：吞掉会让微信原生【发起群聊/添加朋友/扫一扫/收付款】菜单彻底打不开。
                            // 只记坐标，长按 380ms 到点再弹 H 菜单；到点后 UP 才吃掉这一次点击。
                            if (plusH == null) plusH = new android.os.Handler(android.os.Looper.getMainLooper());
                            plusPending = new Runnable() {
                                @Override public void run() {
                                    try {
                                        if (plusLongFired) return;
                                        if (Math.abs(plusDownX - plusDownX) > dp(a, 40)) return;
                                        if (isInChatUi()) {
                                            // 聊天页：长按标题栏中间 → H 设置
                                            if (plusDownY < hchk * 0.09f
                                                    && plusDownX > wchk * 0.18f && plusDownX < wchk * 0.82f) {
                                                plusLongFired = true;
                                                showSettings(a);
                                                log("ENTRY|longpress chat title");
                                            }
                                            return;
                                        }
                                        int[] pr = findPlusRect(a);
                                        if (pr == null) {
                                            pr = new int[]{wchk - dp(a, 150), 0, dp(a, 150), dp(a, 130)};
                                            if (plusRectMiss < 3) { plusRectMiss++; log("PLUSTOUCH|rect fallback"); }
                                        }
                                        boolean inside = plusDownX >= pr[0] - dp(a, 18)
                                                && plusDownX <= pr[0] + pr[2] + dp(a, 18)
                                                && plusDownY >= pr[1] - dp(a, 18)
                                                && plusDownY <= pr[1] + pr[3] + dp(a, 18);
                                        if (!inside) return;
                                        plusLongFired = true;
                                        log("PLUSTOUCH|long fired x=" + (int) plusDownX + " y=" + (int) plusDownY);
                                        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                            @Override public void run() {
                                                try { showPlusQuickMenu(a); } catch (Throwable t) { log("PLUSLP|err " + t); }
                                            }
                                        }, 90);
                                    } catch (Throwable t) { log("PLUSLP|err " + t); }
                                }
                            };
                            plusH.postDelayed(plusPending, 380);
                            return;
                        }

                        if (ac == android.view.MotionEvent.ACTION_MOVE) {
                            if (plusConsume) {
                                if (!plusLongFired && (Math.abs(e.getRawX() - plusDownX) > dp(a, 40)
                                        || Math.abs(e.getRawY() - plusDownY) > dp(a, 40))) {
                                    cancelPlusPending();
                                }
                                p.setResult(Boolean.TRUE);
                                return;
                            }
                            if (!plusLongFired && (Math.abs(e.getRawX() - plusDownX) > dp(a, 40)
                                    || Math.abs(e.getRawY() - plusDownY) > dp(a, 40))) {
                                cancelPlusPending();
                            }
                            return;
                        }

                        if (ac == android.view.MotionEvent.ACTION_UP
                                || ac == android.view.MotionEvent.ACTION_CANCEL) {
                            cancelPlusPending();
                            if (plusConsume) {
                                plusConsume = false;
                                boolean fired = plusLongFired;
                                plusLongFired = false;
                                if (!fired) {
                                    // 短按：我们接管的这段手势要自己把原生菜单叫出来
                                    try { performPlusClick(a); } catch (Throwable t) { log("PLUSTOUCH|click err " + t); }
                                }
                                p.setResult(Boolean.TRUE);
                                log("PLUSTOUCH|consume up");
                                return;
                            }
                            if (plusLongFired) {
                                plusLongFired = false;
                                p.setResult(Boolean.TRUE);
                                log("PLUSTOUCH|consume up");
                                return;
                            }
                            // 短按：交给微信原生菜单
                            android.os.Handler hh = new android.os.Handler(android.os.Looper.getMainLooper());
                            for (long dl : new long[]{280L, 500L, 800L}) {
                                hh.postDelayed(new Runnable() {
                                    @Override public void run() { attachExtraToRealMenu(); }
                                }, dl);
                            }
                        }
                    } catch (Throwable ignore) { }
                }
            });
             XposedBridge.hookAllMethods(act, "onResume", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        Object o = p.thisObject;
                        if (!(o instanceof android.app.Activity)) return;
                        final android.app.Activity a = (android.app.Activity) o;
                        if (!a.getClass().getName().contains("LauncherUI")) return;
                        new android.os.Handler(android.os.Looper.getMainLooper())
                                .postDelayed(new Runnable() {
                            @Override public void run() { ensurePlusLongClick(a); }
                        }, 700);
                    } catch (Throwable ignore) { }
                }
            });
            log("PLUSTOUCH|hook installed v2");
        } catch (Throwable t) { log("PLUSTOUCH|err " + t); }
    }

    /** 轮询检测原生「＋」菜单是否出现，出现就贴两行清空入口 */
    private static void tickPlusMenu() {
        try {
            android.app.Activity act = topAct != null ? topAct : mainAct;
            if (act == null) return;
            java.util.List<android.view.View> roots = allRoots();
            for (android.view.View r : roots) {
                if (findTextNode(r, "发起群聊", 0) == null) continue;
                if (findTextNode(r, "收付款", 0) == null) continue;
                if (findTextNode(r, "清空未读", 0) != null) continue;   // 这是自绘菜单，不是原生
                int w = r.getWidth(), h = r.getHeight();
                if (w < 200 || h < 100) continue;
                if (extraRowPw != null && extraRowPw.isShowing()) return;
                log("PLUSMENU|found " + w + "x" + h);
                showExtraRow(act, r);
                return;
            }
        } catch (Throwable ignore) { }
    }

    private static android.os.Handler plusMenuH = null;

    private static void startPlusMenuWatch() {
        try {
            if (plusMenuH != null) return;
            plusMenuH = new android.os.Handler(android.os.Looper.getMainLooper());
            plusMenuH.postDelayed(new Runnable() {
                @Override public void run() {
                    try { tickPlusMenu(); } catch (Throwable ignore) { }
                    try { plusMenuH.postDelayed(this, 400L); } catch (Throwable ignore) { }
                }
            }, 3000L);
            log("PLUSMENU|watch started");
        } catch (Throwable ignore) { }
    }

    private static void attachExtraToRealMenu() {
        if (true) return;   // 已改用自绘菜单，贴层方案停用
        try {
            android.app.Activity act = topAct;
            if (act == null) act = mainAct;
            if (act == null) act = chatAct;
            if (act != null && act.isFinishing()) act = null;
            log("EXTRAROW|attach act=" + (act == null ? "null" : act.getClass().getSimpleName()));
            if (extraRowPw != null && extraRowPw.isShowing()
                    && System.currentTimeMillis() - extraRowAt < 2000) return;
            if (extraRowPw != null && !extraRowPw.isShowing()) extraRowPw = null;
            java.util.List<android.view.View> roots = allRoots();
            StringBuilder rw = new StringBuilder();
            for (android.view.View r : roots) rw.append(r.getClass().getSimpleName())
                    .append('(').append(r.getWidth()).append(')').append(' ');
            log("EXTRAROW|roots " + rw);
            for (android.view.View rr : roots) {
                boolean has1 = findTextNode(rr, "收付款", 0) != null;
                boolean has2 = findTextNode(rr, "发起群聊", 0) != null;
                log("EXTRAROW|root " + rr.getClass().getSimpleName() + " " + rr.getWidth() + "x" + rr.getHeight()
                        + " 收付款=" + has1 + " 发起群聊=" + has2);
            }
            for (android.view.View root : roots) {
                java.util.ArrayList<android.widget.TextView> tvs = new java.util.ArrayList<android.widget.TextView>();
                collectTexts(root, tvs, 0);
                for (android.widget.TextView tv : tvs) {
                    if (tv.getText() == null) continue;
                    String tx = tv.getText().toString().trim();
                    if (!"收付款".equals(tx) && !"扫一扫".equals(tx)) continue;
                    // 从该文字往上找到"该窗口的顶层子 View"
                    android.view.View top = tv;
                    for (int i = 0; i < 12; i++) {
                        android.view.ViewParent pp = top.getParent();
                        if (!(pp instanceof android.view.View)) break;
                        if (pp == root) break;
                        top = (android.view.View) pp;
                    }
                    if (top.getWidth() < 200 || top.getHeight() < 150) continue;
                    showExtraRow(act, top);
                    return;
                }
            }
            if (act == null) {
                for (android.view.View rr : allRoots()) {
                    android.content.Context c0 = rr.getContext();
                    if (c0 instanceof android.app.Activity) { act = (android.app.Activity) c0; break; }
                    if (c0 instanceof android.content.ContextWrapper) {
                        android.content.Context c1 = ((android.content.ContextWrapper) c0).getBaseContext();
                        if (c1 instanceof android.app.Activity) { act = (android.app.Activity) c1; break; }
                    }
                }
            }
            if (act == null) { log("EXTRAROW|no act"); return; }
        } catch (Throwable t) { log("EXTRAROW|attach err " + t); }
    }

    /** 自己画一个和微信一模一样的「＋」菜单，最后多一行 H 设置（照微X的做法） */
    private static void showOurPlusMenu(final android.app.Activity act, int x, int y) {
        try {
            android.widget.LinearLayout box = new android.widget.LinearLayout(act);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
            bg.setColor(0xFF3B3B40);
            float r = dp(act, 12);
            bg.setCornerRadius(r);
            box.setBackground(bg);

            String[][] items = {
                    {"💬", "发起群聊", "@group"},
                    {"👤", "添加朋友", "com.tencent.mm.plugin.account.friend.ui.FindMContactAddUI"},
                    {"⛶", "扫一扫", "com.tencent.mm.plugin.scanner.ui.BaseScanUI"},
                    {"💳", "收付款", "com.tencent.mm.plugin.offline.ui.WalletOfflineCoinPurseUI"},
                    {"H", "H 设置", null}
            };
            final android.widget.PopupWindow[] holder = new android.widget.PopupWindow[1];
            for (int i = 0; i < items.length; i++) {
                final String cls = items[i][2];
                android.widget.LinearLayout row = new android.widget.LinearLayout(act);
                row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                row.setPadding(dp(act, 22), dp(act, 16), dp(act, 22), dp(act, 16));
                android.widget.TextView ic = new android.widget.TextView(act);
                ic.setText(items[i][0]);
                ic.setTextSize(i == 4 ? 15 : 18);
                ic.setTextColor(0xFFFFFFFF);
                ic.setGravity(android.view.Gravity.CENTER);
                if (i == 4) ic.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
                row.addView(ic, new android.widget.LinearLayout.LayoutParams(dp(act, 32), dp(act, 32)));
                android.widget.TextView lb = new android.widget.TextView(act);
                lb.setText(items[i][1]);
                lb.setTextSize(17);
                lb.setTextColor(0xFFD9D9DE);
                lb.setSingleLine(true);
                android.widget.LinearLayout.LayoutParams lp = new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                lp.leftMargin = dp(act, 18);
                row.addView(lb, lp);
                if (i < items.length - 1) {
                    // 分割线
                    android.view.View lineWrap = new android.view.View(act);
                }
                row.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { if (holder[0] != null) holder[0].dismiss(); } catch (Throwable ignore) { }
                        try {
                            if (cls == null) {
                                if (topAct != null) showSettings(topAct);
                                return;
                            }
                            if ("@group".equals(cls)) {
                                openCreateGroup(act);
                                return;
                            }
                            if (cls.startsWith("@native:")) {
                                openNativeMenuItem(act, cls.substring(8));
                                return;
                            }
                            android.content.Intent it = new android.content.Intent();
                            it.setClassName(act.getPackageName(), cls);
                            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
                            act.startActivity(it);
                        } catch (Throwable t) { toast("打开失败：" + t); }
                    }
                });
                box.addView(row);
                if (i < items.length - 1) {
                    android.view.View line = new android.view.View(act);
                    line.setBackgroundColor(0x22FFFFFF);
                    android.widget.LinearLayout.LayoutParams llp = new android.widget.LinearLayout.LayoutParams(
                            android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(act, 1));
                    llp.leftMargin = dp(act, 22);
                    llp.rightMargin = dp(act, 22);
                    box.addView(line, llp);
                }
            }
            android.widget.PopupWindow pw = new android.widget.PopupWindow(box,
                    dp(act, 200), android.view.ViewGroup.LayoutParams.WRAP_CONTENT, true);
            pw.setBackgroundDrawable(new android.graphics.drawable.ColorDrawable(0x00000000));
            pw.setOutsideTouchable(true);
            pw.showAtLocation(act.getWindow().getDecorView(), android.view.Gravity.TOP | android.view.Gravity.END,
                    dp(act, 8), y);
            holder[0] = pw;
            log("OURMENU|shown y=" + y);
        } catch (Throwable t) { log("OURMENU|err " + t); }
    }

    private static int[] plusRectCache = null;
    private static long plusRectAt = 0;

    /** 短按「＋」：我们吃了手势，得自己把原生菜单叫出来 */
    private static void performPlusClick(android.app.Activity a) {
        try {
            android.view.View v = findPlusView(a);
            if (v == null) { log("PLUSTOUCH|plus view null"); return; }
            v.performClick();
            log("PLUSTOUCH|performClick");
        } catch (Throwable t) { log("PLUSTOUCH|performClick err " + t); }
    }

    /** 找到主界面右上角"＋"按钮的屏幕矩形（缓存 2 秒） */
    private static int[] findPlusRect(android.app.Activity a) {
        try {
            if (plusRectCache != null && System.currentTimeMillis() - plusRectAt < 2000) return plusRectCache;
            android.view.View decor = a.getWindow().getDecorView();
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            q.add(decor);
            int n = 0;
            while (!q.isEmpty() && n++ < 500) {
                android.view.View v = q.poll();
                CharSequence cd = v.getContentDescription();
                if (cd != null && cd.toString().contains("更多功能") && v.getWidth() > 0) {
                    int[] loc = new int[2];
                    v.getLocationOnScreen(loc);
                    plusRectCache = new int[]{loc[0], loc[1], v.getWidth(), v.getHeight()};
                    plusRectAt = System.currentTimeMillis();
                    return plusRectCache;
                }
                if (v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) q.add(g.getChildAt(i));
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    private static android.view.View findPlusView(android.app.Activity a) {
        try {
            android.view.View decor = a.getWindow().getDecorView();
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            q.add(decor);
            int n = 0;
            while (!q.isEmpty() && n++ < 500) {
                android.view.View v = q.poll();
                CharSequence cd = v.getContentDescription();
                if (cd != null && cd.toString().contains("更多功能") && v.getWidth() > 0) return v;
                if (v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) q.add(g.getChildAt(i));
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 借微信自己的菜单完成动作：先点「＋」弹出原生菜单，再点里面的项 */
    private static void openNativeMenuItem(final android.app.Activity act, final String label) {
        try {
            traceUntil = System.currentTimeMillis() + 5000L;
            android.view.View plus = findPlusView(act);
            if (plus == null) { toast("找不到＋按钮"); return; }
            final android.view.View decor = act.getWindow().getDecorView();
            // 把整个界面压暗，原生菜单弹出的那一瞬间看起来像"黑一下"，不刺眼
            try { decor.setAlpha(0.15f); } catch (Throwable ignore) { }
            plus.performClick();
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            for (final long dl : new long[]{100L, 220L, 400L, 650L}) {
                h.postDelayed(new Runnable() {
                    @Override public void run() {
                        try {
                            for (android.view.View root : allRoots()) {
                                // 弹窗那一层也压暗，避免白菜单闪一下
                                try {
                                    if (root.getClass().getName().contains("Popup")) root.setAlpha(0.05f);
                                } catch (Throwable ignore) { }
                                android.widget.TextView tv = findTextNode(root, label, 0);
                                if (tv == null) continue;
                                boolean ok = tapAtScreen(root, tv);
                                log("NATIVE|tap " + label + " ok=" + ok + " at=" + dl);
                                return;
                            }
                            log("NATIVE|retry " + label + " at=" + dl);
                        } catch (Throwable ignore) { }
                    }
                }, dl);
            }
            h.postDelayed(new Runnable() {
                @Override public void run() {
                    try { decor.setAlpha(1f); } catch (Throwable ignore) { }
                    try {
                        for (android.view.View root : allRoots()) {
                            if (root.getClass().getName().contains("Popup")) root.setAlpha(1f);
                        }
                    } catch (Throwable ignore) { }
                }
            }, 700L);
        } catch (Throwable t) { log("NATIVE|err " + t); }
    }

    /** 抓 CreateChatroom 的 intent 参数，供直接跳转用 */
    private static void installChatroomProbe(final ClassLoader app) {
        try {
            Class<?> act = Class.forName("android.app.Activity", false, app);
            XposedBridge.hookAllMethods(act, "onCreate", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (!(p.thisObject instanceof android.app.Activity)) return;
                        android.app.Activity a = (android.app.Activity) p.thisObject;
                        String cn = a.getClass().getName();
                        String low = cn.toLowerCase();
                        if (!low.contains("createchatroom") && !low.contains("selectconversation")
                                && !low.contains("chatroomselect") && !low.contains("selectcontact")) return;
                        android.content.Intent it = a.getIntent();
                        if (it == null) return;
                        StringBuilder sb = new StringBuilder();
                        android.os.Bundle b = it.getExtras();
                        if (b != null) {
                            for (String k : b.keySet()) {
                                Object v = b.get(k);
                                sb.append(k).append('=').append(v).append(" ; ");
                            }
                        }
                        log("CHATROOM|" + cn + " action=" + it.getAction()
                                + " data=" + it.getDataString() + " extras=" + sb);
                    } catch (Throwable ignore) { }
                }
            });
            log("CHATROOM|probe installed");
        } catch (Throwable t) { log("CHATROOM|probe err " + t); }
    }

    private static volatile long traceUntil = 0;
    private static volatile android.content.Intent lastGroupIntent = null;

    private static void installActivityTracer(final ClassLoader app) {
        try {
            Class<?> act = Class.forName("android.app.Activity", false, app);
            XposedBridge.hookAllMethods(act, "onResume", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (System.currentTimeMillis() > traceUntil) return;
                        if (!(p.thisObject instanceof android.app.Activity)) return;
                        android.app.Activity a = (android.app.Activity) p.thisObject;
                        android.content.Intent it = a.getIntent();
                        StringBuilder sb = new StringBuilder();
                        if (it != null && it.getExtras() != null) {
                            for (String k : it.getExtras().keySet()) {
                                sb.append(k).append('=').append(it.getExtras().get(k)).append(" ; ");
                            }
                        }
                        log("TRACE|" + a.getClass().getName() + " extras=" + sb);
                        // 微信运动点赞功能已撤下（8.0.80 排行榜非标准列表，无法可靠点赞）
                    } catch (Throwable ignore) { }
                }
            });
            log("TRACE|installed");
        } catch (Throwable t) { log("TRACE|err " + t); }
    }

    /** 打开"发起群聊"：优先复用微信自己的 Intent（含 uic 列表），没抓到就走原生菜单顺便抓 */
    private static void openCreateGroup(android.app.Activity act) {
        try {
            android.content.Intent saved = lastGroupIntent;
            if (saved != null) {
                android.content.Intent it2 = new android.content.Intent(saved);
                it2.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
                act.startActivity(it2);
                log("GROUP|replay");
                return;
            }
            log("GROUP|no cached intent, use native path");
            openNativeMenuItem(act, "发起群聊");
        } catch (Throwable t) {
            log("GROUP|err " + t);
            toast("打开失败：" + t);
        }
    }

    private static final java.util.List<java.lang.ref.WeakReference<android.widget.TextView>> tabLabelRefs =
            new java.util.ArrayList<java.lang.ref.WeakReference<android.widget.TextView>>();

    private static void hideTabLabels(android.widget.TextView tv) {
        try {
            boolean found = false;
            for (java.lang.ref.WeakReference<android.widget.TextView> r : tabLabelRefs) {
                if (r.get() == tv) { found = true; break; }
            }
            if (!found) tabLabelRefs.add(new java.lang.ref.WeakReference<android.widget.TextView>(tv));
        } catch (Throwable ignore) { }
    }

    private static int labelScanTick = 0;

    /** 脉冲里反复压住底栏文字；引用为空或隔几轮就重新扫一遍界面 */
    private static void enforceTabLabelsHidden() {
        try {
            // 「底栏只留图标」开关：关时把文字还原，开时隐藏（只看图标）
            boolean hide = cfg().optBoolean("thHideTabLabel", false);
            if (!hide) { restoreTabLabels(); return; }
            // 已有引用就先压一遍
            for (java.util.Iterator<java.lang.ref.WeakReference<android.widget.TextView>> it =
                 tabLabelRefs.iterator(); it.hasNext(); ) {
                android.widget.TextView tv = it.next().get();
                if (tv == null) { it.remove(); continue; }
                Object orig = tv.getTag(0x0f0f0f61);
                if (tv.getText() != null && tv.getText().length() > 0) {
                    if (orig == null) tv.setTag(0x0f0f0f61, tv.getText().toString());
                    tv.setText("");
                }
                if (tv.getVisibility() != android.view.View.GONE) tv.setVisibility(android.view.View.GONE);
            }
            // 引用为空、或每 8 轮重新扫描（覆盖微信重建底栏的情况）
            if (tabLabelRefs.isEmpty() || (++labelScanTick % 8) == 0) {
                android.app.Activity a = topAct;
                if (a == null) return;
                android.view.View decor = a.getWindow().getDecorView();
                int screenH = a.getResources().getDisplayMetrics().heightPixels;
                java.util.ArrayList<android.widget.TextView> tvs = new java.util.ArrayList<android.widget.TextView>();
                collectTexts(decor, tvs, 0);
                int[] loc = new int[2];
                String[] labels = {"微信", "通讯录", "发现", "我"};
                for (android.widget.TextView tv : tvs) {
                    try {
                        CharSequence cs = tv.getText();
                        if (cs == null || cs.length() == 0) continue;
                        String tx = cs.toString().trim();
                        tv.getLocationOnScreen(loc);
                        if (loc[1] < screenH * 0.86f) continue;
                        for (String lb : labels) {
                            if (tx.startsWith(lb) && tx.length() <= lb.length() + 4) {
                                tv.setTag(0x0f0f0f61, tx);
                                tv.setText("");
                                tv.setVisibility(android.view.View.GONE);
                                hideTabLabels(tv);
                                break;
                            }
                        }
                    } catch (Throwable ignore) { }
                }
            }
        } catch (Throwable ignore) { }
    }

    /** 关闭"隐藏底栏文字"时，把文字恢复回来 */
    private static void restoreTabLabels() {
        try {
            for (java.util.Iterator<java.lang.ref.WeakReference<android.widget.TextView>> it =
                 tabLabelRefs.iterator(); it.hasNext(); ) {
                android.widget.TextView tv = it.next().get();
                if (tv == null) { it.remove(); continue; }
                Object orig = tv.getTag(0x0f0f0f61);
                if (orig instanceof String) tv.setText((String) orig);
                tv.setVisibility(android.view.View.VISIBLE);
            }
        } catch (Throwable ignore) { }
    }

    /** 把列表顶部的"标题行/分组头"也清成透明（宽>90% 屏、高<200dp 的条状行） */

    private static boolean silentRefreshDone = false;
    private static android.widget.PopupWindow blackMask = null;

    /** 首次启动：不打开任何界面，只触发 LauncherUI 的 onPause/onResume，让后三页重建 */
    private static void silentPageRefresh(final android.app.Activity act) {
        try {
            if (silentRefreshDone) return;
            if (act == null || !act.getClass().getName().contains("LauncherUI")) return;
            if (!themeOn()) return;
            silentRefreshDone = true;
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            for (int round = 0; round < 3; round++) {
                final int r = round;
                h.postDelayed(new Runnable() {
                    @Override public void run() {
                        try {
                            java.lang.reflect.Method pause = null, resume = null;
                            Class<?> c0 = act.getClass();
                            for (int i = 0; i < 8 && c0 != null; i++, c0 = c0.getSuperclass()) {
                                try {
                                    if (pause == null) {
                                        java.lang.reflect.Method m = c0.getDeclaredMethod("onPause");
                                        m.setAccessible(true);
                                        pause = m;
                                    }
                                } catch (Throwable ignore) { }
                                try {
                                    if (resume == null) {
                                        java.lang.reflect.Method m = c0.getDeclaredMethod("onResume");
                                        m.setAccessible(true);
                                        resume = m;
                                    }
                                } catch (Throwable ignore) { }
                                if (pause != null && resume != null) break;
                            }
                            if (pause != null) pause.invoke(act);
                            if (resume != null) resume.invoke(act);
                            log("SILENT|cycle=" + r);
                        } catch (Throwable t) { log("SILENT|cycle err " + t); }
                    }
                }, 1500L + r * 400L);
            }
        } catch (Throwable ignore) { }
    }

    /** 长按那条消息的类型（34 语音 / 43 视频 / 3 图片 ...） */
    private static long typeOfPressed() {
        try {
            android.view.View v = lastLongPressView == null ? null : lastLongPressView.get();
            if (v == null) return 0;
            long ts = tsOfAnchor(v);
            if (ts <= 0) return 0;
            long sec = ts > 100000000000L ? ts / 1000L : ts;
            Object h = msgDbHandle();
            if (h == null) return 0;
            String r = queryContent(h, "select type from message where createTime between "
                    + (sec - 2) + " and " + (sec + 2) + " limit 1");
            return r == null ? 0 : Long.parseLong(r.trim());
        } catch (Throwable t) { return 0; }
    }

    private static int urlProbe = 0;

    /** 抓微信运动 H5 的 URL 与页面结构（为批量点赞做准备） */
    private static void installSportProbe(final ClassLoader app) {
        try {
            // 页面只有 57 个 View，说明运动页是 WebView：钩构造拿到实例
            String[] wvs = {"android.webkit.WebView", "com.tencent.xweb.WebView"};
            for (String wcn : wvs) {
                try {
                    Class<?> wc = Class.forName(wcn, false, app);
                    XC_MethodHook ctorHook = new XC_MethodHook() {
                        @Override protected void afterHookedMethod(MethodHookParam p) {
                            try {
                                if (!(p.thisObject instanceof android.webkit.WebView)) return;
                                final android.webkit.WebView w = (android.webkit.WebView) p.thisObject;
                                log("SPORT|wv created " + w.getClass().getName());
                                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                    @Override public void run() {
                                        try {
                                            w.evaluateJavascript(
                                                "(function(){var b=document.body?document.body.innerText:'';"
                                              + "var n=document.querySelectorAll('[class*=like],[class*=Like]').length;"
                                              + "return 'N='+n+'|T='+b.substring(0,200);})()",
                                                new android.webkit.ValueCallback<String>() {
                                                    @Override public void onReceiveValue(String v) {
                                                        log("SPORT|wvjs=" + v);
                                                    }
                                                });
                                        } catch (Throwable ignore) { }
                                    }
                                }, 3500L);
                            } catch (Throwable ignore) { }
                        }
                    };
                    int cn2 = 0;
                    for (java.lang.reflect.Constructor<?> cc : wc.getDeclaredConstructors()) {
                        try { XposedBridge.hookMethod(cc, ctorHook); cn2++; } catch (Throwable ignore) { }
                    }
                    log("SPORT|ctor hooked " + wcn + " n=" + cn2);
                } catch (Throwable ignore) { }
            }
        } catch (Throwable t) { log("SPORT|probe err2 " + t); }
        try {
            String[] wvClasses = {"android.webkit.WebView",
                    "com.tencent.xweb.WebView",
                    "com.tencent.smtt.sdk.WebView"};
            for (String wcn : wvClasses) {
                try { hookWebViewClass(Class.forName(wcn, false, app)); log("SPORT|hooked " + wcn); }
                catch (Throwable ignore) { }
            }
            if (true) return;
            Class<?> wv = Class.forName("android.webkit.WebView", false, app);
            XposedBridge.hookAllMethods(wv, "loadUrl", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (!(p.thisObject instanceof android.webkit.WebView)) return;
                        final android.webkit.WebView web = (android.webkit.WebView) p.thisObject;
                        String url = p.args != null && p.args.length > 0 ? String.valueOf(p.args[0]) : "";
                        if (urlProbe < 25) {
                            urlProbe++;
                            log("SPORT|load=" + (url == null ? "null" : url.substring(0, Math.min(140, url.length()))));
                        }
                        if (url == null || (!url.contains("sport") && !url.contains("rank"))) return;
                        log("SPORT|url=" + url);
                        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                            @Override public void run() {
                                try {
                                    web.evaluateJavascript(
                                        "(function(){var b=document.body?document.body.innerHTML:'';"
                                      + "var like=document.querySelectorAll('[class*=like],[class*=Like]');"
                                      + "return 'LIKES='+like.length+'|HEAD='+b.substring(0,600);})()",
                                        new android.webkit.ValueCallback<String>() {
                                            @Override public void onReceiveValue(String v) {
                                                log("SPORT|dom=" + (v == null ? "null" : v));
                                            }
                                        });
                                } catch (Throwable t) { log("SPORT|js err " + t); }
                            }
                        }, 3000L);
                    } catch (Throwable ignore) { }
                }
            });
            log("SPORT|probe installed");
        } catch (Throwable t) { log("SPORT|probe err " + t); }
    }

    private static void hookWebViewClass(Class<?> wv) {
        try {
            XposedBridge.hookAllMethods(wv, "loadUrl", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        String url = p.args != null && p.args.length > 0 ? String.valueOf(p.args[0]) : "";
                        if (urlProbe < 30) {
                            urlProbe++;
                            log("SPORT|load=" + (url == null ? "null"
                                    : url.substring(0, Math.min(150, url.length()))));
                        }
                    } catch (Throwable ignore) { }
                }
            });
        } catch (Throwable ignore) { }
    }

    /** 微信运动排行榜：兼容 ListView / RecyclerView，按 selfLikeState 精确点赞 */
    private static void autoLikeSport(final android.app.Activity a) {
        for (final long wait : new long[]{6000L, 9000L}) {
        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
            @Override public void run() {
                int tapped = 0;
                try {
                    android.view.View decor = a.getWindow().getDecorView();
                    android.view.View listView = null;
                    Object adapter = null;
                    int count = 0;
                    for (android.view.View v : collectAll(decor)) {
                        String cn = v.getClass().getName();
                        Object ad = null;
                        if (v instanceof android.widget.AbsListView) {
                            ad = ((android.widget.AbsListView) v).getAdapter();
                        } else if (cn.contains("RecyclerView")) {
                            ad = callAny(v, "getAdapter", new Class<?>[]{}, new Object[]{});
                        }
                        if (ad == null) continue;
                        Object nObj = callAny(ad, "getItemCount", new Class<?>[]{}, new Object[]{});
                        if (!(nObj instanceof Integer)) {
                            nObj = callAny(ad, "getCount", new Class<?>[]{}, new Object[]{});
                        }
                        int n = nObj instanceof Integer ? (Integer) nObj : 0;
                        if (n > 3) { listView = v; adapter = ad; count = n; break; }
                    }
                    if (listView == null) {
                        StringBuilder tb = new StringBuilder();
                        int n2 = 0;
                        for (android.view.View v : collectAll(decor)) {
                            if (n2++ > 45) break;
                            tb.append(v.getClass().getSimpleName())
                              .append('(').append(v.getWidth()).append('x').append(v.getHeight()).append(") ");
                        }
                        log("SPORTLIKE|no list tree=" + tb);
                        toast("没找到排行榜列表");
                        return;
                    }
                    log("SPORTLIKE|list=" + listView.getClass().getName()
                            + " adapter=" + adapter.getClass().getName() + " n=" + count);
                    Object firstItem = callAny(adapter, "getItem", new Class<?>[]{int.class}, new Object[]{1});
                    if (firstItem != null) {
                        StringBuilder fb = new StringBuilder();
                        Class<?> cc = firstItem.getClass();
                        for (int lv = 0; lv < 4 && cc != null; lv++, cc = cc.getSuperclass()) {
                            for (java.lang.reflect.Field f : cc.getDeclaredFields()) {
                                fb.append(f.getName()).append('(').append(f.getType().getSimpleName()).append(") ");
                            }
                        }
                        log("SPORTLIKE|item=" + firstItem.getClass().getName() + " fields=" + fb);
                    }
                    for (int i = 1; i < count; i++) {
                        try {
                            Object item = callAny(adapter, "getItem", new Class<?>[]{int.class}, new Object[]{i});
                            if (item == null) continue;
                            int st = readLikeState(item);
                            if (st == 1) continue;
                            android.view.View row = null;
                            if (listView instanceof android.widget.AbsListView) {
                                row = (android.view.View) callAny(adapter, "getView",
                                        new Class<?>[]{int.class, android.view.View.class,
                                                android.view.ViewGroup.class},
                                        new Object[]{i, null, listView});
                            } else {
                                Object holder = callAny(listView, "findViewHolderForAdapterPosition",
                                        new Class<?>[]{int.class}, new Object[]{i});
                                if (holder == null) {
                                    callAny(listView, "scrollToPosition", new Class<?>[]{int.class},
                                            new Object[]{i});
                                    Thread.sleep(220);
                                    holder = callAny(listView, "findViewHolderForAdapterPosition",
                                            new Class<?>[]{int.class}, new Object[]{i});
                                }
                                if (holder != null) {
                                    Object iv = callAny(holder, "itemView", new Class<?>[]{}, new Object[]{});
                                    if (!(iv instanceof android.view.View)) {
                                        try {
                                            java.lang.reflect.Field f = holder.getClass().getDeclaredField("itemView");
                                            f.setAccessible(true);
                                            iv = f.get(holder);
                                        } catch (Throwable ignore) { }
                                    }
                                    if (iv instanceof android.view.View) row = (android.view.View) iv;
                                }
                            }
                            if (row == null) continue;
                            android.view.View like = findLikeInRow(row);
                            if (like == null) continue;
                            try { like.performClick(); } catch (Throwable ignore) { }
                            tapped++;
                            Thread.sleep(160);
                        } catch (Throwable ignore) { }
                    }
                } catch (Throwable t) { log("SPORTLIKE|err " + t); }
                log("SPORTLIKE|done tapped=" + tapped);
                final int ft = tapped;
                try {
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            try { toast(ft > 0 ? ("已点赞 " + ft + " 位好友") : "没有需要点赞的好友"); }
                            catch (Throwable ignore) { }
                        }
                    });
                } catch (Throwable ignore) { }
            }
        }, wait);
        }
    }

    /** 读 item 里的点赞状态字段（名字不同版本不一样，按模糊匹配） */
    private static int readLikeState(Object item) {
        try {
            Class<?> c = item.getClass();
            for (int lv = 0; lv < 6 && c != null; lv++, c = c.getSuperclass()) {
                for (java.lang.reflect.Field f : c.getDeclaredFields()) {
                    String nm = f.getName().toLowerCase();
                    if (!nm.contains("likestate") && !nm.contains("selflike")) continue;
                    f.setAccessible(true);
                    Object v = f.get(item);
                    if (v instanceof Integer) return (Integer) v;
                }
            }
        } catch (Throwable ignore) { }
        return -1;
    }

    /** 在行视图里找点赞按钮：最右侧的可点击小控件 */
    private static android.view.View findLikeInRow(android.view.View row) {
        try {
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(row, all, 0);
            int[] loc = new int[2];
            int screenW = row.getResources().getDisplayMetrics().widthPixels;
            android.view.View best = null;
            int bestX = -1;
            for (android.view.View v : all) {
                if (v == row) continue;
                if (v.getWidth() < 24 || v.getWidth() > 200) continue;
                if (v.getHeight() < 24 || v.getHeight() > 200) continue;
                if (!v.isClickable() && !isClickableParent(v)) continue;
                v.getLocationOnScreen(loc);
                int right = loc[0] + v.getWidth();
                if (right < screenW * 0.8f) continue;
                if (loc[0] > bestX) { bestX = loc[0]; best = v; }
            }
            return best;
        } catch (Throwable t) { return null; }
    }

    private static boolean isClickableParent(android.view.View v) {
        try {
            android.view.ViewParent p = v.getParent();
            int d = 0;
            while (p instanceof android.view.View && d++ < 3) {
                if (((android.view.View) p).isClickable()) return true;
                p = ((android.view.View) p).getParent();
            }
        } catch (Throwable ignore) { }
        return false;
    }

    private static java.util.List<android.view.View> collectAll(android.view.View root) {
        java.util.ArrayList<android.view.View> out = new java.util.ArrayList<android.view.View>();
        collectAllViews(root, out, 0);
        return out;
    }

    /** 打开微信运动排行榜并自动点赞 */
    private static void openSportLike(android.app.Activity act) {
        try {
            android.content.Intent it = new android.content.Intent();
            it.setClassName(act.getPackageName(), "com.tencent.mm.plugin.exdevice.ui.ExdeviceRankInfoUI");
            it.putExtra("key_is_latest", true);
            it.putExtra("device_type", 1);
            it.putExtra("key_only_show_latest_rank", true);
            it.putExtra("app_username", "微信运动");
            it.putExtra("rank_id", "#");
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
            act.startActivity(it);
            log("SPORTLIKE|opened");
            // 进主页面后自动点「排行榜」，再开始点赞
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            h.postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        android.app.Activity cur = topAct;
                        if (cur == null) return;
                        android.view.View decor = cur.getWindow().getDecorView();
                        android.widget.TextView rank = findTextNode(decor, "排行榜", 0);
                        if (rank == null) { log("SPORTLIKE|no 排行榜 entry"); return; }
                        tapAtScreen(decor, rank);
                        log("SPORTLIKE|tap 排行榜");
                        h.postDelayed(new Runnable() {
                            @Override public void run() {
                                android.app.Activity t2 = topAct;
                                if (t2 != null) autoLikeSport(t2);
                                log("SPORTLIKE|start on " + (t2 == null ? "null" : t2.getClass().getSimpleName()));
                            }
                        }, 1500L);
                    } catch (Throwable t) { log("SPORTLIKE|nav err " + t); }
                }
            }, 1300L);
        } catch (Throwable t) { log("SPORTLIKE|open err " + t); }
    }

    /** 判断点赞控件当前是不是"已赞"（红色心）：取控件位图的中位色判断 */
    private static boolean isLikedView(android.view.View v) {
        try {
            int w = v.getWidth(), h = v.getHeight();
            if (w <= 0 || h <= 0) return false;
            android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(w, h,
                    android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas c = new android.graphics.Canvas(bm);
            v.draw(c);
            int redPx = 0, total = 0;
            for (int y = 0; y < h; y += Math.max(1, h / 12)) {
                for (int x = 0; x < w; x += Math.max(1, w / 12)) {
                    int col = bm.getPixel(x, y);
                    int a = android.graphics.Color.alpha(col);
                    if (a < 60) continue;
                    total++;
                    int r = android.graphics.Color.red(col);
                    int g = android.graphics.Color.green(col);
                    int b = android.graphics.Color.blue(col);
                    if (r > 180 && g < 120 && b < 140) redPx++;
                }
            }
            bm.recycle();
            return total > 0 && redPx * 100 / total >= 8;      // 有明显红色即视为已赞
        } catch (Throwable t) { return false; }
    }

    private static int countCsv(org.json.JSONObject c, String key) {
        try {
            String v = c.optString(key, "");
            if (v.trim().length() == 0) return 0;
            return v.split(",").length;
        } catch (Throwable t) { return 0; }
    }

    /** 按时间戳取这一条消息的类型 */
    private static long typeOfTs(long tsMs) {
        try {
            long sec = tsMs > 100000000000L ? tsMs / 1000L : tsMs;
            Object h = msgDbHandle();
            if (h == null) return 0;
            String r = queryContent(h, "select type from message where createTime between "
                    + (sec - 2) + " and " + (sec + 2) + " limit 1");
            return r == null ? 0 : Long.parseLong(r.trim());
        } catch (Throwable t) { return 0; }
    }

    /** 按时间戳取群消息发送人 */
    private static String senderOfTs(long tsMs) {
        try {
            long sec = tsMs > 100000000000L ? tsMs / 1000L : tsMs;
            Object h = msgDbHandle();
            if (h == null) return null;
            String content = queryContent(h, "select content from message where createTime between "
                    + (sec - 2) + " and " + (sec + 2) + " limit 1");
            if (content == null) return null;
            int idx = content.indexOf(':');
            if (idx > 0 && idx < 64) {
                String head = content.substring(0, idx).trim();
                if (head.startsWith("wxid") || head.endsWith("@chatroom") || head.endsWith("@openim")) {
                    return displayOfTalker(head);
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 查看被过滤的消息日志（最近 200 行） */
    private static void viewFilterLog(final android.app.Activity a) {
        try {
            java.io.File f = new java.io.File(DIR, "wxh_filter.log");
            if (!f.isFile()) { toast("还没有过滤记录"); return; }
            java.util.List<String> lines = new java.util.ArrayList<String>();
            java.io.BufferedReader br = new java.io.BufferedReader(
                    new java.io.InputStreamReader(new java.io.FileInputStream(f), "UTF-8"));
            String l;
            while ((l = br.readLine()) != null) {
                lines.add(l);
                if (lines.size() > 400) lines.remove(0);
            }
            br.close();
            StringBuilder sb = new StringBuilder();
            for (int i = lines.size() - 1; i >= 0 && sb.length() < 8000; i--) {
                sb.append(lines.get(i)).append('\n');
            }
            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            android.widget.TextView tv = new android.widget.TextView(a);
            tv.setText(sb.length() == 0 ? "还没有过滤记录" : sb.toString());
            tv.setTextSize(12);
            tv.setTextIsSelectable(true);
            tv.setPadding(dp(a, 14), dp(a, 12), dp(a, 14), dp(a, 12));
            sv.addView(tv);
            new android.app.AlertDialog.Builder(a).setTitle("过滤日志 · " + lines.size() + " 条")
                    .setView(sv).setPositiveButton("关闭", null).show();
        } catch (Throwable t) { toast("读取失败：" + t); }
    }

    /** 探针：把 rconversation / SnsComment 的结构打印到日志，供批量免打扰与评论防撤回用 */
    private static void runDbProbe(final android.app.Activity a) {
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    Object h = msgDbHandle();
                    if (h == null) { toast("数据库未就绪"); return; }
                    for (String sql : new String[]{
                            "pragma table_info(rconversation)",
                            "select * from rconversation limit 1",
                            "pragma table_info(SnsComment)",
                            "select count(*) from SnsComment"}) {
                        try {
                            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                                    .invoke(h, sql, new String[0]);
                            StringBuilder sb = new StringBuilder();
                            if (cur != null) {
                                java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                                java.lang.reflect.Method gc = cur.getClass().getMethod("getColumnCount");
                                java.lang.reflect.Method gn = cur.getClass().getMethod("getColumnName", int.class);
                                java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                                int cols = (Integer) gc.invoke(cur);
                                int rows = 0;
                                while ((Boolean) mv.invoke(cur) && rows++ < 2) {
                                    for (int i = 0; i < cols; i++) {
                                        String nm = (String) gn.invoke(cur, i);
                                        String v = null;
                                        try { v = (String) gs.invoke(cur, i); } catch (Throwable ignore) { }
                                        if (v != null && v.length() > 40) v = v.substring(0, 40) + "…";
                                        sb.append(nm).append('=').append(v).append(' ');
                                    }
                                    sb.append(" || ");
                                }
                                try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                            }
                            log("DBP|" + sql + " => " + sb);
                        } catch (Throwable t) { log("DBP|" + sql + " err " + t); }
                    }
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() { toast("结构已写入日志"); }
                    });
                } catch (Throwable t) { log("DBP|err " + t); }
            }
        }).start();
    }

    /** 记录前 30 个会话的 status/flag，用来对比"开启免打扰"前后哪一位变了 */
    private static void runMuteProbe(final android.app.Activity a) {
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    Object h = msgDbHandle();
                    if (h == null) { toast("数据库未就绪"); return; }
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select username, status, flag, chatmode, unReadCount"
                                    + " from rconversation order by conversationTime desc limit 30",
                                    new String[0]);
                    StringBuilder sb = new StringBuilder();
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            String u = (String) gs.invoke(cur, 0);
                            long st = (Long) gl.invoke(cur, 1);
                            long fg = (Long) gl.invoke(cur, 2);
                            long cm = (Long) gl.invoke(cur, 3);
                            long uc = (Long) gl.invoke(cur, 4);
                            sb.append(displayOfTalker(u))
                              .append("|status=").append(st).append("|flag=").append(fg)
                              .append("|chatmode=").append(cm).append("|unread=").append(uc).append(" ;; ");
                        }
                        try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                    }
                    log("MUTEPROBE|" + sb);
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() { toast("已记录 30 个会话状态到日志"); }
                    });
                } catch (Throwable t) { log("MUTEPROBE|err " + t); }
            }
        }).start();
    }

    /** 批量免打扰：对会话列表前 N 个会话逐一"长按 → 点消息免打扰" */
    private static void bulkMute(final android.app.Activity a, final int count) {
        new Thread(new Runnable() {
            @Override public void run() {
                for (int i = 0; i < count; i++) {
                    final int idx = i;
                    final java.util.concurrent.CountDownLatch latch =
                            new java.util.concurrent.CountDownLatch(1);
                    new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                        @Override public void run() {
                            try {
                                android.view.View decor = a.getWindow().getDecorView();
                                android.widget.ListView lv = null;
                                for (android.view.View v : collectAll(decor)) {
                                    if (v instanceof android.widget.ListView
                                            && ((android.widget.ListView) v).getChildCount() > 0) { lv = (android.widget.ListView) v; break; }
                                }
                                if (lv == null) { log("MUTEPICK|no listview"); return; }
                                android.view.View row = lv.getChildAt(idx);
                                if (row == null) return;
                                int[] loc = new int[2];
                                row.getLocationOnScreen(loc);
                                float x = loc[0] + row.getWidth() / 2f;
                                float y = loc[1] + row.getHeight() / 2f;
                                long now = android.os.SystemClock.uptimeMillis();
                                android.view.MotionEvent down = android.view.MotionEvent.obtain(now, now,
                                        android.view.MotionEvent.ACTION_DOWN, x, y, 0);
                                decor.dispatchTouchEvent(down);
                                try { Thread.sleep(650); } catch (Throwable ignore) { }
                                android.view.MotionEvent up = android.view.MotionEvent.obtain(now, now + 700,
                                        android.view.MotionEvent.ACTION_UP, x, y, 0);
                                decor.dispatchTouchEvent(up);
                                down.recycle(); up.recycle();
                                log("BULKMUTE|longpress " + idx);
                                // 菜单弹出后点"消息免打扰"
                                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                    @Override public void run() {
                                        try {
                                            for (android.view.View r : allRoots()) {
                                                android.widget.TextView tv = findTextNode(r, "消息免打扰", 0);
                                                if (tv == null) continue;
                                                tapAtScreen(r, tv);
                                                log("BULKMUTE|mute tapped");
                                                return;
                                            }
                                            log("BULKMUTE|menu not found");
                                        } catch (Throwable ignore) { }
                                    }
                                }, 500L);
                            } catch (Throwable t) { log("BULKMUTE|err " + t); }
                            finally { latch.countDown(); }
                        }
                    });
                    try { latch.await(3, java.util.concurrent.TimeUnit.SECONDS); } catch (Throwable ignore) { }
                    try { Thread.sleep(900); } catch (Throwable ignore) { }
                }
                log("BULKMUTE|done");
            }
        }).start();
    }

    /** 选择会话 → 批量开/关免打扰 */
    private static void showMutePicker(final android.app.Activity a) {
        try {
            final Object h = msgDbHandle();
            if (h == null) { toast("数据库未就绪"); return; }
            final java.util.List<String[]> convs = new java.util.ArrayList<String[]>();
            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, "select username from rconversation order by conversationTime desc limit 300",
                            new String[0]);
            if (cur != null) {
                java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                while ((Boolean) mv.invoke(cur)) {
                    String u = (String) gs.invoke(cur, 0);
                    if (u == null) continue;
                    convs.add(new String[]{u, displayOfTalker(u)});
                }
                try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
            }
            final java.util.LinkedHashSet<String> sel = new java.util.LinkedHashSet<String>();
            final android.app.Dialog dlg = new android.app.Dialog(a);
            dlg.requestWindowFeature(android.view.Window.FEATURE_NO_TITLE);
            android.widget.LinearLayout rootL = new android.widget.LinearLayout(a);
            rootL.setOrientation(android.widget.LinearLayout.VERTICAL);
            rootL.setBackgroundColor(0xFFFFFFFF);
            rootL.setPadding(28, 28, 28, 20);

            final android.widget.TextView title = new android.widget.TextView(a);
            title.setText("选择会话 · 已选 0");
            title.setTextSize(17);
            title.setTextColor(0xFF111114);
            title.setPadding(0, 0, 0, 14);
            rootL.addView(title);

            final android.widget.EditText et = new android.widget.EditText(a);
            et.setHint("搜索好友或群");
            et.setSingleLine(true);
            et.setTextColor(0xFF111114);
            et.setHintTextColor(0xFF6B6B76);
            et.setBackgroundColor(0xFFEDEDF2);
            et.setPadding(24, 16, 24, 16);
            rootL.addView(et);

            final android.widget.ListView lv = new android.widget.ListView(a);
            lv.setChoiceMode(android.widget.ListView.CHOICE_MODE_MULTIPLE);
            lv.setDivider(new android.graphics.drawable.ColorDrawable(0xFFE0E0E6));
            lv.setDividerHeight(1);
            final android.widget.ArrayAdapter<String> ad = new android.widget.ArrayAdapter<String>(
                    a, android.R.layout.simple_list_item_multiple_choice) {
                @Override public View getView(int pos, View cv, android.view.ViewGroup parent) {
                    View v = super.getView(pos, cv, parent);
                    if (v instanceof android.widget.TextView) {
                        android.widget.TextView tv = (android.widget.TextView) v;
                        tv.setTextColor(0xFF111114);
                        tv.setTextSize(15);
                        tv.setPadding(24, 24, 24, 24);
                    }
                    return v;
                }
            };
            lv.setAdapter(ad);
            rootL.addView(lv, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, 900));

            final java.util.List<Integer> shown = new java.util.ArrayList<Integer>();
            final Runnable rebuild = new Runnable() {
                @Override public void run() {
                    String q = et.getText().toString().trim().toLowerCase();
                    shown.clear(); ad.clear();
                    for (int i = 0; i < convs.size(); i++) {
                        String[] c = convs.get(i);
                        if (q.length() > 0 && !c[1].toLowerCase().contains(q)
                                && !c[0].toLowerCase().contains(q)) continue;
                        shown.add(Integer.valueOf(i));
                        ad.add(c[1] + (sel.contains(c[0]) ? "  ✓" : ""));
                    }
                    title.setText("选择会话 · 已选 " + sel.size());
                }
            };
            rebuild.run();
            lv.setOnItemClickListener(new android.widget.AdapterView.OnItemClickListener() {
                @Override public void onItemClick(android.widget.AdapterView<?> p, View v, int pos, long id) {
                    try {
                        String u = convs.get(shown.get(pos))[0];
                        if (!sel.remove(u)) sel.add(u);
                        rebuild.run();
                    } catch (Throwable ignore) { }
                }
            });
            et.addTextChangedListener(new android.text.TextWatcher() {
                @Override public void beforeTextChanged(CharSequence s1, int a1, int b1, int c1) { }
                @Override public void onTextChanged(CharSequence s1, int a1, int b1, int c1) { }
                @Override public void afterTextChanged(android.text.Editable e1) { rebuild.run(); }
            });

            android.widget.LinearLayout btns = new android.widget.LinearLayout(a);
            btns.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            btns.setPadding(0, 16, 0, 0);
            android.widget.TextView all = new android.widget.TextView(a);
            all.setText("全选");
            all.setTextSize(14);
            all.setTextColor(0xFF1A6DFF);
            all.setPadding(0, 12, 30, 12);
            all.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View v) {
                    sel.clear();
                    for (String[] c : convs) sel.add(c[0]);
                    rebuild.run();
                }
            });
            btns.addView(all);
            android.widget.TextView mute = new android.widget.TextView(a);
            mute.setText("设为免打扰");
            mute.setTextSize(14);
            mute.setTextColor(0xFFD93A3A);
            mute.setPadding(30, 12, 30, 12);
            mute.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View v) {
                    dlg.dismiss();
                    applyMute(a, sel, true);
                }
            });
            btns.addView(mute);
            android.widget.TextView unmute = new android.widget.TextView(a);
            unmute.setText("取消免打扰");
            unmute.setTextSize(14);
            unmute.setTextColor(0xFF07C160);
            unmute.setPadding(30, 12, 0, 12);
            unmute.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View v) {
                    dlg.dismiss();
                    applyMute(a, sel, false);
                }
            });
            btns.addView(unmute);
            rootL.addView(btns);

            dlg.setContentView(rootL);
            android.view.Window w = dlg.getWindow();
            if (w != null) {
                w.setLayout((int) (a.getResources().getDisplayMetrics().widthPixels * 0.94f),
                        (int) (a.getResources().getDisplayMetrics().heightPixels * 0.8f));
            }
            dlg.show();
        } catch (Throwable t) { log("MUTEPICK|err " + t); toast("打开失败：" + t); }
    }

    /** 对选中的会话逐一执行"长按 → 点免打扰项" */
    private static void applyMute(final android.app.Activity a, final java.util.Set<String> sel,
                                  final boolean mute) {
        new Thread(new Runnable() {
            @Override public void run() {
                int ok = 0;
                // 先确保回到"微信"首页（会话列表）
                final java.util.concurrent.CountDownLatch homeLatch =
                        new java.util.concurrent.CountDownLatch(1);
                new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                    @Override public void run() {
                        try {
                            android.view.ViewGroup pgr = weldPagerRef == null ? null : weldPagerRef.get();
                            if (pgr == null) pgr = findPager(a.getWindow().getDecorView());
                            if (pgr != null) {
                                callAny(pgr, "setCurrentItem", new Class<?>[]{int.class, boolean.class},
                                        new Object[]{0, Boolean.FALSE});
                                log("MUTEPICK|switch home");
                            }
                        } catch (Throwable ignore) { } finally { homeLatch.countDown(); }
                    }
                });
                try { homeLatch.await(3, java.util.concurrent.TimeUnit.SECONDS); } catch (Throwable ignore) { }
                try { Thread.sleep(600); } catch (Throwable ignore) { }
                for (final String u : sel) {
                    final String name = displayOfTalker(u);
                    final java.util.concurrent.CountDownLatch latch =
                            new java.util.concurrent.CountDownLatch(1);
                    final boolean[] hit = new boolean[]{false};
                    new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                        @Override public void run() {
                            try {
                                android.view.View decor = a.getWindow().getDecorView();
                                android.widget.ListView lv = null;
                                for (android.view.View v : collectAll(decor)) {
                                    if (v instanceof android.widget.ListView
                                            && ((android.widget.ListView) v).getChildCount() > 0) { lv = (android.widget.ListView) v; break; }
                                }
                                if (lv == null) return;
                                lv.setSelection(0);
                                android.view.View row = null;
                                for (int page = 0; page < 20 && row == null; page++) {
                                    for (int i = 0; i < lv.getChildCount(); i++) {
                                        android.view.View c = lv.getChildAt(i);
                                        String t = textOfRow(c);
                                        if (t != null && t.contains(name)) { row = c; break; }
                                    }
                                    if (row == null) lv.smoothScrollBy(lv.getHeight() * 7 / 10, 300);
                                    if (row == null) {
                                        try { Thread.sleep(260); } catch (Throwable ignore) { }
                                    }
                                }
                                if (row == null) { log("MUTEPICK|not found " + name); return; }
                                int[] loc = new int[2];
                                row.getLocationOnScreen(loc);
                                float x = loc[0] + row.getWidth() / 2f;
                                float y = loc[1] + row.getHeight() / 2f;
                                long now = android.os.SystemClock.uptimeMillis();
                                android.view.MotionEvent down = android.view.MotionEvent.obtain(now, now,
                                        android.view.MotionEvent.ACTION_DOWN, x, y, 0);
                                decor.dispatchTouchEvent(down);
                                try { Thread.sleep(620); } catch (Throwable ignore) { }
                                android.view.MotionEvent up = android.view.MotionEvent.obtain(now, now + 680,
                                        android.view.MotionEvent.ACTION_UP, x, y, 0);
                                decor.dispatchTouchEvent(up);
                                down.recycle(); up.recycle();
                                hit[0] = true;
                                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                    @Override public void run() {
                                        try {
                                            for (android.view.View r : allRoots()) {
                                                java.util.List<android.widget.TextView> tvs =
                                                        new java.util.ArrayList<android.widget.TextView>();
                                                collectTexts(r, tvs, 0);
                                                for (android.widget.TextView tv : tvs) {
                                                    CharSequence cs = tv.getText();
                                                    if (cs == null) continue;
                                                    String tx = cs.toString();
                                                    if (!tx.contains("免打扰")) continue;
                                                    tapAtScreen(r, tv);
                                                    log("MUTEPICK|toggle " + name + " mute=" + mute);
                                                    return;
                                                }
                                            }
                                            log("MUTEPICK|menu item not found " + name);
                                        } catch (Throwable ignore) { }
                                    }
                                }, 450L);
                            } catch (Throwable t) { log("MUTEPICK|err " + t); }
                            finally { latch.countDown(); }
                        }
                    });
                    try { latch.await(9, java.util.concurrent.TimeUnit.SECONDS); } catch (Throwable ignore) { }
                    if (hit[0]) ok++;
                    try { Thread.sleep(1200); } catch (Throwable ignore) { }
                }
                log("MUTEPICK|done ok=" + ok + " total=" + sel.size());
                final int n = ok;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        try { toast("已处理 " + n + "/" + sel.size() + " 个会话"); } catch (Throwable ignore) { }
                    }
                });
            }
        }).start();
    }

    private static String textOfRow(android.view.View row) {
        try {
            java.util.ArrayList<android.widget.TextView> tvs = new java.util.ArrayList<android.widget.TextView>();
            collectTexts(row, tvs, 0);
            for (android.widget.TextView tv : tvs) {
                if (tv.getText() != null && tv.getText().length() > 0) return tv.getText().toString();
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 朋友圈评论事件探针：抓到删除评论时的数据 */
    private static void installSnsCommentProbe(final ClassLoader app) {
        try {
            Class<?> c = Class.forName("com.tencent.mm.autogen.events.SnsCommentUpdateEvent", false, app);
            XC_MethodHook hook = new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        Object o = p.thisObject;
                        StringBuilder sb = new StringBuilder();
                        Class<?> cc = o.getClass();
                        for (int lv = 0; lv < 5 && cc != null; lv++, cc = cc.getSuperclass()) {
                            for (java.lang.reflect.Field f : cc.getDeclaredFields()) {
                                try {
                                    f.setAccessible(true);
                                    Object v = f.get(o);
                                    if (v == null) continue;
                                    String sval = String.valueOf(v);
                                    if (sval.length() > 80) sval = sval.substring(0, 80) + "…";
                                    sb.append(f.getName()).append('=').append(sval).append(' ');
                                } catch (Throwable ignore) { }
                            }
                        }
                        log("SNSCOMMENT|evt " + sb);
                    } catch (Throwable ignore) { }
                }
            };
            int n = 0;
            for (java.lang.reflect.Method m : c.getDeclaredMethods()) {
                String mn = m.getName();
                if (mn.equals("post") || mn.equals("asyncPost")) {
                    try { XposedBridge.hookMethod(m, hook); n++; } catch (Throwable ignore) { }
                }
            }
            for (java.lang.reflect.Constructor<?> ct : c.getDeclaredConstructors()) {
                try { XposedBridge.hookMethod(ct, hook); n++; } catch (Throwable ignore) { }
            }
            log("SNSCOMMENT|probe installed n=" + n);
        } catch (Throwable t) { log("SNSCOMMENT|probe err " + t); }
    }

    /** 后台防窥：切到后台时盖一层纯色，任务切换预览看不到聊天内容 */
    private static android.graphics.drawable.ColorDrawable privacyMask = null;

    private static void applyPrivacyMask(android.app.Activity a, boolean on) {
        try {
            if (a == null) return;
            android.view.View decor = a.getWindow().getDecorView();
            if (decor == null) return;
            if (on) {
                if (!cfg().optBoolean("privacyBlur", false)) return;
                android.graphics.drawable.ColorDrawable cd =
                        new android.graphics.drawable.ColorDrawable(0xFF1B1B1F);
                decor.getOverlay().add(cd);
                privacyMask = cd;
            } else {
                if (privacyMask != null) {
                    decor.getOverlay().remove(privacyMask);
                    privacyMask = null;
                }
            }
        } catch (Throwable ignore) { }
    }

    /** 收到图片后自动下载解密并存入相册 */
    private static void autoSaveImage(String talker, long ctMs, String content) {
        try {
            Object h = msgDbHandle();
            if (h == null) return;
            long sec = ctMs > 100000000000L ? ctMs / 1000L : ctMs;
            String sql = "select msgId, msgSvrId, imgPath, createTime, content from message where talker='"
                    + talker.replace("'", "''") + "' and type=3 order by createTime desc limit 6";
            if (sec > 0) {
                sql = "select msgId, msgSvrId, imgPath, createTime, content from message where talker='"
                        + talker.replace("'", "''") + "' and type=3 and createTime between "
                        + (sec - 3) + " and " + (sec + 3) + " order by createTime desc limit 1";
            }
            Object cur = h.getClass().getMethod("B", String.class, String[].class).invoke(h, sql, new String[0]);
            if (cur == null) return;
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
            while ((Boolean) mv.invoke(cur)) {
                long svr = (Long) gl.invoke(cur, 1);
                String imgPath = (String) gs.invoke(cur, 2);
                String body = (String) gs.invoke(cur, 4);
                String key = attrOf(body, "aeskey");
                String alt = attrOf(body, "cdnthumbaeskey");
                android.graphics.Bitmap bm = loadImageThumb2(h, svr, key, imgPath, alt);
                if (bm == null) continue;
                boolean ok = saveBitmapQuiet(bm);
                log("AUTOSAVE|" + svr + " ok=" + ok + " " + bm.getWidth() + "x" + bm.getHeight());
                return;
            }
            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
        } catch (Throwable t) { log("AUTOSAVE|err " + t); }
    }

    /** 静默存相册（失败返回 false，不弹窗） */
    private static boolean saveBitmapQuiet(android.graphics.Bitmap bm) {
        try {
            android.content.Context ctx = ctxAny();
            if (ctx == null || bm == null) return false;
            String name = "wxh_auto_" + System.currentTimeMillis() + ".png";
            android.content.ContentValues v = new android.content.ContentValues();
            v.put(android.provider.MediaStore.Images.Media.DISPLAY_NAME, name);
            v.put(android.provider.MediaStore.Images.Media.MIME_TYPE, "image/png");
            v.put(android.provider.MediaStore.Images.Media.RELATIVE_PATH, "Pictures/wxh");
            android.net.Uri uri = ctx.getContentResolver()
                    .insert(android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI, v);
            if (uri == null) return false;
            java.io.OutputStream os = ctx.getContentResolver().openOutputStream(uri);
            bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, os);
            os.close();
            return true;
        } catch (Throwable t) { log("AUTOSAVE|save err " + t); return false; }
    }

    private static android.content.Context ctxAny() {
        try {
            if (chatAct != null) return chatAct;
            if (topAct != null) return topAct;
            if (mainAct != null) return mainAct;
            Object app = Class.forName("android.app.ActivityThread")
                    .getMethod("currentApplication").invoke(null);
            if (app instanceof android.content.Context) return (android.content.Context) app;
        } catch (Throwable ignore) { }
        return null;
    }

    // ================= 深夜护眼 =================
    private static android.graphics.drawable.ColorDrawable nightMask = null;

    private static void applyNightMode(android.app.Activity a) {
        try {
            if (a == null) return;
            android.view.View decor = a.getWindow().getDecorView();
            if (decor == null) return;
            int hour = java.util.Calendar.getInstance().get(java.util.Calendar.HOUR_OF_DAY);
            boolean should = cfg().optBoolean("nightMode", false) && (hour >= 23 || hour < 7);
            if (should) {
                if (nightMask == null) {
                    nightMask = new android.graphics.drawable.ColorDrawable(0x33000000);
                    decor.getOverlay().add(nightMask);
                    log("NIGHT|on " + hour);
                }
            } else if (nightMask != null) {
                decor.getOverlay().remove(nightMask);
                nightMask = null;
                log("NIGHT|off " + hour);
            }
        } catch (Throwable ignore) { }
    }

    // ================= 群潜水成员统计 =================
    private static void showGroupDivers(final android.app.Activity a) {
        try {
            final Object h = msgDbHandle();
            if (h == null) { toast("数据库未就绪"); return; }
            String tk = chatTalker;
            if (tk == null || !tk.endsWith("@chatroom")) {
                // 不在群里：让用户从群聊归拢面板挑；这里直接提示
                toast("请先在要统计的群聊里执行");
                return;
            }
            final String ftk = tk;
            final java.util.LinkedHashMap<String, Long> lastAct = new java.util.LinkedHashMap<String, Long>();
            new Thread(new Runnable() {
                @Override public void run() {
                    try {
                        Object cur = h.getClass().getMethod("B", String.class, String[].class)
                                .invoke(h, "select content, createTime from message where talker='"
                                        + ftk.replace("'", "''") + "' and isSend=0 order by createTime desc limit 3000",
                                        new String[0]);
                        if (cur != null) {
                            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                            java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                            while ((Boolean) mv.invoke(cur)) {
                                String c = (String) gs.invoke(cur, 0);
                                long t = (Long) gl.invoke(cur, 1);
                                if (c == null) continue;
                                int idx = c.indexOf(':');
                                if (idx <= 0 || idx > 64) continue;
                                String who = c.substring(0, idx).trim();
                                if (!who.startsWith("wxid") && !who.endsWith("@openim")) continue;
                                if (!lastAct.containsKey(who)) lastAct.put(who, t);
                            }
                            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                        }
                        // 读群成员列表
                        java.util.ArrayList<String> members = new java.util.ArrayList<String>();
                        Object c2 = h.getClass().getMethod("B", String.class, String[].class)
                                .invoke(h, "select memberlist from chatroom where username='"
                                        + ftk.replace("'", "''") + "' limit 1", new String[0]);
                        if (c2 != null) {
                            java.lang.reflect.Method mv2 = c2.getClass().getMethod("moveToNext");
                            java.lang.reflect.Method gs2 = c2.getClass().getMethod("getString", int.class);
                            if ((Boolean) mv2.invoke(c2)) {
                                String ml = (String) gs2.invoke(c2, 0);
                                if (ml != null) {
                                    for (String seg : ml.split(";")) {
                                        String w = seg.trim();
                                        int sp = w.indexOf('@');
                                        if (sp > 6) w = w.substring(0, sp);
                                        if (w.length() > 4) members.add(w);
                                    }
                                }
                            }
                            try { c2.getClass().getMethod("close").invoke(c2); } catch (Throwable ignore) { }
                        }
                        final java.util.ArrayList<String[]> rows = new java.util.ArrayList<String[]>();
                        if (!members.isEmpty()) {
                            for (String m : members) {
                                Long t = lastAct.get(m);
                                rows.add(new String[]{m, String.valueOf(t == null ? 0 : t)});
                            }
                        } else {
                            for (java.util.Map.Entry<String, Long> e : lastAct.entrySet()) {
                                rows.add(new String[]{e.getKey(), String.valueOf(e.getValue())});
                            }
                        }
                        java.util.Collections.sort(rows, new java.util.Comparator<String[]>() {
                            @Override public int compare(String[] x, String[] y) {
                                return Long.compare(Long.parseLong(x[1]), Long.parseLong(y[1]));
                            }
                        });
                        a.runOnUiThread(new Runnable() {
                            @Override public void run() { showDiversPanel(a, rows, members.size()); }
                        });
                    } catch (Throwable t) { log("DIVERS|err " + t); }
                }
            }).start();
        } catch (Throwable t) { log("DIVERS|err2 " + t); }
    }

    private static void showDiversPanel(android.app.Activity a, java.util.ArrayList<String[]> rows, int total) {
        try {
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 14), dp(a, 10), dp(a, 14), dp(a, 10));
            android.widget.TextView head = new android.widget.TextView(a);
            head.setText("群成员 " + total + " 人 · 按最后发言时间排序（越靠上越潜水）");
            head.setTextSize(12);
            head.setTextColor(0xFF888888);
            box.addView(head);
            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            int shown = 0;
            for (String[] r : rows) {
                if (shown++ > 80) break;
                long t = Long.parseLong(r[1]);
                String when = t <= 0 ? "从未发言" : fmtTs(t).substring(0, 16);
                android.widget.TextView tv = new android.widget.TextView(a);
                tv.setText("· " + displayOfTalker(r[0]) + "　" + when);
                tv.setTextSize(14);
                tv.setTextColor(0xFF222222);
                tv.setPadding(0, dp(a, 7), 0, dp(a, 7));
                list.addView(tv);
            }
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(a, 460)));
            new android.app.AlertDialog.Builder(a)
                    .setTitle("潜水成员")
                    .setView(box)
                    .setPositiveButton("关闭", null)
                    .show();
            log("DIVERS|rows=" + rows.size());
        } catch (Throwable t) { log("DIVERS|panel " + t); }
    }

    // ================= 未读消息汇总 =================
    private static void showUnreadDigest(final android.app.Activity a) {
        try {
            final Object h = msgDbHandle();
            if (h == null) { toast("数据库未就绪"); return; }
            new Thread(new Runnable() {
                @Override public void run() {
                    try {
                        java.util.ArrayList<String[]> items = new java.util.ArrayList<String[]>();
                        Object cur = h.getClass().getMethod("B", String.class, String[].class)
                                .invoke(h, "select username, unReadCount from rconversation where unReadCount>0 "
                                        + "order by conversationTime desc limit 25", new String[0]);
                        java.util.ArrayList<String> tks = new java.util.ArrayList<String>();
                        if (cur != null) {
                            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                            java.lang.reflect.Method gi = cur.getClass().getMethod("getInt", int.class);
                            while ((Boolean) mv.invoke(cur)) {
                                String u = (String) gs.invoke(cur, 0);
                                int n = (Integer) gi.invoke(cur, 1);
                                tks.add(u);
                                items.add(new String[]{u, String.valueOf(n), "", ""});
                            }
                            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                        }
                        for (String[] it : items) {
                            Object c2 = h.getClass().getMethod("B", String.class, String[].class)
                                    .invoke(h, "select type, content, createTime from message where talker='"
                                            + it[0].replace("'", "''") + "' and isSend=0 order by createTime desc limit 3",
                                            new String[0]);
                            StringBuilder sb = new StringBuilder();
                            long last = 0;
                            if (c2 != null) {
                                java.lang.reflect.Method mv2 = c2.getClass().getMethod("moveToNext");
                                java.lang.reflect.Method gl2 = c2.getClass().getMethod("getLong", int.class);
                                java.lang.reflect.Method gs2 = c2.getClass().getMethod("getString", int.class);
                                while ((Boolean) mv2.invoke(c2)) {
                                    long ty = (Long) gl2.invoke(c2, 0);
                                    String c = (String) gs2.invoke(c2, 1);
                                    long t = (Long) gl2.invoke(c2, 2);
                                    if (last == 0) last = t;
                                    String body = bodyOf(ty, c);
                                    if (body != null) sb.append(body.replace('\n', ' ')).append(" / ");
                                }
                                try { c2.getClass().getMethod("close").invoke(c2); } catch (Throwable ignore) { }
                            }
                            it[2] = sb.toString();
                            it[3] = String.valueOf(last);
                            if (it[3].length() > 0 && Long.parseLong(it[3]) < 100000000000L && last > 0) {
                                it[3] = String.valueOf(last * 1000L);
                            }
                        }
                        a.runOnUiThread(new Runnable() {
                            @Override public void run() { showDigestPanel(a, items); }
                        });
                    } catch (Throwable t) { log("DIGEST|err " + t); }
                }
            }).start();
        } catch (Throwable t) { log("DIGEST|err2 " + t); }
    }

