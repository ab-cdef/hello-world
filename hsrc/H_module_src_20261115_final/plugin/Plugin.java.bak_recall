                                        if (tx.length() == 0) continue;
                                        if (tx.equals(nm) || tx.equals(wxid)) {
                                            if (((android.widget.TextView) v).getTextSize() > bestSize) {
                                                bestSize = ((android.widget.TextView) v).getTextSize();
                                                best = (android.widget.TextView) v;
                                            }
                                        }
