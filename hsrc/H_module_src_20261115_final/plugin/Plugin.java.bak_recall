    /* ================= 朋友圈自动转发 ================= */
    private static final java.util.HashMap<String, Long> snsSeen = new java.util.HashMap<String, Long>();

    private static void installSnsInfoCapture(final ClassLoader app) {
        try {
            Class<?> db = Class.forName("com.tencent.wcdb.database.SQLiteDatabase", false, app);
            XC_MethodHook h = new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try { captureMsgDb(p.thisObject); } catch (Throwable ignore) { }
                    try { onSnsRow(dbPathOf(p.thisObject), p.args); } catch (Throwable ignore) { }
                }
            };
            XposedBridge.hookAllMethods(db, "insert", h);
            XposedBridge.hookAllMethods(db, "insertWithOnConflict", h);
            XposedBridge.hookAllMethods(db, "replace", h);
            XposedBridge.hookAllMethods(db, "replaceOrThrow", h);
            XposedBridge.hookAllMethods(db, "insertOrThrow", h);
            // 任何一次查询/插入都顺手记下消息库句柄，比反射猜类名可靠
            XposedBridge.hookAllMethods(db, "rawQuery", h);
            XposedBridge.hookAllMethods(db, "query", h);
            log("SNSFWD|hook installed");
            try { startFwFlusher(); } catch (Throwable ignore) { }
            // 调试用：touch 一下 .sns_selftest 就能让模块自己跑一遍转发链路（跑完自动删标记）
            try {
                final java.io.File mark = new java.io.File(DIR + "/.sns_selftest");
                if (mark.exists()) {
                    mark.delete();
                    log("SNSFWD|selftest scheduled");
                    new Thread(new Runnable() {
                        @Override public void run() {
                            try { Thread.sleep(30000L); } catch (Throwable ignore) { }
                            try { snsFwSelfTest(null); } catch (Throwable t) { log("SNSFWD|selftest err " + t); }
                        }
                    }).start();
                }
            } catch (Throwable ignore) { }
        } catch (Throwable t) { log("SNSFWD|install err " + t); }
    }

    /** 从任意 SQLiteDatabase 实例里认出消息库（EnMicroMsg.db / r61.db），直接留作句柄 */
    private static void captureMsgDb(Object db) {
        if (db == null) return;
        Object cur = dbRef;
        if (cur != null) return;
        String path = dbPathOf(db);
        if (path == null) return;
        String lp = path.toLowerCase();
        if (!(lp.contains("enmicromsg") || lp.endsWith("/r61.db") || lp.contains("mm.sqlite"))) return;
        dbRef = db;
        log("DBREF|from sqlite " + path);
    }

    private static String dbPathOf(Object db) {
        try {
            Object pv = db.getClass().getMethod("getPath").invoke(db);
            if (pv instanceof String) return (String) pv;
        } catch (Throwable ignore) { }
        return null;
    }

    /** 朋友圈新动态落库时抓一条：正文 + 配图链接，按配置决定要不要转发 */
    private static void onSnsRow(final String dbPath, Object[] args) {
        try {
            if (!cfg().optBoolean("snsAutoForward", false)) return;
            if (dbPath == null) return;
            String lp = dbPath.toLowerCase();
            if (!lp.contains("sns")) return;                       // 只认朋友圈库（SnsMicroMsg.db）
            if (args == null) return;
            String table = null;
            android.content.ContentValues cv = null;
            for (int i = 0; i < args.length; i++) {
                Object a = args[i];
                if (a instanceof String && table == null) table = (String) a;
                else if (a instanceof android.content.ContentValues && cv == null) cv = (android.content.ContentValues) a;
            }
            if (table == null || cv == null) return;
            String tl = table.toLowerCase();
            if (!(tl.contains("snsinfo") || tl.equals("sns") || tl.contains("sns2"))) return;
            String body = cv.getAsString("content");
            if (body == null || body.length() < 4) return;
            String snsId = cv.getAsString("snsId");
            if (snsId == null || snsId.length() == 0) snsId = String.valueOf(body.hashCode());
            Long ctL = cv.getAsLong("createTime");
            long ct = ctL == null ? System.currentTimeMillis() : ctL.longValue();
            if (System.currentTimeMillis() - ct > 180000L) { log("SNSFWD|skip old ct=" + ct); return; }
            String user = cv.getAsString("userName");
            String my = myWxidCached();
            if (user != null && my != null && user.equals(my)) { log("SNSFWD|skip self"); return; }
            synchronized (snsSeen) {
                if (snsSeen.containsKey(snsId)) return;
                snsSeen.put(snsId, Long.valueOf(ct));
                if (snsSeen.size() > 300) snsSeen.clear();
            }
            String desc = cleanXmlText(tagOf(body, "contentDesc"));
            if (desc == null) desc = "";
            desc = desc.trim();
            String url = cleanXmlText(tagOf(body, "url"));
            String thumb = cleanXmlText(tagOf(body, "thumb"));
            String imgUrl = (url != null && url.startsWith("http")) ? url
                    : ((thumb != null && thumb.startsWith("http")) ? thumb : null);
            String kw = cfg().optString("snsFwKeyword", "");
            if (kw.length() > 0 && !desc.contains(kw)) { log("SNSFWD|kw miss"); return; }
            if (cfg().optBoolean("snsFwOnlyImage", false) && imgUrl == null) { log("SNSFWD|skip noimg"); return; }
            if (desc.length() == 0 && imgUrl == null) return;
            String who = user == null ? "" : prettyName(user, false);
            String text = "【朋友圈 · " + who + "】"
                    + (desc.length() == 0 ? "[图片]" : desc);
            org.json.JSONArray tg = cfg().optJSONArray("snsFwTargets");
            if (tg == null || tg.length() == 0) tg = cfg().optJSONArray("fwTargets");
            if (tg == null || tg.length() == 0) { log("SNSFWD|no target"); return; }
            synchronized (fwQueue) {
                if (fwQueue.size() >= 40) { log("SNSFWD|drop queue-full"); return; }
                for (int i = 0; i < tg.length(); i++) {
                    String t = tg.optString(i);
                    if (t != null && t.length() > 0) {
                        fwQueue.add(new String[]{t, text, imgUrl == null ? "text" : "snsimg",
                                "sns:" + snsId, String.valueOf(ct), "", imgUrl == null ? "" : imgUrl});
                    }
                }
            }
            log("SNSFWD|queued who=" + who + " img=" + (imgUrl != null)
                    + " n=" + tg.length() + " desc=" + desc);
            startFwWorker();
        } catch (Throwable t) { log("SNSFWD|row err " + t); }
    }

