            ch.setOnTouchListener(new android.view.View.OnTouchListener() {
                boolean lifting = false;
                float downX = 0, downY = 0;
                Runnable arm = null;
                @Override public boolean onTouch(final android.view.View v, android.view.MotionEvent ev) {
                    int act = ev.getActionMasked();
                    if (act == android.view.MotionEvent.ACTION_DOWN) {
                        downX = ev.getRawX();
                        downY = ev.getRawY();
                        lifting = false;
                        final float sx = downX;
                        arm = new Runnable() {
                            @Override public void run() {
                                lifting = true;
                                dragJustEnded = false;
                                try { v.performHapticFeedback(android.view.HapticFeedbackConstants.LONG_PRESS); } catch (Throwable ignore) { }
                                dragBegin(a, chips, gchips, (android.widget.TextView) v, sx);
                            }
                        };
                        hh.postDelayed(arm, 320);
                        return false;
                    }
                    if (act == android.view.MotionEvent.ACTION_MOVE) {
                        if (!lifting) {
                            if (Math.abs(ev.getRawX() - downX) > dp(a, 10) || Math.abs(ev.getRawY() - downY) > dp(a, 10)) {
                                if (arm != null) hh.removeCallbacks(arm);
                            }
                            return false;
                        }
                        dragMove(a, chips, gchips, ev.getRawX());
                        return true;
                    }
                    if (act == android.view.MotionEvent.ACTION_UP || act == android.view.MotionEvent.ACTION_CANCEL) {
                        if (arm != null) hh.removeCallbacks(arm);
                        if (!lifting) return false;
                        lifting = false;
                        boolean wasDrag = dragTarget != dragFrom;
                        dragEnd(a, ar, gchips, gorder, wasDrag);
                        if (wasDrag) {
                            buildGroupHub(a);
                        } else {
                            pickGroupMembers(a, idx);
                        }
                        return true;
                    }
                    return false;
                }
            });
