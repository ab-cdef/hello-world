    /** 收集一行里的所有文字 */
    private static void rowTexts(android.view.View v, java.util.ArrayList<String> out, int depth) {
        try {
            if (v == null || depth > 20) return;
            if (v instanceof android.widget.TextView) {
                CharSequence cs = ((android.widget.TextView) v).getText();
                String t = cs == null ? "" : cs.toString().trim();
                if (t.length() > 0 && t.length() < 40) out.add(t);
            }
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                int n = g.getChildCount();
                for (int i = 0; i < n; i++) rowTexts(g.getChildAt(i), out, depth + 1);
            }
        } catch (Throwable ignore) { }
    }

    /** 从一行文本里挑出「名字」：跳过时间、未读数字、摘要 */
    private static String convTitleOf(java.util.ArrayList<String> ts) {
        for (int i = 0; i < ts.size() && i < 5; i++) {
            String t = ts.get(i);
            if (t == null) continue;
            int len = t.length();
            if (len < 2 || len > 24) continue;
            if (t.matches("[0-9]+")) continue;
            if (t.matches("(上午|下午|昨天|前天|今天)?\\s*[0-9]{1,2}[:：][0-9]{2}")) continue;
            if (t.contains("折叠置顶聊天") || t.equals("搜索") || t.equals("最近")) continue;
            if (t.contains("个群") || t.contains("条未读") || t.endsWith("条]")) continue;
            if (t.indexOf(':') >= 0 || t.indexOf('：') >= 0) continue;
            return t;
        }
        return null;
    }
    private static void deepCollect(android.view.View v, java.util.List<android.view.View> out, int depth) {
        if (v == null || depth > 40 || out.size() > 4000) return;
        out.add(v);
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) deepCollect(g.getChildAt(i), out, depth + 1);
        }
    }

    /** 反射读字符串字段（含父类，找不到就返回空） */
    private static String fldStr(Object o, String f) {
        if (o == null) return "";
        Class<?> k = o.getClass();
        int guard = 0;
        while (k != null && guard < 5) {
            try {
                java.lang.reflect.Field fd = k.getDeclaredField(f);
                fd.setAccessible(true);
                Object v = fd.get(o);
                if (v instanceof String) return (String) v;
                return "";
            } catch (Throwable ignore) { }
            k = k.getSuperclass();
            guard++;
        }
        return "";
    }

    /** 从列表 item（会话对象或 Cursor）里取名字，多个候选用 | 分隔 */
    private static String convNameOf(Object o) {
        if (o == null) return "";
        StringBuilder sb = new StringBuilder();
        String[] fs = {"field_username", "username", "field_nickname", "nickname",
                "field_displayName", "displayName", "field_conRemark", "conRemark", "field_remark",
                "m", "d", "n"};
        for (String f : fs) {
            String val = fldStr(o, f);
            if (val.length() > 0 && sb.indexOf(val) < 0) {
                if (sb.length() > 0) sb.append('|');
                sb.append(val);
            }
        }
        if (sb.length() == 0 && o instanceof android.database.Cursor) {
            android.database.Cursor c = (android.database.Cursor) o;
            for (String col : new String[]{"username", "nickname", "displayName", "conRemark", "remark"}) {
                int idx = -1;
                try { idx = c.getColumnIndex(col); } catch (Throwable ignore) { }
                if (idx < 0) continue;
                try {
                    String s = c.getString(idx);
                    if (s != null && s.length() > 0) { if (sb.length() > 0) sb.append('|'); sb.append(s); }
                } catch (Throwable ignore) { }
            }
        }
        return sb.toString();
    }

    /** 一行文本里任何一段命中集合或关键字 */
    private static boolean nameHit(String joined, java.util.HashSet<String> names, java.util.ArrayList<String> kw) {
        if (joined == null || joined.length() == 0) return false;
        for (String part : joined.split("\\|")) {
            String p = part.trim();
            if (p.length() == 0) continue;
            if (names != null && names.contains(p)) return true;
            if (kw != null) for (String k : kw) if (k.length() > 0 && p.contains(k)) return true;
        }
        return false;
    }

    private static java.util.ArrayList<android.view.View> convRows(android.app.Activity a) {
        java.util.ArrayList<android.view.View> rows = new java.util.ArrayList<android.view.View>();
        try {
            android.view.View decor = a.getWindow().getDecorView();
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            deepCollect(decor, all, 0);
            int w0 = a.getResources().getDisplayMetrics().widthPixels;
            android.view.ViewGroup best = null;
            int bestN = 0;
            for (android.view.View v : all) {
                if (!(v instanceof android.view.ViewGroup)) continue;
                String cn = v.getClass().getName();
                if (!cn.contains("RecyclerView") && !cn.contains("ConversationListView")
                        && !cn.contains("MvvmConversation")) continue;
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                int n = g.getChildCount();
                if (n <= bestN || v.getWidth() < w0 * 0.8f) continue;
                best = g;
                bestN = n;
            }
            if (best != null) {
                for (int i = 0; i < best.getChildCount(); i++) {
                    android.view.View c = best.getChildAt(i);
                    if (c != null && c.getHeight() > 0) rows.add(c);
                }
            }
            if (rows.isEmpty()) {
                for (android.view.View v : all) {
                    if (!(v instanceof android.widget.ListView)) continue;
                    android.widget.ListView lv = (android.widget.ListView) v;
                    if (lv.getChildCount() == 0) continue;
                    for (int i = 0; i < lv.getChildCount(); i++) {
                        android.view.View c = lv.getChildAt(i);
                        if (c != null) rows.add(c);
                    }
                    break;
                }
            }
        } catch (Throwable t) { log("HIDE|convRows err " + t); }
        return rows;
    }

    /** username → 名字 缓存（群名/备注变动少，命中一次就记住） */
    private static final java.util.HashMap<String, String> nameCache = new java.util.HashMap<String, String>();

    private static String cachedName(String un) {
        if (un == null) return "";
        String key = un.trim();
        if (key.length() == 0) return "";
        String hit = nameCache.get(key);
        if (hit != null) return hit;
        String nm = "";
        try {
            String n = nameOf(key);
            if (n != null && n.length() > 0 && !n.equals(key)) nm = n.trim();
        } catch (Throwable ignore) { }
        nameCache.put(key, nm);
        return nm;
    }

    /** 会话列表过滤适配器：跳过命中行，列表真正收缩，不留空白 */
    static class ConvFilterAdapter extends android.widget.BaseAdapter {
        private final android.widget.ListAdapter base;
        private final int[] skip;
        ConvFilterAdapter(android.widget.ListAdapter b, int[] sk) {
            base = b;
            java.util.Arrays.sort(sk);
            skip = sk;
        }
        int real(int pos) {
            int p = pos;
            for (int i = 0; i < skip.length; i++) {
                if (skip[i] <= p) p++;
                else break;
            }
            return p;
        }
        @Override public int getCount() { return Math.max(0, base.getCount() - skip.length); }
        @Override public Object getItem(int position) { return base.getItem(real(position)); }
        @Override public long getItemId(int position) { return base.getItemId(real(position)); }
        @Override public android.view.View getView(int position, android.view.View convertView, android.view.ViewGroup parent) {
            return base.getView(real(position), convertView, parent);
        }
        @Override public int getViewTypeCount() { return base.getViewTypeCount(); }
        @Override public int getItemViewType(int position) { return base.getItemViewType(real(position)); }
        @Override public boolean areAllItemsEnabled() { return base.areAllItemsEnabled(); }
        @Override public boolean isEnabled(int position) { return base.isEnabled(real(position)); }
        @Override public boolean hasStableIds() { return base.hasStableIds(); }
        @Override public boolean isEmpty() { return getCount() == 0; }
    }

    /** 当前屏幕上可见的会话行：[View child, username, 名字, adapter 位置] */
    private static java.util.ArrayList<Object[]> visibleConvs(android.app.Activity a) {
        java.util.ArrayList<Object[]> out = new java.util.ArrayList<Object[]>();
        try {
            android.view.View decor = a.getWindow().getDecorView();
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            deepCollect(decor, all, 0);
            int w0 = a.getResources().getDisplayMetrics().widthPixels;
            android.view.View lv = null;
            for (android.view.View v : all) {
                if (!(v instanceof android.view.ViewGroup)) continue;
                String cn = v.getClass().getName();
                if (!cn.contains("Conversation")) continue;
                if (v.getWidth() < w0 * 0.8f || ((android.view.ViewGroup) v).getChildCount() == 0) continue;
                if (lv == null || ((android.view.ViewGroup) v).getChildCount() > ((android.view.ViewGroup) lv).getChildCount()) lv = v;
            }
            if (lv == null) return out;
            convLv = lv;
            Object ad = null;
            try { ad = lv.getClass().getMethod("getAdapter").invoke(lv); } catch (Throwable ignore) { }
            android.view.ViewGroup lvg = (android.view.ViewGroup) lv;
            for (int i = 0; i < lvg.getChildCount(); i++) {
                android.view.View child = lvg.getChildAt(i);
                if (child == null || child.getHeight() <= 0) continue;
                int pos = i;
                try {
                    Object p2 = lv.getClass().getMethod("getPositionForView", android.view.View.class).invoke(lv, child);
                    if (p2 instanceof Integer) pos = (Integer) p2;
                } catch (Throwable ignore) { }
                Object item = null;
                try { if (ad != null) item = ad.getClass().getMethod("getItem", int.class).invoke(ad, pos); } catch (Throwable ignore) { }
                if (item == null) continue;
                String un = fldStr(item, "field_username");
                if (un.length() == 0) {
                    Object tg = child.getTag();
                    if (tg != null && !(tg instanceof String)) un = fldStr(tg, "m");
                }
                if (un.length() == 0) continue;
                out.add(new Object[]{child, un, cachedName(un), pos});
            }
        } catch (Throwable t) { log("HIDE|vis err " + t); }
        return out;
    }

    /** 在会话列表里隐藏/恢复行 */
    private static int applyHideRows(android.app.Activity a) {
        int hidden = 0;
        try {
            java.util.HashSet<String> names = hiddenNames();
            java.util.ArrayList<String> kw = null;
            if (names.isEmpty()) {
                for (android.view.View v : hiddenRows.keySet()) {
                    try { if (v != null) v.setVisibility(android.view.View.VISIBLE); } catch (Throwable ignore) { }
                }
                hiddenRows.clear();
                lastSkipKey = "";
                return 0;
            }
            for (Object[] r : visibleConvs(a)) {
                android.view.View child = (android.view.View) r[0];
                String un = (String) r[1];
                String nm = (String) r[2];
                String joined = (nm == null || nm.length() == 0) ? un : un + "|" + nm;
                if (nameHit(joined, names, kw)) {
                    if (child.getVisibility() != android.view.View.GONE) {
                        try {
                            child.setVisibility(android.view.View.GONE);
                            hiddenRows.put(child, Boolean.TRUE);
                            if (dbgHit < 30) { dbgHit++; log("HIDE|hid " + joined); }
                        } catch (Throwable ignore) { }
                    }
                    hidden++;
                } else if (hiddenRows.containsKey(child)) {
                    try { child.setVisibility(android.view.View.VISIBLE); } catch (Throwable ignore) { }
                    hiddenRows.remove(child);
                }
            }
        } catch (Throwable t) { log("HIDE|err " + t); }
        return hidden;
    }

    private static void startHidePulse(final android.app.Activity a) {
        try {
            boolean on = cfg().optBoolean("hideOn", false);
            if (!on) return;
            log("HIDE|pulse start pid=" + android.os.Process.myPid());
            if (hideH != null) { hideH.removeCallbacksAndMessages(null); }
            hideH = new android.os.Handler(android.os.Looper.getMainLooper());
            hideR = new Runnable() {
                @Override public void run() {
                    try {
                        android.app.Activity cur = topAct != null ? topAct : a;
                        if (cur == null || !cur.getClass().getName().contains("LauncherUI")) cur = topActivityNow();
                        if (cur != null) {
                            int n = applyHideRows(cur);
                            if (n > 0) log("HIDE|rows=" + n);
                        }
                    } catch (Throwable ignore) { }
                    try { hideH.postDelayed(this, 900L); } catch (Throwable ignore) { }
                }
            };
            hideH.postDelayed(hideR, 800L);
        } catch (Throwable ignore) { }
    }

    private static void showHideFriendsSetting(final android.app.Activity a) {
        final boolean on = cfg().optBoolean("hideOn", false);
        org.json.JSONArray arr = cfg().optJSONArray("hideFriends");
        int n = arr == null ? 0 : arr.length();
        String[] items = new String[]{
                "开关：" + (on ? "开" : "关"),
                "添加要隐藏的好友（已选 " + n + "）",
                "清空隐藏列表"
        };
        new android.app.AlertDialog.Builder(a)
                .setTitle("隐藏好友（会话列表不显示）")
                .setItems(items, new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) {
                        if (which == 0) { setOn("hideOn", !on); toast(!on ? "隐藏好友：开" : "隐藏好友：关"); return; }
                        if (which == 2) { setJsonCfg("hideFriends", new org.json.JSONArray()); toast("已清空"); return; }
                        java.util.ArrayList<String> pre = new java.util.ArrayList<String>();
                        org.json.JSONArray c1 = cfg().optJSONArray("hideFriends");
                        if (c1 != null) {
                            for (int i = 0; i < c1.length(); i++) {
                                String v = c1.optString(i);
                                int bar = v.indexOf('|');
                                pre.add(bar > 0 ? v.substring(0, bar) : v);
                            }
                        }
                        showTalkerPickerMulti(a, "选要隐藏的好友/群（可多选）", false, pre, new ChatPickMulti() {
                            @Override public void onPick(java.util.ArrayList<String[]> sel) {
                                org.json.JSONArray out = new org.json.JSONArray();
                                for (String[] e : sel) out.put(e[0] + "|" + e[1]);
                                setJsonCfg("hideFriends", out);
                                toast("已隐藏：" + out.length() + " 个");
                            }
                        });
                    }
                })
                .setNegativeButton("关闭", null)
                .show();
    }

    private static void showWorkChatsSetting(final android.app.Activity a) {
        org.json.JSONArray arr = cfg().optJSONArray("workChats");
        int n = arr == null ? 0 : arr.length();
        String[] items = new String[]{
                "选工作群/同事（已选 " + n + "）",
                "按关键字自动归类",
                "清空工作名单"
        };
        new android.app.AlertDialog.Builder(a)
                .setTitle("工作群 / 同事名单")
                .setItems(items, new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) {
                        if (which == 0) {
                            java.util.ArrayList<String> pre = new java.util.ArrayList<String>();
                            org.json.JSONArray c1 = cfg().optJSONArray("workChats");
                            if (c1 != null) {
                                for (int i = 0; i < c1.length(); i++) {
                                    String v = c1.optString(i);
                                    int bar = v.indexOf('|');
                                    pre.add(bar > 0 ? v.substring(0, bar) : v);
                                }
                            }
                            showTalkerPickerMulti(a, "选工作群/同事（可多选）", false, pre, new ChatPickMulti() {
                                @Override public void onPick(java.util.ArrayList<String[]> sel) {
                                    org.json.JSONArray out = new org.json.JSONArray();
                                    for (String[] e : sel) out.put(e[0] + "|" + e[1]);
                                    setJsonCfg("workChats", out);
                                    toast("工作名单：" + out.length() + " 个");
                                }
                            });
                            return;
                        }
                        if (which == 1) {
                            int got = autoCollectWorkChats(a);
                            toast(got > 0 ? "已自动归类 " + got + " 个" : "没发现符合关键字的会话");
                            return;
                        }
                        setJsonCfg("workChats", new org.json.JSONArray());
                        toast("已清空工作名单");
                    }
                })
                .setNegativeButton("关闭", null)
                .show();
    }

    /** 按关键字把当前会话列表里命中的标题收进工作名单（只存名字） */
    private static int autoCollectWorkChats(android.app.Activity a) {
        int added = 0;
        try {
            java.util.ArrayList<String> kw = workKeywords();
            java.util.HashSet<String> has = new java.util.HashSet<String>();
            org.json.JSONArray arr = cfg().optJSONArray("workChats");
            org.json.JSONArray out = arr == null ? new org.json.JSONArray() : arr;
            for (int i = 0; i < out.length(); i++) {
                String v = out.optString(i, "");
                if (v.length() == 0) continue;
                has.add(v);
                int bar = v.indexOf('|');
                if (bar > 0) has.add(v.substring(0, bar));
            }
            for (Object[] r : visibleConvs(a)) {
                String un = (String) r[1];
                String nm = (String) r[2];
                if (nm == null || nm.length() == 0) continue;
                boolean hit = false;
                for (String k : kw) if (k.length() > 0 && nm.contains(k)) { hit = true; break; }
                if (!hit || has.contains(un)) continue;
                has.add(un);
                out.put(un + "|" + nm);
                added++;
            }
            if (added > 0) setJsonCfg("workChats", out);
            log("WORKMODE|auto add=" + added);
        } catch (Throwable t) { log("WORKMODE|auto err " + t); }
        return added;
    }

    /* ================= 消息自动转发 ================= */

    private static final java.util.ArrayDeque<String[]> fwQueue = new java.util.ArrayDeque<String[]>();
    /** 微信在后台时发不出去的转发任务，等前台再补发 */
    private static final java.util.ArrayDeque<String[]> fwDefer = new java.util.ArrayDeque<String[]>();
    private static volatile boolean fwFlushOn = false;
    private static volatile boolean fwWorkerOn = false;
    private static final java.util.HashMap<String, Long> fwSeen = new java.util.HashMap<String, Long>();
    private static volatile long fwWindowAt = 0;
    private static volatile int fwWindowN = 0;

    /** 类型 -> 占位符文本 */
    private static String typePlaceholder(int type) {
        switch (type & 0xFFFF) {
            case 3: return "[图片]";
            case 34: return "[语音]";
            case 43: return "[视频]";
            case 47: return "[表情]";
            case 48: return "[位置]";
            case 42: return "[名片]";
            case 49: return "[链接/文件]";
            case 50: return "[通话]";
            case 10000: return "";
            case 10002: return "";
            default: return "[消息]";
        }
    }

    /** 49 类型（链接/文件/小程序/引用/视频号…）转成可读文本 */
    private static String describeAppMsg(String c) {
        try {
            if (c == null || c.length() == 0) return "[链接]";
            String ap = cleanXmlText(tagOf(c, "type"));         // appmsg 子类型
            String ttl = cleanXmlText(tagOf(c, "title"));
            String url = cleanXmlText(tagOf(c, "url"));
            String ext = cleanXmlText(tagOf(c, "fileext"));
            String len = cleanXmlText(tagOf(c, "totallen"));
            if (ttl == null) ttl = "";
            int at = 0;
            try { at = Integer.parseInt(ap == null ? "0" : ap.trim()); } catch (Throwable ignore) { }

            if (at == 6 || at == 74 || (ext != null && ext.length() > 0 && len != null && len.length() > 0)) {
                String sz = "";
                try {
                    long b = Long.parseLong(len == null ? "0" : len.trim());
                    sz = b > 1048576 ? String.format(java.util.Locale.US, "%.1fMB", b / 1048576.0)
                            : b > 1024 ? (b / 1024) + "KB" : b + "B";
                } catch (Throwable ignore) { }
                return "[文件] " + ttl + (sz.length() > 0 ? " (" + sz + ")" : "");
            }
            if (at == 33 || at == 36) return "[小程序] " + ttl;
            if (at == 51 || at == 52 || at == 53) return "[视频号] " + ttl;
            if (at == 57) return "[引用] " + ttl;
            if (at == 19) return "[聊天记录] " + ttl;
            if (at == 5 || at == 4) {
                return "[链接] " + ttl + (url != null && url.startsWith("http") ? "\n" + url : "");
            }
            if (url != null && url.startsWith("http")) return "[链接] " + ttl + "\n" + url;
            return "[链接] " + ttl;
        } catch (Throwable t) { return "[链接]"; }
    }

    /** 渲染转发前缀模板，支持 {群} {发送人} {备注} {微信号} {时间} */
    private static String renderFwTemplate(String tpl, String g, String sname, String remark,
                                           String wxid, String time) {
        String out = tpl == null ? "" : tpl;
        out = out.replace("{群}", g == null ? "" : g);
        out = out.replace("{发送人}", sname == null ? "" : sname);
        out = out.replace("{备注}", remark == null ? "" : remark);
        out = out.replace("{微信号}", wxid == null ? "" : wxid);
        out = out.replace("{时间}", time == null ? "" : time);
        return out;
    }

    /** 显示名兜底：查不到昵称时不要甩出 wxid 原文 */
    private static String prettyName(String tk, boolean isGroup) {
        try {
            String nm = displayOfTalker(tk);
            if (nm == null) nm = "";
            nm = nm.trim();
            boolean bad = nm.length() == 0 || nm.startsWith("wxid_") || nm.endsWith("@chatroom")
                    || nm.equals(tk) || nm.matches("[0-9]+");
            if (bad) return isGroup ? "群聊" : "群成员";
            return nm;
        } catch (Throwable t) { return isGroup ? "群聊" : "群成员"; }
    }

    /** 收到消息时调用：命中规则则入转发队列 */
    private static void autoForward(String talker, Integer type, String content, Integer isSend) {
        autoForward(talker, type, content, isSend, null, null);
    }

    private static void autoForward(String talker, Integer type, String content, Integer isSend,
                                    String imgPath, Long msgSvrId) {
        try {
            if (talker == null || type == null || isSend == null) return;
            if (!cfg().optBoolean("fwOn", false)) return;
            if (isSend.intValue() != 0) return;                 // 只转发收到的
            int tp = type.intValue();
            int base = tp & 0xFFFF;
            if (base == 10000 || base == 10002) return;          // 系统提示

            org.json.JSONArray targets = cfg().optJSONArray("fwTargets");
            if (targets == null || targets.length() == 0) return;
            org.json.JSONArray sources = cfg().optJSONArray("fwSources");
            boolean srcOk = sources == null || sources.length() == 0;
            if (!srcOk) {
                for (int i = 0; i < sources.length(); i++) {
                    if (talker.equals(sources.optString(i))) { srcOk = true; break; }
                }
            }
            if (!srcOk) return;

            // 目标里不转发，避免互相转发成环
            for (int i = 0; i < targets.length(); i++) {
                if (talker.equals(targets.optString(i))) { log("FWD|skip loop target"); return; }
            }

            String text;
            String senderWxid = null;
            boolean wantImage = (base == 3) && cfg().optBoolean("fwImage", false);
            boolean wantVoice = (base == 34) && cfg().optBoolean("fwVoice", true);
            if (base == 1) {
                text = content == null ? "" : content;
                // 群消息原始格式是 "wxid_xxx:\n正文"，剥掉前缀并记下发送人
                if (talker.endsWith("@chatroom")) {
                    int p2 = text.indexOf(":\n");
                    if (p2 > 0 && p2 < 64) {
                        String sid = text.substring(0, p2).trim();
                        if (sid.length() > 0 && !sid.contains(" ") && !sid.contains("<")) {
                            senderWxid = sid;
                            text = text.substring(p2 + 2).trim();
                        }
                    }
                }
            } else if (base == 49) {
                text = describeAppMsg(content == null ? "" : content);
            } else if (base == 42) {
                String nick = cleanXmlText(tagOf(content == null ? "" : content, "nickname"));
                text = "[名片] " + (nick == null || nick.length() == 0 ? "" : nick);
            } else if (base == 48) {
                String lbl = cleanXmlText(tagOf(content == null ? "" : content, "label"));
                text = "[位置] " + (lbl == null || lbl.length() == 0 ? "" : lbl);
            } else if (base == 34 && wantVoice) {
                String d = attrOf(content == null ? "" : content, "voicelength");
                String sec = "";
                try {
                    if (d != null) sec = String.valueOf(Math.max(1, Integer.parseInt(d.trim()) / 1000));
                } catch (Throwable ignore) { }
                text = "[语音" + (sec.length() > 0 ? " " + sec + "\u2033" : "") + "]";
            } else {
                text = typePlaceholder(base);
            }
            if (text == null) text = "";
            text = text.trim();
            if (text.length() == 0) return;

            String kw = cfg().optString("fwKeyword", "");
            if (kw.length() > 0 && !text.contains(kw)) return;

            // 去重：同一会话同一内容 5 秒内只转一次
            String fp = talker + "|" + text;
            long now = System.currentTimeMillis();
            Long prev = fwSeen.get(fp);
            if (prev != null && now - prev.longValue() < 5000) return;
            fwSeen.put(fp, Long.valueOf(now));
            if (fwSeen.size() > 200) fwSeen.clear();

            // ---- 重活挪到后台线程，避免拖慢微信的入库钩子 ----
            final String fTk = talker;
            final String fText = text;
            final String fSender = senderWxid;
            final boolean fImg = wantImage;
            final boolean fVoice = wantVoice;
            final String fPath = imgPath;
            final long fSvr = msgSvrId == null ? 0L : msgSvrId.longValue();
            final org.json.JSONArray fTg = targets;
            final int fCount = targets.length();
            final String fSrc = String.valueOf(System.currentTimeMillis());
            new Thread(new Runnable() {
                @Override public void run() {
                    try {
                        enqueueForward(fTk, fText, fSender, fImg, fVoice, fTg, fCount, fSrc, fPath, fSvr);
                    } catch (Throwable t) { log("FWD|work err " + t); }
                }
            }).start();

        } catch (Throwable t) { log("FWD|err " + t); }
    }

    /** 取该会话最近 N 秒内的一张图（缩略图/大图） */
    private static android.graphics.Bitmap loadRecentImage(String talker, long withinMs) {
        try {
            Object h = msgDbHandle();
            log("IMGLOAD|h=" + (h == null ? "null" : "ok"));
            if (h == null) return null;
            long since = sinceRaw(System.currentTimeMillis() - withinMs);
            log("IMGLOAD|since=" + since + " tk=" + talker);
            Object cur = h.getClass().getMethod("B", String.class, String[].class).invoke(h,
                    "select msgSvrId, ifnull(imgPath,''), ifnull(content,'') from message where talker='"
                            + escSql(talker) + "' and (type&65535)=3 and createTime>=" + since
                            + " order by createTime desc limit 1", new String[0]);
            if (cur == null) return null;
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
            boolean has = (Boolean) mv.invoke(cur);
            log("IMGLOAD|row=" + has);
            if (has) {
                long svr = (Long) gl.invoke(cur, 0);
                String imgPath = (String) gs.invoke(cur, 1);
                String body = (String) gs.invoke(cur, 2);
                String key = attrOf(body, "aeskey");
                String alt = attrOf(body, "cdnthumbaeskey");
                try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                preferBigImg = true;
                android.graphics.Bitmap bm = loadImageThumb2(h, svr, key, imgPath, alt);
                preferBigImg = false;
                log("IMGLOAD|bm=" + (bm == null ? "null" : bm.getWidth() + "x" + bm.getHeight()));
                return bm;
            }
            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
        } catch (Throwable t) { log("IMGLOAD|err " + t); }
        return null;
    }

    /** 直接下载一个 http 图片到相簿，返回 content:// Uri（朋友圈配图走这条） */
    private static android.net.Uri downloadUrlToMedia(String url) {
        try {
            if (url == null || url.length() < 8 || !url.startsWith("http")) return null;
            java.net.URL u = new java.net.URL(url);
            java.net.HttpURLConnection conn = (java.net.HttpURLConnection) u.openConnection();
            conn.setConnectTimeout(8000);
            conn.setReadTimeout(12000);
            conn.setRequestProperty("User-Agent", "Mozilla/5.0 (Linux; Android 14)");
            conn.connect();
            int code = conn.getResponseCode();
            log("FWD|sns dl code=" + code + " len=" + conn.getContentLength());
            if (code != 200) return null;
            android.graphics.BitmapFactory.Options op = new android.graphics.BitmapFactory.Options();
            op.inJustDecodeBounds = false;
            android.graphics.Bitmap bm;
            java.io.InputStream in = conn.getInputStream();
            bm = android.graphics.BitmapFactory.decodeStream(in);
            try { in.close(); } catch (Throwable ignore) { }
            conn.disconnect();
            if (bm == null) return null;
            android.net.Uri uri = saveBitmapToMedia(bm);
            log("FWD|sns dl bm=" + bm.getWidth() + "x" + bm.getHeight() + " uri=" + uri);
            return uri;
        } catch (Throwable t) { log("FWD|sns dl err " + t); return null; }
    }

    /** 把一份已落盘的图片文件复制进相簿，返回 content:// Uri（只认微信已经解好的常见图片格式） */
    private static android.net.Uri copyFileToMedia(String path) {
        try {
            if (path == null) return null;
            path = path.trim();
            if (path.length() < 5) return null;
            String low = path.toLowerCase();
            if (!(low.endsWith(".jpg") || low.endsWith(".jpeg") || low.endsWith(".png")
                    || low.endsWith(".gif") || low.endsWith(".webp"))) {
                log("FWD|img skip ext " + path);
                return null;
            }
            java.io.File f = new java.io.File(path);
            if (!f.isFile() || f.length() < 1024) return null;
            android.content.Context c = ctxAny();
            if (c == null) return null;
            String name = "wxh_fw_" + System.currentTimeMillis()
                    + path.substring(path.lastIndexOf('.'));
            android.content.ContentValues cv = new android.content.ContentValues();
            cv.put(android.provider.MediaStore.Images.Media.DISPLAY_NAME, name);
            cv.put(android.provider.MediaStore.Images.Media.MIME_TYPE,
                    low.endsWith(".png") ? "image/png" : (low.endsWith(".gif") ? "image/gif" : "image/jpeg"));
            if (android.os.Build.VERSION.SDK_INT >= 29) {
                cv.put(android.provider.MediaStore.Images.Media.RELATIVE_PATH, "Pictures/wxh");
            }
            android.net.Uri uri = c.getContentResolver().insert(
                    android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI, cv);
            if (uri == null) return null;
            java.io.OutputStream os = c.getContentResolver().openOutputStream(uri);
            java.io.FileInputStream in = new java.io.FileInputStream(f);
            byte[] buf = new byte[16384];
            int n;
            while ((n = in.read(buf)) > 0) os.write(buf, 0, n);
            in.close();
            os.flush();
            os.close();
            return uri;
        } catch (Throwable t) { log("FWD|img copy err " + t); return null; }
    }

    /** 按 msgSvrId 回消息库查这张图的落盘路径（图片已下载过才有值） */
    private static String imgPathOfSvrId(long svrId) {
        try {
            Object h = msgDbHandle();
            if (h == null) return null;
            Object cur = h.getClass().getMethod("B", String.class, String[].class).invoke(h,
                    "select ifnull(imgPath,''), ifnull(content,'') from message where msgSvrId="
                            + svrId + " limit 1", new String[0]);
            if (cur == null) return null;
            boolean has = (Boolean) cur.getClass().getMethod("moveToNext").invoke(cur);
            String p = null;
            if (has) {
                try { p = (String) cur.getClass().getMethod("getString", int.class).invoke(cur, 0); }
                catch (Throwable ignore) { }
                if (p == null || p.length() == 0) {
                    try {
                        String body = (String) cur.getClass().getMethod("getString", int.class).invoke(cur, 1);
                        log("FWD|img no path for svr=" + svrId + " body="
                                + (body == null ? "" : String.valueOf(body).substring(0, Math.min(120, body.length()))));
                    } catch (Throwable ignore) { }
                }
            }
            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
            return p;
        } catch (Throwable t) { log("FWD|img svr err " + t); return null; }
    }

    /** 撤回备份：把被撤回的图片/语音原文件另存一份，撤回后仍能看能听 */
    private static void recallBackup(long svrId, String talker) {
        if (svrId <= 0) return;
        try {
            String ip = imgPathOfSvrId(svrId);
            if (ip == null || ip.trim().length() == 0) {
                log("RBK|no path svr=" + svrId);
                return;
            }
            java.io.File src = new java.io.File(ip);
            if (!src.isFile() && ip.contains("th_")) {
                // 缩略图路径换原图：th_ 后面就是文件名里的 md5 段
                String md5 = ip.substring(ip.indexOf("th_") + 3);
                md5 = md5.replaceAll("[^0-9a-zA-Z]", "");
                java.io.File dir = src.getParentFile();
                if (dir != null) {
                    java.io.File[] fs = dir.listFiles();
                    if (fs != null) {
                        for (java.io.File f : fs) {
                            if (f.isFile() && f.getName().contains(md5)) { src = f; break; }
                        }
                    }
                }
            }
            if (!src.isFile()) {
                log("RBK|miss " + ip);
                return;
            }
            java.io.File out = new java.io.File(DIR, "wxh_recall");
            if (!out.exists()) out.mkdirs();
            String name = svrId + "_" + src.getName();
            java.io.File dst = new java.io.File(out, name);
            if (dst.isFile() && dst.length() == src.length()) return;
            java.io.FileInputStream in = new java.io.FileInputStream(src);
            java.io.FileOutputStream fo = new java.io.FileOutputStream(dst);
            byte[] buf = new byte[8192];
            int n;
            while ((n = in.read(buf)) > 0) fo.write(buf, 0, n);
            fo.close();
            in.close();
            log("RBK|saved " + talker + " -> " + dst.getAbsolutePath() + " (" + dst.length() + "B)");
        } catch (Throwable t) {
            log("RBK|err " + t);
        }
    }

    /** 位图存进相册（MediaStore），返回 content:// Uri */
    private static android.net.Uri saveBitmapToMedia(android.graphics.Bitmap bm) {
        try {
            if (bm == null) return null;
            android.content.Context c = ctxAny();
            if (c == null) return null;
            String name = "wxh_fw_" + System.currentTimeMillis() + ".png";
            android.content.ContentValues cv = new android.content.ContentValues();
            cv.put(android.provider.MediaStore.Images.Media.DISPLAY_NAME, name);
            cv.put(android.provider.MediaStore.Images.Media.MIME_TYPE, "image/png");
            if (android.os.Build.VERSION.SDK_INT >= 29) {
                cv.put(android.provider.MediaStore.Images.Media.RELATIVE_PATH, "Pictures/wxh");
            }
            android.net.Uri uri = c.getContentResolver().insert(
                    android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI, cv);
            if (uri == null) return null;
            java.io.OutputStream os = c.getContentResolver().openOutputStream(uri);
            bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, os);
            os.flush(); os.close();
            return uri;
        } catch (Throwable t) { log("IMGSEND|save err " + t); return null; }
    }

    /** 后台组装前缀并入队（含限流、队列上限） */
    private static void enqueueForward(String talker, String text, String senderWxid,
                                       boolean wantImage, org.json.JSONArray targets,
                                       int count, String srcCt) {
        enqueueForward(talker, text, senderWxid, wantImage, false, targets, count, srcCt, null, 0L);
    }

    private static void enqueueForward(String talker, String text, String senderWxid,
                                       boolean wantImage, org.json.JSONArray targets,
                                       int count, String srcCt, String imgPath, long msgSvrId) {
        enqueueForward(talker, text, senderWxid, wantImage, false, targets, count, srcCt, imgPath, msgSvrId);
    }

    private static void enqueueForward(String talker, String text, String senderWxid,
                                       boolean wantImage, boolean wantVoice, org.json.JSONArray targets,
                                       int count, String srcCt, String imgPath, long msgSvrId) {
        try {
            String gname = prettyName(talker, true);
            String sname = senderWxid != null ? prettyName(senderWxid, false)
                    : prettyName(talker, talker.endsWith("@chatroom"));
            String remark = "";
            if (senderWxid != null) {
                try {
                    java.util.List<Object[]> rc = queryRows(
                            "select ifnull(conRemark,'') from rcontact where username='"
                                    + escSql(senderWxid) + " limit 1", 1);
                    if (!rc.isEmpty() && rc.get(0)[0] != null) remark = String.valueOf(rc.get(0)[0]).trim();
                } catch (Throwable ignore) { }
            }
            String timeS = new java.text.SimpleDateFormat("HH:mm", java.util.Locale.US)
                    .format(new java.util.Date());
            String prefix = cfg().optString("fwPrefix", "");
            StringBuilder line = new StringBuilder();
            if (prefix.length() > 0) line.append(prefix);
            if (cfg().optBoolean("fwShowFrom", true)) {
                String tpl = cfg().optString("fwTemplate", "");
                if (tpl.length() == 0) tpl = "【{群} · {发送人}】";
                String head = renderFwTemplate(tpl, gname, sname, remark, senderWxid, timeS);
                head = head.replace("【 · 】", "").replace("【 ·", "【").replace(" · 】", "】")
                        .replace("[ · ]", "").replace("[ ·", "[").replace(" · ]", "]")
                        .replace("： · ", "：").replace(": · ", ": ");
                if (head.trim().length() > 0 && !head.trim().equals("【】") && !head.trim().equals("[]")) {
                    line.append(head.trim()).append(" ");
                }
            }
            line.append(text.length() > 300 ? text.substring(0, 300) + "…" : text);
            String out = line.toString();

            // 限流：1 分钟内最多 20 条；队列上限 40
            long now = System.currentTimeMillis();
            if (now - fwWindowAt > 60000L) { fwWindowAt = now; fwWindowN = 0; }
            if (fwWindowN >= 20) { log("FWD|drop rate-limit"); return; }
            fwWindowN++;
            synchronized (fwQueue) {
                if (fwQueue.size() >= 40) { log("FWD|drop queue-full"); return; }
                for (int i = 0; i < count; i++) {
                    String tg = targets.optString(i);
                    if (tg != null && tg.length() > 0) {
                        fwQueue.add(new String[]{tg, out, wantVoice ? "voice" : (wantImage ? "img" : "text"),
                                talker, srcCt, imgPath == null ? "" : imgPath, String.valueOf(msgSvrId),
                                String.valueOf(wantImage)});
                    }
                }
            }
            log("FWD|queued from=" + talker + " n=" + count + " text=" + out);
            startFwWorker();
        } catch (Throwable t) { log("FWD|enqueue err " + t); }
    }

    /** 15 秒一轮把「后台没发出去」的任务挪回队列，微信一回到前台就补发 */
    private static void startFwFlusher() {
        if (fwFlushOn) return;
        fwFlushOn = true;
        new Thread(new Runnable() {
            @Override public void run() {
                while (true) {
                    try { Thread.sleep(15000L); } catch (Throwable ignore) { }
                    try {
                        android.app.Activity an = topAct != null ? topAct : (lastAct != null ? lastAct : mainAct);
                        if (an == null) continue;
                        int n = 0;
                        while (true) {
                            String[] j = null;
                            synchronized (fwDefer) { j = fwDefer.poll(); }
                            if (j == null) break;
                            synchronized (fwQueue) { fwQueue.add(j); }
                            n++;
                        }
                        if (n > 0) { log("FWD|flush deferred n=" + n); startFwWorker(); }
                    } catch (Throwable ignore) { }
                }
            }
        }).start();
    }

    /** 语音消息的 amr 落盘路径：先查库 imgPath，再按时间扫描 voice2 目录 */
    private static String voicePathOfSvrId(long svr) {
        try {
            if (svr > 0L) {
                String p = imgPathOfSvrId(svr);
                if (p != null && p.length() > 0) {
                    java.io.File f = new java.io.File(p);
                    if (f.isFile()) return p;
                }
            }
        } catch (Throwable ignore) { }
        try {
            java.io.File newest = null;
            for (java.io.File base : voice2Bases()) {
                newest = newestAmr(base, newest, 0);
            }
            if (newest != null) return newest.getAbsolutePath();
        } catch (Throwable ignore) { }
        return null;
    }

    private static java.util.List<java.io.File> voice2Bases() {
        java.util.List<java.io.File> out = new java.util.ArrayList<java.io.File>();
        try {
            java.io.File dir = new java.io.File(DIR);
            java.io.File mm = new java.io.File(dir, "MicroMsg");
            if (!mm.isDirectory()) mm = dir;
            java.io.File[] subs = mm.listFiles();
            if (subs != null) {
                for (java.io.File f : subs) {
                    if (f.isDirectory() && new java.io.File(f, "voice2").isDirectory()) out.add(new java.io.File(f, "voice2"));
                }
            }
            java.io.File v2 = new java.io.File(dir, "voice2");
            if (v2.isDirectory()) out.add(v2);
        } catch (Throwable ignore) { }
        return out;
    }

    private static java.io.File newestAmr(java.io.File dir, java.io.File best, int depth) {
        if (dir == null || depth > 3) return best;
        java.io.File[] fs = dir.listFiles();
        if (fs == null) return best;
        for (java.io.File f : fs) {
            if (f.isDirectory()) { best = newestAmr(f, best, depth + 1); continue; }
            String n = f.getName();
            if (!(n.endsWith(".amr") || n.endsWith(".silk"))) continue;
            if (best == null || f.lastModified() > best.lastModified()) best = f;
        }
        return best;
    }

    /** 把音频塞进 MediaStore，再走微信自己的「分享 → 选择聊天」通道发出去（目标会话自动点选） */
    private static void sendAudioFileTo(final android.app.Activity host, final String talker, final String path, final String label) {
        new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
            @Override public void run() {
                try {
                    java.io.File f = new java.io.File(path);
                    byte[] d = readAll(f);
                    if (d == null) { log("FWD|voice read fail " + path); sendTextTo(host, talker, label); return; }
                    String nm = f.getName();
                    if (!nm.toLowerCase().endsWith(".amr")) nm = nm + ".amr";
                    android.content.ContentValues cv = new android.content.ContentValues();
                    cv.put(android.provider.MediaStore.Audio.Media.DISPLAY_NAME, "wxhvoice_" + Math.abs(path.hashCode()) + "_" + nm);
                    cv.put(android.provider.MediaStore.Audio.Media.MIME_TYPE, "audio/amr");
                    if (android.os.Build.VERSION.SDK_INT >= 29) {
                        cv.put(android.provider.MediaStore.Audio.Media.RELATIVE_PATH, "Music/wxh");
                    }
                    android.net.Uri uri = host.getContentResolver().insert(
                            android.provider.MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, cv);
                    if (uri == null) { log("FWD|voice media insert null"); sendTextTo(host, talker, label); return; }
                    java.io.OutputStream os = host.getContentResolver().openOutputStream(uri);
                    os.write(d); os.flush(); os.close();
                    log("FWD|voice media " + uri + " " + d.length + "B");

                    android.content.Intent it = new android.content.Intent(android.content.Intent.ACTION_SEND);
                    it.setType("audio/*");
                    it.setPackage(wxPkg());
                    it.putExtra(android.content.Intent.EXTRA_STREAM, uri);
                    it.putExtra(android.content.Intent.EXTRA_TEXT, label);
                    it.addFlags(android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION);
                    it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
                    host.startActivity(it);
                    log("FWD|voice share start -> " + talker);

                    final String nm2 = nameOf(talker);
                    new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                        @Override public void run() {
                            boolean ok = clickTextInTop(nm2);
                            log("FWD|voice pick " + nm2 + " " + ok);
                            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                @Override public void run() {
                                    boolean s2 = clickTextInTop("发送");
                                    log("FWD|voice confirm " + s2);
                                }
                            }, 1500L);
                        }
                    }, 1500L);
                } catch (Throwable t) {
                    log("FWD|voice send err " + t);
                    try { sendTextTo(host, talker, label); } catch (Throwable ignore) { }
                }
            }
        });
    }

    /** 在顶层弹窗/页面里按文字点一下（用于自动选择会话与确认发送） */
    private static boolean clickTextInTop(String want) {
        try {
            android.app.Activity a = topAct != null ? topAct : lastAct;
            if (a == null || want == null || want.length() == 0) return false;
            android.view.View root = a.getWindow().getDecorView();
            java.util.ArrayDeque<android.view.View> q = new java.util.ArrayDeque<android.view.View>();
            q.add(root);
            int scan = 0;
            while (!q.isEmpty() && scan < 4000) {
                android.view.View v = q.poll(); scan++;
                if (v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) {
                        android.view.View c = g.getChildAt(i);
                        if (c != null) q.add(c);
                    }
                }
                if (v instanceof android.widget.TextView) {
                    CharSequence cs = ((android.widget.TextView) v).getText();
                    if (cs != null && cs.toString().trim().equals(want) && v.isShown()) {
                        android.view.View clickable = v;
                        for (int i = 0; i < 6 && clickable != null; i++) {
                            if (clickable.isClickable()) break;
                            android.view.ViewParent pp = clickable.getParent();
                            clickable = (pp instanceof android.view.View) ? (android.view.View) pp : null;
                        }
                        if (clickable != null && clickable.isClickable()) {
                            clickable.performClick();
                        } else {
                            v.performClick();
                        }
                        return true;
                    }
                }
            }
        } catch (Throwable ignore) { }
        return false;
    }

    private static void startFwWorker() {
        if (fwWorkerOn) return;
        fwWorkerOn = true;
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    while (true) {
                        String[] job = null;
                        synchronized (fwQueue) {
                            if (!fwQueue.isEmpty()) job = fwQueue.poll();
                        }
                        if (job == null) break;
                        // 微信在后台时没有任何 Activity，直接发必然失败：压回延后队列，等回到微信再补发
                        android.app.Activity actNow = topAct != null ? topAct : (lastAct != null ? lastAct : mainAct);
                        if (actNow == null) {
                            int rt = 0;
                            try { rt = job.length > 7 ? Integer.parseInt(job[7]) : 0; } catch (Throwable ignore) { }
                            if (rt < 30) {
                                String[] j2 = new String[8];
                                for (int i = 0; i < 7; i++) j2[i] = job.length > i ? job[i] : "";
                                j2[7] = String.valueOf(rt + 1);
                                synchronized (fwDefer) { fwDefer.add(j2); }
                                log("FWD|defer no-activity retry=" + rt);
                            } else {
                                log("FWD|drop no-activity retry=" + rt);
                            }
                            continue;
                        }
                        final String tg = job[0], tx = job[1];
                        String kind = job.length > 2 ? job[2] : "text";
                        android.net.Uri imgUri = null;
                        if ("snsimg".equals(kind)) {
                            try {
                                String u = job.length > 6 ? job[6] : "";
                                imgUri = downloadUrlToMedia(u);
                                log("FWD|sns img url=" + u + " uri=" + imgUri);
                            } catch (Throwable t) { log("FWD|sns img err " + t); }
                        } else if ("img".equals(kind)) {
                            try {
                                String path0 = job.length > 5 ? job[5] : "";
                                long svr0 = 0L;
                                try { svr0 = job.length > 6 ? Long.parseLong(job[6]) : 0L; }
                                catch (Throwable ignore) { }
                                // ① 入库时带来的 imgPath 直接就是原图（最准）
                                android.net.Uri u1 = copyFileToMedia(path0);
                                if (u1 != null) { imgUri = u1; log("FWD|img from row " + path0); }
                                // ② 只有 msgSvrId：回库补查一次 imgPath
                                if (imgUri == null && svr0 > 0L) {
                                    String p2 = imgPathOfSvrId(svr0);
                                    android.net.Uri u2 = copyFileToMedia(p2);
                                    if (u2 != null) { imgUri = u2; log("FWD|img from svr " + p2); }
                                }
                                // ③ 兜底：该会话最近 20 秒内的那张图
                                if (imgUri == null) {
                                    android.graphics.Bitmap bm = loadRecentImage(job.length > 3 ? job[3] : "", 20000L);
                                    if (bm != null) imgUri = saveBitmapToMedia(bm);
                                    log("FWD|img fallback uri=" + imgUri);
                                }
                                log("FWD|img uri=" + imgUri);
                            } catch (Throwable t) { log("FWD|img err " + t); }
                        }
                        String voicePath = null;
                        if ("voice".equals(kind)) {
                            try {
                                String p0 = job.length > 5 ? job[5] : "";
                                long svr1 = 0L;
                                try { svr1 = job.length > 6 ? Long.parseLong(job[6]) : 0L; }
                                catch (Throwable ignore) { }
                                if (p0.length() == 0 || !new java.io.File(p0).isFile()) p0 = voicePathOfSvrId(svr1);
                                if (p0 != null && new java.io.File(p0).isFile()) voicePath = p0;
                                log("FWD|voice path=" + voicePath);
                            } catch (Throwable t) { log("FWD|voice err " + t); }
                        }
                        final String fvp = voicePath;
                        final android.net.Uri fu = imgUri;
                        new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                            @Override public void run() {
                                try {
                                    if (fvp != null) {
                                        sendAudioFileTo(mainAct, tg, fvp, tx);
                                        log("FWD|send voice " + tg);
                                    } else if (fu != null) {
                                        sendImageTo(mainAct, tg, fu);
                                        log("FWD|send img " + tg);
                                        // 图片带着来源文字一起发，接收方才知道是谁发的
                                        if ("snsimg".equals(kind)
                                                || cfg().optBoolean("fwShowFrom", true)
                                                || cfg().optString("fwPrefix", "").length() > 0
                                                || cfg().optString("fwTemplate", "").length() > 0) {
                                            // 图发出的动作要等微信把图真的贴上并发送完，再延后补文字（别在主线程里睡）
                                            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
                                                    new Runnable() {
                                                        @Override public void run() {
                                                            try {
                                                                sendTextTo(mainAct, tg, tx);
                                                                log("FWD|send img-caption " + tg);
                                                            } catch (Throwable t) {
                                                                log("FWD|send caption err " + t);
                                                            }
                                                        }
                                                    }, 2600L);
                                        }
                                    } else {
                                        sendTextTo(mainAct, tg, tx);
                                        log("FWD|send " + tg);
                                    }
                                } catch (Throwable t) { log("FWD|send err " + t); }
                            }
                        });
                        try { Thread.sleep(4000); } catch (Throwable ignore) { }
                    }
                } catch (Throwable t) {
                    log("FWD|worker err " + t);
                } finally { fwWorkerOn = false; }
            }
        }).start();
    }

    /** 配置界面 */
    private static void showForwardSetting(final android.app.Activity a) {
        final boolean on = cfg().optBoolean("fwOn", false);
        org.json.JSONArray tg = cfg().optJSONArray("fwTargets");
        int tn = tg == null ? 0 : tg.length();
        String[] items = new String[]{
                "开关：" + (on ? "开" : "关"),
                "转发目标（已选 " + tn + " 个）",
                "来源会话（不选=全部）",
                "关键词过滤：" + (cfg().optString("fwKeyword", "").length() == 0 ? "无" : cfg().optString("fwKeyword")),
                "带上来源昵称：" + (cfg().optBoolean("fwShowFrom", true) ? "是" : "否"),
                "前缀模板：" + (cfg().optString("fwTemplate", "").length() == 0 ? "默认" : cfg().optString("fwTemplate")),
                "转发图片原图：" + (cfg().optBoolean("fwImage", false) ? "是" : "否（只发[图片]文字）"),
                "转发语音：" + (cfg().optBoolean("fwVoice", true) ? "开（发语音文件）" : "关（只发[语音]文字）"),
                "清空转发目标"
        };
        new android.app.AlertDialog.Builder(a)
                .setTitle("消息自动转发")
                .setItems(items, new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) {
                        if (which == 0) {
                            setOn("fwOn", !on);
                            toast(!on ? "自动转发：开" : "自动转发：关");
                            showForwardSetting(a);
                            return;
                        }
                        if (which == 1) { pickForwardTarget(a); return; }
                        if (which == 2) { pickForwardSource(a); return; }
                        if (which == 3) { editForwardKeyword(a); return; }
                        if (which == 4) {
                            setOn("fwShowFrom", !cfg().optBoolean("fwShowFrom", true));
                            showForwardSetting(a);
                            return;
                        }
                        if (which == 5) { editFwTemplate(a); return; }
                        if (which == 6) {
                            setOn("fwImage", !cfg().optBoolean("fwImage", false));
                            showForwardSetting(a);
                            return;
                        }
                        if (which == 7) {
                            setOn("fwVoice", !cfg().optBoolean("fwVoice", true));
                            showForwardSetting(a);
                            return;
                        }
                        if (which == 8) {
                            setJsonCfg("fwTargets", new org.json.JSONArray());
                            toast("已清空转发目标");
                            showForwardSetting(a);
                            return;
                        }
                    }
                })
                .setNegativeButton("关闭", null)
                .show();
    }

    private static void pickForwardTarget(final android.app.Activity a) {
        java.util.ArrayList<String> pre = new java.util.ArrayList<String>();
        org.json.JSONArray arr0 = cfg().optJSONArray("fwTargets");
        if (arr0 != null) for (int i = 0; i < arr0.length(); i++) pre.add(arr0.optString(i));
        showTalkerPickerMulti(a, "选转发目标（可多选）", false, pre, new ChatPickMulti() {
            @Override public void onPick(java.util.ArrayList<String[]> sel) {
                org.json.JSONArray out = new org.json.JSONArray();
                for (String[] e : sel) out.put(e[0]);
                setJsonCfg("fwTargets", out);
                toast("转发目标：" + out.length() + " 个");
            }
        });
    }

    private static void pickForwardSource(final android.app.Activity a) {
        java.util.ArrayList<String> pre = new java.util.ArrayList<String>();
        org.json.JSONArray s0 = cfg().optJSONArray("fwSources");
        if (s0 != null) for (int i = 0; i < s0.length(); i++) pre.add(s0.optString(i));
        showTalkerPickerMulti(a, "来源会话（可多选，不选=全部）", false, pre, new ChatPickMulti() {
            @Override public void onPick(java.util.ArrayList<String[]> sel) {
                org.json.JSONArray out = new org.json.JSONArray();
                for (String[] e : sel) out.put(e[0]);
                setJsonCfg("fwSources", out);
                toast(out.length() == 0 ? "来源：全部会话" : ("来源：" + out.length() + " 个"));
            }
        });
    }


    private static void editFwTemplate(final android.app.Activity a) {
        android.widget.LinearLayout box = new android.widget.LinearLayout(a);
        box.setOrientation(android.widget.LinearLayout.VERTICAL);
        final android.widget.EditText et = new android.widget.EditText(a);
        String cur = cfg().optString("fwTemplate", "");
        et.setText(cur.length() == 0 ? "【{群} · {发送人}】" : cur);
        et.setTextSize(15);
        box.addView(et, new android.widget.LinearLayout.LayoutParams(-1, -2));
        android.widget.TextView tip = new android.widget.TextView(a);
        tip.setText("可用字段（点一下插入）：\n{群} 群名　{发送人} 微信名/群昵称　{备注} 我给Ta的备注\n{微信号} 原始id　{时间} 转发时间");
        tip.setTextSize(12);
        tip.setTextColor(0xFF6B6B76);
        tip.setPadding(dp(a, 6), dp(a, 4), dp(a, 6), dp(a, 6));
        box.addView(tip);
        final String[] fields = new String[]{"{群}", "{发送人}", "{备注}", "{微信号}", "{时间}"};
        android.widget.LinearLayout row = new android.widget.LinearLayout(a);
        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        for (final String f : fields) {
            android.widget.TextView tv = new android.widget.TextView(a);
            tv.setText(f);
            tv.setTextSize(13);
            tv.setTextColor(0xFF1A6BC8);
            tv.setPadding(dp(a, 8), dp(a, 6), dp(a, 8), dp(a, 6));
            tv.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    int st = et.getSelectionStart();
                    if (st < 0) st = et.getText().length();
                    et.getText().insert(st, f);
                }
            });
            row.addView(tv);
        }
        box.addView(row);
        new android.app.AlertDialog.Builder(a)
                .setTitle("转发前缀模板")
                .setView(box)
                .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        setStrCfg("fwTemplate", et.getText().toString().trim());
                        showForwardSetting(a);
                        toast("模板已保存");
                    }
                })
                .setNeutralButton("恢复默认", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        setStrCfg("fwTemplate", "");
                        showForwardSetting(a);
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static void editForwardKeyword(final android.app.Activity a) {
        final android.widget.EditText et = new android.widget.EditText(a);
        et.setText(cfg().optString("fwKeyword", ""));
        et.setHint("留空=不过滤");
        new android.app.AlertDialog.Builder(a)
                .setTitle("只转发含此关键词的消息")
                .setView(et)
                .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        setStrCfg("fwKeyword", et.getText().toString().trim());
                        toast("已保存");
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    /* ================= 抢红包策略（智能设置） ================= */

    private static final java.util.HashMap<String, Long> grabChatAt = new java.util.HashMap<String, Long>();
    private static long grabWinAt = 0;
    private static int grabWinN = 0;

    /** 名单匹配（空名单=不限） */
    private static boolean inList(org.json.JSONArray arr, String tk) {
        if (arr == null || arr.length() == 0) return false;
        for (int i = 0; i < arr.length(); i++) if (tk.equals(arr.optString(i))) return true;
        return false;
    }

    /** 这个红包该不该抢；返回 null=可以抢，否则返回跳过原因 */
    private static String grabSkipReason(String talker, String content) {
        try {
            if (talker == null) return "no-talker";
            org.json.JSONArray only = cfg().optJSONArray("grabOnly");
            if (only != null && only.length() > 0 && !inList(only, talker)) return "not-in-whitelist";
            if (inList(cfg().optJSONArray("grabSkip"), talker)) return "blacklist";
            if (cfg().optBoolean("grabSkipMine", true) && content != null
                    && (content.contains("专属") || content.contains("指定人"))) return "exclusive";
            String hours = cfg().optString("grabHours", "all");
            if ("day".equals(hours)) {
                java.util.Calendar c = java.util.Calendar.getInstance();
                int hh = c.get(java.util.Calendar.HOUR_OF_DAY);
                if (hh < 8 || hh >= 23) return "night";
            }
            long now = System.currentTimeMillis();
            int cd = cfg().optInt("grabCooldown", 10);
            Long last = grabChatAt.get(talker);
            if (cd > 0 && last != null && now - last.longValue() < cd * 1000L) return "cooldown";
            if (now - grabWinAt > 60000L) { grabWinAt = now; grabWinN = 0; }
            int perMin = cfg().optInt("grabPerMin", 10);
            if (perMin > 0 && grabWinN >= perMin) return "rate-limit";
            return null;
        } catch (Throwable t) { return null; }
    }

    /** 记录一次领取 */
    private static void grabMark(String talker) {
        try {
            grabChatAt.put(talker, Long.valueOf(System.currentTimeMillis()));
            grabWinN++;
            if (grabChatAt.size() > 300) grabChatAt.clear();
        } catch (Throwable ignore) { }
    }

    /** 随机延迟（毫秒），按配置档位 */
    private static long grabDelayMs() {
        try {
            String lvl = cfg().optString("grabDelay", "fast");
            int lo = 0, hi = 800;
            if ("mid".equals(lvl)) { lo = 1000; hi = 4000; }
            else if ("slow".equals(lvl)) { lo = 3000; hi = 8000; }
            return lo + (long) (Math.random() * (hi - lo));
        } catch (Throwable t) { return 600L; }
    }

