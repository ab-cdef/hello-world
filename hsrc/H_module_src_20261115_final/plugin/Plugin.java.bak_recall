            cImg.setText("图片");
            cImg.setChecked(true);
            box.addView(cImg);
            final android.widget.CheckBox cVoice = new android.widget.CheckBox(a);
            cVoice.setText("语音");
            box.addView(cVoice);
            final android.widget.CheckBox cVideo = new android.widget.CheckBox(a);
            cVideo.setText("视频（按 MicroMsg 缓存命名精确匹配，匹配不到跳过）");
            cVideo.setChecked(true);
