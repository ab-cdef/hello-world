                                                lv0.requestLayout();
                                            }
                                        } catch (Throwable ignore) { }
                                    }
                                });
                            }
                        }
                    } catch (Throwable t) { }
                }
            });
            XposedBridge.hookAllMethods(ad, "getView", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("groupFold", false)) return;
                        lastConvAdapter = p.thisObject;
                        int i = (Integer) p.args[0];
                        if (i == 0) {
                            Object par = p.args[2];
                            if (par instanceof android.view.ViewGroup) {
                                p.setResult(buildGroupRow(((android.view.ViewGroup) par).getContext()));
                            }
                            return;
                        }
                        java.util.List<Integer> mp = convMap;
                        if (mp == null || mp.isEmpty()) return;
                        int gi = i - 1;
                        if (gi < 0 || gi >= mp.size()) {
                            Object par2 = p.args[2];
                            if (par2 instanceof android.view.ViewGroup) {
                                android.view.View blank = new android.view.View(
                                        ((android.view.ViewGroup) par2).getContext());
                                blank.setTag("wxhGroupRow");
                                blank.setLayoutParams(new android.view.ViewGroup.LayoutParams(
                                        android.view.ViewGroup.LayoutParams.MATCH_PARENT, 0));
                                p.setResult(blank);
                            } else {
                                p.setResult(null);
                            }
                            return;
                        }
                        Object cv0 = p.args[1];
                        if (cv0 instanceof android.view.View) {
                            Object tg = ((android.view.View) cv0).getTag();
                            // 我们的行没有 ViewHolder，绝不能回给微信复用（tag 为空也会触发强转崩溃）
                            if (tg == null || "wxhGroupRow".equals(tg)) {
                                p.args[1] = null;
                            }
                        }
                        p.args[0] = mp.get(gi);
                    } catch (Throwable t) { }
                }
            });
            log("hooked cp5.a1 insert@2");
        } catch (Throwable t) { log("convInsert err " + t); }
    }


    // ==================== 密友（秘密好友：只在你自己看得到） ====================
    private static java.util.HashSet<String> miyouCache = null;
    private static long miyouCacheAt = 0;
    /** 临时显示截止时间（到点自动恢复隐藏） */
    private static long miyouTempUntil = 0;
    /** 单个密友的临时显示（2 分钟），不影响其他人 */
    private static long miyouTempOneUntil = 0;
    private static String miyouTempOne = null;
    private static final int MIYOU_TAG = 0x7f0a0b0c;      // 行被我们隐藏的标记
    private static final int MIYOU_H0 = 0x7f0a0b0e;       // 行原始高度

    private static java.util.HashSet<String> miyouSet() {
        long now = System.currentTimeMillis();
        java.util.HashSet<String> c = miyouCache;
        if (c != null && now - miyouCacheAt < 15000) return c;
        c = new java.util.HashSet<String>();
        try {
            org.json.JSONArray ar = cfg().optJSONArray("miyouList");
            if (ar != null) {
                for (int i = 0; i < ar.length(); i++) {
                    String v = ar.optString(i, "").trim();
                    if (v.length() > 0) c.add(v);
                }
            }
        } catch (Throwable ignore) { }
        miyouCache = c;
        miyouCacheAt = now;
        return c;
    }

    private static boolean miyouOnNow() {
        try { return cfg().optBoolean("miyouOn", false); } catch (Throwable ignore) { return false; }
    }

    /** 这条会话该不该藏起来 */
    private static boolean miyouHidden(String talker) {
        if (talker == null || talker.length() == 0) return false;
        if (!miyouOnNow()) return false;
        if (System.currentTimeMillis() < miyouTempUntil) return false;
        if (miyouTempOne != null && miyouTempOne.equals(talker)
                && System.currentTimeMillis() < miyouTempOneUntil) return false;
        return miyouSet().contains(talker);
    }

    private static void miyouStore(java.util.Collection<String> ids) {
        try {
            org.json.JSONObject o = readCfg();
            org.json.JSONArray ar = new org.json.JSONArray();
            for (String s : ids) {
                if (s != null && s.trim().length() > 0) ar.put(s.trim());
            }
            o.put("miyouList", ar);
            o.put("miyouOn", ar.length() > 0);
            writeCfg(o);
            cfg = null;
            cfgAt = 0;
            miyouCache = null;
            miyouCacheAt = 0;
        } catch (Throwable t) { log("MIYOU|store " + t); }
    }

    /** 临时显示到期后自动恢复隐藏（到点重建列表，不然那几条会一直露着） */
    private static void miyouScheduleHide() {
        try {
            final long until = miyouTempUntil;
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        if (miyouTempUntil == until && System.currentTimeMillis() >= until) {
                            log("MIYOU|temp expired, refresh");
                            refreshConvList();
                        }
                    } catch (Throwable ignore) { }
                }
            }, Math.max(1000L, until - System.currentTimeMillis() + 3000L));
        } catch (Throwable ignore) { }
    }

    /** 会话适配器第 pos 条的 talker（cp5.a1.getItem().h1()） */
    private static String miyouTalker(Object ad, int pos) {
        if (ad == null || pos < 0) return null;
        try {
            Object conv = null;
            for (Method m : ad.getClass().getMethods()) {
                if (m.getName().equals("getItem") && m.getParameterTypes().length == 1
                        && m.getParameterTypes()[0] == int.class) {
                    m.setAccessible(true);
                    conv = m.invoke(ad, pos);
                    break;
                }
            }
            if (conv == null) return null;
            return (String) conv.getClass().getMethod("h1").invoke(conv);
        } catch (Throwable t) { return null; }
    }

    /** 可见序号 → 真实序号 的映射（密友被真正剔除，不留空行） */
    private static int[] miyouMap = null;
    private static Object miyouMapAd = null;
    private static int miyouMapTotal = -1;
    private static long miyouMapAt = 0;

    private static void rebuildMiyouMap(Object ad, int total) {
        try {
            java.util.HashSet<String> set = miyouSet();
            java.util.ArrayList<Integer> keep = new java.util.ArrayList<Integer>(total > 0 ? total : 16);
            for (int i = 0; i < total; i++) {
                String u = miyouTalker(ad, i);
                if (u != null && set.contains(u)) continue;
                keep.add(Integer.valueOf(i));
            }
            int[] arr = new int[keep.size()];
            for (int i = 0; i < arr.length; i++) arr[i] = keep.get(i).intValue();
            miyouMap = arr;
            miyouMapAd = ad;
            miyouMapTotal = total;
            miyouMapAt = System.currentTimeMillis();
        } catch (Throwable t) {
            miyouMap = null;
            log("MIYOU|map " + t);
        }
    }

    /** 首页会话列表：把密友从 getCount 里扣掉，getView 按映射取真实会话 */
    private static void installMiyou(ClassLoader app) {
        try {
            final Class<?> ad = Class.forName("cp5.a1", false, app);
            XposedBridge.hookAllMethods(ad, "getCount", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        Object self = p.thisObject;
                        Object r = p.getResult();
                        if (!(r instanceof Integer)) return;
                        int total = ((Integer) r).intValue();
                        // 群聊折叠开启时由 convMap 统一剔除，这里不能重复扣，否则索引会错位
                        if (cfg().optBoolean("groupFold", false)) {
                            miyouMap = null;
                            miyouMapAd = null;
                            return;
                        }
                        if (!miyouOnNow() || System.currentTimeMillis() < miyouTempUntil
                                || miyouSet().isEmpty()) {
                            miyouMap = null;
                            miyouMapAd = null;
                            return;
                        }
                        if (miyouMap == null || miyouMapAd != self || miyouMapTotal != total
                                || System.currentTimeMillis() - miyouMapAt > 3000) {
                            rebuildMiyouMap(self, total);
                        }
                        if (miyouMap != null && miyouMap.length != total) {
                            p.setResult(Integer.valueOf(miyouMap.length));
                        }
                    } catch (Throwable ignore) { }
                }
            });
            XposedBridge.hookAllMethods(ad, "getView", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        int[] mp = miyouMap;
                        if (mp == null || miyouMapAd != p.thisObject) return;
                        int i = ((Integer) p.args[0]).intValue();
                        if (i >= 0 && i < mp.length) {
                            p.args[0] = Integer.valueOf(mp[i]);
                        }
                        p.args[1] = null;   // 位置变了，回收的行不能再按旧位置复用
                    } catch (Throwable ignore) { }
                }
            });
            log("MIYOU|hook cp5.a1 count/getView ok");
        } catch (Throwable t) { log("MIYOU|install " + t); }
        try { installMiyouNotify(app); } catch (Throwable ignore) { }
        // 密友资料页拦截：点开资料页直接退出
        try {
            Class<?> ci = Class.forName("com.tencent.mm.plugin.profile.ui.ContactInfoUI", false, app);
            XposedBridge.hookAllMethods(ci, "onCreate", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("miyouBlockProfile", true)) return;
                        if (!(p.thisObject instanceof android.app.Activity)) return;
                        android.app.Activity a = (android.app.Activity) p.thisObject;
                        String u = a.getIntent() == null ? "" : a.getIntent().getStringExtra("Contact_User");
                        if (u != null && miyouHidden(u)) {
                            log("MIYOU|block profile " + u);
                            p.setResult(null);
                            a.finish();
                        }
                    } catch (Throwable ignore) { }
                }
            });
            log("MIYOU|profile hook ok");
        } catch (Throwable t) { log("MIYOU|profile " + t); }
        // 密友会话拦截：ChattingUI 一创建就退出（onResume 时 chatTalker 可能还没取到）
        try {
            Class<?> cui = Class.forName("com.tencent.mm.ui.chatting.ChattingUI", false, app);
            XposedBridge.hookAllMethods(cui, "onCreate", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("miyouBlockChat", true)) return;
                        if (!(p.thisObject instanceof android.app.Activity)) return;
                        final android.app.Activity a = (android.app.Activity) p.thisObject;
                        android.content.Intent it = a.getIntent();
                        String u = it == null ? "" : it.getStringExtra("Chat_User");
                        log("MIYOU|chat intent " + u + " hidden=" + miyouHidden(String.valueOf(u)));
                        if (u != null && miyouHidden(u)) {
                            log("MIYOU|block chat " + u);
                            a.runOnUiThread(new Runnable() {
                                @Override public void run() {
                                    try { toast("这条会话已隐藏"); } catch (Throwable ignore) { }
                                    a.finish();
                                }
                            });
                        }
                    } catch (Throwable ignore) { }
                }
            });
            log("MIYOU|chat hook ok");
        } catch (Throwable t) { log("MIYOU|chat " + t); }
    }

    /** 密友面板：开关 + 名单 + 临时显示 + 进聊天 */
    private static android.app.Dialog miyouDialog = null;

    private static boolean miyouGateOn() {
        try { return cfg().optBoolean("miyouGate", false); } catch (Throwable ignore) { return false; }
    }

    private static String miyouPass() {
        try { return cfg().optString("miyouPass", ""); } catch (Throwable ignore) { return ""; }
    }

    private static String miyouAlias(String u) {
        try {
            org.json.JSONObject o = cfg().optJSONObject("miyouAlias");
            if (o == null) return "";
            return o.optString(u, "");
        } catch (Throwable ignore) { return ""; }
    }

    private static void miyouAliasSet(String u, String v) {
        try {
            org.json.JSONObject o = readCfg();
            org.json.JSONObject al = o.optJSONObject("miyouAlias");
            if (al == null) al = new org.json.JSONObject();
            if (v == null || v.trim().length() == 0) al.remove(u);
            else al.put(u, v.trim());
            o.put("miyouAlias", al);
            writeCfg(o);
            cfg = null;
            cfgAt = 0;
        } catch (Throwable t) { log("MIYOU|alias " + t); }
    }

    private static boolean miyouMuteOn() {
        try { return cfg().optBoolean("miyouMute", true); } catch (Throwable ignore) { return true; }
    }

    /** 密码门禁：开了就在进面板前先验一次，避免别人随手点开看到名单 */
    private static void showMiyou(final android.app.Activity a) {
        final String pop = miyouPass();
        if (!miyouGateOn() || pop == null || pop.length() < 4) { showMiyouPanel(a); return; }
        final android.widget.EditText et = new android.widget.EditText(a);
        et.setInputType(android.text.InputType.TYPE_CLASS_NUMBER
                | android.text.InputType.TYPE_NUMBER_VARIATION_PASSWORD);
        et.setHint("密码");
        et.setPadding(dp(a, 14), dp(a, 12), dp(a, 14), dp(a, 12));
        new android.app.AlertDialog.Builder(a)
                .setTitle("进入密友")
                .setView(et)
                .setPositiveButton("进入", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        if (pop.equals(et.getText().toString().trim())) showMiyouPanel(a);
                        else toast("密码不对");
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static void showMiyouPanel(final android.app.Activity a) {
        try {
            if (miyouDialog != null) { miyouDialog.dismiss(); miyouDialog = null; }

            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 18), dp(a, 4), dp(a, 18), dp(a, 8));

            android.widget.TextView note = new android.widget.TextView(a);
            note.setText("密友是「要藏起来的好友」：首页会话里不显示、未读也不进群聊角标，只能从这面板进。长按某个密友可以改别名、临时露 2 分钟、移出。");
            note.setTextSize(12);
            note.setTextColor(0xFF8A8A94);
            note.setLineSpacing(0, 1.25f);
            box.addView(note, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT));

            final android.widget.TextView onSw = new android.widget.TextView(a);
            final Runnable paintOn = new Runnable() {
                @Override public void run() {
                    boolean on = miyouOnNow();
                    onSw.setText(on ? "已隐藏" : "未隐藏");
                    android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
                    if (on) gd.setColors(new int[]{0xFF07C160, 0xFF06AD56});
                    else gd.setColor(0xFFF0F0F4);
                    gd.setCornerRadius(dp(a, 15));
                    if (!on) { try { gd.setStroke(dp(a, 1), 0xFFE2E2E8); } catch (Throwable ignore) { } }
                    onSw.setBackground(gd);
                    onSw.setTextColor(on ? 0xFFFFFFFF : 0xFF6B6B76);
                }
            };

            android.widget.LinearLayout onRow = new android.widget.LinearLayout(a);
            onRow.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            onRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
            onRow.setPadding(0, dp(a, 12), 0, dp(a, 12));
            android.widget.TextView onTxt = new android.widget.TextView(a);
            onTxt.setText("隐藏密友会话");
            onTxt.setTextSize(16);
            onTxt.setTextColor(0xFF141418);
            onRow.addView(onTxt, new android.widget.LinearLayout.LayoutParams(0,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
            onSw.setTextSize(12);
            onSw.setGravity(android.view.Gravity.CENTER);
            onSw.setIncludeFontPadding(false);
            onSw.setPadding(dp(a, 14), 0, dp(a, 14), 0);
            onRow.addView(onSw, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, dp(a, 30)));
            paintOn.run();
            onRow.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    setOn("miyouOn", !miyouOnNow());
                    paintOn.run();
                    refreshConvList();
                    toast(miyouOnNow() ? "密友会话已隐藏" : "密友会话已恢复显示");
                }
            });
            box.addView(onRow, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT));

            final android.widget.TextView tempRow = new android.widget.TextView(a);
            tempRow.setTextSize(14);
            tempRow.setTextColor(0xFF3E7BFA);
            tempRow.setPadding(0, dp(a, 10), 0, dp(a, 10));
            final Runnable paintTemp = new Runnable() {
                @Override public void run() {
                    long left = miyouTempUntil - System.currentTimeMillis();
                    if (left > 0) tempRow.setText("临时显示中 · 还剩 " + ((left + 59000) / 60000) + " 分钟（点这里立刻恢复隐藏）");
                    else tempRow.setText("临时显示全部密友 5 分钟（自己核对完自动恢复隐藏）");
                }
            };
            paintTemp.run();
            tempRow.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    if (System.currentTimeMillis() < miyouTempUntil) {
                        miyouTempUntil = 0;
                        toast("密友会话已恢复隐藏");
                    } else {
                        miyouTempUntil = System.currentTimeMillis() + 5 * 60 * 1000L;
                        miyouScheduleHide();
                        toast("密友会话已临时显示 5 分钟");
                    }
                    paintTemp.run();
                    refreshConvList();
                }
            });
            box.addView(tempRow);

            // 密友消息不提醒
            final android.widget.TextView muteSw = new android.widget.TextView(a);
            final Runnable paintMute = new Runnable() {
                @Override public void run() {
                    boolean on = miyouMuteOn();
                    muteSw.setText(on ? "不提醒" : "会提醒");
                    android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
                    if (on) gd.setColors(new int[]{0xFF07C160, 0xFF06AD56});
                    else gd.setColor(0xFFF0F0F4);
                    gd.setCornerRadius(dp(a, 15));
                    if (!on) { try { gd.setStroke(dp(a, 1), 0xFFE2E2E8); } catch (Throwable ignore) { } }
                    muteSw.setBackground(gd);
                    muteSw.setTextColor(on ? 0xFFFFFFFF : 0xFF6B6B76);
                }
            };
            android.widget.LinearLayout muteRow = new android.widget.LinearLayout(a);
            muteRow.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            muteRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
            muteRow.setPadding(0, dp(a, 4), 0, dp(a, 10));
            android.widget.TextView muteTxt = new android.widget.TextView(a);
            muteTxt.setText("密友来消息不弹通知");
            muteTxt.setTextSize(15);
            muteTxt.setTextColor(0xFF141418);
            muteRow.addView(muteTxt, new android.widget.LinearLayout.LayoutParams(0,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
            muteSw.setTextSize(12);
            muteSw.setGravity(android.view.Gravity.CENTER);
            muteSw.setIncludeFontPadding(false);
            muteSw.setPadding(dp(a, 14), 0, dp(a, 14), 0);
            muteRow.addView(muteSw, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, dp(a, 30)));
            paintMute.run();
            muteRow.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    setOn("miyouMute", !miyouMuteOn());
                    paintMute.run();
                }
            });
            box.addView(muteRow, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT));

            // 快捷操作：全部隐藏 / 全部显示 / 密码
            android.widget.LinearLayout qk = new android.widget.LinearLayout(a);
            qk.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            qk.setPadding(0, 0, 0, dp(a, 6));
            android.widget.TextView q1 = hubChip(a, "全部隐藏", false);
            q1.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    setOn("miyouOn", true);
                    miyouTempUntil = 0;
                    paintOn.run();
                    paintTemp.run();
                    refreshConvList();
                    toast("密友会话已全部隐藏");
                }
            });
            qk.addView(q1);
            android.widget.TextView q2 = hubChip(a, "全部显示", false);
            q2.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    setOn("miyouOn", false);
                    paintOn.run();
                    refreshConvList();
                    toast("密友会话已全部显示");
                }
            });
            qk.addView(q2);
            android.widget.TextView q3 = hubChip(a, miyouGateOn() ? "密码已开" : "设密码", false);
            q3.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) { miyouPassDialog(a, paintOn); }
            });
            qk.addView(q3);
            box.addView(qk, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT));

            final java.util.HashSet<String> ids = new java.util.HashSet<String>(miyouSet());
            if (ids.isEmpty()) {
                android.widget.TextView empty = new android.widget.TextView(a);
                empty.setText("还没有密友。点下面「添加密友」从会话里挑。");
                empty.setTextSize(13);
                empty.setTextColor(0xFF9A9AA4);
                empty.setGravity(android.view.Gravity.CENTER);
                empty.setPadding(0, dp(a, 22), 0, dp(a, 22));
                box.addView(empty);
            } else {
                if (ids.size() >= 6) {
                    final android.widget.EditText se = new android.widget.EditText(a);
                    se.setHint("搜索名字或微信号");
                    se.setTextSize(13);
                    se.setSingleLine(true);
                    se.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));
                    android.graphics.drawable.GradientDrawable sb = new android.graphics.drawable.GradientDrawable();
                    sb.setColor(0xFFF4F4F8);
                    sb.setCornerRadius(dp(a, 10));
                    se.setBackground(sb);
                    box.addView(se, new android.widget.LinearLayout.LayoutParams(
                            android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                            android.view.ViewGroup.LayoutParams.WRAP_CONTENT));
                    final android.widget.LinearLayout holder = new android.widget.LinearLayout(a);
                    holder.setOrientation(android.widget.LinearLayout.VERTICAL);
                    final Runnable[] refill = new Runnable[1];
                    refill[0] = new Runnable() {
                        @Override public void run() {
                            final String kw = se.getText().toString().trim().toLowerCase();
                            holder.removeAllViews();
                            for (final String u : ids) {
                                String nm = resolveName(u);
                                String al = miyouAlias(u);
                                String show = al.length() > 0 ? al : (nm.length() > 0 ? nm : u);
                                if (kw.length() > 0
                                        && !show.toLowerCase().contains(kw)
                                        && !u.toLowerCase().contains(kw)) continue;
                                holder.addView(miyouRow(a, u, show, nm, paintOn, paintTemp, refill[0]));
                            }
                        }
                    };
                    refill[0].run();
                    se.addTextChangedListener(new android.text.TextWatcher() {
                        @Override public void beforeTextChanged(CharSequence s, int st, int c, int af) { }
                        @Override public void onTextChanged(CharSequence s, int st, int b, int c) { }
                        @Override public void afterTextChanged(android.text.Editable s) { refill[0].run(); }
                    });
                    android.widget.ScrollView sv = new android.widget.ScrollView(a);
                    sv.addView(holder);
                    box.addView(sv, new android.widget.LinearLayout.LayoutParams(
                            android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(a, 330)));
                } else {
                    android.widget.ScrollView sv = new android.widget.ScrollView(a);
                    android.widget.LinearLayout list = new android.widget.LinearLayout(a);
                    list.setOrientation(android.widget.LinearLayout.VERTICAL);
                    for (final String u : ids) {
                        String nm = resolveName(u);
                        String al = miyouAlias(u);
                        String show = al.length() > 0 ? al : (nm.length() > 0 ? nm : u);
                        list.addView(miyouRow(a, u, show, nm, paintOn, paintTemp, null));
                    }
                    sv.addView(list);
                    box.addView(sv, new android.widget.LinearLayout.LayoutParams(
                            android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                            dp(a, Math.min(330, 30 + ids.size() * 50))));
                }
            }

            android.widget.LinearLayout wrap2 = new android.widget.LinearLayout(a);
            wrap2.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.graphics.drawable.GradientDrawable wb = new android.graphics.drawable.GradientDrawable();
            wb.setColor(0xFFFDFDFF);
            wb.setCornerRadius(dp(a, 18));
            wrap2.setBackground(wb);
            wrap2.setClipToOutline(true);

            android.widget.TextView ttl = new android.widget.TextView(a);
            ttl.setText("密友 " + ids.size() + " 个" + (miyouGateOn() ? " · 已加密码" : ""));
            ttl.setTextSize(19);
            ttl.setTextColor(0xFF141418);
            ttl.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
            ttl.setPadding(dp(a, 18), dp(a, 16), dp(a, 18), dp(a, 8));
            wrap2.addView(ttl, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT));
            wrap2.addView(box, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT));

            android.widget.LinearLayout bar = new android.widget.LinearLayout(a);
            bar.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            bar.setBackgroundColor(0xFFFAFAFC);
            bar.setPadding(dp(a, 18), dp(a, 8), dp(a, 18), dp(a, 8));
            bar.setGravity(android.view.Gravity.END | android.view.Gravity.CENTER_VERTICAL);
            android.widget.TextView bAdd = hubChip(a, "添加密友", true);
            bAdd.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) { pickMiyou(a); }
            });
            bar.addView(bAdd);
            android.widget.TextView bExp = hubChip(a, "导出", false);
            bExp.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) { miyouExport(a); }
            });
            bar.addView(bExp);
            android.widget.TextView bImp = hubChip(a, "导入", false);
            bImp.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) { miyouImport(a); }
            });
            bar.addView(bImp);
            android.widget.TextView bClose = hubChip(a, "关闭", false);
            bClose.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    try { if (miyouDialog != null) { miyouDialog.dismiss(); } } catch (Throwable ignore) { }
                    miyouDialog = null;
                }
            });
            bar.addView(bClose);
            wrap2.addView(bar, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT));

            android.app.Dialog dlg = new android.app.Dialog(a, android.R.style.Theme_Material_Light_NoActionBar);
            dlg.setContentView(wrap2);
            miyouDialog = dlg;
            dlg.show();
            try {
                android.view.Window w = dlg.getWindow();
                if (w != null) {
                    w.setBackgroundDrawable(glassDrawable(a, 20));
                    int sw2 = a.getResources().getDisplayMetrics().widthPixels;
                    w.setLayout(sw2 - dp(a, 30), android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                }
            } catch (Throwable ignore) { }
        } catch (Throwable t) { log("MIYOU|panel " + t); toast("密友面板打开失败"); }
    }

    /** 名单里的一行：头像 + 名字 + 进入 + 2 分钟临时显示；长按弹出更多操作 */
    private static android.view.View miyouRow(final android.app.Activity a, final String u,
                                              String show, String nm,
                                              final Runnable paintOn, final Runnable paintTemp,
                                              final Runnable refill) {
        android.widget.LinearLayout row = new android.widget.LinearLayout(a);
        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        row.setGravity(android.view.Gravity.CENTER_VERTICAL);
        row.setPadding(0, dp(a, 9), 0, dp(a, 9));

        android.widget.TextView av = new android.widget.TextView(a);
        av.setText(show.length() > 0 ? show.substring(0, 1) : "?");
        av.setTextSize(14);
        av.setTextColor(0xFFFFFFFF);
        av.setGravity(android.view.Gravity.CENTER);
        android.graphics.drawable.GradientDrawable ag = new android.graphics.drawable.GradientDrawable();
        ag.setColor(0xFF07C160);
        ag.setShape(android.graphics.drawable.GradientDrawable.OVAL);
        av.setBackground(ag);
        row.addView(av, new android.widget.LinearLayout.LayoutParams(dp(a, 34), dp(a, 34)));

        android.widget.LinearLayout col = new android.widget.LinearLayout(a);
        col.setOrientation(android.widget.LinearLayout.VERTICAL);
        col.setPadding(dp(a, 10), 0, 0, 0);
        android.widget.TextView t1 = new android.widget.TextView(a);
        t1.setText(show);
        t1.setTextSize(15);
        t1.setTextColor(0xFF141418);
        t1.setSingleLine(true);
        col.addView(t1);
        android.widget.TextView t2 = new android.widget.TextView(a);
        t2.setText(nm.length() > 0 ? (nm + "  " + u) : u);
        t2.setTextSize(11);
        t2.setTextColor(0xFF9A9AA4);
        t2.setSingleLine(true);
        col.addView(t2);
        row.addView(col, new android.widget.LinearLayout.LayoutParams(0,
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));

        boolean showing = (miyouTempOne != null && miyouTempOne.equals(u)
                && System.currentTimeMillis() < miyouTempOneUntil);
        android.widget.TextView tmpc = hubChip(a, showing ? "已露出" : "2分", false);
        tmpc.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                if (miyouTempOne != null && miyouTempOne.equals(u)
                        && System.currentTimeMillis() < miyouTempOneUntil) {
                    miyouTempOne = null;
                    miyouTempOneUntil = 0;
                    toast("已恢复隐藏");
                } else {
                    miyouTempOne = u;
                    miyouTempOneUntil = System.currentTimeMillis() + 2 * 60 * 1000L;
                    miyouTempUntil = 0;
                    miyouScheduleHide();
                    toast((resolveName(u).length() > 0 ? resolveName(u) : u) + " 临时露出 2 分钟");
                }
                refreshConvList();
                if (refill != null) refill.run();
                paintTemp.run();
            }
        });
        row.addView(tmpc);

        android.widget.TextView go = new android.widget.TextView(a);
        go.setText("进入");
        go.setTextSize(12);
        go.setTextColor(0xFFE2231A);
        go.setPadding(dp(a, 10), dp(a, 4), dp(a, 4), dp(a, 4));
        row.addView(go);
        row.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                try { if (miyouDialog != null) { miyouDialog.dismiss(); miyouDialog = null; } } catch (Throwable ignore) { }
                zOpenChat(a, u);
            }
        });
        row.setOnLongClickListener(new android.view.View.OnLongClickListener() {
            @Override public boolean onLongClick(android.view.View v) {
                new android.app.AlertDialog.Builder(a)
                        .setTitle(resolveName(u).length() > 0 ? resolveName(u) : u)
                        .setItems(new String[]{"改备注别名", "临时露出 2 分钟", "移出密友"}, new android.content.DialogInterface.OnClickListener() {
                            @Override public void onClick(android.content.DialogInterface d, int w) {
                                if (w == 0) {
                                    final android.widget.EditText et = new android.widget.EditText(a);
                                    et.setHint("只在本面板显示，不影响微信备注");
                                    et.setText(miyouAlias(u));
                                    et.setPadding(dp(a, 14), dp(a, 10), dp(a, 14), dp(a, 10));
                                    new android.app.AlertDialog.Builder(a)
                                            .setTitle("别名")
                                            .setView(et)
                                            .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                                                @Override public void onClick(android.content.DialogInterface d2, int w2) {
                                                    miyouAliasSet(u, et.getText().toString());
                                                    showMiyouPanel(a);
                                                }
                                            })
                                            .setNegativeButton("取消", null)
                                            .show();
                                } else if (w == 1) {
                                    miyouTempOne = u;
                                    miyouTempOneUntil = System.currentTimeMillis() + 2 * 60 * 1000L;
                                    miyouTempUntil = 0;
                                    miyouScheduleHide();
                                    refreshConvList();
                                    toast("临时露出 2 分钟");
                                    showMiyouPanel(a);
                                } else {
                                    java.util.HashSet<String> now2 = new java.util.HashSet<String>(miyouSet());
                                    now2.remove(u);
                                    miyouStore(now2);
                                    toast("已移出密友");
                                    refreshConvList();
                                    showMiyouPanel(a);
                                }
                            }
                        })
                        .setNegativeButton("取消", null)
                        .show();
                return true;
            }
        });
        return row;
    }

    /** 设 / 改 / 关 密友密码 */
    private static void miyouPassDialog(final android.app.Activity a, final Runnable paintOn) {
        final android.widget.LinearLayout box = new android.widget.LinearLayout(a);
        box.setOrientation(android.widget.LinearLayout.VERTICAL);
        box.setPadding(dp(a, 16), dp(a, 8), dp(a, 16), dp(a, 8));
        final android.widget.EditText p1 = new android.widget.EditText(a);
        p1.setHint("4 位以上数字");
        p1.setInputType(android.text.InputType.TYPE_CLASS_NUMBER
                | android.text.InputType.TYPE_NUMBER_VARIATION_PASSWORD);
        box.addView(p1);
        final android.widget.EditText p2 = new android.widget.EditText(a);
        p2.setHint("再输一次");
        p2.setInputType(android.text.InputType.TYPE_CLASS_NUMBER
                | android.text.InputType.TYPE_NUMBER_VARIATION_PASSWORD);
        box.addView(p2);
        android.widget.TextView off = new android.widget.TextView(a);
        off.setText("不设密码（留空两次直接确定）");
        off.setTextSize(12);
        off.setTextColor(0xFF9A9AA4);
        off.setPadding(0, dp(a, 8), 0, 0);
        box.addView(off);
        new android.app.AlertDialog.Builder(a)
                .setTitle("密友密码")
                .setView(box)
                .setPositiveButton("确定", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        String s1 = p1.getText().toString().trim();
                        String s2 = p2.getText().toString().trim();
                        if (s1.length() == 0 && s2.length() == 0) {
                            setOn("miyouGate", false);
                            setStrCfg("miyouPass", "");
                            toast("已关闭密码");
                        } else if (s1.length() < 4) {
                            toast("至少 4 位");
                            return;
                        } else if (!s1.equals(s2)) {
                            toast("两次不一样");
                            return;
                        } else {
                            setStrCfg("miyouPass", s1);
                            setOn("miyouGate", true);
                            toast("密码已设置");
                        }
                        if (paintOn != null) paintOn.run();
                        showMiyouPanel(a);
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    /** 导出名单到 /data/data/com.tencent.mm/files/wxh_miyou.txt（换机/备份用） */
    private static void miyouExport(final android.app.Activity a) {
        try {
            java.util.HashSet<String> ids = new java.util.HashSet<String>(miyouSet());
            if (ids.isEmpty()) { toast("名单是空的"); return; }
            java.io.File f = new java.io.File(DIR, "wxh_miyou.txt");
            java.io.PrintWriter pw = new java.io.PrintWriter(
                    new java.io.OutputStreamWriter(new java.io.FileOutputStream(f), "UTF-8"));
            pw.println("# H模块密友名单");
            for (String u : ids) {
                String al = miyouAlias(u);
                pw.println(u + (al.length() > 0 ? ("\t" + al) : ""));
            }
            pw.flush();
            pw.close();
            toast("已导出 " + ids.size() + " 个 → " + f.getAbsolutePath());
        } catch (Throwable t) { log("MIYOU|export " + t); toast("导出失败：" + t); }
    }

    /** 从 wxh_miyou.txt 合并导入（不覆盖现有名单，只加） */
    private static void miyouImport(final android.app.Activity a) {
        try {
            java.io.File f = new java.io.File(DIR, "wxh_miyou.txt");
            if (!f.exists()) { toast("找不到 " + f.getAbsolutePath()); return; }
            java.io.BufferedReader br = new java.io.BufferedReader(
                    new java.io.InputStreamReader(new java.io.FileInputStream(f), "UTF-8"));
            java.util.HashSet<String> ids = new java.util.HashSet<String>(miyouSet());
            int n = 0;
            String line;
            while ((line = br.readLine()) != null) {
                line = line.trim();
                if (line.length() == 0 || line.startsWith("#")) continue;
                String[] sp = line.split("\t");
                String u = sp[0].trim();
                if (u.length() == 0) continue;
                ids.add(u);
                n++;
                if (sp.length > 1 && sp[1].trim().length() > 0) miyouAliasSet(u, sp[1].trim());
            }
            br.close();
            miyouStore(ids);
            refreshConvList();
            toast("已导入 " + n + " 条，现有 " + ids.size() + " 个密友");
            showMiyouPanel(a);
        } catch (Throwable t) { log("MIYOU|import " + t); toast("导入失败：" + t); }
    }

    private static java.util.HashSet<String> miyouNamesCache = null;
    private static long miyouNamesAt = 0;

    /** 密友的显示名 + 别名，用于在通知里认出是谁 */
    private static java.util.HashSet<String> miyouNames() {
        long now = System.currentTimeMillis();
        java.util.HashSet<String> c = miyouNamesCache;
        if (c != null && now - miyouNamesAt < 15000) return c;
        c = new java.util.HashSet<String>();
        for (String u : miyouSet()) {
            try {
                String nm = resolveName(u);
                if (nm != null && nm.trim().length() > 0) c.add(nm.trim());
            } catch (Throwable ignore) { }
            try {
                String al = miyouAlias(u);
                if (al.length() > 0) c.add(al);
            } catch (Throwable ignore) { }
        }
        miyouNamesCache = c;
        miyouNamesAt = now;
        return c;
    }

    private static boolean miyouNameHit(String s) {
        if (s == null || s.length() == 0) return false;
        for (String n : miyouNames()) {
            if (n.length() >= 2 && s.contains(n)) return true;
        }
        return false;
    }

    /** 密友来消息不弹通知：通知标题/正文里出现密友名字就吞掉这条通知 */
    private static void installMiyouNotify(ClassLoader app) {
        try {
            XposedBridge.hookAllMethods(android.app.NotificationManager.class, "notify",
                    new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        android.app.Notification n = null;
                        String tag = null;
                        for (Object o2 : p.args) {
                            if (o2 instanceof android.app.Notification) n = (android.app.Notification) o2;
                            else if (o2 instanceof String) tag = (String) o2;
                        }
                        StringBuilder sb = new StringBuilder();
                        if (tag != null) sb.append(tag).append(' ');
                        if (n != null && n.extras != null) {
                            sb.append(String.valueOf(n.extras.getCharSequence("android.title"))).append(' ');
                            sb.append(String.valueOf(n.extras.getCharSequence("android.text"))).append(' ');
                            sb.append(String.valueOf(n.extras.getCharSequence("android.bigText"))).append(' ');
                        }
                        String all = sb.toString();
                        // 密友静音
                        if (miyouOnNow() && cfg().optBoolean("miyouMute", true)
                                && !miyouSet().isEmpty() && miyouNameHit(all)) {
                            log("MIYOU|mute notify");
                            p.setResult(null);
                            return;
                        }
                        // 红包 / 转账免打扰：命中群名单就吞掉通知
                        if (cfg().optBoolean("rpkMute", false)) {
                            boolean money = all.contains("红包") || all.contains("转账")
                                    || all.contains("收款") || all.contains("[微信红包]");
                            if (money) {
                                String gl = cfg().optString("rpkGroups", "");
                                boolean hit = gl.trim().length() == 0;
                                for (String g : gl.split(",")) {
                                    if (g.trim().length() > 0 && all.contains(g.trim())) { hit = true; break; }
                                }
                                if (hit) {
                                    log("RPKMUTE|drop " + all.replace('\n', ' '));
                                    p.setResult(null);
                                }
                            }
                        }
                    } catch (Throwable ignore) { }
                }
            });
            log("MIYOU|notify hook ok");
        } catch (Throwable t) { log("MIYOU|notify " + t); }
    }

    /** 从现有会话里挑密友（勾选 = 藏起来） */
    private static void pickMiyou(final android.app.Activity a) {
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.List<Object[]> rows = queryRows(
                        "select username from rconversation where username is not null "
                                + "order by conversationTime desc limit 200", 1);
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (rows.isEmpty()) { toast("读不到会话列表，先打开任意一个聊天再试"); return; }
                        final String[] ids = new String[rows.size()];
                        final String[] items = new String[rows.size()];
                        final boolean[] ck = new boolean[rows.size()];
                        final java.util.HashSet<String> cur = new java.util.HashSet<String>(miyouSet());
                        for (int i = 0; i < rows.size(); i++) {
                            ids[i] = String.valueOf(rows.get(i)[0]);
                            String nm = resolveName(ids[i]);
                            items[i] = (nm.length() > 0 ? nm : ids[i]) + "    " + ids[i];
                            ck[i] = cur.contains(ids[i]);
                        }
                        android.app.AlertDialog.Builder bd = new android.app.AlertDialog.Builder(a);
                        bd.setTitle("选择要藏起来的会话（勾上=密友）");
                        bd.setMultiChoiceItems(items, ck, new android.content.DialogInterface.OnMultiChoiceClickListener() {
                            @Override public void onClick(android.content.DialogInterface d, int which, boolean isChecked) {
                                ck[which] = isChecked;
                            }
                        });
                        bd.setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                            @Override public void onClick(android.content.DialogInterface d, int w) {
                                java.util.HashSet<String> nw = new java.util.HashSet<String>();
                                for (int i = 0; i < ids.length; i++) if (ck[i]) nw.add(ids[i]);
                                miyouStore(nw);
                                refreshConvList();
                                toast("密友 " + nw.size() + " 个，已隐藏");
                                showMiyou(a);
                            }
                        });
                        bd.setNegativeButton("取消", null);
                        bd.show();
                    }
                });
            }
        }).start();
    }

    private static long grpUnreadAt = 0;
    private static int grpUnreadVal = 0;

    private static int groupUnreadTotal() {
        long now = System.currentTimeMillis();
        if (now - grpUnreadAt < 5000) return grpUnreadVal;
        grpUnreadAt = now;
        int sum = 0;
        try {
            java.util.List<Object[]> rows = queryRows(
                    "select unReadCount,username from rconversation where unReadCount>0 and username like '%@chatroom'", 2);
            for (Object[] r : rows) {
                try {
                    // 密友被藏起来了，未读也不该算进「群聊」聚合的角标
                    if (miyouHidden(String.valueOf(r[1] == null ? "" : r[1]).trim())) continue;
                    sum += Integer.parseInt(String.valueOf(r[0]).trim());
                } catch (Throwable ignore) { }
            }
        } catch (Throwable ignore) { }
        grpUnreadVal = sum;
        return sum;
    }

    private static final int REQ_GROUP_AVATAR = 0x5A11;

    /** 长按群聊归拢行：选一张图当静态头像 */
    private static void showGroupRowAvatarPicker(final android.content.Context ctx) {
        try {
            new android.app.AlertDialog.Builder(ctx)
                    .setTitle("群聊头像")
                    .setItems(new String[]{"选择图片", "恢复默认"}, new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            if (w == 1) {
                                setStrCfg("groupRowAvatar", "");
                                toast("已恢复默认头像");
                                return;
                            }
                            try {
                                android.content.Intent it = new android.content.Intent(android.content.Intent.ACTION_GET_CONTENT);
                                it.setType("image/*");
                                it.addCategory(android.content.Intent.CATEGORY_OPENABLE);
                                if (!(ctx instanceof android.app.Activity)) { toast("请在微信界面操作"); return; }
                                ((android.app.Activity) ctx).startActivityForResult(it, REQ_GROUP_AVATAR);
                            } catch (Throwable t) { toast("打开相册失败：" + t); }
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) { log("GAV|err " + t); }
    }

    /** 把选中的图片拷到私有目录并记下路径 */
    private static void handleGroupRowAvatarResult(android.app.Activity a, int req, int res, android.content.Intent data) {
        try {
            if (req != REQ_GROUP_AVATAR) return;
            if (res != android.app.Activity.RESULT_OK || data == null || data.getData() == null) return;
            java.io.InputStream in = a.getContentResolver().openInputStream(data.getData());
            java.io.File out = new java.io.File(DIR, "group_row_avatar.png");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            byte[] buf = new byte[8192];
            int r;
            while ((r = in.read(buf)) > 0) fo.write(buf, 0, r);
            in.close();
            fo.close();
            setStrCfg("groupRowAvatar", out.getAbsolutePath());
            toast("头像已更新");
            log("GAV|saved " + out.getAbsolutePath());
        } catch (Throwable t) { log("GAV|save err " + t); }
    }

    private static android.view.View buildGroupRow(final android.content.Context ctx) {
        android.widget.LinearLayout row = new android.widget.LinearLayout(ctx);
        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        row.setPadding(dp(ctx, 16), dp(ctx, 10), dp(ctx, 16), dp(ctx, 10));
        row.setBackgroundColor(0x00000000);
        row.setClickable(true);
        row.setTag("wxhGroupRow");
        row.setOnLongClickListener(new android.view.View.OnLongClickListener() {
            @Override public boolean onLongClick(android.view.View v) {
                showGroupRowAvatarPicker(v.getContext());
                return true;
            }
        });

        // 头像：取未读最多的群；都没未读则随机一个群
        String pick = null;
        try {
            java.util.List<Object[]> rr = queryRows("select username from rconversation"
                    + " where username like '%@chatroom' and unReadCount>0"
                    + " order by unReadCount desc limit 1", 1);
            if (!rr.isEmpty()) pick = String.valueOf(rr.get(0)[0]);
        } catch (Throwable ignore) { }
        if (pick == null) {
            try {
                java.util.List<String[]> gs = convGroups();
                if (!gs.isEmpty()) pick = gs.get(new java.util.Random().nextInt(gs.size()))[0];
            } catch (Throwable ignore) { }
        }
        android.graphics.Bitmap avBmp = null;
        try {
            String custom = cfg().optString("groupRowAvatar", "");
            if (custom.length() > 0) {
                java.io.File cf = new java.io.File(custom);
                if (cf.isFile()) avBmp = android.graphics.BitmapFactory.decodeFile(cf.getAbsolutePath());
            }
        } catch (Throwable ignore) { }
        if (avBmp != null) {
            android.widget.ImageView iv = new android.widget.ImageView(ctx);
            iv.setImageBitmap(avBmp);
            iv.setScaleType(android.widget.ImageView.ScaleType.CENTER_CROP);
            if (cfg().optBoolean("thRoundAvatar", true)) {
                iv.setClipToOutline(true);
                iv.setOutlineProvider(new android.view.ViewOutlineProvider() {
                    @Override public void getOutline(android.view.View v, android.graphics.Outline o) {
                        o.setOval(0, 0, v.getWidth(), v.getHeight());
                    }
                });
            }
            row.addView(iv, new android.widget.LinearLayout.LayoutParams(dp(ctx, 48), dp(ctx, 48)));
        } else {
            android.widget.TextView icon = new android.widget.TextView(ctx);
            icon.setText("群");
            icon.setTextSize(15);
            icon.setTextColor(0xFFFFFFFF);
            android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
            gd.setColor(0xFFE23636);
            if (cfg().optBoolean("thRoundAvatar", true)) {
                gd.setShape(android.graphics.drawable.GradientDrawable.OVAL);
            } else {
                gd.setCornerRadius(dp(ctx, 6));
            }
            icon.setBackground(gd);
            icon.setGravity(android.view.Gravity.CENTER);
            row.addView(icon, new android.widget.LinearLayout.LayoutParams(dp(ctx, 48), dp(ctx, 48)));
        }

        android.widget.LinearLayout col = new android.widget.LinearLayout(ctx);
        col.setOrientation(android.widget.LinearLayout.VERTICAL);
        col.setPadding(dp(ctx, 12), 0, 0, 0);
        col.setGravity(android.view.Gravity.CENTER_VERTICAL);
        android.widget.TextView t1 = new android.widget.TextView(ctx);
        t1.setText("群聊");
        t1.setTextSize(17);
        t1.setTextColor(0xFF000000);
        col.addView(t1);
        int grpUn = groupUnreadTotal();
        android.widget.TextView t2 = new android.widget.TextView(ctx);
        t2.setText(grpUn > 0 ? (groupCount() + " 个群 · " + grpUn + " 条未读") : (groupCount() + " 个群 · 点此查看"));
        t2.setTextSize(14);
        t2.setTextColor(grpUn > 0 ? 0xFF07C160 : 0xFFB2B2B2);
        col.addView(t2);
        row.addView(col, new android.widget.LinearLayout.LayoutParams(0,
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));

        if (grpUn > 0) {
            android.widget.TextView badge = new android.widget.TextView(ctx);
            badge.setText(grpUn > 99 ? "99+" : String.valueOf(grpUn));
            badge.setTextSize(11);
            badge.setTextColor(0xFFFFFFFF);
            badge.setGravity(android.view.Gravity.CENTER);
            android.graphics.drawable.GradientDrawable bgd = new android.graphics.drawable.GradientDrawable();
            bgd.setColor(0xFF07C160);
            bgd.setCornerRadius(dp(ctx, 9));
            badge.setBackground(bgd);
            badge.setPadding(dp(ctx, 5), 0, dp(ctx, 5), 0);
            android.widget.LinearLayout.LayoutParams blp = new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, dp(ctx, 18));
            blp.gravity = android.view.Gravity.CENTER_VERTICAL;
            row.addView(badge, blp);
        }

        row.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                if (ctx instanceof android.app.Activity) showGroupHub((android.app.Activity) ctx);
            }
        });
        row.setOnLongClickListener(new android.view.View.OnLongClickListener() {
            @Override public boolean onLongClick(android.view.View v) {
                if (!(ctx instanceof android.app.Activity)) return true;
                final android.app.Activity act = (android.app.Activity) ctx;
                new Thread(new Runnable() {
                    @Override public void run() {
                        final int n = clearAllUnread();
                        act.runOnUiThread(new Runnable() {
                            @Override public void run() {
                                toast("已清除 " + n + " 个会话的未读");
                                refreshConvList(act);
                            }
                        });
                    }
                }).start();
                return true;
            }
        });
        return row;
    }

    /** 折叠/展开群聊：改配置并刷新会话列表 */
    private static void toggleFold(final android.content.Context ctx) {
        try {
            boolean cur = cfg().optBoolean("groupFold", false);
            setOn("groupFold", !cur);
            Object ad = lastConvAdapter;
            if (ad != null) {
                try { ad.getClass().getMethod("notifyDataSetChanged").invoke(ad); } catch (Throwable ignore) { }
            }
