        try {
            if (a == null || !themeOn()) return;
            if (THEME_SAFE_OFF) return;
            if (!a.getClass().getName().contains("LauncherUI")) return;
            android.view.ViewGroup pg0 = weldPagerRef == null ? null : weldPagerRef.get();
            if (pg0 == null) {
                pg0 = findPager(a.getWindow().getDecorView());
                if (pg0 != null) weldPagerRef = new java.lang.ref.WeakReference<android.view.ViewGroup>(pg0);
            }
            if (pg0 == null) return;
            final android.view.ViewGroup pgr = pg0;
            Runnable r = new Runnable() {
                @Override public void run() {
                    try {
                        for (int i = 0; i < pgr.getChildCount(); i++) {
                            android.view.View c = pgr.getChildAt(i);
                            if (c != null) c.setTag(0x0f0f0f60, null);
                        }
                        applyThemePageBg(a);
                        // 把历史遗留的透明页面恢复成不透明白底
