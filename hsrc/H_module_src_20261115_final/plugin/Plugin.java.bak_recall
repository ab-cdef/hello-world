    /** 用捕获到的 SQLiteDatabase 把原消息内容加上「（已撤回）」 */
    private static boolean markRevoked(String talker, long svrId) {
        try {
            Object db = dbRef;
            if (db == null) {
                log("MARK|no db");
                return false;
            }
            Class<?> dbc = db.getClass();
            Object cur = null;
            for (Method m : dbc.getMethods()) {
                if (!m.getName().equals("rawQuery")) continue;
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length != 2 || ps[0] != String.class) continue;
                Object arg;
                if (ps[1] == String[].class) arg = new String[]{String.valueOf(svrId)};
                else if (ps[1] == Object[].class) arg = new Object[]{String.valueOf(svrId)};
                else continue;
                m.setAccessible(true);
                cur = m.invoke(db, "select msgId, content from message where msgSvrId=?", arg);
                break;
            }
            if (cur == null) {
                log("MARK|no rawQuery");
                return false;
            }
            android.database.Cursor c = (android.database.Cursor) cur;
            if (c == null || !c.moveToFirst()) {
                log("MARK|row not found " + svrId);
                if (c != null) c.close();
                return false;
            }
            long localId = c.getLong(0);
            String content = c.getString(1);
            c.close();
            // 标记文案：默认「〔已撤回〕」；可切换放句首
            final String TAG = "〔已撤回〕";
            if (content != null && (content.contains(TAG) || content.contains("（已撤回）"))) return true;
            // 只有纯文本才改内容。图片/语音/文件是 XML，硬加后缀会破坏解析，导致消息显示异常
            boolean isText = (content == null) || (content.length() > 0 && content.charAt(0) != '<');
            boolean putFirst = cfg().optBoolean("unrecallPrefix", false);
            int n = 0;
            if (isText) {
                String nc;
                if (content == null || content.length() == 0) nc = TAG;
                else if (putFirst) nc = TAG + "\n" + content;
                else nc = content + "  " + TAG;
                ContentValues cv = new ContentValues();
                cv.put("content", nc);
                for (Method m : dbc.getMethods()) {
                    if (!m.getName().equals("update")) continue;
                    Class<?>[] ps = m.getParameterTypes();
                    if (ps.length != 4 || ps[0] != String.class || ps[1] != ContentValues.class || ps[2] != String.class) continue;
                    Object arg;
                    if (ps[3] == String[].class) arg = new String[]{String.valueOf(localId)};
                    else if (ps[3] == Object[].class) arg = new Object[]{String.valueOf(localId)};
                    else continue;
                    m.setAccessible(true);
                    n = (Integer) m.invoke(db, "message", cv, "msgId=?", arg);
                    break;
                }
            } else {
                log("MARK|skip non-text svrId=" + svrId);
            }
            log("MARK|updated localId=" + localId + " n=" + n + " text=" + isText);
            try {
                Object f = Class.forName("w41.i9", false, appCl != null ? appCl : Plugin.class.getClassLoader()).getMethod("b").invoke(null);
                Object store = f.getClass().getMethod("v").invoke(f);
                try {
                    store.getClass().getMethod("doNotify", String.class).invoke(store, talker);
                    log("MARK|notify talker");
                } catch (Throwable t2) {
                    store.getClass().getMethod("doNotify").invoke(store);
                    log("MARK|notify all");
                }
            } catch (Throwable t) {
            }
            log("MARK|act=" + (chatAct == null ? "null" : chatAct.getClass().getName()));
            // 让当前聊天列表立即重绘
            try {
                final android.app.Activity a = chatAct;
                if (a != null) {
                    a.runOnUiThread(new Runnable() {
                        @Override
                        public void run() {
                            try {
                                java.util.List<Object> lists = new java.util.ArrayList<Object>();
                                collectLists(a.getWindow().getDecorView(), lists);
                                log("MARK|lists=" + lists.size());
                                for (Object rv : lists) {
                                    try {
                                        Object ad = rv.getClass().getMethod("getAdapter").invoke(rv);
                                        if (ad != null) {
                                            ad.getClass().getMethod("notifyDataSetChanged").invoke(ad);
                                            log("MARK|refreshed via " + rv.getClass().getName());
                                        }
                                    } catch (Throwable t1) {
                                    }
                                    try {
                                        rv.getClass().getMethod("invalidateViews").invoke(rv);
                                        log("MARK|invalidateViews " + rv.getClass().getName());
                                    } catch (Throwable t2) {
                                    }
                                }
                            } catch (Throwable t) {
                                log("MARK refresh err " + t);
                            }
                        }
                    });
                }
            } catch (Throwable t) {
            }
            return n > 0;
        } catch (Throwable t) {
            log("MARK err " + t);
            return false;
        }
    }

    private static final java.util.HashMap<String, Long> recent = new java.util.HashMap<String, Long>();

    private static boolean inQuietHours() {
        try {
            int start = cfg().optInt("quietStart", -1);
            int end = cfg().optInt("quietEnd", -1);
            if (start < 0 || end < 0) return false;
            java.util.Calendar cal = java.util.Calendar.getInstance();
            int h = cal.get(java.util.Calendar.HOUR_OF_DAY);
            if (start == end) return false;
            if (start < end) return h >= start && h < end;
            return h >= start || h < end;
        } catch (Throwable t) {
            return false;
        }
    }

    private static android.widget.EditText findEditText(View v) {
        try {
            if (v instanceof android.widget.EditText) return (android.widget.EditText) v;
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.widget.EditText e = findEditText(g.getChildAt(i));
                    if (e != null && e.isShown()) return e;
                }
            }
        } catch (Throwable t) {
        }
        return null;
    }

    private static View findSendButton(View v) {
        try {
            if (v instanceof android.widget.TextView) {
                CharSequence t = ((android.widget.TextView) v).getText();
                CharSequence d = v.getContentDescription();
                if ((t != null && "发送".equals(t.toString().trim()))
                        || (d != null && "发送".equals(d.toString().trim()))) return v;
            }
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    View r = findSendButton(g.getChildAt(i));
                    if (r != null) return r;
                }
            }
        } catch (Throwable t) {
        }
        return null;
    }

    /** 自动回复：在聊天页填内容并点发送 */
    // 自动回复的防抖/防串聊状态
    private static final java.util.HashMap<String, Long> arLastAt = new java.util.HashMap<String, Long>();
