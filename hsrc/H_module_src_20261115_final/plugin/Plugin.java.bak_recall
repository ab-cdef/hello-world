    private static void showMeSimplPicker(final android.app.Activity a) {
        showMultiPicker(a, "「我」页精简", "meSimplWords", "meSimpl",
                "勾选要从「我」页隐藏的项，可多选", ME_PAGE_ITEMS);
    }

    private static void showDiscPicker(final android.app.Activity a) {
        showMultiPicker(a, "隐藏发现页入口", "hideDiscItems", null,
                "勾选要从「发现」页隐藏的入口，可多选", DISC_ITEMS);
