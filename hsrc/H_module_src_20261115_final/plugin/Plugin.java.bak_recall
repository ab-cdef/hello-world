                                    "com.tencent.mm_preferences", android.content.Context.MODE_PRIVATE);
                            String u0 = sp.getString("login_weixin_username", "");
                            if (u0 != null && u0.length() > 0) myId = u0;
                        } catch (Throwable ignore) { }
                        java.util.List<Object[]> me0 = queryRows(
                                "select username, nickname from userinfo2 limit 1", 2);
                        log("ME|userinfo rows=" + me0.size()
                                + (me0.isEmpty() ? "" : " id=" + me0.get(0)[0] + " nick=" + me0.get(0)[1]));
                        if (me0.isEmpty()) {
