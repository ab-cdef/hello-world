    /** 数据库探测失败的日志限流：60 秒最多一条，避免每 tick 刷屏 */
    private static boolean dbLogGate() {
        long n = System.currentTimeMillis();
        if (n - dbLogAt < 60000) return false;
        dbLogAt = n;
        return true;
    }
