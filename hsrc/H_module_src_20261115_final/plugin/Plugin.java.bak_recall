    /** 面板分组标题 + 分隔线 */
    private static void addTimeSection(final android.app.Activity a, android.widget.LinearLayout box,
                                       String title, String desc) {
        android.view.View line = new android.view.View(a);
        line.setBackgroundColor(0x1A000000);
        android.widget.LinearLayout.LayoutParams lp =
                new android.widget.LinearLayout.LayoutParams(-1, dp(a, 1));
        lp.topMargin = dp(a, 12);
        lp.bottomMargin = dp(a, 6);
        box.addView(line, lp);

        android.widget.TextView h = new android.widget.TextView(a);
        h.setText(title);
        h.setTextSize(15);
        h.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
        h.setTextColor(0xFF141418);
        h.setPadding(0, dp(a, 2), 0, 0);
        box.addView(h);
        if (desc != null && desc.length() > 0) {
            android.widget.TextView d = new android.widget.TextView(a);
            d.setText(desc);
            d.setTextSize(11);
            d.setTextColor(0xFF9A9AA3);
            d.setPadding(0, dp(a, 2), 0, dp(a, 4));
            box.addView(d);
        }
    }

    private static android.app.Dialog timePanelDlg = null;

    private static void showTimePanel(final android.app.Activity a) {
        try {
            try {
                if (timePanelDlg != null && timePanelDlg.isShowing()) timePanelDlg.dismiss();
            } catch (Throwable ignore) { }
            final JSONObject c = cfg();
            boolean on = c.optBoolean("msgTimeEnh", false);
            String tpl = c.optString("msgTimeTpl", "$time | $type");
            String fmt = c.optString("msgTimeFmtEnh", "yyyy/MM/dd HH:mm:ss");
            int sp = 11;
            try { sp = Integer.parseInt(c.optString("msgTimeSizeEnh", "11").trim()); } catch (Throwable ignore) { }
            int cmode = c.optInt("msgTimeColorMode", 0);
            boolean center = c.optBoolean("msgTimeCenter", false);
            boolean every = true;

            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 14), dp(a, 10), dp(a, 14), dp(a, 6));

            // 预览
            String sample = tpl.replace("$time", fmtNow(fmt))
                    .replace("$relativeTime", "3分钟前")
                    .replace("$type", "文字")
                    .replace("$sender", "张三");
            sample = sample.replaceAll("\\s*\\|\\s*$", "").replaceAll("^\\s*\\|\\s*", "").trim();
            android.widget.TextView pv = new android.widget.TextView(a);
            pv.setText("预览：" + sample);
            pv.setTextSize(13);
            pv.setTextColor(0xFF444444);
            pv.setBackground(roundRect(0x14000000, dp(a, 10)));
            pv.setPadding(dp(a, 12), dp(a, 10), dp(a, 12), dp(a, 10));
            box.addView(pv);

            addTimeSection(a, box, "增强时间", "气泡外底部那行时间，由本模块生成，可自定义模板");
            addTimeRow(a, box, "消息时间显示", on ? "开" : "关", on, new Runnable() {
                @Override public void run() { putBool("msgTimeEnh", !cfg().optBoolean("msgTimeEnh", false)); showTimePanel(a); }
            });
            addTimeRow(a, box, "时间模板", tpl, true, new Runnable() {
                @Override public void run() {
                    pickStr(a, "时间模板（点一下即用）", new String[]{
                            "$time", "$time | $type", "$time · $sender", "$relativeTime",
                            "$relativeTime · $type", "$time | $type | $sender", "$sender：$time", "自定义…"
                    }, "msgTimeTpl", "$time | $type", new Runnable() { @Override public void run() { showTimePanel(a); } });
                }
            });
            addTimeRow(a, box, "时间格式", fmt, true, new Runnable() {
                @Override public void run() {
                    pickStr(a, "时间格式（点一下即用）", new String[]{
                            "跟原生一样（推荐）", "yyyy/MM/dd HH:mm:ss", "yyyy-MM-dd HH:mm",
                            "MM-dd HH:mm:ss", "MM-dd HH:mm", "HH:mm:ss", "自定义…"
                    }, "msgTimeFmtEnh", "跟原生一样（推荐）", new Runnable() { @Override public void run() { showTimePanel(a); } });
                }
            });
            addTimeRow(a, box, "时间字号", sp + "sp", true, new Runnable() {
                @Override public void run() {
                    int[] sizes = {9, 10, 11, 12, 13, 14, 16, 18};
                    int cur = 11;
                    try { cur = Integer.parseInt(cfg().optString("msgTimeSizeEnh", "11").trim()); } catch (Throwable ignore) { }
                    int idx = 0;
                    for (int i = 0; i < sizes.length; i++) if (sizes[i] == cur) idx = i;
                    putStr("msgTimeSizeEnh", String.valueOf(sizes[(idx + 1) % sizes.length]));
                    showTimePanel(a);
                }
            });
            int customCol = cfg().optInt("msgTimeColorNew", 0);
            String colLabel = customCol != 0
                    ? String.format("#%06X", customCol & 0xFFFFFF)
                    : (cmode == 0 ? "暗色（深底用）" : "亮色（暗底用）");
            addTimeRow(a, box, "时间颜色", colLabel, true, new Runnable() {
                @Override public void run() {
                    showColorPickerCb(a, "msgTimeColorNew",
                            cfg().optInt("msgTimeColorNew", 0xFF8A8A93), new Runnable() {
                                @Override public void run() {
                                    try { showTimePanel(a); } catch (Throwable ignore) { }
                                }
                            });
                }
            });
            addTimeRow(a, box, "时间底色", cfg().optBoolean("msgTimePill", false) ? "浅色底" : "无（跟原生一样）", true,
                    new Runnable() {
                        @Override public void run() {
                            setOn("msgTimePill", !cfg().optBoolean("msgTimePill", false));
                            showTimePanel(a);
                        }
                    });
            addTimeRow(a, box, "一键跟原生", "格式/字号/颜色全部还原", true, new Runnable() {
                @Override public void run() {
                    setStrCfg("msgTimeFmtEnh", "");
                    setStrCfg("msgTimeSizeEnh", "12");
                    setIntCfg("msgTimeColorNew", -5052927);
                    setOn("msgTimePill", false);
                    setOn("hideNativeTime", false);
                    toast("已还原成微信原生时间样式");
                    showTimePanel(a);
                }
            });

            // 居中 + 每条都显示：固定开启，不再提供开关
            addTimeRow(a, box, "恢复默认", "点一下重置", true, new Runnable() {
                @Override public void run() {
                    setStrCfg("ntTimeFmt", "");
                    setIntCfg("ntTimeSize", 0);
                    setIntCfg("ntTimeColorInt", 0);
                    setOn("hideNativeTime", false);
                    setStrCfg("msgTimeSizeEnh", "11");
                    setIntCfg("msgTimeColorNew", 0);
                    setIntCfg("bubbleTimeColor", 0);
                    toast("已恢复默认");
                    showTimePanel(a);
                }
            });

            android.widget.TextView tip = new android.widget.TextView(a);
            tip.setText("时间显示在每条消息顶部、居中；开启「隐藏原生时间」后每行只剩一个时间");
            tip.setTextSize(11);
            tip.setTextColor(0xFF999999);
            tip.setPadding(0, dp(a, 8), 0, 0);
            box.addView(tip);

            android.app.AlertDialog d0 = new android.app.AlertDialog.Builder(a)
                    .setTitle("消息时间")
                    .setView(box)
                    .setPositiveButton("完成", null)
                    .create();
            timePanelDlg = d0;
            d0.setOnDismissListener(new android.content.DialogInterface.OnDismissListener() {
                @Override public void onDismiss(android.content.DialogInterface d) {
                    if (timePanelDlg == d) timePanelDlg = null;
                }
            });
            d0.show();
        } catch (Throwable t) { log("TIMEPANEL|err " + t); }
    }

    private static String fmtNow(String pat) {
        try { return new java.text.SimpleDateFormat(pat).format(new java.util.Date()); }
        catch (Throwable t) { return "2026/11/08 08:30:00"; }
    }

    private static void addTimeRow(final android.app.Activity a, android.widget.LinearLayout box,
                                   String label, String value, boolean on, final Runnable click) {
        try {
            android.widget.LinearLayout row = new android.widget.LinearLayout(a);
            row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            row.setGravity(android.view.Gravity.CENTER_VERTICAL);
            row.setPadding(dp(a, 2), dp(a, 13), dp(a, 2), dp(a, 13));
            android.widget.TextView l = new android.widget.TextView(a);
            l.setText(label);
            l.setTextSize(15);
            l.setTextColor(0xFF1A1A1A);
            row.addView(l, new android.widget.LinearLayout.LayoutParams(0,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
            android.widget.TextView r = new android.widget.TextView(a);
            r.setText(value);
            r.setTextSize(13);
            r.setTextColor(on ? 0xFF07C160 : 0xFF999999);
            r.setGravity(android.view.Gravity.END);
            row.addView(r);
            row.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) { click.run(); }
            });
            box.addView(row);
            android.view.View div = new android.view.View(a);
            div.setBackgroundColor(0x14000000);
            box.addView(div, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, 1));
        } catch (Throwable ignore) { }
    }

