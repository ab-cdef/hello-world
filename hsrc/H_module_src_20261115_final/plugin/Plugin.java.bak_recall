                        StringBuilder sb = new StringBuilder();
                        for (String[] l : st) sb.append(l[0]).append("：").append(l[1])
                                .append("（").append(l[2]).append("）\n");
                        sb.append("\n").append(path[0] == null ? "导出失败" : "已导出：" + path[0]);
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("类型分布：" + name)
                                .setMessage(sb.toString())
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

