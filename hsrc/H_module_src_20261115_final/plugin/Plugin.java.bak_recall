    private static long fragLogAt = 0;

    /** 解码主题图并叠加"微信主页同款磨砂白"，返回可直接用的 Drawable */

    private static void installFragmentHook(ClassLoader app) {
        try {
            if (TABS_THEME_OFF) { log("frag hook off"); return; }
            Class<?> f = Class.forName("androidx.fragment.app.Fragment", false, app);
            XposedBridge.hookAllMethods(f, "onResume", new XC_MethodHook() {
                @Override
                protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        Object frag0 = p.thisObject;
                        if (frag0 != null && System.currentTimeMillis() - fragLogAt > 3000) {
                            fragLogAt = System.currentTimeMillis();
                            log("FRAG|onResume " + frag0.getClass().getName());
                        }
                        if (!themeOn()) return;
                        if (THEME_SAFE_OFF) return;   // 稳定模式：不贴页面底图、不清背景
                        Object frag = p.thisObject;
                        Object act = frag.getClass().getMethod("getActivity").invoke(frag);
                        if (act == null || !themed.containsKey(act)) return;
                        Object fv = frag.getClass().getMethod("getView").invoke(frag);
                        if (!(fv instanceof View)) return;
                        String fn = frag.getClass().getName();
                        // 聊天页不套主题，保持微信原样
                        if (fn.contains("Chatting") || fn.contains("chatting")) return;
                        String key = "MainFragmentBackground";
                        String low = fn.toLowerCase();
                        if (low.contains("contact") || low.contains("address")) key = "ContactFragmentBackground";
                        else if (low.contains("findmore") || low.contains("discover") || low.contains("find")) key = "DiscoverFragmentBackground";
                        else if (low.contains("moretab") || low.contains("more") || low.contains("setting")
                                || low.contains("mine") || low.contains("profile")) key = "MeFragmentBackground";
                        if (!themeOn()) return;   // 默认不接管页面外观
                        String img = themePageImg(key);
                        if (img == null) img = themePageImg("MainFragmentBackground");
                        if (img == null) return;
                        // 微信首页贴原图；后三页清掉页面自身背景，只留窗口底（磨砂白），避免两层图叠加
                        boolean frost = !"MainFragmentBackground".equals(key);   // 只有首页贴图，其他页保持原样
                        if (frost) {
                            // 后三页也贴图，但加一层更重的白纱保证文字可读
                            Drawable d3 = Drawable.createFromPath(img);
                            if (d3 == null) return;
                            try {
                                android.graphics.drawable.ColorDrawable cw2 =
                                        new android.graphics.drawable.ColorDrawable(0xFFFFFFFF);
                                cw2.setAlpha(150);
                                d3 = new android.graphics.drawable.LayerDrawable(new Drawable[]{d3, cw2});
                            } catch (Throwable ignore) { }
                            try {
                                applying.set(Boolean.TRUE);
                                ((View) fv).setBackground(d3);
                            } finally {
                                applying.set(Boolean.FALSE);
                            }
                            return;
                        }
                        // 已改用 ImageView 覆盖层统一出图：
                        // Fragment 层不再贴任何背景图，避免和覆盖层重复叠加（重影/发灰）
                        if (true) return;
                        Drawable d = Drawable.createFromPath(img);
                        if (d == null) return;
                        try {
                            if (d instanceof android.graphics.drawable.BitmapDrawable) {
                                ((android.graphics.drawable.BitmapDrawable) d)
                                        .setGravity(android.view.Gravity.TOP
                                                | android.view.Gravity.FILL_HORIZONTAL);
                            }
                        } catch (Throwable ignore) { }
                        // 图上盖一层半透明白，保证文字可读（强度由 pageBgWhite 控制）
                        if (d != null) {
                            int scrim = cfg().optInt("pageBgWhite", 105);
                            if (scrim > 0) {
                                try {
                                    android.graphics.drawable.ColorDrawable cw =
                                            new android.graphics.drawable.ColorDrawable(0xFFFFFFFF);
                                    cw.setAlpha(Math.min(230, scrim));
                                    d = new android.graphics.drawable.LayerDrawable(
                                            new Drawable[]{d, cw});
                                } catch (Throwable ignore) { }
                            }
                        }
                        int clr = 0;
                        applying.set(Boolean.TRUE);
                        try {
                            ((View) fv).setBackground(d);
                            clr = themeClearAll((View) fv);
                        } finally {
                            applying.set(Boolean.FALSE);
                        }
                        log("frag bg|" + fn.substring(fn.lastIndexOf('.') + 1) + "|" + key
                                + "|" + img.substring(img.lastIndexOf('/') + 1) + "|clr=" + clr);
                    } catch (Throwable t) {
                    }
                }
            });
            log("hooked Fragment.onResume");
        } catch (Throwable t) {
            log("frag hook err " + t);
        }
    }

    /** 老包同款：递归把所有子控件背景置空，让 fragment 底图透出来 */
    /** 只清列表行容器（RecyclerView/ListView 的直接子项）背景，不动文字/图标 */
    private static int themeClearRows(View v, int depth) {
        int n = 0;
        if (v == null || depth > 12) return 0;
        try {
            String cn = v.getClass().getName();
            boolean isList = cn.contains("RecyclerView") || v instanceof android.widget.AbsListView;
            if (isList && v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                try {
                    if (v.getBackground() != null) { v.setBackground(null); n++; }
                } catch (Throwable ignore) { }
                for (int i = 0; i < g.getChildCount(); i++) {
                    View it = g.getChildAt(i);
                    if (it == null) continue;
                    try {
                        if (it.getBackground() != null) {
                            it.setBackgroundColor(0x00FFFFFF);
                            n++;
                        }
                    } catch (Throwable ignore) { }
                }
                return n;   // 不再往下递归，避免动到文字/图标
            }
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    n += themeClearRows(g.getChildAt(i), depth + 1);
                }
            }
        } catch (Throwable ignore) { }
        return n;
    }

    /** 列表渲染晚于 onResume，延迟几拍把白底清掉，让主题图透出来 */
    private static void themeRowPulse(final android.app.Activity a) {
        try {
            if (a == null) return;
            if (!themeOn()) return;
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            final int[] delays = {600, 1800, 3500};
            for (final int d : delays) {
                h.postDelayed(new Runnable() {
                    @Override public void run() {
                        try {
                            if (a.isFinishing()) return;
                            android.view.ViewGroup pager = tabPager;
                            if (pager == null) pager = findPager(a.getWindow().getDecorView());
                            if (pager == null) return;
                            int total = 0;
                            // 只处理首页：后三页清底会出现黑块/白字消失（历史教训）
                            if (pager.getChildCount() > 0) {
                                android.view.View pg0 = pager.getChildAt(0);
                                if (pg0 != null) total += themeClearRows(pg0, 0);
                            }
                            if (total > 0) log("THEMEPULSE|d=" + d + " cleared=" + total);
                        } catch (Throwable ignore) { }
                    }
                }, d);
            }
        } catch (Throwable ignore) { }
    }

    private static int themeClearAll(View v) {
        int n = 0;
        if (v == null) return 0;
        try {
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    View c = g.getChildAt(i);
                    String cn = c.getClass().getName();
                    try {
                        if (!cn.contains("TextureView") && !cn.contains("VideoView")) {
                            if (c.getBackground() != null) {
                                c.setBackground(null);
                                n++;
                            }
                        }
                    } catch (Throwable t2) { }
                    n += themeClearAll(c);
                }
            }
        } catch (Throwable t) { }
        return n;
    }

    /** 虚拟定位 */
    private static void installFakeGps(ClassLoader app) {
        try {
            Class<?> lm = Class.forName("android.location.LocationManager", false, app);
            XposedBridge.hookAllMethods(lm, "getLastKnownLocation", new XC_MethodHook() {
                @Override
                protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        double lat = cfg().optDouble("fakeLat", 0);
                        double lng = cfg().optDouble("fakeLng", 0);
                        if (lat == 0 && lng == 0) return;
                        android.location.Location loc = new android.location.Location("wxh");
                        loc.setLatitude(lat);
                        loc.setLongitude(lng);
                        loc.setAccuracy(10f);
                        loc.setTime(System.currentTimeMillis());
                        p.setResult(loc);
                    } catch (Throwable t) {
                    }
                }
            });
            log("hooked LocationManager.getLastKnownLocation");
        } catch (Throwable t) {
            log("gps err " + t);
        }
    }

    /** 步数修改：hook 传感器事件里的计步值 */
    private static void installStep(ClassLoader app) {
        try {
            Class<?> q = Class.forName("android.hardware.SystemSensorManager$SensorEventQueue", false, app);
            for (final Method m : q.getDeclaredMethods()) {
                if (!m.getName().equals("dispatchSensorEvent")) continue;
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length < 3 || ps[1] != float[].class) continue;
                m.setAccessible(true);
                XposedBridge.hookMethod(m, new XC_MethodHook() {
                    @Override
                    protected void beforeHookedMethod(MethodHookParam p) {
                        try {
                            int steps = cfg().optInt("stepCount", 0);
                            if (steps <= 0) return;
                            float[] v = (float[]) p.args[1];
                            if (v == null || v.length == 0) return;
                            if (v[0] > 0 && v[0] < 200000) v[0] = steps;
                        } catch (Throwable t) {
                        }
                    }
                });
                log("hooked sensor dispatchSensorEvent");
            }
        } catch (Throwable t) {
            log("step err " + t);
        }
    }

    /** 主题美化已整体下线：所有主题渲染分支永不执行，界面保持微信原生 */
    private static boolean themeOn() {
        return false;
    }

    private static void installTheme(ClassLoader app) {
        try {
            // 首页/主界面也套用主题
            String[] uis = {"com.tencent.mm.ui.LauncherUI", "com.tencent.mm.ui.HomeUI"};
            for (String un : uis) {
                try {
                    final Class<?> uc = Class.forName(un, false, app);
                    for (final Method m : uc.getDeclaredMethods()) {
                        String mn = m.getName();
                        if ((mn.equals("onResume") || mn.equals("onCreate")) && m.getParameterTypes().length <= 1) {
                            m.setAccessible(true);
                            XposedBridge.hookMethod(m, new XC_MethodHook() {
                                @Override
                                protected void afterHookedMethod(MethodHookParam p) {
                                    applyTheme(p.thisObject);
                                }
                            });
                            log("hooked " + un + "." + mn);
                            break;
                        }
                    }
                } catch (Throwable t2) {
                    log("theme ui skip " + un);
                }
            }
            // 聊天页保持微信原生：主题只做首页/通讯录/发现/我，绝不碰聊天页
            if (true) {
                log("theme: chat page native (never themed)");
                return;
            }
            final Class<?> c = Class.forName("com.tencent.mm.ui.chatting.ChattingUI", false, app);
            for (final Method m : c.getDeclaredMethods()) {
                if (!m.getName().equals("onResume") || m.getParameterTypes().length != 0) continue;
                log("sns found onResume");
                m.setAccessible(true);
                XposedBridge.hookMethod(m, new XC_MethodHook() {
                    @Override
                    protected void afterHookedMethod(MethodHookParam p) {
                        applyTheme(p.thisObject);
                    }
                });
                log("hooked ChattingUI.onResume");
            }
            for (final Method m : c.getDeclaredMethods()) {
                if (!m.getName().equals("onCreate") || m.getParameterTypes().length != 1) continue;
                m.setAccessible(true);
                XposedBridge.hookMethod(m, new XC_MethodHook() {
                    @Override
                    protected void afterHookedMethod(MethodHookParam p) {
                        applyTheme(p.thisObject);
                    }
                });
                log("hooked ChattingUI.onCreate");
            }
        } catch (Throwable t) {
            log("theme err " + t);
        }
    }

