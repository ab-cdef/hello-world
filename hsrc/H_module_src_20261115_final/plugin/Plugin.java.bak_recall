                l.invalidateViews();
                l.requestLayout();
            }
        } catch (Throwable ignore) { }
    }

    /** 额外设置入口：长按底栏 / 双击标题栏，都能打开 H 菜单 */
    private static void installExtraEntries(final android.app.Activity a) {
        try {
            if (a == null) return;
            if (!a.getClass().getName().endsWith(".LauncherUI")) return;
            if (!cfg().optBoolean("multiEntry", true)) return;
            android.view.View root = a.getWindow().getDecorView();
            // ① 底栏长按已按用户要求移除
            // ② 标题栏双击
            final android.view.View title = findTitleBarView(root, 0);
            if (title != null && title.getTag(0x0f0f0f42) == null) {
                title.setTag(0x0f0f0f42, Boolean.TRUE);
                title.setOnClickListener(new android.view.View.OnClickListener() {
                    long lastAt = 0;
                    @Override public void onClick(android.view.View v) {
                        long now = System.currentTimeMillis();
                        if (now - lastAt < 600) { lastAt = 0; showHMenu(a, null); }
                        else lastAt = now;
                    }
                });
                log("ENTRY|title dblclick hooked");
            }
        } catch (Throwable t) {
            log("ENTRY|err " + t);
        }
    }

    private static void attachLongClickDeep(android.view.View v, android.view.View.OnLongClickListener l, int d) {
        if (v == null || d > 3) return;
        try { v.setOnLongClickListener(l); } catch (Throwable ignore) { }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) attachLongClickDeep(g.getChildAt(i), l, d + 1);
        }
    }

    private static android.view.View findTitleBarView(android.view.View v, int d) {
        if (v == null || d > 10) return null;
        String cn = v.getClass().getName();
        if (cn.contains("ActionBarContainer") || cn.endsWith(".Toolbar")) return v;
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View r = findTitleBarView(g.getChildAt(i), d + 1);
                if (r != null) return r;
            }
        }
        return null;
    }

    private static void showHMenu(final android.app.Activity a, final android.view.View plus) {
