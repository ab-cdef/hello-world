    private static void installDice(ClassLoader app) {
        try {
            Class<?> rnd = Class.forName("java.util.Random", false, app);
            XposedBridge.hookAllMethods(rnd, "nextInt", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (p.args.length != 1) return;
                        Object a = p.args[0];
                        if (!(a instanceof Integer) || ((Integer) a) != 6) return;
                        int want = cfg().optInt("dice", 0);
                        if (want < 1 || want > 6) return;
                        if (!fromSmiley()) return;
                        p.setResult(want - 1);
                        log("DICE|forced " + want);
                    } catch (Throwable t) {
                    }
                }
            });
            log("hooked Random.nextInt");
        } catch (Throwable t) {
            log("dice err " + t);
        }
    }

    private static boolean fromSmiley() {
        try {
            StackTraceElement[] st = new Throwable().getStackTrace();
            int n = Math.min(st.length, 20);
            for (int i = 2; i < n; i++) {
                String c = st[i].getClassName();
                if (c.contains("SmileyGrid") || c.contains("Emoji") || c.contains("emoji")
                        || c.equals("com.tencent.mm.sdk.platformtools.b9")) return true;
            }
        } catch (Throwable t) {
        }
        return false;
    }

