    private static void showSnsBackup(final android.app.Activity a) {
        try {
            final java.io.File f = new java.io.File(a.getFilesDir(), "sns_cache.jsonl");
            if (!f.exists()) { toast("还没有备份数据（去刷一下朋友圈）"); return; }
            final java.util.ArrayList<String[]> rows = new java.util.ArrayList<String[]>();
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            String line;
            while ((line = br.readLine()) != null) {
                try {
                    org.json.JSONObject o = new org.json.JSONObject(line);
                    rows.add(new String[]{o.optString("c"), String.valueOf(o.optLong("t"))});
                } catch (Throwable ignore) { }
            }
            br.close();
            java.util.Collections.reverse(rows);
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 14), dp(a, 8), dp(a, 14), dp(a, 8));
            android.widget.TextView head = new android.widget.TextView(a);
            head.setText("已备份 " + rows.size() + " 条动态（长按可清空）");
            head.setTextSize(12);
            head.setTextColor(0xFF888888);
            box.addView(head);
            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            int n = 0;
            for (String[] r : rows) {
                if (n++ > 200) break;
                android.widget.TextView tv = new android.widget.TextView(a);
                tv.setText(fmtTs(Long.parseLong(r[1])).substring(0, 16) + "\n" + r[0]);
                tv.setTextSize(13);
                tv.setTextColor(0xFF222222);
                tv.setPadding(0, dp(a, 8), 0, dp(a, 8));
                list.addView(tv);
                android.view.View div = new android.view.View(a);
                div.setBackgroundColor(0x1A000000);
                list.addView(div, new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT, 1));
            }
            list.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                @Override public boolean onLongClick(android.view.View v) {
                    new android.app.AlertDialog.Builder(a).setTitle("清空朋友圈备份？")
                            .setPositiveButton("清空", new android.content.DialogInterface.OnClickListener() {
                                @Override public void onClick(android.content.DialogInterface d, int w) {
                                    f.delete();
                                    toast("已清空");
                                }
                            }).setNegativeButton("取消", null).show();
                    return true;
                }
            });
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(a, 470)));
            new android.app.AlertDialog.Builder(a).setTitle("朋友圈备份").setView(box)
                    .setPositiveButton("关闭", null).show();
            log("SNSCACHE|view n=" + rows.size());
        } catch (Throwable t) { log("SNSCACHE|view err " + t); }
    }

    private static void showTodoPanel(final android.app.Activity a) {
        try {
            final java.util.ArrayList<org.json.JSONObject> items = new java.util.ArrayList<org.json.JSONObject>();
            java.io.File f = todoFile(a);
            if (f.exists()) {
                java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
                String line;
                while ((line = br.readLine()) != null) {
                    try { items.add(new org.json.JSONObject(line)); } catch (Throwable ignore) { }
                }
                br.close();
            }
            java.util.Collections.reverse(items);
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 14), dp(a, 8), dp(a, 14), dp(a, 8));
            android.widget.TextView head = new android.widget.TextView(a);
            head.setText("共 " + items.size() + " 条待办 · 点跳转，长按删除");
            head.setTextSize(12);
            head.setTextColor(0xFF888888);
            box.addView(head);
            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            final android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            for (int i = 0; i < items.size() && i < 200; i++) {
                final org.json.JSONObject o = items.get(i);
                final int idx = i;
                android.widget.TextView tv = new android.widget.TextView(a);
                tv.setText("· " + displayOfTalker(o.optString("k")) + "　"
                        + fmtTs(o.optLong("t")).substring(5, 16) + "\n" + o.optString("x"));
                tv.setTextSize(13);
                tv.setTextColor(o.optBoolean("d") ? 0xFF999999 : 0xFF222222);
                tv.setPadding(0, dp(a, 8), 0, dp(a, 8));
                tv.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        jumpToMessage(o.optString("k"), o.optLong("t"), 0, o.optString("x"));
                    }
                });
                tv.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                    @Override public boolean onLongClick(android.view.View v) {
                        removeTodoLine(a, idx);
                        return true;
                    }
                });
                list.addView(tv);
                android.view.View div = new android.view.View(a);
                div.setBackgroundColor(0x1A000000);
                list.addView(div, new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT, 1));
            }
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(a, 470)));
            new android.app.AlertDialog.Builder(a).setTitle("消息待办").setView(box)
                    .setPositiveButton("关闭", null)
                    .setNeutralButton("清空", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            todoFile(a).delete();
                            toast("已清空");
                        }
                    }).show();
        } catch (Throwable t) { log("TODO|panel err " + t); }
    }

    private static void addTodo(String talker, long ts, String text) {
        try {
            android.content.Context c = ctxAny();
            if (c == null) return;
            org.json.JSONObject o = new org.json.JSONObject();
            o.put("t", ts);
            o.put("k", talker == null ? "" : talker);
            o.put("x", text == null ? "" : text.replace("\n", " "));
            o.put("d", false);
            java.io.FileWriter fw = new java.io.FileWriter(todoFile(c), true);
            fw.write(o.toString());
            fw.write("\n");
            fw.close();
            toast("已加入待办");
            log("TODO|add " + ts);
        } catch (Throwable t) { log("TODO|add err " + t); }
    }

    private static void removeTodoLine(android.content.Context c, int revIndex) {
        try {
            java.io.File f = todoFile(c);
            if (!f.exists()) return;
            java.util.ArrayList<String> lines = new java.util.ArrayList<String>();
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            String line;
            while ((line = br.readLine()) != null) lines.add(line);
            br.close();
            int real = lines.size() - 1 - revIndex;
            if (real >= 0 && real < lines.size()) lines.remove(real);
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            for (String l : lines) { fw.write(l); fw.write("\n"); }
            fw.close();
            toast("已删除，重新打开面板生效");
        } catch (Throwable t) { log("TODO|del err " + t); }
    }

    private static void cacheSnsRows(android.app.Activity act) {
        try {
            if (System.currentTimeMillis() - snsCacheAt < 800) return;
            snsCacheAt = System.currentTimeMillis();
            android.view.View decor = act.getWindow().getDecorView();
            android.widget.ListView lv = null;
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(decor, all, 0);
            for (android.view.View v : all) {
                if (!(v instanceof android.widget.ListView)) continue;
                android.widget.ListView cand = (android.widget.ListView) v;
                if (cand.getChildCount() > 0) { lv = cand; break; }
            }
            if (lv == null) return;
            java.io.File f = new java.io.File(act.getFilesDir(), "sns_cache.jsonl");
            java.util.HashSet<String> known = new java.util.HashSet<String>();
            if (f.exists()) {
                java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
                String line;
                while ((line = br.readLine()) != null) {
                    int p = line.indexOf("\"h\":\"");
                    if (p > 0) {
                        int e = line.indexOf('"', p + 5);
                        if (e > p) known.add(line.substring(p + 5, e));
                    }
                }
                br.close();
            }
            java.io.FileWriter fw = new java.io.FileWriter(f, true);
            int added = 0;
            for (int i = 0; i < lv.getChildCount(); i++) {
                android.view.View row = lv.getChildAt(i);
                java.util.ArrayList<android.widget.TextView> tvs = new java.util.ArrayList<android.widget.TextView>();
                collectTexts(row, tvs, 0);
                StringBuilder sb = new StringBuilder();
                for (android.widget.TextView tv : tvs) {
                    String t = tv.getText() == null ? "" : tv.getText().toString().trim();
                    if (t.length() < 2) continue;
                    if (sb.indexOf(t) >= 0) continue;
                    sb.append(t).append(" | ");
                }
                if (sb.length() < 8) continue;
                String text = sb.toString();
                String hash = Integer.toHexString(text.hashCode());
                if (known.contains(hash)) continue;
                known.add(hash);
                StringBuilder line = new StringBuilder();
                line.append("{\"t\":").append(System.currentTimeMillis())
                    .append(",\"h\":\"").append(hash).append("\",\"c\":\"")
                    .append(text.replace("\\", "\\\\").replace("\"", "'").replace("\n", " "))
                    .append("\"}");
                fw.write(line.toString());
                fw.write("\n");
                added++;
            }
            fw.close();
            if (added > 0) log("SNSCACHE|added=" + added);
        } catch (Throwable t) { log("SNSCACHE|err " + t); }
    }

    private static java.io.File todoFile(android.content.Context c) {
        return new java.io.File(c.getFilesDir(), "todo.jsonl");
    }

    private static void doExportRange(final android.app.Activity a, final String tk,
                                      final String fromYmd, final String toYmd) {
        final Object h = msgDbHandle();
        if (h == null) { toast("数据库未就绪"); return; }
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    long from = fromYmd.length() > 0 ? dayStartMs(fromYmd, false) : 0;
                    long to = toYmd.length() > 0 ? dayStartMs(toYmd, true) : Long.MAX_VALUE;
                    if (from < 0 || to < 0) { toast("日期格式应为 yyyy-MM-dd"); return; }
                    Object probe = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select max(createTime) from message", new String[0]);
                    boolean ms = false;
                    if (probe != null) {
                        java.lang.reflect.Method mv = probe.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gl = probe.getClass().getMethod("getLong", int.class);
                        if ((Boolean) mv.invoke(probe)) ms = (Long) gl.invoke(probe, 0) > 100000000000L;
                        try { probe.getClass().getMethod("close").invoke(probe); } catch (Throwable ignore) { }
                    }
                    long f2 = ms ? from : (from > 0 ? from / 1000L : 0);
                    long t2 = ms ? to : (to == Long.MAX_VALUE ? Long.MAX_VALUE : to / 1000L);
                    StringBuilder sb = new StringBuilder();
                    sb.append("会话：").append(displayOfTalker(tk)).append('\n');
                    sb.append("范围：").append(fromYmd.length() > 0 ? fromYmd : "最早")
                      .append(" ~ ").append(toYmd.length() > 0 ? toYmd : "现在").append("\n\n");
                    int n = 0;
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select type, content, createTime, isSend from message where talker='"
                                    + tk.replace("'", "''") + "' and createTime>=" + f2 + " and createTime<=" + t2
                                    + " order by createTime asc", new String[0]);
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            long ty = (Long) gl.invoke(cur, 0);
                            String c = (String) gs.invoke(cur, 1);
                            long t = (Long) gl.invoke(cur, 2);
                            long mine = (Long) gl.invoke(cur, 3);
                            String body = bodyOf(ty, c);
                            if (body == null) continue;
                            if (!ms) t *= 1000L;
                            sb.append('[').append(fmtTs(t)).append("] ")
                              .append(mine > 0 ? "我" : displayOfTalker(tk)).append(": ")
                              .append(body.replace('\n', ' ')).append('\n');
                            n++;
                        }
                        try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                    }
                    java.io.File dir = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                            "Download/wxh");
                    dir.mkdirs();
                    final int fn = n;
                    java.io.File out = new java.io.File(dir, "chat_" + System.currentTimeMillis() + ".txt");
                    java.io.FileWriter fw = new java.io.FileWriter(out);
                    fw.write(sb.toString());
                    fw.close();
                    final String path = out.getAbsolutePath();
                    log("EXPRANGE|n=" + n + " " + path);
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("导出完成")
                                    .setMessage("共 " + fn + " 条\n\n" + path)
                                    .setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) { log("EXPRANGE|err " + t); }
            }
        }).start();
    }

    private static long dayStartMs(String ymd, boolean endOfDay) {
        try {
            java.text.SimpleDateFormat f = new java.text.SimpleDateFormat("yyyy-MM-dd");
            java.util.Date dt = f.parse(ymd);
            long t = dt.getTime();
            return endOfDay ? t + 86399000L : t;
        } catch (Throwable t) { return -1; }
    }


    private static void doExportByMonth(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || tk.length() == 0) { toast("请先在要导出的聊天里执行"); return; }
        new android.app.AlertDialog.Builder(a)
                .setTitle("按月拆分导出")
                .setMessage("把这个会话的全部消息按月份拆成多个 txt，存到 Download/wxh/monthly/ 下。\n\n会话："
                        + displayOfTalker(tk))
                .setPositiveButton("开始", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        runMonthExport(a, tk);
                    }
                })
                .setNegativeButton("取消", null).show();
    }

    private static void runMonthExport(final android.app.Activity a, final String tk) {
        final Object h = msgDbHandle();
        if (h == null) { toast("数据库未就绪"); return; }
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    Object probe = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select max(createTime) from message", new String[0]);
                    boolean ms = false;
                    if (probe != null) {
                        java.lang.reflect.Method mv = probe.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gl = probe.getClass().getMethod("getLong", int.class);
                        if ((Boolean) mv.invoke(probe)) ms = (Long) gl.invoke(probe, 0) > 100000000000L;
                        try { probe.getClass().getMethod("close").invoke(probe); } catch (Throwable ignore) { }
                    }
                    Object cur2 = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select type, content, createTime, isSend from message where talker='"
                                    + tk.replace("'", "''") + "' order by createTime asc", new String[0]);
                    java.util.LinkedHashMap<String, StringBuilder> months =
                            new java.util.LinkedHashMap<String, StringBuilder>();
                    int total = 0;
                    if (cur2 != null) {
                        java.lang.reflect.Method mv = cur2.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gl = cur2.getClass().getMethod("getLong", int.class);
                        java.lang.reflect.Method gs = cur2.getClass().getMethod("getString", int.class);
                        java.text.SimpleDateFormat mf = new java.text.SimpleDateFormat("yyyy-MM");
                        while ((Boolean) mv.invoke(cur2)) {
                            long ty = (Long) gl.invoke(cur2, 0);
                            String cn2 = (String) gs.invoke(cur2, 1);
                            long t = (Long) gl.invoke(cur2, 2);
                            long mine = (Long) gl.invoke(cur2, 3);
                            String body = bodyOf(ty, cn2);
                            if (body == null) continue;
                            if (!ms) t *= 1000L;
                            String key = mf.format(new java.util.Date(t));
                            StringBuilder sb = months.get(key);
                            if (sb == null) { sb = new StringBuilder(); months.put(key, sb); }
                            sb.append('[').append(fmtTs(t)).append("] ")
                              .append(mine > 0 ? "我" : displayOfTalker(tk)).append(": ")
                              .append(body.replace('\n', ' ')).append('\n');
                            total++;
                        }
                        try { cur2.getClass().getMethod("close").invoke(cur2); } catch (Throwable ignore) { }
                    }
                    java.io.File dir = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                            "Download/wxh/monthly/" + Math.abs(tk.hashCode()));
                    dir.mkdirs();
                    int files = 0;
                    for (java.util.Map.Entry<String, StringBuilder> e : months.entrySet()) {
                        java.io.FileWriter fw = new java.io.FileWriter(new java.io.File(dir, e.getKey() + ".txt"));
                        fw.write("会话：" + displayOfTalker(tk) + "\n月份：" + e.getKey() + "\n\n");
                        fw.write(e.getValue().toString());
                        fw.close();
                        files++;
                    }
                    final int fTotal = total, fFiles = files;
                    final String path = dir.getAbsolutePath();
                    log("EXPMONTH|files=" + files + " msgs=" + total + " " + path);
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("导出完成")
                                    .setMessage("共 " + fTotal + " 条，拆成 " + fFiles + " 个月份文件\n\n" + path)
                                    .setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) { log("EXPMONTH|err " + t); }
            }
        }).start();
    }

    private static void runGroupActive(final android.app.Activity a, final String tk, final long days) {
        final Object h = msgDbHandle();
        if (h == null) { toast("数据库未就绪"); return; }
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    long since = days <= 0 ? 0 : (System.currentTimeMillis() / 1000L - days * 86400L);
                    if (days == 1) {
                        java.util.Calendar c = java.util.Calendar.getInstance();
                        c.set(java.util.Calendar.HOUR_OF_DAY, 0); c.set(java.util.Calendar.MINUTE, 0);
                        c.set(java.util.Calendar.SECOND, 0);
                        since = c.getTimeInMillis() / 1000L;
                    }
                    String sql = "select content from message where talker='" + tk.replace("'", "''")
                            + "' and isSend=0" + (since > 0 ? (" and createTime>=" + since) : "");
                    java.util.HashMap<String, Integer> cnt = new java.util.HashMap<String, Integer>();
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, sql, new String[0]);
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            String c = (String) gs.invoke(cur, 0);
                            if (c == null) continue;
                            int idx = c.indexOf(':');
                            if (idx <= 0 || idx > 64) continue;
                            String who = c.substring(0, idx).trim();
                            if (!who.startsWith("wxid") && !who.endsWith("@openim")) continue;
                            Integer v = cnt.get(who);
                            cnt.put(who, v == null ? 1 : v + 1);
                        }
                        try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                    }
                    final java.util.ArrayList<java.util.Map.Entry<String, Integer>> list =
                            new java.util.ArrayList<java.util.Map.Entry<String, Integer>>(cnt.entrySet());
                    java.util.Collections.sort(list, new java.util.Comparator<java.util.Map.Entry<String, Integer>>() {
                        @Override public int compare(java.util.Map.Entry<String, Integer> x,
                                                     java.util.Map.Entry<String, Integer> y) {
                            return y.getValue().compareTo(x.getValue());
                        }
                    });
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            try {
                                android.widget.LinearLayout box = new android.widget.LinearLayout(a);
                                box.setOrientation(android.widget.LinearLayout.VERTICAL);
                                box.setPadding(dp(a, 14), dp(a, 8), dp(a, 14), dp(a, 8));
                                android.widget.TextView head = new android.widget.TextView(a);
                                head.setText("共 " + list.size() + " 人发言");
                                head.setTextSize(12);
                                head.setTextColor(0xFF888888);
                                box.addView(head);
                                android.widget.ScrollView sv = new android.widget.ScrollView(a);
                                android.widget.LinearLayout inner = new android.widget.LinearLayout(a);
                                inner.setOrientation(android.widget.LinearLayout.VERTICAL);
                                int rank = 1;
                                for (java.util.Map.Entry<String, Integer> e : list) {
                                    android.widget.TextView tv = new android.widget.TextView(a);
                                    tv.setText(rank + ". " + displayOfTalker(e.getKey()) + "　" + e.getValue() + " 条");
                                    tv.setTextSize(14);
                                    tv.setTextColor(0xFF222222);
                                    tv.setPadding(0, dp(a, 6), 0, dp(a, 6));
                                    inner.addView(tv);
                                    if (++rank > 80) break;
                                }
                                sv.addView(inner);
                                box.addView(sv, new android.widget.LinearLayout.LayoutParams(
                                        android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(a, 460)));
                                new android.app.AlertDialog.Builder(a)
                                        .setTitle("群成员发言排行" + (days > 0 ? "（近 " + days + " 天）" : "（全部）"))
                                        .setView(box).setPositiveButton("关闭", null).show();
                                log("GACT|" + list.size());
                            } catch (Throwable t) { log("GACT|panel " + t); }
                        }
                    });
                } catch (Throwable t) { log("GACT|err " + t); }
            }
        }).start();
    }

    /* ================= 每日自动备份 ================= */
    private static volatile long snsCacheAt = 0;
    private static volatile long lastAutoBackupChk = 0;

    private static void autoBackupTick(android.app.Activity a) {
        try {
            if (a == null) return;
            if (!cfg().optBoolean("autoDailyBackup", false)) return;
            long now = System.currentTimeMillis();
            if (now - lastAutoBackupChk < 60000) return;
            lastAutoBackupChk = now;
            android.content.SharedPreferences sp =
                    a.getSharedPreferences("wxh_auto", android.content.Context.MODE_PRIVATE);
            long last = sp.getLong("lastBackup", 0);
            if (now - last < 86400000L) return;
            sp.edit().putLong("lastBackup", now).apply();
            log("AUTOBK|start last=" + last);
            backupAllChats(a);
        } catch (Throwable t) { log("AUTOBK|err " + t); }
    }

    private static void backupAllChats(final android.app.Activity a) {
        final Object h = msgDbHandle();
        if (h == null) { toast("数据库未就绪"); return; }
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    java.io.File dir = new java.io.File(android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
                    dir.mkdirs();
                    java.io.File zipFile = new java.io.File(dir, "wxh_backup_" + System.currentTimeMillis() + ".zip");
                    java.util.zip.ZipOutputStream zos = new java.util.zip.ZipOutputStream(
                            new java.io.BufferedOutputStream(new java.io.FileOutputStream(zipFile)));
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select username from rconversation order by conversationTime desc", new String[0]);
                    java.util.ArrayList<String> tks = new java.util.ArrayList<String>();
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        while ((Boolean) mv.invoke(cur)) tks.add((String) gs.invoke(cur, 0));
                        try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                    }
                    int total = 0, convs = 0;
                    for (String tk : tks) {
                        StringBuilder sb = new StringBuilder();
                        Object c2 = h.getClass().getMethod("B", String.class, String[].class)
                                .invoke(h, "select type, content, createTime, isSend from message where talker='"
                                        + tk.replace("'", "''") + "' order by createTime asc", new String[0]);
                        if (c2 == null) continue;
                        java.lang.reflect.Method mv2 = c2.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gl2 = c2.getClass().getMethod("getLong", int.class);
                        java.lang.reflect.Method gs2 = c2.getClass().getMethod("getString", int.class);
                        int n = 0;
                        while ((Boolean) mv2.invoke(c2)) {
                            long ty = (Long) gl2.invoke(c2, 0);
                            String c = (String) gs2.invoke(c2, 1);
                            long t = (Long) gl2.invoke(c2, 2);
                            long mine = (Long) gl2.invoke(c2, 3);
                            String body = bodyOf(ty, c);
                            if (body == null) continue;
                            if (t < 100000000000L) t *= 1000L;
                            sb.append('[').append(fmtTs(t)).append("] ")
                              .append(mine > 0 ? "我" : "TA").append(": ")
                              .append(body.replace('\n', ' ')).append('\n');
                            n++;
                        }
                        try { c2.getClass().getMethod("close").invoke(c2); } catch (Throwable ignore) { }
                        if (n == 0) continue;
                        String safe = tk.replaceAll("[^A-Za-z0-9_.@-]", "_");
                        if (safe.length() > 60) safe = safe.substring(0, 60);
                        java.util.zip.ZipEntry e = new java.util.zip.ZipEntry(displayOfTalker(tk) + "(" + safe + ").txt");
                        zos.putNextEntry(e);
                        zos.write(sb.toString().getBytes("UTF-8"));
                        zos.closeEntry();
                        total += n; convs++;
                    }
                    zos.close();
                    final int ft = total, fc = convs;
                    final String path = zipFile.getAbsolutePath();
                    log("BACKUP|convs=" + fc + " msgs=" + ft + " " + path);
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("备份完成")
                                    .setMessage(fc + " 个会话 / " + ft + " 条消息\n\n" + path)
                                    .setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) { log("BACKUP|err " + t); }
            }
        }).start();
    }

    /** 每条消息：时间画在整行最右侧（垂直居中），不影响气泡 */
    private static void attachMsgTimeRight(final android.view.View row, long ctRaw) {
        try {
            if (ctRaw <= 0 || row == null) return;
            // 这一行自己就带原生时间文案 → 有原生就不画我们的；没有原生才加
            if (rowHasNativeTime(row)) return;
            long ms = ctRaw < 100000000000L ? ctRaw * 1000L : ctRaw;
            String pat = "HH:mm:ss";
            int fmtIdx = cfg().optInt("msgTimeFmt", 0);
            if (fmtIdx == 1) pat = "yyyy-MM-dd HH:mm";
            else if (fmtIdx == 2) pat = "MM-dd HH:mm:ss";
            else if (fmtIdx == 3) pat = "HH:mm:ss";
            else if (fmtIdx == 4) pat = "MM-dd HH:mm";
            final String txt = new java.text.SimpleDateFormat(pat).format(new java.util.Date(ms));
            final int tcolor = cfg().optInt("bubbleTimeColor", 0xFFFFFFFF);
            final float tsz = cfg().optInt("msgTimeSize", 21);

            Object old = row.getTag(0x0f0f0f05);
            android.view.ViewOverlay ov = row.getOverlay();
            if (old instanceof android.graphics.drawable.Drawable) {
                try { ov.remove((android.graphics.drawable.Drawable) old); } catch (Throwable ignore) { }
            }
            android.graphics.drawable.Drawable d = new android.graphics.drawable.Drawable() {
                private final android.graphics.Paint p = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
                @Override public void draw(android.graphics.Canvas c) {
                    try {
                        setBounds(0, 0, row.getWidth(), row.getHeight());
                        android.graphics.Rect b = getBounds();
                        p.setColor(tcolor);
                        p.setTextSize(tsz);
                        float w = p.measureText(txt);
                        float x = b.right - w - 6;
                        float y = (b.top + b.bottom) / 2f + tsz / 3f;
                        c.drawText(txt, x, y, p);
                    } catch (Throwable ignore) { }
                }
                @Override public void setAlpha(int alpha) { p.setAlpha(alpha); }
                @Override public void setColorFilter(android.graphics.ColorFilter cf) { p.setColorFilter(cf); }
                @Override public int getOpacity() { return android.graphics.PixelFormat.TRANSLUCENT; }
            };
            ov.add(d);
            row.setTag(0x0f0f0f05, d);
        } catch (Throwable ignore) { }
    }

    private static void askText(final android.app.Activity a, String title, String hint, final String key) {
        final android.widget.EditText et = new android.widget.EditText(a);
        et.setText(cfg().optString(key, ""));
        et.setHint(hint);
        new android.app.AlertDialog.Builder(a)
                .setTitle(title)
                .setView(et)
                .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) {
                        try {
                            JSONObject o = readCfg();
                            o.put(key, et.getText().toString().trim());
                            writeCfg(o);
                            cfgAt = 0;
                            showSettings(a);
                        } catch (Throwable t) { toast("保存失败"); }
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static String safeSender(long ts) {
        try { String s = senderOfTs(ts); return s == null ? "" : s; } catch (Throwable t) { return ""; }
    }

    /** 消息类型码 → 中文标签 */
    private static String typeLabel(int t) {
        switch (t) {
            case 1: return "文字";
            case 3: return "图片";
            case 34: return "语音";
            case 37: return "好友请求";
            case 42: return "名片";
            case 43: return "视频";
            case 47: return "表情";
            case 48: return "位置";
            case 49: return "链接/文件";
            case 50: return "通话";
            case 10000: return "系统";
            default: return t <= 0 ? "消息" : ("类型" + t);
        }
    }

    /** 与微信原生一致的时间文案：今天 HH:mm / 昨天 HH:mm / 星期X HH:mm / M月d日 HH:mm / yyyy年M月d日 HH:mm */
    private static String nativeTimeText(long ms) {
        try {
            java.util.Calendar now = java.util.Calendar.getInstance();
            java.util.Calendar t = java.util.Calendar.getInstance();
            t.setTimeInMillis(ms);
            long dayNow = now.get(java.util.Calendar.YEAR) * 1000L + now.get(java.util.Calendar.DAY_OF_YEAR);
            long dayT = t.get(java.util.Calendar.YEAR) * 1000L + t.get(java.util.Calendar.DAY_OF_YEAR);
            String hm = String.format(java.util.Locale.US, "%02d:%02d",
                    t.get(java.util.Calendar.HOUR_OF_DAY), t.get(java.util.Calendar.MINUTE));
            if (dayT == dayNow) return hm;
            if (dayT == dayNow - 1) return "\u6628\u5929 " + hm;
            long diff = dayNow - dayT;
            if (diff > 1 && diff < 7) {
                String[] wk = {"\u661f\u671f\u65e5", "\u661f\u671f\u4e00", "\u661f\u671f\u4e8c",
                        "\u661f\u671f\u4e09", "\u661f\u671f\u56db", "\u661f\u671f\u4e94", "\u661f\u671f\u516d"};
                int d = t.get(java.util.Calendar.DAY_OF_WEEK) - 1;
                if (d < 0 || d > 6) d = 0;
                return wk[d] + " " + hm;
            }
            if (t.get(java.util.Calendar.YEAR) == now.get(java.util.Calendar.YEAR)) {
                return (t.get(java.util.Calendar.MONTH) + 1) + "\u6708" + t.get(java.util.Calendar.DAY_OF_MONTH) + "\u65e5 " + hm;
            }
            return t.get(java.util.Calendar.YEAR) + "\u5e74" + (t.get(java.util.Calendar.MONTH) + 1) + "\u6708"
                    + t.get(java.util.Calendar.DAY_OF_MONTH) + "\u65e5 " + hm;
        } catch (Throwable th) {
            return new java.text.SimpleDateFormat("MM-dd HH:mm").format(new java.util.Date(ms));
        }
    }

    private static String relTime(long ms) {
        long d = System.currentTimeMillis() - ms;
        if (d < 60000L) return "刚刚";
        if (d < 3600000L) return (d / 60000L) + "分钟前";
        if (d < 86400000L) return (d / 3600000L) + "小时前";
        if (d < 86400000L * 30) return (d / 86400000L) + "天前";
        return new java.text.SimpleDateFormat("yyyy-MM-dd").format(new java.util.Date(ms));
    }

    /** 消息时间增强：模板 + 元数据，画在整行上（居中或贴消息一侧） */

    /** 每轮巡检：foreground 被微信重绑清掉时补回来（时间不消失的关键） */
    /** 把微信画在消息行里的原生时间文案清空（我们自己会画一份，避免两条时间叠着） */
    /** 独立的纯时间行（没有头像/气泡，整行只有一句时间） */
    private static boolean isPureTimeRow(android.view.View row) {
        try {
            if (row == null) return false;
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(row, all, 0);
            for (android.view.View v : all) {
                if (v instanceof android.widget.ImageView) return false;
            }
            for (android.view.View v : all) {
                if (!(v instanceof android.widget.TextView)) continue;
                CharSequence cs = ((android.widget.TextView) v).getText();
                if (cs == null) continue;
                String t = cs.toString().trim();
                if (t.length() == 0 || t.length() > 22) continue;
                if (t.indexOf(':') < 0 && t.indexOf('\uFF1A') < 0) continue;
                if (t.matches("(今天|昨天|前天|星期[一二三四五六日天])?\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("\\d{4}[年./-]\\d{1,2}[月./-]\\d{1,2}日?\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("\\d{1,2}月\\d{1,2}日\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("(上午|下午|凌晨|中午|晚上)\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")) return true;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    private static void blankNativeTime(android.view.View row) {
        try {
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(row, all, 0);
            for (android.view.View v : all) {
                if (!(v instanceof android.widget.TextView)) continue;
                CharSequence cs = ((android.widget.TextView) v).getText();
                if (cs == null) continue;
                String t = cs.toString().trim();
                if (t.length() == 0 || t.length() > 22) continue;
                if (t.indexOf(':') < 0 && t.indexOf('\uFF1A') < 0) continue;
                if (t.matches("(今天|昨天|前天|星期[一二三四五六日天])?\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("\\d{4}[年./-]\\d{1,2}[月./-]\\d{1,2}日?\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("\\d{1,2}月\\d{1,2}日\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("(上午|下午|凌晨|中午|晚上)\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")) {
                    ((android.widget.TextView) v).setText("");
                }
            }
        } catch (Throwable ignore) { }
    }

    /** 行内是否已经有微信原生的时间文案（避免我们画的与它重复） */
    private static boolean rowHasNativeTime(android.view.View row) {
        try {
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(row, all, 0);
            boolean hasImg = false;
            String tTime = null;
            for (android.view.View v : all) {
                if (v instanceof android.widget.ImageView) { hasImg = true; continue; }
                if (!(v instanceof android.widget.TextView)) continue;
                CharSequence cs = ((android.widget.TextView) v).getText();
                if (cs == null) continue;
                String t = cs.toString().trim();
                if (t.length() == 0 || t.length() > 22) continue;
                if (t.indexOf(':') < 0 && t.indexOf('\uFF1A') < 0) continue;
                if (t.matches("(今天|昨天|前天|星期[一二三四五六日天])?\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("\\d{4}[年./-]\\d{1,2}[月./-]\\d{1,2}日?\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("\\d{1,2}月\\d{1,2}日\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("(上午|下午|凌晨|中午|晚上)\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")) {
                    tTime = t;
                }
            }
            // 有头像又只有一条纯时间文案 → 时间就画在这一行里，我们自己别再画
            if (hasImg && tTime != null) return true;
            // 原生时间也可能是独立的一行：看相邻兄弟行是不是纯时间行
            try {
                android.view.ViewParent vp = row.getParent();
                if (vp instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) vp;
                    int idx = -1;
                    for (int i = 0; i < g.getChildCount(); i++) {
                        if (g.getChildAt(i) == row) { idx = i; break; }
                    }
                    if (idx > 0 && isPureTimeRow(g.getChildAt(idx - 1))) return true;
                }
            } catch (Throwable ignore) { }
            return false;
        } catch (Throwable ignore) { return false; }
    }

    private static void hideNativeTimeRow(android.view.View row) {
        try {
            if (row == null) return;
            if (row.getVisibility() != android.view.View.VISIBLE) return;
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(row, all, 0);
            // 只处理微信原生的“纯时间行”：整行没有头像/气泡
            for (android.view.View v : all) {
                if (v instanceof android.widget.ImageView) return;
            }
            for (android.view.View v : all) {
                if (!(v instanceof android.widget.TextView)) continue;
                CharSequence cs = ((android.widget.TextView) v).getText();
                if (cs == null) continue;
                String t = cs.toString().trim();
                if (t.length() == 0 || t.length() > 22) continue;
                if (t.indexOf(':') < 0 && t.indexOf('\uFF1A') < 0) continue;
                // 只认纯时间文案：今天/昨天/星期X/日期 + HH:mm
                if (t.matches("(今天|昨天|前天|星期[一二三四五六日天])?\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("\\d{4}[年./-]\\d{1,2}[月./-]\\d{1,2}日?\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("\\d{1,2}月\\d{1,2}日\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")
                        || t.matches("(上午|下午|凌晨|中午|晚上)\\s*\\d{1,2}[:：]\\d{2}([:：]\\d{2})?")) {
                    row.setTag(0x0f0f0f32, Boolean.TRUE);
                    row.setVisibility(android.view.View.GONE);
                    return;
                }
            }
        } catch (Throwable ignore) { }
    }

    private static void reapplyRowTimes(android.view.ViewGroup list) {
        try {
            if (list == null) return;
            int n = list.getChildCount();
            for (int i = 0; i < n; i++) {
                android.view.View row = list.getChildAt(i);
                if (row == null) continue;
                Object held = row.getTag(0x0f0f0f07);
                if (held instanceof android.graphics.drawable.Drawable && rowHasNativeTime(row)) {
                    try { row.setForeground(null); } catch (Throwable ignore) { }
                    row.setTag(0x0f0f0f07, null);
                    continue;
                }
                if (held instanceof android.graphics.drawable.Drawable) {
                    // 已画过：只要 foreground 还是我们那张图就不用重画（微信重绑会把它换掉）
                    try {
                        if (row.getForeground() == held) continue;
                    } catch (Throwable ignore) { }
                    // foreground 被清了，直接挂回去，不重建对象
                    try {
                        row.setForeground((android.graphics.drawable.Drawable) held);
                        row.invalidate();
                        continue;
                    } catch (Throwable ignore) { }
                }
                Object o = row.getTag(0x0f0f0f06);
                if (!(o instanceof Long)) {
                    // 自定义时间格式已开启时，微信原生的「昨天 21:30」分隔行会和我们的时间重复，直接藏掉
                    continue;
                }
                long ts = (Long) o;
                if (ts <= 0) continue;
                attachMsgTimeEnh(row, ts, 0, "", i);
            }
        } catch (Throwable ignore) { }
    }
    private static int drawDbg = 0;
    private static int ntLogAt = 0;
    private static int drawErrAt = 0;
    /** 找这一行（或紧邻的上方时间行）里的原生时间 TextView：有原生时间就只染色，不再自绘，避免叠字 */
    private static android.widget.TextView findNativeTimeTv(android.view.View row) {
        try {
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(row, all, 0);
            for (android.view.View v : all) {
                if (!(v instanceof android.widget.TextView)) continue;
                String t = String.valueOf(((android.widget.TextView) v).getText()).trim();
                if (t.length() > 0 && t.length() <= 22 && isTimeText(t)) return (android.widget.TextView) v;
            }
            // 微信常把时间放在消息行上方独立的一行，往上看两行
            android.view.ViewParent p = row.getParent();
            if (p instanceof android.view.ViewGroup) {
                android.view.ViewGroup pg = (android.view.ViewGroup) p;
                int idx = -1;
                for (int i = 0; i < pg.getChildCount(); i++) {
                    if (pg.getChildAt(i) == row) { idx = i; break; }
                }
                for (int d = 1; d <= 2 && idx >= 0; d++) {
                    int j = idx - d;
                    if (j < 0) break;
                    android.view.View prev = pg.getChildAt(j);
                    if (prev == null) continue;
                    java.util.ArrayList<android.view.View> vv = new java.util.ArrayList<android.view.View>();
                    collectAllViews(prev, vv, 0);
                    for (android.view.View v : vv) {
                        if (!(v instanceof android.widget.TextView)) continue;
                        String t = String.valueOf(((android.widget.TextView) v).getText()).trim();
                        if (t.length() > 0 && t.length() <= 22 && isTimeText(t)) return (android.widget.TextView) v;
                    }
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 时间文字统一用的颜色：只认「时间颜色」面板设的值，其余一律原生灰 */
    private static int msgTimeColor() {
        try {
            int custom = cfg().optInt("msgTimeColorNew", 0);
            if ((custom & 0xFFFFFF) == 0xFFFFFF) custom = 0;   // 纯白视为未设置
            if (custom == -1) custom = 0;
            if (custom != 0) {
                int r0 = (custom >> 16) & 0xFF, g0 = (custom >> 8) & 0xFF, b0 = custom & 0xFF;
                // 历史脏值（纯红/纯黑）不采用，回落到原生灰
                boolean red = r0 > 180 && g0 < 120 && b0 < 120;
                boolean black = r0 < 40 && g0 < 40 && b0 < 40;
                if (!red && !black) return custom | 0xFF000000;
            }
        } catch (Throwable ignore) { }
        return 0xFFA6A6AD;
    }

    private static void attachMsgTimeEnh(final android.view.View row, long ctRaw, int type,
                                         String sender, int rowIdx) {
        try {
            if (ctRaw <= 0 || row == null) return;
            // 有原生时间文案就只把它染成配置色，不再自绘 —— 否则两层文字会叠在一起
            android.widget.TextView natT = findNativeTimeTv(row);
            if (natT != null) {
                try { natT.setTextColor(msgTimeColor()); } catch (Throwable ignore) { }
                try {
                    String fpat = cfg().optString("msgTimeFmtEnh", "");
                    if (fpat != null && fpat.trim().length() > 0) {
                        long msx = ctRaw < 100000000000L ? ctRaw * 1000L : ctRaw;
                        String newTxt = new java.text.SimpleDateFormat(fpat).format(new java.util.Date(msx));
                        Object done = natT.getTag(0x0f0f0f0b);
                        if (!(done instanceof String) || !((String) done).equals(newTxt)) {
                            natT.setText(newTxt);
                            natT.setTag(0x0f0f0f0b, newTxt);
                            log("TIME|fmt=" + fpat + " -> " + newTxt);
                        }
                    }
                } catch (Throwable ignore) { }
                return;
            }
            long ms = ctRaw < 100000000000L ? ctRaw * 1000L : ctRaw;
            String pat = cfg().optString("msgTimeFmtEnh", "");
            String timeStr;
            if (pat == null || pat.trim().length() == 0) {
                timeStr = nativeTimeText(ms);      // 未自定义 → 跟微信原生一致
            } else {
                try {
                    timeStr = new java.text.SimpleDateFormat(pat).format(new java.util.Date(ms));
                } catch (Throwable t) {
                    timeStr = nativeTimeText(ms);
                }
            }
            String tpl = cfg().optString("msgTimeTpl", "$time");
            if (tpl.length() == 0) tpl = "$time";
            String txt = tpl.replace("$time", timeStr)
                    .replace("$relativeTime", relTime(ms))
                    .replace("$type", typeLabel(type))
                    .replace("$msgId", "")
                    .replace("$msgSvrId", "")
                    .replace("$sender", sender == null ? "" : sender);
            txt = txt.replaceAll("\\s*\\|\\s*$", "").replaceAll("^\\s*\\|\\s*", "").trim();
            if (txt.length() == 0) return;
            // 同一行已经画过一模一样的文字就别重画：列表每帧都会被扫一遍，
            // 不拦的话每帧都重建 Drawable，既有性能损耗，也会把滚动中的文字闪掉
            try {
                Object drawn = row.getTag(0x0f0f0f0a);
                if (drawn instanceof String && drawn.equals(txt)) return;
            } catch (Throwable ignore) { }

            // 颜色：“消息时间颜色”设置必须生效 —— 用户选什么就用什么（只把纯白视为未设置）
            int custom = cfg().optInt("msgTimeColorNew", 0);
            // -1 / 纯白 都视为“未设置”，必须先归一化再回退，否则 -1 会挡住设置面板的颜色
            if ((custom & 0xFFFFFF) == 0xFFFFFF) custom = 0;
            if (custom == 0) custom = cfg().optInt("bubbleTimeColor", 0);
            if ((custom & 0xFFFFFF) == 0xFFFFFF) custom = 0;
            final int color = msgTimeColor();
            // 阴影反色：深字配白晕、浅字配黑晕，保证任何颜色都看得清
            int lum = (((color >> 16) & 0xFF) * 299 + ((color >> 8) & 0xFF) * 587 + (color & 0xFF) * 114) / 1000;
            final int shadowCol = lum > 150 ? 0x99000000 : 0x99FFFFFF;
            int sp = 12;
            try { sp = Integer.parseInt(cfg().optString("msgTimeSizeEnh", "12").trim()); } catch (Throwable ignore) { }
            if ((timeLogCounter++ % 20) == 0) {
                log("TIME|sp=" + sp + " color=#" + Integer.toHexString(color) + " center=" + cfg().optBoolean("msgTimeCenter", false));
            }
            if (sp < 8) sp = 8;
            if (sp > 24) sp = 24;
            final float size = sp * row.getResources().getDisplayMetrics().scaledDensity;
            final boolean center = true;    // 与原生一致：顶部居中
            boolean mineB;
            Object sendTag = null;
            try { sendTag = row.getTag(0x0f0f0f09); } catch (Throwable ignore) { }
            if (sendTag instanceof Boolean) {
                mineB = ((Boolean) sendTag).booleanValue();
            } else {
                // 兜底：气泡中心在行的右半 → 我发的
                int rw = row.getWidth();
                int cxc = row.getWidth() / 2;
                try {
                    android.view.View bv = mainTextOf(row);
                    if (bv != null && rw > 0) {
                        int[] loc = new int[2];
                        bv.getLocationOnScreen(loc);
                        int[] rl = new int[2];
                        row.getLocationOnScreen(rl);
                        cxc = loc[0] - rl[0] + bv.getWidth() / 2;
                    }
                } catch (Throwable ignore) { }
                mineB = rw > 0 && cxc > rw / 2;
            }
            final boolean mine = mineB;
            // 头像宽度：时间要躲开头像，贴着气泡外侧
            int avW = 0;
            try {
                java.util.ArrayList<android.widget.ImageView> ivs = new java.util.ArrayList<android.widget.ImageView>();
                collectImages(row, ivs, 0);
                for (android.widget.ImageView iv : ivs) {
                    String cn = iv.getClass().getName();
                    if (cn.contains("Avatar") || cn.contains("avatar")) {
                        avW = Math.max(iv.getWidth(), iv.getMeasuredWidth());
                        break;
                    }
                }
            } catch (Throwable ignore) { }
            if (avW <= 0) avW = (int) (52 * row.getResources().getDisplayMetrics().density);
            final int avSpace = avW + (int) (6 * row.getResources().getDisplayMetrics().density);
            final String ftxt = txt;

            if (System.currentTimeMillis() - enhLogAt > 4000) {
                enhLogAt = System.currentTimeMillis();
                log("TIMEENH|draw tpl=" + tpl + " txt=" + txt + " row=" + row.getWidth() + "x" + row.getHeight()
                        + " color=" + Integer.toHexString(color) + " size=" + size);
            }
            // 给整行加一点底部留白，让时间落在气泡框外下方
            try {
                if (row.getTag(0x0f0f0f08) == null) {
                    float d0 = row.getResources().getDisplayMetrics().density;
                    int extra = (int) (size * 1.5f + 3 * d0);
                    row.setPadding(row.getPaddingLeft(), row.getPaddingTop() + extra,
                            row.getPaddingRight(), row.getPaddingBottom());
                    row.setTag(0x0f0f0f08, Integer.valueOf(extra));
                }
            } catch (Throwable ignore) { }
            Object old = row.getTag(0x0f0f0f07);
            android.graphics.drawable.Drawable d = new android.graphics.drawable.Drawable() {
                private final android.graphics.Paint p = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
                @Override public void draw(android.graphics.Canvas c) {
                    try {
                        setBounds(0, 0, row.getWidth(), row.getHeight());
                        android.graphics.Rect b = getBounds();
                        p.setColor(color);
                        p.setTextSize(size);
                        float w = p.measureText(ftxt);
                        float x;
                        float edge = 6f;
                        if (center) x = (b.left + b.right - w) / 2f;
                        else if (mine) x = b.right - w - edge;      // 我的：整行最右边
                        else x = b.left + edge;                     // 对方：整行最左边
                        if (!center) {
                            float lo = b.left + 6f, hi = b.right - w - 6f;
                            if (hi < lo) hi = lo;
                            if (x < lo) x = lo;
                            if (x > hi) x = hi;
                        }
                        if (drawDbg == 0) {
                            drawDbg = 1;
                            log("TIMEPOS|mine=" + mine + " avSpace=" + avSpace + " w=" + w
                                    + " x=" + x + " rowW=" + b.right + " bottom=" + b.bottom);
                        }
                        // 与原生时间行一致：贴在行顶部、居中，并加一层浅色底（花哨壁纸下才看得清）
                        float y = b.top + size * 1.15f;
                        p.setShadowLayer(0f, 0f, 0f, 0);
                        try {
                            if (cfg().optBoolean("msgTimePill", false)) {
                                float pad = size * 0.55f;
                                float rr = size * 0.9f;
                                android.graphics.Paint bg = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
                                bg.setColor(cfg().optInt("msgTimePillColorInt", 0xCCF0F0F0));
                                float top0 = b.top + size * 0.1f;
                                float bot0 = b.top + size * 1.55f;
                                c.drawRoundRect(x - pad, top0, x + w + pad, bot0, rr, rr, bg);
                            }
                        } catch (Throwable ignore) { }
                        p.setColor(color);
                        c.drawText(ftxt, x, y, p);
                    } catch (Throwable t) { if (drawErrAt == 0) { drawErrAt = 1; log("TIMEDRAW|err " + t); } }
                }
                @Override public void setAlpha(int alpha) { p.setAlpha(alpha); }
                @Override public void setColorFilter(android.graphics.ColorFilter cf) { p.setColorFilter(cf); }
                @Override public int getOpacity() { return android.graphics.PixelFormat.TRANSLUCENT; }
            };
            // 用 foreground 绘制（overlay 在这版微信的行上不刷新，实测不显示）
            try { row.setForeground(d); } catch (Throwable ignore) { }
            row.setTag(0x0f0f0f07, d);
            try { row.setTag(0x0f0f0f0a, ftxt); } catch (Throwable ignore) { }
            // Overlay 加完必须让行重绘，否则时间不显示（之前一直丢就是这个原因）
            try { row.invalidate(); } catch (Throwable ignore) { }
            try {
                final android.view.View rw = row;
                row.postDelayed(new Runnable() { @Override public void run() {
                    try { rw.invalidate(); } catch (Throwable ignore) { }
                } }, 120);
            } catch (Throwable ignore) { }
        } catch (Throwable ignore) { }
    }

    private static boolean leftIsMine(android.view.View row) {
        try { return !leftByAvatar(row, row); } catch (Throwable t) { return false; }
    }

    /** 点击即选的字符串配置 */
    private static void pickStr(final android.app.Activity a, String title, final String[] opts,
                                final String key, final String def) {
        pickStr(a, title, opts, key, def, null);
    }

    private static void pickStr(final android.app.Activity a, String title, final String[] opts,
                                final String key, final String def, final Runnable after) {
        String cur = cfg().optString(key, def);
        String[] show = new String[opts.length];
        for (int i = 0; i < opts.length; i++) {
            show[i] = opts[i].equals(cur) ? ("✓ " + opts[i]) : ("　 " + opts[i]);
        }
        new android.app.AlertDialog.Builder(a)
                .setTitle(title)
                .setItems(show, new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) {
                        if (which == opts.length - 1) {
                            askText(a, key.equals("msgTimeTpl") ? "自定义时间模板" : "自定义时间格式",
                                    "可用变量：$time $relativeTime $type $sender", key);
                            return;
                        }
                        try {
                            JSONObject o = readCfg();
                            o.put(key, opts[which]);
                            writeCfg(o);
                            cfgAt = 0;
                            toast("已设为：" + opts[which]);
                            if (after != null) after.run(); else showSettings(a);
                        } catch (Throwable t) { toast("保存失败"); }
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

