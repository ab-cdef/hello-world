    private static final String[] SETTING_KEYS = new String[SETTINGS.length];

    static {
        for (int i = 0; i < SETTINGS.length; i++) SETTING_KEYS[i] = SETTINGS[i][0];
    }


    /** 有明确取值集合的设置项：返回 {显示, 值} 列表，没有就返回 null（沿用点击循环） */
    private static String[][] optionListOf(String key) {
        if ("ttsMode".equals(key)) {
            return new String[][]{{"全部文字", "all"}, {"仅 @我", "at"}, {"仅关键词", "kw"}};
        }
        if ("ttsWho".equals(key)) {
            return new String[][]{{"群聊和私聊", "both"}, {"仅群聊", "group"}, {"仅私聊", "private"}};
        }
        if ("silentDays".equals(key)) {
            return new String[][]{{"3 天", "3"}, {"7 天", "7"}, {"14 天", "14"}, {"30 天", "30"}};
        }
        if ("snsTimeFmtSel".equals(key)) {
            return new String[][]{
                    {"跟原生", ""},
                    {"HH:mm", "HH:mm"},
                    {"HH:mm:ss", "HH:mm:ss"},
                    {"MM-dd HH:mm", "MM-dd HH:mm"},
                    {"yyyy/MM/dd HH:mm", "yyyy/MM/dd HH:mm"},
                    {"MM月dd日 HH:mm", "MM月dd日 HH:mm"},
                    {"12 小时制", "h:mm"}};
        }
        if ("msgTimeFmtSel".equals(key)) {
            return new String[][]{
                    {"跟原生", "native"},
                    {"HH:mm", "HH:mm"},
                    {"HH:mm:ss", "HH:mm:ss"},
                    {"yyyy/MM/dd HH:mm", "yyyy/MM/dd HH:mm"},
                    {"MM-dd HH:mm", "MM-dd HH:mm"},
                    {"12 小时制", "h:mm"}};
        }
        return null;
    }

    private static void applyOptionValue(final android.app.Activity a, String key, String value) {
        try {
            if ("snsTimeFmtSel".equals(key)) {
                setStrCfg("snsTimeFmt", value == null ? "" : value);
                toast("朋友圈时间：" + (value == null || value.length() == 0 ? "跟原生" : value));
                if (settingsRefresher != null) settingsRefresher.run();
                return;
            }
            if ("msgTimeFmtSel".equals(key)) {
                if ("native".equals(value)) {
                    setOn("msgTimeEnh", false);
                    setStrCfg("msgTimeFmtEnh", "");
                } else {
                    setStrCfg("msgTimeFmtEnh", value);
                    setOn("msgTimeEnh", true);
                }
                toast("时间格式：" + ("native".equals(value) ? "跟原生" : value));
                if (settingsRefresher != null) settingsRefresher.run();
                reapplyNow();
                return;
            }
            if ("silentDays".equals(key)) {
                setIntCfg("silentDays", Integer.parseInt(value));
            } else {
                setStrCfg(key, value);
            }
            toast("已设置为：" + value);
            if (settingsRefresher != null) settingsRefresher.run();
        } catch (Throwable t) { log("OPT|err " + t); }
    }

    private static void showOptionDialog(final android.app.Activity a, String title,
                                         final String key, final String[][] opts) {
        try {
            String[] labels = new String[opts.length];
            for (int i = 0; i < opts.length; i++) labels[i] = opts[i][0];
            new android.app.AlertDialog.Builder(a)
                    .setTitle(title)
                    .setItems(labels, new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int which) {
                            applyOptionValue(a, key, opts[which][1]);
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) { log("OPT|dlg err " + t); }
    }

    private static String snsTimeFmtLabel(org.json.JSONObject c) {
        String p = c == null ? "" : c.optString("snsTimeFmt", "");
        if (p.length() == 0) return "跟原生";
        if ("h:mm".equals(p)) return "12 小时制";
        return p;
    }

    private static String timeFmtLabel(org.json.JSONObject c) {
        if (c == null || !c.optBoolean("msgTimeEnh", false)) return "跟原生";
        String p = c.optString("msgTimeFmtEnh", "");
        if (p.length() == 0) return "跟原生";
        if ("h:mm".equals(p)) return "12 小时制";
        return p;
    }

    private static String valueOfKey(org.json.JSONObject c, String key) {
        if ("msgTimeFmtSel".equals(key)) return timeFmtLabel(c);
        if ("snsTimeFmtSel".equals(key)) return snsTimeFmtLabel(c);
        if ("snsKeepAlive".equals(key)) return onOff(c.optBoolean("snsKeepAlive", false));
        if ("unrecall".equals(key)) return onOff(c.optBoolean("unrecallPlugin", true));
        if ("unrecallMark".equals(key)) return onOff(c.optBoolean("unrecallSysMsg", true));
        if ("white".equals(key)) return countOf(c, "unrecallOnly") + " 个会话";
        if ("keywords".equals(key)) return countOf(c, "keywordAlert") + " 个词";
        if ("redpacket".equals(key)) return onOff(c.optBoolean("redPacketAlert", true));
        if ("redpacketOpen".equals(key)) return onOff(c.optBoolean("autoGrabRedPacket", false));
        if ("groupChange".equals(key)) return onOff(c.optBoolean("groupAlert", true));
        if ("groupNotice".equals(key)) return onOff(c.optBoolean("groupNoticeAlert", true));
        if ("atMe".equals(key)) return onOff(c.optBoolean("atMeAlert", true));
        if ("groupQuiet".equals(key)) return onOff(c.optBoolean("groupQuiet", false));
        if ("noPat".equals(key)) return onOff(c.optBoolean("noPatAlert", false));
        if ("noSeenTip".equals(key)) return onOff(c.optBoolean("noSeenTip", true));
        if ("autoRemarkFmt".equals(key)) return autoRemarkFmt(c) + "（例：" + autoRemarkSample(c) + "）";
        if ("hideContacts".equals(key)) { String v0 = c.optString("hideContacts", ""); return v0.length() == 0 ? "未设置" : v0; }
        if ("blockMembers".equals(key)) return countCsv(c, "blockMembers") + " 人";
        if ("blockMode".equals(key)) return c.optBoolean("blockModeWhite", false) ? "只显示名单" : "黑名单";
        if ("filterLog".equals(key)) return onOff(c.optBoolean("filterLog", false));
        if ("viewFilterLog".equals(key) || "clearFilterLog".equals(key)
                || "dbProbe".equals(key)) return "";
        if ("filterTypes".equals(key)) return countCsv(c, "filterTypes") + " 类";
        if ("quiet".equals(key)) {
            return c.optInt("quietStart", -1) >= 0
                    ? c.optInt("quietStart", 23) + "点-" + c.optInt("quietEnd", 7) + "点" : "关";
        }
        if ("autoReply".equals(key)) {
            return c.optBoolean("autoReply", false) ? "开「" + c.optString("autoReplyText", "") + "」" : "关";
        }
        if ("closeFriends".equals(key)) return countOf(c, "closeFriends") + " 人" + previewOf(c, "closeFriends");
        if ("closeCenter".equals(key)) {
            String m = c.optString("closeAlertMode", "dlg");
            return ("banner".equals(m) ? "横幅" : ("off".equals(m) ? "静默" : "弹窗"))
                    + (c.optString("closeReply", "").length() > 0 ? "·有回复" : "");
        }
        if ("snsAutoFwd".equals(key)) {
            return (c.optBoolean("snsAutoForward", false) ? "开" : "关")
                    + "·" + countOf(c, "snsFwTargets") + " 目标";
        }
        if ("snsDbl".equals(key)) return onOff(c.optBoolean("snsDoubleTap", true));
        if ("snsLike".equals(key)) return onOff(c.optBoolean("snsAutoLike", false));
        if ("snsLikePick".equals(key)) return countOf(c, "snsLikeNames") + " 人" + previewOf(c, "snsLikeNames");
        if ("fakeLike".equals(key)) return onOff(c.optBoolean("fakeLike", false));
        if ("fakeLikeNames".equals(key)) return countOf(c, "fakeLikeNames") + " 人" + previewOf(c, "fakeLikeNames");
        if ("snsForward".equals(key)) return onOff(c.optBoolean("snsForward", false));
        if ("snsKw".equals(key)) return countOf(c, "snsHideKeywords") + " 个词";
        if ("snsHide".equals(key)) return countOf(c, "snsHideNames") + " 人";
        if ("chatTop".equals(key)) return onOff(c.optBoolean("chatDoubleTap", true));
        if ("rpkGroups".equals(key)) return countOf(c, "rpkGroups") + " 个群";
        if ("rpkMute".equals(key)) return onOff(c.optBoolean("rpkMute", false));
        if ("recallBackup".equals(key)) return onOff(c.optBoolean("recallBackup", true));
        if ("miyouBlockChat".equals(key)) return onOff(c.optBoolean("miyouBlockChat", true));
        if ("miyouBlockProfile".equals(key)) return onOff(c.optBoolean("miyouBlockProfile", true));
        if ("atCleanNewline".equals(key)) return onOff(c.optBoolean("atCleanNewline", false));
        if ("theme".equals(key)) return onOff(c.optBoolean("theme", true));
        if ("todayCount".equals(key)) return onOff(c.optBoolean("todayCount", true));
        if ("toolbarCompact".equals(key)) return onOff(c.optBoolean("toolbarCompact", true));
        if ("dice".equals(key)) return c.optInt("dice", 0) > 0 ? c.optInt("dice", 0) + " 点" : "关";
        if ("step".equals(key)) return c.optInt("stepCount", 0) > 0 ? c.optInt("stepCount", 0) + " 步" : "关";
        if ("loc".equals(key)) {
            double lat = c.optDouble("fakeLat", 0), lng = c.optDouble("fakeLng", 0);
            return (lat == 0 && lng == 0) ? "关" : lat + "," + lng;
        }
        if ("device".equals(key)) return onOff(c.optBoolean("deviceSpoof", false));
        if ("autoAccept".equals(key)) return onOff(c.optBoolean("autoAcceptFriend", false));
        if ("echoSilent".equals(key)) return onOff(c.optBoolean("echoSilent", true));
        if ("galleryOpen".equals(key) || "clearGallery".equals(key) || "selfCheck".equals(key)) return "";
        if ("textEditMode".equals(key)) return onOff(c.optBoolean("textEditMode", false))
                + "（" + countOf(c, "textReplace") + " 条）";
        if ("clearReplace".equals(key)) return countOf(c, "textReplace") + " 条";
        if ("export".equals(key)) return chatTalker == null ? "先打开聊天" : chatTalker;
        if ("nick".equals(key)) return c.optString("myNick", "").length() > 0 ? c.optString("myNick") : "未设置";
        if ("antiDelete".equals(key)) return onOff(c.optBoolean("antiDelete", true));
        if ("quickPhrases".equals(key)) return countOf(c, "quickPhrases") + " 条";
        if ("qpAutoSend".equals(key)) return onOff(c.optBoolean("qpAutoSend", true));
        if ("aiReply".equals(key)) return c.optString("aiKey", "").length() > 0 ? c.optString("aiModel", "已配置") : "未配置";
        if ("aiHistory".equals(key)) return countOf(c, "aiHistory") + " 条";
        if ("autoClean".equals(key)) return onOff(c.optBoolean("autoClean", false));
        if ("clearReadMarks".equals(key)) return "";
        if ("themeImport".equals(key) || "themeExport".equals(key)) return "";
        if ("bubbleTheme".equals(key)) return onOff(c.optBoolean("bubbleTheme", false));
        if ("bubbleDebug".equals(key)) return onOff(c.optBoolean("bubbleDebug", true));
        if ("bgProbe".equals(key)) return onOff(c.optBoolean("bgProbe", true));
        if ("bubbleMode".equals(key)) {
            int m = bubbleMode(c);
            return m == 1 ? "图片" : (m == 2 ? "纯色" : "关");
        }
        if ("bubbleColorLeft".equals(key)) return String.format("#%06X", c.optInt("bubbleColorLeft", 0xFFFFFFFF) & 0xFFFFFF);
        if ("bubbleColorRight".equals(key)) return String.format("#%06X", c.optInt("bubbleColorRight", 0xFF95EC69) & 0xFFFFFF);
        if ("bubbleTimeColor".equals(key)) return String.format("#%06X", c.optInt("bubbleTimeColor", 0xFFFFFFFF) & 0xFFFFFF);
        if ("bubbleTextColorLeft".equals(key)) {
            int d = autoTextOn(c.optInt("bubbleColorRight", 0xFF95EC69));
            return String.format("#%06X", c.optInt("bubbleTextColorLeft", d) & 0xFFFFFF);
        }
        if ("bubbleTextColorRight".equals(key)) {
            int d = autoTextOn(c.optInt("bubbleColorLeft", 0xFFFFFFFF));
            return String.format("#%06X", c.optInt("bubbleTextColorRight", d) & 0xFFFFFF);
        }
        if ("thRoundAvatar".equals(key)) return onOff(c.optBoolean("thRoundAvatar", true));
        if ("bubbleSkin".equals(key)) return onOff(bubbleSkinStyle() != 0);
        if ("thHideTabLabel".equals(key)) return onOff(c.optBoolean("thHideTabLabel", false));
        if ("thTint".equals(key)) return "";
        if ("groupLog".equals(key)) return "";
        if ("msgStats".equals(key)) return "";
        if ("autoReplyOnly".equals(key)) return countOf(c, "autoReplyOnly") + " 个";
        if ("autoReplyDelay".equals(key)) return c.optInt("autoReplyDelay", 0) + " 秒";
        if ("autoCleanMb".equals(key)) return c.optInt("autoCleanMb", 300) + " MB";
        if ("notifyBlockKw".equals(key)) return countOf(c, "notifyBlockKw") + " 个词";
        if ("groupOnlyKw".equals(key)) return countOf(c, "groupOnlyKw") + " 个词";
        if ("schedSend".equals(key)) {
            org.json.JSONArray sa = c.optJSONArray("schedMsgs");
            int n2 = sa == null ? 0 : sa.length();
            return n2 == 0 ? "无任务" : n2 + " 个任务";
        }
        if ("exportFriends".equals(key) || "searchMsg".equals(key)
                || "exportGroupMembers".equals(key) || "exportMedia".equals(key)
                || "exportHtml".equals(key) || "cacheInfo".equals(key) || "groupRank".equals(key)
                || "cleanCache".equals(key) || "exportAll".equals(key) || "groupHub".equals(key)
                || "blast".equals(key)) return "";
        if ("scan".equals(key) || "status".equals(key) || "reset".equals(key)
                || "unrecallLog".equals(key) || "alertLog".equals(key) || "pktrec".equals(key)
                || "emojiPanel".equals(key)) return "";
        // 兜底：配置里就是布尔/数字的，直接显示状态，避免出现「右边空白」
        try {
            Object gv = c.opt(key);
            if (gv instanceof Boolean) return onOff((Boolean) gv);
            if (gv instanceof Number) return String.valueOf(gv);
        } catch (Throwable ignore) { }
        return "";
    }

    private static String[] buildSettingItems() {
        String[] out = new String[SETTINGS.length];
        org.json.JSONObject c = cfg();
        for (int i = 0; i < SETTINGS.length; i++) {
            String v = valueOfKey(c, SETTINGS[i][0]);
            out[i] = SETTINGS[i][1] + "：" + v;
        }
        return out;
    }

    private static Runnable settingsRefresher = null;

    private static android.graphics.drawable.GradientDrawable roundRect(int color, float radius) {
        return roundRectB(color, radius, 0, 0);
    }

    private static android.graphics.drawable.GradientDrawable roundRectB(int color, float radius, int stroke, float sw) {
        android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
        g.setColor(color);
        g.setCornerRadius(radius);
        if (stroke != 0) {
            try { g.setStroke((int) (sw <= 0 ? 1 : sw), stroke); } catch (Throwable ignore) { }
        }
        return g;
    }

    /** 科技感卡片：实底 + 主题红细描边（取代原来的磨砂玻璃/半透明层） */
    private static android.graphics.drawable.GradientDrawable techCard(int fill, int stroke,
                                                                        float radiusPx, float strokeW) {
        android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
        g.setColor(fill);
        g.setCornerRadius(radiusPx);
        if (strokeW > 0) g.setStroke((int) strokeW, stroke);
        return g;
    }

    /** 弹窗统一背景：主题背景图 + 半透明浅色蒙层 */
    private static android.graphics.Bitmap backdropImage() {
        ensureModuleBg();
        try {
            java.io.File uf = new java.io.File(DIR, "wxh_hub_bg.jpg");
            if (uf.isFile()) {
                android.graphics.Bitmap ub = android.graphics.BitmapFactory.decodeFile(uf.getAbsolutePath());
                if (ub != null) return ub;
            }
        } catch (Throwable ignore) { }
        try {
            String p = themeBg("MainFragmentBackground");
            if (p != null) {
                java.io.File f = new java.io.File(p);
                if (f.isFile()) {
                    android.graphics.Bitmap b = android.graphics.BitmapFactory.decodeFile(f.getAbsolutePath());
                    if (b != null) return b;
                }
            }
        } catch (Throwable ignore) { }
        try {
            java.io.File hf = new java.io.File(DIR, "wxh_hub_header.jpg");
            if (hf.isFile()) return android.graphics.BitmapFactory.decodeFile(hf.getAbsolutePath());
        } catch (Throwable ignore) { }
        return null;
    }

    private static boolean bgChecked = false;

    /** 把模块 APK 里的 assets/ui_bg.jpg（已做磨砂的蜘蛛侠壁纸）释放到微信私有目录，每个进程只做一次 */
    private static void ensureModuleBg() {
        if (bgChecked) return;
        bgChecked = true;
        try {
            java.io.File f = new java.io.File(DIR, "wxh_hub_bg.jpg");
            android.content.Context c = ctxAny();
            if (c == null) return;
            String apk = c.getPackageManager()
                    .getApplicationInfo("com.h.module", 0).sourceDir;
            java.util.zip.ZipFile z = new java.util.zip.ZipFile(apk);
            java.util.zip.ZipEntry e = z.getEntry("assets/ui_bg.jpg");
            if (e == null) { z.close(); log("UIBG|asset missing"); return; }
            java.io.File tmp = new java.io.File(DIR, "wxh_hub_bg.tmp");
            java.io.InputStream in = z.getInputStream(e);
            java.io.FileOutputStream out = new java.io.FileOutputStream(tmp);
            byte[] buf = new byte[8192];
            int n;
            while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
            out.flush(); out.close(); in.close(); z.close();
            if (tmp.length() > 4096) {
                if (f.exists()) f.delete();
                if (!tmp.renameTo(f)) { tmp.delete(); }
            } else { tmp.delete(); }
            log("UIBG|ready " + f.length() + " B");
        } catch (Throwable t) { log("UIBG|err " + t); }
    }

    private static boolean bubbleAssetsDone = false;

    /** 把模块 APK 里的蜘蛛侠气泡图释放到 files/wxh_bubble/ */
    private static void ensureBubbleAssets() {
        if (bubbleAssetsDone) return;
        bubbleAssetsDone = true;
        try {
            android.content.Context c = ctxAny();
            if (c == null) { bubbleAssetsDone = false; return; }
            String apk = c.getPackageManager().getApplicationInfo("com.h.module", 0).sourceDir;
            java.util.zip.ZipFile z = new java.util.zip.ZipFile(apk);
            java.io.File dir = new java.io.File(DIR, "wxh_bubble");
            if (!dir.exists()) dir.mkdirs();
            for (String[] pair : new String[][]{{"assets/bubble/left.png", "left.png"},
                    {"assets/bubble/right.png", "right.png"}}) {
                java.io.File out0 = new java.io.File(dir, pair[1]);
                if (out0.exists() && out0.length() > 300) continue;
                java.util.zip.ZipEntry e = z.getEntry(pair[0]);
                if (e == null) continue;
                java.io.InputStream in = z.getInputStream(e);
                java.io.FileOutputStream fo = new java.io.FileOutputStream(out0);
                byte[] buf = new byte[8192];
                int n;
                while ((n = in.read(buf)) > 0) fo.write(buf, 0, n);
                fo.flush(); fo.close(); in.close();
            }
            z.close();
            log("BUBASSET|ready " + new java.io.File(dir, "left.png").length());
        } catch (Throwable t) { log("BUBASSET|err " + t); }
    }

    /** 统一卡片底：实底 + 主题红描边，不再做磨砂/半透明 */
    private static android.graphics.drawable.Drawable glassDrawable(android.content.Context c, float rDp) {
        float d = c.getResources().getDisplayMetrics().density;
        return techCard(0xF7FFFFFF, 0x55E2231A, rDp * d, 1.2f * d);
    }

    /** 磨砂玻璃底：主题图居中裁满 + 半透明白色磨砂层 + 主题红细描边 */
    static class GlassBg extends android.graphics.drawable.Drawable {
        private final android.graphics.Bitmap bmp;
        private final android.graphics.BitmapShader shader;
        private final android.graphics.Paint imgPaint = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
        private final android.graphics.Paint scrimPaint = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
        private final android.graphics.Paint rimPaint = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
        private final android.graphics.RectF rf = new android.graphics.RectF();
        private final android.graphics.Matrix mx = new android.graphics.Matrix();
        private final android.graphics.Path clipPath = new android.graphics.Path();
        private final float radius;
        private int pct = 255;

        GlassBg(android.graphics.Bitmap b, int scrimColor, float radiusPx, int rimColor, float rimW) {
            bmp = b;
            shader = new android.graphics.BitmapShader(b,
                    android.graphics.Shader.TileMode.CLAMP, android.graphics.Shader.TileMode.CLAMP);
            imgPaint.setShader(shader);
            scrimPaint.setColor(scrimColor);
            rimPaint.setStyle(android.graphics.Paint.Style.STROKE);
            rimPaint.setColor(rimColor);
            rimPaint.setStrokeWidth(rimW);
            radius = radiusPx;
        }

        @Override protected void onBoundsChange(android.graphics.Rect b) {
            super.onBoundsChange(b);
            try {
                if (b.width() <= 0 || b.height() <= 0 || bmp == null) return;
                float sc = Math.max(b.width() / (float) bmp.getWidth(), b.height() / (float) bmp.getHeight());
                mx.reset();
                mx.setScale(sc, sc);
                mx.postTranslate((b.width() - bmp.getWidth() * sc) / 2f,
                        (b.height() - bmp.getHeight() * sc) / 2f);
                shader.setLocalMatrix(mx);
            } catch (Throwable ignore) { }
        }

        @Override public void draw(android.graphics.Canvas c) {
            rf.set(getBounds());
            float r = Math.min(radius, Math.min(rf.width(), rf.height()) / 2f);
            clipPath.reset();
            clipPath.addRoundRect(rf, r, r, android.graphics.Path.Direction.CW);
            int save = c.save();
            try {
                c.clipPath(clipPath);
                c.drawRect(rf, imgPaint);
                c.drawRect(rf, scrimPaint);
            } finally { c.restoreToCount(save); }
            try {
                float hw = rimPaint.getStrokeWidth() / 2f;
                rf.inset(hw, hw);
                clipPath.reset();
                clipPath.addRoundRect(rf, r, r, android.graphics.Path.Direction.CW);
                c.drawPath(clipPath, rimPaint);
            } catch (Throwable ignore) { }
        }

        @Override public void setAlpha(int a) {
            pct = a;
            imgPaint.setAlpha(a);
            scrimPaint.setAlpha(a);
            rimPaint.setAlpha(a);
            invalidateSelf();
        }

        @Override public void setColorFilter(android.graphics.ColorFilter cf) {
            imgPaint.setColorFilter(cf);
            invalidateSelf();
        }

        @Override public int getOpacity() { return android.graphics.PixelFormat.TRANSLUCENT; }
    }

    private static android.widget.FrameLayout withBackdrop(android.app.Activity a, android.view.View content,
                                                           int scrimColor, float radiusPx) {
        android.widget.FrameLayout shell = new android.widget.FrameLayout(a);
        android.graphics.Bitmap bm = backdropImage();
        if (bm != null) {
            android.widget.ImageView iv = new android.widget.ImageView(a);
            iv.setScaleType(android.widget.ImageView.ScaleType.CENTER_CROP);
            iv.setImageBitmap(bm);
            shell.addView(iv, new android.widget.FrameLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, android.view.ViewGroup.LayoutParams.MATCH_PARENT));
        }
        if (scrimColor != 0) {
            android.view.View sc = new android.view.View(a);
            sc.setBackground(roundRect(scrimColor, radiusPx));
            shell.addView(sc, new android.widget.FrameLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, android.view.ViewGroup.LayoutParams.MATCH_PARENT));
        }
        shell.addView(content, new android.widget.FrameLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.MATCH_PARENT, android.view.ViewGroup.LayoutParams.MATCH_PARENT));
        android.graphics.drawable.GradientDrawable clip = new android.graphics.drawable.GradientDrawable();
        clip.setColor(0x00000000);
        clip.setCornerRadius(radiusPx);
        shell.setBackground(clip);
        shell.setClipToOutline(true);
        return shell;
    }

