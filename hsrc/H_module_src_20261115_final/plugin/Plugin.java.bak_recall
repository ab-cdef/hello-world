    private static void pickSenderAndExport(final android.app.Activity a, final String talker) {
        final java.util.List<Object[]> snd = recentSenders(talker);
        final java.util.List<String> labels = new java.util.ArrayList<String>();
        final java.util.List<String> ids = new java.util.ArrayList<String>();
        labels.add("我发的消息"); ids.add("__me__");
        for (Object[] r : snd) {
            String uid = String.valueOf(r[0]);
            labels.add(displayOfTalker(uid) + "（" + r[1] + " 条）");
            ids.add(uid);
        }
        new android.app.AlertDialog.Builder(a)
                .setTitle("导出谁的消息")
                .setItems(labels.toArray(new String[labels.size()]),
                        new android.content.DialogInterface.OnClickListener() {
                            @Override public void onClick(android.content.DialogInterface d, int which) {
                                final String sid = ids.get(which);
                                final String who = labels.get(which);
                                toast("导出中…");
                                new Thread(new Runnable() { @Override public void run() {
                                    final int n = exportBySender(talker, sid, who);
                                    new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                                        @Override public void run() { toast("已导出 " + n + " 条"); }
                                    });
                                } }).start();
                            }
                        })
                .setNegativeButton("取消", null)
                .show();
    }

    /** 导出某人在某会话里的消息（sid="__me__" 表示我发的） */
    private static int exportBySender(String talker, String sid, String whoLabel) {
        int n = 0;
        try {
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            String safeWho = (whoLabel == null ? "记录" : whoLabel).replaceAll("[\\/:*?\"<>|（(].*", "").trim();
            if (safeWho.length() == 0) safeWho = "记录";
            java.io.File f = new java.io.File(dir, "bydy_" + csv(displayOfTalker(talker)) + "_" + csv(safeWho)
                    + "_" + stamp + ".csv");
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            fw.write("\uFEFF时间,发送人,内容\n");
            boolean mine = "__me__".equals(sid);
            java.util.List<Object[]> rows = queryRows(
                    "select createTime, ifnull(content,''), ifnull(type,1), ifnull(isSend,0) from message where talker='"
                            + escSql(talker) + "' order by createTime asc limit 5000", 4);
            for (Object[] r : rows) {
                long ct = 0;
                try { ct = Long.parseLong(String.valueOf(r[0]).trim()); } catch (Throwable ignore) { }
                if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                boolean isMine = "1".equals(String.valueOf(r[3]).trim());
                String content = String.valueOf(r[1]);
                String thisSid = isMine ? "__me__" : senderIdOfGroupMsg(content);
                if (!mine && (thisSid == null || !thisSid.equals(sid))) continue;
                if (mine && !isMine) continue;
                int tp = 1;
                try { tp = Integer.parseInt(String.valueOf(r[2]).trim()) & 0xFFFF; } catch (Throwable ignore) { }
                if (tp == 10000 || tp == 10002) continue;      // 系统提示不算"我说的话"
                String body = content;
                if (tp != 1) body = "[" + typeLabel(tp) + "]";
                else {
                    int p1 = content.indexOf(":\n");
                    if (p1 > 0 && p1 < 40) body = content.substring(p1 + 2);
                    if (body.startsWith("<")) body = "[非文本]";
                }
                fw.write(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss", java.util.Locale.US)
                        .format(new java.util.Date(ct)) + "," + csv(isMine ? "我" : displayOfTalker(thisSid))
                        + "," + csv(body) + "\n");
                n++;
            }
            fw.close();
            askShare(f);
            log("BYSENDER|talker=" + talker + " who=" + sid + " n=" + n + " path=" + f.getAbsolutePath());
        } catch (Throwable t) {
            log("BYSENDER|err " + t);
        }
        return n;
    }

    /** 从备注/昵称里找 MM-DD 或 M月D日，返回 {月, 日}；找不到返回 null */
    private static int[] parseBirthday(String text) {
        if (text == null) return null;
        try {
            java.util.regex.Matcher m1 = java.util.regex.Pattern
                    .compile("(\\d{1,2})\\s*[-/月]\\s*(\\d{1,2})").matcher(text);
            while (m1.find()) {
                int mo = Integer.parseInt(m1.group(1));
                int d = Integer.parseInt(m1.group(2));
                if (mo >= 1 && mo <= 12 && d >= 1 && d <= 31) return new int[]{mo, d};
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 扫描全部好友备注里的生日，返回 {昵称, 备注, MM-DD, 还有几天} */
    private static java.util.List<String[]> birthdayScan(int daysAhead) {
        java.util.List<String[]> out = new java.util.ArrayList<String[]>();
        try {
            java.util.Calendar now = java.util.Calendar.getInstance();
            int todayDoy = now.get(java.util.Calendar.DAY_OF_YEAR);
            int year = now.get(java.util.Calendar.YEAR);
            java.util.List<Object[]> rows = queryRows(
                    "select ifnull(nickname,''), ifnull(conRemark,'') from rcontact"
                            + " where (type & 1) != 0 and (ifnull(conRemark,'') <> '' or ifnull(nickname,'') <> '')"
                            + " limit 3000", 2);
            for (Object[] r : rows) {
                String nick = String.valueOf(r[0]);
                String remark = String.valueOf(r[1]);
                int[] bd = parseBirthday(remark);
                if (bd == null) bd = parseBirthday(nick);
                if (bd == null) continue;
                int[] days = new int[1];
                int diff = -1;
                try {
                    java.util.Calendar c = java.util.Calendar.getInstance();
                    c.set(java.util.Calendar.YEAR, year);
                    c.set(java.util.Calendar.MONTH, bd[0] - 1);
                    c.set(java.util.Calendar.DAY_OF_MONTH, bd[1]);
                    int doy = c.get(java.util.Calendar.DAY_OF_YEAR);
                    diff = doy - todayDoy;
                    if (diff < 0) {                      // 已过 → 明年
                        c.set(java.util.Calendar.YEAR, year + 1);
                        diff = c.get(java.util.Calendar.DAY_OF_YEAR) + (365 - todayDoy + 1) - 1;
                        diff = (int) ((c.getTimeInMillis() - now.getTimeInMillis()) / 86400000L);
                    }
                } catch (Throwable ignore) { }
                if (diff < 0 || diff > daysAhead) continue;
                out.add(new String[]{nick, remark,
                        String.format(java.util.Locale.US, "%02d-%02d", bd[0], bd[1]),
                        String.valueOf(diff)});
            }
            java.util.Collections.sort(out, new java.util.Comparator<String[]>() {
                @Override public int compare(String[] a, String[] b) {
                    return Integer.parseInt(a[3]) - Integer.parseInt(b[3]);
                }
            });
        } catch (Throwable t) {
            log("BDAY|scan err " + t);
        }
        return out;
    }

    /** 聊天列表右下角的生日悬浮球：显示近期生日人数，点开面板 */
    private static int bdayCount = -1;   // 近期生日人数缓存；-1=还没算
    private static java.lang.ref.WeakReference<android.app.Activity> bdayActRef = null;

    /** 每 500ms 看一次当前 tab：不在「聊天」页就把生日球藏起来（微信切 tab 不走 setCurrentItem 时也稳） */
    private static boolean bdayWatchStarted = false;

    private static void startBdayWatch() {
        if (bdayWatchStarted) return;
        bdayWatchStarted = true;
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        h.postDelayed(new Runnable() {
            @Override public void run() {
                boolean again = true;
                try {
                    android.app.Activity a = bdayActRef == null ? null : bdayActRef.get();
                    if (a == null || a.isFinishing()) { again = false; }
                    else {
                        android.view.View decor = a.getWindow().getDecorView();
                        android.view.View pill = decor.findViewWithTag("wxhBdayPill");
                        boolean on = cfg().optBoolean("bdayFloat", true);
                        int tab = bdayTabIndex(a);
                        if (pill == null) {
                            if (on && tab == 0) ensureBdayPill(a);   // 回到聊天页再补回来
                        } else {
                            int want = (!on || tab != 0 || bdayCount == 0)
                                    ? android.view.View.GONE : android.view.View.VISIBLE;
                            if (pill.getVisibility() != want) pill.setVisibility(want);
                        }
                    }
                } catch (Throwable ignore) { }
                if (again) h.postDelayed(this, 500);
                else bdayWatchStarted = false;
            }
        }, 500);
    }

    private static void ensureBdayPill(final android.app.Activity act) {
        try {
            if (act == null) return;
            bdayActRef = new java.lang.ref.WeakReference<android.app.Activity>(act);
            startBdayWatch();
            final android.view.View decor = act.getWindow().getDecorView();
            if (!(decor instanceof android.view.ViewGroup)) return;
            android.view.View exist = decor.findViewWithTag("wxhBdayPill");
            if (!cfg().optBoolean("bdayFloat", true)) {
                if (exist != null) ((android.view.ViewGroup) exist.getParent()).removeView(exist);
                return;
            }
            // 生日球只在微信「聊天」首页显示；切到通讯录/发现/我就藏起来
            if (bdayTabIndex(act) != 0) {
                if (exist != null) exist.setVisibility(android.view.View.GONE);
                return;
            }
            if (exist != null) {
                exist.setVisibility(bdayCount == 0 ? android.view.View.GONE : android.view.View.VISIBLE);
                return;
            }

            final android.widget.TextView pill = new android.widget.TextView(act);
            pill.setTag("wxhBdayPill");
            pill.setTextSize(12);
            pill.setTextColor(0xFFFFFFFF);
            pill.setGravity(android.view.Gravity.CENTER);
            android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
            bg.setColor(0xF207C160);
            bg.setCornerRadius(dp(act, 20));
            pill.setBackground(bg);
            pill.setPadding(dp(act, 12), dp(act, 6), dp(act, 12), dp(act, 6));
            pill.setText("生日");
            pill.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    try { showBirthday(act); } catch (Throwable t) { toast("打开失败"); }
                }
            });

            android.widget.FrameLayout.LayoutParams lp = new android.widget.FrameLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
            lp.gravity = android.view.Gravity.BOTTOM | android.view.Gravity.END;
            lp.rightMargin = dp(act, 14);
            lp.bottomMargin = dp(act, 96);
            ((android.view.ViewGroup) decor).addView(pill, lp);
            log("BDAY|pill added");

            // 异步统计人数，回来再改文字
            new Thread(new Runnable() {
                @Override public void run() {
                    final int n;
                    try { n = birthdayScan(bdayRange()).size(); } catch (Throwable t) { return; }
                    bdayCount = n;
                    act.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            try {
                                if (n <= 0) {
                                    pill.setVisibility(android.view.View.GONE);
                                } else {
                                    pill.setText("\uD83C\uDF82 " + n);
                                    pill.setVisibility(bdayTabIndex(act) == 0
                                            ? android.view.View.VISIBLE : android.view.View.GONE);
                                }
                            } catch (Throwable ignore) { }
                        }
                    });
                }
            }).start();
        } catch (Throwable t) {
            log("BDAY|pill err " + t);
        }
    }

    /** 生日提醒面板：范围 / 每天提醒 / 时间 / 名单 */
