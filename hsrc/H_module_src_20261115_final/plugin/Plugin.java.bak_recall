    private static void grabNow(final String talker, final String content) {
        try {
            log("GRAB|now start");
            final String nu = grabNativeUrl(content);
            if (nu == null) { log("GRAB|now no nativeurl"); return; }
            final String key = nuKey(nu);
            if (grabTried.contains(key)) { log("GRAB|now tried before"); return; }
            grabTried.add(key);
            markGrabTried(key);
            final android.content.Context ctx = ctxAny();
            log("GRAB|now ctx=" + (ctx == null ? "null" : ctx.getClass().getSimpleName()));
            if (ctx == null) return;
            new Handler(Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() {
                    boolean ok = openLuckyMoneyDirect(ctx, nu, talker);
                    log("GRAB|now open ok=" + ok);
                }
            }, grabDelayMs());
        } catch (Throwable t) { log("GRAB|now err " + t); }
    }

    /** 从红包消息 XML 里取 nativeurl */
    private static String grabNativeUrl(String content) {
        try {
            if (content == null) return null;
            String v = cleanXmlText(tagOf(content, "nativeurl"));
            if (v != null && v.length() > 10) return v;
            return null;
        } catch (Throwable t) { return null; }
    }

    /** 直接拉起领取页（微信内部 API；比点聊天里的气泡可靠） */
    private static boolean openLuckyMoneyDirect(android.content.Context ctx, String nativeurl, String talker) {
        try {
            if (ctx == null || nativeurl == null) return false;
            android.content.Intent it = new android.content.Intent();
            it.putExtra("key_native_url", nativeurl);
            if (talker != null) it.putExtra("key_username", talker);
            // 后台没有 Activity 上下文时必须带 NEW_TASK，否则 startActivity 会抛异常
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
            String[] classes = {"nk4.l", "oq4.l", "pn4.l", "qm4.l", "rm4.l", "sm4.l",
                    "tm4.l", "um4.l", "vm4.l", "wl4.l"};
            String[] methods = {"A", "B", "C", "D"};
            String[] acts = {".ui.LuckyMoneyNewReceiveUI", ".ui.LuckyMoneyNotHookReceiveUI",
                    ".ui.LuckyMoneyReceiveUI"};
            for (String cn : classes) {
                Class<?> c;
                try { c = Class.forName(cn, false, appCl); } catch (Throwable e) { continue; }
                for (String mn : methods) {
                    for (String an : acts) {
                        try {
                            java.lang.reflect.Method m = c.getDeclaredMethod(mn,
                                    android.content.Context.class, String.class, String.class,
                                    android.content.Intent.class);
                            m.setAccessible(true);
                            m.invoke(null, ctx, "luckymoney", an, it);
                            log("GRAB|open via " + cn + "." + mn + " " + an);
                            return true;
                        } catch (Throwable ignore) { }
                    }
                }
            }
            // 降级：直接 startActivity
            for (String an : acts) {
                try {
                    android.content.Intent it2 = new android.content.Intent(it);
                    it2.setClassName(ctx.getPackageName(), "com.tencent.mm.plugin.luckymoney" + an);
                    it2.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
                    ctx.startActivity(it2);
                    log("GRAB|open fallback " + an);
                    return true;
                } catch (Throwable ignore) { }
            }
        } catch (Throwable t) { log("GRAB|open err " + t); }
        return false;
    }

    /** 从 Activity 字段里找「開」按钮并 performClick（微信自绘按钮只认这个） */
    private static boolean clickOpenByField(android.app.Activity a) {
        try {
            if (a == null) return false;
            Class<?> c = a.getClass();
            int depth = 0;
            while (c != null && c != Object.class && depth++ < 6) {
                for (java.lang.reflect.Field f : c.getDeclaredFields()) {
                    try {
                        f.setAccessible(true);
                        Object o = f.get(a);
                        if (!(o instanceof android.widget.Button)) continue;
                        android.widget.Button b = (android.widget.Button) o;
                        if (b == null || b.getVisibility() != android.view.View.VISIBLE) continue;
                        CharSequence cs = b.getText();
                        String t = cs == null ? "" : cs.toString().trim();
                        boolean hit = t.length() == 0 || t.contains("開") || t.contains("开")
                                || t.contains("拆") || t.contains("领取");
                        if (!hit) continue;
                        b.setEnabled(true);
                        b.performClick();
                        log("AUTOGRAB|field " + f.getName() + " text=[" + t + "]");
                        return true;
                    } catch (Throwable ignore) { }
                }
                c = c.getSuperclass();
            }
        } catch (Throwable t) { log("AUTOGRAB|fieldScan err " + t); }
        return false;
    }

    /** 抢完自动关掉领取页 */
    private static void autoClosePacket(final android.app.Activity a) {
        try {
            if (a == null) return;
            if (!cfg().optBoolean("grabAutoClose", true)) { log("AUTOGRAB|close off"); return; }
            new Handler(Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        String cn2 = a.getClass().getName();
                        if (a.isFinishing()) { log("AUTOGRAB|already closed"); return; }
                        if (cn2.contains("LuckyMoney")) {
                            a.finish();
                            log("AUTOGRAB|closed " + cn2.substring(cn2.lastIndexOf('.') + 1));
                        } else {
                            // 页面内弹层：确认屏幕上还有红包界面，才发返回键
                            android.view.View dec = a.getWindow().getDecorView();
                            boolean lm = findContains(dec, "恭喜发财") != null
                                    || findContains(dec, "開") != null
                                    || findContains(dec, "已领取") != null
                                    || findContains(dec, "已存入") != null;
                            // 弹层不主动发返回键：容易把聊天页一起退掉，交给微信自己收
                            log(lm ? "AUTOGRAB|lm layer, skip back" : "AUTOGRAB|no lm ui, keep");
                        }
                    } catch (Throwable t) { log("AUTOGRAB|close err " + t); }
                }
            }, 1200L);
        } catch (Throwable ignore) { }
    }

    /** 红包页面自动点「开」 */
    private static final java.util.WeakHashMap<Object, Boolean> grabHandled =
            new java.util.WeakHashMap<Object, Boolean>();

    private static void installAutoGrab(ClassLoader app) {
        try {
            String[] uis = {
                    "com.tencent.mm.plugin.luckymoney.ui.LuckyMoneyNewReceiveUI",
                    "com.tencent.mm.plugin.luckymoney.ui.LuckyMoneyReceiveUI",
                    "com.tencent.mm.plugin.luckymoney.ui.LuckyMoneyNewYearReceiveUI",
                    "com.tencent.mm.plugin.luckymoney.ui.LuckyMoneyBusiReceiveUI",
                    "com.tencent.mm.plugin.luckymoney.ui.LuckyMoneyNotHookReceiveUI",
                    "com.tencent.mm.plugin.luckymoney.ui.LuckyMoneyNewYearReceiveUIV2",
                    "com.tencent.mm.plugin.luckymoney.ui.LuckyMoneyBusiReceiveUIV2",
                    "com.tencent.mm.plugin.luckymoney.ui.LuckyMoneyNewYearStateReceiveUI",
                    "com.tencent.mm.plugin.luckymoney.ui.LuckyMoneyReceiveUIV2",
                    "com.tencent.mm.plugin.luckymoney.appbrand.ui.receive.WxaLuckyMoneyReceiveUI",
            };
            int n = 0;
            for (String cn : uis) {
                try {
                    Class<?> c = Class.forName(cn, false, app);
                    XC_MethodHook h = new XC_MethodHook() {
                        @Override protected void afterHookedMethod(MethodHookParam p) {
                            try {
                                if (!cfg().optBoolean("autoGrabRedPacket", false)) return;
                                final Object act = p.thisObject;
                                if (!(act instanceof android.app.Activity)) return;
                                // 一次性守卫：同一个领取页只处理一次，绝不重试
                                synchronized (grabHandled) {
                                    if (grabHandled.containsKey(act)) return;
                                    grabHandled.put(act, Boolean.TRUE);
                                }
                                final android.app.Activity a = (android.app.Activity) act;
                                new Handler(Looper.getMainLooper()).postDelayed(new Runnable() {
                                    @Override public void run() {
                                        try {
                                            boolean ok = clickOpenByField(a);
                                            log("AUTOGRAB|once ok=" + ok);
                                            autoClosePacket(a);
                                        } catch (Throwable t) { log("AUTOGRAB|once err " + t); }
                                    }
                                }, 400L);
                            } catch (Throwable ignore) { }
                        }
                    };
                    try { XposedBridge.hookAllMethods(c, "initView", h); } catch (Throwable ignore) { }
                    try { XposedBridge.hookAllMethods(c, "onCreate", h); } catch (Throwable ignore) { }
                    try { XposedBridge.hookAllMethods(c, "onResume", h); } catch (Throwable ignore) { }
                    n++;
                } catch (Throwable ignore) { }
            }
            log("auto grab uis=" + n);
            try { installZombieProbe(app); } catch (Throwable ignore) { }
            startBgGrabPulse();
            try { startPcLoginWatch(null); } catch (Throwable ignore) { }
            try { startRemindPulse(); } catch (Throwable ignore) { }
            // 自绘菜单已在用，贴层方案停用（避免重复显示）
            // try { startPlusMenuWatch(); } catch (Throwable ignore) { }
        } catch (Throwable t) {
            log("installAutoGrab err " + t);
        }
    }

    /** 只发给目标控件的点击，避免触发全局手势 */
    private static void tapView(View v) {
        try {
            if (v == null || v.getWidth() <= 0) return;
            float x = v.getWidth() / 2f;
            float y = v.getHeight() / 2f;
            long t = android.os.SystemClock.uptimeMillis();
            android.view.MotionEvent down = android.view.MotionEvent.obtain(t, t, android.view.MotionEvent.ACTION_DOWN, x, y, 0);
            android.view.MotionEvent up = android.view.MotionEvent.obtain(t, t + 50, android.view.MotionEvent.ACTION_UP, x, y, 0);
            View target = v;
            if (!v.isClickable()) {
                android.view.ViewParent pr = v.getParent();
                int guard = 0;
                while (pr instanceof View && guard++ < 6) {
                    View pv = (View) pr;
                    if (pv.isClickable()) {
                        target = pv;
                        down.setLocation(pv.getWidth() / 2f, pv.getHeight() / 2f);
                        up.setLocation(pv.getWidth() / 2f, pv.getHeight() / 2f);
                        break;
                    }
                    pr = pv.getParent();
                }
            }
            target.dispatchTouchEvent(down);
            target.dispatchTouchEvent(up);
            down.recycle();
            up.recycle();
            log("TAP|" + target.getClass().getName() + "|clickable=" + target.isClickable());
        } catch (Throwable t) {
            log("tapView err " + t);
        }
    }

    /** 扫描当前聊天里未领取的红包并依次点开 */
    /** 按分钟算 since，自己判断库里的时间单位 */
    private static long sinceForWindow(int minutes) {
        long maxCt = 0;
        try {
            java.util.List<Object[]> mx = queryViaHandle("select max(createTime) from message", 1);
            if (!mx.isEmpty() && mx.get(0)[0] != null) {
                maxCt = Long.parseLong(String.valueOf(mx.get(0)[0]).trim());
            }
        } catch (Throwable ignore) { }
        long now = System.currentTimeMillis();
        long delta = minutes * 60L * 1000L;
        return maxCt > 100000000000L ? (now - delta) : ((now - delta) / 1000L);
    }

    /** 记录已经尝试过的红包（nativeurl 的短哈希），落盘避免重启后重复弹 */
    private static final java.util.HashSet<String> grabTried = new java.util.HashSet<String>();
    private static final java.util.HashMap<String, Long> claimAt = new java.util.HashMap<String, Long>();
    private static volatile boolean bgBusy = false;
    private static volatile long bgScanAt = 0;

    private static String nuKey(String nu) {
        try {
            java.security.MessageDigest md = java.security.MessageDigest.getInstance("MD5");
            byte[] d = md.digest(nu.getBytes("UTF-8"));
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < 8; i++) sb.append(String.format(java.util.Locale.US, "%02x", d[i] & 0xff));
            return sb.toString();
        } catch (Throwable t) { return String.valueOf(nu.hashCode()); }
    }

    private static void loadGrabTried() {
        try {
            if (!grabTried.isEmpty()) return;
            java.io.File f = new java.io.File(DIR, "grab_tried.txt");
            if (!f.isFile()) return;
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            String line;
            while ((line = br.readLine()) != null) {
                String v = line.trim();
                if (v.length() > 0) grabTried.add(v);
            }
            br.close();
            log("GRAB|tried loaded=" + grabTried.size());
        } catch (Throwable ignore) { }
    }

    private static void markGrabTried(String key) {
        try {
            grabTried.add(key);
            if (grabTried.size() > 2000) grabTried.clear();
            java.io.FileWriter fw = new java.io.FileWriter(new java.io.File(DIR, "grab_tried.txt"), true);
            fw.write(key + "\n");
            fw.close();
        } catch (Throwable ignore) { }
    }

    /* ================= 后台补抢（不进群也扫） ================= */

    private static Handler bgGrabH = null;

    private static void startRemindPulse() {
        try {
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            h.postDelayed(new Runnable() {
                @Override public void run() {
                    try { maybeFireReminds(); } catch (Throwable ignore) { }
                    try { h.postDelayed(this, 60000L); } catch (Throwable ignore) { }
                }
            }, 20000L);
            log("REMIND|pulse started");
        } catch (Throwable ignore) { }
    }

    private static void startBgGrabPulse() {
        try {
            if (bgGrabH != null) return;
            bgGrabH = new Handler(Looper.getMainLooper());
            bgGrabH.postDelayed(new Runnable() {
                @Override public void run() {
                    try { bgGrabScanWhenReady(); } catch (Throwable t) { log("GRAB|bg err " + t); }
                    try { maybePushWeekly(); } catch (Throwable ignore) { }
                    try { if (pcWatchH == null) startPcLoginWatch(null); } catch (Throwable ignore) { }
                    try { bgGrabH.postDelayed(this, 5 * 60 * 1000L); } catch (Throwable ignore) { }
                }
            }, 3 * 60 * 1000L);
            log("GRAB|bg pulse started");
        } catch (Throwable ignore) { }
    }

    /** 群活跃周报：每周一次推送，统计被关注的群 */
    private static void maybePushWeekly() {
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    if (!cfg().optBoolean("weeklyOn", false)) return;
                    long last = cfg().optLong("weeklyLastAt", 0);
                    long now = System.currentTimeMillis();
                    if (now - last < 6L * 86400000L) return;
                    org.json.JSONArray gs = cfg().optJSONArray("weeklyGroups");
                    if (gs == null || gs.length() == 0) return;
                    long since = sinceRaw(now - 7L * 86400000L);
                    StringBuilder sb = new StringBuilder("本周群活跃\n");
                    int sent = 0;
                    for (int i = 0; i < gs.length() && sent < 8; i++) {
                        String tk = gs.optString(i, "");
                        if (tk.length() == 0) continue;
                        java.util.List<Object[]> rows = queryRows(
                                "select ifnull(content,''), createTime from message where talker='"
                                        + escSql(tk) + "' and createTime>=" + since
                                        + " order by createTime desc limit 2000", 2);
                        java.util.LinkedHashMap<String, Integer> cnt =
                                new java.util.LinkedHashMap<String, Integer>();
                        int total = 0;
                        for (Object[] r : rows) {
                            String sid = senderIdOfGroupMsg(String.valueOf(r[0]));
                            if (sid == null || sid.length() == 0) continue;
                            Integer v = cnt.get(sid);
                            cnt.put(sid, v == null ? 1 : v + 1);
                            total++;
                        }
                        String top = "无发言";
                        int best = 0;
                        for (java.util.Map.Entry<String, Integer> e : cnt.entrySet()) {
                            if (e.getValue() > best) { best = e.getValue(); top = nameOf(e.getKey()); }
                        }
                        sb.append("· ").append(displayOfTalker(tk))
                          .append("  ").append(total).append(" 条，最活跃 ").append(top)
                          .append("(").append(best).append(")\n");
                        sent++;
                    }
                    if (sent == 0) return;
                    alert("群活跃周报", sb.toString());
                    setLongCfg("weeklyLastAt", now);
                    log("WEEKLY|pushed groups=" + sent);
                } catch (Throwable t) { log("WEEKLY|err " + t); }
            }
        }).start();
    }

    private static void setLongCfg(String key, long val) {
        try {
            java.io.File f = new java.io.File(DIR, "wxh_config.json");
            byte[] b = new byte[(int) f.length()];
            java.io.FileInputStream in = new java.io.FileInputStream(f);
            int got = 0;
            while (got < b.length) {
                int r = in.read(b, got, b.length - got);
                if (r <= 0) break;
                got += r;
            }
            in.close();
            org.json.JSONObject o = new org.json.JSONObject(new String(b, "UTF-8"));
            o.put(key, val);
            java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
            fo.write(o.toString(2).getBytes("UTF-8"));
            fo.close();
            cfg = null;
        } catch (Throwable t) { log("setLong err " + t); }
    }

    /** 用消息库句柄直接查（dbRef 在后台经常为 null） */
    private static java.util.List<Object[]> queryViaHandle(String sql, int cols) {
        java.util.List<Object[]> out = new java.util.ArrayList<Object[]>();
        try {
            Object h = msgDbHandle();
            if (h == null) { log("GRAB|handle null"); return out; }
            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, sql, new String[0]);
            if (cur == null) return out;
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
            while ((Boolean) mv.invoke(cur)) {
                Object[] r = new Object[cols];
                for (int i = 0; i < cols; i++) {
                    try { r[i] = gs.invoke(cur, i); } catch (Throwable ignore) { }
                }
                out.add(r);
                if (out.size() > 200) break;
            }
            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
        } catch (Throwable t) { log("GRAB|qv err " + t); }
        return out;
    }

    /** 等数据库可用后再扫（后台线程） */
    private static void bgGrabScanWhenReady() {
        new Thread(new Runnable() {
            @Override public void run() {
                for (int i = 0; i < 30; i++) {
                    if (dbRef != null) break;
                    try { ensureDb(); } catch (Throwable ignore) { }
                    if (dbRef != null) break;
                    try { Thread.sleep(1000); } catch (Throwable ignore) { }
                }
                new Handler(Looper.getMainLooper()).post(new Runnable() {
                    @Override public void run() {
                        try { bgGrabScan(); } catch (Throwable t) { log("GRAB|bg scan err " + t); }
                    }
                });
            }
        }).start();
    }

    /** 扫最近活跃的群，把还没试过的红包拉开 */
    private static void bgGrabScan() {
        try {
            if (!cfg().optBoolean("autoGrabRedPacket", false)) return;
            if (!cfg().optBoolean("grabOnBg", true)) return;
            if (bgBusy) return;
            loadGrabTried();
            int winMin = cfg().optInt("grabBgWin", 120);
            if (winMin < 5) winMin = 5;
            // 自己判断时间单位，别依赖可能算错的缓存
            long maxCt = 0;
            try {
                java.util.List<Object[]> mx = queryViaHandle("select max(createTime) from message", 1);
                if (!mx.isEmpty() && mx.get(0)[0] != null) {
                    maxCt = Long.parseLong(String.valueOf(mx.get(0)[0]).trim());
                }
            } catch (Throwable ignore) { }
            boolean msUnit = maxCt > 100000000000L;
            long nowMs2 = System.currentTimeMillis();
            long since = msUnit ? (nowMs2 - winMin * 60L * 1000L) : ((nowMs2 - winMin * 60L * 1000L) / 1000L);
            java.util.List<Object[]> groups = queryViaHandle(
                    "select talker from message where type=436207665 and createTime>=" + since
                            + " order by createTime desc limit 40", 1);
            log("GRAB|bg rows=" + groups.size() + " since=" + since);
            if (groups.isEmpty()) { log("GRAB|bg no groups"); return; }
            bgBusy = true;
            final android.content.Context ctx = ctxAny();
            if (ctx == null) { bgBusy = false; log("GRAB|bg no ctx"); return; }
            final java.util.ArrayList<String[]> jobs = new java.util.ArrayList<String[]>();
            java.util.HashSet<String> seenTk = new java.util.HashSet<String>();
            for (Object[] g : groups) {
                String tk = String.valueOf(g[0]);
                if (tk == null || !tk.endsWith("@chatroom")) continue;
                if (!seenTk.add(tk)) continue;
                if (seenTk.size() > 5) break;
                if (inList(cfg().optJSONArray("grabSkip"), tk)) continue;
                org.json.JSONArray only = cfg().optJSONArray("grabOnly");
                if (only != null && only.length() > 0 && !inList(only, tk)) continue;
                java.util.List<Object[]> rows = queryViaHandle(
                        "select ifnull(content,'') from message where talker='" + escSql(tk)
                                + "' and type=436207665 and createTime>=" + since
                                + " order by createTime desc limit 3", 1);
                for (Object[] r : rows) {
                    String nu = grabNativeUrl(String.valueOf(r[0]));
                    if (nu == null) continue;
                    String k = nuKey(nu);
                    if (grabTried.contains(k)) continue;
                    grabTried.add(k);
                    jobs.add(new String[]{nu, tk, k});
                    if (jobs.size() >= 5) break;
                }
                if (jobs.size() >= 5) break;
            }
            log("GRAB|bg jobs=" + jobs.size());
            if (jobs.isEmpty()) { bgBusy = false; return; }
            final Handler h = new Handler(Looper.getMainLooper());
            for (int i = 0; i < jobs.size(); i++) {
                final String[] j = jobs.get(i);
                h.postDelayed(new Runnable() {
                    @Override public void run() {
                        try {
                            boolean ok = openLuckyMoneyDirect(ctx, j[0], j[1]);
                            markGrabTried(j[2]);
                            log("GRAB|bg open#" + j[1] + " ok=" + ok);
                        } catch (Throwable t) { log("GRAB|bg open err " + t); }
                    }
                }, 1000L + i * 4000L);
            }
            h.postDelayed(new Runnable() {
                @Override public void run() {
                    bgBusy = false;
                    // 收尾：停在红包页就关掉，回到原来的界面
                    try {
                        android.app.Activity top2 = topActivityNow();
                        if (top2 != null && top2.getClass().getName().contains("LuckyMoney")) {
                            top2.finish();
                            log("GRAB|bg final closed");
                        }
                    } catch (Throwable ignore) { }
                }
            }, 1000L + jobs.size() * 4000L + 3000L);
        } catch (Throwable t) { bgBusy = false; log("GRAB|bg scan err " + t); }
    }

    /** 进入群聊时补抢旧红包：只处理群，只走 nativeurl 直接拉起 */
    private static void claimExistingPackets(final android.app.Activity a) {
        try {
            if (a == null) return;
            if (!cfg().optBoolean("autoGrabRedPacket", false)) return;
            if (!cfg().optBoolean("claimExisting", true)) return;
            final String tk = chatTalker;
            if (tk == null) { log("GRAB|claim no talker"); return; }
            if (!tk.endsWith("@chatroom") && !cfg().optBoolean("grabPrivate", true)) {
                log("GRAB|claim skip private");
                return;
            }
            String why = grabSkipReason(tk, null);
            if (why != null) { log("GRAB|claim skip " + why); return; }
            Long lastAt = claimAt.get(tk);
            long nowMs = System.currentTimeMillis();
            if (lastAt != null && nowMs - lastAt.longValue() < 60000L) { log("GRAB|claim cooldown"); return; }
            claimAt.put(tk, Long.valueOf(nowMs));
            if (claimAt.size() > 200) claimAt.clear();

            loadGrabTried();
            final java.util.ArrayList<String> urls = new java.util.ArrayList<String>();
            try {
                long sinceC = sinceForWindow(cfg().optInt("grabClaimWin", 30));
                java.util.List<Object[]> rows = queryRows(
                        "select ifnull(content,'') from message where talker='" + escSql(tk)
                                + "' and type=436207665 and createTime>=" + sinceC
                                + " order by createTime desc limit 12", 1);
                for (Object[] r : rows) {
                    String raw = String.valueOf(r[0]);
                    if (raw.contains("已领取") || raw.contains("已被领完")) continue;
                    String nu = grabNativeUrl(raw);
                    if (nu == null) continue;
                    String k = nuKey(nu);
                    if (grabTried.contains(k)) continue;
                    if (!urls.contains(nu)) urls.add(nu);
                }
            } catch (Throwable t) { log("GRAB|claim query err " + t); }

            log("GRAB|claim group=" + tk + " todo=" + urls.size());
            if (urls.isEmpty()) return;

            final Handler h = new Handler(Looper.getMainLooper());
            for (int i = 0; i < urls.size(); i++) {
                final String nu = urls.get(i);
                final int idx = i;
                h.postDelayed(new Runnable() {
                    @Override public void run() {
                        try {
                            markGrabTried(nuKey(nu));
                            boolean ok = openLuckyMoneyDirect(a, nu, tk);
                            log("GRAB|claim open#" + idx + " ok=" + ok);
                        } catch (Throwable t) { log("GRAB|claim err " + t); }
                    }
                }, 1200L + i * 3500L);
            }
            // 全部跑完后收尾：若停在红包详情页，关掉它回到聊天
            h.postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        android.app.Activity top2 = topActivityNow();
                        if (top2 == null) return;
                        String cn2 = top2.getClass().getName();
                        if (!cn2.contains("LuckyMoney")) { log("GRAB|final top=" + cn2); return; }
                        top2.finish();
                        log("GRAB|final closed " + cn2.substring(cn2.lastIndexOf('.') + 1));
                    } catch (Throwable t) { log("GRAB|final err " + t); }
                }
            }, 1200L + urls.size() * 3500L + 4000L);
        } catch (Throwable t) {
            log("claimExisting err " + t);
        }
    }


    private static void dumpView(View v, StringBuilder sb, int depth) {
        try {
            if (sb.length() > 2000 || depth > 14) return;
            StringBuilder line = new StringBuilder();
            for (int i = 0; i < depth; i++) line.append('.');
            line.append(v.getClass().getSimpleName());
            if (v.isClickable()) line.append('*');
            CharSequence cd = v.getContentDescription();
            if (cd != null) line.append(" cd=").append(cd);
            if (v instanceof android.widget.TextView) {
                CharSequence t = ((android.widget.TextView) v).getText();
                if (t != null && t.length() > 0) line.append(" t=").append(t.toString().replace('\n', ' '));
            }
            sb.append('[').append(line).append(']');
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) dumpView(g.getChildAt(i), sb, depth + 1);
            }
        } catch (Throwable t) {
        }
    }

    private static View findOpenButton(View v) {
        try {
            CharSequence cd = v.getContentDescription();
            if (cd != null && v.isShown() && v.isClickable()) {
                String cs = cd.toString();
                if (cs.contains("开") || cs.contains("開")) return v;
            }
            if (v instanceof android.widget.TextView) {
                CharSequence t = ((android.widget.TextView) v).getText();
                if (t != null) {
                    String s2 = t.toString().trim().replace(" ", "");
                    if ((s2.equals("开") || s2.equals("開") || s2.equals("拆")
                            || s2.equals("领取") || s2.equals("開紅包") || s2.equals("开红包")
                            || s2.contains("開") || s2.contains("拆"))
                            && v.isShown()) return v;
                }
            }
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    View r = findOpenButton(g.getChildAt(i));
                    if (r != null) return r;
                }
            }
        } catch (Throwable t) {
        }
        return null;
    }

    /** 收到红包后自动点开 */
    private static void autoOpenPacket(final String talker) {
        try {
            long nowArr = System.currentTimeMillis();
            if (nowArr - lastGrabArriveAt < 8000L && talker != null && talker.equals(lastGrabTalker)) {
                log("GRAB|dup skip");
                return;
            }
            lastGrabTalker = talker;
            lastGrabArriveAt = nowArr;
            log("GRAB|arrive tk=" + talker + " self=" + lastRedPacketIsSend
                    + " onNew=" + cfg().optBoolean("grabOnNew", true)
                    + " act=" + (chatAct != null || topAct != null || topActivityNow() != null));
            android.app.Activity a = chatAct;
            if (a == null) a = topAct;
            if (a == null) a = topActivityNow();
            if (talker == null) { log("GRAB|no talker"); return; }
            if (lastRedPacketIsSend && cfg().optBoolean("grabSkipSelf", true)) {
                log("GRAB|skip self");
                return;
            }
            if (!cfg().optBoolean("grabOnNew", true)) { log("GRAB|skip new-off"); return; }
            String why = grabSkipReason(talker, null);
            if (why != null) { log("GRAB|skip " + why + " " + talker); return; }
            // 只用 nativeurl 直接拉起（外部包的做法），不做气泡点击、不做坐标兜底
            final String nu = grabNativeUrl(lastRedPacketContent);
            if (nu == null) { log("GRAB|no nativeurl"); return; }
            final android.content.Context ctx = (a != null) ? a : ctxAny();
            if (ctx == null) { log("GRAB|no ctx"); return; }
            new Handler(Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() {
                    boolean ok = openLuckyMoneyDirect(ctx, nu, talker);
                    log("GRAB|direct ok=" + ok);
                    if (ok) grabMark(talker);
                    // 1.5 秒后确认页面是否真的起来了（后台启动可能被系统拦）
                    new Handler(Looper.getMainLooper()).postDelayed(new Runnable() {
                        @Override public void run() {
                            try {
                                android.app.Activity top2 = topActivityNow();
                                String cn2 = top2 == null ? "null" : top2.getClass().getSimpleName();
                                boolean lm = cn2.contains("LuckyMoney");
                                log("GRAB|verify top=" + cn2 + " lm=" + lm);
                            } catch (Throwable ignore) { }
                        }
                    }, 1500L);
                }
            }, grabDelayMs());
        } catch (Throwable t) {
            log("autoOpenPacket err " + t);
        }
    }

    private static android.widget.TextView findContains(View v, String want) {
        try {
            if (v instanceof android.widget.TextView) {
                CharSequence t = ((android.widget.TextView) v).getText();
                if (t != null && t.toString().contains(want)) return (android.widget.TextView) v;
            }
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.widget.TextView r = findContains(g.getChildAt(i), want);
                    if (r != null) return r;
                }
            }
        } catch (Throwable t) {
        }
        return null;
    }

    private static void installMenu(ClassLoader app) {
        try {
            final XC_MethodHook addHook = new XC_MethodHook() {
                @Override
                protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        Object menu = p.args[0];
                        if (menu == null) return;
                        menu.getClass().getMethod("add", CharSequence.class)
                                .invoke(menu, "H");
                        log("MENU|added to " + p.thisObject.getClass().getName());
                    } catch (Throwable t) {
                    }
                }
            };
            final XC_MethodHook clickHook = new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        Object mi = p.args[0];
                        CharSequence title = null;
                        try {
                            title = (CharSequence) mi.getClass().getMethod("getTitle").invoke(mi);
                        } catch (Throwable t) {
                        }
                        if (title != null && ("H".equals(title.toString()) || title.toString().contains("微X"))) {
                            Object self = p.thisObject;
                            Object act = self;
                            try {
                                act = self.getClass().getMethod("getActivity").invoke(self);
                            } catch (Throwable t) {
                            }
                            if (act instanceof android.app.Activity) showSettings((android.app.Activity) act);
                            p.setResult(Boolean.TRUE);
                        }
                    } catch (Throwable t) {
                    }
                }
            };
            String[] uis = {"com.tencent.mm.ui.LauncherUI", "com.tencent.mm.ui.HomeUI"};
            for (String n : uis) {
                try {
                    Class<?> c = Class.forName(n, false, app);
                    XposedBridge.hookAllMethods(c, "onOptionsItemSelected", clickHook);
                    log("hooked menu on " + n);
                } catch (Throwable t) {
                    log("menu skip " + n);
                }
            }
            // 加号弹窗菜单是 MenuInflater 填充的
            try {
                Class<?> mf = Class.forName("android.view.MenuInflater", false, app);
                XposedBridge.hookAllMethods(mf, "inflate", new XC_MethodHook() {
                    @Override
                    protected void afterHookedMethod(MethodHookParam p) {
                        try {
                            if (p.args.length < 2) return;
                            Object menu = p.args[1];
                            if (menu == null) return;
                            int size = (Integer) menu.getClass().getMethod("size").invoke(menu);
                            if (size < 3) return;
                            boolean hasAddFriend = false;
                            for (int i = 0; i < size; i++) {
                                Object it = menu.getClass().getMethod("getItem", int.class).invoke(menu, i);
                                CharSequence t = (CharSequence) it.getClass().getMethod("getTitle").invoke(it);
                                if (t != null && t.toString().contains("添加朋友")) hasAddFriend = true;
                                if (t != null && "H".equals(t.toString())) return;
                            }
                            if (!hasAddFriend) return;
                            menu.getClass().getMethod("add", CharSequence.class).invoke(menu, "H");
                            log("MENU|H added");
                        } catch (Throwable t) {
                        }
                    }
                });
                log("hooked MenuInflater.inflate");
            } catch (Throwable t) {
                log("menu inflater err " + t);
            }
            // 加号弹窗
            try {
                Class<?> pw = Class.forName("android.widget.PopupWindow", false, app);
                XposedBridge.hookAllMethods(pw, "<init>", new XC_MethodHook() {
                    @Override
                    protected void afterHookedMethod(MethodHookParam p) {
                        try {
                            log("POPUP|" + p.thisObject.getClass().getName());
                        } catch (Throwable t) {
                        }
                    }
                });
                XC_MethodHook showHook = new XC_MethodHook() {
                    @Override
                    protected void afterHookedMethod(MethodHookParam p) {
                        try {
                            // popup 方案已弃用
                        } catch (Throwable t) {
                        }
                    }
                };
                for (String mn : new String[]{"showAsDropDown", "showAtLocation"}) {
                    XposedBridge.hookAllMethods(pw, mn, showHook);
                }
                XposedBridge.hookAllMethods(pw, "setContentView", new XC_MethodHook() {
                    @Override
                    protected void afterHookedMethod(MethodHookParam p) {
                        try {
                            Object cv = p.args != null && p.args.length > 0 ? p.args[0] : null;
                            if (cv instanceof View) {
                                final android.widget.TextView anchor = findText((View) cv, "收付款");
                                if (anchor != null) {
                                    log("MENU|plus popup content found");
                                    anchor.postDelayed(new Runnable() {
                                        @Override
                                        public void run() {
                                            try {
                                                View itemRoot = (View) anchor.getParent();
                                                if (itemRoot == null) return;
                                                ViewGroup container = (ViewGroup) itemRoot.getParent();
                                                if (container == null) return;
                                                for (int i = 0; i < container.getChildCount(); i++) {
                                                    if (findText(container.getChildAt(i), "H") != null) return;
                                                }
                                                final View copy = (View) itemRoot.getClass().getMethod("clone").invoke(itemRoot);
                                                android.widget.TextView label = findText(copy, "收付款");
                                                if (label != null) label.setText("H");
                                                copy.setOnClickListener(new View.OnClickListener() {
                                                    @Override
                                                    public void onClick(View v) {
                                                        android.content.Context c = v.getContext();
                                                        if (c instanceof android.app.Activity) showSettings((android.app.Activity) c);
                                                    }
                                                });
                                                container.addView(copy);
                                                log("MENU|H appended");
                                            } catch (Throwable t) {
                                                log("MENU inject err " + t);
                                            }
                                        }
                                    }, 50);
                                }
                            }
                        } catch (Throwable t) {
                        }
                    }
                });
                try {
                    Class<?> apw = Class.forName("com.tencent.mm.ui.widget.MMAutoDismissPopupWindow", false, app);
                    for (String mn : new String[]{"showAsDropDown", "showAtLocation"}) {
                        XposedBridge.hookAllMethods(apw, mn, showHook);
                    }
                    log("hooked MMAutoDismissPopupWindow");
                } catch (Throwable t) {
                }
                log("hooked PopupWindow.show");
            } catch (Throwable t) {
                log("menu inflater err " + t);
            }
        } catch (Throwable t) {
            log("menu err " + t);
        }
    }

    /* ================= 通知快速回复 ================= */
    private static final String QR_KEY = "wxh_reply_text";
    private static volatile boolean qrReceiverDone = false;
    private static volatile String qrTalker = null;
    static volatile String qrSimText = null;
    static volatile String qrSimTalker = null;

    /** 给微信的通知挂一个「快速回复」输入框；回复内容走 sendTextTo 发出 */
    private static void decorateQuickReply(android.content.Context ctx, android.app.Notification n) {
        try {
            if (!cfg().optBoolean("quickReply", false)) return;
            if (n == null) return;
            String tk = qrTalker;
            if (tk == null || tk.length() == 0) return;
            ensureQrReceiver(ctx);
            android.content.Intent it = new android.content.Intent("wxh.QUICK_REPLY");
            it.setPackage(ctx.getPackageName());
            it.putExtra("talker", tk);
            int flags = android.os.Build.VERSION.SDK_INT >= 31
                    ? android.app.PendingIntent.FLAG_UPDATE_CURRENT | 0x40000000
                    : android.app.PendingIntent.FLAG_UPDATE_CURRENT;
            android.app.PendingIntent pi = android.app.PendingIntent.getBroadcast(
                    ctx, (tk.hashCode() & 0x7fffffff), it, flags);
            android.app.RemoteInput ri = new android.app.RemoteInput.Builder(QR_KEY)
                    .setLabel("回复 " + displayOfTalker(tk)).build();
            android.app.Notification.Action act = new android.app.Notification.Action.Builder(
                    android.R.drawable.ic_menu_send, "快速回复", pi).addRemoteInput(ri).build();
            android.app.Notification.Action[] old = n.actions == null
                    ? new android.app.Notification.Action[0] : n.actions;
            android.app.Notification.Action[] arr =
                    new android.app.Notification.Action[old.length + 1];
            System.arraycopy(old, 0, arr, 0, old.length);
            arr[old.length] = act;
            n.actions = arr;
            log("QREPLY|attached " + tk + " actions=" + arr.length);
        } catch (Throwable t) { log("QREPLY|err " + t); }
    }

    private static void ensureQrReceiver(final android.content.Context ctx) {
        if (qrReceiverDone) return;
        qrReceiverDone = true;
        try {
            android.content.BroadcastReceiver r = new android.content.BroadcastReceiver() {
                @Override public void onReceive(android.content.Context c, android.content.Intent in) {
                    try {
                        android.os.Bundle res = android.app.RemoteInput.getResultsFromIntent(in);
                        String tk = in.getStringExtra("talker");
                        CharSequence cs = res == null ? null : res.getCharSequence(QR_KEY);
                        if (cs == null && qrSimText != null && tk != null && tk.equals(qrSimTalker)) {
                            cs = qrSimText;
                            qrSimText = null;
                        }
                        if (cs == null || cs.length() == 0 || tk == null) return;
                        log("QREPLY|text " + tk + " " + cs);
                        sendTextTo(null, tk, cs.toString());
                    } catch (Throwable t) { log("QREPLY|recv err " + t); }
                }
            };
            android.content.IntentFilter f = new android.content.IntentFilter("wxh.QUICK_REPLY");
            if (android.os.Build.VERSION.SDK_INT >= 33) {
                ctx.registerReceiver(r, f, android.content.Context.RECEIVER_EXPORTED);
            } else {
                ctx.registerReceiver(r, f);
            }
            log("QREPLY|receiver ok");
        } catch (Throwable t) { log("QREPLY|reg err " + t); }
    }

    private static void installNotify(ClassLoader app) {
        try {
            Class<?> nm = Class.forName("android.app.NotificationManager", false, app);
            XC_MethodHook h = new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("keywordAlertOn", true)) return;
                        android.app.Notification n = null;
                        for (Object a : p.args) if (a instanceof android.app.Notification) n = (android.app.Notification) a;
                        if (n == null || n.extras == null) return;
                        String text = n.extras.getString(android.app.Notification.EXTRA_TEXT);
                        String title = n.extras.getString(android.app.Notification.EXTRA_TITLE);
                        String all = (title == null ? "" : title) + " " + (text == null ? "" : text);
                        log("NOTIFY|" + p.args.length + "|" + all);
                        try {
                            if (qrTalker != null) decorateQuickReply(topAct != null ? topAct : lastAct, n);
                        } catch (Throwable ignore) { }
                        try {
                            Object st = n.extras.get("android.textLines");
                            Object msg = n.extras.get("android.messages");
                            if (st != null) log("NOTIFY_LINES|" + st);
                            if (msg != null) log("NOTIFY_MSGS|" + msg);
                        } catch (Throwable t2) {
                        }
                        org.json.JSONArray kw = cfg().optJSONArray("keywordAlert");
                        if (kw == null) return;
                        for (int i = 0; i < kw.length(); i++) {
                            String k = kw.optString(i, "");
                            if (k.length() > 0 && all.contains(k)) {
                                log("KEYWORD|" + k + "|" + all);
                                toast("关键词[" + k + "]：" + all);
                                return;
                            }
                        }
                    } catch (Throwable t) {
                    }
                }
            };
            XposedBridge.hookAllMethods(nm, "notify", h);
            XposedBridge.hookAllMethods(nm, "notifyAsPackage", h);
            XposedBridge.hookAllMethods(nm, "notifyAsPackageNoTag", h);
            log("hooked NotificationManager.notify/notifyAsPackage");
            try {
                Class<?> compat = Class.forName("androidx.core.app.NotificationManagerCompat", false, app);
                XposedBridge.hookAllMethods(compat, "notify", h);
                log("hooked NotificationManagerCompat.notify");
            } catch (Throwable t2) {
                log("compat skip " + t2);
            }
        } catch (Throwable t) {
            log("notify err " + t);
        }
    }

