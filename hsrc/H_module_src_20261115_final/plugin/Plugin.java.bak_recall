                        } catch (Throwable t) { continue; }
                        if (kw.length() > 0 && tx.toLowerCase().indexOf(kw) < 0) continue;
                        android.widget.TextView tv = new android.widget.TextView(a);
                        tv.setText(tx);
                        tv.setTextSize(13);
                        tv.setTextColor(0xFF1A1A1E);
                        tv.setPadding(dp(a, 10), dp(a, 8), dp(a, 10), dp(a, 8));
                        android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
                        g.setColor(0xF7FFFFFF);
                        g.setCornerRadius(dp(a, 10));
                        tv.setBackground(g);
                        android.widget.LinearLayout.LayoutParams lp =
                                new android.widget.LinearLayout.LayoutParams(-1, -2);
                        lp.bottomMargin = dp(a, 5);
                        tv.setLayoutParams(lp);
                        final String ftx = tx;
                        String tkTmp = "";
                        final org.json.JSONObject o0;
                        try { tkTmp = o.optString("tk", ""); } catch (Throwable t2) { tkTmp = ""; }
                        o0 = o;
                        final String ftk = tkTmp;
                        tv.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                            @Override public boolean onLongClick(android.view.View v) {
                                final String fname;
                                try { fname = o0.optString("name", ""); } catch (Throwable t) { return true; }
                                String[] ops = {"保存到手机", "复制信息", "跳转会话"};
                                new android.app.AlertDialog.Builder(a)
                                        .setTitle(fname)
                                        .setItems(ops, new android.content.DialogInterface.OnClickListener() {
                                            @Override public void onClick(android.content.DialogInterface d, int w) {
                                                if (w == 0) saveGroupFile(a, fname);
                                                else if (w == 1) {
                                                    try {
                                                        android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                                                a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                                        cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", ftx));
                                                        toast("已复制");
