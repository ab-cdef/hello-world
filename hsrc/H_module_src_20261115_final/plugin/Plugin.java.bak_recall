            // ===== 提醒与静默 =====
            android.widget.LinearLayout sec4 = consoleSection(a, box, "提醒与静默",
                    "群里长期没动静会提醒你；也可以让某个群只做记录不打扰");
            consoleRow(a, sec4, "群沉默提醒",
                    cfg().optBoolean("silentWarn", false) ? "开 ›" : "关 ›",
