        } catch (Throwable t) {
            log("install err " + t);
        }
    }

    private static String extractNick(String xml) {
        try {
            if (xml == null) return "";
            for (String tag : new String[]{"nickname", "sendusername", "sendNickname"}) {
                int i = xml.indexOf("<" + tag + ">");
                if (i < 0) i = xml.indexOf("<" + tag + "><!");
                if (i < 0) {
                    String open = "<" + tag + "><![CDATA[";
                    i = xml.indexOf(open);
                    if (i >= 0) {
                        int j = xml.indexOf("]]>", i + open.length());
                        if (j > i) return xml.substring(i + open.length(), j).trim();
                    }
                    continue;
                }
                int start = xml.indexOf('>', i) + 1;
                int end = xml.indexOf("</" + tag + ">", start);
                if (end > start) return xml.substring(start, end).trim();
            }
        } catch (Throwable t) {
        }
        return "";
    }

    private static String shortOf(String s) {
        if (s == null) return "";
        int i = s.indexOf("title=\"");
        if (i >= 0) {
            int j = s.indexOf('"', i + 7);
            if (j > i) return s.substring(i + 7, j);
        }
        return s.length() > 40 ? s.substring(0, 40) : s;
    }

    private static int getInt(Object o, String name) {
        try {
            Field f = o.getClass().getField(name);
            return f.getInt(o);
        } catch (Throwable t) {
            return -1;
        }
    }

    private static String getStr(Object o, String name) {
        try {
            Field f = o.getClass().getField(name);
            Object v = f.get(o);
            return v == null ? null : String.valueOf(v);
        } catch (Throwable t) {
            return null;
        }
    }

    private static int alertId = 9000;

    /** 后台也能看到的提醒：系统通知 */
    private static void alert(final String title, final String text) {
        toast(title);
        try {
            Context ctx = null;
            try {
                Class<?> at = Class.forName("android.app.ActivityThread");
                Object app = at.getMethod("currentApplication").invoke(null);
                if (app != null) ctx = (Context) app;
                if (ctx == null) {
                    Object thread = at.getMethod("currentActivityThread").invoke(null);
                    if (thread != null) ctx = (Context) at.getMethod("getSystemContext").invoke(thread);
                }
            } catch (Throwable t0) {
                log("ctx err " + t0);
            }
            if (ctx == null) { log("alert no ctx"); return; }
            final Context fctx = ctx;
            final android.app.NotificationManager nm =
                    (android.app.NotificationManager) fctx.getSystemService(Context.NOTIFICATION_SERVICE);
            if (nm == null) return;
            if (android.os.Build.VERSION.SDK_INT >= 26) {
                android.app.NotificationChannel ch = new android.app.NotificationChannel(
                        "wxh_alert", "微X增强提醒", android.app.NotificationManager.IMPORTANCE_HIGH);
                ch.enableVibration(true);
                nm.createNotificationChannel(ch);
            }
            android.app.Notification.Builder b = android.os.Build.VERSION.SDK_INT >= 26
                    ? new android.app.Notification.Builder(ctx, "wxh_alert")
                    : new android.app.Notification.Builder(ctx);
            b.setSmallIcon(fctx.getApplicationInfo().icon)
                    .setContentTitle(title)
                    .setContentText(text)
                    .setAutoCancel(true)
                    .setWhen(System.currentTimeMillis());
            nm.notify(alertId++, b.build());
            log("ALERT_NOTIFY|" + android.os.Process.myPid() + "|" + title + "|" + text);
            try {
                java.io.FileOutputStream fo = new java.io.FileOutputStream(DIR + "/wxh_alerts.log", true);
                String line = new java.text.SimpleDateFormat("MM-dd HH:mm:ss").format(new java.util.Date())
                        + "|" + title + "|" + text + "\n";
                fo.write(line.getBytes("UTF-8"));
                fo.close();
            } catch (Throwable t5) {
            }
        } catch (Throwable t) {
            log("alert err " + t);
        }
    }

    private static void toast(final String text) {
        try {
            // 开关类的提示不要再弹（圆点颜色已经能看出来）
            if (text != null) {
                String t0 = text.trim();
                if (t0.matches("^.{0,24}[：:]\\s*(开|关|开启|关闭|已开启|已关闭)$")) {
                    log("TOASTDROP|toggle " + t0);
                    return;
                }
            }
        } catch (Throwable ignore) { }
        try {
            if (text != null && settingsRefresher != null
                    && (text.contains("翻到顶") || text.contains("没找到") || text.contains("定位"))) {
                log("TOASTDROP|" + text);
                return;
            }
        } catch (Throwable ignore) { }
        try {
            Context ctx = null;
            try {
                Class<?> at = Class.forName("android.app.ActivityThread");
                Object app = at.getMethod("currentApplication").invoke(null);
                if (app != null) ctx = (Context) app;
                if (ctx == null) {
                    Object thread = at.getMethod("currentActivityThread").invoke(null);
                    if (thread != null) ctx = (Context) at.getMethod("getSystemContext").invoke(thread);
                }
            } catch (Throwable t0) {
                log("ctx err " + t0);
            }
            if (ctx == null) { log("alert no ctx"); return; }
            final Context fctx = ctx;
            new Handler(Looper.getMainLooper()).post(new Runnable() {
                @Override
                public void run() {
                    try {
                        Toast.makeText(fctx, text, Toast.LENGTH_LONG).show();
                    } catch (Throwable t) {
                    }
                }
            });
        } catch (Throwable t) {
            log("toast err " + t);
        }
    }

    /** 导出指定群的成员名单 */
    private static void exportGroupMembers(final android.app.Activity a) {
        try {
            final Object db = dbRef;
            if (db == null) { toast("数据库未就绪"); return; }
            final java.util.List<String> chats = new java.util.ArrayList<String>();
            final java.util.List<String> ids = new java.util.ArrayList<String>();
            new Thread(new Runnable() {
                @Override public void run() {
                    try {
                        Object cur = null;
                        for (Method m : db.getClass().getMethods()) {
                            if (!m.getName().equals("rawQuery")) continue;
                            Class<?>[] ps = m.getParameterTypes();
                            if (ps.length != 2 || ps[0] != String.class) continue;
                            Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                            cur = m.invoke(db, "select username,displayName from rcontact where username like '%@chatroom'", arg);
                            break;
                        }
                        if (cur != null) {
                            while ((Boolean) cur.getClass().getMethod("moveToNext").invoke(cur)) {
                                String u = (String) cur.getClass().getMethod("getString", int.class).invoke(cur, 0);
                                String d = (String) cur.getClass().getMethod("getString", int.class).invoke(cur, 1);
                                ids.add(u);
                                chats.add((d == null || d.length() == 0) ? u : d);
                            }
                            cur.getClass().getMethod("close").invoke(cur);
                        }
                    } catch (Throwable t) { log("GRP|list err " + t); }
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            if (chats.isEmpty()) { toast("没有找到群"); return; }
                            new android.app.AlertDialog.Builder(a)
                                .setTitle("选择要导出的群")
                                .setItems(chats.toArray(new String[0]), new android.content.DialogInterface.OnClickListener() {
                                    @Override public void onClick(android.content.DialogInterface d, int which) {
                                        dumpGroupMembers(ids.get(which), chats.get(which));
                                    }
                                }).show();
                        }
                    });
                }
            }).start();
        } catch (Throwable t) { toast("err " + t); }
    }

    private static void dumpGroupMembers(final String roomId, final String roomName) {
        new Thread(new Runnable() {
            @Override public void run() {
                StringBuilder sb = new StringBuilder();
                sb.append("# 群成员导出\n# 群: ").append(roomName).append("\n# ID: ").append(roomId).append("\n\n");
                sb.append("用户名,昵称,群昵称,备注,类型\n");
                int n = 0;
                try {
                    Object db = dbRef;
                    Object cur = null;
                    for (Method m : db.getClass().getMethods()) {
                        if (!m.getName().equals("rawQuery")) continue;
                        Class<?>[] ps = m.getParameterTypes();
                        if (ps.length != 2 || ps[0] != String.class) continue;
                        Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                        cur = m.invoke(db,
                            "select username,nickname,conRemark,type from rcontact where username in " +
                            "(select memberlist from chatroom where chatroomname='" + roomId + "')", arg);
                        break;
                    }
                    if (cur != null) {
                        while ((Boolean) cur.getClass().getMethod("moveToNext").invoke(cur)) {
                            String u = (String) cur.getClass().getMethod("getString", int.class).invoke(cur, 0);
                            String nk = (String) cur.getClass().getMethod("getString", int.class).invoke(cur, 1);
                            String rm = (String) cur.getClass().getMethod("getString", int.class).invoke(cur, 2);
                            int tp = (Integer) cur.getClass().getMethod("getInt", int.class).invoke(cur, 3);
                            sb.append(u).append(',').append(nk==null?"":nk).append(',').append(rm==null?"":rm)
                              .append(',').append(tp).append('\n');
                            n++;
                        }
                        cur.getClass().getMethod("close").invoke(cur);
                    }
                } catch (Throwable t) {
                    sb.append("# 读取失败: ").append(t).append('\n');
                    log("GRPM|err " + t);
                }
                final String path = mmBase() + "/files/group_members_" +
                        Math.abs(roomId.hashCode()) + ".csv";
                try {
                    java.io.FileOutputStream fo = new java.io.FileOutputStream(path);
                    fo.write(sb.toString().getBytes("UTF-8"));
                    fo.close();
                } catch (Throwable t) { log("GRPM|write err " + t); }
                final int cnt = n;
                toast("已导出 " + cnt + " 名成员\n" + path);
                log("GRPM|done " + cnt + " " + path);
            }
        }).start();
    }

    /** 导出当前聊天里的图片/语音/视频文件 */
    /* ================= 新消息语音播报（在线合成 + MediaPlayer） ================= */
    private static final java.util.LinkedList<String> ttsQ = new java.util.LinkedList<String>();
    private static volatile boolean ttsBusy = false;
    private static volatile android.media.MediaPlayer ttsMp = null;

    private static void ttsMaybe(String talker, Integer type, String content, Integer isSend) {
        try {
            if (talker == null || content == null) return;
            if (isSend != null && isSend.intValue() != 0) return;
            if (!cfg().optBoolean("ttsOn", false)) return;
            int ty = type == null ? 0 : (type.intValue() & 0xFFFF);
            if (ty != 1) return;
            boolean grp = talker.contains("@chatroom");
            String who = cfg().optString("ttsWho", "both");
            if ("group".equals(who) && !grp) return;
            if ("private".equals(who) && grp) return;
            String body = bodyOf(ty, content);
            if (body == null) body = content;
            body = body.replace('\n', ' ').trim();
            if (body.length() == 0) return;
            String mode = cfg().optString("ttsMode", "all");
            if ("at".equals(mode)) {
                if (!content.contains("atuserlist") && body.indexOf('@') < 0) return;
            } else if ("kw".equals(mode)) {
                String words = cfg().optString("monitorWords", "");
                boolean hit = false;
                for (String w : words.split("[,，]")) {
                    String ww = w.trim();
                    if (ww.length() > 0 && body.indexOf(ww) >= 0) { hit = true; break; }
                }
                if (!hit) return;
            }
            String name = displayOfTalker(talker);
            String sender = grp ? senderOfGroupMsg(content, talker) : "";
            if (body.length() > 60) body = body.substring(0, 60);
            String say = (sender != null && sender.length() > 0 ? sender : name) + "：" + body;
            ttsSpeak(say);
        } catch (Throwable t) { log("TTS|err " + t); }
    }

    private static void ttsSpeak(String text) {
        try {
            if (text == null) return;
            String t = text.trim();
            if (t.length() == 0) return;
            if (t.length() > 120) t = t.substring(0, 120);
            synchronized (ttsQ) {
                if (ttsQ.size() > 5) ttsQ.removeFirst();
                ttsQ.add(t);
            }
            if (ttsBusy) return;
            ttsBusy = true;
            new Thread(new Runnable() {
                @Override public void run() {
                    while (true) {
                        String t2;
                        synchronized (ttsQ) { t2 = ttsQ.poll(); }
                        if (t2 == null) break;
                        try { synthAndPlay(t2); } catch (Throwable th) { log("TTS|err " + th); }
                    }
                    ttsBusy = false;
                }
            }).start();
        } catch (Throwable t) { log("TTS|speak err " + t); }
    }

    private static void synthAndPlay(String text) {
        try {
            String q = java.net.URLEncoder.encode(text, "UTF-8");
            java.net.URL u = new java.net.URL(
                    "https://fanyi.baidu.com/gettts?lan=zh&spd=5&source=web&text=" + q);
            java.net.HttpURLConnection c = (java.net.HttpURLConnection) u.openConnection();
            c.setConnectTimeout(8000);
            c.setReadTimeout(12000);
            c.setRequestProperty("User-Agent", "Mozilla/5.0 (Linux; Android 13; Mobile)");
            c.setRequestProperty("Referer", "https://fanyi.baidu.com/");
            int code = c.getResponseCode();
            if (code != 200) { log("TTS|http " + code); return; }
            java.io.File f = new java.io.File(DIR, "tts.mp3");
            java.io.InputStream in = c.getInputStream();
            java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
            byte[] buf = new byte[8192];
            int r;
            while ((r = in.read(buf)) > 0) fo.write(buf, 0, r);
            fo.close();
            in.close();
            c.disconnect();
            if (f.length() < 1500) { log("TTS|small " + f.length()); return; }
            log("TTS|got " + f.length() + " bytes for " + text);
            playMp3(f);
        } catch (Throwable t) { log("TTS|synth err " + t); }
    }

    private static void playMp3(java.io.File f) {
        try {
            if (ttsMp != null) {
                try { ttsMp.reset(); } catch (Throwable ignore) { }
                try { ttsMp.release(); } catch (Throwable ignore) { }
                ttsMp = null;
            }
            final android.media.MediaPlayer mp = new android.media.MediaPlayer();
            ttsMp = mp;
            mp.setDataSource(f.getAbsolutePath());
            mp.prepare();
            mp.setOnCompletionListener(new android.media.MediaPlayer.OnCompletionListener() {
                @Override public void onCompletion(android.media.MediaPlayer m) {
                    try { m.release(); } catch (Throwable ignore) { }
                    if (ttsMp == m) ttsMp = null;
                }
            });
            mp.start();
            log("TTS|playing");
        } catch (Throwable t) { log("TTS|play err " + t); }
    }

    /* ================= 群沉默提醒 ================= */
    private static volatile long lastSilentChk = 0;

    private static void silentTick(final android.app.Activity a) {
        try {
            if (a == null) return;
            if (!cfg().optBoolean("silentWarn", false)) return;
            long now = System.currentTimeMillis();
            if (now - lastSilentChk < 60000) return;
            lastSilentChk = now;
            android.content.SharedPreferences sp =
                    a.getSharedPreferences("wxh_silent", android.content.Context.MODE_PRIVATE);
            long last = sp.getLong("last", 0);
            if (now - last < 86400000L) return;
            sp.edit().putLong("last", now).apply();
            final int days = Math.max(1, cfg().optInt("silentDays", 7));
            new Thread(new Runnable() {
                @Override public void run() {
                    try {
                        StringBuilder sb = new StringBuilder();
                        int n = 0;
                        java.util.List<Object[]> rows = queryRows(
                                "select username, conversationTime from rconversation"
                                        + " where username like '%@chatroom'"
                                        + " order by conversationTime asc limit 300", 2);
                        long cut = (System.currentTimeMillis() - days * 86400000L) / 1000L;
                        for (Object[] r : rows) {
                            String tk = r[0] == null ? "" : String.valueOf(r[0]);
                            long ct = 0;
                            try { ct = Long.parseLong(String.valueOf(r[1])); } catch (Throwable ignore) { }
                            if (ct > 100000000000L) ct = ct / 1000L;
                            if (ct <= 0 || ct >= cut) continue;
                            n++;
                            if (n <= 6) sb.append("· ").append(displayOfTalker(tk)).append("\n");
                        }
                        if (n > 0) {
                            alert("有 " + n + " 个群超过 " + days + " 天没消息",
                                    sb.toString() + (n > 6 ? "…" : ""));
                        }
                        log("SILENT|n=" + n + " days=" + days);
                    } catch (Throwable t) { log("SILENT|err " + t); }
                }
            }).start();
        } catch (Throwable t) { log("SILENT|err2 " + t); }
    }


    private static boolean isJunkSpeak(String s) {
        if (s == null) return true;
        String t = s.trim();
        if (t.length() == 0) return true;
        if (t.startsWith("View.") || t.contains("ContentCapture")) return true;
        if (t.contains("Accessibility") && t.length() < 40) return true;
        return false;
    }

    /** 取这条消息真正能念的文字：长按文字 → adapter 内容 → 行内 TextView 文本 */
    private static String speakableText(android.view.View anchor) {
        try {
            String t = lastLongPressText;
            if (isJunkSpeak(t)) t = null;
            if (t == null) {
                String a = textByAdapter(anchor);
                if (!isJunkSpeak(a)) t = a;
            }
            if (t != null && t.trim().startsWith("<msg")) {
                try {
                    String b = bodyOf(1, t);
                    if (!isJunkSpeak(b)) t = b;
                } catch (Throwable ignore) { }
            }
            if (isJunkSpeak(t) && anchor != null) {
                android.view.View row = rowOf(anchor);
                if (row == null) row = anchor;
                java.util.List<android.view.View> all = new java.util.ArrayList<android.view.View>();
                collectViews(row, all, 0);
                StringBuilder sb = new StringBuilder();
                for (android.view.View v : all) {
                    if (!(v instanceof android.widget.TextView)) continue;
                    CharSequence cs = ((android.widget.TextView) v).getText();
                    if (cs == null) continue;
                    String s2 = cs.toString().trim();
                    if (isJunkSpeak(s2)) continue;
                    if (s2.matches("^\\d{1,2}:\\d{2}$")) continue;
                    sb.append(s2).append(' ');
                }
                if (sb.length() > 0) t = sb.toString().trim();
            }
            return t;
        } catch (Throwable t) { return null; }
    }

    /** 播报范围循环：全部 → @我 → 关键词 */
