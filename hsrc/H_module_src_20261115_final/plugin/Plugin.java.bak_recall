    private static void exportGroupFiles(android.app.Activity a, java.util.ArrayList<String> all) {
        try {
            java.io.File dir = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                    "Download/wxh");
            dir.mkdirs();
            java.io.File out = new java.io.File(dir, "group_files_"
                    + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss").format(new java.util.Date()) + ".txt");
            java.io.FileWriter fw = new java.io.FileWriter(out);
            fw.write("时间\t群/会话\t发送人\t文件名\t大小\n");
            for (String raw : all) {
                try {
                    org.json.JSONObject o = new org.json.JSONObject(raw);
                    fw.write(fmtTs(o.optLong("ts", 0)) + "\t" + o.optString("talker") + "\t"
                            + o.optString("sender") + "\t" + o.optString("name") + "\t"
                            + fmtSize(o.optLong("size", 0)) + "\n");
                } catch (Throwable ignore) { }
            }
            fw.close();
            toast("已导出：" + out.getAbsolutePath());
            log("GRPFILE|export " + out.getAbsolutePath());
        } catch (Throwable t) { toast("导出失败 " + t); }
    }


    /* ================= 消息定时提醒 ================= */
    private static void askRemind(final android.app.Activity a, final String text) {
        final String[] opts = {"10 分钟后", "30 分钟后", "1 小时后", "3 小时后", "明天此时", "自定义（分钟）"};
        new android.app.AlertDialog.Builder(a)
                .setTitle("几点提醒我？")
                .setItems(opts, new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        long[] ms = {600000L, 1800000L, 3600000L, 10800000L, 86400000L};
                        if (w < ms.length) {
                            addReminder(a, text, System.currentTimeMillis() + ms[w]);
                        } else {
                            final android.widget.EditText et = new android.widget.EditText(a);
                            et.setHint("多少分钟后提醒");
                            et.setTextSize(15);
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("自定义提醒")
                                    .setView(et)
                                    .setPositiveButton("确定", new android.content.DialogInterface.OnClickListener() {
                                        @Override public void onClick(android.content.DialogInterface d2, int w2) {
                                            int m = 0;
                                            try { m = Integer.parseInt(et.getText().toString().trim()); } catch (Throwable t) { }
                                            if (m <= 0) { toast("请输入正整数分钟"); return; }
                                            addReminder(a, text, System.currentTimeMillis() + m * 60000L);
                                        }
                                    })
                                    .setNegativeButton("取消", null).show();
                        }
                    }
                })
                .setNegativeButton("取消", null).show();
    }

    private static void addReminder(android.app.Activity a, String text, long at) {
        try {
            java.io.File f = new java.io.File(DIR + "/reminders.jsonl");
            org.json.JSONObject o = new org.json.JSONObject();
            o.put("at", at);
            o.put("text", text == null ? "" : text);
            o.put("talker", chatTalker == null ? "" : displayOfTalker(chatTalker));
            o.put("done", false);
            java.io.FileWriter fw = new java.io.FileWriter(f, true);
            fw.write(o.toString() + "\n");
            fw.close();
            java.text.SimpleDateFormat f2 = new java.text.SimpleDateFormat("HH:mm");
            toast("已设定 " + f2.format(new java.util.Date(at)) + " 提醒");
            log("REMIND|set at=" + at + " text=" + (text == null ? "" : text.length()));
            startRemindTick(a);
        } catch (Throwable t) { toast("设定失败: " + t); }
    }

    private static volatile boolean remindTicking = false;

    private static void startRemindTick(final android.app.Activity a) {
        if (remindTicking) return;
        remindTicking = true;
        final android.os.Handler hh = new android.os.Handler(android.os.Looper.getMainLooper());
        hh.postDelayed(new Runnable() {
            @Override public void run() {
                try {
                    checkReminders(a);
                    hh.postDelayed(this, 30000);      // 每 30 秒检查
                } catch (Throwable t) { remindTicking = false; }
            }
        }, 5000);
    }

    private static void checkReminders(android.app.Activity a) {
        try {
            java.io.File f = new java.io.File(DIR + "/reminders.jsonl");
            if (!f.exists()) return;
            long now = System.currentTimeMillis();
            java.util.ArrayList<String> keep = new java.util.ArrayList<String>();
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            java.util.ArrayList<String> fire = new java.util.ArrayList<String>();
            String ln;
            while ((ln = br.readLine()) != null) {
                if (ln.trim().length() == 0) continue;
                org.json.JSONObject o;
                try { o = new org.json.JSONObject(ln); } catch (Throwable t) { continue; }
                if (o.optBoolean("done", false)) continue;
                if (o.optLong("at", 0) <= now) {
                    fire.add(o.optString("talker") + "：" + o.optString("text"));
                } else {
                    keep.add(ln);
                }
            }
            br.close();
            if (fire.isEmpty()) return;
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            fw.write("");
            fw.close();
            fw = new java.io.FileWriter(f, true);
            for (String k : keep) fw.write(k + "\n");
            fw.close();
            for (String msg : fire) {
                notifyLocal(a, "消息提醒", msg);
                log("REMIND|fire " + msg);
            }
        } catch (Throwable t) { log("REMIND|err " + t); }
    }

    private static void notifyLocal(android.app.Activity a, String title, String body) {
        try {
            android.app.NotificationManager nm = (android.app.NotificationManager)
                    a.getSystemService(android.content.Context.NOTIFICATION_SERVICE);
            if (android.os.Build.VERSION.SDK_INT >= 26) {
                android.app.NotificationChannel ch = new android.app.NotificationChannel(
                        "wxh_remind", "H 消息提醒", android.app.NotificationManager.IMPORTANCE_HIGH);
                ch.enableVibration(true);
                nm.createNotificationChannel(ch);
            }
            android.app.Notification.Builder b;
            if (android.os.Build.VERSION.SDK_INT >= 26) {
                b = new android.app.Notification.Builder(a, "wxh_remind");
            } else {
                b = new android.app.Notification.Builder(a);
            }
            b.setSmallIcon(android.R.drawable.ic_dialog_info)
                    .setContentTitle(title)
                    .setContentText(body)
                    .setStyle(new android.app.Notification.BigTextStyle().bigText(body))
                    .setAutoCancel(true)
                    .setWhen(System.currentTimeMillis());
            nm.notify((int) (System.currentTimeMillis() % 100000), b.build());
        } catch (Throwable t) { log("REMIND|notify err " + t); }
    }

    private static void showReminders(final android.app.Activity a) {
        try {
            java.io.File f = new java.io.File(DIR + "/reminders.jsonl");
            if (!f.exists()) { toast("还没有提醒"); return; }
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            StringBuilder sb = new StringBuilder();
            int n = 0;
            String ln;
            while ((ln = br.readLine()) != null) {
                if (ln.trim().length() == 0) continue;
                org.json.JSONObject o;
                try { o = new org.json.JSONObject(ln); } catch (Throwable t) { continue; }
                if (o.optBoolean("done", false)) continue;
                sb.append("· ").append(fmtTs(o.optLong("at", 0)))
                  .append("  ").append(o.optString("talker")).append('\n')
                  .append("   ").append(o.optString("text")).append("\n\n");
                n++;
            }
            br.close();
            if (n == 0) { toast("没有待触发的提醒"); return; }
            new android.app.AlertDialog.Builder(a)
                    .setTitle("待触发的提醒（" + n + "）")
                    .setMessage(sb.toString())
                    .setPositiveButton("清空全部", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try { new java.io.FileWriter(f, false).close(); toast("已清空"); }
                            catch (Throwable t) { }
                        }
                    })
                    .setNegativeButton("关闭", null).show();
        } catch (Throwable t) { log("REMIND|view err " + t); }
    }


    /* ================= 日报群自动摘要 ================= */
    private static void addDailyGroup(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || tk.length() == 0) { toast("请先在群聊里执行"); return; }
        try {
            org.json.JSONObject c = cfg();
            org.json.JSONArray arr = c.optJSONArray("dailyGroups");
            if (arr == null) arr = new org.json.JSONArray();
            for (int i = 0; i < arr.length(); i++) {
                if (tk.equals(arr.optString(i))) { toast("已经在列表里了"); return; }
            }
            arr.put(tk);
            c.put("dailyGroups", arr);
            writeCfg(c);
            toast("已加入日报群：" + displayOfTalker(tk) + "\n共 " + arr.length() + " 个");
            log("DAILYG|add " + tk);
        } catch (Throwable t) { toast("添加失败 " + t); }
    }


    private static void removeDailyGroup(final android.app.Activity a, final String tk, String name) {
        new android.app.AlertDialog.Builder(a)
                .setTitle("移除日报群")
                .setMessage("不再自动为「" + name + "」生成摘要？\n\n（不会影响已生成的文件）")
                .setPositiveButton("移除", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        try {
                            org.json.JSONObject c = cfg();
                            org.json.JSONArray arr = c.optJSONArray("dailyGroups");
                            org.json.JSONArray out = new org.json.JSONArray();
                            if (arr != null) {
                                for (int i = 0; i < arr.length(); i++) {
                                    if (!tk.equals(arr.optString(i))) out.put(arr.optString(i));
                                }
                            }
                            c.put("dailyGroups", out);
                            writeCfg(c);
                            toast("已移除，剩 " + out.length() + " 个");
                            log("DAILYG|remove " + tk);
                            if (out.length() > 0) listDailyGroups(a);
                        } catch (Throwable t) { toast("移除失败 " + t); }
                    }
                })
                .setNegativeButton("取消", null).show();
    }

    private static void listDailyGroups(final android.app.Activity a) {
        try {
            org.json.JSONObject c = cfg();
            org.json.JSONArray arr = c.optJSONArray("dailyGroups");
            if (arr == null || arr.length() == 0) { toast("还没有日报群，在群聊里点「加入日报自动摘要」"); return; }
            final String[] ids = new String[arr.length()];
            for (int m = 0; m < arr.length(); m++) ids[m] = arr.optString(m);

            final android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            int pd = dp(a, 8);
            box.setPadding(pd, pd, pd, pd);

            android.widget.TextView tip = new android.widget.TextView(a);
            tip.setText("每天第一次打开微信时自动为这些群生成当日摘要。\n点某一行可单独移除。");
            tip.setTextSize(12);
            tip.setTextColor(0xFF888888);
            tip.setPadding(dp(a, 10), dp(a, 4), dp(a, 10), dp(a, 10));
            box.addView(tip);

            for (int m = 0; m < ids.length; m++) {
                final String id = ids[m];
                android.widget.LinearLayout row = new android.widget.LinearLayout(a);
                row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                row.setPadding(dp(a, 14), dp(a, 14), dp(a, 14), dp(a, 14));
                android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
                g.setColor(0xF7FFFFFF);
                g.setCornerRadius(dp(a, 12));
                row.setBackground(g);
                android.widget.LinearLayout.LayoutParams lp =
                        new android.widget.LinearLayout.LayoutParams(-1, -2);
                lp.bottomMargin = dp(a, 6);
                row.setLayoutParams(lp);

                android.widget.TextView tx = new android.widget.TextView(a);
                tx.setText((m + 1) + ". " + displayOfTalker(id));
                tx.setTextSize(15);
                tx.setTextColor(0xFF1A1A1E);
                row.addView(tx, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));

                android.widget.TextView del = new android.widget.TextView(a);
                del.setText("移除");
                del.setTextSize(13);
                del.setTextColor(0xFF07C160);
                del.setPadding(dp(a, 10), dp(a, 6), dp(a, 6), dp(a, 6));
                row.addView(del);

                row.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        if (dlg != null) { try { dlg.dismiss(); } catch (Throwable ignore) { } }
                        removeDailyGroup(a, id, displayOfTalker(id));
                    }
                });
                box.addView(row);
            }

            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            sv.addView(box);
            dlg = new android.app.AlertDialog.Builder(a)
                    .setTitle("日报群（" + ids.length + "）")
                    .setView(sv)
                    .setPositiveButton("清空全部", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("清空日报群")
                                    .setMessage("移除全部 " + ids.length + " 个日报群？\n已生成的摘要文件不会被删除。")
                                    .setPositiveButton("清空", new android.content.DialogInterface.OnClickListener() {
                                        @Override public void onClick(android.content.DialogInterface d2, int w2) {
                                            try {
                                                org.json.JSONObject c2 = cfg();
                                                c2.put("dailyGroups", new org.json.JSONArray());
                                                writeCfg(c2);
                                                toast("已清空日报群");
                                                log("DAILYG|clear all");
                                            } catch (Throwable t) { }
                                        }
                                    })
                                    .setNegativeButton("取消", null).show();
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .create();
            dlg.show();
        } catch (Throwable t) { log("DAILYG|list err " + t); }
    }

    private static volatile long dailyAutoChk = 0;

    private static void autoDailyTick(android.app.Activity a) {
        try {
            if (a == null) return;
            long now = System.currentTimeMillis();
            if (now - dailyAutoChk < 60000) return;
            dailyAutoChk = now;
            org.json.JSONObject c = cfg();
            org.json.JSONArray arr = c.optJSONArray("dailyGroups");
            if (arr == null || arr.length() == 0) return;
            java.text.SimpleDateFormat df = new java.text.SimpleDateFormat("yyyyMMdd");
            String today = df.format(new java.util.Date(now));
            android.content.SharedPreferences sp =
                    a.getSharedPreferences("wxh_auto", android.content.Context.MODE_PRIVATE);
            if (today.equals(sp.getString("dailyDate", ""))) return;
            sp.edit().putString("dailyDate", today).apply();
            log("DAILYG|auto start n=" + arr.length());
            for (int i = 0; i < arr.length(); i++) {
                final String tk = arr.optString(i);
                if (tk == null || tk.length() == 0) continue;
                new Thread(new Runnable() {
                    @Override public void run() {
                        try { doDailySummaryQuiet(tk); } catch (Throwable t) { log("DAILYG|err " + t); }
                    }
                }).start();
                try { Thread.sleep(800); } catch (Throwable ignore) { }
            }
        } catch (Throwable t) { log("DAILYG|tick err " + t); }
    }

    /** 静默生成，不弹窗（自动任务用） */
    private static void doDailySummaryQuiet(final String tk) {
        try {
            final Object h = msgDbHandle();
            if (h == null) return;
            Object probe = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, "select max(createTime) from message", new String[0]);
            boolean ms = false;
            if (probe != null) {
                java.lang.reflect.Method mv = probe.getClass().getMethod("moveToNext");
                java.lang.reflect.Method gl = probe.getClass().getMethod("getLong", int.class);
                if ((Boolean) mv.invoke(probe)) ms = (Long) gl.invoke(probe, 0) > 100000000000L;
                try { probe.getClass().getMethod("close").invoke(probe); } catch (Throwable ignore) { }
            }
            java.util.Calendar c0 = java.util.Calendar.getInstance();
            c0.set(java.util.Calendar.HOUR_OF_DAY, 0);
            c0.set(java.util.Calendar.MINUTE, 0);
            c0.set(java.util.Calendar.SECOND, 0);
            long dayStart = c0.getTimeInMillis();
            long f = ms ? dayStart : dayStart / 1000L;
            java.text.SimpleDateFormat hf = new java.text.SimpleDateFormat("HH:mm");
            java.text.SimpleDateFormat df = new java.text.SimpleDateFormat("yyyy-MM-dd");
            java.util.LinkedHashMap<String, java.util.ArrayList<String>> byWho =
                    new java.util.LinkedHashMap<String, java.util.ArrayList<String>>();
            java.util.ArrayList<String> keyLines = new java.util.ArrayList<String>();
            int total = 0;
            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, "select type, content, createTime, isSend from message where talker='"
                            + tk.replace("'", "''") + "' and createTime>=" + f
                            + " order by createTime asc", new String[0]);
            if (cur != null) {
                java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                while ((Boolean) mv.invoke(cur)) {
                    long ty = (Long) gl.invoke(cur, 0);
                    String cn = (String) gs.invoke(cur, 1);
                    long t = (Long) gl.invoke(cur, 2);
                    long mine = (Long) gl.invoke(cur, 3);
                    if (!ms) t *= 1000L;
                    String body = bodyOf(ty, cn);
                    if (body == null || body.trim().length() == 0) continue;
                    body = body.replace('\n', ' ').trim();
                    String who = mine > 0 ? "我" : senderOfGroupMsg(cn, tk);
                    if (who == null || who.length() == 0) who = "成员";
                    java.util.ArrayList<String> arr = byWho.get(who);
                    if (arr == null) { arr = new java.util.ArrayList<String>(); byWho.put(who, arr); }
                    arr.add(hf.format(new java.util.Date(t)) + "  " + body);
                    total++;
                    if (isKeyLine(body)) keyLines.add(hf.format(new java.util.Date(t)) + "  " + who + "：" + body);
                }
                try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
            }
            if (total == 0) { log("DAILYG|empty " + tk); return; }
            StringBuilder sb = new StringBuilder();
            sb.append("【").append(displayOfTalker(tk)).append("】今日消息摘要\n");
            sb.append("日期：").append(df.format(new java.util.Date())).append('\n');
            sb.append("消息：").append(total).append(" 条，参与：").append(byWho.size()).append(" 人\n");
            sb.append("================================\n\n");
            if (!keyLines.isEmpty()) {
                sb.append("【关键消息】\n");
                int lim = Math.min(40, keyLines.size());
                for (int i = 0; i < lim; i++) sb.append("· ").append(keyLines.get(i)).append('\n');
                sb.append('\n');
            }
            sb.append("【按成员】\n");
            for (java.util.Map.Entry<String, java.util.ArrayList<String>> e : byWho.entrySet()) {
                sb.append("\n▌").append(e.getKey()).append("（").append(e.getValue().size()).append(" 条）\n");
                int lim = Math.min(30, e.getValue().size());
                for (int i = 0; i < lim; i++) sb.append("  ").append(e.getValue().get(i)).append('\n');
            }
            sb.append(dailyRuleNote());
            java.io.File dir = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                    "Download/wxh/daily/auto");
            dir.mkdirs();
            String safe = displayOfTalker(tk).replaceAll("[\\\\/:*?\"<>|]", "_");
            java.io.File out = new java.io.File(dir, safe + "_" + df.format(new java.util.Date()) + ".txt");
            java.io.FileWriter fw = new java.io.FileWriter(out);
            fw.write(sb.toString());
            fw.close();
            log("DAILYG|ok " + total + " " + out.getAbsolutePath());
        } catch (Throwable t) { log("DAILYG|quiet err " + t); }
    }

    private static void showDailySummary(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || tk.length() == 0) { toast("请先在要汇总的聊天里执行"); return; }
        new android.app.AlertDialog.Builder(a)
