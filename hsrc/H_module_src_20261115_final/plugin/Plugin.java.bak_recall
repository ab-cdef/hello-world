    /* ================= 导出 CSV（Excel 可打开） ================= */
    private static String csvEsc(String v) {
        if (v == null) return "";
        String x = v.replace("\"", "\"\"");
        if (x.indexOf(',') >= 0 || x.indexOf('"') >= 0 || x.indexOf('\n') >= 0) {
            return "\"" + x + "\"";
        }
        return x;
    }


    /* ================= 今日群消息摘要（日报素材） ================= */

    /* ================= 群文件清单 ================= */

    private static String cleanXmlText(String v) {
        if (v == null) return null;
        String x = v.trim();
        if (x.startsWith("<![CDATA[")) x = x.substring(9);
        if (x.endsWith("]]>")) x = x.substring(0, x.length() - 3);
        x = x.replace("&lt;", "<").replace("&gt;", ">").replace("&amp;", "&").replace("&quot;", "\"");
        return x.trim();
    }

    private static final java.util.LinkedHashSet<String> grpFileSeen =
            new java.util.LinkedHashSet<String>();

    private static void recordGroupFile(String talker, String content, String name, String len, long ct) {
        try {
            if (!cfg().optBoolean("groupFileLog", true)) return;
            String seKey = (talker == null ? "" : talker) + "|" + (name == null ? "" : name) + "|" + ct;
            if (grpFileSeen.contains(seKey)) return;
            grpFileSeen.add(seKey);
            if (grpFileSeen.size() > 800) {
                java.util.Iterator<String> it0 = grpFileSeen.iterator();
                if (it0.hasNext()) { it0.next(); it0.remove(); }
            }
            java.io.File f = new java.io.File(DIR + "/group_files.jsonl");
            org.json.JSONObject o = new org.json.JSONObject();
            o.put("ts", ct > 0 ? ct : System.currentTimeMillis());
            o.put("talker", talker == null ? "" : displayOfTalker(talker));
            o.put("tk", talker == null ? "" : talker);
            o.put("name", name == null ? "" : name);
            long sz = 0;
            try { sz = Long.parseLong((len == null ? "0" : len.trim())); } catch (Throwable t) { sz = 0; }
            o.put("size", sz);
            String sender = senderOfGroupMsg(content, talker);
            o.put("sender", sender == null ? "" : sender);
            java.io.FileWriter fw = new java.io.FileWriter(f, true);
            fw.write(o.toString() + "\n");
            fw.close();
            log("GRPFILE|" + name + " size=" + sz);
        } catch (Throwable t) { log("GRPFILE|err " + t); }
    }

    private static String fmtSize(long b) {
        if (b <= 0) return "未知大小";
        if (b < 1024) return b + " B";
        if (b < 1048576) return (b / 1024) + " KB";
        return String.format(java.util.Locale.US, "%.1f MB", b / 1048576.0);
    }


    /* ================= 关键词监控 ================= */
    private static final java.util.HashSet<String> monSeen = new java.util.HashSet<String>();

    private static void monitorHit(String talker, Integer type, String content,
                                   Integer isSend, Long ctL) {
        try {
            if (talker == null || content == null) return;
            String words = cfg().optString("monitorWords", "");
            if (words == null || words.trim().length() == 0) return;
            org.json.JSONArray monOnly = cfg().optJSONArray("monOnly");
            if (monOnly != null && monOnly.length() > 0) {
                boolean okTk = false;
                for (int mi = 0; mi < monOnly.length(); mi++) {
                    if (talker.equals(monOnly.optString(mi))) { okTk = true; break; }
                }
                if (!okTk) return;
            }
            int ty = type == null ? 0 : (type.intValue() & 0xFFFF);
            if (ty != 1 && ty != 49) return;                 // 只看文字与链接/文件
            String body = bodyOf(ty, content);
            if (body == null || body.length() < 2) return;
            String hit = null;
            for (String w : words.split("[,，]")) {
                String ww = w.trim();
                if (ww.length() == 0) continue;
                if (body.indexOf(ww) >= 0) { hit = ww; break; }
            }
            if (hit == null) return;
            long ct = ctL == null ? System.currentTimeMillis() : ctL.longValue();
            if (ct < 100000000000L) ct *= 1000L;
            String key = talker + "|" + ct + "|" + body.hashCode();
            if (monSeen.contains(key)) return;
            monSeen.add(key);
            if (monSeen.size() > 2000) monSeen.clear();
            org.json.JSONObject o = new org.json.JSONObject();
            o.put("ts", ct);
            o.put("tk", talker);
            o.put("talker", displayOfTalker(talker));
            String sn = senderOfGroupMsg(content, talker);
            o.put("sender", sn == null ? "" : sn);
            o.put("kw", hit);
            String body2 = body.replace('\n', ' ');
            if (body2.length() > 300) body2 = body2.substring(0, 300) + "…";
            o.put("text", body2);
            java.io.FileWriter fw = new java.io.FileWriter(new java.io.File(DIR + "/monitor.jsonl"), true);
            fw.write(o.toString() + "\n");
            fw.close();
            log("MON|" + hit + " " + o.optString("talker"));
            if (cfg().optBoolean("monNotify", true)) {
                try {
                    String sn2 = body2.length() > 60 ? body2.substring(0, 60) + "…" : body2;
                    alert("关键词命中：" + hit, o.optString("talker") + " · " + sn2);
                } catch (Throwable ignore) { }
            }
        } catch (Throwable t) { log("MON|err " + t); }
    }

    private static void showMonitor(final android.app.Activity a) {
        try {
            java.io.File f = new java.io.File(DIR + "/monitor.jsonl");
            final java.util.ArrayList<String> all = new java.util.ArrayList<String>();
            if (f.exists()) {
                java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
                String ln;
                while ((ln = br.readLine()) != null) if (ln.trim().length() > 0) all.add(ln);
                br.close();
            }

            final android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            int pd = dp(a, 8);
            box.setPadding(pd, pd, pd, pd);

            final android.widget.EditText search = new android.widget.EditText(a);
            search.setHint("搜索内容 / 群名 / 关键词");
            search.setTextSize(14);
            box.addView(search);

            final android.widget.LinearLayout listBox = new android.widget.LinearLayout(a);
            listBox.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            sv.addView(listBox);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 360)));

            final android.widget.TextView cnt = new android.widget.TextView(a);
            cnt.setTextSize(12);
            cnt.setTextColor(0xFF888888);
            cnt.setPadding(dp(a, 6), dp(a, 4), dp(a, 6), dp(a, 4));
            box.addView(cnt);

            final Runnable rebuild = new Runnable() {
                @Override public void run() {
                    listBox.removeAllViews();
                    String kw = search.getText().toString().trim().toLowerCase();
                    int shown = 0;
                    for (int i = all.size() - 1; i >= 0 && shown < 150; i--) {
                        org.json.JSONObject o;
                        String tx, tk;
                        try {
                            o = new org.json.JSONObject(all.get(i));
                            tx = "[" + fmtTs(o.optLong("ts", 0)) + "] " + o.optString("talker")
                                    + (o.optString("sender").length() > 0 ? " · " + o.optString("sender") : "")
                                    + "\n命中「" + o.optString("kw") + "」：\n" + o.optString("text");
                            tk = o.optString("tk", "");
                        } catch (Throwable t) { continue; }
                        if (kw.length() > 0 && tx.toLowerCase().indexOf(kw) < 0) continue;
                        final String ftx = tx, ftk = tk;
                        android.widget.TextView tv = new android.widget.TextView(a);
                        tv.setText(tx);
                        tv.setTextSize(13);
                        tv.setTextColor(0xFF1A1A1E);
                        tv.setPadding(dp(a, 10), dp(a, 8), dp(a, 10), dp(a, 8));
                        android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
                        g.setColor(0xF7FFFFFF);
                        g.setCornerRadius(dp(a, 10));
                        tv.setBackground(g);
                        android.widget.LinearLayout.LayoutParams lp =
                                new android.widget.LinearLayout.LayoutParams(-1, -2);
                        lp.bottomMargin = dp(a, 5);
                        tv.setLayoutParams(lp);
                        tv.setOnClickListener(new android.view.View.OnClickListener() {
                            @Override public void onClick(android.view.View v) {
                                if (dlg != null) { try { dlg.dismiss(); } catch (Throwable ignore) { } }
                                if (ftk.length() > 0) zOpenChat(a, ftk);
                            }
                        });
                        tv.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                            @Override public boolean onLongClick(android.view.View v) {
                                try {
                                    android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                            a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                    cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", ftx));
                                    toast("已复制");
                                } catch (Throwable t) { }
                                return true;
                            }
                        });
                        listBox.addView(tv);
                        shown++;
                    }
                    cnt.setText(all.size() == 0
                            ? "还没有命中记录。点右下「设置词表」填关键词后开始监控。"
                            : "共 " + all.size() + " 条命中，显示 " + shown + " 条（点击跳会话 / 长按复制）");
                }
            };
            search.addTextChangedListener(new android.text.TextWatcher() {
                @Override public void beforeTextChanged(CharSequence s2, int st, int c, int af) { }
                @Override public void onTextChanged(CharSequence s2, int st, int b, int c) { }
                @Override public void afterTextChanged(android.text.Editable e) { rebuild.run(); }
            });
            rebuild.run();

            dlg = new android.app.AlertDialog.Builder(a)
                    .setTitle("关键词监控")
                    .setView(box)
                    .setPositiveButton("设置词表", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            editMonitorWords(a);
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .create();
            dlg.show();
        } catch (Throwable t) { log("MON|view err " + t); }
    }

    private static void editMonitorWords(final android.app.Activity a) {
        try {
            final android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            int pd = dp(a, 8);
            box.setPadding(pd, pd, pd, pd);

            final android.widget.LinearLayout addRow = new android.widget.LinearLayout(a);
            addRow.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            addRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
            final android.widget.EditText input = new android.widget.EditText(a);
            input.setHint("输入关键词");
            input.setTextSize(14);
            addRow.addView(input, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
            final android.widget.TextView addBtn = new android.widget.TextView(a);
            addBtn.setText("添加");
            addBtn.setTextSize(14);
            addBtn.setTextColor(0xFFFFFFFF);
            android.graphics.drawable.GradientDrawable abg = new android.graphics.drawable.GradientDrawable();
            abg.setColor(0xFF07C160);
            abg.setCornerRadius(dp(a, 16));
            addBtn.setBackground(abg);
            addBtn.setPadding(dp(a, 14), dp(a, 8), dp(a, 14), dp(a, 8));
            addRow.addView(addBtn);
            box.addView(addRow);

            final android.widget.LinearLayout listBox = new android.widget.LinearLayout(a);
            listBox.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            sv.addView(listBox);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 360)));

            final android.widget.TextView hint = new android.widget.TextView(a);
            hint.setTextSize(12);
            hint.setTextColor(0xFF888888);
            hint.setPadding(dp(a, 6), dp(a, 6), dp(a, 6), dp(a, 4));
            box.addView(hint);

            final Runnable[] rebuild = new Runnable[1];
            rebuild[0] = new Runnable() {
                @Override public void run() {
                    listBox.removeAllViews();
                    String raw = cfg().optString("monitorWords", "");
                    java.util.List<String> ws = new java.util.ArrayList<String>();
                    for (String w : raw.split("[,，]")) {
                        String ww = w.trim();
                        if (ww.length() > 0) ws.add(ww);
                    }
                    if (ws.isEmpty()) {
                        android.widget.TextView empty = new android.widget.TextView(a);
                        empty.setText("还没有关键词。在上方输入后点「添加」。\n\n聊天里出现这些词时会自动记录到「关键词监控」。");
                        empty.setTextSize(13);
                        empty.setTextColor(0xFF9A9AA3);
                        empty.setPadding(dp(a, 10), dp(a, 20), dp(a, 10), dp(a, 10));
                        listBox.addView(empty);
                    }
                    for (int m = 0; m < ws.size(); m++) {
                        final String word = ws.get(m);
                        android.widget.LinearLayout row = new android.widget.LinearLayout(a);
                        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                        row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                        row.setPadding(dp(a, 14), dp(a, 13), dp(a, 14), dp(a, 13));
                        android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
                        g.setColor(0xF7FFFFFF);
                        g.setCornerRadius(dp(a, 12));
                        row.setBackground(g);
                        android.widget.LinearLayout.LayoutParams lp =
                                new android.widget.LinearLayout.LayoutParams(-1, -2);
                        lp.bottomMargin = dp(a, 6);
                        row.setLayoutParams(lp);

                        android.widget.TextView tx = new android.widget.TextView(a);
                        tx.setText(word);
                        tx.setTextSize(15);
                        tx.setTextColor(0xFF1A1A1E);
                        row.addView(tx, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));

                        android.widget.TextView del = new android.widget.TextView(a);
                        del.setText("删除");
                        del.setTextSize(13);
                        del.setTextColor(0xFF07C160);
                        del.setPadding(dp(a, 8), dp(a, 4), dp(a, 4), dp(a, 4));
                        row.addView(del);

                        row.setOnClickListener(new android.view.View.OnClickListener() {
                            @Override public void onClick(android.view.View v) {
                                input.setText(word);
                                input.setSelection(word.length());
                            }
                        });
                        row.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                            @Override public boolean onLongClick(android.view.View v) {
                                removeWord(a, word, rebuild[0]);
                                return true;
                            }
                        });
                        listBox.addView(row);
                    }
                    hint.setText("共 " + ws.size() + " 个词　·　长按词可删除　·　点词可填入编辑");
                }
            };

            addBtn.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    String w = input.getText().toString().trim();
                    if (w.length() == 0) { toast("请输入关键词"); return; }
                    try {
                        org.json.JSONObject o = cfg();
                        String raw = o.optString("monitorWords", "");
                        java.util.List<String> ws = new java.util.ArrayList<String>();
                        for (String x : raw.split("[,，]")) { String xx = x.trim(); if (xx.length() > 0) ws.add(xx); }
                        for (String x : ws) {
                            if (x.equals(w)) { toast("已经有这个词了"); return; }
                        }
                        ws.add(w);
                        StringBuilder sb = new StringBuilder();
                        for (int m = 0; m < ws.size(); m++) { if (m > 0) sb.append(','); sb.append(ws.get(m)); }
                        o.put("monitorWords", sb.toString());
                        writeCfg(o);
                        input.setText("");
                        toast("已添加：" + w);
                        rebuild[0].run();
                    } catch (Throwable t) { log("MON|add err " + t); }
                }
            });
            rebuild[0].run();

            dlg = new android.app.AlertDialog.Builder(a)
                    .setTitle("监控词表")
                    .setView(box)
                    .setPositiveButton("完成", null)
                    .create();
            dlg.show();
        } catch (Throwable t) { log("MON|words err " + t); }
    }

    private static void removeWord(final android.app.Activity a, final String word, final Runnable after) {
        new android.app.AlertDialog.Builder(a)
                .setTitle("删除关键词")
                .setMessage("不再监控「" + word + "」？")
                .setPositiveButton("删除", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        try {
                            org.json.JSONObject o = cfg();
                            String raw = o.optString("monitorWords", "");
                            StringBuilder sb = new StringBuilder();
                            for (String x : raw.split("[,，]")) {
                                String xx = x.trim();
                                if (xx.length() == 0 || xx.equals(word)) continue;
                                if (sb.length() > 0) sb.append(',');
                                sb.append(xx);
                            }
                            o.put("monitorWords", sb.toString());
                            writeCfg(o);
                            toast("已删除：" + word);
                            if (after != null) after.run();
                        } catch (Throwable t) { log("MON|del err " + t); }
                    }
                })
                .setNegativeButton("取消", null).show();
    }


