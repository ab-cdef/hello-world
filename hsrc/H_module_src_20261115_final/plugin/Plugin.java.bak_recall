    private static int fileDbg = 0;

    /** 导出会话里的文件消息（type 49 且 appmsg/type=6） */
    private static int exportFileList(String talker) {
        int n = 0;
        long total = 0;
        try {
            java.util.regex.Pattern pTitle = java.util.regex.Pattern.compile("<title>(?:<!\\[CDATA\\[)?(.*?)(?:\\]\\]>)?</title>");
            java.util.regex.Pattern pLen = java.util.regex.Pattern.compile("<totallen>(\\d+)</totallen>");
            java.util.List<Object[]> rows = queryRows(
                    "select createTime, ifnull(content,''), ifnull(isSend,0) from message where talker='"
                            + escSql(talker) + "' and (type & 0xFFFF) = 49 order by createTime asc limit 5000", 3);
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            java.io.File f = new java.io.File(dir, "files_" + csv(displayOfTalker(talker)) + "_" + stamp + ".csv");
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            fw.write("\uFEFF时间,发送人,文件名,大小\n");
            for (Object[] r : rows) {
                String c = String.valueOf(r[1]);
                // 先取文件名与大小，再判断是不是真正的「文件」（标题必须带扩展名 + 有 totallen）
                String name = "";
                String size = "";
                long bytes = 0;
                try {
                    java.util.regex.Matcher mt = pTitle.matcher(c);
                    if (mt.find()) name = mt.group(1);
                    java.util.regex.Matcher ml = pLen.matcher(c);
                    if (ml.find()) { bytes = Long.parseLong(ml.group(1)); size = humanSize(bytes); }
                } catch (Throwable ignore) { }
                boolean isFile = bytes > 0 && name.matches(
                        "(?i).*\\.(pdf|docx?|xlsx?|pptx?|zip|rar|7z|txt|csv|mp4|mov|avi|mkv|jpg|jpeg|png|gif|webp|apk|wav|mp3|amr|silk|exe|psd|ai)$");
                if (!isFile) {
                    if (fileDbg < 2) { fileDbg++; log("FILELIST|skip name=" + name + " bytes=" + bytes); }
                    continue;
                }
                long ct = 0;
                try { ct = Long.parseLong(String.valueOf(r[0]).trim()); } catch (Throwable ignore) { }
                if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                boolean mine = "1".equals(String.valueOf(r[2]).trim());
                String who = mine ? "我" : displayOfTalker(senderIdOfGroupMsg(c));
                fw.write(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                        .format(new java.util.Date(ct)) + "," + csv(who) + ","
                        + csv(name) + "," + size + "\n");
                n++;
                try { total += Long.parseLong("0" + sizeToBytes(size)); } catch (Throwable ignore) { }
            }
            fw.close();
            askShare(f);
            log("FILELIST|talker=" + talker + " n=" + n + " path=" + f.getAbsolutePath());
        } catch (Throwable t) {
            log("FILELIST|err " + t);
        }
        return n;
    }

    private static String sizeToBytes(String s) {
        return "0";
    }

