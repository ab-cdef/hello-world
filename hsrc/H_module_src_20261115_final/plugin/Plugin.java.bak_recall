        android.widget.TextView arrow = new android.widget.TextView(a);
        arrow.setText("\u203a");
        arrow.setTextSize(18);
        arrow.setTextColor(0xFFC9C9CF);
        row.addView(arrow);
        row.setOnClickListener(l);
        return row;
    }

    private static void installPlusButton(ClassLoader app) {
        try {
            Class<?> v = Class.forName("android.view.View", false, app);
            XposedBridge.hookAllMethods(v, "performClick", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(final MethodHookParam p) {
                    try {
                        if (Boolean.TRUE.equals(skipPlus.get())) return;
                        Object o = p.thisObject;
                        if (!(o instanceof View)) return;
                        CharSequence d = ((View) o).getContentDescription();
                        if (d == null) return;
                        String ds = d.toString();
                        if (!ds.contains("更多功能") && !ds.contains("更多")) return;
                        final android.content.Context c = ((View) o).getContext();
                        if (!(c instanceof android.app.Activity)) return;
                        p.setResult(Boolean.TRUE);
                        showSettings((android.app.Activity) c);
                    } catch (Throwable t) {
                    }
                }
            });
            // 长按「+」也打开 H 菜单（多入口）
            try {
                final java.lang.reflect.Method mLong = v.getMethod("performLongClick");
                XposedBridge.hookMethod(mLong, new XC_MethodHook() {
                    @Override protected void beforeHookedMethod(final MethodHookParam p) {
                        try {
                            Object o = p.thisObject;
                            if (!(o instanceof View)) return;
                            CharSequence d = ((View) o).getContentDescription();
                            if (d == null) return;
                            String ds = d.toString();
                            if (!ds.contains("更多功能") && !ds.contains("更多")) return;
                            final android.content.Context c = ((View) o).getContext();
                            if (!(c instanceof android.app.Activity)) return;
                            p.setResult(Boolean.TRUE);
                            showSettings((android.app.Activity) c);
                        } catch (Throwable ignore) { }
                    }
                });
                log("ENTRY|plus longpress hooked");
            } catch (Throwable ignore) { }
            log("hooked plus button (chooser)");
            startScheduler();
            startAutoClean();
            // 资源探测延后到主界面出现时（此时一定能拿到 Context）
            try { installBubbleResHook(app); } catch (Throwable ignore) { }
            // BGHOOK 已停用：无消息类型信息，会误改文件卡片与系统提示
            try { installInflateBubbleHook(app); } catch (Throwable ignore) { }
            try {
                Class<?> ac = Class.forName("com.tencent.mm.pluginsdk.ui.tools.r0", false, app);
                hookChatAdapter(ac);
            } catch (Throwable t) { log("CHATAD|early " + t); }
            // installNeatDrawHook 已停用：MMNeat7extView 在标题栏/会话列表也在用，会全局染色
            probeLauncher(app);
        } catch (Throwable t) {
            log("plus btn err " + t);
        }
    }

    private static java.util.List<View> allRoots() {
        java.util.List<View> out = new java.util.ArrayList<View>();
        try {
            Class<?> wmg = Class.forName("android.view.WindowManagerGlobal");
            Object inst = wmg.getMethod("getInstance").invoke(null);
            java.lang.reflect.Field f = wmg.getDeclaredField("mViews");
            f.setAccessible(true);
            Object v = f.get(inst);
            if (v instanceof java.util.List) {
                for (Object o : (java.util.List<?>) v) {
                    if (o instanceof View) out.add((View) o);
                }
            }
        } catch (Throwable t) {
            log("allRoots err " + t);
        }
        return out;
    }

    private static android.widget.TextView findText(View v, String want) {
        try {
            if (v instanceof android.widget.TextView) {
                CharSequence t = ((android.widget.TextView) v).getText();
                if (t != null && want.equals(t.toString().trim())) return (android.widget.TextView) v;
            }
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.widget.TextView r = findText(g.getChildAt(i), want);
                    if (r != null) return r;
                }
            }
        } catch (Throwable t) {
        }
        return null;
    }

    /** 在微信消息菜单里插入「AI 分析」 */
    /** 通过 RecyclerView/adapter 取长按那条消息的原文 */
    private static String textByAdapter(android.view.View anchor) {
        try {
            android.app.Activity ca = chatAct;
            if (ca == null || anchor == null) return null;
            android.view.ViewGroup list = findMsgList(ca.getWindow().getDecorView());
            if (list == null) return null;
            android.view.View item = anchor;
            int guard = 0;
            while (item != null && item.getParent() != list && guard++ < 12) {
                android.view.ViewParent vp = item.getParent();
                if (!(vp instanceof android.view.View)) break;
                item = (android.view.View) vp;
            }
            if (item == null) return null;
            int pos = -1;
            try {
                Object p2 = list.getClass().getMethod("getChildAdapterPosition", android.view.View.class)
                        .invoke(list, item);
                if (p2 instanceof Integer) pos = (Integer) p2;
            } catch (Throwable ignore) { }
            if (pos < 0) {
                try {
                    Object p3 = list.getClass().getMethod("getPositionForView", android.view.View.class)
                            .invoke(list, item);
                    if (p3 instanceof Integer) pos = (Integer) p3;
                } catch (Throwable ignore) { }
            }
            Object adapter = null;
            try { adapter = list.getClass().getMethod("getAdapter").invoke(list); } catch (Throwable ignore) { }
            if (adapter == null || pos < 0) {
                log("TXTAD|no adapter pos=" + pos);
                return null;
            }
            Object obj = null;
            try {
                Object r = adapter.getClass().getMethod("getItem", int.class).invoke(adapter, pos);
                obj = r;
            } catch (Throwable ignore) { }
            if (obj == null) {
                log("TXTAD|no item pos=" + pos + " ad=" + adapter.getClass().getName());
                return null;
            }
            // 先试 getContent()
            try {
                Object c = obj.getClass().getMethod("getContent").invoke(obj);
                if (c instanceof CharSequence && ((CharSequence) c).length() > 0) return c.toString();
            } catch (Throwable ignore) { }
            Class<?> k = obj.getClass();
            while (k != null && k != Object.class) {
                for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                    String n = f.getName().toLowerCase();
                    if (!n.contains("content") && !n.contains("text")) continue;
                    if (f.getType() != String.class) continue;
                    try {
                        f.setAccessible(true);
                        Object v = f.get(obj);
                        if (v instanceof String && ((String) v).length() > 0) return (String) v;
                    } catch (Throwable ignore) { }
                }
                k = k.getSuperclass();
            }
            log("TXTAD|item cls=" + obj.getClass().getName());
        } catch (Throwable t) {
            log("TXTAD|err " + t);
        }
        return null;
    }

    /** 朋友圈转发（自实现）：长按动态 → 菜单里加「转发」→ 选会话发送文字 */
    private static volatile android.view.View menuAnchorView = null;
    private static volatile boolean savingFile = false;
