    /* ---- 月度收支报表 ---- */

    /** 从 message 表重建会话列表（清空后恢复用） */
    private static void rebuildConvList(final android.app.Activity a) {
        toast("正在重建会话列表…");
        new Thread(new Runnable() { @Override public void run() {
            int ok = 0, bad = 0;
            String err = "";
            try {
                java.util.List<Object[]> rows = queryRows(
                        "select talker, max(createTime) from message group by talker order by 2 desc limit 300", 2);
                for (Object[] r : rows) {
                    String tk = r[0] == null ? "" : String.valueOf(r[0]);
                    if (tk.length() == 0) continue;
                    long ct = 0;
                    try { ct = Long.parseLong(String.valueOf(r[1])); } catch (Throwable ignore) { }
                    if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                    String esc = tk.replace("'", "''");
                    try {
                        execSqlRaw("insert or ignore into rconversation(username, conversationTime, content, msgType, isSend, unReadCount) "
                                + "values('" + esc + "'," + ct + ",'',1,0,0)");
                        ok++;
                    } catch (Throwable t) { bad++; if (err.length() == 0) err = String.valueOf(t); }
                }
            } catch (Throwable t) { err = String.valueOf(t); }
            log("REBUILD|ok=" + ok + " bad=" + bad + " err=" + err);
            final int okf = ok, badf = bad;
            a.runOnUiThread(new Runnable() { @Override public void run() {
                toast(okf > 0 ? ("已恢复 " + okf + " 个会话") : "重建失败，见日志 REBUILD");
                if (okf > 0) refreshConvList();
            }});
        }}).start();
    }

    private static void showMonthlyReport(final android.app.Activity a) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.LinkedHashMap<String, long[]> byMonth =
                        new java.util.LinkedHashMap<String, long[]>();
                try {
                    // 红包
                    java.util.List<Object[]> hb = queryRows(
                            "select ifnull(receiveAmount,0), ifnull(receiveTime,0), ifnull(sender,'')"
                                    + " from WalletLuckyMoney order by receiveTime desc limit 1000", 3);
                    for (Object[] r : hb) {
                        long cent = pl(r[0]);
                        long ms = pl(r[1]);
                        if (ms > 0 && ms < 100000000000L) ms *= 1000L;
                        if (ms <= 0) continue;
                        String mon = monthKey(ms);
                        long[] v = byMonth.get(mon);
                        if (v == null) { v = new long[2]; byMonth.put(mon, v); }
                        String sender = r[2] == null ? "" : String.valueOf(r[2]).trim();
                        if (sender.length() > 0 && sender.equals(myWxidCached())) v[1] += cent;  // 支出
                        else v[0] += cent;                                                       // 收入
                    }
                    // 转账
                    java.util.List<Object[]> tr = queryRows(
                            "select ifnull(isSend,0), ifnull(receiveTime,0), ifnull(locaMsgId,0)"
                                    + " from RemittanceRecord order by receiveTime desc limit 1000", 3);
                    for (Object[] r : tr) {
                        long ms = pl(r[1]);
                        if (ms > 0 && ms < 100000000000L) ms *= 1000L;
                        long cent = 0;
                        if (ms <= 0) {
                            continue;
                        }
                        try {
                            long locaId = pl(r[2]);
                            cent = transferCentOfMsg(locaId);
                        } catch (Throwable ignore) { }
                        String mon = monthKey(ms);
                        long[] v = byMonth.get(mon);
                        if (v == null) { v = new long[2]; byMonth.put(mon, v); }
                        if (pl(r[0]) == 1) v[1] += cent; else v[0] += cent;
                    }
                } catch (Throwable t) { log("MREP|load err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() { showMonthlyPanel(a, byMonth); }
                });
            }
        }).start();
    }

    private static long pl(Object o) {
        try { return Long.parseLong(String.valueOf(o).trim()); } catch (Throwable t) { return 0; }
    }

    private static String monthKey(long ms) {
        return new java.text.SimpleDateFormat("yyyy-MM", java.util.Locale.US).format(new java.util.Date(ms));
    }

    private static void showMonthlyPanel(final android.app.Activity a,
                                         final java.util.LinkedHashMap<String, long[]> byMonth) {
        try {
            if (byMonth.isEmpty()) { toast("没有收支记录"); return; }
            java.util.ArrayList<String> keys = new java.util.ArrayList<String>(byMonth.keySet());
            java.util.Collections.sort(keys);
            java.util.Collections.reverse(keys);

            android.widget.TextView tv = new android.widget.TextView(a);
            tv.setTextSize(13);
            tv.setTypeface(android.graphics.Typeface.MONOSPACE);
            tv.setTextColor(0xFF141418);
            tv.setTextIsSelectable(true);
            int pad = dp(a, 12);
            tv.setPadding(pad, pad, pad, pad);

            StringBuilder sb = new StringBuilder();
            long totalIn = 0, totalOut = 0;
            for (String k : keys) {
                long[] v = byMonth.get(k);
                totalIn += v[0];
                totalOut += v[1];
                sb.append(k).append("   收入 ").append(String.format(java.util.Locale.US, "%8.2f", v[0] / 100.0))
                        .append("   支出 ").append(String.format(java.util.Locale.US, "%8.2f", v[1] / 100.0))
                        .append('\n');
            }
            sb.append("\n合计   收入 ").append(String.format(java.util.Locale.US, "%.2f", totalIn / 100.0))
                    .append("   支出 ").append(String.format(java.util.Locale.US, "%.2f", totalOut / 100.0))
                    .append("\n净额 ").append(String.format(java.util.Locale.US, "%.2f", (totalIn - totalOut) / 100.0));
            tv.setText(sb.toString());

            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            sv.addView(tv);

            new android.app.AlertDialog.Builder(a)
                    .setTitle("月度收支报表")
                    .setView(sv)
                    .setPositiveButton("复制", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                        a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", tv.getText().toString()));
                                toast("已复制");
                            } catch (Throwable ignore) { }
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { log("MREP|panel err " + t); }
    }

    private static String fmtMoney(long cent) {
        try {
            return String.format(java.util.Locale.US, "%.2f", cent / 100.0);
        } catch (Throwable t) { return String.valueOf(cent); }
    }

    /** 把 wxid / 微信号 换成昵称，换不到就原样返回 */
    private static String nameOf(String id) {
        try {
            if (id == null) return "";
            String v = id.trim();
            if (v.length() == 0) return "";
            String nm = displayOfTalker(v);
            if (nm != null && nm.length() > 0 && !nm.equals(v) && !nm.startsWith("wxid_")) return nm;
            // 按微信号/别名再找一次
            java.util.List<Object[]> r = queryRows(
                    "select ifnull(conRemark,''), ifnull(nickname,'') from rcontact where username='"
                            + escSql(v) + "' or alias='" + escSql(v) + "' limit 1", 2);
            if (!r.isEmpty()) {
                String rm = r.get(0)[0] == null ? "" : String.valueOf(r.get(0)[0]).trim();
                String nk = r.get(0)[1] == null ? "" : String.valueOf(r.get(0)[1]).trim();
                if (rm.length() > 0) return rm;
                if (nk.length() > 0) return nk;
            }
        } catch (Throwable ignore) { }
        return id;
    }

    /** 探针：列出与红包/转账相关的表和列（写日志） */
    private static void probeMoneyTables(Object db) {
        try {
            String[] names = {"RemittanceRecord", "WalletLuckyMoney", "WalletTransfer",
                    "WalletTransferRecord", "TransferRecord", "WalletRemit", "PayMsgRecord"};
            for (String t : names) {
                try {
                    Object cur = null;
                    for (Method m : db.getClass().getMethods()) {
                        if (!m.getName().equals("rawQuery")) continue;
                        Class<?>[] ps = m.getParameterTypes();
                        if (ps.length != 2 || ps[0] != String.class) continue;
                        Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                        m.setAccessible(true);
                        cur = m.invoke(db, "select * from " + t + " limit 1", arg);
                        break;
                    }
                    if (cur == null) { log("TBL|" + t + " null"); continue; }
                    android.database.Cursor c = (android.database.Cursor) cur;
                    StringBuilder sb = new StringBuilder();
                    for (String col : c.getColumnNames()) sb.append(col).append(',');
                    try { c.close(); } catch (Throwable ignore) { }
                    log("TBL|" + t + " cols=" + sb);
                } catch (Throwable e) {
                    log("TBL|" + t + " err=" + e);
                }
            }
        } catch (Throwable ignore) { }
    }

    private static String val(java.util.List<String> cols, String[] row, String name) {
        try {
            int i = cols.indexOf(name);
            if (i < 0 || i >= row.length) return "";
            return row[i] == null ? "" : row[i];
        } catch (Throwable t) { return ""; }
    }

    /** 导出好友列表 CSV */
    private static void exportFriends(final android.app.Activity a) {
        try {
            final Object db = dbRef;
            if (db == null) {
                toast("数据库未就绪，先收发一条消息");
                return;
            }
                new Thread(new Runnable() {
                @Override
                public void run() {
                    try {
                        Object cur = null;
                        for (Method m : db.getClass().getMethods()) {
                            if (!m.getName().equals("rawQuery")) continue;
                            Class<?>[] ps = m.getParameterTypes();
                            if (ps.length != 2 || ps[0] != String.class) continue;
                            Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                            m.setAccessible(true);
                            cur = m.invoke(db, "select username,nickname,conRemark,type from rcontact", arg);
                            break;
                        }
                        if (cur == null) {
                            toast("读取失败");
                            return;
                        }
                        StringBuilder sb = new StringBuilder("用户名,昵称,备注\n");
                        int n = 0;
                        Method mv = cur.getClass().getMethod("moveToNext");
                        Method gs = cur.getClass().getMethod("getString", int.class);
                        Method gi = cur.getClass().getMethod("getInt", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            String u = (String) gs.invoke(cur, 0);
                            String nick = (String) gs.invoke(cur, 1);
                            String rm = (String) gs.invoke(cur, 2);
                            int t = (Integer) gi.invoke(cur, 3);
                            if (u == null || u.endsWith("@chatroom") || u.startsWith("gh_")
                                    || u.contains("@app") || u.equals("filehelper")) continue;
                            if ((t & 1) == 0) continue;
                            sb.append(u).append(',').append(csv(nick)).append(',')
                                    .append(csv(rm)).append('\n');
                            n++;
                        }
                        try {
                            cur.getClass().getMethod("close").invoke(cur);
                        } catch (Throwable t) {
                        }
                        String fn = DIR + "/friends.csv";
                        java.io.FileOutputStream fo = new java.io.FileOutputStream(fn);
                        fo.write(sb.toString().getBytes("UTF-8"));
                        fo.close();
                        log("EXPORTFRIENDS|" + n);
                        final int fn2 = n;
                        a.runOnUiThread(new Runnable() {
                            @Override
                            public void run() {
                                toast("已导出 " + fn2 + " 位好友 → friends.csv");
                            }
                        });
                    } catch (Throwable t) {
                        log("exportFriends err " + t);
                    }
                }
            }).start();
        } catch (Throwable t) {
            log("exportFriends outer " + t);
        }
    }

    /**
     * 客户未回复定时提醒：每 2 小时扫一次「最后一条是我发的且超 24 小时」的会话，
     * 有新的就推一条系统通知（最多列 3 个名字）。
     */
    private static long followRemindAt = 0;
    private static String followRemindSig = "";

    private static void notifyFollowUpIfDue() {
        try {
            if (!cfg().optBoolean("followRemind", false)) return;
            long now = System.currentTimeMillis();
            if (now - followRemindAt < 2 * 3600L * 1000L) return;
            followRemindAt = now;
            if (inQuietHours()) { log("FREMIND|quiet"); return; }
            java.util.List<String[]> hits = followUpList(24, 8);
            if (hits.isEmpty()) { log("FREMIND|none"); return; }
            StringBuilder sig = new StringBuilder();
            StringBuilder names = new StringBuilder();
            for (int i = 0; i < hits.size(); i++) {
                sig.append(hits.get(i)[0]).append(';');
                if (i < 3) {
                    if (names.length() > 0) names.append('、');
                    names.append(hits.get(i)[1]);
                }
            }
            if (sig.toString().equals(followRemindSig)) { log("FREMIND|same"); return; }
            followRemindSig = sig.toString();
            String body = names + (hits.size() > 3 ? (" 等 " + hits.size() + " 个") : "")
                    + " 超过 24 小时没回，点开 H 设置 → 跟进清单";
            notifyLocal(mainAct != null ? mainAct : chatAct, "客户待跟进 " + hits.size() + " 个", body);
            log("FREMIND|n=" + hits.size() + " body=" + body);
        } catch (Throwable t) {
            log("FREMIND|err " + t);
        }
    }

    /**
     * 新客户首次对话提醒：磁盘里存一份「已知会话」清单，
     * 每次扫描发现清单外的新会话（最近 7 天内第一条消息）就推通知。
     */
    private static long newCustAt = 0;

    private static void notifyNewChatsIfDue() {
        try {
            if (!cfg().optBoolean("newCust", true)) return;
            long now = System.currentTimeMillis();
            if (now - newCustAt < 5 * 60L * 1000L) return;
            newCustAt = now;

            java.io.File f = new java.io.File(DIR, "newchat_seen.txt");
            java.util.HashSet<String> seen = new java.util.HashSet<String>();
            if (f.exists()) {
                java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
                String ln;
                while ((ln = br.readLine()) != null) {
                    ln = ln.trim();
                    if (ln.length() > 0) seen.add(ln);
                }
                br.close();
            }
            long since = now - 7 * 86400000L;
            java.util.List<Object[]> rows = queryRows(
                    "select talker, min(createTime) from message where createTime > " + since
                            + " group by talker", 2);
            java.util.List<String> fresh = new java.util.ArrayList<String>();
            java.util.List<String> all = new java.util.ArrayList<String>();
            for (Object[] r : rows) {
                String tk = String.valueOf(r[0]);
                if (tk == null || tk.length() == 0) continue;
                if (tk.endsWith("@chatroom")) continue;          // 只看私聊
                if (tk.startsWith("gh_") || "filehelper".equals(tk) || "weixin".equals(tk)) continue;
                all.add(tk);
                if (seen.isEmpty()) continue;
                if (!seen.contains(tk)) fresh.add(tk);
            }
            if (seen.isEmpty()) {
                // 首次运行：只建基线，不打扰
                java.io.FileWriter fw = new java.io.FileWriter(f, false);
                for (String tk : all) fw.write(tk + "\n");
                fw.close();
                log("NEWCUST|baseline=" + all.size());
                return;
            }
            if (fresh.isEmpty()) return;
            if (inQuietHours()) { log("NEWCUST|quiet n=" + fresh.size()); return; }
            StringBuilder names = new StringBuilder();
            for (int i = 0; i < fresh.size() && i < 3; i++) {
                if (names.length() > 0) names.append('、');
                names.append(displayOfTalker(fresh.get(i)));
            }
            String body = names + (fresh.size() > 3 ? (" 等 " + fresh.size() + " 位") : "") + " 首次联系你";
            notifyLocal(mainAct != null ? mainAct : chatAct, "新客户 " + fresh.size() + " 位", body);
            log("NEWCUST|n=" + fresh.size() + " body=" + body);
            java.io.FileWriter fw = new java.io.FileWriter(f, true);
            for (String tk : fresh) fw.write(tk + "\n");
            fw.close();
        } catch (Throwable t) {
            log("NEWCUST|err " + t);
        }
    }

    /** 返回 {{talker, 会话名, 未回小时}} */
    private static java.util.List<String[]> followUpList(int hours, int max) {
        java.util.List<String[]> out = new java.util.ArrayList<String[]>();
        try {
            long now = System.currentTimeMillis();
            long th = hours * 3600L * 1000L;
            java.util.List<Object[]> rows = queryRows(
                    "select username, conversationTime from rconversation"
                            + " where username not like 'gh_%' and username not in ('filehelper','weixin')"
                            + " order by conversationTime desc limit 300", 2);
            for (Object[] r : rows) {
                if (out.size() >= max) break;
                String tk = String.valueOf(r[0]);
                long ct = 0;
                try { ct = Long.parseLong(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                if (ct <= 0 || now - ct < th) continue;
                java.util.List<Object[]> last = queryRows(
                        "select isSend, createTime from message where talker='"
                                + tk.replace("'", "''") + "' order by createTime desc limit 1", 2);
                if (last.isEmpty()) continue;
                if (!"1".equals(String.valueOf(last.get(0)[0]).trim())) continue;
                long lct = 0;
                try { lct = Long.parseLong(String.valueOf(last.get(0)[1]).trim()); } catch (Throwable ignore) { }
                if (lct > 0 && lct < 100000000000L) lct *= 1000L;
                out.add(new String[]{tk, displayOfTalker(tk), String.valueOf((now - lct) / 3600000L)});
            }
        } catch (Throwable t) {
            log("FUPLIST|err " + t);
        }
        return out;
    }

