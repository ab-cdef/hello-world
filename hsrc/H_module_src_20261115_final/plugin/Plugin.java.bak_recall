                    // 名单类只显示人数，括号里的具体名单一律不展开
                    int pbr = val.indexOf('（');
                    if (pbr > 0) val = val.substring(0, pbr).trim();
                    android.widget.LinearLayout holder = new android.widget.LinearLayout(a);
                    holder.setOrientation(android.widget.LinearLayout.VERTICAL);
                    holder.setPadding(dp(a, 5), dp(a, 3), dp(a, 5), dp(a, 6));

                    android.widget.LinearLayout card = new android.widget.LinearLayout(a);
                    card.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                    card.setBackground(null);
                    card.setPadding(dp(a, 14), dp(a, 12), dp(a, 10), dp(a, 12));
                    card.setGravity(android.view.Gravity.CENTER_VERTICAL);
                    card.setMinimumHeight(dp(a, 48));
                    try { card.setElevation(0); } catch (Throwable ignore) { }

                    android.widget.LinearLayout texts = new android.widget.LinearLayout(a);
                    texts.setOrientation(android.widget.LinearLayout.VERTICAL);
                    android.widget.TextView name = new android.widget.TextView(a);
