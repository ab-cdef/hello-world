    /** 天气结果窗口：内容 + 发送到当前聊天 */
    private static void showWeatherResult(final android.app.Activity a, final String city, final String txt) {
        final String body = txt == null ? "" : txt;
        android.widget.ScrollView sv = new android.widget.ScrollView(a);
        android.widget.TextView tv = new android.widget.TextView(a);
        tv.setText(body);
        tv.setTextSize(12);
        tv.setTextColor(0xFF202020);
        tv.setTypeface(android.graphics.Typeface.MONOSPACE);
        tv.setTextIsSelectable(true);
        int pad = dp(a, 10);
        tv.setPadding(pad, pad, pad, pad);
        sv.addView(tv, new android.view.ViewGroup.LayoutParams(-1, -2));
        android.app.AlertDialog dlg = new android.app.AlertDialog.Builder(a)
                .setTitle(city + " · 天气")
                .setView(sv)
                .setPositiveButton("关闭", null)
                .setNegativeButton("复制", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        try {
                            android.content.ClipboardManager cm =
                                    (android.content.ClipboardManager) a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                            cm.setPrimaryClip(android.content.ClipData.newPlainText("weather", body));
                            toast("已复制");
                        } catch (Throwable ignore) { }
                    }
                })
                .setNeutralButton("发送到聊天", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        sendWeatherToChat(city, body);
                    }
                })
                .create();
        try { dlg.getWindow().setBackgroundDrawable(new android.graphics.drawable.ColorDrawable(0xE8FFFFFF)); } catch (Throwable ignore) { }
        dlg.show();
