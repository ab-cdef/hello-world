    /* ================= 悬浮输入栏 / 悬浮标题栏 ================= */
    private static volatile boolean chatFloatDone = false;
    private static volatile long chatFloatAt = 0;

    private static void applyChatFloat(android.app.Activity act) {
        try {
            if (act == null) return;
            boolean wantInput = cfg().optBoolean("chatFloatInput", false);
            boolean wantBar = cfg().optBoolean("chatFloatBar", false);
            if (!wantInput && !wantBar) return;
            if (System.currentTimeMillis() - chatFloatAt < 1500) return;
            chatFloatAt = System.currentTimeMillis();
            final android.view.View decor = act.getWindow().getDecorView();
            float d = act.getResources().getDisplayMetrics().density;
            int marg = (int) (8 * d), rad = (int) (16 * d);
            // 隐藏聊天输入栏的「语音」按钮
            if (cfg().optBoolean("hideVoiceBtn", false)) {
                try {
                    android.view.View footer0 = findViewByClass(decor, "ChatFooter", "ChattingFooter");
                    if (footer0 instanceof android.view.ViewGroup) {
                        java.util.ArrayList<android.view.View> all0 = new java.util.ArrayList<android.view.View>();
                        collectAllViews(footer0, all0, 0);
                        for (android.view.View v0 : all0) {
                            CharSequence cd0 = v0.getContentDescription();
                            if (cd0 == null) continue;
                            String d0 = cd0.toString();
                            if ((d0.contains("语音") || d0.contains("按住") || d0.toLowerCase().contains("voice"))
                                    && v0.getTag(0x0f0f0f73) == null) {
                                v0.setTag(0x0f0f0f73, "hide");
                                v0.setVisibility(android.view.View.GONE);
                                log("HIDEVOICE|" + d0);
                            }
                        }
                    }
                } catch (Throwable ignore) { }
            }
            if (wantInput) {
                android.view.View footer = findViewByClass(decor, "ChatFooter", "ChattingFooter");
                if (footer != null) {
                    android.view.ViewGroup parent = (android.view.ViewGroup) footer.getParent();
                    if (parent != null && footer.getTag(0x0f0f0f40) == null) {
                        footer.setTag(0x0f0f0f40, "float");
                        android.view.ViewGroup.LayoutParams lp = footer.getLayoutParams();
                        if (lp instanceof android.view.ViewGroup.MarginLayoutParams) {
                            ((android.view.ViewGroup.MarginLayoutParams) lp).leftMargin = marg;
                            ((android.view.ViewGroup.MarginLayoutParams) lp).rightMargin = marg;
                            ((android.view.ViewGroup.MarginLayoutParams) lp).bottomMargin = marg;
                            footer.setLayoutParams(lp);
                        }
                        android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
                        gd.setCornerRadius(rad);
                        gd.setColor(0xF2FFFFFF);
                        footer.setBackground(gd);
                        footer.setElevation(8 * d);
                        log("CHATFLOAT|input ok");
                    }
                }
            }
            if (wantBar) {
                final android.view.View bar = findViewByClass(decor, "MMActionBar", "ActionBar");
                if (bar != null && bar.getTag(0x0f0f0f41) == null) {
                    bar.setTag(0x0f0f0f41, "float");
                    android.view.ViewGroup.LayoutParams lp = bar.getLayoutParams();
                    if (lp instanceof android.view.ViewGroup.MarginLayoutParams) {
                        ((android.view.ViewGroup.MarginLayoutParams) lp).leftMargin = marg;
                        ((android.view.ViewGroup.MarginLayoutParams) lp).rightMargin = marg;
                        ((android.view.ViewGroup.MarginLayoutParams) lp).topMargin = marg;
                        bar.setLayoutParams(lp);
                    }
                    android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
                    gd.setCornerRadius(rad);
                    gd.setColor(0xF2FFFFFF);
                    bar.setBackground(gd);
                    bar.setElevation(6 * d);
                    log("CHATFLOAT|bar ok");
                }
            }
        } catch (Throwable t) { log("CHATFLOAT|err " + t); }
    }

    /** 按类名关键字向下找第一个匹配的 View */
    private static android.view.View findViewByClass(android.view.View v, String... keys) {
        try {
            if (v == null) return null;
            String cn = v.getClass().getName();
            for (String k : keys) if (cn.contains(k)) return v;
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.view.View r = findViewByClass(g.getChildAt(i), keys);
                    if (r != null) return r;
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /* ================= 多主题：完整主题包（WeKit 格式 zip：settings.json + images + icons） ================= */
    private static final String PACK_DIR = DIR + "/wxh_themes";

    private static java.io.File packRoot() {
        java.io.File d = new java.io.File(PACK_DIR);
        if (!d.exists()) d.mkdirs();
        return d;
    }

    private static String[] packNames() {
        try {
            java.io.File d = packRoot();
            String[] all = d.list();
            if (all == null) return new String[0];
            java.util.ArrayList<String> out = new java.util.ArrayList<String>();
            for (String n : all) {
                if (n.startsWith(".")) continue;
                java.io.File sub = new java.io.File(d, n);
                if (sub.isDirectory() && new java.io.File(sub, "settings.json").isFile()) out.add(n);
            }
            java.util.Collections.sort(out);
            return out.toArray(new String[0]);
        } catch (Throwable t) { return new String[0]; }
    }

    /** 切换到一个完整主题包：写 cfg + 清所有图片缓存，回微信即生效 */
    private static void applyFullPack(String name) {
        try {
            if (name == null || name.length() == 0) return;
            java.io.File d = new java.io.File(packRoot(), name);
            if (!new java.io.File(d, "settings.json").isFile()) { toast("主题包不完整：" + name); return; }
            JSONObject o = readCfg();
            o.put("themePack", d.getAbsolutePath());
            o.put("theme", true);
            o.put("pageTheme", true);
            o.put("themeChat", true);
            o.put("bubbleTheme", true);
            o.put("thDrawer", false);          // 抽屉功能一律关掉
            writeCfg(o);
            cfg = null; cfgAt = 0;
            pack = null; packAt = 0;
            weldBgCache = null; weldBgPath = null;
            try { pageRootBm.clear(); } catch (Throwable ignore) { }
            try { tabBgBm.clear(); } catch (Throwable ignore) { }
            toast("已切换主题包「" + name + "」\n进一次聊天页看效果");
            log("PACK|apply " + name);
        } catch (Throwable t) { toast("切换失败：" + t); log("PACK|apply err " + t); }
    }

    private static void deleteFullPack(String name) {
        try {
            java.io.File d = new java.io.File(packRoot(), name);
            if (!d.isDirectory()) return;
            killTree(d);
            toast("已删除主题包「" + name + "」");
            log("PACK|delete " + name);
        } catch (Throwable t) { toast("删除失败：" + t); }
    }

    private static void killTree(java.io.File f) {
        if (f == null) return;
        if (f.isDirectory()) {
            java.io.File[] cs = f.listFiles();
            if (cs != null) for (java.io.File c : cs) killTree(c);
        }
        f.delete();
    }

    /** 导入手机里的完整主题包 zip（含 settings.json）到 wxh_themes/<包名>，可存多套切换 */
    private static void importFullPack(final android.app.Activity a) {
        try {
            java.io.File ext = themeExtDir();
            java.io.File[] files = ext.listFiles();
            final java.util.ArrayList<java.io.File> zips = new java.util.ArrayList<java.io.File>();
            if (files != null) for (java.io.File f : files)
                if (f.isFile() && f.getName().toLowerCase().endsWith(".zip")) zips.add(f);
            if (zips.isEmpty()) { toast("把主题包 zip 放到\n" + ext.getAbsolutePath()); return; }
            final String[] names = new String[zips.size()];
            for (int i = 0; i < zips.size(); i++) names[i] = zips.get(i).getName();
            new android.app.AlertDialog.Builder(a)
                    .setTitle("导入哪个主题包")
                    .setItems(names, new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            final java.io.File zip = zips.get(w);
                            toast("导入中…");
                            new Thread(new Runnable() {
                                @Override public void run() {
                                    String msg;
                                    try {
                                        String nm = zip.getName();
                                        if (nm.toLowerCase().endsWith(".zip")) nm = nm.substring(0, nm.length() - 4);
                                        java.io.File dst = new java.io.File(packRoot(), nm);
                                        killTree(dst);
                                        dst.mkdirs();
                                        int n = unzipTo(zip, dst);
                                        // 有些包外面多套一层目录，往里找一层
                                        if (!new java.io.File(dst, "settings.json").isFile()) {
                                            java.io.File[] cs = dst.listFiles();
                                            if (cs != null && cs.length == 1 && cs[0].isDirectory()
                                                    && new java.io.File(cs[0], "settings.json").isFile()) {
                                                java.io.File inner = cs[0];
                                                java.io.File[] ins = inner.listFiles();
                                                if (ins != null) for (java.io.File x : ins)
                                                    x.renameTo(new java.io.File(dst, x.getName()));
                                                inner.delete();
                                            }
                                        }
                                        boolean ok = new java.io.File(dst, "settings.json").isFile();
                                        msg = ok ? ("已导入「" + nm + "」" + n + " 个文件，可用「切换主题包」选中")
                                                : "包结构不对（缺 settings.json）";
                                    } catch (Throwable t) { msg = "导入失败: " + t; }
                                    final String fmsg = msg;
                                    a.runOnUiThread(new Runnable() {
                                        @Override public void run() { toast(fmsg); log("PACK|import " + fmsg); }
                                    });
                                }
                            }).start();
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) { toast("导入失败 " + t); }
    }

    /* ================= 四页主题包管理（WCX ThemeStore 同款） ================= */
    private static final String TABTHEME_DIR = DIR + "/wxh_tabthemes";

    private static java.io.File tabThemeDir() {
        java.io.File d = new java.io.File(TABTHEME_DIR);
        if (!d.exists()) d.mkdirs();
        return d;
    }

    private static String[] tabThemeNames() {
        try {
            java.io.File d = tabThemeDir();
            String[] all = d.list();
            if (all == null) return new String[0];
            java.util.ArrayList<String> out = new java.util.ArrayList<String>();
            for (String n : all) {
                if (n.startsWith(".")) continue;
                java.io.File sub = new java.io.File(d, n);
                if (sub.isDirectory()) out.add(n);
            }
            java.util.Collections.sort(out);
            return out.toArray(new String[0]);
        } catch (Throwable t) { return new String[0]; }
    }

    /** 把当前四张图保存成命名主题 */
    private static void saveTabTheme(String name) {
        try {
            if (name == null || name.trim().length() == 0) return;
            name = name.trim().replace('/', '_').replace('\\', '_');
            java.io.File dst = new java.io.File(tabThemeDir(), name);
            if (!dst.exists()) dst.mkdirs();
            int n = 0;
            for (int i = 0; i < 4; i++) {
                java.io.File src = new java.io.File(DIR + "/tab_bg_" + i + ".jpg");
                if (!src.isFile()) continue;
                java.io.File to = new java.io.File(dst, i + ".jpg");
                copyFile(src, to);
                n++;
            }
            toast("已保存主题「" + name + "」(" + n + " 张)");
            log("TABTHEME|save " + name + " n=" + n);
        } catch (Throwable t) { toast("保存失败：" + t); }
    }

    /** 应用某个命名主题 */
    private static void applyTabTheme(String name) {
        try {
            java.io.File src = new java.io.File(tabThemeDir(), name);
            if (!src.isDirectory()) { toast("主题不存在"); return; }
            for (int i = 0; i < 4; i++) {
                java.io.File from = new java.io.File(src, i + ".jpg");
                java.io.File to = new java.io.File(DIR + "/tab_bg_" + i + ".jpg");
                if (from.isFile()) copyFile(from, to);
                else to.delete();
            }
            tabBgBm.clear();
            android.app.Activity a = chatAct != null ? chatAct : lastAct;
            if (a != null) decorateAllTabs(a);
            toast("已切换主题「" + name + "」");
            log("TABTHEME|apply " + name);
        } catch (Throwable t) { toast("切换失败：" + t); }
    }

    private static void deleteTabTheme(String name) {
        try {
            java.io.File d = new java.io.File(tabThemeDir(), name);
            if (!d.isDirectory()) return;
            java.io.File[] fs = d.listFiles();
            if (fs != null) for (java.io.File f : fs) f.delete();
            d.delete();
            toast("已删除主题「" + name + "」");
        } catch (Throwable t) { toast("删除失败：" + t); }
    }

    /** 导出当前四张图为 zip 到 Download/wxh/ */
    private static void exportTabTheme() {
        try {
            java.io.File out = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
            if (!out.exists()) out.mkdirs();
            String fn = "tabtheme_" + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US).format(new java.util.Date()) + ".zip";
            java.io.File zip = new java.io.File(out, fn);
            java.util.zip.ZipOutputStream zos = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(zip));
            int n = 0;
            for (int i = 0; i < 4; i++) {
                java.io.File f = new java.io.File(DIR + "/tab_bg_" + i + ".jpg");
                if (!f.isFile()) continue;
                zos.putNextEntry(new java.util.zip.ZipEntry(i + ".jpg"));
                java.io.FileInputStream in = new java.io.FileInputStream(f);
                byte[] buf = new byte[16384];
                int r;
                while ((r = in.read(buf)) > 0) zos.write(buf, 0, r);
                in.close();
                zos.closeEntry();
                n++;
            }
            zos.close();
            toast("已导出 " + n + " 张 → " + zip.getAbsolutePath());
            log("TABTHEME|export " + zip.getAbsolutePath());
        } catch (Throwable t) { toast("导出失败：" + t); }
    }

    private static void copyFile(java.io.File from, java.io.File to) throws Exception {
        java.io.FileInputStream in = new java.io.FileInputStream(from);
        java.io.FileOutputStream os = new java.io.FileOutputStream(to, false);
        byte[] buf = new byte[16384];
        int r;
        while ((r = in.read(buf)) > 0) os.write(buf, 0, r);
        os.close();
        in.close();
    }

    /** 导入 zip 主题 */
    private static final int REQ_PICK_TABZIP = 0x7A20;
    private static volatile boolean zipHook = false;
    private static void installZipHook() {
        if (zipHook) return;
        zipHook = true;
        try {
            XposedBridge.hookAllMethods(android.app.Activity.class, "onActivityResult", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam pm) {
                    try {
                        int req = (Integer) pm.args[0], res = (Integer) pm.args[1];
                        Object data = pm.args[2];
                        if (req != REQ_PICK_TABZIP || res != android.app.Activity.RESULT_OK || data == null) return;
                        android.net.Uri uri = ((android.content.Intent) data).getData();
                        if (uri == null) return;
                        android.content.Context ctx = (android.content.Context) pm.thisObject;
                        java.io.InputStream in = ctx.getContentResolver().openInputStream(uri);
                        java.util.zip.ZipInputStream zin = new java.util.zip.ZipInputStream(in);
                        int n = 0;
                        java.util.zip.ZipEntry e;
                        while ((e = zin.getNextEntry()) != null) {
                            String nm = e.getName();
                            if (!nm.matches("[0-3]\\.jpg")) continue;
                            java.io.FileOutputStream os = new java.io.FileOutputStream(
                                    new java.io.File(DIR + "/tab_bg_" + nm.charAt(0) + ".jpg"), false);
                            byte[] buf = new byte[16384];
                            int r;
                            while ((r = zin.read(buf)) > 0) os.write(buf, 0, r);
                            os.close();
                            n++;
                        }
                        zin.close();
                        tabBgBm.clear();
                        if (pm.thisObject instanceof android.app.Activity)
                            decorateAllTabs((android.app.Activity) pm.thisObject);
                        toast("已导入 " + n + " 张背景图");
                        log("TABTHEME|import n=" + n);
                    } catch (Throwable t) { log("TABTHEME|import err " + t); }
                }
            });
            log("TABTHEME|zip hook installed");
        } catch (Throwable t) { log("TABTHEME|zip hook err " + t); }
    }

    private static void importTabTheme(android.app.Activity a) {
        try {
            installZipHook();
            android.content.Intent it = new android.content.Intent(android.content.Intent.ACTION_GET_CONTENT);
            it.setType("application/zip");
            it.addCategory(android.content.Intent.CATEGORY_OPENABLE);
            a.startActivityForResult(android.content.Intent.createChooser(it, "选择主题 zip"), REQ_PICK_TABZIP);
        } catch (Throwable t) { toast("打开失败：" + t); }
    }

    /** 给第 pos 页贴/更新背景图 */
    private static final java.util.WeakHashMap<android.view.View, android.graphics.drawable.Drawable> tabBgOv =
            new java.util.WeakHashMap<android.view.View, android.graphics.drawable.Drawable>();

    /**
     * 给第 pos 页贴背景：用 ViewOverlay 绘制，不参与布局 —— 只覆盖视觉，绝不影响页面内容。
     * （之前用 addView 塞 ImageView 会把 LinearLayout 页面挤出屏幕，导致列表整块空白）
     */
    private static boolean wxRvDumped = false;

    private static void decorateTabPage(android.app.Activity a, android.view.View page, int pos) {
        try {
            if (page == null) return;
            // 覆盖层功能已删除：清理历史遗留的 ViewOverlay 叠图
            try {
                android.graphics.drawable.Drawable ovd = tabBgOv.remove(page);
                if (ovd != null) page.getOverlay().remove(ovd);
                page.getOverlay().clear();
            } catch (Throwable ignore) { }
            if (true) return;
            String path = themePageImg(pos == 0 ? "MainFragmentBackground"
                    : pos == 1 ? "ContactFragmentBackground"
                    : pos == 2 ? "DiscoverFragmentBackground" : "MeFragmentBackground");
            if (pos == 1 && !wxRvDumped) {
                wxRvDumped = true;
                try {
                    StringBuilder sb = new StringBuilder();
                    java.util.ArrayList<android.view.View> all =
                            new java.util.ArrayList<android.view.View>();
                    collectAllViews(page, all, 0);
                    for (android.view.View v : all) {
                        String cn2 = v.getClass().getName();
                        if (!cn2.contains("WxRecyclerView") && !cn2.toLowerCase().contains("recycler")) continue;
                        sb.append(cn2).append(" ad=");
                        try {
                            Object ad0 = v.getClass().getMethod("getAdapter").invoke(v);
                            sb.append(ad0 == null ? "null" : ad0.getClass().getName());
                        } catch (Throwable ignore) { sb.append("?"); }
                        sb.append(' ');
                    }
                    log("WXRV|" + sb);
                } catch (Throwable ignore) { }
            }
            android.view.ViewOverlay ov = page.getOverlay();
            android.graphics.drawable.Drawable old = tabBgOv.get(page);
            if (path == null) {
                if (old != null) { try { ov.remove(old); } catch (Throwable ignore) { } tabBgOv.remove(page); }
                return;
            }
            int alpha = cfg().optInt("tabBgAlpha", 38);
            if (alpha <= 0) {
                if (old != null) { try { ov.remove(old); } catch (Throwable ignore) { } tabBgOv.remove(page); }
                return;
            }
            if (old instanceof android.graphics.drawable.BitmapDrawable) {
                old.setAlpha(alpha);
                return;
            }
            if (old != null) { try { ov.remove(old); } catch (Throwable ignore) { } }
            android.graphics.Bitmap bm = decodeFileCached2(path);
            if (bm == null) return;
            android.graphics.drawable.BitmapDrawable bd =
                    new android.graphics.drawable.BitmapDrawable(a.getResources(), bm);
            bd.setGravity(android.view.Gravity.FILL);
            bd.setAlpha(alpha);
            ov.add(bd);
            tabBgOv.put(page, bd);
            log("TABBG|page" + pos + " " + new java.io.File(path).getName() + " a=" + alpha);
        } catch (Throwable t) { log("TABBG|err page" + pos + " " + t); }
    }


    private static final java.util.HashMap<String, android.graphics.Bitmap> tabBgBm =
            new java.util.HashMap<String, android.graphics.Bitmap>();
    private static android.graphics.Bitmap decodeFileCached2(String path) {
        try {
            android.graphics.Bitmap c = tabBgBm.get(path);
            if (c != null && !c.isRecycled()) return c;
            android.graphics.BitmapFactory.Options o = new android.graphics.BitmapFactory.Options();
            o.inSampleSize = 2;
            o.inPreferredConfig = android.graphics.Bitmap.Config.RGB_565;
            android.graphics.Bitmap b = android.graphics.BitmapFactory.decodeFile(path, o);
            if (b != null) tabBgBm.put(path, b);
            return b;
        } catch (Throwable t) { return null; }
    }

    private static android.view.ViewGroup tabPager = null;
    private static volatile boolean pagerAddHooked = false;
    private static volatile boolean pagerSwitchHooked = false;

    /** 切 tab 后重新清一次行背景（否则只有 resume 那一拍生效） */
    private static void hookPagerSwitch(final android.view.ViewGroup pager) {
        if (pagerSwitchHooked || pager == null) return;
        pagerSwitchHooked = true;
        try {
            XposedBridge.hookAllMethods(pager.getClass(), "setCurrentItem", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam pm) {
                    try {
                        Object ctx = pager.getContext();
                        if (!(ctx instanceof android.app.Activity)) return;
                        final android.app.Activity act = (android.app.Activity) ctx;
                        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
                        final int[] ds = {500, 1500};
                        for (final int d : ds) {
                            h.postDelayed(new Runnable() {
                                @Override public void run() {
                                    try {
                                        android.view.ViewGroup pg = tabPager;
                                        if (pg == null) return;
                                        int n = 0;
                                        if (pg.getChildCount() > 0) n += themeClearRows(pg.getChildAt(0), 0);
                                        if (n > 0) log("THEMESW|cleared=" + n);
                                    } catch (Throwable ignore) { }
                                }
                            }, d);
                        }
                    } catch (Throwable ignore) { }
                }
            });
            log("THEMESW|hooked setCurrentItem");
        } catch (Throwable t) { log("THEMESW|err " + t); }
    }

    /** 给四页整体贴图（页面重建/切页时都可调用） */
    private static void decorateAllTabs(final android.app.Activity a) {
        try {
            android.view.ViewGroup pager = tabPager;
            if (pager == null) {
                pager = findPager(a.getWindow().getDecorView());
                tabPager = pager;
            }
            if (pager == null) return;
            try { hookPagerSwitch(pager); } catch (Throwable ignore) { }
            if (!pagerAddHooked) {
                pagerAddHooked = true;
                try {
                    XposedBridge.hookAllMethods(pager.getClass(), "addView", new XC_MethodHook() {
                        @Override protected void afterHookedMethod(MethodHookParam pm) {
                            try {
                                Object ch0 = pm.args.length > 0 ? pm.args[0] : null;
                                if (!(ch0 instanceof android.view.View)) return;
                                android.view.ViewGroup c = (android.view.ViewGroup) pm.thisObject;
                                int idx = c.indexOfChild((android.view.View) ch0);
                                if (idx >= 0 && idx <= 3) {
                                    decorateTabPage(chatAct != null ? chatAct : lastAct, (android.view.View) ch0, idx);
                                }
                            } catch (Throwable ignore) { }
                        }
                    });
                    log("TABBG|addView hooked");
                } catch (Throwable ignore) { }
            }
            for (int i = 0; i < pager.getChildCount() && i <= 3; i++) {
                decorateTabPage(a, pager.getChildAt(i), i);
            }
            try { installSettingsEntry(a); } catch (Throwable ignore) { }
            try { autoBackupTick(a); } catch (Throwable ignore) { }
            try { autoDailyTick(a); } catch (Throwable ignore) { }
            try { silentTick(a); } catch (Throwable ignore) { }
            final android.app.Activity fa = a;
            for (long d : new long[]{300L, 1200L, 3000L}) {
                pager.postDelayed(new Runnable() {
                    @Override public void run() {
                        try {
                            android.view.ViewGroup p2 = tabPager;
                            if (p2 == null) return;
                            for (int i = 0; i < p2.getChildCount() && i <= 3; i++)
                                decorateTabPage(fa, p2.getChildAt(i), i);
                        } catch (Throwable ignore) { }
                    }
                }, d);
            }
        } catch (Throwable t) { log("TABBG|all err " + t); }
    }

    /** 进聊天页时把背景层藏起来，回来再显示（WCX 同款处理） */
    private static void setTabBgVisible(boolean vis) {
        // overlay 层随页面一起隐藏，无需额外处理（保留接口供调用）
    }

    /** 第 idx 个界面用的主题图（不够就循环取） */

    /** 按当前页切换浮窗里的背景图（交叉淡入，避免"上一页闪一下"） */

    private static void showTintWindow(android.app.Activity a) {
        if (true) return;         // 按用户要求：不使用任何悬浮窗，四页保持微信原生
        try {
            if (a == null) return;
            // 只有主界面在前台、且拥有窗口焦点时才允许出现
            if (!a.getClass().getName().contains("LauncherUI")) return;
            try {
                android.app.Activity tp = topAct;
                // 必须就是这个 LauncherUI 实例在最前（设置页/朋友圈/小程序等覆盖时不显示）
                boolean otherTop = tp != null && tp != a
                        && !tp.getClass().getName().contains("LauncherUI");
                if (otherTop) { hideTintWindow(); return; }
            } catch (Throwable ignore) { }
            if (!themeOn()) { hideTintWindow(); return; }
            int alpha = cfg().optInt("tintAlpha", 96);
            if (alpha <= 0) { hideTintWindow(); return; }
            if (tintFull != null) {
                try {
                    ((android.widget.ImageView) tintFull).setImageAlpha(alpha);
                    tintFull.setAlpha(1f);
                    if (tintWm != null && tintLp != null) tintWm.updateViewLayout(tintFull, tintLp);
                } catch (Throwable ignore) { }
                return;
            }
            // 每页一张图：取主题包 images 目录里第 N 张
            android.graphics.Bitmap bm = themeBmForPage(0);
            if (bm == null) bm = weldBg(a);
            if (bm == null) return;
            tintWm = (android.view.WindowManager) a.getSystemService(android.content.Context.WINDOW_SERVICE);
            if (tintWm == null) return;
            android.widget.ImageView iv = new android.widget.ImageView(a);
            iv.setScaleType(android.widget.ImageView.ScaleType.CENTER_CROP);
            iv.setImageBitmap(bm);
            iv.setImageAlpha(alpha);
            iv.setClickable(false);
            iv.setFocusable(false);
            android.view.WindowManager.LayoutParams lp = new android.view.WindowManager.LayoutParams();
            lp.type = android.view.WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY;
            lp.format = android.graphics.PixelFormat.TRANSLUCENT;
            lp.flags = android.view.WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
                    | android.view.WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
                    | android.view.WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
                    | android.view.WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS;
            lp.width = android.view.WindowManager.LayoutParams.MATCH_PARENT;
            lp.height = android.view.WindowManager.LayoutParams.MATCH_PARENT;
            lp.gravity = android.view.Gravity.TOP | android.view.Gravity.START;
            try {
                tintWm.addView(iv, lp);
                tintFull = iv;
                tintLp = lp;
                log("TINTWIN|added a=" + alpha + " type=" + lp.type);
            }
            catch (Throwable t) { log("TINTWIN|err " + t); }
        } catch (Throwable t) { log("TINTWIN|err2 " + t); }
    }

    private static void hideTintWindow() {
        try {
            if (tintWm != null && tintFull != null) tintWm.removeView(tintFull);
        } catch (Throwable ignore) { }
        tintFull = null;
    }


    /** 主题包 images 目录里的图片列表（按名字排序） */
    private static java.util.List<java.io.File> themeImages() {
        java.util.ArrayList<java.io.File> out = new java.util.ArrayList<java.io.File>();
        try {
            java.io.File dir = new java.io.File(mmBase() + "/files/wxh_theme/images");
            java.io.File[] fs = dir.listFiles();
            if (fs == null) return out;
            for (java.io.File f : fs) {
                String n = f.getName().toLowerCase();
                if (!(n.endsWith(".png") || n.endsWith(".jpg") || n.endsWith(".jpeg")
                        || n.endsWith(".webp"))) continue;
                if (n.contains("bubble") || n.contains("drawer")) continue;   // 气泡/抽屉图不算
                out.add(f);
            }
            java.util.Collections.sort(out, new java.util.Comparator<java.io.File>() {
                @Override public int compare(java.io.File x, java.io.File y) {
                    return x.getName().compareTo(y.getName());
                }
            });
        } catch (Throwable ignore) { }
        return out;
    }

    /** 第 idx 个界面用的主题图（不够就循环取） */
    /** fragment 对应的页面序号（0 微信 / 1 通讯录 / 2 发现 / 3 我） */
    private static int pageIdxOfKey(String key) {
        if (key == null) return 0;
        if (key.startsWith("Contact")) return 1;
        if (key.startsWith("Discover")) return 2;
        if (key.startsWith("Me")) return 3;
        return 0;
    }

    /** 给页面根铺一层主题图前景：白块会被染成主题色而不是纯白（不拦截任何触摸） */
    private static void applyPageTint(android.view.View root, int pageIdx) {
        try {
            if (root == null) return;
            int a = cfg().optInt("pageTintA", 120);
            if (a <= 0) return;
            Object done = root.getTag(0x0f0f0f61);
            if (done != null) {
                android.graphics.drawable.Drawable fg = root.getForeground();
                if (fg != null) { fg.setAlpha(a); return; }
            }
            android.graphics.Bitmap bm = themeBmForPage(pageIdx);
            if (bm == null) return;
            android.graphics.drawable.BitmapDrawable d =
                    new android.graphics.drawable.BitmapDrawable(root.getResources(), bm);
            d.setAlpha(a);
            d.setGravity(android.view.Gravity.FILL);
            root.setForeground(d);
            root.setTag(0x0f0f0f61, Boolean.TRUE);
            log("pagetint|" + pageIdx + "|a=" + a);
        } catch (Throwable ignore) { }
    }

    private static android.graphics.Bitmap themeBmForPage(int idx) {
        try {
            Integer key = Integer.valueOf(idx);
            android.graphics.Bitmap cached = pageBmCache.get(key);
            if (cached != null && !cached.isRecycled()) return cached;
            // 四个 tab 页优先用 page0~page3（一页一张），不走"目录里随便挑"的老逻辑
            try {
                java.io.File d0 = new java.io.File(mmBase() + "/files/wxh_theme/images");
                String[] e0 = {".jpg", ".png", ".jpeg", ".webp"};
                for (String e : e0) {
                    java.io.File pf = new java.io.File(d0, "page" + idx + e);
                    if (!pf.exists()) continue;
                    android.graphics.BitmapFactory.Options o0 = new android.graphics.BitmapFactory.Options();
                    o0.inPreferredConfig = android.graphics.Bitmap.Config.ARGB_8888;
                    android.graphics.Bitmap b0 = android.graphics.BitmapFactory.decodeFile(pf.getAbsolutePath(), o0);
                    if (b0 != null) {
                        pageBmCache.put(key, b0);
                        log("PAGEBM|" + idx + "|" + pf.getName() + "|" + b0.getWidth() + "x" + b0.getHeight());
                        return b0;
                    }
                }
