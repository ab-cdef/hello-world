    private static void installSnsForwardX(ClassLoader app) {
        try {
            Class<?> act = Class.forName("android.app.Activity", false, app);
            XposedBridge.hookAllMethods(act, "startActivityForResult", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (System.currentTimeMillis() > traceUntil) return;
                        Object a0 = p.args != null && p.args.length > 0 ? p.args[0] : null;
                        if (!(a0 instanceof android.content.Intent)) return;
                        android.content.Intent it = (android.content.Intent) a0;
                        StringBuilder sb = new StringBuilder();
                        if (it.getExtras() != null) {
                            for (String k : it.getExtras().keySet()) {
                                sb.append(k).append('=').append(it.getExtras().get(k)).append(" ; ");
                            }
                        }
                        String comp = String.valueOf(it.getComponent());
                        if (comp.contains("MvvmContactListUI")) {
                            try {
                                lastGroupIntent = new android.content.Intent(it);
                                log("GROUP|captured");
                            } catch (Throwable ignore) { }
                        }
                        log("START|" + comp + " extras=" + sb);
                    } catch (Throwable ignore) { }
                }
            });
            XposedBridge.hookAllMethods(act, "onResume", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        lastActClass = p.thisObject.getClass().getName();
