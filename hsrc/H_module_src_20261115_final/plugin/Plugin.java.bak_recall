    /* ================= 精确跳转 + 定位（自己算位置，不依赖微信参数） ================= */
    private static Object adapterOf(android.view.View list) {
        try { return list.getClass().getMethod("getAdapter").invoke(list); } catch (Throwable ignore) { }
        return null;
    }

    private static int countOfAdapter(Object ad) {
        if (ad == null) return 0;
        try {
            Object v = ad.getClass().getMethod("getItemCount").invoke(ad);
            if (v instanceof Integer) return (Integer) v;
        } catch (Throwable ignore) { }
        try {
            Object v = ad.getClass().getMethod("getCount").invoke(ad);
            if (v instanceof Integer) return (Integer) v;
        } catch (Throwable ignore) { }
        return 0;
    }

    private static Object itemAt(Object ad, int pos) {
        if (ad == null || pos < 0) return null;
        try { return ad.getClass().getMethod("getItem", int.class).invoke(ad, pos); } catch (Throwable ignore) { }
        return null;
    }

    private static String itemContent(Object item) {
        if (item == null) return null;
        try {
            Object c = item.getClass().getMethod("getContent").invoke(item);
            if (c instanceof CharSequence) return c.toString();
        } catch (Throwable ignore) { }
        return null;
    }

    private static long itemCreateTime(Object item) {
        if (item == null) return 0;
        for (String mn : new String[]{"getCreateTime", "getMsgTime"}) {
            try {
                Object v = item.getClass().getMethod(mn).invoke(item);
                if (v instanceof Long) {
                    long t = (Long) v;
                    return t > 100000000000L ? t : t * 1000L;
                }
            } catch (Throwable ignore) { }
        }
        return 0;
    }

    private static void scrollListTo(android.view.View list, int pos) {
        try {
            Object lm = list.getClass().getMethod("getLayoutManager").invoke(list);
            if (lm != null) {
                try {
                    lm.getClass().getMethod("scrollToPositionWithOffset", int.class, int.class)
                            .invoke(lm, pos, list.getHeight() / 3);
                    return;
                } catch (Throwable ignore) { }
            }
        } catch (Throwable ignore) { }
        try { list.getClass().getMethod("scrollToPosition", int.class).invoke(list, pos); } catch (Throwable ignore) { }
    }


    /** 取当前真正在前台的 Activity（跳转会新建 Activity，旧引用里没有列表） */
    private static android.app.Activity curAct(android.app.Activity fallback) {
        try {
            if (topAct != null && !topAct.isFinishing()) return topAct;
            if (chatAct != null && !chatAct.isFinishing()) return chatAct;
        } catch (Throwable ignore) { }
        return fallback;
    }

    /** 在聊天列表里找一条消息的下标：先按 id，再按正文+时间 */
    private static int findPosInList(android.view.View list, long msgId, String text, long tsMs) {
        try {
            Object ad = adapterOf(list);
            int n = countOfAdapter(ad);
            String key = text == null ? null : text.trim();
            if (key != null && key.length() > 24) key = key.substring(0, 24);
            for (int i = 0; i < n; i++) {
                Object item = itemAt(ad, i);
                if (item == null) continue;
                long id = itemMsgId(item);
                if (msgId > 0 && id == msgId) return i;
                if (msgId <= 0 && key != null && key.length() >= 4) {
                    String body = itemContent(item);
                    if (body != null && body.indexOf(key) >= 0) {
                        long ct = itemCreateTime(item);
                        if (tsMs <= 0 || ct <= 0 || Math.abs(ct - tsMs) < 180000L) return i;
                    }
                }
            }
        } catch (Throwable t) { log("LOC|find err " + t); }
        return -1;
    }

    private static void locateAndHighlight(final android.app.Activity a, final long msgId,
                                           final String text, final long tsMs) {
        locateAndHighlight(a, msgId, text, tsMs, false);
    }



    private static volatile boolean painted = false;

    private static String normKey(String text) {
        if (text == null) return null;
        String t = text.replace("\n", "").replace(" ", "").replace("\u3000", "").trim();
        if (t.length() > 24) t = t.substring(0, 24);
        return t.length() >= 4 ? t : null;
    }

    private static String rowAllText(android.view.View row) {
        try {
            java.util.List<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectViews(row, all, 0);
            StringBuilder sb = new StringBuilder();
            for (android.view.View v : all) {
                if (!(v instanceof android.widget.TextView)) continue;
                CharSequence c = ((android.widget.TextView) v).getText();
                if (c == null) continue;
                sb.append(c.toString().replace("\n", "").replace(" ", ""));
            }
            return sb.toString();
        } catch (Throwable t) { return null; }
    }


    /** 目标时间在聊天里可能显示的几种写法 */
    private static String[] timeCandidates(long tsMs) {
        try {
            if (tsMs <= 0) return new String[0];
            if (tsMs < 100000000000L) tsMs *= 1000L;
            java.util.Date d = new java.util.Date(tsMs);
            String[][] fmts = {
                    {"yyyy/M/d HH:mm:ss"}, {"yyyy/MM/dd HH:mm:ss"},
                    {"yyyy-M-d HH:mm:ss"}, {"yyyy-MM-dd HH:mm:ss"},
                    {"MM-dd HH:mm:ss"}, {"M-d HH:mm:ss"},
                    {"yyyy/M/d HH:mm"}, {"yyyy-MM-dd HH:mm"},
                    {"MM-dd HH:mm"}, {"HH:mm:ss"}
            };
            java.util.ArrayList<String> out = new java.util.ArrayList<String>();
            for (String[] f : fmts) {
                try {
                    out.add(new java.text.SimpleDateFormat(f[0], java.util.Locale.US).format(d));
                } catch (Throwable ignore) { }
            }
            return out.toArray(new String[0]);
        } catch (Throwable t) { return new String[0]; }
    }

    /** 用「屏幕上显示的那条消息时间」锁行 */
    private static android.view.View findRowByDisplayedTime(android.app.Activity a, long tsMs) {
        try {
            String[] cands = timeCandidates(tsMs);
            if (cands.length == 0) return null;
            android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (!(list instanceof android.view.ViewGroup)) return null;
            android.view.ViewGroup g = (android.view.ViewGroup) list;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View row = g.getChildAt(i);
                String t = rowAllText(row);
                if (t == null) continue;
                for (String c : cands) {
                    if (c.length() >= 5 && t.indexOf(c) >= 0) {
                        log("LOC|time hit idx=" + i + " by=" + c);
                        return row;
                    }
                }
            }
        } catch (Throwable t) { log("LOC|time err " + t); }
        return null;
    }

    /** 用屏幕上真实显示的文字找那一行（比 adapter 数据可靠） */
    private static android.view.View findVisibleRowByText(android.app.Activity a, String text, long tsMs) {
        try {
            String key = normKey(text);
            if (key == null) return null;
            android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (!(list instanceof android.view.ViewGroup)) return null;
            Object ad = adapterOf(list);
            android.view.ViewGroup g = (android.view.ViewGroup) list;
            android.view.View fallback = null;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View row = g.getChildAt(i);
                String t = rowAllText(row);
                if (t == null || t.indexOf(key) < 0) continue;
                // 时间戳先缩小范围：±3 分钟内才算同一条
                long rts = 0;
                try {
                    Object p0 = list.getClass().getMethod("getChildAdapterPosition", android.view.View.class)
                            .invoke(list, row);
                    if (p0 instanceof Integer && ad != null) {
                        rts = itemCreateTime(itemAt(ad, (Integer) p0));
                    }
                } catch (Throwable ignore) { }
                if (tsMs > 0 && rts > 0 && Math.abs(rts - tsMs) > 180000L) {
                    if (fallback == null) fallback = row;
                    continue;
                }
                log("LOC|visible hit idx=" + i + " rts=" + rts + " ts=" + tsMs);
                return row;
            }
            if (fallback != null) {
                log("LOC|visible fallback (time mismatch)");
                return fallback;
            }
        } catch (Throwable t) { log("LOC|vis err " + t); }
        return null;
    }

    private static void paintRow(final android.app.Activity a, android.view.View row) {
        try {
            if (row == null) return;
            final android.view.View frow = row;
            row.setForeground(makeHlFrame(a));
            row.requestLayout();
            row.invalidate();
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() { try { frow.setForeground(null); } catch (Throwable ignore) { } }
            }, 3800L);
            painted = true;
            log("LOC|paint row");
        } catch (Throwable t) { log("LOC|paint err " + t); }
    }




    /** A 方案：复制消息 + 打开会话，让用户用微信自带的「查找聊天记录」粘一下定位 */
    private static void openAndCopy(final android.app.Activity a, String talker, String text) {
        try {
            if (text != null && text.trim().length() > 0) {
                android.content.ClipboardManager cm = (android.content.ClipboardManager)
                        a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", text.trim()));
            }
            if (talker != null && talker.length() > 0) zOpenChat(a, talker);
            toast("已复制这条消息\n点右上角「…」→ 查找聊天记录 → 粘贴即可定位");
            log("COPYJUMP|" + talker + " len=" + (text == null ? 0 : text.length()));
        } catch (Throwable t) { log("COPYJUMP|err " + t); toast("操作失败：" + t); }
    }

    /* ================= 用微信自己的「查找聊天记录」定位 ================= */
    private static android.view.View findClickableByText(android.view.View root, String text, int depth) {
        try {
            if (root == null || depth > 22) return null;
            if (root instanceof android.widget.TextView && root.isShown()) {
                CharSequence cs = ((android.widget.TextView) root).getText();
                if (cs != null && cs.toString().trim().equals(text)) {
                    android.view.View cur = root;
                    for (int i = 0; i < 5 && cur != null; i++) {
                        if (cur.isClickable()) return cur;
                        android.view.ViewParent p = cur.getParent();
                        cur = (p instanceof android.view.View) ? (android.view.View) p : null;
                    }
                    return root;
                }
            }
            if (root instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) root;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.view.View r = findClickableByText(g.getChildAt(i), text, depth + 1);
                    if (r != null) return r;
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 依次：… 菜单 → 查找聊天记录 → 输入关键词 → 点第一条结果 */
    private static void searchLocate(final android.app.Activity a, final String text) {
        try {
            if (text == null || text.trim().length() < 2) return;
            final String q = text.trim();
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            android.app.Activity act = curAct(a);
            android.view.View decor = act.getWindow().getDecorView();
            android.view.View more = null;
            for (android.view.View v : collectAll(decor)) {
                CharSequence d = v.getContentDescription();
                if (d != null && (d.toString().contains("更多") || d.toString().contains("More"))) { more = v; break; }
            }
            if (more == null) {
                // 退一步：标题栏右上角区域里最靠右的可点控件
                try {
                    int[] loc = new int[2];
                    int w = decor.getWidth();
                    int bestX = -1;
                    for (android.view.View v : collectAll(decor)) {
                        if (!v.isShown() || !v.isClickable()) continue;
                        v.getLocationOnScreen(loc);
                        if (loc[1] > 320) continue;
                        if (loc[0] < w * 0.6) continue;
                        if (loc[0] > bestX) { bestX = loc[0]; more = v; }
                    }
                } catch (Throwable ignore) { }
            }
            if (more == null) { log("SL|no more btn"); return; }
            log("SL|more=" + more.getClass().getSimpleName());
            more.performClick();
            log("SL|click more");
            h.postDelayed(new Runnable() {
                @Override public void run() {
                    android.app.Activity act2 = curAct(a);
                    android.view.View hit = findClickableByText(act2.getWindow().getDecorView(),
                            "查找聊天记录", 0);
                    if (hit == null) { log("SL|no 查找聊天记录"); return; }
                    hit.performClick();
                    log("SL|click 查找聊天记录");
                    h.postDelayed(new Runnable() {
                        @Override public void run() {
                            android.app.Activity act3 = curAct(a);
                            android.widget.EditText et2 = findEditText(act3.getWindow().getDecorView(), 0);
                            if (et2 == null) { log("SL|no search input"); return; }
                            try { et2.performClick(); } catch (Throwable ignore) { }
                            et2.setText(q);
                            et2.setSelection(et2.getText().length());
                            try {
                                et2.onEditorAction(android.view.inputmethod.EditorInfo.IME_ACTION_SEARCH);
                            } catch (Throwable ignore) { }
                            log("SL|query " + q);
                            h.postDelayed(new Runnable() {
                                @Override public void run() {
                                    android.app.Activity act4 = curAct(a);
                                    android.view.View row = findClickableByText(act4.getWindow().getDecorView(), q, 0);
                                    if (row == null) {
                                        // 结果行文字一般包含关键词，退一步做包含匹配
                                        for (android.view.View v : collectAll(act4.getWindow().getDecorView())) {
                                            if (!(v instanceof android.widget.TextView) || !v.isShown()) continue;
                                            CharSequence cs = ((android.widget.TextView) v).getText();
                                            if (cs != null && cs.toString().contains(q.length() > 8 ? q.substring(0, 8) : q)) {
                                                row = v; break;
                                            }
                                        }
                                    }
                                    if (row == null) { log("SL|no result row"); return; }
                                    row.performClick();
                                    log("SL|click result");
                                    h.postDelayed(new Runnable() {
                                        @Override public void run() { paintFirstVisibleRow(a); }
                                    }, 1200L);
                                }
                            }, 1500L);
                        }
                    }, 900L);
                }
            }, 700L);
        } catch (Throwable t) { log("SL|err " + t); }
    }

    private static void paintFirstVisibleRow(android.app.Activity a) {
        try {
            android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (list instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) list;
                if (g.getChildCount() > 0) paintRow(a, g.getChildAt(0));
            }
        } catch (Throwable ignore) { }
    }

    /** 微信的时间是单独一行：「时间行 + 下一条消息行」，找到时间行就圈它下面那条 */
    private static boolean paintByTimeLabel(android.app.Activity a, long tsMs) {
        try {
            String[] cands = timeCandidates(tsMs);
            if (cands.length == 0) return false;
            android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (!(list instanceof android.view.ViewGroup)) return false;
            android.view.ViewGroup g = (android.view.ViewGroup) list;
            for (int i = 0; i < g.getChildCount(); i++) {
                String t = rowAllText(g.getChildAt(i));
                if (t == null) continue;
                for (String c : cands) {
                    if (c.length() < 5 || t.indexOf(c) < 0) continue;
                    android.view.View row = (i + 1 < g.getChildCount()) ? g.getChildAt(i + 1) : g.getChildAt(i);
                    painted = true;
            log("LOC|timelabel hit idx=" + i + " by=" + c + " paintChild=" + (i + 1));
                    paintRow(a, row);
                    return true;
                }
            }
        } catch (Throwable t) { log("LOC|tlabel err " + t); }
        return false;
    }

    /** 反复「重算位置 → 滚动 → 取行 → 画框」，应对微信自己回弹到底部 */
    private static void scrollAndPaint(final android.app.Activity a, final long msgId,
                                       final String text, final long tsMs, final int attempt) {
        try {
            if (settingsRefresher != null) return;   // 面板打开时不跑定位，避免旧弹窗冒出来

            if (attempt > 8) { log("LOC|give up after " + attempt); return; }
            android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (list == null) return;
            int pos = findPosInList(list, msgId, text, tsMs);
            if (pos < 0) {
                android.view.View tr = findRowByDisplayedTime(a, tsMs);
                if (tr == null) tr = findVisibleRowByText(a, text, tsMs);
                if (tr != null) { paintRow(a, tr); return; }
                log("LOC|sap not found attempt=" + attempt);
                return;
            }
            scrollListTo(list, pos);
            log("LOC|sap scroll pos=" + pos + " attempt=" + attempt);
            final android.view.View flist = list;
            final int fpos = pos;
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        android.view.View row = null;
                        Object lm = flist.getClass().getMethod("getLayoutManager").invoke(flist);
                        if (lm != null) {
                            Object v = lm.getClass().getMethod("findViewByPosition", int.class).invoke(lm, fpos);
                            if (v instanceof android.view.View) row = (android.view.View) v;
                        }
                        if (row != null) { paintRow(a, row); return; }
                        if (paintByTimeLabel(a, tsMs)) return;
                        scrollAndPaint(a, msgId, text, tsMs, attempt + 1);
                    } catch (Throwable ignore) { }
                }
            }, 420L);
        } catch (Throwable t) { log("LOC|sap err " + t); }
    }

    /** 按 adapter 下标直接给那一行画框（不依赖 childAdapterPosition） */
    private static void paintAtPos(final android.app.Activity a, final int pos) {
        try {
            android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (list == null) return;
            android.view.View row = null;
            try {
                Object lm = list.getClass().getMethod("getLayoutManager").invoke(list);
                if (lm != null) {
                    Object v = lm.getClass().getMethod("findViewByPosition", int.class).invoke(lm, pos);
                    if (v instanceof android.view.View) row = (android.view.View) v;
                }
            } catch (Throwable ignore) { }
            if (row == null && list instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) list;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.view.View ch = g.getChildAt(i);
                    try {
                        Object p2 = list.getClass().getMethod("getChildAdapterPosition", android.view.View.class)
                                .invoke(list, ch);
                        if (p2 instanceof Integer && (Integer) p2 == pos) { row = ch; break; }
                    } catch (Throwable ignore) { }
                }
            }
            if (row == null) {
                log("LOC|paint miss pos=" + pos);
                return;
            }
            final android.view.View frow = row;
            row.setForeground(makeHlFrame(a));
            row.requestLayout();
            row.invalidate();
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() { try { frow.setForeground(null); } catch (Throwable ignore) { } }
            }, 3800L);
            log("LOC|paint pos=" + pos);
        } catch (Throwable t) { log("LOC|paintAt err " + t); }
    }

    private static void locateAndHighlight(final android.app.Activity a, final long msgId,
                                           final String text, final long tsMs, final boolean paging) {
        try {
            if (a == null) return;
            android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (!(list instanceof android.view.ViewGroup)) {
                log("LOC|no list act=" + curAct(a).getClass().getSimpleName());
                return;
            }
            int pos = findPosInList(list, msgId, text, tsMs);
            if (pos < 0) {
                log("LOC|miss id=" + msgId + " list=" + list.getClass().getSimpleName()
                        + " act=" + curAct(a).getClass().getSimpleName());
                android.view.View tr = findRowByDisplayedTime(a, tsMs);
                if (tr != null) { paintRow(a, tr); return; }
                android.view.View vr = findVisibleRowByText(a, text, tsMs);
                if (vr != null) { paintRow(a, vr); return; }
                log("LOC|not loaded id=" + msgId + " paging=" + paging
                        + " text=" + (text == null ? "" : text.substring(0, Math.min(20, text.length()))));
                if (paging) {
                    pageUpFind(curAct(a), msgId, text, tsMs, 1);
                    final android.app.Activity aa = curAct(a);
                    final String ftxt = text;
                    new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                        @Override public void run() {
                            if (!painted && ftxt != null && ftxt.trim().length() >= 2) {
                                log("LOC|fallback to search");
                                searchLocate(aa, ftxt);
                            }
                        }
                    }, 20000L);
                }
                return;
            }
            log("LOC|scroll pos=" + pos + " id=" + msgId);
            scrollAndPaint(a, msgId, text, tsMs, 0);
        } catch (Throwable t) { log("LOC|err " + t); }
    }

    private static void paintRowAt(android.app.Activity a, long msgId, String text, long tsMs) {
        try {
            android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (!(list instanceof android.view.ViewGroup)) return;
            Object ad = adapterOf(list);
            android.view.ViewGroup g = (android.view.ViewGroup) list;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View row = g.getChildAt(i);
                Object pos = null;
                try {
                    pos = list.getClass().getMethod("getChildAdapterPosition", android.view.View.class)
                            .invoke(list, row);
                } catch (Throwable ignore) { }
                if (!(pos instanceof Integer) || (Integer) pos < 0) continue;
                Object item = itemAt(ad, (Integer) pos);
                long id = itemMsgId(item);
                boolean hit = false;
                if (msgId > 0 && id == msgId) hit = true;
                if (!hit && text != null) {
                    String body = itemContent(item);
                    String key = text.trim();
                    if (key.length() > 20) key = key.substring(0, 20);
                    if (body != null && key.length() >= 4 && body.indexOf(key) >= 0) {
                        long ct = itemCreateTime(item);
                        if (tsMs <= 0 || ct <= 0 || Math.abs(ct - tsMs) < 180000L) hit = true;
                    }
                }
                if (!hit) continue;
                final android.view.View frow = row;
                row.setForeground(makeHlFrame(a));
                row.requestLayout();
                row.invalidate();
                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                    @Override public void run() { try { frow.setForeground(null); } catch (Throwable ignore) { } }
                }, 3600L);
                log("LOC|paint " + ((Integer) pos));
                return;
            }
        } catch (Throwable t) { log("LOC|paint err " + t); }
    }



    private static int firstVisiblePos(android.view.View list) {
        try {
            Object lm = list.getClass().getMethod("getLayoutManager").invoke(list);
            if (lm == null) return -1;
            Object v = lm.getClass().getMethod("findFirstVisibleItemPosition").invoke(lm);
            return v instanceof Integer ? (Integer) v : -1;
        } catch (Throwable t) { return -1; }
    }

    /** 目标没加载时：fling 上翻触发微信加载更早消息，每屏重试一次 */
    private static void pageUpFind(final android.app.Activity a, final long msgId,
                                   final String text, final long tsMs, final int attempt) {
        try {
            if (settingsRefresher != null) return;   // 面板打开时不跑定位，避免旧弹窗冒出来

            if (a == null) {
                return;
            }
            if (attempt > 25) {
                toast("找不到了，可能这条更早，需要手动上翻");
                return;
            }
            final android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (!(list instanceof android.view.ViewGroup)) return;
            int h = list.getHeight();
            if (h <= 0) return;
            final int beforeCount = countOfAdapter(adapterOf(list));
            // 先试 fling（更容易触发微信的「加载更早消息」），失败再 scrollBy
            boolean flung = false;
            try {
                list.getClass().getMethod("fling", int.class, int.class).invoke(list, 0, -(h * 2));
                flung = true;
            } catch (Throwable ignore) { }
            if (!flung) list.scrollBy(0, -(h * 3 / 4));
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        android.view.View tr2 = findRowByDisplayedTime(a, tsMs);
                        if (tr2 != null) { paintRow(a, tr2); return; }
                        android.view.View vr = findVisibleRowByText(a, text, tsMs);
                        if (vr != null) { paintRow(a, vr); return; }
                        int pos = findPosInList(list, msgId, text, tsMs);
                        if (pos >= 0) {
                            log("LOC|page hit attempt=" + attempt + " pos=" + pos);
                            scrollAndPaint(a, msgId, text, tsMs, 0);
                            return;
                        }
                        int afterCount = countOfAdapter(adapterOf(list));
                        boolean canUp = true;
                        try { canUp = list.canScrollVertically(-1); } catch (Throwable ignore) { }
                        log("LOC|page attempt=" + attempt + " cnt=" + beforeCount + "->" + afterCount
                                + " canUp=" + canUp);
                        if (!canUp && afterCount <= beforeCount) {
                            toast("已到顶，没找到这条");
                            return;
                        }
                        pageUpFind(a, msgId, text, tsMs, attempt + 1);
                    } catch (Throwable ignore) { }
                }
            }, 760L);
        } catch (Throwable t) { log("LOC|page err " + t); }
    }

    /** 打开会话并精确滚动到某条消息（不依赖微信的 Chat_Msg_Id） */
    private static void openChatAt2(final android.app.Activity a, final String talker,
                                    final long msgId, final String text, final long tsMs) {
        try {
            android.content.Intent it = new android.content.Intent();
            it.setClassName(a.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
            it.putExtra("Chat_User", resolveTalker(talker));
            if (msgId > 0) it.putExtra("Chat_Msg_Id", msgId);
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK
                    | android.content.Intent.FLAG_ACTIVITY_CLEAR_TOP
                    | android.content.Intent.FLAG_ACTIVITY_SINGLE_TOP);
            android.content.Intent _csw = prepareChatSwitch(a, it);
            if (_csw != null) a.startActivity(_csw);
            log("LOC|open " + talker + " id=" + msgId);
        } catch (Throwable t) { toast("打开失败：" + t); return; }
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        h.postDelayed(new Runnable() {
            @Override public void run() {
                try { locateAndHighlight(a, msgId, text, tsMs, false); } catch (Throwable ignore) { }
            }
        }, 1200L);
        h.postDelayed(new Runnable() {
            @Override public void run() {
                try { locateAndHighlight(a, msgId, text, tsMs, true); } catch (Throwable ignore) { }
            }
        }, 2400L);
    }

    /* ================= 定位消息后的高亮（粗红框） ================= */
    private static android.graphics.drawable.Drawable makeHlFrame(android.content.Context c) {
        android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
        g.setShape(android.graphics.drawable.GradientDrawable.RECTANGLE);
        g.setColor(0x00000000);
        g.setStroke(dp(c, 5), 0xFF07C160);
        g.setCornerRadius(dp(c, 14));
        return g;
    }

    private static long itemMsgId(Object item) {
        try {
            if (item == null) return 0;
            for (String mn : new String[]{"getMsgId", "getMsgSvrId"}) {
                try {
                    Object v = item.getClass().getMethod(mn).invoke(item);
                    if (v instanceof Long) return (Long) v;
                    if (v instanceof Integer) return ((Integer) v).longValue();
                } catch (Throwable ignore) { }
            }
            Class<?> k = item.getClass();
            while (k != null && k != Object.class) {
                for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                    if (f.getType() != long.class && f.getType() != Long.class) continue;
                    String n = f.getName().toLowerCase();
                    if (!n.contains("msgid") && !n.contains("svrid")) continue;
                    f.setAccessible(true);
                    return f.getLong(item);
                }
                k = k.getSuperclass();
            }
        } catch (Throwable ignore) { }
        return 0;
    }

    private static boolean applyHighlight(final android.app.Activity a, final long target) {
        try {
            if (a == null || target <= 0) return false;
            android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (!(list instanceof android.view.ViewGroup)) return false;
            Object adapter = null;
            try { adapter = list.getClass().getMethod("getAdapter").invoke(list); } catch (Throwable ignore) { }
            android.view.ViewGroup g = (android.view.ViewGroup) list;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View row = g.getChildAt(i);
                Object item = null;
                try {
                    Object pos = list.getClass()
                            .getMethod("getChildAdapterPosition", android.view.View.class)
                            .invoke(list, row);
                    if (adapter != null && pos instanceof Integer && (Integer) pos >= 0) {
                        item = adapter.getClass().getMethod("getItem", int.class)
                                .invoke(adapter, (Integer) pos);
                    }
                } catch (Throwable ignore) { }
                long id = itemMsgId(item);
                if (id != target) continue;
                row.setForeground(makeHlFrame(a));
                row.requestLayout();
                row.invalidate();
                final android.view.View frow = row;
                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                    @Override public void run() {
                        try { frow.setForeground(null); } catch (Throwable ignore) { }
                    }
                }, 3200);
                log("HL|hit row " + target);
                return true;
            }
        } catch (Throwable t) { log("HL|err " + t); }
        return false;
    }

    private static void highlightMsgRow(final android.app.Activity a, final long msgId) {
        if (msgId <= 0) return;
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        final long[] delays = {500L, 1100L, 1800L, 2600L, 3600L};
        for (final long d : delays) {
            h.postDelayed(new Runnable() {
                @Override public void run() {
                    try { applyHighlight(a, msgId); } catch (Throwable ignore) { }
                }
            }, d);
        }
    }

