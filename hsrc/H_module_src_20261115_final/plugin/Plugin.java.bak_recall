    /* ================= 二维码扫描记录 ================= */
    private static volatile boolean qrHooked = false;

    private static void installQrLog(final ClassLoader app) {
        if (qrHooked) return;
        qrHooked = true;
        try {
            // 扫码成功后微信会构造这个事件；不同版本类名可能不同，逐个试
            String[] cands = {
                    "com.tencent.mm.autogen.events.HandleScanResultEvent",
                    "com.tencent.mm.autogen.events.ScanCodeSuccessEvent",
                    "com.tencent.mm.plugin.scanner.a"
            };
            int ok = 0;
            for (String cn : cands) {
                try {
                    Class<?> c = Class.forName(cn, false, app);
                    for (java.lang.reflect.Constructor<?> ctor : c.getDeclaredConstructors()) {
                        try {
                            XposedBridge.hookMethod(ctor, new XC_MethodHook() {
                                @Override protected void afterHookedMethod(MethodHookParam pm) {
                                    try { dumpQrEvent(pm.thisObject); } catch (Throwable ignore) { }
                                }
                            });
                        } catch (Throwable ignore) { }
                    }
                    ok++;
                    log("QRLOG|hooked " + cn);
                } catch (Throwable ignore) { }
            }
            if (ok == 0) log("QRLOG|no class found");
        } catch (Throwable t) { log("QRLOG|err " + t); }
    }

    /** 从事件对象里捞出所有字符串字段，能看出扫码内容就落盘 */
    private static void dumpQrEvent(Object ev) {
        try {
            if (ev == null) return;
            if (!cfg().optBoolean("qrLog", true)) return;
            StringBuilder sb = new StringBuilder();
            Class<?> k = ev.getClass();
            while (k != null && k != Object.class) {
                for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                    try {
                        f.setAccessible(true);
                        Object v = f.get(ev);
                        if (v instanceof String) {
                            String sv = (String) v;
                            if (sv != null && sv.length() > 4 && !sv.startsWith("com.tencent")) {
                                sb.append(f.getName()).append('=').append(sv).append(' ');
                            }
                        }
                    } catch (Throwable ignore) { }
                }
                k = k.getSuperclass();
            }
            String out = sb.toString().trim();
            if (out.length() == 0) return;
            String line = "[" + new java.text.SimpleDateFormat("MM-dd HH:mm:ss", java.util.Locale.US)
                    .format(new java.util.Date()) + "] " + ev.getClass().getSimpleName() + " :: " + out;
            java.io.File f2 = new java.io.File(DIR + "/qr_log.txt");
            java.io.FileOutputStream os = new java.io.FileOutputStream(f2, true);
            os.write((line + "\n").getBytes("UTF-8"));
            os.close();
            log("QRLOG|" + out);
        } catch (Throwable ignore) { }
    }

    private static void showQrLog(android.app.Activity a) {
        try {
            java.io.File f = new java.io.File(DIR + "/qr_log.txt");
            if (!f.isFile() || f.length() == 0) { toast("暂无扫码记录"); return; }
            java.io.BufferedReader br = new java.io.BufferedReader(
                    new java.io.InputStreamReader(new java.io.FileInputStream(f), "UTF-8"));
            java.util.ArrayList<String> lines = new java.util.ArrayList<String>();
            String ln;
            while ((ln = br.readLine()) != null) lines.add(ln);
            br.close();
            StringBuilder sb = new StringBuilder();
            int start = Math.max(0, lines.size() - 40);
            for (int i = lines.size() - 1; i >= start; i--) sb.append(lines.get(i)).append("\n\n");
            alert("扫码记录（" + lines.size() + " 条）", sb.toString());
        } catch (Throwable t) { toast("读取失败：" + t); }
    }

    /* ================= 资料卡居中（ContactInfoUI 头像水平居中） ================= */
    private static volatile boolean profileHooked = false;
    private static void installProfileCenter(final ClassLoader app) {
        if (profileHooked) return;
        profileHooked = true;
        try {
            Class<?> c = Class.forName("com.tencent.mm.plugin.profile.ui.ContactInfoUI", false, app);
            XposedBridge.hookAllMethods(c, "onResume", new XC_MethodHook() {
                @Override protected void afterHookedMethod(final MethodHookParam pm) {
                    try {
                        if (!cfg().optBoolean("profileCenter", false)) return;
                        if (!(pm.thisObject instanceof android.app.Activity)) return;
                        final android.app.Activity a = (android.app.Activity) pm.thisObject;
                        a.getWindow().getDecorView().postDelayed(new Runnable() {
                            @Override public void run() {
                                try { centerProfileAvatar(a); } catch (Throwable ignore) { }
                            }
                        }, 400);
                    } catch (Throwable ignore) { }
                }
            });
            log("PROFILEC|hooked");
        } catch (Throwable t) { log("PROFILEC|err " + t); }
    }

    private static void centerProfileAvatar(android.app.Activity a) {
        try {
            android.view.View decor = a.getWindow().getDecorView();
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(decor, all, 0);
            android.view.View best = null;
            int bestArea = 0;
            for (android.view.View v : all) {
                String cn = v.getClass().getName();
                if (!cn.contains("Avatar")) continue;
                int ar = v.getWidth() * v.getHeight();
                if (ar > bestArea) { bestArea = ar; best = v; }
            }
            if (best == null || bestArea < 4000) return;
            if (best.getTag(0x0f0f0f90) != null) return;
            best.setTag(0x0f0f0f90, "center");
            android.view.View parent = (android.view.View) best.getParent();
            if (parent != null && !parent.getClass().getName().contains("Avatar")) {
                if (parent instanceof android.widget.LinearLayout) {
                    ((android.widget.LinearLayout) parent).setGravity(android.view.Gravity.CENTER_HORIZONTAL);
                    log("PROFILEC|center " + parent.getClass().getSimpleName());
                }
            }
        } catch (Throwable ignore) { }
    }

    /* ================= 朋友圈：隐藏「广告」行（文本严格匹配） ================= */
    private static volatile boolean snsAdHooked = false;
    private static void installSnsAdFilter(final ClassLoader app) {
        if (snsAdHooked) return;
        snsAdHooked = true;
        try {
            try {
                Class<?> cd = Class.forName("com.tencent.mm.plugin.sns.ui.SnsCommentDetailUI", false, app);
                XposedBridge.hookAllMethods(cd, "onResume", new XC_MethodHook() {
                    @Override protected void afterHookedMethod(final MethodHookParam pm) {
                        try {
                            if (!(pm.thisObject instanceof android.app.Activity)) return;
                            java.io.File f = new java.io.File(mmBase() + "/files/wxh_vsnstext");
                            if (!f.isFile()) return;
                            f.delete();
                            final android.app.Activity a2 = (android.app.Activity) pm.thisObject;
                            log("SNSTEXT|armed");
                            a2.getWindow().getDecorView().postDelayed(new Runnable() {
                                @Override public void run() { probeSnsText(a2); }
                            }, 2000L);
                        } catch (Throwable ignore) { }
                    }
                });
                log("SNSTEXT|hook installed");
            } catch (Throwable ignore) { }
            String[] uis = {"com.tencent.mm.plugin.sns.ui.SnsTimeLineUI",
                    "com.tencent.mm.plugin.sns.ui.improve.ImproveSnsTimelineUI"};
            int hooked = 0;
            for (String un : uis) {
                try {
                    Class<?> c = Class.forName(un, false, app);
                    XposedBridge.hookAllMethods(c, "onResume", new XC_MethodHook() {
                        @Override protected void afterHookedMethod(final MethodHookParam pm) {
                            try {
                                if (!(pm.thisObject instanceof android.app.Activity)) return;
                                final android.app.Activity a = (android.app.Activity) pm.thisObject;
                                inSns = true;
                                log("SNSAD|hook resume " + a.getClass().getSimpleName());
                                try {
                                    java.io.File xf = new java.io.File(mmBase() + "/files/wxh_vsns");
                                    if (xf.isFile()) {
                                        xf.delete();
                                        log("SNSX|armed-run");
                                        a.getWindow().getDecorView().postDelayed(new Runnable() {
                                            @Override public void run() { exploreSnsFeed(a); }
                                        }, 2500L);
                                    }
                                } catch (Throwable ignore) { }
                                final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
                                h.postDelayed(new Runnable() {
                                    int rounds = 0;
                                    @Override public void run() {
                                        try {
                                            if (cfg().optBoolean("snsAdOff", false)) hideSnsAdRows(a);
                                            snsTick(a);
                                        } catch (Throwable ignore) { }
                                        if (++rounds < 400 && inSns) h.postDelayed(this, 500);
                                    }
                                }, 600);
                            } catch (Throwable ignore) { }
                        }
                    });
                    XposedBridge.hookAllMethods(c, "onPause", new XC_MethodHook() {
                        @Override protected void beforeHookedMethod(MethodHookParam pm) {
                            inSns = false;
                        }
                    });
                    hooked++;
                } catch (Throwable t) {
                    log("SNSAD|skip " + un + " " + t.getClass().getSimpleName());
                }
            }
            log("SNSAD|installed ok=" + hooked);
            // 长按某条动态 = 伪赞：在 Activity 触摸分发层判定，绕开卡片子控件吞事件的问题
            try {
                XposedBridge.hookAllMethods(android.app.Activity.class, "dispatchTouchEvent", new XC_MethodHook() {
                    @Override protected void beforeHookedMethod(MethodHookParam pm) {
                        try {
                            if (!inSns || !snsFakeOn()) return;
                            if (!(pm.args[0] instanceof android.view.MotionEvent)) return;
                            if (!(pm.thisObject instanceof android.app.Activity)) return;
                            android.view.MotionEvent e = (android.view.MotionEvent) pm.args[0];
                            final android.app.Activity a = (android.app.Activity) pm.thisObject;
                            String cn = a.getClass().getName();
                            if (!cn.contains("Sns")) return;
                            int act = e.getActionMasked();
                            if (act == android.view.MotionEvent.ACTION_DOWN) {
                                snsDownAt = System.currentTimeMillis();
                                snsDownX = e.getX();
                                snsDownY = e.getY();
                            } else if (act == android.view.MotionEvent.ACTION_MOVE) {
                                if (Math.abs(e.getX() - snsDownX) > 40 || Math.abs(e.getY() - snsDownY) > 40) snsDownAt = 0;
                            } else if (act == android.view.MotionEvent.ACTION_UP) {
                                long dur = System.currentTimeMillis() - snsDownAt;
                                long at = snsDownAt;
                                snsDownAt = 0;
                                if (at > 0 && dur > 650 && dur < 3000) {
                                    View card = snsCardAt(a, e.getRawX(), e.getRawY());
                                    if (card == null) {
                                        card = snsCardAtByTime(a, e.getRawX(), e.getRawY());
                                        if (card != null && collectText(card).contains("换封面")) card = null;
                                    }
                                    if (card != null && snsFakeLikeCard(card)) {
                                        pm.setResult(Boolean.TRUE);   // 吃掉这一下，避免原生再弹菜单/进主页
                                    }
                                }
                            }
                        } catch (Throwable ignore) { }
                    }
                });
                log("FAKELIKE|touch hook installed");
            } catch (Throwable t) { log("FAKELIKE|touch err " + t); }
        } catch (Throwable t) { log("SNSAD|err " + t); }
    }

    private static volatile long snsDownAt = 0;
    private static float snsDownX = 0f, snsDownY = 0f;

    private static boolean snsFakeOn() {
        try { return cfg().optBoolean("fakeLike", false); } catch (Throwable t) { return false; }
    }

    /** 从屏幕坐标找那条动态卡片（沿父链上溯到"含头像"的容器） */
    private static View snsCardAt(android.app.Activity a, float x, float y) {
        try {
            View root = a.getWindow().getDecorView();
            java.util.ArrayList<View> all = new java.util.ArrayList<View>();
            collectSnsViews(root, all, 0);
            // 新版朋友圈每条动态的头部是 ImproveItemHeader；找"顶部在我上面、离我最近"的那个头部
            View bestHeader = null;
            int bestTop = -100000;
            for (int i = 0; i < all.size(); i++) {
                View v = all.get(i);
                if (!v.getClass().getSimpleName().startsWith("ImproveItemHeader")) continue;
                int[] l = new int[2];
                v.getLocationOnScreen(l);
                int t = l[1];
                if (t <= y + 40 && t >= y - 1400 && t > bestTop) {
                    bestTop = t;
                    bestHeader = v;
                }
            }
            if (bestHeader != null) {
                android.view.ViewParent p = bestHeader.getParent();
                if (p instanceof View) return (View) p;
            }
        } catch (Throwable ignore) { }
        return null;
    }

    private static View snsCardAtByTime(android.app.Activity a, float x, float y) {
        try {
            View root = a.getWindow().getDecorView();
            int sw = root.getWidth();
            java.util.ArrayList<View> all = new java.util.ArrayList<View>();
            collectSnsViews(root, all, 0);
            StringBuilder dbg = new StringBuilder("FAKELIKE|at y=" + (int) y + " n=" + all.size());
            View best = null;
            int bestH = 1 << 20;
            for (int i = 0; i < all.size(); i++) {
                View v = all.get(i);
                int h = v.getHeight();
                if (h < 200 || h > 1800) continue;
                if (v.getWidth() < sw / 2) continue;
                if (!v.isShown()) continue;
                int[] loc = new int[2];
                v.getLocationOnScreen(loc);
                if (y < loc[1] || y > loc[1] + h) continue;
                if (hasTimeText(v) && h < bestH) {
                    best = v;
                    bestH = h;
                    dbg.append(" time:").append(v.getClass().getSimpleName()).append("/h").append(h)
                            .append("/t").append(loc[1]);
                    if (dbg.length() > 240) break;
                }
            }
            if (best != null) {
                int[] lc = new int[2];
                best.getLocationOnScreen(lc);
                log(dbg.toString());
                log("FAKELIKE|card h=" + best.getHeight() + " top=" + lc[1] + " cls="
                        + best.getClass().getSimpleName() + " byTime=" + hasTimeText(best));
                return best;
            }
            dbg.append(" -> fallback");
            log(dbg.toString());
            StringBuilder near = new StringBuilder("FAKELIKE|near:");
            int cnt = 0;
            for (int i = 0; i < all.size() && cnt < 24; i++) {
                View v = all.get(i);
                int[] l2 = new int[2];
                v.getLocationOnScreen(l2);
                if (Math.abs(l2[1] + v.getHeight() / 2 - y) > 160) continue;
                if (v.getWidth() < 200) continue;
                near.append(' ').append(v.getClass().getSimpleName()).append("/h").append(v.getHeight())
                        .append("/w").append(v.getWidth()).append("/t").append(l2[1]);
                try {
                    if (v.getId() != 0) {
                        String rn = v.getResources().getResourceName(v.getId());
                        near.append('#').append(rn.substring(rn.indexOf('/') + 1));
                    }
                } catch (Throwable ignore) { }
                if (v instanceof android.widget.TextView) {
                    CharSequence tt = ((android.widget.TextView) v).getText();
                    if (tt != null && tt.length() > 0) {
                        String s2 = tt.toString();
                        near.append('"').append(s2.length() > 6 ? s2.substring(0, 6) : s2).append('"');
                    }
                }
                cnt++;
                if (near.length() > 800) break;
            }
            log(near.toString());
            StringBuilder its = new StringBuilder("FAKELIKE|items:");
            int ic = 0;
            for (int i = 0; i < all.size() && ic < 16; i++) {
                View v = all.get(i);
                String cn2 = v.getClass().getSimpleName();
                if (!cn2.startsWith("ImproveItem") && !cn2.startsWith("ImprovePost")) continue;
                int[] l3 = new int[2];
                v.getLocationOnScreen(l3);
                its.append(' ').append(cn2).append("/h").append(v.getHeight()).append("/t").append(l3[1])
                        .append("/w").append(v.getWidth());
                ic++;
                if (its.length() > 700) break;
            }
            log(its.toString());
            // 兜底：含作者头像的最小容器
            for (int i = 0; i < all.size(); i++) {
                View v = all.get(i);
                int h = v.getHeight();
                if (h < 200 || h > 1800) continue;
                if (v.getWidth() < sw / 2) continue;
                if (!v.isShown()) continue;
                int[] loc = new int[2];
                v.getLocationOnScreen(loc);
                if (y < loc[1] || y > loc[1] + h) continue;
                if (hasAuthorAvatar(v) && h < bestH) {
                    best = v;
                    bestH = h;
                }
            }
            return best;
        } catch (Throwable ignore) { }
        return null;
    }

    /** 朋友圈专用的深度遍历：列表项在很深的层级，普通遍历会被深度上限截断 */
    private static void collectSnsViews(View v, java.util.List<View> out, int depth) {
        try {
            if (v == null || depth > 40 || out.size() > 3000) return;
            out.add(v);
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) collectSnsViews(g.getChildAt(i), out, depth + 1);
            }
        } catch (Throwable ignore) { }
    }

    /** 容器里的时间 TextView（昨天/分钟前/12月3日…） */
    private static android.widget.TextView findTimeText(View v) {
        try {
            java.util.ArrayList<View> all = new java.util.ArrayList<View>();
            collectSnsViews(v, all, 0);
            for (int i = 0; i < all.size(); i++) {
                View c = all.get(i);
                if (!(c instanceof android.widget.TextView)) continue;
                CharSequence t = ((android.widget.TextView) c).getText();
                if (t == null) continue;
                String s = t.toString().trim();
                if (s.length() == 0 || s.length() > 12) continue;
                if (s.contains("分钟前") || s.contains("小时前") || s.contains("刚刚")
                        || s.equals("昨天") || s.equals("前天") || s.equals("今天")
                        || s.matches("\\d{1,2}月\\d{1,2}日") || s.matches("\\d{1,2}:\\d{2}")) {
                    return (android.widget.TextView) c;
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 容器里有没有朋友圈的时间文本（昨天/分钟前/12月3日…） */
    private static boolean hasTimeText(View v) {
        try {
            java.util.ArrayList<View> all = new java.util.ArrayList<View>();
            collectSnsViews(v, all, 0);
            for (int i = 0; i < all.size(); i++) {
                View c = all.get(i);
                if (!(c instanceof android.widget.TextView)) continue;
                CharSequence t = ((android.widget.TextView) c).getText();
                if (t == null) continue;
                String s = t.toString().trim();
                if (s.length() == 0 || s.length() > 12) continue;
                if (s.contains("分钟前") || s.contains("小时前") || s.contains("刚刚")
                        || s.equals("昨天") || s.equals("前天") || s.equals("今天")) return true;
                if (s.matches("\\d{1,2}月\\d{1,2}日") || s.matches("\\d{1,2}:\\d{2}")) return true;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    /** 这条容器里有没有作者头像（大尺寸、带描述、不是封面图） */
    private static boolean hasAuthorAvatar(View v) {
        try {
            java.util.ArrayList<View> all = new java.util.ArrayList<View>();
            collectSnsViews(v, all, 0);
            for (int i = 0; i < all.size(); i++) {
                View c = all.get(i);
                if (!(c instanceof android.widget.ImageView)) continue;
                if (c.getWidth() < 60 || c.getHeight() < 60) continue;
                CharSequence cd = c.getContentDescription();
                if (cd == null || cd.length() == 0) continue;
                String s = cd.toString();
                if (s.contains("封面") || s.contains("加载")) continue;
                return true;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    private static View hitDeep(View v, float x, float y) {
        try {
            if (!(v instanceof ViewGroup)) return v.isShown() ? v : null;
            ViewGroup g = (ViewGroup) v;
            for (int i = g.getChildCount() - 1; i >= 0; i--) {
                View ch = g.getChildAt(i);
                if (ch.getVisibility() != View.VISIBLE) continue;
                // 跳过不接收点击的纯展示图（朋友圈封面的半透明覆盖图会把整屏都算成命中）
                if (!(ch instanceof ViewGroup) && !ch.isClickable() && !(ch instanceof android.widget.TextView)) continue;
                int[] loc = new int[2];
                ch.getLocationOnScreen(loc);
                if (x >= loc[0] && x <= loc[0] + ch.getWidth()
                        && y >= loc[1] && y <= loc[1] + ch.getHeight()) {
                    View r = hitDeep(ch, x, y);
                    if (r != null) return r;
                }
            }
            return g;
        } catch (Throwable ignore) { return null; }
    }

    /** 对一条动态执行伪赞：记录 + 淡红底标记；名单非空时只认名单里的动态 */
    private static boolean snsFakeLikeCard(View card) {
        try {
            String txt = collectText(card);
            if (txt == null || txt.length() == 0) return false;
            org.json.JSONArray fn = cfg().optJSONArray("fakeLikeNames");
            if (fn != null && fn.length() > 0) {
                boolean hit = false;
                for (int i = 0; i < fn.length(); i++) {
                    String n = fn.optString(i, "");
                    if (n.length() > 0 && txt.contains(n)) { hit = true; break; }
                }
                if (!hit) return false;
            }
            fakeLikeRecord(txt);
            if (card.getHeight() > 50) card.setBackgroundColor(0x0DE5484D);
            android.widget.TextView tv = findTimeText(card);
            if (tv != null) tv.setTextColor(0xFFE5484D);      // 时间文字变红 = 这条已伪赞
            View like2 = findLikeButton(card);
            if (like2 != null) markLiked(like2);
            otherLikeStats++;
            toast("伪赞成功：仅本地标记，没发出去，对方无感知");
            log("FAKELIKE|longpress count=" + otherLikeStats + " "
                    + (txt.length() > 24 ? txt.substring(0, 24) : txt));
            return true;
        } catch (Throwable t) {
            log("FAKELIKE|card err " + t);
            return false;
        }
    }

    /** 朋友圈每 500ms 一轮的扫描：伪点赞按钮挂载 / 自动点赞 / 屏蔽词 / 已伪赞回填染色 */
    private static void snsTick(android.app.Activity a) {
        try {
            boolean fake = cfg().optBoolean("fakeLike", false);
            boolean auto = cfg().optBoolean("snsAutoLike", false);
            org.json.JSONArray kw = cfg().optJSONArray("snsHideKeywords");
            org.json.JSONArray nm = cfg().optJSONArray("snsHideNames");
            boolean hideKw = (kw != null && kw.length() > 0) || (nm != null && nm.length() > 0);
            if (!fake && !auto && !hideKw) return;
            java.util.List<Object> lists = new java.util.ArrayList<Object>();
            collectLists(a.getWindow().getDecorView(), lists);
            for (Object o : lists) {
                if (!(o instanceof ViewGroup)) continue;
                ViewGroup g = (ViewGroup) o;
                for (int i = 0; i < g.getChildCount(); i++) {
                    View ch = g.getChildAt(i);
                    if (ch.getVisibility() != View.VISIBLE) continue;
                    if (auto) snsAutoLike(ch);
                    if (fake) {
                        // 已伪赞回填：新版每条动态的容器是 ImproveItemHeader 的父级
                        if (ch.getClass().getSimpleName().startsWith("ImproveItemHeader")) {
                            android.view.ViewParent pv = ch.getParent();
                            if (pv instanceof View) snsReMarkLiked((View) pv);
                        } else {
                            snsReMarkLiked(ch);
                        }
                    }
                    if (hideKw) {
                        String bad = snsKeywordHit(ch);
                        if (bad != null) {
                            ch.setVisibility(View.GONE);
                            log("SNSKW|hidden by " + bad);
                        }
                    }
                }
            }
        } catch (Throwable ignore) { }
    }

    /** 把之前伪赞过的动态重新标红（记录里存了内容 hash，比对得上才染色） */
    private static void snsReMarkLiked(View ch) {
        try {
            org.json.JSONArray fl = cfg().optJSONArray("fakeLiked");
            if (fl == null || fl.length() == 0) return;
            String key = String.valueOf(collectText(ch).hashCode());
            for (int q = 0; q < fl.length(); q++) {
                String one = fl.optString(q, "");
                int bar = one.indexOf('|');
                if (bar > 0) one = one.substring(0, bar);
                if (key.equals(one)) {
                    if (ch.getHeight() > 50) ch.setBackgroundColor(0x0DE5484D);
                    android.widget.TextView tv = findTimeText(ch);
                    if (tv != null) tv.setTextColor(0xFFE5484D);
                    View like = findLikeButton(ch);
                    if (like != null) markLiked(like);
                    break;
                }
            }
        } catch (Throwable ignore) { }
    }

    /** 扫描朋友圈列表，把带「广告」标签的行整行隐藏 */
    private static void hideSnsAdRows(android.app.Activity a) {
        try {
            android.view.View decor = a.getWindow().getDecorView();
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(decor, all, 0);
            for (android.view.View v : all) {
                if (!(v instanceof android.widget.TextView)) continue;
                CharSequence tx = ((android.widget.TextView) v).getText();
                if (tx == null) continue;
                String t = tx.toString().trim();
                boolean isNewFeed = t.endsWith("条新动态") || t.endsWith("条新消息");
                if (cfg().optBoolean("hideSnsNewFeed", false) && isNewFeed) {
                    android.view.View rowN = findRowContainer(v);
                    if (rowN != null && rowN.getTag(0x0f0f0f81) == null) {
                        rowN.setTag(0x0f0f0f81, "nf");
                        rowN.setVisibility(android.view.View.GONE);
                        log("SNSNEW|hidden");
                    }
                    continue;
                }
                if (!"广告".equals(t) && !"推广".equals(t)) continue;
                android.view.View row = findRowContainer(v);
                if (row != null && row.getTag(0x0f0f0f80) == null) {
                    row.setTag(0x0f0f0f80, "ad");
                    row.setVisibility(android.view.View.GONE);
                    log("SNSAD|hidden");
                }
            }
        } catch (Throwable ignore) { }
    }

    /** 从某个 View 向上找列表行容器（父级是 RecyclerView 的那个） */
    private static android.view.View findRowContainer(android.view.View v) {
        try {
            android.view.View cur = v;
            for (int i = 0; i < 8 && cur != null; i++) {
                android.view.ViewParent p = cur.getParent();
                if (!(p instanceof android.view.View)) return null;
                if (p.getClass().getName().contains("RecyclerView")) return cur;
                cur = (android.view.View) p;
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /* ================= 底栏悬浮圆角 / 列表按压缩放 ================= */
    private static void floatTabBar(android.app.Activity a) {
        try {
            // 底栏恢复微信原生：不再做悬浮/圆角/边距改造
            if (true) return;
            if (a == null || !a.getClass().getName().endsWith("LauncherUI")) return;
            if (isInChatUi()) return;
            android.view.View decor = a.getWindow().getDecorView();
            int[] scr = new int[2];
            decor.getLocationOnScreen(scr);
            int sh = a.getResources().getDisplayMetrics().heightPixels;
            float d = a.getResources().getDisplayMetrics().density;
            android.view.View bar = null;
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(decor, all, 0);
            for (android.view.View v : all) {
                if (v instanceof android.view.ViewGroup && ((android.view.ViewGroup) v).getChildCount() >= 3
                        && ((android.view.ViewGroup) v).getChildCount() <= 6) {
                    int[] loc = new int[2];
                    v.getLocationOnScreen(loc);
                    int hgt = v.getHeight(), wid = v.getWidth();
                    if (wid > sh * 0.9 && hgt > dp(a, 40) && hgt < dp(a, 110)
                            && loc[1] + hgt > sh - dp(a, 10)) {
                        bar = v;   // 底部整条 + 3~6 个子项 → 判定为 tab 栏
                        break;
                    }
                }
            }
            if (bar == null || bar.getTag(0x0f0f0f70) != null) return;
            bar.setTag(0x0f0f0f70, "float");
            android.view.ViewGroup.LayoutParams lp = bar.getLayoutParams();
            int m = (int) (8 * d), rad = (int) (22 * d);
            if (lp instanceof android.view.ViewGroup.MarginLayoutParams) {
                android.view.ViewGroup.MarginLayoutParams mp = (android.view.ViewGroup.MarginLayoutParams) lp;
                mp.leftMargin = m; mp.rightMargin = m; mp.bottomMargin = m;
                bar.setLayoutParams(mp);
            }
            android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
            gd.setCornerRadius(rad);
            gd.setColor(0xF0FFFFFF);
            bar.setBackground(gd);
            bar.setElevation(8 * d);
            log("TABFLOAT|ok h=" + bar.getHeight());
        } catch (Throwable ignore) { }
    }

    /** 列表行按下轻微缩放（不消费事件，微信照常处理点击） */
    private static void applyPressEffect(android.view.ViewGroup lv) {
        try {
            if (lv == null) return;
            for (int i = 0; i < lv.getChildCount(); i++) {
                final android.view.View row = lv.getChildAt(i);
                if (row == null || row.getTag(0x0f0f0f71) != null) continue;
                row.setTag(0x0f0f0f71, "press");
                row.setOnTouchListener(new android.view.View.OnTouchListener() {
                    @Override public boolean onTouch(android.view.View v, android.view.MotionEvent e) {
                        try {
                            int act = e.getActionMasked();
                            if (act == android.view.MotionEvent.ACTION_DOWN) {
                                v.animate().scaleX(0.97f).scaleY(0.97f).setDuration(70).start();
                            } else if (act == android.view.MotionEvent.ACTION_UP
                                    || act == android.view.MotionEvent.ACTION_CANCEL) {
                                v.animate().scaleX(1f).scaleY(1f).setDuration(110).start();
                            }
                        } catch (Throwable ignore) { }
                        return false;   // 不消费，让微信自己处理点击
                    }
                });
            }
        } catch (Throwable ignore) { }
    }

    /* ================= 莫奈引擎（简化版）：从系统壁纸提取强调色 ================= */
    private static volatile int monetColor = 0;

    /** 取壁纸主色：缩样后按「饱和度加权」挑最鲜艳的一簇，避免取到大面积黑白灰 */
    private static int computeMonetColor(android.content.Context ctx) {
        try {
            android.app.WallpaperManager wm = android.app.WallpaperManager.getInstance(ctx);
            android.graphics.drawable.Drawable d = wm.getDrawable();
            if (d == null) return 0xFF07C160;
            int W = 24, H = 24;
            android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(W, H, android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas cv = new android.graphics.Canvas(bm);
            d.setBounds(0, 0, W, H);
            d.draw(cv);
            float[] hsv = new float[3];
            double bestScore = -1;
            int bestColor = 0xFF07C160;
            for (int y = 0; y < H; y++) {
                for (int x = 0; x < W; x++) {
                    int px = bm.getPixel(x, y);
                    android.graphics.Color.colorToHSV(px, hsv);
                    float sat = hsv[1], val = hsv[2];
                    if (val < 0.15f || val > 0.95f && sat < 0.1f) continue;   // 丢纯黑纯白
                    double score = sat * 1.6 + (1 - Math.abs(val - 0.6)) * 0.6;
                    if (score > bestScore) { bestScore = score; bestColor = px; }
                }
            }
            bm.recycle();
            // 稍微提亮、保证在浅色卡片上可读
            android.graphics.Color.colorToHSV(bestColor, hsv);
            hsv[1] = Math.min(1f, Math.max(0.45f, hsv[1]));
            hsv[2] = Math.min(1f, Math.max(0.55f, hsv[2]));
            int out = android.graphics.Color.HSVToColor(hsv);
            log("MONET|accent=" + Integer.toHexString(out));
            return out;
        } catch (Throwable t) {
            log("MONET|err " + t);
            return 0xFF07C160;
        }
    }

    /** 当前强调色（开了莫奈就取壁纸色，否则用默认红） */
    private static int accentColor(android.content.Context ctx) {
        try {
            if (!cfg().optBoolean("monetOn", false)) return 0xFF07C160;
            int c = monetColor;
            if (c == 0) { c = computeMonetColor(ctx); monetColor = c; }
            return c;
        } catch (Throwable t) { return 0xFF07C160; }
    }

    /* ================= 「我」页精简 / 隐藏下滑最近页 ================= */
    private static void applyMeSimplify(android.app.Activity a) {
        try {
            if (!cfg().optBoolean("meSimpl", false)) return;
            if (a == null || !a.getClass().getName().endsWith("LauncherUI")) return;
            if (isInChatUi()) return;
            android.view.ViewGroup pager = tabPager;
            if (pager == null) { pager = findPager(a.getWindow().getDecorView()); tabPager = pager; }
            if (pager == null) return;
            int pg;
            try { pg = (Integer) pager.getClass().getMethod("getCurrentItem").invoke(pager); }
            catch (Throwable t) { return; }
            if (pg != 3) return;                       // 只在「我」页
            String raw = cfg().optString("meSimplWords", "作品,小店与卡包,视频号,直播,购物,游戏");
            String[] words = raw.split("[,，]");
            android.view.View page = pager.getChildAt(3);
            if (page == null) return;
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(page, all, 0);
            int n = 0;
            for (android.view.View v : all) {
                if (!(v instanceof android.widget.TextView)) continue;
                CharSequence tx = ((android.widget.TextView) v).getText();
                if (tx == null) continue;
                String t = tx.toString().trim();
                if (t.length() == 0 || t.length() > 12) continue;
                for (String w : words) {
                    String ww = w.trim();
                    if (ww.length() == 0) continue;
                    if (t.equals(ww)) {
                        android.view.View row = (android.view.View) v.getParent();
                        for (int k = 0; k < 3 && row != null && !(row.getParent() instanceof android.view.ViewGroup); k++) { }
                        if (row != null && row.getTag(0x0f0f0f60) == null) {
                            row.setTag(0x0f0f0f60, "hide");
                            row.setVisibility(android.view.View.GONE);
                            n++;
                        }
                        break;
                    }
                }
            }
            if (n > 0) log("MESIMPL|" + n);
        } catch (Throwable ignore) { }
    }

