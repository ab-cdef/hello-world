            prompt.setHint("角色提示词");
            prompt.setText(cfg().optString("aiPrompt",
                    "你是用户本人，在微信上回复对方。语气自然口语化，简短克制，不超过30字，不要引号，不要解释。"));
            prompt.setTextSize(12);
            prompt.setMinLines(3);
            box.addView(prompt);

            new android.app.AlertDialog.Builder(a)
                    .setTitle("AI 回复设置")
                    .setView(box)
                    .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                org.json.JSONObject o = readCfg();
                                o.put("aiBase", base.getText().toString().trim());
                                o.put("aiKey", key.getText().toString().trim());
                                o.put("aiModel", model.getText().toString().trim());
                                o.put("aiPrompt", prompt.getText().toString().trim());
                                writeCfg(o);
                                cfg = null;
                                cfgAt = 0;
                                toast("已保存");
                            } catch (Throwable t) { toast("保存失败"); }
                        }
                    })
                    .setNeutralButton("测试", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                org.json.JSONObject o = readCfg();
                                o.put("aiBase", base.getText().toString().trim());
                                o.put("aiKey", key.getText().toString().trim());
                                o.put("aiModel", model.getText().toString().trim());
                                o.put("aiPrompt", prompt.getText().toString().trim());
                                writeCfg(o);
                                cfg = null;
                                cfgAt = 0;
                            } catch (Throwable ignore) { }
                            toast("测试中…");
                            new Thread(new Runnable() {
                                @Override public void run() {
                                    String r; String e = null;
                                    try { r = callAi("在吗？"); } catch (Throwable t) { r = null; e = String.valueOf(t); }
                                    final String fr = r, fe = e;
                                    a.runOnUiThread(new Runnable() {
                                        @Override public void run() {
                                            toast(fr != null && fr.length() > 0 ? "AI 正常：" + fr : "失败：" + fe);
                                        }
                                    });
                                }
                            }).start();
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) { log("AI|settings " + t); }
    }
    /** 常用语：聊天页弹层 */


    private static String greetWord() {
        int h = java.util.Calendar.getInstance().get(java.util.Calendar.HOUR_OF_DAY);
        if (h < 6) return "凌晨好";
        if (h < 11) return "早上好";
        if (h < 13) return "中午好";
        if (h < 18) return "下午好";
        return "晚上好";
    }

    /** 常用语变量：$date $time $weekday $name $me */
    private static String expandPhrase(String p) {
        if (p == null) return "";
        try {
            java.util.Date now = new java.util.Date();
            String s2 = p;
            s2 = s2.replace("$date", new java.text.SimpleDateFormat("yyyy-MM-dd").format(now));
            s2 = s2.replace("$time", new java.text.SimpleDateFormat("HH:mm").format(now));
            s2 = s2.replace("$weekday", new java.text.SimpleDateFormat("EEEE", java.util.Locale.CHINA).format(now));
            s2 = s2.replace("$date2", new java.text.SimpleDateFormat("M月d日", java.util.Locale.CHINA).format(now));
            s2 = s2.replace("$month", new java.text.SimpleDateFormat("M月", java.util.Locale.CHINA).format(now));
            s2 = s2.replace("$day", new java.text.SimpleDateFormat("d日", java.util.Locale.CHINA).format(now));
            s2 = s2.replace("$time2", new java.text.SimpleDateFormat("HH:mm:ss").format(now));
            s2 = s2.replace("$tomorrow", new java.text.SimpleDateFormat("M月d日", java.util.Locale.CHINA)
                    .format(new java.util.Date(now.getTime() + 86400000L)));
            s2 = s2.replace("$yesterday", new java.text.SimpleDateFormat("M月d日", java.util.Locale.CHINA)
                    .format(new java.util.Date(now.getTime() - 86400000L)));
            s2 = s2.replace("$greet", greetWord());
            s2 = s2.replace("$nl", "\n");
            if (s2.contains("$name")) {
                String nm = chatTalker == null ? "" : displayOfTalker(chatTalker);
                s2 = s2.replace("$name", nm);
            }
            if (s2.contains("$me")) {
                s2 = s2.replace("$me", cfg().optString("myNick", ""));
            }
            return s2;
        } catch (Throwable t) { return p; }
    }

    private static void showQuickPhrases(final android.app.Activity a, final android.widget.EditText et) {
        try {
            final java.util.ArrayList<String> ps = new java.util.ArrayList<String>();
            org.json.JSONArray arr = cfg().optJSONArray("quickPhrases");
            if (arr != null) for (int i = 0; i < arr.length(); i++) {
                String v = arr.optString(i, "");
                if (v.length() > 0) ps.add(v);
            }
            if (ps.isEmpty()) {
                ps.add("收到");
                ps.add("好的，马上处理");
                ps.add("稍等，我看一下");
            }
            final android.widget.ListView lv = new android.widget.ListView(a);
            final android.widget.ArrayAdapter<String> ad = new android.widget.ArrayAdapter<String>(
                    a, android.R.layout.simple_list_item_1, ps);
            lv.setAdapter(ad);

            // 变量快捷栏：点一下把变量插进输入框
            android.widget.HorizontalScrollView hs = new android.widget.HorizontalScrollView(a);
            android.widget.LinearLayout varRow = new android.widget.LinearLayout(a);
            varRow.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            varRow.setPadding(dp(a, 10), dp(a, 8), dp(a, 6), dp(a, 4));
            final String[][] vars = {
                    {"$date", "日期"}, {"$time", "时间"}, {"$weekday", "星期"},
                    {"$name", "会话名"}, {"$me", "我的昵称"}
            };
            for (final String[] vv : vars) {
                android.widget.TextView chip = new android.widget.TextView(a);
                chip.setText(vv[1] + " " + vv[0]);
                chip.setTextSize(12);
                chip.setTextColor(0xFF2E7D32);
                android.graphics.drawable.GradientDrawable cg = new android.graphics.drawable.GradientDrawable();
                cg.setColor(0xFFEAF6EE);
                cg.setCornerRadius(dp(a, 14));
                chip.setBackground(cg);
                chip.setPadding(dp(a, 10), dp(a, 6), dp(a, 10), dp(a, 6));
                android.widget.LinearLayout.LayoutParams clp =
                        new android.widget.LinearLayout.LayoutParams(-2, -2);
                clp.rightMargin = dp(a, 6);
                chip.setLayoutParams(clp);
                chip.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try {
                            android.widget.EditText target = currentInput();
                            if (target == null) target = et;
                            if (target == null) { toast("没找到输入框"); return; }
                            int st = target.getSelectionStart();
                            if (st < 0) st = target.getText().length();
                            target.getText().insert(st, vv[0]);
                            toast("已插入 " + vv[0] + "（发送时替换为实际值）");
                        } catch (Throwable ignore) { }
                    }
                });
                varRow.addView(chip);
            }
            hs.addView(varRow);

            final android.app.AlertDialog[] dlgRef = new android.app.AlertDialog[1];

            lv.setOnItemClickListener(new android.widget.AdapterView.OnItemClickListener() {
                @Override public void onItemClick(android.widget.AdapterView<?> p, android.view.View v, int pos, long id) {
                    try {
                        android.widget.EditText target = currentInput();
                        if (target == null) target = et;
                        if (target == null) { toast("没找到输入框"); return; }
                        String phrase = expandPhrase(ps.get(pos));
                        int st = target.getSelectionStart();
                        if (st < 0) st = target.getText().length();
                        target.getText().insert(st, phrase);
                        log("QP|insert " + phrase + " len=" + target.getText().length());
                        try { if (dlgRef[0] != null) dlgRef[0].dismiss(); } catch (Throwable ignore) { }
                        if (cfg().optBoolean("qpAutoSend", true)) {
                            final android.app.Activity fa = a;
                            target.postDelayed(new Runnable() {
                                @Override public void run() { sendNow(fa); }
                            }, 200);
                        }
                    } catch (Throwable t) { log("QP|click err " + t); toast("插入失败：" + t); }
                }
            });

            // 长按删除
            lv.setOnItemLongClickListener(new android.widget.AdapterView.OnItemLongClickListener() {
                @Override public boolean onItemLongClick(android.widget.AdapterView<?> p, android.view.View v, final int pos, long id) {
                    final String phrase = ps.get(pos);
                    new android.app.AlertDialog.Builder(a)
                            .setTitle("常用语")
                            .setItems(new String[]{"置顶", "删除", "取消"}, new android.content.DialogInterface.OnClickListener() {
                                @Override public void onClick(android.content.DialogInterface d, int w) {
                                    if (w == 0) {
                                        try {
                                            JSONObject o = readCfg();
                                            org.json.JSONArray a2 = o.optJSONArray("quickPhrases");
                                            org.json.JSONArray out = new org.json.JSONArray();
                                            out.put(phrase);
                                            if (a2 != null) for (int i = 0; i < a2.length(); i++) {
                                                String v0 = a2.optString(i, "");
                                                if (v0.length() > 0 && !v0.equals(phrase)) out.put(v0);
                                            }
                                            o.put("quickPhrases", out);
                                            writeCfg(o);
                                            cfg = null; cfgAt = 0; cfgChkAt = 0;
                                            ps.clear();
                                            org.json.JSONArray na = cfg().optJSONArray("quickPhrases");
                                            if (na != null) for (int i = 0; i < na.length(); i++) {
                                                String v1 = na.optString(i, "");
                                                if (v1.length() > 0) ps.add(v1);
                                            }
                                            ad.notifyDataSetChanged();
                                            lv.setSelection(0);
                                            toast("已置顶：" + phrase);
                                        } catch (Throwable t) { toast("置顶失败"); }
                                        return;
                                    }
                                    if (w != 1) return;
                                    try {
                                        JSONObject o = readCfg();
                                        org.json.JSONArray a2 = o.optJSONArray("quickPhrases");
                                        org.json.JSONArray out = new org.json.JSONArray();
                                        if (a2 != null) for (int i = 0; i < a2.length(); i++) {
                                            String v0 = a2.optString(i, "");
                                            if (v0.length() > 0 && !v0.equals(phrase)) out.put(v0);
                                        }
                                        o.put("quickPhrases", out);
                                        writeCfg(o);
                                        cfg = null; cfgAt = 0; cfgChkAt = 0;
                                        ps.clear();
                                        org.json.JSONArray nd = cfg().optJSONArray("quickPhrases");
                                        if (nd != null) for (int i = 0; i < nd.length(); i++) {
                                            String v1 = nd.optString(i, "");
                                            if (v1.length() > 0) ps.add(v1);
                                        }
                                        ad.notifyDataSetChanged();
                                        toast("已删除");
                                    } catch (Throwable t) { toast("删除失败"); }
                                }
                            })
                            .show();
                    if (true) return true;
                    new android.app.AlertDialog.Builder(a)
                            .setTitle("删除常用语")
                            .setMessage(phrase)
                            .setPositiveButton("删除", new android.content.DialogInterface.OnClickListener() {
                                @Override public void onClick(android.content.DialogInterface d, int w) {
                                    try {
                                        JSONObject o = readCfg();
                                        org.json.JSONArray a2 = o.optJSONArray("quickPhrases");
                                        org.json.JSONArray out = new org.json.JSONArray();
                                        if (a2 != null) for (int i = 0; i < a2.length(); i++) {
                                            String v2 = a2.optString(i, "");
                                            if (!v2.equals(phrase)) out.put(v2);
                                        }
                                        o.put("quickPhrases", out);
                                        writeCfg(o);
                                        ps.remove(pos);
                                        ad.notifyDataSetChanged();
                                        log("QP|deleted " + phrase + " left=" + ps.size());
                                        toast("已删除");
                                    } catch (Throwable t) { toast("删除失败：" + t); }
                                }
                            })
                            .setNegativeButton("取消", null)
                            .show();
                    return true;
                }
            });

            dlgRef[0] = new android.app.AlertDialog.Builder(a)
                    .setTitle("常用语")
                    .setView(lv)
                    .setNeutralButton("编辑", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) { editQuickPhrases(a); }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { log("QP|" + t); }
    }

    /** 编辑常用语 */
    private static void editQuickPhrases(final android.app.Activity a) {
        try {
            final android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 16), dp(a, 10), dp(a, 16), dp(a, 6));
            final android.widget.TextView list = new android.widget.TextView(a);
            list.setTextSize(13);
            list.setTextColor(0xFF44444C);
            box.addView(list);
            final android.widget.EditText input = new android.widget.EditText(a);
            input.setHint("输入一句常用语（可多行，用 $nl 做换行模板）");
            input.setTextSize(13);
            input.setSingleLine(false);
            input.setMinLines(2);
            input.setGravity(android.view.Gravity.TOP | android.view.Gravity.START);
            box.addView(input, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 84)));

            // 变量选择：点一下插入到输入框光标处
            android.widget.TextView vtip = new android.widget.TextView(a);
            vtip.setText("可插入变量（发送时自动替换）");
            vtip.setTextSize(11);
            vtip.setTextColor(0xFF9A9AA3);
            vtip.setPadding(0, dp(a, 6), 0, dp(a, 2));
            box.addView(vtip);

            android.widget.HorizontalScrollView vhs = new android.widget.HorizontalScrollView(a);
            android.widget.LinearLayout vrow = new android.widget.LinearLayout(a);
            vrow.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            final String[][] vlist = {
                    {"日期", "$date"}, {"中文日期", "$date2"}, {"时间", "$time"},
                    {"时分秒", "$time2"}, {"星期", "$weekday"}, {"月份", "$month"},
                    {"几号", "$day"}, {"明天", "$tomorrow"}, {"昨天", "$yesterday"},
                    {"问候", "$greet"}, {"会话名", "$name"}, {"我的昵称", "$me"},
                    {"换行", "$nl"}
            };
            for (final String[] vv : vlist) {
                android.widget.TextView chip = new android.widget.TextView(a);
                chip.setText(vv[0] + " " + vv[1]);
                chip.setTextSize(12);
                chip.setTextColor(0xFF2E7D32);
                android.graphics.drawable.GradientDrawable cg = new android.graphics.drawable.GradientDrawable();
                cg.setColor(0xFFEAF6EE);
                cg.setCornerRadius(dp(a, 14));
                chip.setBackground(cg);
                chip.setPadding(dp(a, 10), dp(a, 6), dp(a, 10), dp(a, 6));
                android.widget.LinearLayout.LayoutParams clp =
                        new android.widget.LinearLayout.LayoutParams(-2, -2);
                clp.rightMargin = dp(a, 6);
                chip.setLayoutParams(clp);
                chip.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try {
                            int st = input.getSelectionStart();
                            if (st < 0) st = input.getText().length();
                            input.getText().insert(st, vv[1]);
                            input.requestFocus();
                        } catch (Throwable ignore) { }
                    }
                });
                vrow.addView(chip);
            }
            vhs.addView(vrow);
            box.addView(vhs);

            final Runnable refresh = new Runnable() {
                @Override public void run() {
                    StringBuilder sb = new StringBuilder();
                    org.json.JSONArray arr = cfg().optJSONArray("quickPhrases");
                    if (arr == null || arr.length() == 0) sb.append("暂无常用语");
                    else for (int i = 0; i < arr.length(); i++) sb.append(i + 1).append(". ").append(arr.optString(i)).append("\n");
                    list.setText(sb.toString());
                }
            };
            refresh.run();

            new android.app.AlertDialog.Builder(a)
                    .setTitle("常用语")
                    .setView(box)
                    .setPositiveButton("添加", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            String v = input.getText().toString().trim();
                            if (v.length() == 0) { return; }
                            try {
                                org.json.JSONObject o = readCfg();
                                org.json.JSONArray arr = o.optJSONArray("quickPhrases");
                                if (arr == null) arr = new org.json.JSONArray();
                                arr.put(v);
                                o.put("quickPhrases", arr);
                                writeCfg(o);
                                cfg = null;
                                cfgAt = 0;
                                toast("已添加");
                            } catch (Throwable ignore) { }
                        }
                    })
                    .setNeutralButton("清空", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                org.json.JSONObject o = readCfg();
                                o.put("quickPhrases", new org.json.JSONArray());
                                writeCfg(o);
                                cfg = null;
                                cfgAt = 0;
                                toast("已清空");
                            } catch (Throwable ignore) { }
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { log("QP|edit " + t); }
    }

    /** 通知关键词屏蔽 */
    private static void installNotifyFilter(ClassLoader app) {
        try {
            Class<?> nm = Class.forName("android.app.NotificationManager", false, app);
            XposedBridge.hookAllMethods(nm, "notify", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        String kw = cfg().optString("notifyBlockKw", "");
                        if (kw.trim().length() == 0) return;
                        android.app.Notification n = null;
                        for (Object a0 : p.args) {
                            if (a0 instanceof android.app.Notification) { n = (android.app.Notification) a0; break; }
                        }
                        if (n == null || n.extras == null) return;
                        String all = "" + n.extras.getCharSequence(android.app.Notification.EXTRA_TITLE)
                                + " " + n.extras.getCharSequence(android.app.Notification.EXTRA_TEXT)
                                + " " + n.extras.getCharSequence(android.app.Notification.EXTRA_BIG_TEXT)
                                + " " + n.extras.getCharSequence(android.app.Notification.EXTRA_SUMMARY_TEXT);
                        // 群消息仅关键词提醒
                        try {
                            String gk = cfg().optString("groupOnlyKw", "");
                            if (gk.trim().length() > 0) {
                                CharSequence tt = n.extras.getCharSequence(android.app.Notification.EXTRA_TITLE);
                                String titleS = tt == null ? "" : tt.toString();
                                boolean isGroup = titleS.matches(".*\\(\\d+\\)\\s*$");
                                if (isGroup) {
                                    boolean hit = false;
                                    for (String k : gk.split(",")) {
                                        String kk = k.trim();
                                        if (kk.length() > 0 && all.contains(kk)) { hit = true; break; }
                                    }
                                    if (!hit) {
                                        p.setResult(null);
                                        log("NOTIF|mute group " + titleS);
                                        return;
                                    }
                                }
                            }
                        } catch (Throwable ignore) { }
                        String[] ks = kw.split(",");
                        for (String k : ks) {
                            String kk = k.trim();
                            if (kk.length() > 0 && all.contains(kk)) {
                                p.setResult(null);
                                log("NOTIF|block " + kk);
                                return;
                            }
                        }
                    } catch (Throwable ignore) { }
                }
            });
            log("hooked notifyFilter");
        } catch (Throwable t) { log("notif err " + t); }
    }
    /** 会话最后一条消息摘要（群消息前缀换成备注名） */
    private static final java.util.HashMap<String, String> senderNameCache = new java.util.HashMap<String, String>();

    private static String senderName(String id) {
        if (id == null || id.length() == 0) return "";
        String c = senderNameCache.get(id);
        if (c != null) return c;
        String nm = "";
        try {
            if (nameMap != null) {
                String v = nameMap.get(id);
                if (v != null) nm = v;
            }
            if (nm.length() == 0) {
                java.util.List<Object[]> rr = queryRows(
                    "select conRemark, nickname from rcontact where username='" + id + "'", 2);
                if (!rr.isEmpty()) {
                    Object a1 = rr.get(0)[0], a2 = rr.get(0)[1];
                    if (a1 != null && String.valueOf(a1).trim().length() > 0) nm = String.valueOf(a1).trim();
                    else if (a2 != null && String.valueOf(a2).trim().length() > 0) nm = String.valueOf(a2).trim();
                }
            }
        } catch (Throwable ignore) { }
        if (senderNameCache.size() > 800) senderNameCache.clear();
        senderNameCache.put(id, nm);
        return nm;
    }

    private static String lastMsgOf(String u) {
        try {
            java.util.List<Object[]> l2 = queryRows(
                "select content, type from message where talker='" + u + "' order by createTime desc limit 1", 2);
            if (l2.isEmpty()) return "";
            Object co = l2.get(0)[0];
            int ty = 1;
            try { ty = Integer.parseInt(String.valueOf(l2.get(0)[1]).trim()); } catch (Throwable ignore) { }
            String c = co == null ? "" : String.valueOf(co);
            String who = "";
            int ci = c.indexOf(':');
            if (ci > 0 && ci < 64) {
                String head = c.substring(0, ci).trim();
                boolean isId = head.startsWith("wxid_") || head.endsWith("@chatroom") || head.contains("@openim");
                if (isId) {
                    c = c.substring(ci + 1);
                    if (head.startsWith("wxid_")) who = senderName(head);
                }
            }
            String body;
            switch (ty) {
                case 3:  body = "[图片]"; break;
                case 34: body = "[语音]"; break;
                case 43: body = "[视频]"; break;
                case 47: body = "[表情]"; break;
                case 48: body = "[位置]"; break;
                case 42: body = "[名片]"; break;
                case 50: body = "[语音通话]"; break;
                case 49: {
                    String title = tagOf(c, "title");
                    body = title.length() == 0 ? "[链接]" : "[链接] " + title;
                    break;
                }
                default: body = prettyContent(c); break;
            }
            if (body == null || body.length() == 0) body = "[消息]";
            if (who != null && who.length() > 0) return who + ": " + body;
            return body;
        } catch (Throwable t) { return ""; }
    }

