    private static void setStrCfg(String key, String val) {
        try {
            File f = new File(DIR, "wxh_config.json");
            byte[] b = new byte[(int) f.length()];
            java.io.FileInputStream in = new java.io.FileInputStream(f);
            int got = 0;
            while (got < b.length) {
                int r = in.read(b, got, b.length - got);
                if (r <= 0) break;
                got += r;
            }
            in.close();
            JSONObject o = new JSONObject(new String(b, "UTF-8"));
            o.put(key, val);
            java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
            fo.write(o.toString(2).getBytes("UTF-8"));
            fo.close();
            cfg = null; cfgAt = 0;
            boolean secret = key != null && key.toLowerCase().indexOf("cookie") >= 0;
            log("SETTINGS|" + key + (secret ? "=len:" + (val == null ? 0 : val.length()) : "=" + val));
        } catch (Throwable t) { log("setStr err " + t); }
    }
    private static String previewOf(org.json.JSONObject c, String key) {
        try {
            org.json.JSONArray a = c.optJSONArray(key);
            if (a == null || a.length() == 0) return "";
            StringBuilder sb = new StringBuilder("（");
            for (int i = 0; i < Math.min(3, a.length()); i++) {
                if (i > 0) sb.append('、');
                sb.append(a.optString(i));
            }
            if (a.length() > 3) sb.append("…");
            sb.append('）');
            return sb.toString();
        } catch (Throwable t) {
            return "";
        }
    }

    private static String countOf(org.json.JSONObject c, String key) {
        org.json.JSONArray a = c.optJSONArray(key);
        return String.valueOf(a == null ? 0 : a.length());
    }

    private static String onOff(boolean b) {
        return b ? "开" : "关";
    }

