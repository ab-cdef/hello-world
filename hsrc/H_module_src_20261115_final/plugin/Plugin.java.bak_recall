    private static boolean isOn(String key) {
        if ("diceOn".equals(key)) return cfg().optInt("dice", 0) > 0;
        if ("keywordAlertOn".equals(key)) {
            org.json.JSONArray a = cfg().optJSONArray("keywordAlert");
            return a != null && a.length() > 0;
        }
        if ("snsKeywordOn".equals(key)) {
            org.json.JSONArray a = cfg().optJSONArray("snsHideKeywords");
            return a != null && a.length() > 0;
        }
        if ("quietOn".equals(key)) return cfg().optInt("quietStart", -1) >= 0;
        return cfg().optBoolean(key, true);
    }

    private static void setOn(String key, boolean val) {
        try {
            JSONObject o = new JSONObject();
            File f = new File(DIR, "wxh_config.json");
            FileInputStream in = new FileInputStream(f);
            byte[] b = new byte[(int) f.length()];
            int got = 0;
            while (got < b.length) {
                int r = in.read(b, got, b.length - got);
                if (r <= 0) break;
                got += r;
            }
            in.close();
            o = new JSONObject(new String(b, "UTF-8"));
            if ("diceOn".equals(key)) {
                o.put("dice", val ? 6 : 0);
            } else if ("keywordAlertOn".equals(key)) {
                o.put("keywordAlert", val ? new org.json.JSONArray().put("在吗") : new org.json.JSONArray());
            } else if ("snsKeywordOn".equals(key)) {
                o.put("snsHideKeywords", val ? new org.json.JSONArray().put("抽奖") : new org.json.JSONArray());
            } else if ("quietOn".equals(key)) {
                o.put("quietStart", val ? 23 : -1);
                o.put("quietEnd", val ? 7 : -1);
            } else {
                o.put(key, val);
            }
            java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
            fo.write(o.toString(2).getBytes("UTF-8"));
            fo.close();
            cfg = null;
            cfgAt = 0;
            cfgChkAt = 0;
            cfg = null;
            cfgAt = 0;
            cfgChkAt = 0;
            log("SETTINGS|" + key + "=" + val);
            reapplyNow();
        } catch (Throwable t) {
            log("settings save err " + t);
        }
    }

    /** 设置一改就立即生效：重建工具栏 + 重刷气泡/提示 + 通知列表重绘 */
    private static void reapplyNow() {
        try {
            final android.app.Activity a = uiActRef != null ? uiActRef : chatAct;
            if (a == null) { log("APPLY|no act"); return; }
            a.runOnUiThread(new Runnable() {
                @Override public void run() {
                    try {
                        android.view.View decor = a.getWindow().getDecorView();
                        android.view.View tools = decor.findViewWithTag("wxhChatTools");
                        if (tools != null && tools.getParent() instanceof android.view.ViewGroup) {
                            ((android.view.ViewGroup) tools.getParent()).removeView(tools);
                        }
                        try { resprayBubbleSkin(a); } catch (Throwable ignore) { }
                        try { applyInputHint(); } catch (Throwable ignore) { }
                        java.util.List<Object> lists = new java.util.ArrayList<Object>();
                        collectLists(decor, lists);
                        for (Object rv : lists) {
                            try {
                                Object ad = rv.getClass().getMethod("getAdapter").invoke(rv);
                                if (ad != null) ad.getClass().getMethod("notifyDataSetChanged").invoke(ad);
                            } catch (Throwable ignore) { }
                        }
                        log("APPLY|live reapply done");
                    } catch (Throwable t) { log("APPLY|err " + t); }
                }
            });
        } catch (Throwable ignore) { }
    }

    /** 写整数型配置（气泡主题这类多选值用） */
    private static void setIntCfg(String key, int val) {
        try {
            File f = new File(DIR, "wxh_config.json");
            byte[] b = new byte[(int) f.length()];
            java.io.FileInputStream in = new java.io.FileInputStream(f);
            int got = 0;
            while (got < b.length) {
                int r = in.read(b, got, b.length - got);
                if (r <= 0) break;
                got += r;
            }
            in.close();
            JSONObject o = new JSONObject(new String(b, "UTF-8"));
            o.put(key, val);
            java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
            fo.write(o.toString(2).getBytes("UTF-8"));
            fo.close();
            cfg = null;
            cfgAt = 0;
            cfgChkAt = 0;
            log("SETTINGS|" + key + "=" + val);
        } catch (Throwable t) {
            log("settings save err " + t);
        }
    }

