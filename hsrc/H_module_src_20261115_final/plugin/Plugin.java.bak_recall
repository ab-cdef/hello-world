                                    .setNegativeButton("取消", null)
                                    .create();
                            dd[0].show();
                        } catch (Throwable t) { log("MEXP|picker err " + t); }
                    }
                });
            }
        }).start();
    }

    private static void runMediaExport(final android.app.Activity a, final String talker, final String name,
                                       final boolean img, final boolean voice, final boolean video,
                                       final boolean file, final long sinceMs, final String senderId) {
        expReset();
        final android.widget.TextView tv = new android.widget.TextView(a);
        tv.setText("准备中…");
        tv.setTextSize(15);
        tv.setPadding(dp(a, 20), dp(a, 18), dp(a, 20), dp(a, 8));
        android.widget.ProgressBar pb = new android.widget.ProgressBar(a);
        pb.setIndeterminate(true);
        android.widget.LinearLayout box = new android.widget.LinearLayout(a);
        box.setOrientation(android.widget.LinearLayout.VERTICAL);
        box.addView(tv);
        box.addView(pb);
        final android.app.AlertDialog dlg = new android.app.AlertDialog.Builder(a)
                .setTitle("正在导出 " + name)
                .setView(box)
                .setNegativeButton("取消", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        expCancel = true;
                    }
                })
                .setCancelable(false)
                .create();
        dlg.show();

        final boolean[] live = {true};
        final Runnable ticker = new Runnable() {
            @Override public void run() {
                if (!live[0]) return;
                tv.setText(expStage + "\n已处理 " + expSeen + " 条 · 导出 " + expGot + " · 跳过 " + expSkip);
                a.getWindow().getDecorView().postDelayed(this, 400);
            }
        };
        ticker.run();

        new Thread(new Runnable() {
            @Override public void run() {
                int ni = 0, nv = 0, nm = 0, nf = 0;
                String err = null;
                java.io.File base = null;
                try {
                    base = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                            "Download/wxh/export/" + safeName(name));
                    java.io.File di = new java.io.File(base, "images");
                    java.io.File dv = new java.io.File(base, "voice");
                    java.io.File dm = new java.io.File(base, "video");
                    java.io.File df = new java.io.File(base, "files");
                    if (img) di.mkdirs();
                    if (voice) dv.mkdirs();
                    if (video) dm.mkdirs();
                    if (file) df.mkdirs();
                    if (img && !expCancel) { expStage = "正在导出图片"; ni = exportImages(talker, sinceMs, di, senderId); }
                    if (voice && !expCancel) { expStage = "正在导出语音"; nv = exportVoiceOf(talker, sinceMs, dv, senderId); }
                    if (video && !expCancel) { expStage = "正在匹配视频"; nm = exportVideoOfX(talker, sinceMs, dm, false, senderId); }
                    if (file && !expCancel) { expStage = "正在导出文件"; nf = exportFileOf(talker, sinceMs, df, senderId); }
                    expStage = expCancel ? "已取消" : "已完成";
                } catch (Throwable t) {
                    err = String.valueOf(t);
                    log("MEXP|err " + t);
                }

                // 未匹配清单
                String missFile = "";
                try {
                    if (base != null && expMissing.length() > 0) {
                        java.io.File mf = new java.io.File(base, "_未导出清单.txt");
                        java.io.FileOutputStream fo = new java.io.FileOutputStream(mf, false);
                        fo.write(("\uFEFF未导出的媒体（共 " + expMissN + " 条）\n"
                                + "原因：本机没有缓存文件／同秒有歧义／拿不到关键字段\n\n"
                                + expMissing.toString()).getBytes("UTF-8"));
                        fo.close();
                        missFile = mf.getName();
                    }
                } catch (Throwable ignore) { }

                final String msg = (err != null ? "导出出错：" + err + "\n\n" : "")
                        + "图片 " + ni + " · 语音 " + nv + " · 视频 " + nm + " · 文件 " + nf + "\n"
                        + "跳过（已存在）" + expSkip + " 个\n"
                        + (missFile.length() > 0 ? "未导出清单：" + missFile + "\n" : "")
                        + "\n" + (base == null ? "" : base.getAbsolutePath());
                log("MEXP|done img=" + ni + " voice=" + nv + " video=" + nm + " file=" + nf
                        + " skip=" + expSkip + " cancel=" + expCancel);
                live[0] = false;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        try { dlg.dismiss(); } catch (Throwable ignore) { }
                        try { notifyLocal(a, expCancel ? "导出已取消" : "导出完成", msg); } catch (Throwable ignore) { }
                        new android.app.AlertDialog.Builder(a)
                                .setTitle(expCancel ? "已取消" : "导出完成")
                                .setMessage(msg)
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    private static byte[] readAllBytes(java.io.File f) {
        try {
            java.io.FileInputStream in = new java.io.FileInputStream(f);
            byte[] out = new byte[(int) f.length()];
            int off = 0;
            while (off < out.length) {
                int r = in.read(out, off, out.length - off);
                if (r <= 0) break;
                off += r;
            }
            in.close();
            return off == out.length ? out : java.util.Arrays.copyOf(out, off);
        } catch (Throwable t) {
            return null;
        }
    }

    private static void writeBytes(java.io.File dst, byte[] b) throws Exception {
        java.io.FileOutputStream fo = new java.io.FileOutputStream(dst);
        fo.write(b);
        fo.close();
    }

    private static byte[] aesDecryptNoPad(byte[] body, String keyHex) {
        try {
            if (keyHex == null || keyHex.length() != 32) return null;
            byte[] key = new byte[16];
            for (int i = 0; i < 16; i++) key[i] = (byte) Integer.parseInt(keyHex.substring(i * 2, i * 2 + 2), 16);
            javax.crypto.Cipher c = javax.crypto.Cipher.getInstance("AES/ECB/NoPadding");
            c.init(javax.crypto.Cipher.DECRYPT_MODE, new javax.crypto.spec.SecretKeySpec(key, "AES"));
            int len = body.length - (body.length % 16);
            if (len <= 0) return null;
            return c.doFinal(body, 0, len);
        } catch (Throwable t) {
            return null;
        }
    }

    private static byte[] trimJpeg(byte[] b) {
        try {
            for (int i = b.length - 2; i > 2; i--) {
                if ((b[i] & 0xFF) == 0xFF && (b[i + 1] & 0xFF) == 0xD9) {
                    return java.util.Arrays.copyOf(b, i + 2);
                }
            }
        } catch (Throwable ignore) { }
        return b;
    }

    private static boolean saveImageBytes(java.io.File src, String keyHex, java.io.File dst) {
        try {
            byte[] raw = readAllBytes(src);
            if (raw == null || raw.length < 8) return false;
            byte[] body = raw;
            if ((raw[0] & 0xFF) == 0x07 && (raw[1] & 0xFF) == 0x08 && raw.length > 20) {
                body = java.util.Arrays.copyOfRange(raw, 15, raw.length);
            }
            if (body.length > 2 && (body[0] & 0xFF) == 0xFF && (body[1] & 0xFF) == 0xD8) {
                writeBytes(dst, body);
                return true;
            }
            byte[] dec = aesDecryptNoPad(body, keyHex);
            if (dec != null && dec.length > 4) {
                byte[] jp = trimJpeg(dec);
                if ((jp[0] & 0xFF) == 0xFF && (jp[1] & 0xFF) == 0xD8) {
                    writeBytes(dst, jp);
                    return true;
                }
                android.graphics.Bitmap bm2 = android.graphics.BitmapFactory.decodeByteArray(dec, 0, dec.length);
                if (bm2 != null) {
                    java.io.FileOutputStream fo = new java.io.FileOutputStream(dst);
                    bm2.compress(android.graphics.Bitmap.CompressFormat.JPEG, 92, fo);
                    fo.close();
                    bm2.recycle();
                    return true;
                }
            }
            android.graphics.Bitmap bm = android.graphics.BitmapFactory.decodeByteArray(body, 0, body.length);
            if (bm != null) {
                java.io.FileOutputStream fo = new java.io.FileOutputStream(dst);
                bm.compress(android.graphics.Bitmap.CompressFormat.JPEG, 92, fo);
                fo.close();
                bm.recycle();
                return true;
            }
            writeBytes(new java.io.File(dst.getAbsolutePath() + ".raw.jpg"), body);
        } catch (Throwable t) { }
        return false;
    }

    /* ================= 媒体导出：进度 / 取消 / 增量 / 发送人筛选 ================= */

    static volatile boolean expCancel = false;
    // 调试用：设置后下一次 Activity 恢复时直接调起导出（走真实 UI 流程）
    static volatile String vuiTalker = null, vuiName = null;
    static volatile String expStage = "";
    static volatile int expSeen = 0, expGot = 0, expSkip = 0, expMissN = 0;
    static StringBuilder expMissing = new StringBuilder();

    private static void expReset() {
        expCancel = false;
        expStage = "准备中";
        expSeen = 0; expGot = 0; expSkip = 0; expMissN = 0;
        expMissing = new StringBuilder();
    }

    /**
     * 从群消息 content 里取原始发送人 id。
     * 实测群消息前缀是 "<id>:<x>:<y>\n<正文>"，id 不一定以 wxid_ 开头（有 wuyifu1749 这种）。
     * 但自己发的消息没有前缀，正文里可能自带冒号（如「12:30 开会」），所以要能区分：
     * 只认「id 形态」的头，且长度 >= 5、必须含字母。
     */
    private static String senderIdOfGroupMsg(String content) {
        try {
            if (content == null) return null;
            int idx = content.indexOf(':');
            if (idx <= 0 || idx > 64) return null;
            String head = content.substring(0, idx).trim();
            if (head.length() == 0 || head.indexOf('<') >= 0) return null;
            boolean strong = head.startsWith("wxid_") || head.endsWith("@chatroom")
                    || head.endsWith("@openim");
            boolean hasLetter = false;
            for (int i = 0; i < head.length(); i++) {
                char c = head.charAt(i);
                boolean ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
                        || (c >= '0' && c <= '9') || c == '_' || c == '@' || c == '.' || c == '-';
                if (!ok) return null;
                if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) hasLetter = true;
            }
            if (strong) return head;
            if (head.length() >= 5 && hasLetter) return head;
            return null;
        } catch (Throwable t) { return null; }
    }

    private static boolean passSender(String content, String senderId) {
        if (senderId == null || senderId.length() == 0) return true;
        return senderId.equals(senderIdOfGroupMsg(content));
    }

    private static void expMiss(String what, long ctRaw, String why) {
        try {
            java.text.SimpleDateFormat f =
                    new java.text.SimpleDateFormat("MM-dd HH:mm:ss", java.util.Locale.US);
            expMissing.append(f.format(new java.util.Date(ctToMs(ctRaw))))
                      .append("  ").append(what).append("  —  ").append(why).append('\n');
            expMissN++;
        } catch (Throwable ignore) { }
    }

    /** 增量：目标文件已存在且大小一致 → 视为上次already导出过 */
    private static boolean alreadyExported(java.io.File dst, long srcLen) {
        try {
            return dst.isFile() && dst.length() > 0 && (srcLen <= 0 || dst.length() == srcLen);
        } catch (Throwable t) { return false; }
    }

    private static int exportImages(String talker, long sinceMs, java.io.File dir, String senderId) {
        int ok = 0, idx = 0;
        try {
            String sql = "select msgSvrId, ifnull(imgPath,''), ifnull(content,''), createTime from message"
                    + " where talker='" + escSql(talker) + "' and (type & 65535)=3"
                    + (sinceMs > 0 ? " and createTime>=" + sinceRaw(sinceMs) : "")
                    + " order by createTime";
            java.util.List<Object[]> rows = queryRows(sql, 4);
            java.text.SimpleDateFormat fmt =
                    new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US);
            for (Object[] r : rows) {
                if (expCancel) break;
                expSeen++;
                try {
                    long svr = 0;
                    try { svr = Long.parseLong(String.valueOf(r[0])); } catch (Throwable ignore) { }
                    String ip = r[1] == null ? "" : String.valueOf(r[1]);
                    String content = r[2] == null ? "" : String.valueOf(r[2]);
                    long ct = 0;
                    try { ct = Long.parseLong(String.valueOf(r[3])); } catch (Throwable ignore) { }
                    String key = attrOf(content, "aeskey");
                    java.io.File src = null;
                    if (svr > 0) {
                        java.util.List<Object[]> p = queryRows("select ifnull(bigImgPath,''), ifnull(thumbImgPath,'')"
                                + " from ImgInfo2 where msgSvrId=" + svr + " limit 1", 2);
                        if (!p.isEmpty()) {
                            String big = p.get(0)[0] == null ? "" : String.valueOf(p.get(0)[0]);
                            String th = p.get(0)[1] == null ? "" : String.valueOf(p.get(0)[1]);
                            if (big.length() > 0 && new java.io.File(big).isFile()) src = new java.io.File(big);
                            else if (th.length() > 0 && new java.io.File(th).isFile()) src = new java.io.File(th);
                        }
                    }
                    if (src == null && ip.length() > 0) {
                        java.io.File f = new java.io.File(ip);
                        if (f.isFile()) src = f;
                        else if (ip.contains("th_")) {
                            String md5 = ip.substring(ip.indexOf("th_") + 3);
                            int cut = md5.indexOf('/');
                            if (cut > 0) md5 = md5.substring(0, cut);
                            String p2 = resolveThumbPath(md5);
                            if (p2 != null) src = new java.io.File(p2);
                        }
                    }
                    if (!passSender(content, senderId)) continue;
                    if (src == null || !src.isFile()) { expMiss("图片", ct, "本机没有原图/缩略图"); continue; }
                    idx++;
                    String bn = (ct > 0 ? fmt.format(new java.util.Date(ctToMs(ct))) : "img") + "_" + idx;
                    java.io.File dst = new java.io.File(dir, bn + ".jpg");
                    if (alreadyExported(dst, 0)) { expSkip++; continue; }
                    if (saveImageBytes(src, key, dst)) { ok++; expGot++; }
                    else expMiss("图片", ct, "解密失败");
                } catch (Throwable ignore) { }
            }
        } catch (Throwable t) { log("MEXP|img err " + t); }
        log("MEXP|images ok=" + ok + " seen=" + idx);
        return ok;
    }

    private static java.util.ArrayList<java.io.File> voiceBases() {
        java.util.ArrayList<java.io.File> bases = new java.util.ArrayList<java.io.File>();
        try {
            java.io.File mm = new java.io.File(mmBase() + "/MicroMsg");
            java.io.File[] subs = mm.listFiles();
            if (subs != null) for (java.io.File f : subs) {
                if (f.isDirectory() && new java.io.File(f, "voice2").isDirectory()) bases.add(f);
            }
        } catch (Throwable ignore) { }
        return bases;
    }

    /**
     * 语音缓存真实结构（设备实测）：MicroMsg/<hash>/voice2/<2位>/<2位>/msg_amr_<yyMMddHHmmss+随机>.amr
     * 旧实现只找 voice2/<2位>/msg_<md5>.amr，永远 0 命中。
     * 现在递归收集全部 .amr，用文件名里嵌的时间键精确匹配消息 createTime；
     * 拿不到时间键时退回「文件名包含消息 md5」的匹配。
     */
    private static java.util.HashMap<String, java.util.ArrayList<java.io.File>> voiceIndex = null;
    private static long voiceIndexAt = 0;

    private static java.util.HashMap<String, java.util.ArrayList<java.io.File>> voiceFiles() {
        long now = System.currentTimeMillis();
        if (voiceIndex != null && now - voiceIndexAt < 60000) return voiceIndex;
        java.util.HashMap<String, java.util.ArrayList<java.io.File>> idx =
                new java.util.HashMap<String, java.util.ArrayList<java.io.File>>();
        try {
            for (java.io.File b : voiceBases()) {
                java.io.File v2 = new java.io.File(b, "voice2");
                collectAmr(v2, idx, 0);
            }
        } catch (Throwable ignore) { }
        voiceIndex = idx;
        voiceIndexAt = now;
        return idx;
    }

    private static void collectAmr(java.io.File d, java.util.HashMap<String, java.util.ArrayList<java.io.File>> idx, int depth) {
        if (d == null || depth > 3) return;
        java.io.File[] fs;
        try { fs = d.listFiles(); } catch (Throwable t) { return; }
        if (fs == null) return;
        for (java.io.File f : fs) {
            if (f.isDirectory()) { collectAmr(f, idx, depth + 1); continue; }
            String nm = f.getName();
            if (!nm.endsWith(".amr")) continue;
            String k = timeKeyInName(nm);
            if (k != null) {
                java.util.ArrayList<java.io.File> l = idx.get(k);
                if (l == null) { l = new java.util.ArrayList<java.io.File>(); idx.put(k, l); }
                l.add(f);
            }
            java.util.ArrayList<java.io.File> all = idx.get("#all");
            if (all == null) { all = new java.util.ArrayList<java.io.File>(); idx.put("#all", all); }
            all.add(f);
            java.util.ArrayList<java.io.File> nm2 = idx.get("#n:" + nm);
            if (nm2 == null) { nm2 = new java.util.ArrayList<java.io.File>(); idx.put("#n:" + nm, nm2); }
            nm2.add(f);
        }
    }

    private static boolean isAllDigits(String s) {
        if (s == null || s.length() == 0) return false;
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c < '0' || c > '9') return false;
        }
        return true;
    }

    /** 从文件名里找 12 位 yyMMddHHmmss，找不到就依次试后面几位 */
    private static String timeKeyInName(String nm) {
        for (int i = 0; i + 12 <= nm.length(); i++) {
            if (!isAllDigits(nm.substring(i, i + 12))) continue;
            String k = nm.substring(i, i + 12);
            try {
                java.text.SimpleDateFormat f =
                        new java.text.SimpleDateFormat("yyMMddHHmmss", java.util.Locale.US);
                f.setLenient(false);
                f.parse(k);
                return k;
            } catch (Throwable ignore) { }
        }
        return null;
    }

    private static int exportVoiceOf(String talker, long sinceMs, java.io.File dir, String senderId) {
        int ok = 0, miss = 0, byTime = 0, byMd5 = 0, byName = 0;
        try {
            String sql = "select msgId, ifnull(imgPath,''), createTime, ifnull(content,'') from message where talker='"
                    + escSql(talker) + "' and (type & 65535)=34"
                    + (sinceMs > 0 ? " and createTime>=" + sinceRaw(sinceMs) : "")
                    + " order by createTime";
            java.util.List<Object[]> rows = queryRows(sql, 4);
            java.util.HashMap<String, java.util.ArrayList<java.io.File>> idx = voiceFiles();
            java.util.ArrayList<java.io.File> all = idx.get("#all");
            if (all == null || all.isEmpty()) {
                log("MEXP|voice no cache files");
                return 0;
            }
            java.text.SimpleDateFormat fmt =
                    new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US);
            for (Object[] r : rows) {
                if (expCancel) break;
                expSeen++;
                try {
                    long mid = 0;
                    try { mid = Long.parseLong(String.valueOf(r[0])); } catch (Throwable ignore) { }
                    String ip = r[1] == null ? "" : String.valueOf(r[1]);
                    long ct = 0;
                    try { ct = Long.parseLong(String.valueOf(r[2])); } catch (Throwable ignore) { }
                    String content = r[3] == null ? "" : String.valueOf(r[3]);
                    if (!passSender(content, senderId)) continue;

                    java.io.File src = null;
                    // 0) 定名匹配：文件名 = "msg_" + imgPath + ".amr"
                    String ipn = ip.trim();
                    if (ipn.length() > 3) {
                        String[] cands = {"msg_" + ipn + ".amr", ipn + ".amr",
                                "msg_amr_" + ipn + ".amr"};
                        for (String cn2 : cands) {
                            java.util.ArrayList<java.io.File> l = idx.get("#n:" + cn2);
                            if (l != null && !l.isEmpty()) { src = l.get(0); byName++; break; }
                        }
                    }
                    // 1) 时间键精确匹配
                    if (src == null && ct > 0) {
                        java.util.ArrayList<java.io.File> l = idx.get(videoTimeKey(ctToSec(ct)));
                        if (l != null && l.size() == 1) { src = l.get(0); byTime++; }
                        else if (l != null && l.size() > 1) { miss++; expMiss("语音", ct, "同秒多条语音，无法确定"); continue; }
                    }
                    // 2) 退回 md5 包含匹配
                    if (src == null) {
                        String md5 = null;
                        int k = ip.indexOf("msg_");
                        if (k >= 0) md5 = ip.substring(k + 4).replace(".amr", "").trim();
                        if (md5 != null && md5.length() >= 16) {
                            for (java.io.File f : all) {
                                if (f.getName().contains(md5)) { src = f; byMd5++; break; }
                            }
                        }
                    }
                    if (src == null) { miss++; expMiss("语音", ct, "本机没有该语音文件"); continue; }
                    String bn = (ct > 0 ? fmt.format(new java.util.Date(ctToMs(ct))) : String.valueOf(mid))
                            + "_" + src.getName().replace("msg_amr_", "").replace(".amr", "");
                    if (bn.length() > 80) bn = bn.substring(0, 80);
                    java.io.File dst = new java.io.File(dir, bn + ".amr");
                    if (alreadyExported(dst, src.length())) { expSkip++; continue; }
                    copyFile(src, dst);
                    ok++; expGot++;
                } catch (Throwable ignore) { miss++; }
            }
        } catch (Throwable t) { log("MEXP|voice err " + t); }
        log("MEXP|voice ok=" + ok + " miss=" + miss + " byName=" + byName + " byTime=" + byTime + " byMd5=" + byMd5);
        return ok;
    }

    private static int exportFileOf(String talker, long sinceMs, java.io.File dir, String senderId) {
        int ok = 0, miss = 0;
        try {
            String sql = "select ifnull(content,''), createTime from message where talker='" + escSql(talker)
                    + "' and (type & 65535)=49 and content like '%<title>%'"
                    + (sinceMs > 0 ? " and createTime>=" + sinceRaw(sinceMs) : "")
                    + " order by createTime";
            java.util.List<Object[]> rows = queryRows(sql, 2);
            java.io.File mm = new java.io.File(mmBase() + "/MicroMsg");
            java.util.HashSet<String> done = new java.util.HashSet<String>();
            for (Object[] r : rows) {
                if (expCancel) break;
                expSeen++;
                try {
                    String content = r[0] == null ? "" : String.valueOf(r[0]);
                    long ct = 0;
                    try { ct = Long.parseLong(String.valueOf(r[1])); } catch (Throwable ignore) { }
                    if (!passSender(content, senderId)) continue;
                    String title = cleanXmlText(tagOf(content, "title"));
                    if (title == null || title.trim().length() < 3) { miss++; continue; }
                    title = title.trim();
                    if (!title.contains(".")) { miss++; continue; }
                    if (!done.add(title)) continue;
                    java.io.File src = findInAttach(mm, title);
                    if (src == null) { miss++; expMiss("文件", ct, "本机没下载：" + title); continue; }
                    java.io.File dst = new java.io.File(dir, safeName(title));
                    if (alreadyExported(dst, src.length())) { expSkip++; continue; }
                    copyFile(src, dst);
                    ok++; expGot++;
                } catch (Throwable ignore) { miss++; }
            }
        } catch (Throwable t) { log("MEXP|file err " + t); }
        log("MEXP|files ok=" + ok + " miss=" + miss);
        return ok;
    }

    /* ================= 视频导出（MicroMsg/<hash>/video 缓存匹配） =================
     * 命名规则（设备实测）：文件名 = [前缀 send|NS] + yyMMddHHmmss + 4位随机 + [origin|chatroom] + 扩展名
     * 前 12 位（yyMMddHHmmss）就是消息的创建时间，后可带 ⌖ 等脏字符，数字串也可能是 17 位。
     * 匹配策略：只认「消息 createTime == 文件名前 12 位」的精确命中；同秒出现多条不同视频视为有歧义，
     * 一律跳过。实测过 ±5 秒的模糊兜底会把别人 1~2 秒前的视频错配进来，所以彻底不用。
     * 图片 jpg 是同名缩略图，只取 mp4/mov 等视频扩展名。
     */

    /** 从缓存文件名提取 16 位数字键：跳过 send/NS 前缀，忽略 origin/chatroom/⌖ 后缀 */
    private static String videoKeyOf(String fn) {
        if (fn == null || fn.length() < 16) return null;
        int n = fn.length(), i = 0;
        while (i < n && !Character.isDigit(fn.charAt(i))) i++;
        int j = i;
        while (j < n && Character.isDigit(fn.charAt(j))) j++;
        if (j - i < 16) return null;
        return fn.substring(i, i + 16);
    }

    private static boolean isVideoExt(String fn) {
        String x = fn == null ? "" : fn.toLowerCase(java.util.Locale.US);
        return x.endsWith(".mp4") || x.endsWith(".mov") || x.endsWith(".m4v") || x.endsWith(".ts");
    }

    /** 时间戳（秒）-> yyMMddHHmmss，即缓存文件名的前 12 位 */
    private static String videoTimeKey(long sec) {
        java.text.SimpleDateFormat f =
                new java.text.SimpleDateFormat("yyMMddHHmmss", java.util.Locale.US);
        return f.format(new java.util.Date(sec * 1000L));
    }

    /**
     * 从候选里挑一个真正对应这条消息的视频。
     * 同一秒可能有多条不同视频（实测 2610242237012995 / 2610242237013126 同秒），
     * 因此必须 16 位完整键唯一才认；唯一后 multiple 副本（origin/chatroom）优先普通文件。
     * 返回 null = 有歧义，调用方必须跳过，绝不超过安全边际去猜。
     */
    private static java.io.File pickVideo(java.util.ArrayList<java.io.File> list) {
        if (list == null || list.isEmpty()) return null;
        java.util.HashSet<String> keys = new java.util.HashSet<String>();
        for (java.io.File f : list) {
            String k = videoKeyOf(f.getName());
            if (k != null) keys.add(k);
        }
        if (keys.size() != 1) return null;
        java.io.File best = null;
        for (java.io.File f : list) {
            if (best == null) { best = f; continue; }
            boolean bo = best.getName().contains("origin");
            boolean fo = f.getName().contains("origin");
            if (bo && !fo) { best = f; continue; }
            if (bo == fo && f.length() > best.length()) best = f;
        }
        return best;
    }

    /** 重名自动加序号：xxx.mp4 / xxx_2.mp4 … */
    private static java.io.File uniqueDst(java.io.File dir, String bid, String ext) {
        java.io.File f = new java.io.File(dir, bid + ext);
        int n = 2;
        while (f.exists() && n < 500) {
            f = new java.io.File(dir, bid + "_" + n + ext);
            n++;
        }
        return f;
    }

    /**
     * 启动自检：只有 /data/data/com.tencent.mm/files/wxh_vtest 存在时才跑（跑完自删）。
     * 对最近有视频的会话做一遍 dry-run 匹配，把每条会话的命中数写进日志，
     * 用来验证「文件名前 12 位 == 消息时间」这条规则，不写任何文件。
     */
    /** 无 UI 的真实导出（调试用）：talker|显示名 */
    private static void runVideoExportHeadless(String talker, String name, String senderId) {
        try {
            java.io.File base = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                    "Download/wxh/export/" + safeName(name));
            java.io.File dv = new java.io.File(base, "video");
            dv.mkdirs();
            java.io.File di = new java.io.File(base, "images");
            java.io.File dvv = new java.io.File(base, "voice");
            java.io.File df = new java.io.File(base, "files");
            di.mkdirs(); dvv.mkdirs(); dv.mkdirs(); df.mkdirs();
            expReset();
            long t0 = System.currentTimeMillis();
            int ni = exportImages(talker, 0, di, senderId);
            int nv = exportVoiceOf(talker, 0, dvv, senderId);
            int nm = exportVideoOfX(talker, 0, dv, false, senderId);
            int nf = exportFileOf(talker, 0, df, senderId);
            log("VEXP|" + talker + " sender=" + senderId + " img=" + ni + " voice=" + nv
                    + " video=" + nm + " file=" + nf + " skip=" + expSkip + " seen=" + expSeen
                    + " cost=" + (System.currentTimeMillis() - t0) + "ms dir=" + base);
        } catch (Throwable t) { log("VEXP|err " + t); }
    }

    static void maybeRunVideoSelfTest() {
        try {
            final java.io.File uif = new java.io.File(mmBase() + "/files/wxh_vui");
            if (uif.isFile()) {
                byte[] b = readAllBytes(uif);
                try { uif.delete(); } catch (Throwable ignore) { }
                String line = b == null ? "" : new String(b).trim();
                if (line.length() > 0) {
                    String[] pp = line.split("\\|");
                    vuiTalker = pp[0].trim();
                    vuiName = pp.length > 1 ? pp[1].trim() : "调试导出";
                    log("VUI|armed " + vuiTalker);
                }
            }
            final java.io.File sf = new java.io.File(mmBase() + "/files/wxh_vschema");
            if (sf.isFile()) {
                try { sf.delete(); } catch (Throwable ignore) { }
                new Thread(new Runnable() {
                    @Override public void run() {
                        for (int i = 0; i < 60; i++) {
                            if (dbRef == null) { try { ensureDb(); } catch (Throwable ignore) { } }
                            if (dbRef != null) break;
                            try { Thread.sleep(1000); } catch (Throwable ignore) { }
                        }
                        dumpConversationSchema();
                    }
                }).start();
            }
            final java.io.File hbf = new java.io.File(mmBase() + "/files/wxh_vhub");
            if (hbf.isFile()) {
                try { hbf.delete(); } catch (Throwable ignore) { }
                hubTest = true;
                log("HUBTEST|armed");
            }
            final java.io.File ghf = new java.io.File(mmBase() + "/files/wxh_vghub");
            if (ghf.isFile()) {
                try { ghf.delete(); } catch (Throwable ignore) { }
                new Thread(new Runnable() {
                    @Override public void run() {
                        for (int i = 0; i < 60; i++) {
                            if (dbRef == null) { try { ensureDb(); } catch (Throwable ignore) { } }
                            if (dbRef != null) break;
                            try { Thread.sleep(1000); } catch (Throwable ignore) { }
                        }
                        java.util.ArrayList<String[]> gs = new java.util.ArrayList<String[]>();
                        fillGroupsFromDb(gs);
                        StringBuilder sb = new StringBuilder();
                        for (int i = 0; i < Math.min(5, gs.size()); i++) sb.append(gs.get(i)[1]).append('/');
                        log("VGHUB|n=" + gs.size() + " top=" + sb);
                    }
                }).start();
            }
            final java.io.File ecf = new java.io.File(mmBase() + "/files/wxh_vec");
            if (ecf.isFile()) {
                try { ecf.delete(); } catch (Throwable ignore) { }
                exportCenterTest = true;
                log("EXPTEST|armed");
            }
            final java.io.File mtf = new java.io.File(mmBase() + "/files/wxh_vtrend");
            if (mtf.isFile()) {
                try { mtf.delete(); } catch (Throwable ignore) { }
                new Thread(new Runnable() {
                    @Override public void run() {
                        String[] path = new String[1];
                        buildMemberTrend(path);
                        log("VTREND|path=" + path[0]);
                    }
                }).start();
            }
            final java.io.File hmf = new java.io.File(mmBase() + "/files/wxh_vhmd");
            if (hmf.isFile()) {
                try { hmf.delete(); } catch (Throwable ignore) { }
