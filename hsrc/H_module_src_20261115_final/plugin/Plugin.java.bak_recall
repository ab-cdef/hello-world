    private static volatile String lastRedPacketContent = null;
    private static volatile boolean lastRedPacketIsSend = false;
    private static final java.util.HashMap<String, Long> noticeSeen = new java.util.HashMap<String, Long>();
    private static int timeLogCounter = 0;
    private static volatile boolean selfTestDone = false;
    private static volatile boolean avatarFromLongPress = false;
    private static java.util.ArrayList<String[]> pickCache = null;
    private static long pickCacheAt = 0;
    private static volatile long lastGrabArriveAt = 0;
    private static volatile long redPktHandledAt = 0;
    private static volatile String grabOpenErr = null;
    private static volatile String lastGrabTalker = null;

    private static void openChatOnly(final android.app.Activity host, final String talker) {
        try {
            android.app.Activity a = host != null ? host : (topAct != null ? topAct : lastAct);
            if (a == null) a = mainAct;
            if (a == null) a = topActivityNow();
            if (a == null) { log("NF|no activity"); return; }
            android.content.Intent it = new android.content.Intent();
            it.setClassName(a.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
            it.putExtra("Chat_User", resolveTalker(talker));
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
            android.content.Intent _csw = prepareChatSwitch(a, it);
            if (_csw != null) a.startActivity(_csw);
            log("NF|open " + talker);
        } catch (Throwable t) { log("NF|open err " + t); }
    }

    /** 用系统分享把文件交给微信，微信自己转发原件（图片/视频/文件都行） */
    private static void shareFileTo(final android.app.Activity host, final String target,
                                    final android.net.Uri uri, final String mime) {
        try {
            android.app.Activity a = host != null ? host : (topAct != null ? topAct : lastAct);
            if (a == null) a = mainAct;
            if (a == null) a = topActivityNow();
            if (a == null) { log("SHAREF|no activity"); return; }
            autoForwardAt = System.currentTimeMillis();
            autoForwardTalker = target;
            android.content.Intent it = new android.content.Intent(android.content.Intent.ACTION_SEND);
            it.setType(mime == null ? "image/png" : mime);
            it.putExtra(android.content.Intent.EXTRA_STREAM, uri);
            it.setPackage(wxPkg());
            it.addFlags(android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION);
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
            a.startActivity(it);
            log("SHAREF|start " + mime + " -> " + target + " uri=" + uri);
        } catch (Throwable t) { log("SHAREF|err " + t); }
    }

    /* ================= 群档案速览卡 ================= */

    /** 读群成员 wxid 列表 */
    private static java.util.ArrayList<String> groupMemberList(String chatroomId) {
        java.util.ArrayList<String> list = new java.util.ArrayList<String>();
        try {
            Object handle = msgDbHandle();
            if (handle == null) return list;
            Object cur = handle.getClass().getMethod("B", String.class, String[].class)
                    .invoke(handle, "select memberlist from chatroom where chatroomname=? limit 1",
                            new String[]{chatroomId});
            if (cur == null) return list;
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
            if ((Boolean) mv.invoke(cur)) {
                String ml = (String) gs.invoke(cur, 0);
                if (ml != null) {
                    for (String m : ml.split(";")) {
                        String u = m.trim();
                        if (u.length() > 0 && !u.endsWith("@chatroom")) list.add(u);
                    }
                }
            }
            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
        } catch (Throwable t) { log("GPROF|member err " + t); }
        return list;
    }

    /** 生成群画像文本 */
    private static String buildGroupProfile(String talker) {
        StringBuilder sb = new StringBuilder();
        try {
            String nm = displayOfTalker(talker);
            long now = System.currentTimeMillis();
            java.util.ArrayList<String> members = groupMemberList(talker);

            // 好友判定
            int friends = 0;
            for (String uid : members) {
                try {
                    java.util.List<Object[]> rc = queryRows(
                            "select ifnull(type,0) from rcontact where username='" + escSql(uid) + "' limit 1", 1);
                    if (!rc.isEmpty()) {
                        int tp = 0;
                        try { tp = Integer.parseInt(String.valueOf(rc.get(0)[0]).trim()); } catch (Throwable ignore) { }
                        if ((tp & 1) != 0) friends++;
                    }
                } catch (Throwable ignore) { }
            }

            // 消息统计：近 30 天明细 + 全量总数
            long since30 = sinceRaw(now - 30L * 86400000L);
            long since7 = sinceRaw(now - 7L * 86400000L);
            long c7 = 0, c30 = 0, cAll = 0, firstMs = 0;
            long[] hours = new long[24];
            java.util.LinkedHashMap<String, Integer> cnt = new java.util.LinkedHashMap<String, Integer>();
            int pageSize = 5000;
            for (int off = 0; ; off += pageSize) {
                java.util.List<Object[]> rows = queryRows(
                        "select ifnull(content,''), createTime from message where talker='" + escSql(talker)
                                + "' order by createTime limit " + pageSize + " offset " + off, 2);
                if (rows.isEmpty()) break;
                for (Object[] r : rows) {
                    long raw = 0;
                    try { raw = Long.parseLong(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                    long ms = ctToMs(raw);
                    cAll++;
                    if (firstMs == 0 || ms < firstMs) firstMs = ms;
                    if (raw >= since7) c7++;
                    if (raw >= since30) {
                        c30++;
                        java.util.Calendar cc = java.util.Calendar.getInstance();
                        cc.setTimeInMillis(ms);
                        hours[cc.get(java.util.Calendar.HOUR_OF_DAY)]++;
                        String sid = senderIdOfGroupMsg(String.valueOf(r[0]));
                        if (sid != null && sid.length() > 0) {
                            Integer v = cnt.get(sid);
                            cnt.put(sid, v == null ? 1 : v + 1);
                        }
                    }
                }
                if (rows.size() < pageSize) break;
            }

            // 活跃时段 top3
            StringBuilder hot = new StringBuilder();
            for (int k = 0; k < 3; k++) {
                int bi = -1; long bv = -1;
                for (int i = 0; i < 24; i++) if (hours[i] > bv) { bv = hours[i]; bi = i; }
                if (bi < 0 || bv <= 0) break;
                if (hot.length() > 0) hot.append(" / ");
                hot.append(bi).append("-").append(bi + 1).append("点(").append(bv).append(")");
                hours[bi] = -1;
            }

            // 核心成员 top5
            java.util.List<java.util.Map.Entry<String, Integer>> es =
                    new java.util.ArrayList<java.util.Map.Entry<String, Integer>>(cnt.entrySet());
            java.util.Collections.sort(es, new java.util.Comparator<java.util.Map.Entry<String, Integer>>() {
                @Override public int compare(java.util.Map.Entry<String, Integer> x,
                                             java.util.Map.Entry<String, Integer> y) {
                    return y.getValue() - x.getValue();
                }
            });

            java.text.SimpleDateFormat df = new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
            sb.append("群名：").append(nm).append("\n");
            sb.append("群ID：").append(talker).append("\n");
            sb.append("成员：").append(members.size()).append(" 人（其中好友 ").append(friends).append(" 人）\n");
            sb.append("首条消息：").append(firstMs > 0 ? df.format(new java.util.Date(firstMs)) : "—").append("\n");
            sb.append("\n【发言量】\n");
            sb.append("近 7 天：").append(c7).append(" 条\n");
            sb.append("近 30 天：").append(c30).append(" 条\n");
            sb.append("累计：").append(cAll).append(" 条\n");
            if (c30 > 0) {
                sb.append("日均：").append(String.format(java.util.Locale.US, "%.1f", c30 / 30.0)).append(" 条\n");
                sb.append("\n【活跃时段】\n").append(hot.length() == 0 ? "—" : hot.toString()).append("\n");
                sb.append("\n【核心成员 · 近30天】\n");
                for (int i = 0; i < es.size() && i < 5; i++) {
                    sb.append("  ").append(i + 1).append(". ").append(displayOfTalker(es.get(i).getKey()))
                            .append("  ").append(es.get(i).getValue()).append(" 条\n");
                }
                if (es.size() > 5) sb.append("  … 共 ").append(es.size()).append(" 人发言\n");
            } else {
                sb.append("\n近 30 天没有发言。\n");
            }

            // 最近公告
            try {
                java.util.List<org.json.JSONObject> hs = readNoticeHist(talker, 1);
                if (hs != null && !hs.isEmpty()) {
                    String txt = hs.get(0).optString("text", "");
                    String tm = hs.get(0).optString("time", "");
                    if (txt.length() > 120) txt = txt.substring(0, 120) + "…";
                    sb.append("\n【最近公告】").append(tm).append("\n").append(txt).append("\n");
                }
            } catch (Throwable ignore) { }

            String dbg = "";
            try {
                java.util.List<Object[]> cr = queryRows("select chatroomname from chatroom limit 3", 1);
                for (Object[] r0 : cr) dbg += String.valueOf(r0[0]) + ",";
            } catch (Throwable ignore) { }
            log("GPROF|" + talker + " members=" + members.size() + " c7=" + c7 + " c30=" + c30
                    + " cAll=" + cAll + " db=" + (dbRef != null) + " rooms=" + dbg);
        } catch (Throwable t) {
            sb.append("生成失败：").append(t);
            log("GPROF|err " + t);
        }
        return sb.toString();
    }

    private static void showGroupProfile(final android.app.Activity a, final String talker) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                for (int i = 0; i < 40 && dbRef == null; i++) {
                    try { ensureDb(); } catch (Throwable ignore) { }
                    if (dbRef != null) break;
                    try { Thread.sleep(500); } catch (Throwable ignore) { }
                }
                final String txt = buildGroupProfile(talker);
                new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                    @Override public void run() {
                        try {
                            final android.widget.TextView tv = new android.widget.TextView(a);
                            tv.setText(txt);
                            tv.setTextSize(13);
                            tv.setTypeface(android.graphics.Typeface.MONOSPACE);
                            tv.setTextColor(0xFF141418);
                            int pad = (int) (16 * a.getResources().getDisplayMetrics().density);
                            tv.setPadding(pad, pad, pad, pad);
                            android.widget.ScrollView sv = new android.widget.ScrollView(a);
                            sv.addView(tv);
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("群档案速览")
                                    .setView(sv)
                                    .setPositiveButton("复制", new android.content.DialogInterface.OnClickListener() {
                                        @Override public void onClick(android.content.DialogInterface d, int w) {
                                            try {
                                                android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                                        a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                                cm.setPrimaryClip(android.content.ClipData.newPlainText("群档案", txt));
                                                toast("已复制");
                                            } catch (Throwable ignore) { }
                                        }
                                    })
                                    .setNegativeButton("关闭", null)
                                    .show();
                        } catch (Throwable t) { log("GPROF|ui err " + t); }
                    }
                });
            }
        }).start();
    }

