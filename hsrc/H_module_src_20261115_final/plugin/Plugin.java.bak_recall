                        } catch (Throwable ignore) { }
                        if (uid == null || uid.length() == 0) {
                            // 兜底：从页面标题反查（intent 里没带 Contact_User 时）
                            try {
                                java.util.ArrayList<android.view.View> vs2 = new java.util.ArrayList<android.view.View>();
                                collectAllViews(a.getWindow().getDecorView(), vs2, 0);
                                android.widget.TextView tBest = null;
