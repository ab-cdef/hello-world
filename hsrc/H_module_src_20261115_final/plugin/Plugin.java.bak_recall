    /* ================= 群成员变动日志 ================= */
    private static void recordGroupChange(String kind, java.util.Map<?, ?> mm, String txt) {
        try {
            String room = "";
            try {
                for (Object v : ((java.util.Map<?, ?>) mm).values()) {
                    if (v instanceof String) {
                        String sv = (String) v;
                        if (sv.endsWith("@chatroom") && sv.length() > 8) { room = sv; break; }
                    }
                }
            } catch (Throwable ignore) { }
            org.json.JSONObject o = new org.json.JSONObject();
            o.put("ts", System.currentTimeMillis());
            o.put("kind", kind);
            o.put("talker", room);
            o.put("name", room.length() > 0 ? displayOfTalker(room) : "");
            String t = txt == null ? "" : txt.replace('\n', ' ');
            if (t.length() > 300) t = t.substring(0, 300);
            o.put("text", t);
            java.io.FileWriter fw = new java.io.FileWriter(
                    new java.io.File(DIR + "/group_changes.jsonl"), true);
            fw.write(o.toString() + "\n");
            fw.close();
            log("GCHG|" + kind + " " + room);
            // 实时提醒（默认关）：只对 入群/退群/移出 推通知，改名之类不打扰
            try {
                if (cfg().optBoolean("gcNotify", false) && !inQuietHours()) {
                    boolean important = kind.contains("入群") || kind.contains("退群")
                            || kind.contains("移出") || kind.contains("入");
                    if (important) {
                        String nm = room.length() > 0 ? displayOfTalker(room) : "";
                        String body = (t.length() > 40 ? t.substring(0, 40) + "…" : t);
                        notifyLocal(mainAct != null ? mainAct : chatAct,
                                nm.length() > 0 ? ("群变动：" + nm) : "群成员变动", body);
                        log("GCNOTIFY|" + kind + " " + nm);
                    }
                }
            } catch (Throwable ignore) { }
        } catch (Throwable t) { log("GCHG|err " + t); }
    }

    private static void showGroupChanges(final android.app.Activity a) {
        try {
            java.io.File f = new java.io.File(DIR + "/group_changes.jsonl");
            final java.util.ArrayList<org.json.JSONObject> all =
                    new java.util.ArrayList<org.json.JSONObject>();
            if (f.isFile()) {
                java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
                String ln;
                while ((ln = br.readLine()) != null) {
                    if (ln.trim().length() == 0) continue;
                    try { all.add(new org.json.JSONObject(ln)); } catch (Throwable ignore) { }
                }
                br.close();
            }

            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));

            final android.widget.TextView head = new android.widget.TextView(a);
            head.setTextSize(12);
            head.setTextColor(0xFF888888);
            box.addView(head);

            final android.widget.LinearLayout chips = new android.widget.LinearLayout(a);
            chips.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            box.addView(chips);

            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            final android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 420)));

            final String[] kinds = {"全部", "新人入群", "成员退群", "被移出群聊", "群名变更", "群公告"};
            final String[] cur = {"全部"};

            final Runnable rebuild = new Runnable() {
                @Override public void run() {
                    list.removeAllViews();
                    int shown = 0, totalHit = 0;
                    for (int i = all.size() - 1; i >= 0; i--) {
                        final org.json.JSONObject o = all.get(i);
                        String kind = o.optString("kind", "");
                        if (!"全部".equals(cur[0]) && !cur[0].equals(kind)) continue;
                        totalHit++;
                        if (shown >= 200) continue;
                        shown++;
                        String nm = o.optString("name", "");
                        if (nm.length() == 0) nm = o.optString("talker", "");
                        android.widget.TextView tv = new android.widget.TextView(a);
                        String when = "";
                        try { when = fmtTs(o.optLong("ts", 0)); } catch (Throwable ignore) { }
                        tv.setText(when + "  " + kind + (nm.length() > 0 ? "  · " + nm : "")
                                + "\n" + o.optString("text", ""));
                        tv.setTextSize(13);
                        tv.setTextColor(0xFF1A1A1E);
                        tv.setPadding(dp(a, 10), dp(a, 8), dp(a, 10), dp(a, 8));
                        android.graphics.drawable.GradientDrawable g =
                                new android.graphics.drawable.GradientDrawable();
                        g.setColor(0xF7FFFFFF);
                        g.setCornerRadius(dp(a, 10));
                        tv.setBackground(g);
                        android.widget.LinearLayout.LayoutParams lp =
                                new android.widget.LinearLayout.LayoutParams(-1, -2);
                        lp.bottomMargin = dp(a, 5);
                        tv.setLayoutParams(lp);
                        final String tk = o.optString("talker", "");
                        tv.setOnClickListener(new android.view.View.OnClickListener() {
                            @Override public void onClick(android.view.View v) {
                                if (tk.length() > 0) zOpenChat(a, tk);
                                else toast("这条没记录到会话");
                            }
                        });
                        tv.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                            @Override public boolean onLongClick(android.view.View v) {
                                try {
                                    android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                            a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                    cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh",
                                            o.optString("text", "")));
                                    toast("已复制");
                                } catch (Throwable ignore) { }
                                return true;
                            }
                        });
                        list.addView(tv);
                    }
                    head.setText("共 " + all.size() + " 条记录 · 当前筛选 " + totalHit + " 条");
                    if (totalHit == 0) {
                        android.widget.TextView empty = new android.widget.TextView(a);
                        empty.setText("还没有记录。\n需要开启「群成员变动提醒」，之后群里的进退群、改群名、发公告都会被记下来。");
                        empty.setTextSize(13);
                        empty.setTextColor(0xFF999999);
                        empty.setPadding(dp(a, 10), dp(a, 20), dp(a, 10), dp(a, 20));
                        list.addView(empty);
                    }
                }
            };

            for (final String k : kinds) {
                android.widget.TextView chip = new android.widget.TextView(a);
                chip.setText(k);
                chip.setTextSize(12);
                chip.setGravity(android.view.Gravity.CENTER);
                chip.setPadding(dp(a, 12), dp(a, 6), dp(a, 12), dp(a, 6));
                android.widget.LinearLayout.LayoutParams lp =
                        new android.widget.LinearLayout.LayoutParams(-2, -2);
                lp.rightMargin = dp(a, 6);
                lp.topMargin = dp(a, 6);
                chip.setLayoutParams(lp);
                chip.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        cur[0] = k;
                        paintChips((android.widget.LinearLayout) v.getParent(),
                                java.util.Arrays.asList(kinds).indexOf(k));
                        rebuild.run();
                    }
                });
                chips.addView(chip);
            }

            new android.app.AlertDialog.Builder(a)
                    .setTitle("群成员变动日志")
                    .setView(box)
                    .setNegativeButton("关闭", null)
                    .create().show();
            rebuild.run();
            paintChips(chips, 0);
        } catch (Throwable t) {
            log("GCHG|ui err " + t);
            toast("打开失败：" + t);
        }
    }

    /* ================= 会话数据统计（本地只读） ================= */
    private static void showChatStats(final android.app.Activity a) {
        toast("正在统计，消息多的话要几秒…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<Object[]> rows = new java.util.ArrayList<Object[]>();
                final long[] counts = new long[4];
                try {
                    java.util.List<Object[]> q = queryRows(
                            "select talker, count(*),"
                                    + " sum(case when (type & 65535)=3 then 1 else 0 end),"
                                    + " sum(case when (type & 65535)=34 then 1 else 0 end),"
                                    + " sum(case when (type & 65535)=49 then 1 else 0 end),"
                                    + " sum(length(ifnull(content,''))),"
                                    + " min(createTime), max(createTime)"
                                    + " from message group by talker", 8);
                    for (Object[] r : q) {
                        long n = parseLongOf(r[1]);
                        if (n <= 0) continue;
                        String tk = r[0] == null ? "" : String.valueOf(r[0]);
                        rows.add(new Object[]{tk, n, parseLongOf(r[2]), parseLongOf(r[3]),
                                parseLongOf(r[4]), parseLongOf(r[5]),
                                parseLongOf(r[6]), parseLongOf(r[7])});
                    }
                    java.util.Collections.sort(rows, new java.util.Comparator<Object[]>() {
                        @Override public int compare(Object[] x, Object[] y) {
                            long a1 = x[1] == null ? 0 : ((Number) x[1]).longValue();
                            long b1 = y[1] == null ? 0 : ((Number) y[1]).longValue();
                            return Long.compare(b1, a1);
                        }
                    });
                    long sent = 0, recv = 0;
                    try {
                        java.util.List<Object[]> is = queryRows(
                                "select isSend, count(*) from message group by isSend", 2);
                        for (Object[] r : is) {
                            long k = parseLongOf(r[0]);
                            long v = parseLongOf(r[1]);
                            if (k == 1) sent = v; else recv = v;
                        }
                    } catch (Throwable ignore) { }
                    counts[0] = sent;
                    counts[1] = recv;
                    counts[2] = countAllToday(1);
                    counts[3] = countAllToday(0);
                    log("CSTAT|rows=" + rows.size() + " sent=" + sent + " recv=" + recv);
                } catch (Throwable t) { log("CSTAT|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() { showChatStatsPanel(a, rows, counts); }
                });
            }
        }).start();
    }

    private static long parseLongOf(Object o) {
        try {
            if (o == null) return 0;
            if (o instanceof Number) return ((Number) o).longValue();
            return Long.parseLong(String.valueOf(o).trim());
        } catch (Throwable t) { return 0; }
    }

    private static String hrSize(long kb) {
        if (kb < 1024) return kb + " KB";
        if (kb < 1048576) return String.format(java.util.Locale.US, "%.1f MB", kb / 1024.0);
        return String.format(java.util.Locale.US, "%.2f GB", kb / 1048576.0);
    }

    private static String cstatGroupOf(String tk) {
        if (tk == null || tk.length() == 0) return "其他";
        if (tk.endsWith("@chatroom")) return "群聊";
        if (tk.startsWith("gh_")) return "公众号 / 服务号";
        if ("filehelper".equals(tk)) return "文件传输助手";
        if (tk.startsWith("wxid_")) return "私聊";
        if (tk.contains("@app")) return "企业微信 / 应用";
        if (tk.startsWith("weixin") || tk.contains("notification_messages")
                || tk.contains("fmessage") || tk.startsWith("brandsessionholder")
                || tk.startsWith("medianote") || tk.startsWith("floatbottle")
                || tk.startsWith("officialaccounts") || tk.startsWith("newsapp")) return "系统 / 其他";
        return "其他";
    }

    private static void showChatStatsPanel(final android.app.Activity a,
                                           final java.util.ArrayList<Object[]> rows,
                                           final long[] counts) {
        try {
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));

            long total = 0, totalChars = 0;
            for (Object[] r : rows) {
                total += parseLongOf(r[1]);
                totalChars += parseLongOf(r[5]);
            }
            android.widget.TextView head = new android.widget.TextView(a);
            head.setText("今日  发 " + (counts == null ? 0 : counts[2])
                    + " · 收 " + (counts == null ? 0 : counts[3])
                    + "\n全部  发 " + (counts == null ? 0 : counts[0])
                    + " · 收 " + (counts == null ? 0 : counts[1])
                    + " · 合计 " + ((counts == null ? 0 : counts[0]) + (counts == null ? 0 : counts[1]))
                    + "\n" + rows.size() + " 个会话 · " + total + " 条 · 文本 " + hrSize(totalChars / 1024)
                    + "\n点分组展开 / 收起");
            head.setTextSize(12);
            head.setTextColor(0xFF888888);
            box.addView(head);

            // 分组
            final java.util.LinkedHashMap<String, java.util.ArrayList<Object[]>> groups =
                    new java.util.LinkedHashMap<String, java.util.ArrayList<Object[]>>();
            String[] order = {"群聊", "私聊", "公众号 / 服务号", "企业微信 / 应用", "文件传输助手", "系统 / 其他", "其他"};
            for (String g : order) groups.put(g, new java.util.ArrayList<Object[]>());
            for (Object[] r : rows) {
                String g = cstatGroupOf(String.valueOf(r[0]));
                java.util.ArrayList<Object[]> lst = groups.get(g);
                if (lst == null) lst = groups.get("其他");
                lst.add(r);
            }

            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            final android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 430)));

            final android.app.Dialog[] dd = new android.app.Dialog[1];
            for (final String gname : order) {
                final java.util.ArrayList<Object[]> g = groups.get(gname);
                if (g == null || g.isEmpty()) continue;
                long gn = 0, gc = 0;
                for (Object[] r : g) { gn += parseLongOf(r[1]); gc += parseLongOf(r[5]); }

                android.widget.LinearLayout sec = new android.widget.LinearLayout(a);
                sec.setOrientation(android.widget.LinearLayout.VERTICAL);

                final android.widget.TextView header = new android.widget.TextView(a);
                header.setText("\u25b8 " + gname + " · " + g.size() + " 个会话 · " + gn
                        + " 条 · " + hrSize(gc / 1024));
                header.setTextSize(14);
                header.setTextColor(0xFF1A1A1E);
                header.setPadding(dp(a, 10), dp(a, 11), dp(a, 10), dp(a, 11));
                android.graphics.drawable.GradientDrawable hg =
                        new android.graphics.drawable.GradientDrawable();
                hg.setColor(0xFFEDEFF5);
                hg.setCornerRadius(dp(a, 10));
                header.setBackground(hg);
                android.widget.LinearLayout.LayoutParams hlp =
                        new android.widget.LinearLayout.LayoutParams(-1, -2);
                hlp.bottomMargin = dp(a, 4);
                hlp.topMargin = dp(a, 6);
                header.setLayoutParams(hlp);

                final android.widget.LinearLayout body = new android.widget.LinearLayout(a);
                body.setOrientation(android.widget.LinearLayout.VERTICAL);
                body.setVisibility(android.view.View.GONE);

                int shown = 0;
                for (final Object[] r : g) {
                    if (shown >= 80) break;
                    shown++;
                    long n = parseLongOf(r[1]);
                    long imgs = parseLongOf(r[2]);
                    long voices = parseLongOf(r[3]);
                    long files = parseLongOf(r[4]);
                    long chars = parseLongOf(r[5]);
                    long t0 = parseLongOf(r[6]);
                    long t1 = parseLongOf(r[7]);
                    String nm = displayOfTalker(String.valueOf(r[0]));
                    String span = "";
                    try {
                        if (t0 > 100000000000L) t0 /= 1000L;
                        if (t1 > 100000000000L) t1 /= 1000L;
                        span = new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US)
                                .format(new java.util.Date(t0 * 1000L))
                                + " ~ " + fmtTs(t1 * 1000L).substring(0, 10);
                    } catch (Throwable ignore) { }
                    android.widget.TextView tv = new android.widget.TextView(a);
                    tv.setText(nm + "   " + n + " 条\n"
                            + "图 " + imgs + " · 语音 " + voices + " · 文件 " + files
                            + " · 文本 " + hrSize(chars / 1024) + "\n" + span);
                    tv.setTextSize(13);
                    tv.setTextColor(0xFF1A1A1E);
                    tv.setPadding(dp(a, 10), dp(a, 8), dp(a, 10), dp(a, 8));
                    android.graphics.drawable.GradientDrawable gd =
                            new android.graphics.drawable.GradientDrawable();
                    gd.setColor(0xF7FFFFFF);
                    gd.setCornerRadius(dp(a, 10));
                    tv.setBackground(gd);
                    android.widget.LinearLayout.LayoutParams lp =
                            new android.widget.LinearLayout.LayoutParams(-1, -2);
                    lp.bottomMargin = dp(a, 5);
                    tv.setLayoutParams(lp);
                    final String ftk = String.valueOf(r[0]);
                    tv.setOnClickListener(new android.view.View.OnClickListener() {
                        @Override public void onClick(android.view.View v) {
                            if (dd[0] != null) { try { dd[0].dismiss(); } catch (Throwable ignore) { } }
                            zOpenChat(a, ftk);
                        }
                    });
                    tv.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                        @Override public boolean onLongClick(android.view.View v) {
                            try {
                                android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                        a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", ftk));
                                toast("已复制会话 id");
                            } catch (Throwable ignore) { }
                            return true;
                        }
                    });
                    body.addView(tv);
                }
                if (g.size() > shown) {
                    android.widget.TextView more = new android.widget.TextView(a);
                    more.setText("… 还有 " + (g.size() - shown) + " 个，用「导出 CSV」看全部");
                    more.setTextSize(11);
                    more.setTextColor(0xFF999999);
                    more.setPadding(dp(a, 10), dp(a, 2), dp(a, 10), dp(a, 6));
                    body.addView(more);
                }

                header.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        boolean open = body.getVisibility() == android.view.View.VISIBLE;
                        body.setVisibility(open ? android.view.View.GONE : android.view.View.VISIBLE);
                        String txt = String.valueOf(header.getText());
                        if (txt.startsWith("\u25b8")) header.setText("\u25be" + txt.substring(1));
                        else if (txt.startsWith("\u25be")) header.setText("\u25b8" + txt.substring(1));
                    }
                });

                sec.addView(header);
                sec.addView(body);
                list.addView(sec);
            }

            dd[0] = new android.app.AlertDialog.Builder(a)
                    .setTitle("会话数据统计")
                    .setView(box)
                    .setPositiveButton("导出 CSV", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            exportChatStatsCsv(rows);
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .create();
            dd[0].show();
        } catch (Throwable t) {
            log("CSTAT|ui err " + t);
            toast("打开失败：" + t);
        }
    }

    private static void exportChatStatsCsv(final java.util.ArrayList<Object[]> rows) {
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    StringBuilder sb = new StringBuilder();
                    sb.append("会话,会话id,消息数,图片,语音,文件,文本字节,首条,最后\n");
                    java.text.SimpleDateFormat f =
                            new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US);
                    for (Object[] r : rows) {
                        long t0 = parseLongOf(r[6]);
                        long t1 = parseLongOf(r[7]);
                        if (t0 > 100000000000L) t0 /= 1000L;
                        if (t1 > 100000000000L) t1 /= 1000L;
                        sb.append(csvCell(displayOfTalker(String.valueOf(r[0])))).append(',')
                          .append(csvCell(String.valueOf(r[0]))).append(',')
                          .append(parseLongOf(r[1])).append(',')
                          .append(parseLongOf(r[2])).append(',')
                          .append(parseLongOf(r[3])).append(',')
                          .append(parseLongOf(r[4])).append(',')
                          .append(parseLongOf(r[5])).append(',')
                          .append(t0 > 0 ? f.format(new java.util.Date(t0 * 1000L)) : "").append(',')
                          .append(t1 > 0 ? f.format(new java.util.Date(t1 * 1000L)) : "")
                          .append('\n');
                    }
                    android.content.Context ctx = ctxAny();
                    if (ctx == null) { toast("没有上下文"); return; }
                    String name = "wxh_chat_stats_" + System.currentTimeMillis() + ".csv";
                    android.content.ContentValues v = new android.content.ContentValues();
                    v.put(android.provider.MediaStore.MediaColumns.DISPLAY_NAME, name);
                    v.put(android.provider.MediaStore.MediaColumns.MIME_TYPE, "text/csv");
                    v.put(android.provider.MediaStore.MediaColumns.RELATIVE_PATH, "Download/wxh");
                    android.net.Uri uri = ctx.getContentResolver()
                            .insert(android.provider.MediaStore.Downloads.EXTERNAL_CONTENT_URI, v);
                    if (uri == null) { toast("写入失败"); return; }
                    java.io.OutputStream os = ctx.getContentResolver().openOutputStream(uri);
                    os.write(("\ufeff" + sb.toString()).getBytes("UTF-8"));
                    os.flush();
                    os.close();
                    toast("已导出：Download/wxh/" + name);
                    log("CSTAT|csv " + name + " rows=" + rows.size());
                } catch (Throwable t) {
                    log("CSTAT|csv err " + t);
                    toast("导出失败：" + t);
                }
            }
        }).start();
    }

    private static String csvCell(String s) {
        if (s == null) return "";
        String t = s.replace("\"", "\"\"");
        if (t.indexOf(',') >= 0 || t.indexOf('\n') >= 0 || t.indexOf('"') >= 0) {
            return "\"" + t + "\"";
        }
        return t;
    }

    /* ================= 聊天记录长图导出 ================= */
    private static void exportChatLongShot(final android.app.Activity a) {
        try {
            final android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (list == null) { toast("找不到消息列表"); return; }
            final int W = list.getWidth();
            final int H = list.getHeight();
            if (W <= 0 || H <= 0) { toast("列表还没布局好，稍后再试"); return; }
            toast("开始截取，请不要操作屏幕…");
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            final java.util.ArrayList<android.graphics.Bitmap> shots =
                    new java.util.ArrayList<android.graphics.Bitmap>();
            final java.util.ArrayList<Integer> deltas = new java.util.ArrayList<Integer>();
            final int MAX_PAGES = 10;
            final int[] prevOff = {-1};
            final int[] acc = {0};
            final Runnable[] self = new Runnable[1];
            self[0] = new Runnable() {
                @Override public void run() {
                    try {
                        if (shots.size() >= MAX_PAGES) {
                            composeLongShot(a, shots, deltas, W, H);
                            return;
                        }
                        int off = scrollOffOf(list);
                        if (off < 0) off = acc[0];
                        if (prevOff[0] >= 0 && off <= prevOff[0]) {
                            composeLongShot(a, shots, deltas, W, H);
                            return;
                        }
                        android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(
                                W, H, android.graphics.Bitmap.Config.RGB_565);
                        android.graphics.Canvas c = new android.graphics.Canvas(bm);
                        list.draw(c);
                        shots.add(bm);
                        deltas.add(prevOff[0] < 0 ? 0 : off - prevOff[0]);
                        prevOff[0] = off;
                        log("LONGSHOT|page " + shots.size() + " off=" + off);
                        int stp = Math.max(80, H - 60);
                        list.scrollBy(0, stp);
                        acc[0] += stp;
                        h.postDelayed(this, 300);
                    } catch (Throwable t) {
                        log("LONGSHOT|err " + t);
                        composeLongShot(a, shots, deltas, W, H);
                    }
                }
            };
            h.post(self[0]);
        } catch (Throwable t) {
            log("LONGSHOT|start err " + t);
            toast("导出失败：" + t);
        }
    }


    /** computeVerticalScrollOffset 是 protected，用反射读 */
    private static int scrollOffOf(android.view.View v) {
        try {
            java.lang.reflect.Method m = android.view.View.class
                    .getDeclaredMethod("computeVerticalScrollOffset");
            m.setAccessible(true);
            Object r = m.invoke(v);
            return r instanceof Integer ? (Integer) r : -1;
        } catch (Throwable t) {
            return -1;
        }
    }

    private static void composeLongShot(final android.app.Activity a,
                                        final java.util.ArrayList<android.graphics.Bitmap> shots,
                                        final java.util.ArrayList<Integer> deltas,
                                        int W, int H) {
        if (shots == null || shots.isEmpty()) { toast("没有截到内容"); return; }
        try {
            int total = H;
            for (int i = 1; i < shots.size(); i++) {
                int d = deltas.get(i) == null ? 0 : deltas.get(i);
                int add = d >= H ? H : H - Math.max(0, d);
                total += add;
                if (total > 16000) break;
            }
            if (total > 16000) total = 16000;
            android.graphics.Bitmap out = android.graphics.Bitmap.createBitmap(
                    W, total, android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas c = new android.graphics.Canvas(out);
            c.drawColor(0xFFFFFFFF);
            android.graphics.Paint p = new android.graphics.Paint();
            c.drawBitmap(shots.get(0), 0, 0, p);
            int y = H;
            for (int i = 1; i < shots.size() && y < total; i++) {
                int d = deltas.get(i) == null ? 0 : deltas.get(i);
                int srcTop = d >= H ? 0 : H - Math.max(0, d);
                int hh = H - srcTop;
                if (hh <= 0) continue;
                if (y + hh > total) hh = total - y;
                if (hh <= 0) break;
                android.graphics.Rect src = new android.graphics.Rect(0, srcTop, W, srcTop + hh);
                android.graphics.Rect dst = new android.graphics.Rect(0, y, W, y + hh);
                c.drawBitmap(shots.get(i), src, dst, p);
                y += hh;
            }
            for (android.graphics.Bitmap b : shots) {
                try { b.recycle(); } catch (Throwable ignore) { }
            }
            // 缩到 60%，避免超大图
            int ow = Math.max(1, W * 6 / 10);
            int oh = Math.max(1, total * 6 / 10);
            android.graphics.Bitmap small = android.graphics.Bitmap.createScaledBitmap(out, ow, oh, true);
            try { out.recycle(); } catch (Throwable ignore) { }
            final String path = saveLongShot(small);
            toast(path == null ? "保存失败" : ("长图已保存到相册：Pictures/wxh\n" + ow + "×" + oh));
            log("LONGSHOT|done " + ow + "x" + oh + " " + path);
        } catch (Throwable t) {
            log("LONGSHOT|compose err " + t);
            toast("合成失败：" + t);
        }
    }

    private static String saveLongShot(android.graphics.Bitmap bm) {
        try {
            android.content.Context ctx = ctxAny();
            if (ctx == null || bm == null) return null;
            String name = "wxh_chat_" + System.currentTimeMillis() + ".png";
            android.content.ContentValues v = new android.content.ContentValues();
            v.put(android.provider.MediaStore.Images.Media.DISPLAY_NAME, name);
            v.put(android.provider.MediaStore.Images.Media.MIME_TYPE, "image/png");
            v.put(android.provider.MediaStore.Images.Media.RELATIVE_PATH, "Pictures/wxh");
            android.net.Uri uri = ctx.getContentResolver()
                    .insert(android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI, v);
            if (uri == null) return null;
            java.io.OutputStream os = ctx.getContentResolver().openOutputStream(uri);
            bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, os);
            os.flush();
            os.close();
            return uri.toString();
        } catch (Throwable t) {
            log("LONGSHOT|save err " + t);
            return null;
        }
    }

    /* ================= 群 @我 汇总 ================= */
    private static String[] selfIdNick() {
        String id = cfg().optString("myWxid", "");
        String nick = cfg().optString("myNick", "");
        // 1) userinfo 表
        if (id.length() == 0 || nick.length() == 0) {
            try {
                java.util.List<Object[]> me = queryRows("select username, nickname from userinfo limit 1", 2);
                if (!me.isEmpty()) {
                    if (id.length() == 0 && me.get(0)[0] != null) id = String.valueOf(me.get(0)[0]).trim();
                    if (nick.length() == 0 && me.get(0)[1] != null) nick = String.valueOf(me.get(0)[1]).trim();
                }
            } catch (Throwable ignore) { }
        }
        // 2) 自己发的群消息 content = "发送者wxid:\n正文"，从中取自己的 wxid
        if (id.length() == 0) {
            try {
                java.util.List<Object[]> r = queryRows(
                        "select content from message where isSend=1 and talker like '%@chatroom'"
                                + " and content like 'wxid_%' order by createTime desc limit 8", 1);
                for (Object[] o : r) {
                    String c = o[0] == null ? "" : String.valueOf(o[0]);
                    int k = c.indexOf(':');
                    if (k <= 4) continue;
                    String cand = c.substring(0, k).trim();
                    if (cand.startsWith("wxid_")) { id = cand; break; }
                }
            } catch (Throwable ignore) { }
        }
        // 3) 通讯录里自己的备注/昵称
        if (nick.length() == 0 && id.length() > 0) {
            try {
                java.util.List<Object[]> r = queryRows(
                        "select ifnull(conRemark,''), ifnull(nickname,'') from rcontact where username='"
                                + id.replace("'", "''") + "' limit 1", 2);
                if (!r.isEmpty()) {
                    String rk = r.get(0)[0] == null ? "" : String.valueOf(r.get(0)[0]).trim();
                    String nk = r.get(0)[1] == null ? "" : String.valueOf(r.get(0)[1]).trim();
                    nick = rk.length() > 0 ? rk : nk;
                }
            } catch (Throwable ignore) { }
        }
        // 4) 缓存到配置，下次直接用
        try {
            if (id.length() > 0 || nick.length() > 0) {
                org.json.JSONObject o = readCfg();
                boolean ch = false;
                if (id.length() > 0 && !id.equals(o.optString("myWxid", ""))) { o.put("myWxid", id); ch = true; }
                if (nick.length() > 0 && !nick.equals(o.optString("myNick", ""))) { o.put("myNick", nick); ch = true; }
                if (ch) {
                    writeCfg(o);
                    cfg = null;
                    cfgAt = 0;
                    log("ATMEP|self cached id=" + id + " nick=" + nick);
                }
            }
        } catch (Throwable ignore) { }
        return new String[]{id, nick};
    }

    static volatile boolean pickTest = false;
    static volatile boolean menuTest = false;
    static volatile boolean pick2Test = false;
    static volatile boolean exportCenterTest = false;
    static volatile boolean hubTest = false;

    static volatile String atMeCsvPath = null;
    static volatile int atMeReplied = 0;
    static volatile int atMeCount = 0;

    private static void showAtMePanel(final android.app.Activity a) {
        collectAtMe(a);
    }

    /** a == null 时只统计并导出，不弹 UI（供无界面验证） */
    private static void collectAtMe(final android.app.Activity a) {
        if (a != null) toast("正在统计 @我 的消息…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<String[]> items = new java.util.ArrayList<String[]>();
                try {
                    String[] me = selfIdNick();
                    String myId = me[0];
                    String myNick = me[1];
                    long since = (System.currentTimeMillis() - 7L * 86400000L) / 1000L;
                    java.util.List<Object[]> rows = queryRows(
                            "select talker, content, createTime, ifnull(msgId,0), ifnull(msgSvrId,0) from message"
                                    + " where talker like '%@chatroom' and isSend=0"
                                    + " and createTime>=" + since
                                    + " order by createTime desc limit 3000", 5);
                    java.util.HashSet<String> seen = new java.util.HashSet<String>();
                    for (Object[] r : rows) {
                        try {
                            String tk = r[0] == null ? "" : String.valueOf(r[0]);
                            String c = r[1] == null ? "" : String.valueOf(r[1]);
                            long ct = 0;
                            try { ct = Long.parseLong(String.valueOf(r[2])); } catch (Throwable ignore) { }
                            if (tk.length() == 0 || c.length() == 0) continue;
                            boolean hit = false;
                            if (myId.length() > 0 && c.indexOf("<atuserlist>") >= 0 && c.indexOf(myId) >= 0) hit = true;
                            if (!hit && myNick.length() > 0 && c.indexOf("@" + myNick) >= 0) hit = true;
                            if (!hit) continue;
                            String body = bodyOf(1, c);
                            if (body == null) body = c;
                            body = body.replace('\n', ' ').trim();
                            if (body.length() > 200) body = body.substring(0, 200) + "…";
                            String sn = senderOfGroupMsg(c, tk);
                            String key = tk + "|" + ct + "|" + body.hashCode();
                            if (!seen.add(key)) continue;
                            long mid = 0, svr = 0;
                            try { mid = Long.parseLong(String.valueOf(r[3])); } catch (Throwable ignore) { }
                            try { svr = Long.parseLong(String.valueOf(r[4])); } catch (Throwable ignore) { }
                            long jid = mid > 0 ? mid : svr;
                            items.add(new String[]{String.valueOf(ct), tk,
                                    sn == null ? "" : sn, body, String.valueOf(jid)});
                            if (items.size() >= 200) break;
                        } catch (Throwable ignore) { }
                    }
                    // 「是否已回复」：之后 24 小时内我在同一个群发过消息
                    java.util.HashMap<String, long[]> sentMap =
                            new java.util.HashMap<String, long[]>();
                    try {
                        java.util.List<Object[]> sent = queryRows(
                                "select talker, createTime from message where isSend=1"
                                        + " and talker like '%@chatroom' and createTime>=" + since
                                        + " order by createTime", 2);
                        java.util.HashMap<String, java.util.ArrayList<Long>> tmp =
                                new java.util.HashMap<String, java.util.ArrayList<Long>>();
                        for (Object[] sr : sent) {
                            if (sr[0] == null || sr[1] == null) continue;
                            String tk2 = String.valueOf(sr[0]);
                            long v = 0;
                            try { v = ctToMs(Long.parseLong(String.valueOf(sr[1]))); } catch (Throwable ignore) { }
                            java.util.ArrayList<Long> l = tmp.get(tk2);
                            if (l == null) { l = new java.util.ArrayList<Long>(); tmp.put(tk2, l); }
                            l.add(v);
                        }
                        for (java.util.Map.Entry<String, java.util.ArrayList<Long>> e : tmp.entrySet()) {
                            long[] arr = new long[e.getValue().size()];
                            for (int i = 0; i < arr.length; i++) arr[i] = e.getValue().get(i);
                            java.util.Arrays.sort(arr);
                            sentMap.put(e.getKey(), arr);
                        }
                    } catch (Throwable t) { log("ATMEP|sent err " + t); }

                    int replied = 0;
                    java.util.ArrayList<String[]> withFlag = new java.util.ArrayList<String[]>();
                    for (String[] it : items) {
                        long ct = 0;
                        try { ct = Long.parseLong(it[0]); } catch (Throwable ignore) { }
                        long ctMs = ctToMs(ct);
                        boolean re = false;
                        long[] arr = sentMap.get(it[1]);
                        if (arr != null) {
                            int lo = 0, hi = arr.length - 1, pos = -1;
                            while (lo <= hi) {
                                int mid2 = (lo + hi) >>> 1;
                                if (arr[mid2] > ctMs) { pos = mid2; hi = mid2 - 1; } else lo = mid2 + 1;
                            }
                            if (pos >= 0 && arr[pos] - ctMs <= 86400000L) re = true;
                        }
                        if (re) replied++;
                        withFlag.add(new String[]{it[0], it[1], it[2], it[3], it[4], re ? "1" : "0"});
                    }
                    items.clear();
                    items.addAll(withFlag);
                    atMeReplied = replied;
                    atMeCount = items.size();

                    try {
                        java.io.File dir = new java.io.File(
                                android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
                        dir.mkdirs();
                        StringBuilder csv = new StringBuilder("\uFEFF");
                        csv.append("时间,群,发送人,内容,已回复\n");
                        java.text.SimpleDateFormat f2 =
                                new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss", java.util.Locale.US);
                        for (String[] it : items) {
                            long ct2 = 0;
                            try { ct2 = Long.parseLong(it[0]); } catch (Throwable ignore) { }
                            csv.append(f2.format(new java.util.Date(ctToMs(ct2)))).append(',')
                               .append(displayOfTalker(it[1]).replace(",", "，")).append(',')
                               .append((it[2] == null ? "" : it[2]).replace(",", "，")).append(',')
                               .append((it[3] == null ? "" : it[3]).replace(",", "，")).append(',')
                               .append("1".equals(it[5]) ? "已回复" : "未回复").append('\n');
                        }
                        java.io.File out = new java.io.File(dir, "atme_"
                                + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                                .format(new java.util.Date()) + ".csv");
                        java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
                        fo.write(csv.toString().getBytes("UTF-8"));
                        fo.close();
                        atMeCsvPath = out.getAbsolutePath();
                    } catch (Throwable t) { log("ATMEP|csv err " + t); }

                    log("ATMEP|found=" + items.size() + " replied=" + replied
                            + " csv=" + atMeCsvPath + " myId=" + myId + " myNick=" + myNick);
                } catch (Throwable t) { log("ATMEP|err " + t); }
                if (a != null) a.runOnUiThread(new Runnable() {
                    @Override public void run() { showAtMeList(a, items); }
                });
            }
        }).start();
    }


    /** 打开会话并定位到指定消息（Chat_Msg_Id = msgSvrId） */
    private static void openChatAt(final android.app.Activity a, String talker, long msgSvrId) {
        try {
            android.content.Intent it = new android.content.Intent();
            it.setClassName(a.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
            it.putExtra("Chat_User", resolveTalker(talker));
            if (msgSvrId > 0) it.putExtra("Chat_Msg_Id", msgSvrId);
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK
                    | android.content.Intent.FLAG_ACTIVITY_CLEAR_TOP
                    | android.content.Intent.FLAG_ACTIVITY_SINGLE_TOP);
            android.content.Intent _csw = prepareChatSwitch(a, it);
            if (_csw != null) a.startActivity(_csw);
            log("ATMEP|open " + talker + " id=" + msgSvrId);
            try { highlightMsgRow(a, msgSvrId); } catch (Throwable ignore) { }
        } catch (Throwable t) { toast("打开失败：" + t); }
    }

    private static void showAtMeList(final android.app.Activity a, final java.util.ArrayList<String[]> items) {
        try {
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));

            android.widget.TextView head = new android.widget.TextView(a);
            int un = items.size() - atMeReplied;
            head.setText("近 7 天群里 @你 的消息 " + items.size() + " 条（未回复 " + un + " 条）\n"
                    + (atMeCsvPath == null ? "点一条跳过去" : "已导出：" + atMeCsvPath));
            head.setTextSize(12);
            head.setTextColor(0xFF888888);
            box.addView(head);

            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            final android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 420)));

            final android.app.Dialog[] dd = new android.app.Dialog[1];
            for (final String[] it : items) {
                android.widget.TextView tv = new android.widget.TextView(a);
                String when = "";
                try { when = fmtTs(Long.parseLong(it[0])); } catch (Throwable ignore) { }
                String who = it[2] == null || it[2].length() == 0 ? displayOfTalker(it[1]) : it[2];
                tv.setText(when + "  " + displayOfTalker(it[1]) + (who.equals(displayOfTalker(it[1])) ? "" : (" · " + who)) + "\n" + it[3]);
                tv.setTextSize(13);
                tv.setTextColor(0xFF1A1A1E);
                tv.setPadding(dp(a, 10), dp(a, 8), dp(a, 10), dp(a, 8));
                android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
                g.setColor(0xF7FFFFFF);
                g.setCornerRadius(dp(a, 10));
                tv.setBackground(g);
                android.widget.LinearLayout.LayoutParams lp =
                        new android.widget.LinearLayout.LayoutParams(-1, -2);
                lp.bottomMargin = dp(a, 5);
                tv.setLayoutParams(lp);
                tv.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        if (dd[0] != null) { try { dd[0].dismiss(); } catch (Throwable ignore) { } }
                        long svr = 0;
                        try { svr = Long.parseLong(it[4]); } catch (Throwable ignore) { }
                        openAndCopy(a, it[1], it[3]);
                    }
                });
                tv.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                    @Override public boolean onLongClick(android.view.View v) {
                        try {
                            android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                    a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                            cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", it[3]));
                            toast("已复制内容");
                        } catch (Throwable ignore) { }
                        return true;
                    }
                });
                list.addView(tv);
            }
            if (items.isEmpty()) {
                android.widget.TextView empty = new android.widget.TextView(a);
                empty.setText("近 7 天没有 @你 的消息\n（只统计群聊文字消息，需要先在「我的」页打开一次资料面板以获取昵称）");
                empty.setTextSize(13);
                empty.setTextColor(0xFF999999);
                empty.setPadding(dp(a, 10), dp(a, 20), dp(a, 10), dp(a, 20));
                list.addView(empty);
            }
            dd[0] = new android.app.AlertDialog.Builder(a)
                    .setTitle("群 @我 汇总")
                    .setView(box)
                    .setNegativeButton("关闭", null)
                    .create();
            dd[0].show();
        } catch (Throwable t) {
            log("ATMEP|ui err " + t);
            toast("打开失败：" + t);
        }
    }

    /* ================= 群媒体批量导出（会话 / 类型 / 时间） ================= */
    private static String escSql(String s) {
        return s == null ? "" : s.replace("'", "''");
    }

    /* ---- 时间单位归一化：微信 createTime 在本机库里是「毫秒」 ---- */
    private static int ctUnitCache = 0;   // 1=秒 2=毫秒

    private static boolean ctIsMs() {
        if (ctUnitCache == 0) {
            long v = 0;
            try {
                java.util.List<Object[]> r = queryRows("select max(createTime) from message", 1);
                if (!r.isEmpty() && r.get(0)[0] != null) v = Long.parseLong(String.valueOf(r.get(0)[0]));
            } catch (Throwable ignore) { }
            ctUnitCache = v > 100000000000L ? 2 : 1;
            log("MEXP|ctUnit=" + (ctUnitCache == 2 ? "ms" : "sec") + " max=" + v);
        }
        return ctUnitCache == 2;
    }

    /** SQL 里比较用的 sinceRaw：和库里 createTime 同单位 */
    private static long sinceRaw(long sinceMs) {
        if (sinceMs <= 0) return 0;
        return ctIsMs() ? sinceMs : sinceMs / 1000L;
    }

    /** 原始 createTime -> 毫秒（逐行兜底，避免个别旧库是秒） */
    private static long ctToMs(long raw) {
        return raw > 100000000000L ? raw : raw * 1000L;
    }

    /** 原始 createTime -> 秒 */
    private static long ctToSec(long raw) {
        return raw > 100000000000L ? raw / 1000L : raw;
    }

    private static String safeName(String s) {
        if (s == null || s.trim().length() == 0) return "chat";
        String t = s.trim().replaceAll("[\\\\/:*?\"<>|\\r\\n]", "_");
        if (t.length() > 40) t = t.substring(0, 40);
        return t;
    }


    /** 关键词订阅：把当前会话加入/移出监控范围 */
    private static void toggleMonOnlyCur(final android.app.Activity a) {
        try {
            String tk = chatTalker != null && chatTalker.length() > 0 ? chatTalker : currentTalker();
            if (tk == null || tk.length() == 0) { toast("请先打开一个聊天"); return; }
            org.json.JSONObject o = readCfg();
            org.json.JSONArray arr = o.optJSONArray("monOnly");
            if (arr == null) arr = new org.json.JSONArray();
            boolean removed = false;
            for (int i = arr.length() - 1; i >= 0; i--) {
                if (tk.equals(arr.optString(i))) { arr.remove(i); removed = true; }
            }
            if (!removed) arr.put(tk);
            o.put("monOnly", arr);
            writeCfg(o);
            cfg = null;
            cfgAt = 0;
            toast((removed ? "已移出监控：" : "已加入监控：") + displayOfTalker(tk) + "（共 " + arr.length() + " 个）");
        } catch (Throwable t) { toast("设置失败"); }
    }

