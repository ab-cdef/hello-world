    private static void showMultiPicker(final android.app.Activity a, String title,
                                        final String cfgKey, final String enableKey,
                                        String tipText, String[] presets) {
        try {
            String cur = cfg().optString(cfgKey, "");
            final java.util.LinkedHashSet<String> sel = new java.util.LinkedHashSet<String>();
            for (String w : cur.split("[,，]")) {
                String t = w.trim();
                if (t.length() > 0) sel.add(t);
            }

            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));

            android.widget.TextView tip = new android.widget.TextView(a);
            tip.setText(tipText);
            tip.setTextSize(12);
            tip.setTextColor(0xFF888888);
            box.addView(tip);

            android.widget.TextView all = new android.widget.TextView(a);
            all.setText("全选 / 全不选");
            all.setTextSize(13);
            all.setTextColor(0xFF2E7D32);
            all.setPadding(dp(a, 2), dp(a, 8), dp(a, 2), dp(a, 8));
            box.addView(all);

            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 360)));

            final java.util.ArrayList<android.widget.CheckBox> boxes =
                    new java.util.ArrayList<android.widget.CheckBox>();
            final java.util.ArrayList<String> names = new java.util.ArrayList<String>();
            java.util.LinkedHashSet<String> pool = new java.util.LinkedHashSet<String>();
            for (String s : presets) pool.add(s);
            for (String s : sel) pool.add(s);   // 配置里已有但不在预设里的也列出来

            for (final String name : pool) {
                android.widget.CheckBox cb = new android.widget.CheckBox(a);
                cb.setText(name);
                cb.setTextSize(14);
                cb.setTextColor(0xFF1A1A1E);
                cb.setChecked(sel.contains(name));
                cb.setPadding(dp(a, 6), dp(a, 8), dp(a, 6), dp(a, 8));
                list.addView(cb);
                boxes.add(cb);
                names.add(name);
            }

            all.setOnClickListener(new android.view.View.OnClickListener() {
                boolean on = true;
                @Override public void onClick(android.view.View v) {
                    boolean target = true;
                    for (android.widget.CheckBox cb : boxes) { if (!cb.isChecked()) { target = true; break; } target = false; }
                    for (android.widget.CheckBox cb : boxes) cb.setChecked(target);
                }
            });

            new android.app.AlertDialog.Builder(a)
                    .setTitle(title)
                    .setView(box)
                    .setPositiveButton("确认", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            StringBuilder sb = new StringBuilder();
                            for (int i = 0; i < boxes.size(); i++) {
                                if (!boxes.get(i).isChecked()) continue;
                                if (sb.length() > 0) sb.append(',');
                                sb.append(names.get(i));
                            }
                            setStrCfg(cfgKey, sb.toString());
                            if (enableKey != null && sb.length() > 0) setOn(enableKey, true);
                            toast(sb.length() == 0 ? "已清空隐藏项（精简不生效）" : "已隐藏 " + sb.toString().replace(',', ' '));
                            if (settingsRefresher != null) settingsRefresher.run();
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) {
            log("MESIMPL|err " + t);
            toast("打开失败：" + t);
        }
    }


    /** 聊天页 resume 时执行一次 flag 测试（文件驱动） */


    /** 探针：把转账预检的相关类/构造函数/方法全部打印出来（定位当前微信版本的正确入口） */
    private static void dumpZombieSend(String target) {
        try {
            log("ZDUMP|start target=" + target);
            String[] cands = {
                    "com.tencent.mm.plugin.remittance.model.i",
                    "com.tencent.mm.plugin.remittance.model.j",
                    "com.tencent.mm.plugin.remittance.model.k",
                    "com.tencent.mm.plugin.remittance.model.a",
                    "com.tencent.mm.plugin.remittance.model.b"
            };
            for (String cn : cands) {
                Class<?> c;
                try { c = Class.forName(cn, false, appCl); } catch (Throwable t) { continue; }
                StringBuilder sb = new StringBuilder("ZDUMP|" + cn + " ctors=");
                try {
                    for (java.lang.reflect.Constructor<?> k : c.getConstructors())
                        sb.append(java.util.Arrays.toString(k.getParameterTypes())).append(' ');
                } catch (Throwable ignore) { }
                sb.append(" methods=");
                try {
                    for (java.lang.reflect.Method m : c.getMethods()) {
                        if (m.getDeclaringClass() == Object.class) continue;
                        sb.append(m.getName()).append(java.util.Arrays.toString(m.getParameterTypes()))
                                .append("->").append(m.getReturnType().getSimpleName()).append(' ');
                        if (sb.length() > 900) break;
                    }
                } catch (Throwable ignore) { }
                log(sb.toString());
            }
            try {
                Class<?> n1 = Class.forName("com.tencent.mm.modelbase.n1", false, appCl);
                StringBuilder sb = new StringBuilder("ZDUMP|n1 decl=");
                for (java.lang.reflect.Method m : n1.getDeclaredMethods()) {
                    sb.append(m.getName()).append(java.util.Arrays.toString(m.getParameterTypes()))
                            .append("->").append(m.getReturnType().getSimpleName()).append(' ');
                    if (sb.length() > 800) break;
                }
                log(sb.toString());
            } catch (Throwable t) { log("ZDUMP|n1 err " + t); }
            try {
                Object nw = zNetwork;
                if (nw == null) { log("ZDUMP|network null"); return; }
                Class<?> nc = nw.getClass();
                StringBuilder sb = new StringBuilder("ZDUMP|net=" + nc.getName() + " ");
                for (java.lang.reflect.Method m : nc.getMethods()) {
                    if (m.getDeclaringClass() == Object.class) continue;
                    sb.append(m.getName()).append(java.util.Arrays.toString(m.getParameterTypes())).append(' ');
                    if (sb.length() > 800) break;
                }
                log(sb.toString());
            } catch (Throwable t) { log("ZDUMP|net err " + t); }
        } catch (Throwable t) { log("ZDUMP|err " + t); }
    }

    /** 探针：把转账预检真正发一次 */
    private static void maybeZombieProbe() {
        try {
            java.io.File fd = new java.io.File("/sdcard/wxh_vdump");
            if (!fd.isFile()) fd = new java.io.File(mmBase() + "/files/wxh_vdump");
            if (fd.isFile()) {
                String tg = new String(readAllBytes(fd), "UTF-8").trim();
                try { fd.delete(); } catch (Throwable ignore) { }
                dumpZombieSend(tg);
            }
        } catch (Throwable ignore) { }
        try {
            java.io.File f = new java.io.File(mmBase() + "/files/wxh_vzp");
            if (!f.isFile()) f = new java.io.File("/storage/emulated/0/Android/data/com.tencent.mm/files/wxh_vzp");
            if (!f.isFile()) f = new java.io.File("/sdcard/wxh_vzp");
            if (!f.isFile()) return;
            final String tk = new String(readAllBytes(f), "UTF-8").trim();
            try { f.delete(); } catch (Throwable ignore) { }
            log("ZPROBE|trigger " + tk);
            new Thread(new Runnable() {
                @Override public void run() {
                    String r = zombieProbeWait(tk);
                    log("ZPROBE|result " + tk + " => " + r);
                }
            }).start();
        } catch (Throwable t) { log("ZPROBE|trigger err " + t); }
    }

    private static void maybeOpenBatch(android.app.Activity a) {
        try {
            java.io.File f = new java.io.File(mmBase() + "/files/wxh_vgb");
            if (!f.isFile()) return;
            try { f.delete(); } catch (Throwable ignore) { }
            showGroupBatch(a);
            log("VGB|opened");
        } catch (Throwable t) { log("VGB|err " + t); }
    }

    private static void maybeFlagTest() {
        try {
            java.io.File f = new java.io.File(mmBase() + "/files/wxh_vbit");
            if (!f.isFile()) return;
            String line = new String(readAllBytes(f), "UTF-8").trim();
            try { f.delete(); } catch (Throwable ignore) { }
            String[] pp = line.split("\\|");
            String tk = pp[0].trim();
            long mask = pp.length > 1 ? Long.parseLong(pp[1].trim(), 16) : 2L;
            boolean on = pp.length <= 2 || "1".equals(pp[2].trim());
            flagTest(tk, mask, on);
        } catch (Throwable t) { log("FTEST|hook err " + t); }
    }

    private static boolean convProbed = false;

    /** 进聊天后（库一定可用）探一次 rconversation 的列名 */
    private static void probeConvColumns() {
        if (convProbed) return;
        convProbed = true;
        try {
            Object h = msgDbHandle();
            if (h == null) { log("PROBE|handle null"); return; }
            Object cur = h.getClass().getMethod("B", String.class, String[].class)
                    .invoke(h, "select * from rconversation limit 1", new String[0]);
            if (cur == null) { log("PROBE|cur null"); return; }
            android.database.Cursor c = (android.database.Cursor) cur;
            StringBuilder sb = new StringBuilder();
            for (String cn2 : c.getColumnNames()) sb.append(cn2).append(',');
            try { c.close(); } catch (Throwable ignore) { }
            log("PROBE|rconversation cols=" + sb);
            try {
                Object cur2 = h.getClass().getMethod("B", String.class, String[].class)
                        .invoke(h, "select * from rcontact limit 1", new String[0]);
                if (cur2 != null) {
                    android.database.Cursor c2 = (android.database.Cursor) cur2;
                    StringBuilder sb2 = new StringBuilder();
                    for (String cn3 : c2.getColumnNames()) sb2.append(cn3).append(',');
                    try { c2.close(); } catch (Throwable ignore) { }
                    log("PROBE|rcontact cols=" + sb2);
                    try {
                        java.util.List<Object[]> tb = queryRows(
                                "select name from sqlite_master where type='table'", 1);
                        StringBuilder sb3 = new StringBuilder();
                        for (Object[] r3 : tb) {
                            String nm3 = String.valueOf(r3[0]);
                            if (nm3.toLowerCase().indexOf("label") >= 0) sb3.append(nm3).append(',');
                        }
                        log("PROBE|label tables=" + sb3);
                        try {
                            java.util.List<Object[]> tb2 = queryRows(
                                    "select name from sqlite_master where type='table' and (name like '%hatroom%' or name like '%ember%' or name like '%oom%')", 1);
                            StringBuilder sb4 = new StringBuilder();
                            for (Object[] r5 : tb2) sb4.append(String.valueOf(r5[0])).append(',');
                            log("PROBE|room tables=" + sb4);
                            java.util.List<Object[]> c1 = queryRows("select * from chatroom limit 1", 8);
                            for (Object[] r6 : c1) {
                                StringBuilder s6 = new StringBuilder();
                                for (Object o6 : r6) s6.append(String.valueOf(o6)).append('|');
                                log("PROBE|chatroomrow " + s6);
                            }
                        } catch (Throwable t6) { log("PROBE|room err " + t6); }
                        try {
                            java.util.List<Object[]> lb = queryRows("select * from ContactLabel limit 3", 6);
                            for (Object[] r4 : lb) {
                                StringBuilder s4 = new StringBuilder();
                                for (Object o4 : r4) s4.append(String.valueOf(o4)).append('|');
                                log("PROBE|labelrow " + s4);
                            }
                        } catch (Throwable t5) { log("PROBE|lrow err " + t5); }
                    } catch (Throwable t4) { log("PROBE|tb err " + t4); }
                }
            } catch (Throwable t3) { log("PROBE|rcontact err " + t3); }
            try {
                java.util.List<Object[]> fr = queryRows(
                        "select username, flag, unReadCount, status from rconversation"
                                + " where username like '%@chatroom' order by conversationTime desc limit 12", 4);
                for (Object[] r : fr) log("PROBE|f|" + r[0] + "|" + r[1] + "|u" + r[2] + "|s" + r[3]);
            } catch (Throwable t) { log("PROBE|f err " + t); }
        } catch (Throwable t) { log("PROBE|err " + t); }
    }

    /** 调试：改某个群的 flag 位并回读 */
    private static void flagTest(String talker, long mask, boolean on) {
        try {
            String t = talker.replace("'", "''");
            java.util.List<Object[]> b = queryRows("select flag from rconversation where username='" + t + "' limit 1", 1);
            String before = b.isEmpty() ? "none" : String.valueOf(b.get(0)[0]);
            String sql = "update rconversation set flag = " + (on ? "(flag | " + mask + ")" : "(flag & ~" + mask + ")")
                    + " where username='" + t + "'";
            boolean ok = execSqlRaw(sql);
            java.util.List<Object[]> af = queryRows("select flag from rconversation where username='" + t + "' limit 1", 1);
            String after = af.isEmpty() ? "none" : String.valueOf(af.get(0)[0]);
            log("FTEST|mask=" + mask + " on=" + on + " before=" + before + " after=" + after + " ok=" + ok);
            refreshConvList();
        } catch (Throwable t) { log("FTEST|err " + t); }
    }

    /* ================= 僵尸粉：静默转账检测（移植自 1.0.0 包） ================= */

    private static final java.util.HashMap<Object, String> probeMap =
            new java.util.HashMap<Object, String>();
    private static final java.util.HashMap<String, String> probeResult =
            new java.util.HashMap<String, String>();
    private static boolean probeHookInstalled = false;

    private static void installZombieProbe(ClassLoader app) {
        if (probeHookInstalled) return;
        probeHookInstalled = true;
        try {
            Class<?> c = Class.forName("com.tencent.mm.plugin.remittance.model.r0", false, app);
            XposedBridge.hookAllMethods(c, "onGYNetEnd", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        Object[] a = p.args;
                        if (a == null || a.length < 2) return;
                        String errCode = String.valueOf(a[0]);
                        String errMsg = String.valueOf(a[1]);
                        String wxid;
                        synchronized (probeMap) { wxid = probeMap.remove(p.thisObject); }
                        if (wxid == null) return;
                        boolean dead = !"0".equals(errCode)
                                && (errMsg.contains("不是收款方好友") || errMsg.contains("拒绝接收")
                                    || errMsg.contains("请确认") || errMsg.contains("关系")
                                    || errMsg.contains("不是你的好友") || errMsg.contains("添加"));
                        // 网络/超时这类跟好友关系无关的失败，一律记「未知」，不许当成正常或僵尸
                        boolean netty = errMsg.contains("网络") || errMsg.contains("超时")
                                || errMsg.contains("失败") || errMsg.contains("繁忙");
                        String r = dead ? "僵尸" : (netty ? "未知" : "正常");
                        probeResult.put(wxid, r);
                        log("ZPROBE|" + wxid + " code=" + errCode + " msg=" + errMsg + " => " + r);
                    } catch (Throwable t) { log("ZPROBE|hook err " + t); }
                }
            });
            log("ZPROBE|hooked r0.onGYNetEnd");
            zombieDeletePrecheck();
        } catch (Throwable t) { log("ZPROBE|install err " + t); }
    }

    /** 构造并发出一个 1 元转账场景，用于静默探测 */
    private static boolean zombieProbe(String wxid) {
        try {
            Class<?> c = Class.forName("com.tencent.mm.plugin.remittance.model.r0", false, appCl);
            java.lang.reflect.Constructor<?> ctor = null;
            for (java.lang.reflect.Constructor<?> k : c.getConstructors()) {
                Class<?>[] pts = k.getParameterTypes();
                if (pts.length >= 29 && pts[0] == double.class) { ctor = k; break; }
            }
            if (ctor == null) { log("ZPROBE|no ctor"); return false; }
            Class<?>[] pts = ctor.getParameterTypes();
            Object[] args = new Object[pts.length];
            for (int i = 0; i < pts.length; i++) {
                Class<?> t = pts[i];
                if (t == double.class) args[i] = Double.valueOf(0);
                else if (t == float.class) args[i] = Float.valueOf(0);
                else if (t == long.class) args[i] = Long.valueOf(0);
                else if (t == int.class) args[i] = Integer.valueOf(0);
                else if (t == short.class) args[i] = Short.valueOf((short) 0);
                else if (t == byte.class) args[i] = Byte.valueOf((byte) 0);
                else if (t == boolean.class) args[i] = Boolean.FALSE;
                else if (t == String.class) args[i] = "";
            }
            if (pts.length > 0 && pts[0] == double.class) args[0] = Double.valueOf(1.0d);
            if (pts.length > 1 && pts[1] == String.class) args[1] = "1";
            if (pts.length > 2 && pts[2] == String.class) args[2] = wxid;
            if (pts.length > 4 && pts[4] == int.class) args[4] = Integer.valueOf(31);
            if (pts.length > 5 && pts[5] == int.class) args[5] = Integer.valueOf(2);
            if (pts.length > 13 && pts[13] == int.class) args[13] = Integer.valueOf(11);
            if (pts.length > 23 && pts[23] == String.class) args[23] = String.valueOf(System.currentTimeMillis());
            if (pts.length > 24 && pts[24] == int.class) args[24] = Integer.valueOf(0);
            if (pts.length > 26 && pts[26] == int.class) args[26] = Integer.valueOf(0);
            Object scene = ctor.newInstance(args);
            synchronized (probeMap) { probeMap.put(scene, wxid); }
            Class<?> q = Class.forName("com.tencent.mm.modelbase.s1", false, appCl);
            java.lang.reflect.Field f = q.getField("y");
            Object queue = f.get(null);
            if (queue == null) { log("ZPROBE|no queue"); return false; }
            boolean sent = false;
            for (Method m : queue.getClass().getMethods()) {
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length == 2 && ps[1] == int.class && m.getReturnType() == boolean.class
                        && ps[0].isAssignableFrom(scene.getClass())) {
                    m.setAccessible(true);
                    Object r = m.invoke(queue, scene, Integer.valueOf(0));
                    sent = Boolean.TRUE.equals(r);
                    log("ZPROBE|send via " + m.getName() + " => " + sent);
                    break;
                }
            }
            return sent;
        } catch (Throwable t) { log("ZPROBE|probe err " + t); return false; }
    }

    /** 僵尸粉检测面板（静默转账版） */
    private static void showZombieSilent(final android.app.Activity a) {
        toast("正在读取好友…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<String[]> fs = new java.util.ArrayList<String[]>();
                try {
                    java.util.List<Object[]> q = queryRows(
                            "select username, ifnull(conRemark,''), ifnull(nickname,'') from rcontact"
                                    + " where (ifnull(type,0) & 1) != 0 and username not like '%@chatroom'"
                                    + " and username not like 'gh_%' order by conRemark,nickname limit 800", 3);
                    for (Object[] r : q) {
                        String u = r[0] == null ? "" : String.valueOf(r[0]);
                        if (u.length() == 0) continue;
                        String rm = r[1] == null ? "" : String.valueOf(r[1]).trim();
                        String nk = r[2] == null ? "" : String.valueOf(r[2]).trim();
                        fs.add(new String[]{u, rm.length() > 0 ? rm : nk});
                    }
                } catch (Throwable t) { log("ZUI|load err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() { buildZombieUi(a, fs); }
                });
            }
        }).start();
    }

    private static void buildZombieUi(final android.app.Activity a,
                                      final java.util.ArrayList<String[]> fs) {
        try {
            final java.util.HashSet<String> sel = new java.util.HashSet<String>();
            final java.util.ArrayList<String[]> shown = new java.util.ArrayList<String[]>(fs);
            final android.widget.BaseAdapter[] adRef = new android.widget.BaseAdapter[1];

            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 10), dp(a, 6), dp(a, 10), dp(a, 6));

            final android.widget.EditText search = new android.widget.EditText(a);
            search.setHint("搜索昵称 / 备注 / wxid");
            search.setTextSize(14);
            search.setSingleLine(true);
            box.addView(search, new android.widget.LinearLayout.LayoutParams(-1, -2));

            final android.widget.TextView info = new android.widget.TextView(a);
            info.setTextSize(12);
            info.setTextColor(0xFF6B6B76);
            info.setPadding(dp(a, 4), dp(a, 6), dp(a, 4), dp(a, 6));
            info.setText("共 " + fs.size() + " 位好友，已选 0");
            box.addView(info);

            android.widget.LinearLayout ops = new android.widget.LinearLayout(a);
            String[] names = {"全选", "反选", "清空结果",
                    cfg().optBoolean("zombieAutoDelete", false) ? "自动删除:开" : "自动删除:关",
                    "开始检测"};
            for (int i = 0; i < names.length; i++) {
                final String lb = names[i];
                android.widget.TextView tv = new android.widget.TextView(a);
                tv.setText(lb);
                tv.setTextSize(13);
                tv.setTextColor(i == 2 ? 0xFFC8102E : 0xFF1A6BC8);
                tv.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));
                tv.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        if ("全选".equals(lb)) {
                            for (String[] e : shown) sel.add(e[0]);
                            if (adRef[0] != null) adRef[0].notifyDataSetChanged();
                        } else if ("反选".equals(lb)) {
                            for (String[] e : shown) {
                                if (sel.contains(e[0])) sel.remove(e[0]); else sel.add(e[0]);
                            }
                            if (adRef[0] != null) adRef[0].notifyDataSetChanged();
                        } else if ("清空结果".equals(lb)) {
                            try { zombieLogFile().delete(); } catch (Throwable ignore) { }
                            probeResult.clear();
                            sel.clear();
                            if (adRef[0] != null) adRef[0].notifyDataSetChanged();
                            info.setText("已清空，可重新检测（共 " + shown.size() + " 位）");
                            toast("已清空历史结果");
                            return;
                        } else if (lb.startsWith("自动删除")) {
                            boolean cur = cfg().optBoolean("zombieAutoDelete", false);
                            if (!cur) {
                                new android.app.AlertDialog.Builder(a)
                                        .setTitle("⚠ 自动删除好友")
                                        .setMessage("检测判定为「僵尸」的好友将被**直接删除**，此操作不可撤销。\n\n"
                                                + "· 判定依赖回包文案，存在误判可能\n"
                                                + "· 建议先只检测、人工核对结果\n\n确定开启？")
                                        .setPositiveButton("确认开启", new android.content.DialogInterface.OnClickListener() {
                                            @Override public void onClick(android.content.DialogInterface d, int w) {
                                                setOn("zombieAutoDelete", true);
                                                toast("自动删除：开");
                                            }
                                        })
                                        .setNegativeButton("取消", null).show();
                            } else {
                                setOn("zombieAutoDelete", false);
                                toast("自动删除：关");
                            }
                            return;
                        } else {
                            if (sel.isEmpty()) { toast("先勾选好友"); return; }
                            startZombieScan(a, new java.util.ArrayList<String>(sel), info);
                            return;
                        }
                        info.setText("共 " + shown.size() + " 位，已选 " + sel.size());
                    }
                });
                ops.addView(tv);
            }
            box.addView(ops, new android.widget.LinearLayout.LayoutParams(-1, -2));

            final android.widget.ListView lv = new android.widget.ListView(a);
            lv.setDivider(null);
            box.addView(lv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 380)));

            final android.widget.BaseAdapter ad = new android.widget.BaseAdapter() {
                @Override public int getCount() { return shown.size(); }
                @Override public Object getItem(int i) { return shown.get(i); }
                @Override public long getItemId(int i) { return i; }
                @Override public android.view.View getView(int pos, android.view.View cv, android.view.ViewGroup parent) {
                    android.widget.LinearLayout row;
                    android.widget.TextView nameTv;
                    android.view.View dot;
                    if (cv instanceof android.widget.LinearLayout) {
                        row = (android.widget.LinearLayout) cv;
                        nameTv = (android.widget.TextView) row.getChildAt(0);
                        dot = row.getChildAt(1);
                    } else {
                        row = new android.widget.LinearLayout(a);
                        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                        row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                        row.setPadding(dp(a, 10), dp(a, 12), dp(a, 10), dp(a, 12));
                        nameTv = new android.widget.TextView(a);
                        nameTv.setTextSize(14);
                        nameTv.setTextColor(0xFF1A1A1E);
                        row.addView(nameTv, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
                        dot = new android.view.View(a);
                        row.addView(dot, new android.widget.LinearLayout.LayoutParams(dp(a, 16), dp(a, 16)));
                    }
                    String[] e = shown.get(pos);
                    String st = probeResult.get(e[0]);
                    nameTv.setText(e[1] + (st == null ? "" : "（" + st + "）"));
                    android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
                    g.setShape(android.graphics.drawable.GradientDrawable.OVAL);
                    g.setColor(sel.contains(e[0]) ? 0xFF07C160 : 0xFF2E9E5B);
                    dot.setBackground(g);
                    return row;
                }
            };
            lv.setAdapter(ad);
            adRef[0] = ad;
            lv.setItemsCanFocus(false);
            lv.setOnItemClickListener(new android.widget.AdapterView.OnItemClickListener() {
                @Override public void onItemClick(android.widget.AdapterView<?> pv, android.view.View v, int pos, long id) {
                    if (pos < 0 || pos >= shown.size()) return;
                    String u = shown.get(pos)[0];
                    if (sel.contains(u)) sel.remove(u); else sel.add(u);
                    ad.notifyDataSetChanged();
                    info.setText("共 " + shown.size() + " 位，已选 " + sel.size());
                }
            });

            final Runnable flt = new Runnable() {
                @Override public void run() {
                    String kw = search.getText().toString().trim().toLowerCase();
                    shown.clear();
                    if (kw.length() == 0) shown.addAll(fs);
                    else for (String[] e : fs) {
                        if ((e[1] + " " + e[0]).toLowerCase().contains(kw)) shown.add(e);
                    }
                    ad.notifyDataSetChanged();
                    info.setText("共 " + shown.size() + " 位，已选 " + sel.size());
                }
            };
            search.addTextChangedListener(new android.text.TextWatcher() {
                @Override public void beforeTextChanged(CharSequence s2, int st, int c, int af) { }
                @Override public void onTextChanged(CharSequence s2, int st, int b, int c) { }
                @Override public void afterTextChanged(android.text.Editable e) { flt.run(); }
            });

            new android.app.AlertDialog.Builder(a)
                    .setTitle("僵尸粉检测（静默）")
                    .setView(box)
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { log("ZUI|ui err " + t); }
    }

    private static void startZombieScan(final android.app.Activity a,
                                        final java.util.ArrayList<String> list,
                                        final android.widget.TextView info) {
        final int total = list.size();
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.HashSet<String> done = loadZombieDone();
                final int[] deadCount = new int[]{0};
                final int[] iRef = new int[]{0};
                for (String u : list) {
                    iRef[0]++;
                    final int idxNow = iRef[0];
                    final String nm = displayOfTalker(u);
                    if (done.contains(u)) { log("ZSCAN|skip done " + u); continue; }
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() { info.setText("检测中 " + idxNow + "/" + total); }
                    });
                    String r = zombieProbeWait(u);
                    appendZombieResult(u, nm, r);
                    log("ZSCAN|" + u + "|" + nm + "|" + r);
                    deadCount[0] += r.contains("僵尸") ? 1 : 0;
                    updateZombieNotif(idxNow, total, deadCount[0]);
                    if (r.contains("僵尸") && cfg().optBoolean("zombieAutoDelete", false)) {
                        boolean del = zombieDeleteFriend(u);
                        log("ZSCAN|delete " + u + " => " + del);
                    }
                    try { Thread.sleep(1200); } catch (Throwable ignore) { }
                }
                exportZombieCsv(a, total);
            }
        }).start();
    }

    private static java.io.File zombieLogFile() {
        return new java.io.File(DIR, "zombie_result.txt");
    }

    private static java.util.HashSet<String> loadZombieDone() {
        java.util.HashSet<String> done = new java.util.HashSet<String>();
        try {
            java.io.File f = zombieLogFile();
            if (!f.isFile()) return done;
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            String line;
            while ((line = br.readLine()) != null) {
                int p2 = line.indexOf('|');
                if (p2 > 0) done.add(line.substring(0, p2));
            }
            br.close();
        } catch (Throwable ignore) { }
        return done;
    }

    private static void appendZombieResult(String wxid, String name, String status) {
        try {
            java.io.FileWriter fw = new java.io.FileWriter(zombieLogFile(), true);
            fw.write(wxid + "|" + name + "|" + status + "\n");
            fw.close();
        } catch (Throwable ignore) { }
    }

    /** 删除好友（调用微信 DeleteContactService，清除聊天记录传 false） */
    private static boolean zombieDeleteFriend(String wxid) {
        try {
            Class<?> c = Class.forName("aw1.n", false, appCl);
            Object inst = c.getConstructor().newInstance();
            java.lang.reflect.Method m = c.getMethod("a", String.class, boolean.class);
            m.setAccessible(true);
            m.invoke(inst, wxid, Boolean.FALSE);
            log("ZDEL|ok " + wxid);
            return true;
        } catch (Throwable t) {
            log("ZDEL|err " + wxid + " " + t);
            return false;
        }
    }

    /** 预检：确认删除接口存在（不执行删除） */
    private static void zombieDeletePrecheck() {
        try {
            Class<?> c = Class.forName("aw1.n", false, appCl);
            java.lang.reflect.Method m = c.getMethod("a", String.class, boolean.class);
            log("ZDEL|precheck ok class=" + c.getName() + " method=" + m.getName());
        } catch (Throwable t) { log("ZDEL|precheck err " + t); }
    }

    private static void updateZombieNotif(int done, int total, int dead) {
        try {
            android.content.Context ctx = ctxAny();
            if (ctx == null) return;
            android.app.NotificationManager nm =
                    (android.app.NotificationManager) ctx.getSystemService(android.content.Context.NOTIFICATION_SERVICE);
            if (nm == null) return;
            if (android.os.Build.VERSION.SDK_INT >= 26) {
                android.app.NotificationChannel ch = new android.app.NotificationChannel(
                        "wxh_zombie", "僵尸粉检测", android.app.NotificationManager.IMPORTANCE_LOW);
                nm.createNotificationChannel(ch);
            }
            android.app.Notification.Builder b = android.os.Build.VERSION.SDK_INT >= 26
                    ? new android.app.Notification.Builder(ctx, "wxh_zombie")
                    : new android.app.Notification.Builder(ctx);
            b.setSmallIcon(ctx.getApplicationInfo().icon)
                    .setContentTitle("正在检测僵尸粉")
                    .setContentText("已检测 " + done + "/" + total + " · 僵尸 " + dead)
                    .setProgress(total <= 0 ? 1 : total, done, false)
                    .setOngoing(true);
            nm.notify(0x5A4D, b.build());
        } catch (Throwable ignore) { }
    }

    private static void cancelZombieNotif() {
        try {
            android.content.Context ctx = ctxAny();
            if (ctx == null) return;
            android.app.NotificationManager nm =
                    (android.app.NotificationManager) ctx.getSystemService(android.content.Context.NOTIFICATION_SERVICE);
            if (nm != null) nm.cancel(0x5A4D);
        } catch (Throwable ignore) { }
    }

    /** 汇总导出并弹预览 */
    private static void exportZombieCsv(final android.app.Activity a, final int total) {
        try {
            java.io.File src = zombieLogFile();
            java.io.File dir = new java.io.File(android.os.Environment
                    .getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            final java.io.File csv = new java.io.File(dir, "zombie_" + new java.text.SimpleDateFormat(
                    "yyyyMMdd_HHmm", java.util.Locale.US).format(new java.util.Date()) + ".csv");
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(src));
            java.io.FileWriter fw = new java.io.FileWriter(csv, false);
            fw.write("\uFEFF昵称,wxid,状态\n");
            String line; int dead = 0, normal = 0;
            while ((line = br.readLine()) != null) {
                String[] pp = line.split("\\|");
                if (pp.length < 3) continue;
                fw.write(csv(pp[1]) + "," + csv(pp[0]) + "," + csv(pp[2]) + "\n");
                if (pp[2].contains("僵尸")) dead++;
                else if (pp[2].contains("正常")) normal++;
            }
            br.close();
            fw.close();
            final int fd = dead, fn = normal;
            final StringBuilder zl = new StringBuilder();
            try {
                java.io.BufferedReader br2 = new java.io.BufferedReader(new java.io.FileReader(src));
                String ln;
                while ((ln = br2.readLine()) != null) {
                    String[] pp = ln.split("\\|");
                    if (pp.length >= 3 && pp[2].contains("僵尸")) {
                        zl.append("· ").append(pp[1]).append("\n  ").append(pp[0]).append("\n");
                    }
                }
                br2.close();
            } catch (Throwable ignore) { }
            a.runOnUiThread(new Runnable() {
                @Override public void run() {
                    cancelZombieNotif();
                    StringBuilder sb = new StringBuilder();
                    sb.append("正常：").append(fn).append(" 位\n僵尸：").append(fd).append(" 位\n\n");
                    if (fd > 0) sb.append("僵尸名单：\n").append(zl);
                    else sb.append("没有发现僵尸粉。");
                    new android.app.AlertDialog.Builder(a)
                            .setTitle("检测完成")
                            .setMessage(sb.toString())
                            .setPositiveButton("导出 CSV", new android.content.DialogInterface.OnClickListener() {
                                @Override public void onClick(android.content.DialogInterface d, int w) { askShare(csv); }
                            })
                            .setNeutralButton("复制", new android.content.DialogInterface.OnClickListener() {
                                @Override public void onClick(android.content.DialogInterface d, int w) {
                                    try {
                                        android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                                a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                        cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", sb.toString()));
                                        toast("已复制");
                                    } catch (Throwable ignore) { }
                                }
                            })
                            .setNegativeButton("关闭", null)
                            .show();
                }
            });
        } catch (Throwable t) { log("ZSCAN|export err " + t); }
    }

    /** 探测一个好友并返回状态（同步等待最多 8 秒） */
    private static String zombieProbeWait(String wxid) {
        try {
            probeResult.remove(wxid);
            if (!zombieProbe(wxid)) return "发送失败";
            for (int i = 0; i < 80; i++) {
                String r = probeResult.get(wxid);
                if (r != null) return r;
                try { Thread.sleep(100); } catch (Throwable ignore) { }
            }
            return "超时";
        } catch (Throwable t) { return "异常:" + t; }
    }

    /* ---- 批量操作工具 ---- */
    /** 在包装类里递归找真正带 execSQL 的对象 */
    private static Object findSqlDb(Object o, int depth) {
        try {
            if (o == null || depth > 3) return null;
            for (Method m : o.getClass().getMethods()) {
                if (m.getName().equals("execSQL")) return o;
            }
            Class<?> c = o.getClass();
            while (c != null && c != Object.class) {
                for (java.lang.reflect.Field f : c.getDeclaredFields()) {
                    try {
                        f.setAccessible(true);
                        Object v = f.get(o);
                        if (v == null || v == o) continue;
                        String tn = v.getClass().getName();
                        if (tn.startsWith("java.") || tn.startsWith("android.content")) continue;
                        Object r = findSqlDb(v, depth + 1);
                        if (r != null) return r;
                    } catch (Throwable ignore) { }
                }
                c = c.getSuperclass();
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 数会话条数（按条件）；返回 -1 表示读不到 */
    private static int convCount(String cond) {
        try {
            Object h = msgDbHandle();
            if (h == null) return -1;
            String v = queryContent(h, "select count(*) from rconversation where " + cond);
            if (v == null) return -1;
            return Integer.parseInt(v.trim());
        } catch (Throwable t) { return -1; }
    }

    /** 批量清会话：按 单聊 / 群聊 / 公众号 分类清，或全部清未读 */
    private static void showClearByType(final android.app.Activity a) {
        final String cSingle = "username not like '%@chatroom' and username not like 'gh_%' and username<>'filehelper'";
        final String cRoom = "username like '%@chatroom'";
        final String cGh = "username like 'gh_%'";
        int nS = convCount(cSingle), nR = convCount(cRoom), nG = convCount(cGh);
        String f = "（读取失败）";
        final String[] labs = {
                "单聊会话  " + (nS < 0 ? f : nS + " 个"),
                "群聊会话  " + (nR < 0 ? f : nR + " 个"),
                "公众号会话  " + (nG < 0 ? f : nG + " 个"),
                "全部清未读（不删会话）"
        };
        final String[] conds = {cSingle, cRoom, cGh, ""};
        new android.app.AlertDialog.Builder(a)
                .setTitle("批量清会话")
                .setItems(labs, new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        if (w == 3) {
                            boolean ok = execSqlRaw("update rconversation set unReadCount=0");
                            toast(ok ? "已清空全部未读" : "清空失败");
                            log("CLRTYPE|unread all ok=" + ok);
                            if (ok) refreshConvList();
                            return;
                        }
                        if (w < 0 || w > 2) return;
                        final String cond = conds[w];
                        final String lab = labs[w];
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("清空会话")
                                .setMessage(lab + "\n会话将从列表移除，聊天记录保留。\n\n不可撤销，确定？")
                                .setPositiveButton("确定清空", new android.content.DialogInterface.OnClickListener() {
                                    @Override public void onClick(android.content.DialogInterface d2, int w2) {
                                        boolean ok = execSqlRaw("delete from rconversation where " + cond);
                                        toast(ok ? "已清空" : "清空失败");
                                        log("CLRTYPE|clear " + cond + " ok=" + ok);
                                        if (ok) refreshConvList();
                                    }
                                })
                                .setNegativeButton("取消", null).show();
                    }
                })
                .setNegativeButton("关闭", null).show();
        log("CLRTYPE|open single=" + nS + " room=" + nR + " gh=" + nG);
    }

    private static boolean execSqlRaw(String sql) {
        try {
            if (dbRef == null) { try { ensureDb(); } catch (Throwable ignore) { } }
            Object h0 = dbRef != null ? dbRef : msgDbHandle();
            log("SQL|dbRef=" + (dbRef == null ? "null" : dbRef.getClass().getName())
                    + " handle=" + (h0 == null ? "null" : h0.getClass().getName()));
            Object real = findSqlDb(h0, 0);
            Object[] targets = new Object[]{real, dbRef, msgDbHandle()};
            for (Object h : targets) {
                if (h == null) continue;
                for (Method m : h.getClass().getMethods()) {
                    if (!m.getName().equals("execSQL")) continue;
                    Class<?>[] ps = m.getParameterTypes();
                    try {
                        if (ps.length == 1 && ps[0] == String.class) {
                            m.setAccessible(true);
                            m.invoke(h, sql);
                            log("SQL|ok1 " + h.getClass().getSimpleName());
                            return true;
                        }
                        if (ps.length == 2 && ps[0] == String.class) {
                            Object arg = (ps[1] == Object[].class) ? new Object[0]
                                    : (ps[1] == String[].class ? new String[0] : null);
                            if (arg == null) continue;
                            m.setAccessible(true);
                            m.invoke(h, sql, arg);
                            log("SQL|ok2 " + h.getClass().getSimpleName());
                            return true;
                        }
                    } catch (Throwable t2) { log("SQL|try err " + t2); }
                }
            }
            StringBuilder ms = new StringBuilder();
            for (Object h2 : targets) {
                if (h2 == null) continue;
                ms.append(h2.getClass().getName()).append(": ");
                for (Method m : h2.getClass().getMethods()) {
                    String n = m.getName().toLowerCase();
                    if (n.contains("exec") || n.contains("update") || n.contains("insert")
                            || n.contains("delete") || n.contains("replace") || n.contains("raw")) {
                        ms.append(m.getName()).append("(");
                        for (Class<?> pp : m.getParameterTypes()) ms.append(pp.getSimpleName()).append(",");
                        ms.append(") ");
                    }
                }
                ms.append(" || ");
            }
            log("SQL|methods " + ms);
        } catch (Throwable t) { log("SQL|err " + t); }
        return false;
    }

    /** 改完库立刻刷新会话列表 */
    private static void refreshConvList() {
        try {
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        android.app.Activity top = topActivityNow();
                        if (top != null && top.getClass().getName().contains("LauncherUI")) {
                            top.recreate();
                            log("BATCH|refresh recreate");
                        } else {
                            android.content.Context ctx = ctxAny();
                            if (ctx != null) {
                                android.content.Intent it = new android.content.Intent();
                                it.setClassName(ctx.getPackageName(), "com.tencent.mm.ui.LauncherUI");
                                it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK
                                        | android.content.Intent.FLAG_ACTIVITY_SINGLE_TOP
                                        | android.content.Intent.FLAG_ACTIVITY_CLEAR_TOP);
                                ctx.startActivity(it);
                                log("BATCH|refresh start");
                            }
                        }
                    } catch (Throwable t) { log("BATCH|refresh err " + t); }
                }
            }, 300L);
        } catch (Throwable ignore) { }
    }

    private static String inList(java.util.List<String> tks) {
        StringBuilder sb = new StringBuilder();
        for (String t : tks) {
            if (t == null || t.length() == 0) continue;
            if (sb.length() > 0) sb.append(',');
            sb.append('\'').append(t.replace("'", "''")).append('\'');
        }
        return sb.toString();
    }

    /** 批量标记已读 */
    private static int batchMarkRead(java.util.List<String> tks) {
        try {
            if (tks.isEmpty()) return 0;
            boolean ok = execSqlRaw("update rconversation set unReadCount=0 where username in ("
                    + inList(tks) + ")");
            log("BATCH|read n=" + tks.size() + " ok=" + ok);
            return ok ? tks.size() : 0;
        } catch (Throwable t) { return 0; }
    }

    /** 是否已经免打扰（位未确定前一律当作未设置） */
    private static boolean isMutedAlready(java.util.List<String> tks) {
        return false;
    }

    /** 自测：读列名、读/写 flag，验证写库链路 */
    private static void vmSelfTest() {
        try {
            for (int i = 0; i < 120 && dbRef == null; i++) {
                try { ensureDb(); } catch (Throwable ignore) { }
                try { Thread.sleep(1000); } catch (Throwable ignore) { }
            }
            log("VMT|dbRef=" + (dbRef == null ? "null" : dbRef.getClass().getName()));
            String[] cands = {"flag", "attr", "mute", "isMute", "status", "conversationTime", "unReadCount"};
            for (String c : cands) {
                try {
                    java.util.List<Object[]> rr = queryRows("select " + c + " from rconversation limit 1", 1);
                    log("VMT|col " + c + " rows=" + rr.size());
                } catch (Throwable t) { log("VMT|col " + c + " err"); }
            }
            try {
                java.util.List<Object[]> rr = queryRows(
                        "select flag from rconversation where username='87654321@chatroom' limit 1", 1);
                log("VMT|before=" + (rr.isEmpty() ? "none" : rr.get(0)[0]));
            } catch (Throwable t) { log("VMT|read err " + t); }
            boolean ok = execSqlRaw("update rconversation set flag = flag | 2 where username='87654321@chatroom'");
            log("VMT|write ok=" + ok);
            try {
                java.util.List<Object[]> rr = queryRows(
                        "select flag from rconversation where username='87654321@chatroom' limit 1", 1);
                log("VMT|after=" + (rr.isEmpty() ? "none" : rr.get(0)[0]));
            } catch (Throwable t) { log("VMT|read2 err " + t); }
            new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                @Override public void run() { refreshConvList(); }
            });
            log("VMT|done");
        } catch (Throwable t) { log("VMT|err " + t); }
    }

    /** 批量设置某个 flag 位 */
    private static int batchFlag(java.util.List<String> tks, int mask, boolean on) {
        try {
            if (tks.isEmpty()) return 0;
            String op = on ? ("(flag | " + mask + ")") : ("(flag & ~" + mask + ")");
            boolean ok = execSqlRaw("update rconversation set flag = " + op
                    + " where username in (" + inList(tks) + ")");
            log("BATCH|flag mask=" + mask + " on=" + on + " n=" + tks.size() + " ok=" + ok);
            return ok ? tks.size() : 0;
        } catch (Throwable t) { return 0; }
    }

    /** 批量静音开关（flag 位，实验） */
    private static int batchMute(java.util.List<String> tks, boolean mute) {
        try {
            if (tks.isEmpty()) return 0;
            String sql = "update rconversation set flag = " + (mute
                    ? "(flag | 4611686018427387904)" : "(flag & ~4611686018427387904)")
                    + " where username in (" + inList(tks) + ")";
            boolean ok = execSqlRaw(sql);
            log("BATCH|mute=" + mute + " n=" + tks.size() + " ok=" + ok);
            return ok ? tks.size() : 0;
        } catch (Throwable t) { return 0; }
    }

    /** 批量删除会话（不删聊天记录） */
    private static int batchDeleteConv(java.util.List<String> tks) {
        try {
            if (tks.isEmpty()) return 0;
            boolean ok = execSqlRaw("delete from rconversation where username in (" + inList(tks) + ")");
            log("BATCH|del n=" + tks.size() + " ok=" + ok);
            return ok ? tks.size() : 0;
        } catch (Throwable t) { return 0; }
    }

    /** 诊断：打印选中群的状态位 */
    private static void dumpConvFlags(java.util.List<String> tks) {
        try {
            if (tks.isEmpty()) { log("BATCH|dump none"); return; }
            java.util.List<Object[]> rows = queryRows(
                    "select username, ifnull(flag,0), ifnull(attr,0), ifnull(unReadCount,0) from rconversation"
                            + " where username in (" + inList(tks) + ")", 4);
            for (Object[] r : rows) {
                log("BATCH|flag " + r[0] + " flag=" + r[1] + " attr=" + r[2] + " unread=" + r[3]);
            }
        } catch (Throwable t) { log("BATCH|dump err " + t); }
    }

    /* ================= 群批量管理（多选） ================= */
    private static final long MUTE_MASK = 4611686018427387904L;   // flag bit62 = 免打扰

    private static void showGroupBatch(final android.app.Activity a) {
        toast("正在读取群列表…");
        loadGroupBatch(a, 0);
    }

    /** 主线程加载（子线程里 dbRef 常为 null），失败自动重试 */
    private static void loadGroupBatch(final android.app.Activity a, final int attempt) {
        final java.util.ArrayList<Object[]> rows = new java.util.ArrayList<Object[]>();
        try {
            try { ensureDb(); } catch (Throwable ignore) { }
            java.util.List<Object[]> q = queryRows(
                    "select username, ifnull(flag,0), ifnull(attrflag,0), ifnull(unReadCount,0)"
                            + " from rconversation where username like '%@chatroom'"
                            + " order by conversationTime desc limit 300", 4);
            for (Object[] r : q) {
                if (r[0] == null) continue;
                String tk = String.valueOf(r[0]);
                if (!tk.endsWith("@chatroom")) continue;
                rows.add(new Object[]{tk, r[1], r[2], r[3]});
            }
            log("BATCH|load attempt=" + attempt + " groups=" + rows.size()
                    + " dbRef=" + (dbRef == null ? "null" : "ok"));
        } catch (Throwable t) { log("BATCH|load err " + t); }
        if (rows.isEmpty() && attempt < 4) {
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() { loadGroupBatch(a, attempt + 1); }
            }, 500L);
            return;
        }
        if (rows.isEmpty()) {
            toast("读不到群列表，先随便打开一个聊天再试");
            return;
        }
        int dbg = 0;
        for (Object[] r : rows) {
            String tk = String.valueOf(r[0]);
            boolean key = "12345678@chatroom".equals(tk) || "87654321@chatroom".equals(tk);
            if (dbg++ >= 5 && !key) continue;
            log("BATCH|attr " + tk + " flag=" + r[1] + " attr=" + r[2]);
        }
        buildGroupBatchUi(a, rows);
    }

    private static void buildGroupBatchUi(final android.app.Activity a,
                                          final java.util.ArrayList<Object[]> rows) {
        try {
            final java.util.HashSet<String> sel = new java.util.HashSet<String>();
            final java.util.ArrayList<Object[]> shown = new ArrayListCompat(rows);

            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 10), dp(a, 6), dp(a, 10), dp(a, 6));

            final android.widget.EditText search = new android.widget.EditText(a);
            search.setHint("搜索群名 / 群 ID");
            search.setTextSize(14);
            search.setSingleLine(true);
            box.addView(search, new android.widget.LinearLayout.LayoutParams(-1, -2));

            final android.widget.TextView info = new android.widget.TextView(a);
            info.setTextSize(12);
            info.setTextColor(0xFF6B6B76);
            info.setPadding(dp(a, 4), dp(a, 6), dp(a, 4), dp(a, 6));
            box.addView(info);

            android.widget.LinearLayout ops1 = new android.widget.LinearLayout(a);
            android.widget.LinearLayout ops2 = new android.widget.LinearLayout(a);
            String[] names1 = {"全选", "反选", "已读", "免打扰", "取消免打扰"};
            String[] names2 = {"置顶", "取消置顶", "存通讯录", "删会话"};
            for (int i = 0; i < names1.length; i++) ops1.addView(mkOp(a, names1[i], false));
            for (int i = 0; i < names2.length; i++) ops2.addView(mkOp(a, names2[i], "删会话".equals(names2[i])));
            box.addView(ops1, new android.widget.LinearLayout.LayoutParams(-1, -2));
            box.addView(ops2, new android.widget.LinearLayout.LayoutParams(-1, -2));

            final android.widget.ListView lv = new android.widget.ListView(a);
            lv.setDivider(null);
            box.addView(lv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 400)));

            final android.widget.BaseAdapter adapter = new android.widget.BaseAdapter() {
                @Override public int getCount() { return shown.size(); }
                @Override public Object getItem(int i) { return shown.get(i); }
                @Override public long getItemId(int i) { return i; }
                @Override public android.view.View getView(int pos, android.view.View convert, android.view.ViewGroup parent) {
                    android.widget.LinearLayout row;
                    android.widget.TextView nameTv;
                    android.view.View dot;
                    if (convert instanceof android.widget.LinearLayout) {
                        row = (android.widget.LinearLayout) convert;
                        nameTv = (android.widget.TextView) row.getChildAt(0);
                        dot = row.getChildAt(1);
                    } else {
                        row = new android.widget.LinearLayout(a);
                        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                        row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                        row.setPadding(dp(a, 10), dp(a, 12), dp(a, 10), dp(a, 12));
                        nameTv = new android.widget.TextView(a);
                        nameTv.setTextSize(14);
                        nameTv.setTextColor(0xFF1A1A1E);
                        row.addView(nameTv, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
                        dot = new android.view.View(a);
                        row.addView(dot, new android.widget.LinearLayout.LayoutParams(dp(a, 16), dp(a, 16)));
                    }
                    if (pos < 0 || pos >= shown.size()) return row;
                    final Object[] r = shown.get(pos);
                    final String tk = String.valueOf(r[0]);
                    long flag = 0;
                    try { flag = Long.parseLong(String.valueOf(r[1])); } catch (Throwable ignore) { }
                    long unread = 0;
                    try { unread = Long.parseLong(String.valueOf(r[3])); } catch (Throwable ignore) { }
                    StringBuilder sb = new StringBuilder(displayOfTalker(tk));
                    if ((flag & MUTE_MASK) != 0) sb.append("  🔕");
                    if (unread > 0) sb.append("  (").append(unread).append(")");
                    nameTv.setText(sb.toString());
                    android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
                    g.setShape(android.graphics.drawable.GradientDrawable.OVAL);
                    g.setColor(sel.contains(tk) ? 0xFF07C160 : 0xFF2E9E5B);
                    dot.setBackground(g);
                    return row;
                }
            };
            lv.setAdapter(adapter);
            lv.setOnItemClickListener(new android.widget.AdapterView.OnItemClickListener() {
                @Override public void onItemClick(android.widget.AdapterView<?> pv, android.view.View v, int pos, long id) {
                    if (pos < 0 || pos >= shown.size()) return;
                    String tk2 = String.valueOf(shown.get(pos)[0]);
                    if (sel.contains(tk2)) sel.remove(tk2); else sel.add(tk2);
                    adapter.notifyDataSetChanged();
                    info.setText("已选 " + sel.size() + " / 共 " + shown.size());
                }
            });

            final Runnable refresh = new Runnable() {
                @Override public void run() {
                    try {
                        String kw = search.getText().toString().trim().toLowerCase();
                        shown.clear();
                        if (kw.length() == 0) shown.addAll(rows);
                        else {
                            for (Object[] r : rows) {
                                String tk = String.valueOf(r[0]);
                                String hay = (displayOfTalker(tk) + " " + tk).toLowerCase();
                                if (hay.contains(kw)) shown.add(r);
                            }
                        }
                        adapter.notifyDataSetChanged();
                        info.setText("已选 " + sel.size() + " / 共 " + shown.size());
                    } catch (Throwable t) { log("BATCH|refresh " + t); }
                }
            };
            refresh.run();
            final android.os.Handler sh = new android.os.Handler(android.os.Looper.getMainLooper());
            search.addTextChangedListener(new android.text.TextWatcher() {
                @Override public void beforeTextChanged(CharSequence s2, int st, int c, int af) { }
                @Override public void onTextChanged(CharSequence s2, int st, int b, int c) { }
                @Override public void afterTextChanged(android.text.Editable e) {
                    sh.removeCallbacks(refresh);
                    sh.postDelayed(refresh, 200L);
                }
            });

            final android.app.AlertDialog[] dlg = new android.app.AlertDialog[1];
            android.view.View.OnClickListener oc = new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    String label = String.valueOf(((android.widget.TextView) v).getText())
                            .replace("🔕", "").trim();
                    if ("全选".equals(label)) {
                        for (Object[] r : shown) sel.add(String.valueOf(r[0]));
                        adapter.notifyDataSetChanged();
                        info.setText("已选 " + sel.size() + " / 共 " + shown.size());
                        return;
                    }
                    if ("反选".equals(label)) {
                        for (Object[] r : shown) {
                            String tk = String.valueOf(r[0]);
                            if (sel.contains(tk)) sel.remove(tk); else sel.add(tk);
                        }
                        adapter.notifyDataSetChanged();
                        info.setText("已选 " + sel.size() + " / 共 " + shown.size());
                        return;
                    }
                    if (sel.isEmpty()) { toast("先勾选群"); return; }
                    java.util.ArrayList<String> lst = new java.util.ArrayList<String>(sel);
                    int n = 0;
                    if ("已读".equals(label)) n = batchMarkRead(lst);
                    else if ("免打扰".equals(label)) n = batchMute(lst, true);
                    else if ("取消免打扰".equals(label)) n = batchMute(lst, false);
                    else if ("置顶".equals(label)) n = batchFlag(lst, 1, true);
                    else if ("取消置顶".equals(label)) n = batchFlag(lst, 1, false);
                    else if ("存通讯录".equals(label)) n = batchFlag(lst, 4, true);
                    else if ("删会话".equals(label)) n = batchDeleteConv(lst);
                    if (n <= 0) { toast(label + "：失败"); return; }
                    sel.clear();
                    adapter.notifyDataSetChanged();
                    new android.app.AlertDialog.Builder(a)
                            .setTitle("已修改 " + n + " 个群")
                            .setMessage(label + " 执行完成。\n微信把会话状态缓存在内存里，需要重启才生效。")
                            .setPositiveButton("立即重启微信", new android.content.DialogInterface.OnClickListener() {
                                @Override public void onClick(android.content.DialogInterface d, int w) {
                                    try { android.os.Process.killProcess(android.os.Process.myPid()); }
                                    catch (Throwable t) { }
                                }
                            })
                            .setNegativeButton("稍后", null)
                            .show();
                }
            };
            for (int i = 0; i < ops1.getChildCount(); i++) ops1.getChildAt(i).setOnClickListener(oc);
            for (int i = 0; i < ops2.getChildCount(); i++) ops2.getChildAt(i).setOnClickListener(oc);

            dlg[0] = new android.app.AlertDialog.Builder(a)
                    .setTitle("群批量管理（" + rows.size() + " 个群）")
                    .setView(box)
                    .setNegativeButton("关闭", null)
                    .create();
            dlg[0].show();
        } catch (Throwable t) { log("BATCH|ui err " + t); toast("打开失败：" + t); }
    }

    /** 简易 ArrayList 包装（避免泛型数组问题） */
    private static class ArrayListCompat extends java.util.ArrayList<Object[]> {
        ArrayListCompat(java.util.ArrayList<Object[]> src) { super(src); }
    }

    private static android.widget.TextView mkOp(android.app.Activity a, String label, boolean red) {
        android.widget.TextView tv = new android.widget.TextView(a);
        tv.setText(label);
        tv.setTextSize(13);
        tv.setTextColor(red ? 0xFFC8102E : 0xFF1A6BC8);
        tv.setPadding(dp(a, 10), dp(a, 8), dp(a, 10), dp(a, 8));
        return tv;
    }


    /* ================= 群管理控制台（把相关功能联动到一个面板） ================= */
    private static android.widget.LinearLayout consoleSection(final android.app.Activity a,
                                                             android.widget.LinearLayout box,
                                                             String title, String desc) {
        android.widget.TextView h = new android.widget.TextView(a);
        h.setText(title);
        h.setTextSize(14);
        h.setTextColor(0xFF1A1A1E);
        h.setPadding(dp(a, 2), dp(a, 12), dp(a, 2), dp(a, 2));
        box.addView(h);
        if (desc != null && desc.length() > 0) {
            android.widget.TextView d = new android.widget.TextView(a);
            d.setText(desc);
            d.setTextSize(11);
            d.setTextColor(0xFF999999);
            d.setPadding(dp(a, 2), 0, dp(a, 2), dp(a, 6));
            box.addView(d);
        }
        android.widget.LinearLayout body = new android.widget.LinearLayout(a);
        body.setOrientation(android.widget.LinearLayout.VERTICAL);
        box.addView(body);
        return body;
    }

    private static android.widget.TextView consoleRow(final android.app.Activity a,
                                                      android.widget.LinearLayout body,
                                                      String label, String value,
                                                      final Runnable click) {
        android.widget.LinearLayout row = new android.widget.LinearLayout(a);
        row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        row.setGravity(android.view.Gravity.CENTER_VERTICAL);
        row.setPadding(dp(a, 14), dp(a, 12), dp(a, 14), dp(a, 12));
        android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
        g.setColor(0xF7FFFFFF);
        g.setCornerRadius(dp(a, 10));
        row.setBackground(g);
        android.widget.LinearLayout.LayoutParams lp =
                new android.widget.LinearLayout.LayoutParams(-1, -2);
        lp.bottomMargin = dp(a, 5);
        row.setLayoutParams(lp);

        android.widget.TextView l = new android.widget.TextView(a);
        l.setText(label);
        l.setTextSize(14);
        l.setTextColor(0xFF1A1A1E);
        row.addView(l, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));

        android.widget.TextView v = new android.widget.TextView(a);
        // 开关类（开/关）用红绿圆点，和选择列表保持一致
        if ("开".equals(value)) {
            v.setText("●");
            v.setTextSize(16);
            v.setTextColor(0xFF07C160);
        } else if ("关".equals(value)) {
            v.setText("●");
            v.setTextSize(16);
            v.setTextColor(0xFF2E9E5B);
        } else {
            v.setText(value == null ? "›" : value);
            v.setTextSize(12);
            v.setTextColor(0xFF888888);
        }
        row.addView(v);

        row.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View x) {
                if (click != null) click.run();
            }
        });
        body.addView(row);
        return v;
    }

    private static void showGroupConsole(final android.app.Activity a) {
        try {
