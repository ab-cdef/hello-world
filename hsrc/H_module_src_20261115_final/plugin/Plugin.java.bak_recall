    /** 设置项自检：可见性（未分组=看不见）、配置残留、缺失项，输出 Markdown */
    private static void exportSettingsAudit() {
        try {
            java.util.HashSet<String> ref = new java.util.HashSet<String>();
            for (String[] g : settingsGroups()) for (String k : g[1].split(",")) ref.add(k.trim());
            java.util.HashSet<String> declared = new java.util.HashSet<String>();
            StringBuilder inv = new StringBuilder();
            int invisible = 0;
            for (String[] it : SETTINGS) {
                declared.add(it[0]);
                if (!ref.contains(it[0])) { invisible++; inv.append("- ").append(it[1])
                        .append("（").append(it[0]).append("）\n"); }
            }
            JSONObject c = readCfg();
            java.util.Iterator<String> it2 = c.keys();
            StringBuilder extra = new StringBuilder();
            int extraN = 0;
            while (it2.hasNext()) {
                String k = it2.next();
                if (declared.contains(k)) continue;
                if (k.startsWith("last") || k.startsWith("ct") || k.startsWith("__")) continue;
                extraN++;
                if (extraN <= 40) extra.append("- ").append(k).append('\n');
            }
            StringBuilder md = new StringBuilder();
            md.append("# 设置项自检报告\n\n> 生成于 ")
              .append(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                      .format(new java.util.Date())).append("\n\n");
            md.append("## 概况\n\n");
            md.append("- 设置项总数：**").append(SETTINGS.length).append("**\n");
            md.append("- 分组引用：" ).append(ref.size()).append(" 个键\n");
            md.append("- 未分组（设置页里看不见）：**").append(invisible).append("**\n");
            md.append("- 配置里的残留键（已无对应设置项）：**").append(extraN).append("**\n\n");
            md.append("## 未分组项\n\n").append(invisible == 0 ? "- 无\n" : inv.toString()).append('\n');
            md.append("## 配置残留键（前 40）\n\n").append(extraN == 0 ? "- 无\n" : extra.toString());
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            java.io.File f = new java.io.File(dir, "settings_audit.md");
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            fw.write(md.toString());
            fw.close();
            log("SAUDIT|total=" + SETTINGS.length + " invisible=" + invisible
                    + " extraKeys=" + extraN + " path=" + f.getAbsolutePath());
        } catch (Throwable t) {
            log("SAUDIT|err " + t);
        }
    }

    /** 自检：列出没有出现在任何分组里的设置项（这些项在设置面板里看不到） */
    private static void auditGroupCoverage() {
        try {
            String[][] groups = settingsGroups();
            java.util.HashSet<String> shown = new java.util.HashSet<String>();
            for (String[] g : groups) for (String k : g[1].split(",")) shown.add(k.trim());
            StringBuilder sb = new StringBuilder();
            int miss = 0, withValue = 0;
            java.util.List<Object[]> all = new java.util.ArrayList<Object[]>();
            for (String[] it : SETTINGS) {
                String k = it[0];
                if (!shown.contains(k)) {
                    miss++;
                    if (miss <= 20) sb.append(k).append(',');
                }
                withValue++;
            }
            log("SGAUDIT|settings=" + withValue + " grouped=" + shown.size()
                    + " ungrouped=" + miss + " list=" + sb);
        } catch (Throwable t) {
            log("SGAUDIT|err " + t);
        }
    }

