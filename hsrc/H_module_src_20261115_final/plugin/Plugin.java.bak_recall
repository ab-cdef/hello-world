            };
            try { XposedBridge.hookAllMethods(pw0, "showAtLocation", h); } catch (Throwable ignore) { }
            try {
                XposedBridge.hookAllMethods(pw0, "dismiss", new XC_MethodHook() {
                    @Override protected void afterHookedMethod(MethodHookParam p) {
                        try { menuInjectAt = 0L; } catch (Throwable ignore) { }
                    }
                });
            } catch (Throwable ignore) { }
            try { XposedBridge.hookAllMethods(pw0, "showAsDropDown", h); } catch (Throwable ignore) { }
            log("hooked sns forward x");
        } catch (Throwable t) { log("snsf err " + t); }
    }

    /** 把动态里的图片存进相册，方便手动添加到发表页 */
    private static int saveSnsImages(android.content.Context ctx, android.view.View post) {
        if (post == null) return 0;
        int saved = 0;
        try {
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectImageViews(post, all, 0);
            long ts = System.currentTimeMillis();
            int idx = 0;
            for (android.view.View v : all) {
                try {
                    if (!(v instanceof android.widget.ImageView)) continue;
                    android.graphics.drawable.Drawable d = ((android.widget.ImageView) v).getDrawable();
                    if (!(d instanceof android.graphics.drawable.BitmapDrawable)) continue;
                    android.graphics.Bitmap bm = ((android.graphics.drawable.BitmapDrawable) d).getBitmap();
                    if (bm == null || bm.getWidth() < 200 || bm.getHeight() < 200) continue;
                    idx++;
                    android.content.ContentValues cv = new android.content.ContentValues();
                    cv.put(android.provider.MediaStore.Images.Media.DISPLAY_NAME, "wxh_" + ts + "_" + idx + ".png");
                    cv.put(android.provider.MediaStore.Images.Media.MIME_TYPE, "image/png");
                    try { cv.put(android.provider.MediaStore.Images.Media.RELATIVE_PATH, "Pictures/wxh"); } catch (Throwable ignore) { }
                    android.net.Uri uri = ctx.getContentResolver().insert(
                            android.provider.MediaStore.Images.Media.EXTERNAL_CONTENT_URI, cv);
                    if (uri == null) continue;
                    java.io.OutputStream os = ctx.getContentResolver().openOutputStream(uri);
                    if (os == null) continue;
                    bm.compress(android.graphics.Bitmap.CompressFormat.PNG, 100, os);
                    os.close();
                    saved++;
                } catch (Throwable ignore) { }
            }
        } catch (Throwable t) { log("SNSIMG|" + t); }
        log("SNSIMG|saved=" + saved);
        return saved;
    }

    private static void collectImageViews(android.view.View v, java.util.ArrayList<android.view.View> out, int depth) {
        if (depth > 12) return;
        try {
            if (v instanceof android.widget.ImageView) out.add(v);
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) collectImageViews(g.getChildAt(i), out, depth + 1);
            }
        } catch (Throwable ignore) { }
    }

    /** 转发到自己的朋友圈：打开发表页并填入文字 */
    private static void shareToSns(final android.content.Context ctx, final String text) {
        if (!(ctx instanceof android.app.Activity)) return;
        final android.app.Activity a = (android.app.Activity) ctx;
        copyText(a, text);
        try {
            android.content.Intent it = new android.content.Intent();
            it.setClassName(a.getPackageName(), "com.tencent.mm.plugin.sns.ui.SnsUploadUI");
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
            a.startActivity(it);
        } catch (Throwable t) {
            toast("打开朋友圈发表页失败，文字已复制");
            log("SNSF|start " + t);
            return;
        }
        toast("已填入，点右上角「发表」");
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        fillSnsLater(h, text, 0);
        new Thread(new Runnable() {
            @Override public void run() {
                final int n = saveSnsImages(a, lastSnsView);
                if (n > 0) {
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            toast("已存 " + n + " 张图片到相册，点 ＋ 可添加");
                        }
                    });
                }
            }
        }).start();
    }

    private static void fillSnsLater(final android.os.Handler h, final String text, final int round) {
        h.postDelayed(new Runnable() {
            @Override public void run() {
                try {
                    android.app.Activity act = lastAct;
                    if (act == null || act.getClass() == null
                            || !act.getClass().getName().contains("SnsUpload")) {
                        if (round < 12) fillSnsLater(h, text, round + 1);
                        return;
                    }
                    android.widget.EditText et = findEditText(act.getWindow().getDecorView());
                    if (et == null) {
                        if (round < 12) fillSnsLater(h, text, round + 1);
                        return;
                    }
                    if (et.getText() != null && et.getText().length() > 0) return;
                    et.setText(text);
                    et.setSelection(text.length());
                    et.requestFocus();
                    log("SNSF|filled round=" + round);
                } catch (Throwable t) {
                    log("SNSF|fill " + t);
                }
            }
        }, round == 0 ? 900 : 350);
    }

    private static String extractPostText(android.view.View v) {
        try {
            android.widget.TextView mt = mainTextOf(v);
            if (mt != null && mt.getText() != null) {
                String s = mt.getText().toString().trim();
                if (s.length() > 1) return s;
            }
        } catch (Throwable ignore) { }
        return findTextIn(v);
    }

    private static void injectSnsRow(final android.widget.PopupWindow pw, final android.view.View root,
                                     final String text) {
        if (root.findViewWithTag("wxhSnsFwd") != null) return;  // 复用时靠 snsFwdText 取最新正文
        android.view.ViewGroup rows = findRowOfLabel(root, "收藏", 0);
        if (rows == null) rows = findRowContainer(root, 0);
        if (rows == null) { log("SNSF|no rows"); return; }
        final android.content.Context ctx = root.getContext();

        android.widget.LinearLayout item = new android.widget.LinearLayout(ctx);
        item.setOrientation(android.widget.LinearLayout.VERTICAL);
        item.setGravity(android.view.Gravity.CENTER_HORIZONTAL);
        item.setPadding(dp(ctx, 6), dp(ctx, 10), dp(ctx, 6), dp(ctx, 10));
        item.setMinimumWidth(dp(ctx, 56));
        item.setTag("wxhSnsFwd");

        android.widget.TextView icon = new android.widget.TextView(ctx);
        icon.setText("转");
        icon.setTextSize(11);
        icon.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
        icon.setTextColor(0xFFFFFFFF);
        icon.setGravity(android.view.Gravity.CENTER);
        // 图标不再加外框
        icon.setBackground(null);
        item.addView(icon, new android.widget.LinearLayout.LayoutParams(dp(ctx, 24), dp(ctx, 24)));

        android.widget.TextView label = new android.widget.TextView(ctx);
        label.setText("转发");
        label.setTextSize(10);
        label.setTextColor(0xFFE8E8E8);
        label.setGravity(android.view.Gravity.CENTER);
        label.setSingleLine(true);
        label.setIncludeFontPadding(false);
        android.widget.LinearLayout.LayoutParams llp = new android.widget.LinearLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
        llp.topMargin = dp(ctx, 3);
        item.addView(label, llp);

        item.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                try { pw.dismiss(); } catch (Throwable ignore) { }
                String t0 = snsFwdText;
                if (t0 == null || t0.trim().length() == 0) t0 = text;
                shareToSns(ctx, t0);
            }
        });

        android.widget.LinearLayout.LayoutParams ilp = new android.widget.LinearLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
        ilp.leftMargin = dp(ctx, 20);
        ilp.gravity = android.view.Gravity.CENTER_VERTICAL;
        rows.addView(item, ilp);
        rows.requestLayout();
        root.post(new Runnable() {
            @Override public void run() {
                try { pw.update(pw.getWidth(), android.view.ViewGroup.LayoutParams.WRAP_CONTENT); }
                catch (Throwable ignore) { }
            }
        });
        log("SNSF|added");
    }

    /** 选择会话并发送一段文字 */
    private static void shareTextToChat(final android.content.Context ctx, final String text) {
        if (!(ctx instanceof android.app.Activity)) return;
        final android.app.Activity a = (android.app.Activity) ctx;
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.List<String[]> cs = allConversations();
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (cs.isEmpty()) { toast("没有可发送的会话"); return; }
                        final String[] names = new String[cs.size()];
                        for (int i = 0; i < cs.size(); i++) names[i] = cs.get(i)[1];
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("转发到")
                                .setItems(names, new android.content.DialogInterface.OnClickListener() {
                                    @Override public void onClick(android.content.DialogInterface d, int w) {
                                        startBlast(a, new java.util.ArrayList<String>(
                                                java.util.Collections.singletonList(cs.get(w)[0])), text);
                                    }
                                })
                                .setNegativeButton("取消", null)
                                .show();
                    }
                });
            }
        }).start();
    }

    /** 探测 ChatFooter 里与 @ 相关的方法 */
    private static final java.util.concurrent.atomic.AtomicBoolean footerProbed =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    /** 在视图树里按类名找控件 */
    private static android.view.View findByClass(android.view.View v, String cls, int depth) {
        if (depth > 14) return null;
        try {
            if (v.getClass().getName().equals(cls)) return v;
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.view.View r = findByClass(g.getChildAt(i), cls, depth + 1);
                    if (r != null) return r;
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 真正插入 @所有人（文本 + 微信的 at 实体） */
    /** 在输入框插入 @某人（先登记 at 实体，再插文字；失败退化为纯文本） */
    private static void insertAtMember(final android.app.Activity act, final String username, final String name) {
        if (username == null || username.length() == 0 || name == null || name.length() == 0) {
            toast("没识别到这个人");
            return;
        }
        try {
            android.view.View footer = findByClass(act.getWindow().getDecorView(),
                    "com.tencent.mm.pluginsdk.ui.chat.ChatFooter", 0);
            if (footer != null) {
                try {
                    java.lang.reflect.Method m = footer.getClass().getMethod("setAtSomebody", String.class);
                    m.setAccessible(true);
                    m.invoke(footer, username);
                } catch (Throwable t) { log("ATONE|set err " + t); }
                try {
                    java.lang.reflect.Method gl = footer.getClass().getMethod("getAtSomebodyList");
                    gl.setAccessible(true);
                    Object lv = gl.invoke(footer);
                    if (lv instanceof java.util.List) {
                        java.util.List l = (java.util.List) lv;
                        if (!l.contains(username)) l.add(username);
                    }
                } catch (Throwable ignore) { }
            }
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            for (int i = 1; i <= 3; i++) {
                h.postDelayed(new Runnable() {
                    @Override public void run() {
                        try {
                            android.widget.EditText cur = currentInput();
                            if (cur == null) return;
                            String txt = cur.getText().toString();
                            String want = "@" + name + " ";
                            if (txt.endsWith(want)) return;
                            int st = cur.getSelectionStart();
                            if (st < 0) st = txt.length();
                            cur.getText().insert(st, want);
                            cur.setSelection(Math.min(cur.getText().length(), st + want.length()));
                            cur.requestFocus();
                            log("ATONE|inserted " + name + " len=" + cur.getText().length());
                        } catch (Throwable t) { log("ATONE|ins " + t); }
                    }
                }, 120L * i);
            }
            toast("已插入 @" + name);
        } catch (Throwable t) { toast("插入失败"); }
    }

    private static boolean insertAtAll(final android.app.Activity act, final android.widget.EditText et) {
        try {
            android.view.View footer = findByClass(act.getWindow().getDecorView(),
                    "com.tencent.mm.pluginsdk.ui.chat.ChatFooter", 0);
            if (footer == null) { log("ATALL|no footer"); return false; }
            // 1) 先登记 at 实体（这一步会重置编辑器，所以要放在插入文字之前）
            try {
                java.lang.reflect.Method m = footer.getClass().getMethod("setAtSomebody", String.class);
                m.setAccessible(true);
                m.invoke(footer, "notify@all");
            } catch (Throwable t) { log("ATALL|set err " + t); }
            try {
                java.lang.reflect.Method gl = footer.getClass().getMethod("getAtSomebodyList");
                gl.setAccessible(true);
                Object lv = gl.invoke(footer);
                if (lv instanceof java.util.List) {
                    java.util.List l = (java.util.List) lv;
                    if (!l.contains("notify@all")) l.add("notify@all");
                    log("ATALL|list=" + l.size());
                }
            } catch (Throwable t) { log("ATALL|list err " + t); }

            // 2) 等编辑器重置完成后再插入文字
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            for (int i = 1; i <= 3; i++) {
                h.postDelayed(new Runnable() {
                    @Override public void run() {
                        try {
                            android.widget.EditText cur = currentInput();
                            if (cur == null) cur = et;
                            if (cur == null) return;
                            String txt = cur.getText().toString();
                            if (txt.contains("@所有人")) return;
                            int st = cur.getSelectionStart();
                            if (st < 0) st = txt.length();
                            cur.getText().insert(st, "@所有人 ");
                            cur.setSelection(Math.min(cur.getText().length(), st + 5));
                            cur.requestFocus();
                            log("ATALL|inserted len=" + cur.getText().length());
                        } catch (Throwable t) { log("ATALL|ins " + t); }
                    }
                }, 120L * i);
            }
            return true;
        } catch (Throwable t) {
            log("ATALL|err " + t);
            return false;
        }
    }

    /** 一次性导出 LauncherUI 里与切页/发现相关的方法 */
    private static final java.util.concurrent.atomic.AtomicBoolean launcherProbed =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    private static void probeLauncher(ClassLoader app) {
        if (!launcherProbed.compareAndSet(false, true)) return;
        try {
            Class<?> c = Class.forName("com.tencent.mm.ui.LauncherUI", false, app);
            StringBuilder sb = new StringBuilder("LPROBE|");
            for (java.lang.reflect.Method m : c.getDeclaredMethods()) {
                String n = m.getName().toLowerCase();
                if (n.contains("tab") || n.contains("switch") || n.contains("select")
                        || n.contains("discover") || n.contains("sns") || n.contains("jump")) {
                    sb.append(m.getName()).append('(');
                    for (Class<?> pc : m.getParameterTypes()) sb.append(pc.getSimpleName()).append(',');
                    sb.append(") ");
                }
            }
            log(sb.toString());
            // 导出与 tab / pager / adapter 相关的字段
            StringBuilder fb = new StringBuilder("LFIELD|");
            for (java.lang.reflect.Field f : c.getDeclaredFields()) {
                String tn = f.getType().getName().toLowerCase();
                String fn = f.getName().toLowerCase();
                if (tn.contains("tab") || tn.contains("pager") || tn.contains("adapter")
                        || fn.contains("tab") || fn.contains("pager") || fn.contains("index")
                        || fn.contains("current") || fn.contains("fragment")) {
                    fb.append(f.getName()).append(':').append(f.getType().getSimpleName()).append(' ');
                }
            }
            log(fb.toString());
            Class<?> sup = c.getSuperclass();
            int guard = 0;
            while (sup != null && guard++ < 3) {
                StringBuilder sb2 = new StringBuilder("LSUPER|" + sup.getSimpleName() + "|");
                for (java.lang.reflect.Field f : sup.getDeclaredFields()) {
                    String tn = f.getType().getName().toLowerCase();
                    String fn = f.getName().toLowerCase();
                    if (tn.contains("tab") || tn.contains("pager") || fn.contains("tab") || fn.contains("pager")) {
                        sb2.append(f.getName()).append(':').append(f.getType().getSimpleName()).append(' ');
                    }
                }
                log(sb2.toString());
                sup = sup.getSuperclass();
            }
        } catch (Throwable t) { log("LPROBE|err " + t); }
    }

    private static void probeChatFooter(ClassLoader app) {
        if (!footerProbed.compareAndSet(false, true)) return;
        try {
            Class<?> c = Class.forName("com.tencent.mm.pluginsdk.ui.chat.ChatFooter", false, app);
            StringBuilder sb = new StringBuilder("FOOTER|");
            for (java.lang.reflect.Method m : c.getDeclaredMethods()) {
                String n = m.getName();
                if (n.toLowerCase().contains("at") || n.toLowerCase().contains("mention")) {
                    sb.append(n).append('(');
                    for (Class<?> pc : m.getParameterTypes()) sb.append(pc.getSimpleName()).append(',');
                    sb.append(')');
                }
            }
            log(sb.toString());
        } catch (Throwable t) { log("FOOTER|err " + t); }
    }

    private static volatile long menuInjectAt = 0L;
    private static final java.util.concurrent.atomic.AtomicBoolean menuClsLogged =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    private static void installChatMenuInject(ClassLoader app) {
        try {
            Class<?> pw0 = Class.forName("android.widget.PopupWindow", false, app);
            XC_MethodHook h = new XC_MethodHook() {
                @Override protected void afterHookedMethod(final MethodHookParam p) {
                    try {
                        Object o = p.thisObject;
                        if (!(o instanceof android.widget.PopupWindow)) return;
                        String cn = o.getClass().getName();
                        if (chatAct == null && lastAct == null) {
                            log("MENUINJ|no act cls=" + cn);
                            return;
                        }
                        if (!cn.startsWith("ak5.e5")) {
                            if (menuClsLogged.compareAndSet(false, true)) log("MENUINJ|skipcls " + cn);
                            return;
                        }
                        android.view.View anchor = null;
                        if (p.args.length >= 1 && p.args[0] instanceof android.view.View) {
                            anchor = (android.view.View) p.args[0];
                        }
                        String msg = null;
                        if (anchor != null) msg = textByAdapter(anchor);
                        if (msg == null && anchor != null) msg = textOfView(anchor);
                        if (msg == null && lastLongPressText != null
                                && System.currentTimeMillis() - lastLongPressAt < 4000) {
                            msg = lastLongPressText;
                        }
                        String msgUse = msg;
                        if (badMsgText(msgUse) && lastLongPressText != null
                                && System.currentTimeMillis() - lastLongPressAt < 6000) {
                            msgUse = lastLongPressText;
                        }
                        final String fmsg = badMsgText(msgUse) ? null : msgUse.trim();
                        final android.view.View anchorF = anchor;
                        final android.widget.PopupWindow pw = (android.widget.PopupWindow) o;
                        final android.view.View cv = pw.getContentView();
                        if (cv == null) return;
                        log("MENUINJ|cls=" + cn + " msg=" + (fmsg == null ? "null" : fmsg));
                        if (anchor != null && dumpProbe.compareAndSet(false, true)) {
                            try {
                                StringBuilder mb = new StringBuilder("ANCHOR|" + anchor.getClass().getName() + "|M:");
                                Class<?> k2 = anchor.getClass();
                                while (k2 != null && k2 != Object.class) {
                                    for (java.lang.reflect.Method m2 : k2.getDeclaredMethods()) {
                                        if (m2.getParameterTypes().length == 0) mb.append(m2.getName()).append(',');
                                    }
                                    k2 = k2.getSuperclass();
                                }
                                mb.append("|F:");
                                k2 = anchor.getClass();
                                while (k2 != null && k2 != Object.class) {
                                    for (java.lang.reflect.Field f2 : k2.getDeclaredFields()) {
                                        mb.append(f2.getName()).append(':').append(f2.getType().getSimpleName()).append(',');
                                    }
                                    k2 = k2.getSuperclass();
                                }
                                log(mb.toString());
                            } catch (Throwable ignore) { }
                        }
                        cv.post(new Runnable() {
                            @Override public void run() {
                                try { injectMenuRow(pw, cv, fmsg, anchorF); } catch (Throwable t) { log("MENUINJ|" + t); }
                            }
                        });
                    } catch (Throwable ignore) { }
                }
            };
            try { XposedBridge.hookAllMethods(pw0, "showAtLocation", h); } catch (Throwable ignore) { }
            try { XposedBridge.hookAllMethods(pw0, "showAsDropDown", h); } catch (Throwable ignore) { }
            log("hooked chat menu inject v5");
        } catch (Throwable t) { log("menuinj err " + t); }
    }

    private static int countLabels(android.view.View v, int depth) {
        if (depth > 8) return 0;
        int n = 0;
        if (v instanceof android.widget.TextView) {
            CharSequence t = ((android.widget.TextView) v).getText();
            if (t != null) {
                String s = t.toString();
                if (s.equals("复制") || s.equals("转发") || s.equals("收藏") || s.equals("删除")
                        || s.equals("引用") || s.equals("提醒") || s.equals("翻译") || s.equals("多选")
                        || s.equals("搜一搜")) n++;
            }
        }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) n += countLabels(g.getChildAt(i), depth + 1);
        }
        return n;
    }

    private static android.view.ViewGroup findRowOfLabel(android.view.View v, String want, int depth) {
        if (depth > 8) return null;
        if (v instanceof android.widget.TextView) {
            CharSequence t = ((android.widget.TextView) v).getText();
            if (t != null && want.equals(t.toString())) {
                android.view.ViewParent p0 = v.getParent();
                while (p0 instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) p0;
                    if (g instanceof android.widget.LinearLayout
                            && ((android.widget.LinearLayout) g).getOrientation()
                            == android.widget.LinearLayout.HORIZONTAL) return g;
                    p0 = g.getParent();
                }
            }
        }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.ViewGroup r = findRowOfLabel(g.getChildAt(i), want, depth + 1);
                if (r != null) return r;
            }
        }
        return null;
    }

    private static android.view.ViewGroup findRowContainer(android.view.View v, int depth) {
        if (depth > 6 || !(v instanceof android.view.ViewGroup)) return null;
        android.view.ViewGroup g = (android.view.ViewGroup) v;
        if (g instanceof android.widget.LinearLayout
                && ((android.widget.LinearLayout) g).getOrientation() == android.widget.LinearLayout.VERTICAL
                && countLabels(g, 0) >= 4) {
            return g;
        }
        for (int i = 0; i < g.getChildCount(); i++) {
            android.view.ViewGroup r = findRowContainer(g.getChildAt(i), depth + 1);
            if (r != null) return r;
        }
        return null;
    }

    private static void injectMenuRow(final android.widget.PopupWindow pw, final android.view.View root,
                                      final String msg, final android.view.View anchorView) {
        if (anchorView != null) {
            menuAnchorView = anchorView;
            log("MENUINJ|anchor saved " + anchorView.getClass().getSimpleName());
        }
        if (root.findViewWithTag("wxhAiMenu") != null) return;
        // 微信有时会连续 show 两次同一菜单，防抖避免注入两遍
        long nowInj = System.currentTimeMillis();
        if (nowInj - menuInjectAt < 2500L) {
            log("MENUINJ|debounce " + (nowInj - menuInjectAt) + "ms");
            return;
        }
        menuInjectAt = nowInj;
        // 只在聊天页注入。朋友圈/公众号/设置等页面的长按菜单没有"消息"上下文，
        // 这些 chip（伪赞/引用/转发到/存图…）点了只会报"定位不到这条消息"。
        boolean inChatNow = inChat || isInChatUi() || chatTalker != null;
        if (!inChatNow) { log("MENUINJ|skip non-chat"); return; }
        android.view.ViewGroup rowsTmp = findRowOfLabel(root, "问小微", 0);
        boolean sameRow = rowsTmp != null;
        if (rowsTmp == null) rowsTmp = findRowContainer(root, 0);
        if (rowsTmp == null) { log("MENUINJ|no rows"); return; }
        final android.view.ViewGroup rows = rowsTmp;

        final android.content.Context ctx = root.getContext();
        // 以微信自己的项为参照，保证横竖对齐
        android.view.View refItemTmp = rows.getChildCount() > 0 ? rows.getChildAt(0) : null;
        final android.view.View refItem = refItemTmp;
        int refW = -2, refH = -2, padL = dp(ctx, 6), padT = dp(ctx, 10), padR = dp(ctx, 6), padB = dp(ctx, 10);
        if (refItem != null) {
            if (refItem.getLayoutParams() != null) {
                refW = refItem.getLayoutParams().width;
                refH = refItem.getLayoutParams().height;
            }
            if (padL == 0) refW = -2;
            padL = refItem.getPaddingLeft();
            padT = refItem.getPaddingTop();
            padR = refItem.getPaddingRight();
            padB = refItem.getPaddingBottom();
        }
        // 我们的项单独占一整行（等宽 4 格），避免挤进微信的格子导致裁剪
        android.view.ViewGroup colParent = rows.getParent() instanceof android.view.ViewGroup
                ? (android.view.ViewGroup) rows.getParent() : null;
        // 我们的 chip 用「竖向容器 + 每行 5 个」的自建网格，排版可控
        final android.widget.LinearLayout ourRow = new android.widget.LinearLayout(ctx);
        ourRow.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        ourRow.setTag("wxhOurRow");
        final int[] chipN = new int[]{0};
        final android.widget.LinearLayout[] curRow = new android.widget.LinearLayout[]{null};
        final android.content.Context ctxF = ctx;
        // 菜单底色：微信长按菜单是深灰圆角，这里用同色补一条，只留底部圆角与菜单衔接
        try {
            android.graphics.drawable.GradientDrawable bgRow = new android.graphics.drawable.GradientDrawable();
            bgRow.setColor(0xFF2C2C2E);
            float r = dp(ctx, 10);
            bgRow.setCornerRadii(new float[]{0, 0, 0, 0, r, r, r, r});
            ourRow.setBackground(bgRow);
            ourRow.setPadding(dp(ctx, 4), dp(ctx, 8), dp(ctx, 4), dp(ctx, 10));
        } catch (Throwable ignore) { }
        android.widget.LinearLayout item = new android.widget.LinearLayout(ctx);
        item.setOrientation(android.widget.LinearLayout.VERTICAL);
        item.setGravity(android.view.Gravity.CENTER_HORIZONTAL);
        item.setPadding(padL, padT, padR, padB);
        if (refW > 0) item.setMinimumWidth(refW);
        item.setTag("wxhAiMenu");

        android.widget.TextView icon = new android.widget.TextView(ctx);
        icon.setText("AI");
        icon.setTextSize(9);
        icon.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
        icon.setTextColor(0xFFFFFFFF);
        icon.setGravity(android.view.Gravity.CENTER);
        // 图标不再加外框
        icon.setBackground(null);
        item.addView(icon, new android.widget.LinearLayout.LayoutParams(dp(ctx, 24), dp(ctx, 24)));

        android.widget.TextView label = new android.widget.TextView(ctx);
        label.setText("AI 分析");
        label.setTextSize(10);
        label.setTextColor(0xFFE8E8E8);
        label.setGravity(android.view.Gravity.CENTER);
        label.setSingleLine(true);
        label.setIncludeFontPadding(false);
        android.widget.LinearLayout.LayoutParams llp = new android.widget.LinearLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
        llp.topMargin = dp(ctx, 3);
        item.addView(label, llp);

        item.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                try { pw.dismiss(); } catch (Throwable ignore) { }
                aiGenerate(chatAct, currentInput(), msg);
            }
        });

        // 同一行再加一个「发朋友圈」
        try {
            if (true) {
                android.widget.LinearLayout item2 = new android.widget.LinearLayout(ctx);
                item2.setOrientation(android.widget.LinearLayout.VERTICAL);
                item2.setGravity(android.view.Gravity.CENTER_HORIZONTAL);
                item2.setPadding(dp(ctx, 6), dp(ctx, 10), dp(ctx, 6), dp(ctx, 10));
                item2.setMinimumWidth(dp(ctx, 56));
                android.widget.TextView icon2 = new android.widget.TextView(ctx);
                icon2.setText("圈");
                icon2.setTextSize(11);
                icon2.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
                icon2.setTextColor(0xFFFFFFFF);
                icon2.setGravity(android.view.Gravity.CENTER);
        // 图标不再加外框
                icon2.setBackground(null);
                item2.addView(icon2, new android.widget.LinearLayout.LayoutParams(dp(ctx, 24), dp(ctx, 24)));
                android.widget.TextView lb2 = new android.widget.TextView(ctx);
                lb2.setText("发圈");
                lb2.setTextSize(10);
                lb2.setTextColor(0xFFE8E8E8);
                lb2.setGravity(android.view.Gravity.CENTER);
                android.widget.LinearLayout.LayoutParams l2 = new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                l2.topMargin = dp(ctx, 5);
                item2.addView(lb2, l2);
                item2.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        if (msg == null || msg.trim().length() == 0) { toast("这条没有可转发的文字"); return; }
                        shareToSns(chatAct, msg);
                    }
                });
                android.widget.LinearLayout.LayoutParams ilp2 = gridLp(refItem, refW, refH);
                ilp2.gravity = android.view.Gravity.CENTER_VERTICAL;
                addGridChipView(ctxF, ourRow, chipN, curRow, item2);
            }
        } catch (Throwable ignore) { }

        // 「改字」：替换这条消息里的文字（用菜单锚点里已确认的原文）
        try {
            if (cfg().optBoolean("textEditMode", false)) {
                android.widget.LinearLayout item3 = new android.widget.LinearLayout(ctx);
                item3.setOrientation(android.widget.LinearLayout.VERTICAL);
                item3.setGravity(android.view.Gravity.CENTER_HORIZONTAL);
                item3.setPadding(dp(ctx, 6), dp(ctx, 10), dp(ctx, 6), dp(ctx, 10));
                item3.setMinimumWidth(dp(ctx, 56));

                android.widget.TextView icon3 = new android.widget.TextView(ctx);
                icon3.setText("A");
                icon3.setTextSize(11);
                icon3.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
                icon3.setTextColor(0xFFFFFFFF);
                icon3.setGravity(android.view.Gravity.CENTER);
                icon3.setBackground(null);          // 不要外框
                item3.addView(icon3, new android.widget.LinearLayout.LayoutParams(dp(ctx, 24), dp(ctx, 24)));

                android.widget.TextView lb3 = new android.widget.TextView(ctx);
                lb3.setText("改字");
                lb3.setTextSize(10);
                lb3.setTextColor(0xFFE8E8E8);
                lb3.setGravity(android.view.Gravity.CENTER);
                android.widget.LinearLayout.LayoutParams l3 = new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                l3.topMargin = dp(ctx, 5);
                item3.addView(lb3, l3);

                item3.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        // 精确定位：找锚点所在的整行，算出「从底部数第几条」
                        boolean fresh = System.currentTimeMillis() - lastLongPressAt < 8000;
                        int pfb = -1;
                        long ts = 0;
                        if (fresh) { ts = lastLongPressTs; pfb = lastLongPressPfb; }
                        if (pfb < 0) pfb = rowIndexFromBottomByContainment(anchorView);
                        if (pfb < 0) pfb = rowIndexFromBottomByPoint(anchorView);
                        if (ts <= 0) ts = tsOfAnchor(anchorView);
                        if (ts <= 0) ts = tsOfRow(pfb);
                        if (ts < 100000000000L && ts > 0) ts = ts * 1000L;
                        String tk = chatTalker;
                        String useOrig = msg;
                        if (fresh && lastLongPressText != null && lastLongPressText.trim().length() > 0) {
                            useOrig = lastLongPressText.trim();
                        }
                        if (useOrig == null || useOrig.trim().length() == 0) {
                            toast("这条没有可改的文字");
                            return;
                        }
                        log("TXTREPL_SCOPE|talker=" + tk + " pfb=" + pfb + " ts=" + ts + " orig=" + useOrig);
                        askReplaceAt(chatAct, useOrig, tk, pfb, ts);
                    }
                });
                android.widget.LinearLayout.LayoutParams ilp3 = gridLp(refItem, refW, refH);
                ilp3.gravity = android.view.Gravity.CENTER_VERTICAL;
                addGridChipView(ctxF, ourRow, chipN, curRow, item3);


            }
        } catch (Throwable ignore) { }

        // 「复读」：文字复读文字，图片复读图片（不受 msg 是否为空限制）
        try {
                // 「复读」：把这条内容再发一遍
                android.widget.LinearLayout item4 = new android.widget.LinearLayout(ctx);
                item4.setOrientation(android.widget.LinearLayout.VERTICAL);
                item4.setGravity(android.view.Gravity.CENTER_HORIZONTAL);
                item4.setPadding(padL, padT, padR, padB);
                android.widget.TextView icon4 = new android.widget.TextView(ctx);
                icon4.setText("\u21bb");
                icon4.setTextSize(14);
                icon4.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
                icon4.setTextColor(0xFFFFFFFF);
                icon4.setGravity(android.view.Gravity.CENTER);
                icon4.setBackground(null);          // 不要外框
                item4.addView(icon4, new android.widget.LinearLayout.LayoutParams(dp(ctx, 24), dp(ctx, 24)));
                android.widget.TextView lb4 = new android.widget.TextView(ctx);
                lb4.setText("复读");
                lb4.setTextSize(10);
                lb4.setTextColor(0xFFE8E8E8);
                lb4.setGravity(android.view.Gravity.CENTER);
                lb4.setSingleLine(true);
                lb4.setIncludeFontPadding(false);
                android.widget.LinearLayout.LayoutParams l4 = new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                l4.topMargin = dp(ctx, 5);
                item4.addView(lb4, l4);
                item4.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        long tp0 = typeOfPressed();
                        if (tp0 == 34 || tp0 == 43) {
                            // 语音/视频：走微信自己的「转发」= 语音转发
                            autoForwardAt = System.currentTimeMillis();
                            autoForwardTalker = chatTalker;
                            boolean fw = false;
                            try { fw = clickMenuText(root, "转发"); } catch (Throwable ignore) { }
                            log("ECHOVOICE|forward=" + fw + " type=" + tp0);
                            try { pw.dismiss(); } catch (Throwable ignore) { }
                            if (fw) scheduleForwardConfirm();
                            return;
                        }
                        boolean preferImg = (msg == null || msg.trim().length() == 0
                                || (msg.trim().startsWith("[") && msg.trim().endsWith("]")));
                        if (!preferImg) {
                            // 表情包/图片：这一行里有大图且文字很短 → 按图片复读
                            try {
                                android.view.View pv = lastLongPressView == null ? null : lastLongPressView.get();
                                android.view.View rw = rowOf(pv);
                                if (rw != null && findBigImageView(rw) != null && msg.trim().length() <= 8) {
                                    preferImg = true;
                                }
                            } catch (Throwable ignore) { }
                        }
                        if (preferImg) {
                            try { pw.dismiss(); } catch (Throwable ignore) { }
                            echoImageFlow();
                        } else {
                            try { pw.dismiss(); } catch (Throwable ignore) { }
                            echoMessage(msg);
                        }
                    }
                });
                android.widget.LinearLayout.LayoutParams ilp4 = gridLp(refItem, refW, refH);
                ilp4.gravity = android.view.Gravity.CENTER_VERTICAL;
                addGridChipView(ctxF, ourRow, chipN, curRow, item4);

                // 「详情」：查看这条消息的元数据
                addGridChip(ctxF, ourRow, chipN, curRow, "\u2139", "详情", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        showMsgDetail(chatAct, chatTalker,
                                lastLongPressTs > 0 ? lastLongPressTs : System.currentTimeMillis(),
                                lastLongPressText);
                    }
                });
                // 「TA记录」：看这个人的历史发言
                addGridChip(ctxF, ourRow, chipN, curRow, "\u263A", "TA记录", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        try {
                            android.view.View anchor = lastLongPressView != null ? lastLongPressView.get() : null;
                            String who = null;
                            if (anchor != null && chatTalker != null && chatTalker.endsWith("@chatroom")) {
                                who = senderOfRow(anchor, chatTalker);
                            }
                            if (who == null || who.length() == 0) who = chatTalker;
                            openHistoryWith(who);
                        } catch (Throwable t) { log("TAHIST|err " + t); }
                    }
                });
                // 「待办」：把这条消息标记为待办
                addGridChip(ctxF, ourRow, chipN, curRow, "\u2691", "待办", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        long t3 = lastLongPressTs > 0 ? lastLongPressTs : System.currentTimeMillis();
                        String tx3 = lastLongPressText != null ? lastLongPressText
                                : (lastLongPressView != null && lastLongPressView.get() != null
                                        ? String.valueOf(renderedTextOf(lastLongPressView.get())) : "");
                        addTodo(chatTalker, t3, tx3);
                    }
                });
                // 「提醒」：到点用通知提醒我回这条
                addGridChip(ctxF, ourRow, chipN, curRow, "\u23f1", "提醒", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        String tx4 = lastLongPressText != null ? lastLongPressText
                                : (lastLongPressView != null && lastLongPressView.get() != null
                                        ? String.valueOf(renderedTextOf(lastLongPressView.get())) : "");
                        if (tx4 == null) tx4 = "";
                        if (tx4.length() > 60) tx4 = tx4.substring(0, 60) + "…";
                        askRemind(ctx instanceof android.app.Activity
                                ? (android.app.Activity) ctx : chatAct, tx4);
                    }
                });
                // 「收藏」：存进本地收藏夹
                addGridChip(ctxF, ourRow, chipN, curRow, "\u2606", "收藏", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        android.view.View av = lastLongPressView == null ? null : lastLongPressView.get();
                        if (av == null) av = menuAnchorView;
                        String tx = speakableText(av);
                        String tkF = null;
                        try {
                            android.app.Activity caF = chatAct != null ? chatAct : lastAct;
                            if (caF != null) tkF = talkerFromAdapter(caF);
                        } catch (Throwable ignore) { }
                        if (tkF == null || tkF.length() == 0) tkF = currentTalker();
                        if (tkF == null || tkF.length() == 0) tkF = chatTalker;
                        log("FAV|talker=" + tkF + " chatTalker=" + chatTalker);
                        addFavorite(tkF, tx);
                    }
                });
                // 「朗读」：用系统 TTS 读这条
                addGridChip(ctxF, ourRow, chipN, curRow, "\u266a", "朗读", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        android.view.View av = lastLongPressView == null ? null : lastLongPressView.get();
                        if (av == null) av = menuAnchorView;
                        String tx = speakableText(av);
                        if (tx == null || tx.trim().length() == 0) { toast("这条没有可读文字"); return; }
                        ttsSpeak(tx.trim());
                    }
                });
                // 「存图」：把这条的图片/表情保存到相册
                addGridChip(ctxF, ourRow, chipN, curRow, "\u2b07", "存图", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        saveImageOfMessage(false);
                    }
                });
                // 「复制图」：存到相册并复制图片到剪贴板（可在聊天里长按粘贴发送）
                // 「@TA」：群里一键 @ 发这条的人
                try {
                    final android.app.Activity caAt = chatAct != null ? chatAct
                            : (ctx instanceof android.app.Activity ? (android.app.Activity) ctx : lastAct);
                    if (caAt != null && chatTalker != null && chatTalker.endsWith("@chatroom")) {
                        android.view.View avAt = lastLongPressView == null ? null : lastLongPressView.get();
                        if (avAt == null) avAt = menuAnchorView;
                        final String uidAt = avAt == null ? null : senderOfRow(avAt, chatTalker);
                        String nmAt = uidAt == null ? "" : senderName(uidAt);
                        if (nmAt.length() == 0 && uidAt != null) nmAt = displayOfTalker(uidAt);
                        final String nameAt = nmAt;
                        if (uidAt != null && nameAt.length() > 0) {
                            addGridChip(ctxF, ourRow, chipN, curRow, "\u0040", "@" + (nameAt.length() > 4
                                    ? nameAt.substring(0, 4) : nameAt), new android.view.View.OnClickListener() {
                                @Override public void onClick(android.view.View v) {
                                    try { pw.dismiss(); } catch (Throwable ignore) { }
                                    insertAtMember(caAt, uidAt, nameAt);
                                }
                            });
                        }
                    }
                } catch (Throwable ignore) { }

                // 「语音路径」：把这条语音的缓存文件路径复制出来（方便外部工具处理）
                addGridChip(ctxF, ourRow, chipN, curRow, "\u266b", "语音路径", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        try {
                            String tk = chatTalker != null ? chatTalker : currentTalker();
                            long ts = lastLongPressTs;
                            if (tk == null || tk.length() == 0 || ts <= 0) { toast("定位不到这条语音"); return; }
                            String ip = "";
                            java.util.List<Object[]> rr = queryRows(
                                    "select ifnull(imgPath,'') from message where talker='" + escSql(tk)
                                            + "' and createTime=" + ts + " and (type & 65535)=34 limit 1", 1);
                            if (!rr.isEmpty() && rr.get(0)[0] != null) ip = String.valueOf(rr.get(0)[0]);
                            if (ip.length() == 0) { toast("这条不是语音消息"); return; }
                            String md5 = null;
                            int k = ip.indexOf("msg_");
                            if (k >= 0) md5 = ip.substring(k + 4).replace(".amr", "").trim();
                            if (md5 == null || md5.length() < 16) md5 = ip.trim();
                            java.io.File hit = null;
                            for (java.io.File b : voiceBases()) {
                                java.io.File v2 = new java.io.File(b, "voice2");
                                java.io.File[] ds = v2.listFiles();
                                if (ds == null) continue;
                                for (java.io.File d1 : ds) {
                                    if (!d1.isDirectory()) continue;
                                    java.io.File[] fs1 = d1.listFiles();
                                    if (fs1 == null) continue;
                                    for (java.io.File f1 : fs1) {
                                        if (f1.isDirectory()) {
                                            java.io.File[] fs2 = f1.listFiles();
                                            if (fs2 == null) continue;
                                            for (java.io.File f2 : fs2) {
                                                if (f2.getName().contains(md5)) { hit = f2; break; }
                                            }
                                        } else if (f1.getName().contains(md5)) { hit = f1; }
                                        if (hit != null) break;
                                    }
                                    if (hit != null) break;
                                }
                                if (hit != null) break;
                            }
                            if (hit == null) { toast("本机没找到这条语音文件\nimgPath=" + ip); return; }
                            android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                    ctx.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                            cm.setPrimaryClip(android.content.ClipData.newPlainText("p", hit.getAbsolutePath()));
                            toast("已复制路径\n" + hit.getAbsolutePath());
                            log("VOICEPATH|" + hit.getAbsolutePath());
                        } catch (Throwable t) { toast("失败：" + t); }
                    }
                });

                // 「复制ID」：复制这条消息发送人的 wxid（群里查人/加好友用）
                addGridChip(ctxF, ourRow, chipN, curRow, "\u2699", "复制ID", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        try {
                            android.view.View av = lastLongPressView == null ? null : lastLongPressView.get();
                            if (av == null) av = menuAnchorView;
                            String uid = av == null ? null : senderOfRow(av, chatTalker);
                            if (uid == null || uid.length() == 0) { toast("没识别到发送人"); return; }
                            android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                    ctx.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                            cm.setPrimaryClip(android.content.ClipData.newPlainText("wxid", uid));
                            toast("已复制 ID：" + uid);
                            log("CPID|" + uid);
                        } catch (Throwable t) { toast("复制失败"); }
                    }
                });

                // 「加好友」：复制发送人 wxid 并打开微信「添加朋友」搜索页（销售用）
                addGridChip(ctxF, ourRow, chipN, curRow, "\u2795", "加好友", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        try {
                            android.view.View av = lastLongPressView == null ? null : lastLongPressView.get();
                            if (av == null) av = menuAnchorView;
                            String uid = av == null ? null : senderOfRow(av, chatTalker);
                            if (uid == null || uid.length() == 0) { toast("没识别到发送人"); return; }
                            android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                    ctx.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                            cm.setPrimaryClip(android.content.ClipData.newPlainText("wxid", uid));
                            String nm = displayOfTalker(uid);
                            boolean opened = false;
                            String[] acts = {
                                    "com.tencent.mm.plugin.fts.ui.FTSAddFriendUI",
                                    "com.tencent.mm.ui.fts.FTSAddFriendUI"
                            };
                            for (String cn : acts) {
                                try {
                                    android.content.Intent it = new android.content.Intent();
                                    it.setClassName(ctx, cn);
                                    it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
                                    ctx.startActivity(it);
                                    opened = true;
                                    break;
                                } catch (Throwable ignore) { }
                            }
                            toast(opened
                                    ? ("已复制 " + (nm == null ? uid : nm) + " 的微信号\n在搜索框粘贴即可添加")
                                    : ("已复制微信号：" + uid + "\n请到 通讯录 → 添加朋友 粘贴"));
                            log("ADDFRIEND|" + uid + " opened=" + opened);
                        } catch (Throwable t) { toast("加好友失败"); }
                    }
                });

                // 「定时」：把这条消息内容预填进定时发送
                addGridChip(ctxF, ourRow, chipN, curRow, "\u23f2", "定时", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        android.app.Activity aa = chatAct != null ? chatAct : lastAct;
                        if (aa == null) { toast("请回到聊天页再试"); return; }
                        String tk = chatTalker != null ? chatTalker : currentTalker();
                        long ts = pressedTs();
                        schedInitText = messageBodyOf(tk, ts, 500, false);
                        showScheduleDialog(aa);
                    }
                });

                // 「套餐」：当前会话一键出 4 个文件（记录/明细/类型/报告）
                addGridChip(ctxF, ourRow, chipN, curRow, "\u25a3", "套餐", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        android.app.Activity aa = chatAct != null ? chatAct : lastAct;
                        String tk = chatTalker != null ? chatTalker : currentTalker();
                        if (aa == null || tk == null) { toast("请回到聊天页再试"); return; }
                        runExportBundle(aa, tk, displayOfTalker(tk));
                    }
                });

                // 「转发到」：把这一条消息转发到指定会话
                addGridChip(ctxF, ourRow, chipN, curRow, "\u21aa", "转发到", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        android.app.Activity aa = chatAct != null ? chatAct : lastAct;
                        String tk = chatTalker != null ? chatTalker : currentTalker();
                        long ts = pressedTs();
                        if (aa == null || tk == null || ts <= 0) { toast("定位不到这条消息"); return; }
                        showTalkerPicker(aa, "转发到", false, new ChatPick() {
                            @Override public void onPick(String target, String tnm) {
                                forwardOne(aa, tk, ts, target, tnm);
                            }
                        });
                    }
                });

                // 「引用」：把这条消息的原文 + 发送人塞进输入框（拟真引用）
                addGridChip(ctxF, ourRow, chipN, curRow, "\u201c", "引用", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        android.app.Activity aa = chatAct != null ? chatAct : lastAct;
                        String tk = chatTalker != null ? chatTalker : currentTalker();
                        long ts = pressedTs();
                        if (aa == null || tk == null || ts <= 0) { toast("定位不到这条消息"); return; }
                        if (insertQuoteFor(aa, tk, ts)) toast("已插入引用，补充内容后发送");
                        else toast("插入失败");
                    }
                });

                // 「导出」：当前会话的媒体导出（图片/语音/视频/文件）
                addGridChip(ctxF, ourRow, chipN, curRow, "\u2b07\ufe0f", "导出", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        String tk = chatTalker;
                        if (tk == null || tk.length() == 0) tk = currentTalker();
                        if (tk == null || tk.length() == 0) { toast("没识别到会话"); return; }
                        android.app.Activity aa = chatAct != null ? chatAct
                                : (ctx instanceof android.app.Activity ? (android.app.Activity) ctx : lastAct);
                        if (aa == null) { toast("请回到聊天页再试"); return; }
                        showMediaExportTypes(aa, tk, displayOfTalker(tk));
                    }
                });

                addGridChip(ctxF, ourRow, chipN, curRow, "\u29c9", "复制图", new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { pw.dismiss(); } catch (Throwable ignore) { }
                        saveImageOfMessage(true);
                    }
                });
        } catch (Throwable ignore) { }

        addGridChipView(ctxF, ourRow, chipN, curRow, item);
        final android.view.ViewGroup[] wrapRef = new android.view.ViewGroup[1];
        // 记录微信原生菜单的宽度：我们的列宽按它算，才能像原生那样靠左排，而不是铺满屏宽
        int natW0 = 0;
        try { if (pw.getWidth() > 0) natW0 = pw.getWidth(); } catch (Throwable ignore) { }
        if (natW0 <= 0) { try { if (root.getWidth() > 0) natW0 = root.getWidth(); } catch (Throwable ignore) { } }
        final int[] natW = new int[]{natW0};
        // 把微信原本的菜单内容整体包一层，我们的行放在它下面（绝不进入微信的网格行）
        try {
            android.view.ViewGroup content = (root instanceof android.view.ViewGroup)
                    ? (android.view.ViewGroup) root : null;
            android.view.ViewParent vp = content == null ? null : content.getParent();
            if (content != null && vp instanceof android.view.ViewGroup) {
                android.view.ViewGroup holder = (android.view.ViewGroup) vp;
                int idx = holder.indexOfChild(content);
                android.view.ViewGroup.LayoutParams clp = content.getLayoutParams();
                holder.removeView(content);
                android.widget.LinearLayout wrap = new android.widget.LinearLayout(ctx);
                wrap.setOrientation(android.widget.LinearLayout.VERTICAL);
                // 背景跟着一起搬：原来菜单的深色圆角底放到外层，我们这行才会同底色
                try {
                    android.graphics.drawable.Drawable bg0 = clp != null ? null : null;
                    android.graphics.drawable.Drawable bgc = content.getBackground();
                    if (bgc == null) bgc = holder.getBackground();
                    if (bgc != null) {
                        wrap.setBackground(bgc);
                        content.setBackground(null);
                    }
                } catch (Throwable ignore) { }
                wrap.addView(content, new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT));
                android.widget.LinearLayout.LayoutParams rlp = new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                rlp.topMargin = -dp(ctx, 14);   // 负边距：压掉菜单底部的空白，视觉上融为一体
                wrap.addView(ourRow, rlp);
                wrapRef[0] = wrap;
                if (clp != null) holder.addView(wrap, idx, clp);
                else holder.addView(wrap, idx);
                holder.requestLayout();
                menuInjectCount.incrementAndGet();
                log("MENUINJ|wrapped");
            } else if (content != null) {
                content.addView(ourRow, new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT));
            }
        } catch (Throwable t) { log("MENUINJ|wrap err " + t); }
        rows.requestLayout();
        try {
            android.view.View rootAll = root.getRootView();
            java.util.ArrayList<android.view.View> dups = new java.util.ArrayList<android.view.View>();
            collectTagged(rootAll, "wxhOurRow", dups, 0);
            int keep = -1;
            for (int i = 0; i < dups.size(); i++) if (i == dups.size() - 1) keep = i;
            for (int i = 0; i < dups.size(); i++) {
                if (i == keep) continue;
                android.view.View d = dups.get(i);
                if (d == ourRow) continue;
                if (d.getParent() instanceof android.view.ViewGroup) {
                    ((android.view.ViewGroup) d.getParent()).removeView(d);
                    log("MENUINJ|dedup removed");
                }
            }
        } catch (Throwable ignore) { }
        root.post(new Runnable() {
            @Override public void run() {
                try {
                    // 从菜单真实绘制结果里取底色，做到完全一致
                    try {
                        if (root.getWidth() > 0 && root.getHeight() > 0) {
                            android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(
                                    root.getWidth(), root.getHeight(), android.graphics.Bitmap.Config.ARGB_8888);
                            android.graphics.Canvas cc = new android.graphics.Canvas(bm);
                            root.draw(cc);
                            int px = bm.getPixel(root.getWidth() / 2, Math.max(1, root.getHeight() / 2));
                            if (android.graphics.Color.alpha(px) > 200) {
                                android.graphics.drawable.GradientDrawable bgRow = new android.graphics.drawable.GradientDrawable();
                                bgRow.setColor(px);
                                float r = dp(ctx, 10);
                                bgRow.setCornerRadii(new float[]{0, 0, 0, 0, r, r, r, r});
                                ourRow.setBackground(bgRow);
                                log("MENUINJ|color=#" + Integer.toHexString(px));
                            }
                        }
                    } catch (Throwable ignore) { }
                    // 自动换行：每行 4 项，横竖都对齐（多了就加行）
                    try {
                        int totalChips = ourRow.getChildCount();
                        java.util.ArrayList<android.view.View> chips = new java.util.ArrayList<android.view.View>();
                        for (int i = 0; i < totalChips; i++) chips.add(ourRow.getChildAt(i));
                        ourRow.removeAllViews();
                        ourRow.setOrientation(android.widget.LinearLayout.VERTICAL);
                        // 精简模式：最多两行（10 项），超出收进「更多」，避免菜单过高盖住消息
                        try {
                            if (cfg().optBoolean("menuCompact", true) && chips.size() > 10) {
                                final java.util.ArrayList<android.view.View> overflow =
                                        new java.util.ArrayList<android.view.View>();
                                while (chips.size() > 9) overflow.add(chips.remove(9));
                                android.view.View more = makeChip(ctx, "\u22ef", "更多",
                                        new android.view.View.OnClickListener() {
                                            @Override public void onClick(android.view.View v) {
                                                try { pw.dismiss(); } catch (Throwable ignore) { }
                                                showMenuOverflow(ctx, overflow);
                                            }
                                        });
                                chips.add(more);
                                log("MENUINJ|compact overflow=" + overflow.size());
                            }
                        } catch (Throwable t) { log("MENUINJ|compact err " + t); }
                        int per = 5;                 // 与微信原生网格一致：每行 5 项
                        // 行高直接取微信原生菜单行的实测高度 —— 用户要求"对齐上面的就行"
                        // 行距固定 72dp：等于微信原生菜单相邻两行 top 差（实测 192px）
                        int cellH = dp(ctx, 72);
                        log("MENUINJ|rowH=" + cellH);
                        int rows = (chips.size() + per - 1) / per;
                        for (int startR = 0; startR < chips.size(); startR += per) {
                            android.widget.LinearLayout line = new android.widget.LinearLayout(ctx);
                            line.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                            line.setBaselineAligned(false);
                            line.setGravity(android.view.Gravity.START | android.view.Gravity.TOP);
                            int baseW = natW[0] > 0 ? natW[0] : dp(ctx, 300);
                            int cellW = (baseW - dp(ctx, 2)) / per;   // 与原生列距一致，整行靠左
                            for (int k = 0; k < per; k++) {
                                int idx = startR + k;
                                android.view.View cell = idx < chips.size() ? chips.get(idx)
                                        : new android.view.View(ctx);
                                android.widget.LinearLayout.LayoutParams lp =
                                        new android.widget.LinearLayout.LayoutParams(cellW, cellH);
                                lp.gravity = android.view.Gravity.TOP | android.view.Gravity.CENTER_HORIZONTAL;
                                cell.setLayoutParams(lp);
                                cell.setMinimumHeight(cellH);
                                if (cell instanceof android.widget.LinearLayout) {
                                    android.widget.LinearLayout c2 = (android.widget.LinearLayout) cell;
                                    c2.setGravity(android.view.Gravity.TOP | android.view.Gravity.CENTER_HORIZONTAL);
                                    if (c2.getChildCount() > 0 && c2.getChildAt(0) instanceof android.widget.TextView) {
                                        android.widget.TextView ic = (android.widget.TextView) c2.getChildAt(0);
                                        ic.setTextSize(18);
                                        android.view.ViewGroup.LayoutParams ilp = ic.getLayoutParams();
                                        if (ilp != null) {
                                            ilp.width = dp(ctx, 26);
                                            ilp.height = dp(ctx, 26);
                                            ic.setLayoutParams(ilp);
                                        }
                                        ic.setGravity(android.view.Gravity.CENTER);
                                    }
                                }
                                cell.setPadding(0, 0, dp(ctx, 1), 0);
                                line.addView(cell);
                            }
                            android.widget.LinearLayout.LayoutParams llp =
                                    new android.widget.LinearLayout.LayoutParams(
                                            android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                                            android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                            llp.bottomMargin = dp(ctx, 0);
                            ourRow.addView(line, llp);
                        }
                        ourRow.setPadding(0, 0, 0, dp(ctx, 14));
                        log("MENUINJ|grid " + chips.size() + "x" + rows);
                    } catch (Throwable ignore) { }
                    android.view.View target = wrapRef[0] != null ? wrapRef[0] : root;
                    int wpx = natW[0] > 0 ? natW[0] : 0;
                    if (wpx <= 0) wpx = pw.getWidth() > 0 ? pw.getWidth() : target.getWidth();
                    if (wpx <= 0) wpx = (int) (ctx.getResources().getDisplayMetrics().widthPixels * 0.86f);
                    target.measure(android.view.View.MeasureSpec.makeMeasureSpec(wpx, android.view.View.MeasureSpec.EXACTLY),
                            android.view.View.MeasureSpec.makeMeasureSpec(0, android.view.View.MeasureSpec.UNSPECIFIED));
                    int hpx = target.getMeasuredHeight();
                    if (hpx > 0) pw.update(wpx, hpx);
                    log("MENUINJ|resize w=" + wpx + " h=" + hpx + " wrap=" + (wrapRef[0] != null));
                    try { avoidCoveringAnchor(pw, target, menuAnchorView, wpx, hpx); }
                    catch (Throwable ignore) { }
                } catch (Throwable ignore) { }
            }
        });
        log("MENUINJ|added sameRow=" + sameRow + " n=" + rows.getChildCount());
    }



    /** 收集带指定 tag 的所有子视图 */
    private static void collectTagged(android.view.View v, String tag, java.util.List<android.view.View> out, int depth) {
        if (v == null || depth > 24) return;
        if (tag.equals(v.getTag())) out.add(v);
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) collectTagged(g.getChildAt(i), tag, out, depth + 1);
        }
    }

    /** 精简模式：被收进「更多」的功能，弹窗里排 3 列 */
    private static void showMenuOverflow(final android.content.Context ctx,
                                         final java.util.ArrayList<android.view.View> chips) {
        try {
            android.app.Activity a = (ctx instanceof android.app.Activity) ? (android.app.Activity) ctx
                    : (chatAct != null ? chatAct : lastAct);
            if (a == null) { toast("打开聊天页后再试"); return; }
            android.widget.LinearLayout grid = new android.widget.LinearLayout(ctx);
            grid.setOrientation(android.widget.LinearLayout.VERTICAL);
            int per = 3;
            for (int i = 0; i < chips.size(); i += per) {
                android.widget.LinearLayout line = new android.widget.LinearLayout(ctx);
                line.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                for (int k = 0; k < per; k++) {
                    int idx = i + k;
                    if (idx < chips.size()) {
                        android.view.View cell = chips.get(idx);
                        android.widget.LinearLayout.LayoutParams lp =
                                new android.widget.LinearLayout.LayoutParams(0, dp(ctx, 76), 1f);
                        cell.setLayoutParams(lp);
                        line.addView(cell);
                    } else {
                        line.addView(new android.view.View(ctx),
                                new android.widget.LinearLayout.LayoutParams(0, dp(ctx, 76), 1f));
                    }
                }
                grid.addView(line);
            }
            android.widget.ScrollView sv = new android.widget.ScrollView(ctx);
            sv.addView(grid);
            int maxH = Math.min(dp(ctx, 300),
                    (int) (ctx.getResources().getDisplayMetrics().heightPixels * 0.45f));
            android.widget.LinearLayout box = new android.widget.LinearLayout(ctx);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, maxH));
            new android.app.AlertDialog.Builder(a)
                    .setTitle("更多功能")
                    .setView(box)
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { log("MENUOVF|err " + t); }
    }

    /** 菜单避让：菜单盖住被长按的消息时，自动挪到消息上方/下方 */
    private static void avoidCoveringAnchor(final android.widget.PopupWindow pw, final android.view.View target,
                                            final android.view.View anchor, final int w, final int h) {
        if (anchor == null || target == null || w <= 0 || h <= 0) return;
        try { if (!cfg().optBoolean("menuAvoidMsg", true)) return; } catch (Throwable ignore) { }
        target.postDelayed(new Runnable() {
            @Override public void run() {
                try {
                    int[] tp = new int[2];
                    target.getLocationOnScreen(tp);
                    int[] ap = new int[2];
                    anchor.getLocationOnScreen(ap);
                    int gap = dp(target.getContext(), 8);
                    int aTop = ap[1], aBottom = ap[1] + anchor.getHeight();
                    int tTop = tp[1], tBottom = tp[1] + h;
                    if (tBottom <= aTop + gap || tTop >= aBottom - gap) {
                        log("MENUPOS|ok 无遮挡");
                        return;
                    }
                    int sh = target.getResources().getDisplayMetrics().heightPixels;
                    int above = aTop - gap;
                    int below = sh - aBottom - gap;
                    int newY;
                    if (above >= h) newY = aTop - h - gap;
                    else if (below >= h) newY = aBottom + gap;
                    else {
                        log("MENUPOS|无空间 above=" + above + " below=" + below + " h=" + h);
                        return;
                    }
                    if (newY < 0) newY = 0;
                    if (newY + h > sh) newY = Math.max(0, sh - h);
                    if (Math.abs(newY - tTop) < dp(target.getContext(), 4)) return;
                    pw.update(tp[0], newY, w, h);
                    log("MENUPOS|moved " + tTop + "->" + newY + " h=" + h);
                } catch (Throwable t) {
                    log("MENUPOS|err " + t);
                }
            }
        }, 90);
    }

    private static void installMenuProbe(ClassLoader app) {
        try {
            Class<?> dlg = Class.forName("android.app.Dialog", false, app);
            XposedBridge.hookAllMethods(dlg, "show", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (chatAct == null) return;
                        log("DLOG|" + p.thisObject.getClass().getName());
                    } catch (Throwable ignore) { }
                }
            });
            Class<?> pw = Class.forName("android.widget.PopupWindow", false, app);
            XposedBridge.hookAllMethods(pw, "showAtLocation", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (chatAct == null) return;
                        log("PLOG|" + p.thisObject.getClass().getName() + "|" + p.thisObject.getClass().getSuperclass().getName());
                    } catch (Throwable ignore) { }
                }
            });
            log("hooked menu probe");
        } catch (Throwable t) { log("probe err " + t); }
    }

    /** 接住取图结果 */
    private static void installAvatarResultHook(ClassLoader app) {
        try {
            XposedBridge.hookAllMethods(android.app.Activity.class, "onActivityResult", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (!(p.thisObject instanceof android.app.Activity)) return;
                        int req = (Integer) p.args[0];
                        if (req != REQ_GROUP_AVATAR) return;
                        handleGroupRowAvatarResult((android.app.Activity) p.thisObject,
                                req, (Integer) p.args[1], (android.content.Intent) p.args[2]);
                    } catch (Throwable ignore) { }
                }
            });
            log("GAV|result hook installed");
        } catch (Throwable t) { log("GAV|hook err " + t); }
    }

    private static void installLongPressAi(ClassLoader app) {
        try {
            Class<?> v = Class.forName("android.view.View", false, app);
            XposedBridge.hookAllMethods(v, "performLongClick", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        // 主界面长按右上角「＋」→ 打开 H 设置（唯一设置入口）
                        try {
                            Object o0 = p.thisObject;
                            if (o0 instanceof android.view.View) {
                                CharSequence cd0 = ((android.view.View) o0).getContentDescription();
                                android.app.Activity ta = topAct;
                                if (cd0 != null && cd0.toString().contains("更多功能")
                                        && ta != null && ta.getClass().getName().contains("LauncherUI")
                                        && !isInChatUi()) {
                                    p.setResult(Boolean.TRUE);
                                    showSettings(ta);
                                    log("ENTRY|longpress plus");
                                    return;
                                }
                            }
                        } catch (Throwable ignore) { }
                        android.app.Activity ca = chatAct;
                        if (ca == null) return;
                        // 聊天页长按右上角「…」→ 打开 H 设置
                        try {
                            Object o2 = p.thisObject;
                            if (o2 instanceof android.view.View) {
                                CharSequence cd2 = ((android.view.View) o2).getContentDescription();
                                String s2 = cd2 == null ? "" : cd2.toString();
                                if (s2.contains("更多功能") || s2.contains("更多")) {
                                    p.setResult(Boolean.TRUE);
                                    showSettings(ca);
                                    log("ENTRY|longpress chat more");
                                    return;
                                }
                            }
                        } catch (Throwable ignore) { }
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        android.view.View src = (android.view.View) o;
                        if (src instanceof android.widget.EditText) return;
                        if ("wxhAiChip".equals(src.getTag())) return;
                        // 长按主界面右上角「＋」→ 打开 H 设置（聊天页的「…」不接管）
                        try {
                            CharSequence cd = src.getContentDescription();
                            if (false && cd != null && cd.toString().contains("更多功能")
                                    && !isInChatUi()
                                    && topAct != null && topAct.getClass().getName().contains("LauncherUI")) {
                                p.setResult(Boolean.TRUE);
                                showSettings(topAct);
                                log("ENTRY|longpress plus");
                                return;
                            }
                        } catch (Throwable ignore) { }
                        // 长按聊天底部栏的表情/加号按钮 → 打开「我的图库」
                        try {
                            if (inChatFooter(src)) {
                                p.setResult(Boolean.TRUE);   // 吃掉长按，阻止微信自己弹菜单
                                openGalleryPanel(ca);
                                return;
                            }
                        } catch (Throwable ignore) { }
                        longPressCount.incrementAndGet();
                        // 先记录锚点：图片/表情没有文字，也必须记住长按的是哪个控件
                        try { lastLongPressView = new java.lang.ref.WeakReference<android.view.View>(src); } catch (Throwable ignore) { }
                        String t = renderedTextOf(src);
                        if (t == null || t.trim().length() == 0) t = findTextIn(src);
                        // 关键：先把时间戳定下来，再判断文字。
                        // 否则长按「公众号文章/文件卡片」这类超长或无文字的消息会提前 return，
                        // lastLongPressTs 一直是 0，伪赞/引用/转发到 就都提示「定位不到这条消息」。
                        try {
                            long ts0 = tsForPressedRow(src, t == null ? null : t.trim());
                            if (ts0 > 0 || lastLongPressTs <= 0) lastLongPressTs = ts0;
                            lastLongPressPfb = rowIndexFromBottomByContainment(src);
                            log("LP|ts=" + lastLongPressTs + " hasText=" + (t != null));
                        } catch (Throwable ignore) { }
                        if (t == null) return;
                        t = t.trim();
                        if (t.length() == 0) return;
                        if (t.length() > 400) t = t.substring(0, 400);
                        lastLongPressText = t;
                        lastLongPressAt = System.currentTimeMillis();
                        try { lastLongPressView = new java.lang.ref.WeakReference<android.view.View>(src); } catch (Throwable ignore) { }
                    } catch (Throwable ignore) { }
                }
            });
            log("hooked performLongClick (ai chip)");
        } catch (Throwable t) { log("aichip err " + t); }
    }

    private static void installContextMenuEdit(ClassLoader app) {
        try {
            Class<?> v = Class.forName("android.view.View", false, app);
            XposedBridge.hookAllMethods(v, "onCreateContextMenu", new XC_MethodHook() {
                @Override
                protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (p.args.length < 1 || !(p.args[0] instanceof android.view.ContextMenu)) return;
                        final android.view.ContextMenu menu = (android.view.ContextMenu) p.args[0];
                        final View src = (View) p.thisObject;
                        if (src instanceof android.widget.EditText) return;
                        android.content.Context ctx = src.getContext();
                        if (!(ctx instanceof android.app.Activity)) return;
                        final android.app.Activity act = (android.app.Activity) ctx;
                        if (menu.size() == 0) return;

                        // 长按消息 → AI 分析这条并给回复
                        try {
                            if (chatAct != null) {
                                String raw = findTextIn(src);
                                if (raw != null && raw.trim().length() > 0 && raw.length() < 500) {
                                    final String msg = raw.trim();
                                    menu.add("AI 分析这条").setOnMenuItemClickListener(
                                            new android.view.MenuItem.OnMenuItemClickListener() {
                                                @Override public boolean onMenuItemClick(android.view.MenuItem item) {
                                                    android.widget.EditText et2 = currentInput();
                                                    aiGenerate(act, et2, msg);
                                                    return true;
                                                }
                                            });
                                }
                            }
                        } catch (Throwable ignore) { }

                        // 长按消息 → 导出本会话媒体（快捷入口）
                        try {
                            if (cfg().optBoolean("msgMenuExport", false) && chatTalker != null
                                    && chatTalker.length() > 0 && act == chatAct) {
                                final String tk2 = chatTalker;
                                final String nm2 = displayOfTalker(tk2);
                                menu.add("导出本会话媒体").setOnMenuItemClickListener(
                                        new android.view.MenuItem.OnMenuItemClickListener() {
                                            @Override public boolean onMenuItemClick(android.view.MenuItem item) {
                                                showMediaExportTypes(act, tk2, nm2);
                                                return true;
                                            }
                                        });
                            }
                        } catch (Throwable ignore) { }

                        // 「改文字」已统一到消息菜单（改字），这里不再挂，避免找到别的控件文本
                    } catch (Throwable t) {
                    }
                }
            });
            log("hooked onCreateContextMenu (edit + ai)");
        } catch (Throwable t) {
            log("menu edit err " + t);
        }
    }

    /** 找控件子树里的第一段短文字 */
    private static String findTextIn(View v) {
        try {
            if (v instanceof android.widget.TextView) {
                CharSequence cs = ((android.widget.TextView) v).getText();
                if (cs != null && cs.length() > 0 && cs.length() <= 200) return cs.toString();
            }
            // 微信 MMNeat7extView：优先取它内部包裹的 TextView
            try {
                java.lang.reflect.Method mw = v.getClass().getMethod("getWrappedTextView");
                Object rw = mw.invoke(v);
                if (rw instanceof android.widget.TextView) {
                    CharSequence cw = ((android.widget.TextView) rw).getText();
                    if (cw != null && cw.length() > 0 && cw.length() <= 2000) return cw.toString();
                }
            } catch (Throwable ignore) { }
            if (v.getClass().getName().contains("Neat7ext")) {
                // 内部字段里可能直接放着 TextView 或 CharSequence
                Class<?> kk = v.getClass();
                while (kk != null && kk != Object.class) {
                    for (java.lang.reflect.Field ff : kk.getDeclaredFields()) {
                        try {
                            ff.setAccessible(true);
                            Object rv = ff.get(v);
                            if (rv instanceof android.widget.TextView) {
                                CharSequence cw2 = ((android.widget.TextView) rv).getText();
                                if (cw2 != null && cw2.length() > 0 && cw2.length() <= 2000) return cw2.toString();
                            }
                            if (ff.getType() == CharSequence.class && rv instanceof CharSequence) {
                                CharSequence cv = (CharSequence) rv;
                                if (cv.length() > 0 && cv.length() <= 2000) return cv.toString();
                            }
                        } catch (Throwable ignore) { }
                    }
                    kk = kk.getSuperclass();
                }
            }
            // 微信自绘文本控件（MMNeat7extView 等）：沿继承链找 getText / 文本字段
            Class<?> k = v.getClass();
            while (k != null && k != Object.class) {
                try {
                    for (java.lang.reflect.Method m : k.getDeclaredMethods()) {
                        if (!m.getName().equals("getText") && !m.getName().equals("getContent")
                                && !m.getName().equals("getRealText")) continue;
                        if (m.getParameterTypes().length != 0) continue;
                        m.setAccessible(true);
                        Object r = m.invoke(v);
                        if (r instanceof CharSequence) {
                            CharSequence cs2 = (CharSequence) r;
                            if (cs2.length() > 0 && cs2.length() <= 400) return cs2.toString();
                        }
                    }
                } catch (Throwable ignore) { }
                k = k.getSuperclass();
            }
            k = v.getClass();
            while (k != null && k != Object.class) {
                try {
                    for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                        String fn = f.getName().toLowerCase();
                        if (!fn.contains("text") && !fn.contains("content")) continue;
                        if (f.getType() != CharSequence.class && f.getType() != String.class) continue;
                        f.setAccessible(true);
                        Object r = f.get(v);
                        if (r instanceof CharSequence) {
                            CharSequence cs3 = (CharSequence) r;
                            if (cs3.length() > 0 && cs3.length() <= 400) return cs3.toString();
                        }
                    }
                } catch (Throwable ignore) { }
                k = k.getSuperclass();
            }
            try {
                CharSequence cd = v.getContentDescription();
                if (cd != null && cd.length() > 0 && cd.length() <= 200) {
                    String cds = cd.toString();
                    if (!cds.contains("ContentCapture") && !cds.startsWith("View.")) return cds;
                }
            } catch (Throwable ignore) { }
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    String r = findTextIn(g.getChildAt(i));
                    if (r != null) return r;
                }
            }
        } catch (Throwable t) {
        }
        return null;
    }

    /** 询问替换文本 */
    private static void askReplace(final android.app.Activity act, final String orig) {
        try {
            final android.widget.EditText et = new android.widget.EditText(act);
            et.setText(orig);
            et.setSelectAllOnFocus(true);
            new android.app.AlertDialog.Builder(act)
                    .setTitle("改成什么？")
                    .setMessage("原文：" + orig)
                    .setView(et)
                    .setPositiveButton("保存并生效", new android.content.DialogInterface.OnClickListener() {
                        @Override
                        public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                String neu = et.getText().toString();
                                if (neu.length() == 0 || neu.equals(orig)) return;
                                JSONObject o = readCfg();
                                org.json.JSONArray arr = o.optJSONArray("textReplace");
                                if (arr == null) arr = new org.json.JSONArray();
                                boolean found = false;
                                org.json.JSONArray out = new org.json.JSONArray();
                                for (int i = 0; i < arr.length(); i++) {
                                    String rule = arr.optString(i, "");
                                    if (rule.startsWith(orig + "=")) {
                                        found = true;
                                        out.put(orig + "=" + neu);
                                    } else {
                                        out.put(rule);
                                    }
                                }
                                if (!found) out.put(orig + "=" + neu);
                                liveRules.put(orig, neu);
                                o.put("textReplace", out);
                                writeCfg(o);
                                log("TXTREPL_SAVE|" + orig + "=" + neu + " n=" + out.length()
                                        + " fileLen=" + new File(DIR, "wxh_config.json").length());
                                applyReplaceNow(act, orig, neu);
                                toast("已替换（" + out.length() + "）");
                            } catch (Throwable t) {
                                log("TXTREPL_SAVE_ERR|" + t);
                                toast("保存失败：" + t);
                            }
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) {
        }
    }

    /** 立即把当前界面上的文字替换掉 */
    private static void applyReplaceNow(android.app.Activity act, String from, String to) {
        try {
            View root = act.getWindow().getDecorView();
            java.util.List<android.widget.TextView> all =
                    new java.util.ArrayList<android.widget.TextView>();
            collectTextViews(root, all, 0);
            int n = 0;
            for (android.widget.TextView tv : all) {
                CharSequence cs = tv.getText();
                if (cs == null) continue;
                String cur = cs.toString();
                if (cur.equals(from) || cur.trim().equals(from.trim())) {
                    tv.setText(to);
                    n++;
                }
            }
            log("REPLACE|done n=" + n);
        } catch (Throwable t) {
            log("REPLACE|err " + t);
        }
    }

    private static void collectTextViews(View v, java.util.List<android.widget.TextView> out, int d) {
        try {
            if (d > 20) return;
            if (v instanceof android.widget.TextView) out.add((android.widget.TextView) v);
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) collectTextViews(g.getChildAt(i), out, d + 1);
            }
        } catch (Throwable t) {
        }
    }

    /** 编辑替换规则（原=新） */
    private static void editReplaceRules(final android.app.Activity a) {
        try {
            final android.widget.EditText et = new android.widget.EditText(a);
            et.setText(joinArr(cfg().optJSONArray("textReplace")));
            et.setHint("原文=新文本（每行一条）");
            et.setMinLines(4);
            new android.app.AlertDialog.Builder(a)
                    .setTitle("文本替换规则")
                    .setMessage("每行一条，格式：原文=新文本\n精确匹配，改完立即生效")
                    .setView(et)
                    .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                        @Override
                        public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                JSONObject o = readCfg();
                                org.json.JSONArray arr = new org.json.JSONArray();
                                for (String line : et.getText().toString().split("\\n")) {
                                    if (line.trim().length() > 0) arr.put(line.trim());
                                }
                                o.put("textReplace", arr);
                                writeCfg(o);
                                toast("已保存 " + arr.length() + " 条规则");
                            } catch (Throwable t) {
                                toast("保存失败");
                            }
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) {
        }
    }

    private static void installLongPressEdit(ClassLoader app) {
        try {
            // 微信长按文字走 startActionMode，不是 performLongClick
            Class<?> tvCls = Class.forName("android.widget.TextView", false, app);
            XposedBridge.hookAllMethods(tvCls, "startActionMode", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("textEditMode", false)) return;
                        Object o = p.thisObject;
                        if (!(o instanceof android.widget.TextView)) return;
                        final android.widget.TextView tv = (android.widget.TextView) o;
                        CharSequence cs = tv.getText();
                        if (cs == null || cs.length() == 0 || cs.length() > 200) return;
                        final String orig = cs.toString();
                        android.content.Context ctx = tv.getContext();
                        if (!(ctx instanceof android.app.Activity)) return;
                        final android.app.Activity act = (android.app.Activity) ctx;
                        act.runOnUiThread(new Runnable() {
                            @Override
                            public void run() {
                                askReplace(act, orig);
                            }
                        });
                    } catch (Throwable t) {
                    }
                }
            });
            log("hooked TextView.startActionMode (edit)");
            Class<?> v = Class.forName("android.view.View", false, app);
            XposedBridge.hookAllMethods(v, "performLongClick", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("textEditMode", false)) return;
                        Object o = p.thisObject;
                        if (!(o instanceof android.widget.TextView)) return;
                        final android.widget.TextView tv = (android.widget.TextView) o;
                        CharSequence cs = tv.getText();
                        if (cs == null || cs.length() == 0 || cs.length() > 200) return;
                        final String orig = cs.toString();
                        android.content.Context ctx = tv.getContext();
                        if (!(ctx instanceof android.app.Activity)) return;
                        final android.app.Activity act = (android.app.Activity) ctx;
                        p.setResult(Boolean.TRUE);
                        act.runOnUiThread(new Runnable() {
                            @Override
                            public void run() {
                                try {
                                    final android.widget.EditText et = new android.widget.EditText(act);
                                    et.setText(orig);
                                    et.setSelectAllOnFocus(true);
                                    new android.app.AlertDialog.Builder(act)
                                            .setTitle("改成什么？")
                                            .setMessage("原文：" + orig)
                                            .setView(et)
                                            .setPositiveButton("保存并生效", new android.content.DialogInterface.OnClickListener() {
                                                @Override
                                                public void onClick(android.content.DialogInterface d, int w) {
                                                    try {
                                                        String neu = et.getText().toString();
                                                        if (neu.length() == 0 || neu.equals(orig)) return;
                                                        JSONObject o = readCfg();
                                                        org.json.JSONArray arr = o.optJSONArray("textReplace");
                                                        if (arr == null) arr = new org.json.JSONArray();
                                                        boolean found = false;
                                                        for (int i = 0; i < arr.length(); i++) {
                                                            String rule = arr.optString(i, "");
                                                            if (rule.startsWith(orig + "=")) {
                                                                arr.put(i, orig + "=" + neu);
                                                                found = true;
                                                                break;
                                                            }
                                                        }
                                                        if (!found) arr.put(orig + "=" + neu);
                                                        o.put("textReplace", arr);
                                                        writeCfg(o);
                                                        cfgAt = 0;
                                                        tv.setText(neu);
                                                        log("TXTLONG|" + orig + "->" + neu);
                                                        toast("已替换并保存");
                                                    } catch (Throwable t) {
                                                        toast("保存失败");
                                                    }
                                                }
                                            })
                                            .setNegativeButton("取消", null)
                                            .show();
                                } catch (Throwable t) {
                                }
                            }
                        });
                    } catch (Throwable t) {
                    }
                }
            });
            log("hooked long press edit");
        } catch (Throwable t) {
            log("longPressEdit err " + t);
        }
    }

    /** 文本替换：修改界面上任意文字 */
    private static void installTextReplace(ClassLoader app) {
        try {
            Class<?> tv = Class.forName("android.widget.TextView", false, app);
            XposedBridge.hookAllMethods(tv, "setText", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        org.json.JSONArray rules = cfg().optJSONArray("textReplace");
                        if (rules == null || rules.length() == 0) return;
                        Object a0 = p.args != null && p.args.length > 0 ? p.args[0] : null;
                        if (!(a0 instanceof CharSequence)) return;
                        String txt = a0.toString();
                        for (int i = 0; i < rules.length(); i++) {
                            String rule = rules.optString(i, "");
                            int eq = rule.indexOf('=');
                            if (eq <= 0) continue;
                            String from = rule.substring(0, eq);
                            String to = rule.substring(eq + 1);
                            if (txt.equals(from)) {
                                p.args[0] = to;
                                log("TXTREPL|" + from + "->" + to);
                                return;
                            }
                        }
                    } catch (Throwable t) {
                    }
                }
            });
            log("hooked TextView.setText (replace)");
            // 聊天气泡是 MMNeat7extView（不是 TextView），必须单独钩它的两个设文本方法
            try {
                Class<?> neat = Class.forName("com.tencent.mm.ui.widget.MMNeat7extView", false, app);
                XC_MethodHook neatHook = new XC_MethodHook() {
                    @Override protected void beforeHookedMethod(MethodHookParam p) {
                        try {
                            Object a0 = p.args != null && p.args.length > 0 ? p.args[0] : null;
                            if (!(a0 instanceof CharSequence)) return;
                            String txt = a0.toString();
                            // 记下真实文本，供长按菜单取值（避免误抓 contentDescription）
                            if (p.thisObject instanceof android.view.View) {
                                try { ((android.view.View) p.thisObject).setTag(0x0f0f0f05, txt); } catch (Throwable ignore) { }
                            }
                            String liveTo = liveReplace(txt);
                            if (liveTo != null) {
                                p.args[0] = liveTo;
                                try { ((android.view.View) p.thisObject).setTag(0x0f0f0f05, liveTo); } catch (Throwable ignore) { }
                                log("TXTREPL|" + txt + "->" + liveTo);
                                return;
                            }
                            org.json.JSONArray rules = cfg().optJSONArray("textReplace");
                            if (rules == null || rules.length() == 0) return;
                            for (int i = 0; i < rules.length(); i++) {
                                String rule = rules.optString(i, "");
                                int eq = rule.indexOf('=');
                                if (eq <= 0) continue;
                                if (txt.equals(rule.substring(0, eq))) {
                                    String to = rule.substring(eq + 1);
                                    p.args[0] = to;
                                    if (p.thisObject instanceof android.view.View) {
                                        try { ((android.view.View) p.thisObject).setTag(0x0f0f0f05, to); } catch (Throwable ignore) { }
                                    }
                                    log("TXTREPL|" + txt + "->" + to);
                                    return;
                                }
                            }
                        } catch (Throwable ignore) { }
                    }
                };
                XposedBridge.hookAllMethods(neat, "b", neatHook);
                XposedBridge.hookAllMethods(neat, "c", neatHook);
                log("hooked MMNeat setText (replace)");
            } catch (Throwable ignore) { }
        } catch (Throwable t) {
            log("textReplace err " + t);
        }
    }


    /** 读取联系人（username + 显示名），使用 g9.r 的查询接口 */
    private static java.util.List<String[]> loadContacts() {
        java.util.List<String[]> out = new java.util.ArrayList<String[]>();
        try {
            java.util.List<Object[]> rows = queryRows(
                    "select username, ifnull(conRemark,''), ifnull(nickname,'') from rcontact"
                            + " where type not in (4,33,256) and username not like '%@chatroom'"
                            + " and username not like 'gh_%'", 3);
            for (Object[] r : rows) {
                if (r == null || r[0] == null) continue;
                String u = String.valueOf(r[0]);
                if (u.length() == 0) continue;
                String rk = r[1] == null ? "" : String.valueOf(r[1]).trim();
                String nk = r[2] == null ? "" : String.valueOf(r[2]).trim();
                String disp = rk.length() > 0 ? rk : (nk.length() > 0 ? nk : u);
                out.add(new String[]{u, disp});
            }
            log("CONTACTS|n=" + out.size());
        } catch (Throwable t) {
            log("CONTACTS|err " + t);
        }
        return out;
    }

    /** talker -> 显示名 */
    private static String displayOfTalker(String talker) {
        try {
            if (talker == null) return "";
            Object handle = msgDbHandle();
            if (handle == null) return talker;
            Object cur = handle.getClass().getMethod("B", String.class, String[].class)
                    .invoke(handle, "select conRemark,nickname from rcontact where username=? limit 1",
                            new String[]{talker});
            if (cur == null) return talker;
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
            String out = talker;
            if ((Boolean) mv.invoke(cur)) {
                String r = (String) gs.invoke(cur, 0);
                String n = (String) gs.invoke(cur, 1);
                if (r != null && r.length() > 0) out = r;
                else if (n != null && n.length() > 0) out = n;
            }
            try {
                cur.getClass().getMethod("close").invoke(cur);
            } catch (Throwable t) {
            }
            return out;
        } catch (Throwable t) {
            return talker;
        }
    }


    private static final java.util.Map<String, Integer> zombieResult =
            new java.util.concurrent.ConcurrentHashMap<String, Integer>();
    private static final java.util.Map<String, java.util.concurrent.CountDownLatch> zombieWait =
            new java.util.concurrent.ConcurrentHashMap<String, java.util.concurrent.CountDownLatch>();
    private static volatile boolean zombieScanning = false;
    private static int notifyId = 9001;

    /** 转账预检：静默判断是否还是好友（对方无感知） */
    private static void installZombieHook(ClassLoader app) {
        try {
            Class<?> c = Class.forName("com.tencent.mm.plugin.remittance.model.i", false, app);
            XposedBridge.hookAllMethods(c, "H", new XC_MethodHook() {
                @Override
                protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        String user = zCurUser;
                        if (user == null) return;
                        Object[] a = p.args;
                        int errType = (a.length > 0 && a[0] instanceof Integer) ? (Integer) a[0] : -1;
                        int errCode = (a.length > 1 && a[1] instanceof Integer) ? (Integer) a[1] : -1;
                        String text = (a.length > 3 && a[3] != null) ? String.valueOf(a[3]) : "";
                        int flag = zJudge(errType, errCode, text);
                        zombieResult.put(user, flag);
                        java.util.concurrent.CountDownLatch l = zombieWait.get(user);
                        if (l != null) l.countDown();
                        log("ZOMBIE|" + user + "|" + flag + "|t=" + errType + "," + errCode + "|" + text);
                    } catch (Throwable t) {
                    }
                }
            });
            try {
                Class<?> n1c = Class.forName("com.tencent.mm.modelbase.n1", false, app);
                XposedBridge.hookAllMethods(n1c, "dispatch", new XC_MethodHook() {
                    @Override protected void beforeHookedMethod(MethodHookParam p) {
                        try {
                            if (p.args != null && p.args.length > 0 && p.args[0] != null) {
                                if (zNetwork == null) log("ZNET|got " + p.args[0].getClass().getName());
                                zNetwork = p.args[0];
                            }
                        } catch (Throwable ignore) { }
                    }
                });
                log("ZNET|hooked dispatch");
            } catch (Throwable t) { log("ZNET|err " + t); }

            log("hooked zombie probe");
        } catch (Throwable t) {
            log("zombie hook err " + t);
        }
    }

    /** 发一个转账预检场景 */
    private static void dumpNetApi() {
        try {
            Class<?> c = Class.forName("w41.i9", false, appCl);
            StringBuilder sb = new StringBuilder("NETAPI|w41.i9:");
            for (java.lang.reflect.Method m : c.getMethods()) {
                if (m.getParameterTypes().length <= 1) {
                    sb.append(m.getName()).append('(');
                    for (Class<?> pt : m.getParameterTypes()) sb.append(pt.getSimpleName());
                    sb.append(")->").append(m.getReturnType().getSimpleName()).append(' ');
                }
                if (sb.length() > 800) break;
            }
            log(sb.toString());
            Object q = c.getMethod("e").invoke(null);
            StringBuilder sb2 = new StringBuilder("NETAPI|queue=" + q.getClass().getName() + ":");
            for (java.lang.reflect.Method m : q.getClass().getMethods()) {
                if (m.getName().length() <= 2) {
                    sb2.append(m.getName()).append('(');
                    for (Class<?> pt : m.getParameterTypes()) sb2.append(pt.getSimpleName());
                    sb2.append(") ");
                }
                if (sb2.length() > 600) break;
            }
            log(sb2.toString());
        } catch (Throwable t) {
            log("NETAPI|err " + t);
        }
    }

    /** 检查转账检测依赖的类在 8.0.80 上是否还存在 */
    private static String zombieDepCheck() {
        String[] cls = {
                "com.tencent.mm.plugin.remittance.model.i",
                "com.tencent.mm.plugin.remittance.ui.RemittanceUI",
                "w41.i9",
                "com.tencent.mm.modelbase.n1"
        };
        StringBuilder sb = new StringBuilder();
        for (String c : cls) {
            boolean ok = false;
            try { Class.forName(c, false, appCl); ok = true; } catch (Throwable ignore) { }
            sb.append(c.substring(c.lastIndexOf('.') + 1)).append(ok ? "✓ " : "✗ ");
        }
        return sb.toString();
    }

    /** 正在检测的好友（供回调取用） */
    private static volatile String zCurUser = null;
    /** 缓存找到的场景队列实例 */
    private static volatile Object zQueue = null;
    private static volatile Object zNetwork = null;
    private static final java.util.concurrent.atomic.AtomicBoolean zQueueProbing =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    /** 运行时定位 NetSceneQueue：枚举 w41.* 下的类，找返回 t0 接口的静态无参方法 */
    private static Object sceneQueue() {
        Object cached = zQueue;
        if (cached != null) return cached;
        try {
            final Class<?> t0 = Class.forName("com.tencent.mm.modelbase.t0", false, appCl);
            StringBuilder tried = new StringBuilder();
            for (int pass = 0; pass < 3 && zQueue == null; pass++) {
                String[] names;
                if (pass == 0) {
                    names = new String[]{"a","b","c","d","e","f","g","h","i","j","k","l","m",
                            "n","o","p","q","r","s","t","u","v","w","x","y","z"};
                } else if (pass == 1) {
                    names = new String[260];
                    int k = 0;
                    for (char c = 'a'; c <= 'z'; c++)
                        for (int d = 0; d <= 9; d++) names[k++] = "" + c + d;
                } else {
                    names = new String[676];
                    int k = 0;
                    for (char c = 'a'; c <= 'z'; c++)
                        for (char d = 'a'; d <= 'z'; d++) names[k++] = "" + c + d;
                }
                for (String nm : names) {
                    Class<?> c;
                    try { c = Class.forName("w41." + nm, false, appCl); }
                    catch (Throwable e) { continue; }
                    for (java.lang.reflect.Method m : c.getDeclaredMethods()) {
                        if (!java.lang.reflect.Modifier.isStatic(m.getModifiers())) continue;
                        if (m.getParameterTypes().length != 0) continue;
                        if (!t0.isAssignableFrom(m.getReturnType())) continue;
                        try {
                            m.setAccessible(true);
                            Object v = m.invoke(null);
                            if (v != null && t0.isInstance(v)) {
                                zQueue = v;
                                log("ZSCAN|queue=" + c.getName() + "." + m.getName()
                                        + " impl=" + v.getClass().getName());
                                return v;
                            }
                        } catch (Throwable ignore) { }
                    }
                    tried.append(nm).append(',');
                }
            }
            log("ZSCAN|queue not found, tried=" + tried.length());
        } catch (Throwable t) { log("ZSCAN|queue err " + t); }
        return zQueue;
    }

    /** 发一个转账预检场景：直接调 NetScene 的 doScene，无需自己找队列 */
    private static boolean sendBeforeTransfer(String user) {
        try {
            Class<?> sc = Class.forName("com.tencent.mm.plugin.remittance.model.i", false, appCl);
            Object scene = sc.getConstructor(String.class, String.class).newInstance(user, "");
            Class<?> n1 = Class.forName("com.tencent.mm.modelbase.n1", false, appCl);
            Object network = zNetwork;
            if (network == null) {
                try { network = n1.getMethod("dispatcher").invoke(scene); } catch (Throwable ignore) { }
            }
            if (network == null) { log("SEND_Z|no network"); return false; }
            Class<?> sCls = Class.forName("com.tencent.mm.network.s", false, appCl);
            Class<?> u0 = Class.forName("com.tencent.mm.modelbase.u0", false, appCl);
            java.lang.reflect.Method ds = n1.getMethod("doScene", sCls, u0);
            zCurUser = user;
            Object r = ds.invoke(scene, network, null);
            log("SEND_Z|doScene=" + r);
            return true;
        } catch (Throwable t) {
            log("SEND_Z|err " + t);
            return false;
        }
    }

    /** 进度通知 */
    private static void zombieNotify(android.content.Context ctx, int done, int total, boolean fin) {
        try {
            android.app.NotificationManager nm = (android.app.NotificationManager)
                    ctx.getSystemService(android.content.Context.NOTIFICATION_SERVICE);
            if (android.os.Build.VERSION.SDK_INT >= 26) {
                android.app.NotificationChannel ch = new android.app.NotificationChannel(
                        "wxh_zombie2", "僵尸粉检测进度", android.app.NotificationManager.IMPORTANCE_DEFAULT);
                ch.setSound(null, null);
                ch.enableVibration(false);
                ch.setShowBadge(false);
                nm.createNotificationChannel(ch);
            }
            android.app.Notification.Builder b = (android.os.Build.VERSION.SDK_INT >= 26)
                    ? new android.app.Notification.Builder(ctx, "wxh_zombie2")
                    : new android.app.Notification.Builder(ctx);
            b.setSmallIcon(android.R.drawable.stat_notify_sync)
                    .setContentTitle(fin ? "僵尸粉检测完成" : "正在检测僵尸粉")
                    .setContentText(done + " / " + total + "   僵尸 " + zDeadCount
                            + (zPaused ? "（已暂停）" : ""))
                    .setOngoing(!fin)
                    .setOnlyAlertOnce(true)
                    .setProgress(Math.max(total, 1), done, false);
            nm.notify(notifyId, b.build());
        } catch (Throwable t) {
        }
    }



    // ===================== 僵尸粉检测面板 =====================
    private static final java.util.Map<String, Integer> zombieMap =
            new java.util.LinkedHashMap<String, Integer>();
    private static android.app.Dialog zDlg = null;
    private static android.widget.TextView zStat = null;
    private static android.widget.ListView zList = null;
    private static java.util.List<String[]> zContacts = null;
    private static final java.util.LinkedHashSet<String> zSel = new java.util.LinkedHashSet<String>();
    private static int zFilter = 0;   // 0=全部 1=只看僵尸 2=只看未检测
    private static volatile boolean zPaused = false;
    private static volatile int zDeadCount = 0;
    private static android.widget.TextView zPauseBtn = null;
    private static String zQuery = "";
    private static android.widget.BaseAdapter zAdapter = null;
    private static final java.util.List<String[]> zShown = new java.util.ArrayList<String[]>();

    private static void zSave() {
        try {
            JSONObject o = readCfg();
            JSONObject m = new JSONObject();
            for (java.util.Map.Entry<String, Integer> e : zombieMap.entrySet()) m.put(e.getKey(), e.getValue());
            o.put("zombieMap", m);
            writeCfg(o);
            cfg = null; cfgAt = 0;
        } catch (Throwable ignore) { }
    }

    private static void zLoad() {
        try {
            zombieMap.clear();
            JSONObject m = cfg().optJSONObject("zombieMap");
            if (m != null) {
                java.util.Iterator<String> it = m.keys();
                while (it.hasNext()) { String k = it.next(); zombieMap.put(k, m.optInt(k, 0)); }
            }
        } catch (Throwable ignore) { }
    }

    private static String zStateText(Integer v) {
        if (v == null) return "未检测";
        if (v == 1) return "僵尸粉";
        if (v == 0) return "正常";
        return "未知";
    }

    private static int zStateColor(Integer v) {
        if (v == null) return 0xFF9A9AA2;
        if (v == 1) return 0xFF07C160;
        if (v == 0) return 0xFF1DA462;
        return 0xFFB08A00;
    }

    private static void zRebuild() {
        try {
            if (zAdapter == null || zContacts == null) return;
            zShown.clear();
            String q = zQuery == null ? "" : zQuery.trim().toLowerCase();
            int known = 0, dead = 0;
            for (String[] c : zContacts) {
                String u = c[0], name = c[1];
                Integer st = zombieMap.get(u);
                if (st != null) known++;
                if (st != null && st == 1) dead++;
                if (zFilter == 1 && (st == null || st != 1)) continue;
                if (zFilter == 2 && st != null) continue;
                if (zFilter == 3 && (st == null || st != -1)) continue;
                if (q.length() > 0 && !name.toLowerCase().contains(q) && !u.toLowerCase().contains(q)) continue;
                zShown.add(c);
            }
            zAdapter.notifyDataSetChanged();
            if (zStat != null) {
                int unknown = zContacts.size() - known;
                int unk = known - dead;
                String s1 = "好友 " + zContacts.size();
                String s2 = "僵尸 " + dead;
                String s3 = "未知 " + unk;
                String s4 = "未检测 " + unknown;
                String full = s1 + " · " + s2 + " · " + s3 + " · " + s4;
                android.text.SpannableString ss = new android.text.SpannableString(full);
                final int[] bounds = new int[]{
                        0, s1.length(),
                        s1.length() + 3, s1.length() + 3 + s2.length(),
                        s1.length() + 3 + s2.length() + 3,
                        s1.length() + 3 + s2.length() + 3 + s3.length(),
                        s1.length() + 3 + s2.length() + 3 + s3.length() + 3, full.length()};
                for (int k = 0; k < 4; k++) {
                    final int fk = k;
                    ss.setSpan(new android.text.style.ClickableSpan() {
                        @Override public void onClick(android.view.View v) {
                            zFilter = fk == 0 ? 0 : (fk == 1 ? 1 : (fk == 2 ? 3 : 2));
                            zRebuild();
                        }
                        @Override public void updateDrawState(android.text.TextPaint tp) {
                            int col = (fk == 0 && zFilter == 0) || (fk == 1 && zFilter == 1)
                                    || (fk == 2 && zFilter == 3) || (fk == 3 && zFilter == 2)
                                    ? 0xFF07C160 : 0xFF7A7A85;
                            tp.setColor(col);
                            tp.setUnderlineText(false);
                        }
                    }, bounds[k * 2], bounds[k * 2 + 1], android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
                }
                zStat.setText(ss);
                zStat.setMovementMethod(android.text.method.LinkMovementMethod.getInstance());
            }
        } catch (Throwable t) { log("ZP|rebuild " + t); }
    }

    private static void zOpenChat(final android.app.Activity a, String wxid) {
        try {
            android.content.Intent it = new android.content.Intent();
            it.setClassName(a.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
            it.putExtra("Chat_User", resolveTalker(wxid));
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK
                    | android.content.Intent.FLAG_ACTIVITY_CLEAR_TOP
                    | android.content.Intent.FLAG_ACTIVITY_SINGLE_TOP);
            if (zDlg != null) zDlg.dismiss();
            android.content.Intent _csw = prepareChatSwitch(a, it);
            if (_csw != null) a.startActivity(_csw);
        } catch (Throwable t) { toast("打不开聊天: " + t); }
    }

    private static void zScanTargets(final android.app.Activity a, final java.util.List<String> targets) {
        if (zombieScanning) { toast("正在扫描中…"); return; }
        if (!zombieSupported()) { zombieFallback(a); return; }
        zombieScanning = true;
        zPaused = false;
        zDeadCount = 0;
        if (zPauseBtn != null) zPauseBtn.setText("暂停");
        toast("开始检测 " + targets.size() + " 人…");
        new Thread(new Runnable() {
            @Override public void run() {
                final android.content.Context nctx = a.getApplicationContext();
                int done = 0, dead = 0;
                zombieNotify(nctx, 0, targets.size(), false);
                try {
                    for (String u : targets) {
                        while (zPaused && zombieScanning) {
                            try { Thread.sleep(200); } catch (Throwable ignore) { }
                        }
                        if (!zombieScanning) break;
                        java.util.concurrent.CountDownLatch l = new java.util.concurrent.CountDownLatch(1);
                        zombieWait.put(u, l);
                        if (!sendBeforeTransfer(u)) { zombieWait.remove(u); continue; }
                        try { l.await(3, java.util.concurrent.TimeUnit.SECONDS); } catch (Throwable ignore) { }
                        zombieWait.remove(u);
                        Integer r = zombieResult.get(u);
                        if (r != null && r == 1) {
                            // 判为僵尸：隔 1.5 秒再确认一次，两次都僵尸才确认
                            try { Thread.sleep(600); } catch (Throwable ignore) { }
                            java.util.concurrent.CountDownLatch l2 = new java.util.concurrent.CountDownLatch(1);
                            zombieWait.put(u, l2);
                            zombieResult.remove(u);
                            if (sendBeforeTransfer(u)) {
                                try { l2.await(3, java.util.concurrent.TimeUnit.SECONDS); } catch (Throwable ignore) { }
                            }
                            zombieWait.remove(u);
                            Integer r2 = zombieResult.get(u);
                            if (r2 != null && r2 == 1) { r = 1; }
                            else if (r2 != null && r2 == 0) { r = 0; }
                            else { r = -1; }
                            log("ZCONF|" + u + "|" + (r == 1 ? "confirmed" : "changed=" + r));
                        }
                        zombieMap.put(u, r == null ? -1 : r);
                        done++;
                        if (r != null && r == 1) dead++;
                        zDeadCount = dead;
                        zombieNotify(nctx, done, targets.size(), false);
                        if (done % 3 == 0) {
                            zSave();
                            a.runOnUiThread(new Runnable() {
                                @Override public void run() { zRebuild(); }
                            });
                        }
                        try { Thread.sleep(400); } catch (Throwable ignore) { }
                    }
                } catch (Throwable t) { log("ZP|scan " + t); }
                finally {
                    zombieScanning = false;
                    zSave();
                    zombieNotify(a.getApplicationContext(), done, done, true);
                    final int fd = done, fdead = dead;
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            zRebuild();
                            toast("检测完成：本次 " + fd + " 人，僵尸 " + fdead + " 人");
                        }
                    });
                }
            }
        }).start();
    }

    private static void zSelectedChat() {
        try {
            org.json.JSONArray arr = cfg().optJSONArray("zombieSel");
            if (arr != null) for (int i = 0; i < arr.length(); i++) zSel.add(arr.optString(i));
        } catch (Throwable ignore) { }
    }

    /** 静默检测依赖的微信内部类是否可用（版本变化后可能不存在） */
    private static boolean zombieSupported() {
        try {
            Class<?> sc = Class.forName("com.tencent.mm.plugin.remittance.model.i", false, appCl);
            Class<?> n1 = Class.forName("com.tencent.mm.modelbase.n1", false, appCl);
            Class<?> sCls = Class.forName("com.tencent.mm.network.s", false, appCl);
            Class<?> u0 = Class.forName("com.tencent.mm.modelbase.u0", false, appCl);
            n1.getMethod("dispatcher");
            n1.getMethod("doScene", sCls, u0);
            sc.getConstructor(String.class, String.class);
            return true;
        } catch (Throwable t) {
            log("ZSCAN|deps missing " + t);
            return false;
        }
    }

    /** 降级方案：按最后互动时间列出可能断联的好友 */
    private static void zombieFallback(final android.app.Activity a) {
        toast("当前微信版本不支持静默检测，改为按互动时间分析");
        new Thread(new Runnable() {
            @Override public void run() {
                StringBuilder sb = new StringBuilder();
                try {
                    long now = System.currentTimeMillis();
                    java.util.List<Object[]> rows = queryRows(
                            "select talker, max(createTime) as t from message"
                                    + " where talker not like '%@chatroom'"
                                    + " group by talker order by t asc limit 120", 2);
                    long maxCt = 0;
                    for (Object[] r : rows) {
                        try { maxCt = Math.max(maxCt, Long.parseLong(String.valueOf(r[1]).trim())); }
                        catch (Throwable ignore) { }
                    }
                    boolean msUnit = maxCt > 100000000000L;
                    int shown = 0;
                    for (Object[] r : rows) {
                        if (shown >= 50) break;
                        String tk = String.valueOf(r[0]);
                        long t = 0;
                        try { t = Long.parseLong(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                        long tMs = msUnit ? t : t * 1000L;
                        long days = tMs > 0 ? (now - tMs) / 86400000L : -1;
                        if (days < 30) continue;
                        String nm = resolveName(tk);
                        if (nm == null || nm.equals(tk)) continue;
                        sb.append(days).append(" 天未聊   ").append(nm).append('\n');
                        shown++;
                    }
                    if (sb.length() == 0) sb.append("没有超过 30 天未互动的好友");
                    else sb.insert(0, "超过 30 天没有互动的单向好友（仅供参考）\n\n");
                } catch (Throwable t) { sb.append("分析失败: ").append(t); }
                final String out = sb.toString();
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        android.widget.TextView tv = new android.widget.TextView(a);
                        tv.setText(out);
                        tv.setTextSize(13);
                        tv.setTextColor(0xFF333333);
                        tv.setPadding(dp(a, 16), dp(a, 14), dp(a, 16), dp(a, 14));
                        android.widget.ScrollView sv = new android.widget.ScrollView(a);
                        sv.addView(tv);
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("疑似断联好友")
                                .setView(sv)
                                .setPositiveButton("关闭", null)
                                .show();
                    }
                });
            }
        }).start();
    }

    /** 静默扫描僵尸粉 */
    private static void startZombieScan(final android.app.Activity a) {
        startZombieScan(a, null);
    }

    private static void startZombieScan(final android.app.Activity a, final java.util.List<String> preset) {
        if (zombieScanning) {
            toast("正在扫描中…");
            return;
        }
        final android.content.Context ctx = a.getApplicationContext();
        zombieScanning = true;
        zombieResult.clear();
        new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    java.util.List<String> targets = new java.util.ArrayList<String>();
                    if (preset != null && !preset.isEmpty()) {
                        targets.addAll(preset);
                    } else {
                        java.util.List<String[]> cs = loadContacts();
                        for (String[] c : cs) {
                            if (c[0].length() > 0 && !c[0].endsWith("@chatroom")) targets.add(c[0]);
                        }
                    }
                    int total = targets.size();
                    log("ZSCAN|deps " + zombieDepCheck());
                    log("ZSCAN|start total=" + total);
                    int done = 0;
                    for (String u : targets) {
                        if (!zombieScanning) break;
                        // 用已验证的转账场景（r0 + onGYNetEnd 回调）发一次预检：
                        // 旧路径 n1.doScene/NetSceneQueue 在 8.0.x 上已经找不到入口，会一直「queue not found」
                        String rr = zombieProbeWait(u);
                        int flagZ = rr == null ? -1 : (rr.contains("僵尸") ? 1 : (rr.contains("正常") ? 0 : -1));
                        zombieResult.put(u, flagZ);
                        done++;
                        zombieNotify(ctx, done, total, false);
                        try {
                            Thread.sleep(cfg().optBoolean("zombieFast", false) ? 800L : 1500L);
                        } catch (Throwable t) {
                        }
                    }
                    java.util.List<String> dead = new java.util.ArrayList<String>();
                    for (java.util.Map.Entry<String, Integer> e : zombieResult.entrySet()) {
                        if (e.getValue() == 1) dead.add(e.getKey());
                    }
                    StringBuilder sb = new StringBuilder();
                    sb.append("扫描 ").append(done).append(" 人，疑似非好友 ")
                            .append(dead.size()).append(" 人\n");
                    for (String d : dead) sb.append(d).append("  ").append(displayOfTalker(d)).append("\n");
                    zombieNotify(ctx, total, total, true);
                    final String txt = sb.toString();
                    log("ZSCAN|done " + txt.replace('\n', ' '));
                    a.runOnUiThread(new Runnable() {
                        @Override
                        public void run() {
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("僵尸粉扫描结果")
                                    .setMessage(txt)
                                    .setPositiveButton("好", null)
                                    .show();
                        }
                    });
                } catch (Throwable t) {
                    log("ZSCAN|err " + t);
                } finally {
                    zombieScanning = false;
                }
            }
        }).start();
    }

    /** 密友：用 username 精确匹配，或昵称匹配 */
    private static boolean isCloseFriendEx(String talker) {
        try {
            org.json.JSONArray arr = cfg().optJSONArray("closeFriends");
            if (arr == null || arr.length() == 0) return false;
            String disp = null;
            for (int i = 0; i < arr.length(); i++) {
                String n = arr.optString(i, "");
                if (n.length() == 0) continue;
                if (n.equals(talker)) return true;
                if (disp == null) disp = displayOfTalker(talker);
                if (n.equals(disp)) return true;
            }
        } catch (Throwable t) {
        }
        return false;
    }

    /** 密友：指定好友消息重点提醒 */
    private static boolean isCloseFriend(String talker) {
        try {
            org.json.JSONArray arr = cfg().optJSONArray("closeFriends");
            if (arr == null || arr.length() == 0) return false;
            for (int i = 0; i < arr.length(); i++) {
                String n = arr.optString(i, "");
                if (n.length() > 0 && (n.equals(talker) || (talker != null && talker.contains(n)))) return true;
            }
        } catch (Throwable t) {
        }
        return false;
    }

    /* ================= 密友中心 ================= */

    private static volatile long closeReplyAt = 0;

    /** 密友消息：按「弹窗 / 横幅 / 静默」提醒，可选震动、专属自动回复，并留一份记录 */
    private static void closeFriendNotice(String talker, String content) {
        String who = displayOfTalker(talker);
        String body = shortOf(content == null ? "" : content);
        String mode = cfg().optString("closeAlertMode", "dlg");
        try {
            if ("dlg".equals(mode)) alert("⭐ 密友：" + who, body);
            else if ("banner".equals(mode)) toast("⭐ 密友 " + who + "：" + body);
        } catch (Throwable ignore) { }
        try {
            if (cfg().optBoolean("closeVibrate", true)) {
                android.content.Context c0 = ctxAny();
                Object vb = c0 == null ? null : c0.getSystemService(android.content.Context.VIBRATOR_SERVICE);
                if (vb instanceof android.os.Vibrator) ((android.os.Vibrator) vb).vibrate(220L);
            }
        } catch (Throwable ignore) { }
        try {
            java.io.FileWriter fw = new java.io.FileWriter(new java.io.File(DIR + "/close_friends.log"), true);
            fw.write(new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US)
                    .format(new java.util.Date()) + "|" + who + "|" + body + "\n");
            fw.close();
        } catch (Throwable ignore) { }
        try {
            String rep = cfg().optString("closeReply", "");
            if (rep.length() > 0 && System.currentTimeMillis() - closeReplyAt > 600000L) {
                closeReplyAt = System.currentTimeMillis();
                sendTextTo(mainAct, talker, rep);
                log("CLOSE|reply " + talker);
            }
        } catch (Throwable ignore) { }
        log("CLOSE|" + talker + " mode=" + mode);
    }

