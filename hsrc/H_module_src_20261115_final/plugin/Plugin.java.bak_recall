    // ================= 主题包 导入 / 导出 =================
    private static java.io.File themeExtDir() {
        java.io.File d = new java.io.File("/sdcard/Android/data/com.tencent.mm/files");
        if (!d.exists()) d.mkdirs();
        return d;
    }

    private static int unzipTo(java.io.File zip, java.io.File outDir) throws Exception {
        int n = 0;
        java.util.zip.ZipInputStream zin = new java.util.zip.ZipInputStream(
                new java.io.BufferedInputStream(new java.io.FileInputStream(zip)));
        java.util.zip.ZipEntry e;
        byte[] buf = new byte[8192];
        while ((e = zin.getNextEntry()) != null) {
            String name = e.getName();
            if (name.contains("..")) continue;
            java.io.File dst = new java.io.File(outDir, name);
            if (e.isDirectory()) { dst.mkdirs(); continue; }
            dst.getParentFile().mkdirs();
            java.io.FileOutputStream fo = new java.io.FileOutputStream(dst);
            int len;
            while ((len = zin.read(buf)) > 0) fo.write(buf, 0, len);
            fo.close();
            n++;
        }
        zin.close();
        return n;
    }

    private static void importThemePack(final android.app.Activity a) {
        try {
            java.io.File ext = themeExtDir();
            java.io.File[] files = ext.listFiles();
            final java.util.ArrayList<java.io.File> zips = new java.util.ArrayList<java.io.File>();
            if (files != null) {
                for (java.io.File f : files) {
                    if (f.isFile() && f.getName().toLowerCase().endsWith(".zip")) zips.add(f);
                }
            }
            if (zips.isEmpty()) {
                toast("请把主题包 zip 放到\n" + ext.getAbsolutePath());
                return;
            }
            final String[] names = new String[zips.size()];
            for (int i = 0; i < zips.size(); i++) names[i] = zips.get(i).getName();
            new android.app.AlertDialog.Builder(a)
                    .setTitle("选择要导入的主题包")
                    .setItems(names, new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            final java.io.File zip = zips.get(w);
                            toast("导入中…");
                            new Thread(new Runnable() {
                                @Override public void run() {
                                    String msg;
                                    try {
                                        java.io.File dst = new java.io.File(
                                                cfg().optString("themePack", DIR + "/wxh_theme"));
                                        // 清空旧包
                                        deleteDir(dst, 0);
                                        dst.mkdirs();
                                        int n = unzipTo(zip, dst);
                                        boolean ok = new java.io.File(dst, "images").isDirectory()
                                                || new java.io.File(dst, "settings.json").isFile();
                                        msg = ok ? ("已导入 " + n + " 个文件") : "包结构不对（缺 images/）";
                                        cfgAt = 0;
                                    } catch (Throwable t) {
                                        msg = "导入失败: " + t;
                                    }
                                    final String fmsg = msg;
                                    a.runOnUiThread(new Runnable() {
                                        @Override public void run() {
                                            toast(fmsg);
                                            log("THEME|import " + fmsg);
                                        }
                                    });
                                }
                            }).start();
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) { toast("导入失败 " + t); }
    }

    private static void deleteDir(java.io.File f, int depth) {
        if (f == null || depth > 8) return;
        try {
            if (f.isDirectory()) {
                java.io.File[] cs = f.listFiles();
                if (cs != null) for (java.io.File c : cs) deleteDir(c, depth + 1);
            }
            f.delete();
        } catch (Throwable ignore) { }
    }

    private static void exportThemePack(final android.app.Activity a) {
        toast("导出中…");
        new Thread(new Runnable() {
            @Override public void run() {
                String msg;
                try {
                    java.io.File src = new java.io.File(cfg().optString("themePack", DIR + "/wxh_theme"));
                    if (!src.isDirectory()) { msg = "还没有主题包"; }
                    else {
                        java.io.File out = new java.io.File(themeExtDir(),
                                "wxh_theme_" + new java.text.SimpleDateFormat("MMddHHmm").format(new java.util.Date()) + ".zip");
                        java.util.zip.ZipOutputStream zos = new java.util.zip.ZipOutputStream(
                                new java.io.FileOutputStream(out));
                        int n = zipDir(src, src, zos);
                        zos.close();
                        msg = "已导出 " + n + " 个文件\n" + out.getAbsolutePath();
                    }
                } catch (Throwable t) { msg = "导出失败: " + t; }
                final String fmsg = msg;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        toast(fmsg);
                        log("THEME|export " + fmsg.replace('\n', ' '));
                    }
                });
            }
        }).start();
    }

    private static int zipDir(java.io.File root, java.io.File cur, java.util.zip.ZipOutputStream zos) throws Exception {
        int n = 0;
        java.io.File[] cs = cur.listFiles();
        if (cs == null) return 0;
        for (java.io.File f : cs) {
            String rel = root.toURI().relativize(f.toURI()).getPath();
            if (f.isDirectory()) {
                zos.putNextEntry(new java.util.zip.ZipEntry(rel));
                zos.closeEntry();
                n += zipDir(root, f, zos);
            } else {
                zos.putNextEntry(new java.util.zip.ZipEntry(rel));
                java.io.FileInputStream in = new java.io.FileInputStream(f);
                byte[] buf = new byte[8192];
                int len;
                while ((len = in.read(buf)) > 0) zos.write(buf, 0, len);
                in.close();
                zos.closeEntry();
                n++;
            }
        }
        return n;
    }

    // ================= 气泡主题 =================
    private static final java.util.concurrent.atomic.AtomicInteger imgFail =
            new java.util.concurrent.atomic.AtomicInteger(0);

    private static final java.util.Map<android.view.View, Boolean> themedBubbles =
            new java.util.WeakHashMap<android.view.View, Boolean>();
    private static long lastBubbleTick = 0;
    private static android.graphics.Bitmap bmpLeft = null, bmpRight = null;
    private static byte[] chunkLeft = null, chunkRight = null;
    private static long bmpAt = 0;

    /** 代码内构造 9-patch chunk（不依赖文件里的 npTc，避免破坏 PNG） */
    private static byte[] buildChunk(int[] xDivs, int[] yDivs, int l, int r, int t, int b) {
        try {
            int n = 4 + xDivs.length * 4 + yDivs.length * 4 + 16;
            byte[] out = new byte[n];
            out[0] = 1;
            out[1] = (byte) xDivs.length;
            out[2] = (byte) yDivs.length;
            out[3] = 0;
            int p = 4;
            for (int v : xDivs) { out[p++] = (byte) (v >> 24); out[p++] = (byte) (v >> 16); out[p++] = (byte) (v >> 8); out[p++] = (byte) v; }
            for (int v : yDivs) { out[p++] = (byte) (v >> 24); out[p++] = (byte) (v >> 16); out[p++] = (byte) (v >> 8); out[p++] = (byte) v; }
            for (int v : new int[]{l, r, t, b}) { out[p++] = (byte) (v >> 24); out[p++] = (byte) (v >> 16); out[p++] = (byte) (v >> 8); out[p++] = (byte) v; }
            return out;
        } catch (Throwable e) { return null; }
    }

    /** 从 PNG 文件里直接读 npTc 九宫格数据（BitmapFactory 不会解析） */
    private static byte[] readNpTc(String path) {
        try {
            java.io.File f = new java.io.File(path);
            if (!f.isFile()) return null;
            long len = f.length();
            if (len <= 0 || len > 8 * 1024 * 1024) return null;
            byte[] buf = new byte[(int) len];
            java.io.FileInputStream in = new java.io.FileInputStream(f);
            int got = 0;
            while (got < buf.length) {
                int r = in.read(buf, got, buf.length - got);
                if (r <= 0) break;
                got += r;
            }
            in.close();
            // PNG 签名 8 字节
            int p = 8;
            while (p + 8 <= got) {
                int size = ((buf[p] & 0xFF) << 24) | ((buf[p+1] & 0xFF) << 16)
                        | ((buf[p+2] & 0xFF) << 8) | (buf[p+3] & 0xFF);
                if (size < 0 || p + 8 + size > got) break;
                String type = new String(buf, p + 4, 4, "US-ASCII");
                if ("npTc".equals(type)) {
                    byte[] out = new byte[size];
                    System.arraycopy(buf, p + 8, out, 0, size);
                    return out;
                }
                if ("IDAT".equals(type)) break;
                p += 8 + size + 4;
            }
        } catch (Throwable t) { log("NPT|err " + t); }
        return null;
    }

    private static android.graphics.Bitmap bubbleBmp(boolean left) {
        long now = System.currentTimeMillis();
        try { ensureBubbleAssets(); } catch (Throwable ignore) { }
        if (bmpLeft == null && bmpRight == null && now - bmpAt > 5000) {
            bmpAt = now;
            try {
                String base = cfg().optString("themePack", DIR + "/wxh_theme") + "/images/";
                android.graphics.BitmapFactory.Options op = new android.graphics.BitmapFactory.Options();
                op.inScaled = true;
                op.inDensity = 320;   // 按 2x 基准解读，避免 96px 图在三倍屏上被放大成 96dp
                String skinL = DIR + "/wxh_bubble/left.png";
                String skinR = DIR + "/wxh_bubble/right.png";
                if (new java.io.File(skinL).exists()) bmpLeft = android.graphics.BitmapFactory.decodeFile(skinL, op);
                if (new java.io.File(skinR).exists()) bmpRight = android.graphics.BitmapFactory.decodeFile(skinR, op);
                if (bmpLeft == null) bmpLeft = android.graphics.BitmapFactory.decodeFile(base + "left_bubble.9.png", op);
                bmpRight = android.graphics.BitmapFactory.decodeFile(base + "right_bubble.9.png", op);
                if (bmpLeft == null) bmpLeft = android.graphics.BitmapFactory.decodeFile(
                        cfg().optString("themePack", DIR + "/wxh_theme") + "/images/left_bubble.png");
                if (bmpRight == null) bmpRight = android.graphics.BitmapFactory.decodeFile(
                        cfg().optString("themePack", DIR + "/wxh_theme") + "/images/right_bubble.png");
                // 图 200x96（含尾巴），内容区从 (1,1) 开始
                // 水平拉伸避开尾巴（0-42）、垂直避开圆角（0-20 / 78-96）
                // padding 左右对称居中；上下留足避免文字贴边
                // 四边留白统一，文字自然居中；气泡最小高度由原图撑开，尾巴不变形
                // 图片坐标（320dpi 基准，显示时 ×1.5）
                // 左右上 = 24px(约12dp)；底部 = 40px(约20dp)，给换行后的最后一行留空间
                // 实测气泡主体：y 3~83（尾巴在 80~90 的左/右下角），x 3~197
                // padding 让内容垂直居中在主体内；拉伸区严格避开圆角与尾巴
                // 气泡主体：y 3~74（尾巴在 74~89 的角落窄条），x 2~197
                // 让文字居中于主体：内容区 y=12~65，中心 38.5 = 主体中心
                // 9-patch 自带 padding 全部归零：留白改由控件 dp padding 精确控制（不受图片缩放比影响）
                int pl = 0, pr = 0, pt = 0, pb = 0;
                // 垂直拉伸区止于 74（主体底边），否则尾巴会被拉长
                // 拉伸区取图形最均匀的中段（水平 20px、垂直 22px），
                // 四角圆角、边缘渐变、尾巴全部落在固定区，长文本拉伸也不会变形/发虚
                chunkLeft = buildChunk(new int[]{90, 110}, new int[]{36, 58}, 26, 26, 20, 20);
                chunkRight = buildChunk(new int[]{90, 110}, new int[]{36, 58}, 26, 26, 20, 20);
                log("PAD|L" + pl + " R" + pr + " T" + pt + " B" + pb);
                log("NPT|chunk built L=" + (chunkLeft == null ? "null" : chunkLeft.length)
                        + " bmpL=" + (bmpLeft == null ? "null" : bmpLeft.getWidth() + "x" + bmpLeft.getHeight())
                        + " bmpR=" + (bmpRight == null ? "null" : bmpRight.getWidth() + "x" + bmpRight.getHeight()));
            } catch (Throwable ignore) { }
        }
        // 实测：对方(left)要用 right_bubble(红)，我发(right)要用 left_bubble(白)
        return left ? bmpRight : bmpLeft;
    }

    /** 颜色选择盘：预设色块 + 十六进制输入 */
    /* ================= 色盘取色器（HSV 圆盘，点哪取哪） ================= */
    private interface OnColor { void onColor(int color); }

    private static class ColorWheel extends android.view.View {
        private android.graphics.Bitmap bmp;
        private int radius = 128;
        private float selX = -1, selY = -1;
        private int initColor = 0xFF8A8A93;
        OnColor cb;

        ColorWheel(android.content.Context c) { super(c); }

        void setInitColor(int c) {
            initColor = c;
            selX = -1;
            invalidate();
        }

        private void ensureSel() {
            if (selX >= 0) return;
            float cx = getWidth() / 2f, cy = getHeight() / 2f;
            float rad = Math.min(getWidth(), getHeight()) / 2f;
            float[] hsv = new float[3];
            android.graphics.Color.colorToHSV(initColor, hsv);
            double ang = Math.toRadians(hsv[0]);
            float r = rad * hsv[1];
            selX = (float) (cx + r * Math.cos(ang));
            selY = (float) (cy + r * Math.sin(ang));
        }

        private void build() {
            int n = radius * 2;
            int[] px = new int[n * n];
            float[] hsv = new float[]{0f, 1f, 1f};
            for (int y = 0; y < n; y++) {
                for (int x = 0; x < n; x++) {
                    float dx = x - radius + 0.5f;
                    float dy = y - radius + 0.5f;
                    float dist = (float) Math.sqrt(dx * dx + dy * dy);
                    if (dist > radius) { px[y * n + x] = 0x00000000; continue; }
                    float ang = (float) (Math.toDegrees(Math.atan2(dy, dx)) + 360f) % 360f;
                    hsv[0] = ang;
                    hsv[1] = Math.min(1f, dist / radius);
                    hsv[2] = 1f;
                    px[y * n + x] = android.graphics.Color.HSVToColor(hsv);
                }
            }
            bmp = android.graphics.Bitmap.createBitmap(px, n, n, android.graphics.Bitmap.Config.ARGB_8888);
        }

        @Override protected void onDraw(android.graphics.Canvas cv) {
            if (bmp == null) build();
            android.graphics.RectF r = new android.graphics.RectF(0, 0, getWidth(), getHeight());
            android.graphics.Paint p = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
            cv.drawBitmap(bmp, null, r, p);

            ensureSel();
            float d = getResources().getDisplayMetrics().density;
            // 选中圆点：白环 + 深色细边，落在哪就是哪
            android.graphics.Paint ring = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
            ring.setStyle(android.graphics.Paint.Style.STROKE);
            ring.setStrokeWidth(3f * d);
            ring.setColor(0xFFFFFFFF);
            cv.drawCircle(selX, selY, 9f * d, ring);
            ring.setStrokeWidth(1f * d);
            ring.setColor(0x66000000);
            cv.drawCircle(selX, selY, 11f * d, ring);
            ring.setColor(0xFFFFFFFF);
            cv.drawCircle(selX, selY, 7f * d, ring);
        }

        @Override public boolean onTouchEvent(android.view.MotionEvent e) {
            if (e.getAction() == android.view.MotionEvent.ACTION_DOWN
                    || e.getAction() == android.view.MotionEvent.ACTION_MOVE) {
                float cx = getWidth() / 2f, cy = getHeight() / 2f;
                float dx = e.getX() - cx, dy = e.getY() - cy;
                float dist = (float) Math.sqrt(dx * dx + dy * dy);
                float rad = Math.min(getWidth(), getHeight()) / 2f;
                if (dist > rad) {
                    dx = dx * rad / dist;
                    dy = dy * rad / dist;
                }
                float ang = (float) (Math.toDegrees(Math.atan2(dy, dx)) + 360f) % 360f;
                float[] hsv = new float[]{ang, Math.min(1f, dist / rad), 1f};
                int color = android.graphics.Color.HSVToColor(hsv);
                selX = cx + dx;
                selY = cy + dy;
                if (cb != null) cb.onColor(color);
                invalidate();
                return true;
            }
            return true;
        }
    }


    private static Runnable colorPickAfter = null;
    private static android.app.Dialog colorDlg = null;

    private static void showColorPickerCb(final android.app.Activity a, final String key,
                                          final int cur, final Runnable after) {
        colorPickAfter = after;
        showColorPicker(a, key, cur);
    }

    private static void showColorPicker(final android.app.Activity a, final String key, final int cur) {
        try {
            final android.app.Dialog dlg = new android.app.Dialog(a,
                    android.R.style.Theme_Material_Light_NoActionBar);
            android.widget.LinearLayout wrap = new android.widget.LinearLayout(a);
            wrap.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
            bg.setColor(0xFFFFFFFF);
            bg.setCornerRadius(dp(a, 18));
            wrap.setBackground(bg);
            wrap.setPadding(dp(a, 16), dp(a, 14), dp(a, 16), dp(a, 12));

            android.widget.TextView title = new android.widget.TextView(a);
            title.setText("选择颜色");
            title.setTextSize(16);
            title.setTextColor(0xFF141418);
            wrap.addView(title);

            final int[] picked = {cur | 0xFF000000};
            final ColorWheel wheel = new ColorWheel(a);
            wheel.setInitColor(cur | 0xFF000000);
            wheel.cb = new OnColor() {
                @Override public void onColor(int color) { picked[0] = color | 0xFF000000; }
            };
            wrap.addView(wheel, new android.widget.LinearLayout.LayoutParams(dp(a, 240), dp(a, 240)));


            final android.view.View swatch = new android.view.View(a);
            android.graphics.drawable.GradientDrawable swg = new android.graphics.drawable.GradientDrawable();
            swg.setShape(android.graphics.drawable.GradientDrawable.OVAL);
            swg.setColor(picked[0]);
            swg.setStroke(dp(a, 1), 0x33000000);
            swatch.setBackground(swg);
            android.widget.LinearLayout swRow = new android.widget.LinearLayout(a);
            swRow.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            swRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
            swRow.setPadding(0, dp(a, 8), 0, 0);
            swRow.addView(swatch, new android.widget.LinearLayout.LayoutParams(dp(a, 26), dp(a, 26)));

            final android.widget.TextView preview = new android.widget.TextView(a);
            preview.setText(String.format("#%06X", picked[0] & 0xFFFFFF));
            preview.setTextSize(13);
            preview.setTextColor(0xFF55555A);
            preview.setPadding(dp(a, 10), 0, 0, 0);
            swRow.addView(preview);
            wrap.addView(swRow);
            wheel.cb = new OnColor() {
                @Override public void onColor(int color) {
                    picked[0] = color | 0xFF000000;
                    try {
                        android.graphics.drawable.GradientDrawable g2 = new android.graphics.drawable.GradientDrawable();
                        g2.setShape(android.graphics.drawable.GradientDrawable.OVAL);
                        g2.setColor(picked[0]);
                        g2.setStroke(dp(a, 1), 0x33000000);
                        swatch.setBackground(g2);
                        preview.setText(String.format("#%06X", picked[0] & 0xFFFFFF));
                    } catch (Throwable ignore) { }
                    try { wheel.invalidate(); } catch (Throwable ignore) { }
                }
            };

            // 快捷色行已按用户要求移除

            android.widget.LinearLayout btns = new android.widget.LinearLayout(a);
            btns.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            btns.setGravity(android.view.Gravity.END);
            android.widget.TextView cancel = new android.widget.TextView(a);
            cancel.setText("取消");
            cancel.setTextSize(14);
            cancel.setTextColor(0xFF888888);
            cancel.setPadding(dp(a, 14), dp(a, 12), dp(a, 14), dp(a, 12));
            btns.addView(cancel);
            android.widget.TextView ok = new android.widget.TextView(a);
            ok.setText("确定");
            ok.setTextSize(14);
            ok.setTextColor(0xFF2E7D32);
            ok.setPadding(dp(a, 14), dp(a, 12), dp(a, 14), dp(a, 12));
            btns.addView(ok);
            wrap.addView(btns);

            cancel.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    colorPickAfter = null;
                    try { dlg.dismiss(); } catch (Throwable ignore) { }
                }
            });
            dlg.setOnDismissListener(new android.content.DialogInterface.OnDismissListener() {
                @Override public void onDismiss(android.content.DialogInterface d) {
                    if (colorDlg == dlg) colorDlg = null;
                }
            });
            ok.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    try {
                        setIntCfg(key, picked[0]);
                        toast("已设置 " + String.format("#%06X", picked[0] & 0xFFFFFF));
                        if (settingsRefresher != null) settingsRefresher.run();
                        Runnable cb2 = colorPickAfter;
                        colorPickAfter = null;
                        if (cb2 != null) {
                            try { dlg.dismiss(); } catch (Throwable ignore) { }
                            cb2.run();
                        }
                    } catch (Throwable ignore) { }
                    try { dlg.dismiss(); } catch (Throwable ignore) { }
                }
            });

            dlg.setContentView(wrap);
            dlg.show();
            try {
                android.view.Window w = dlg.getWindow();
                if (w != null) {
                    w.setLayout((int) (a.getResources().getDisplayMetrics().widthPixels * 0.86),
                            android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                }
            } catch (Throwable ignore) { }
            preview.setText(String.format("#%06X", picked[0] & 0xFFFFFF));
        } catch (Throwable t) { toast("打开取色器失败：" + t); }
    }

    /** 拦截气泡背景资源设置：按资源名判定左右，直接换色 */
    private static final java.util.concurrent.atomic.AtomicInteger bgProbe =
            new java.util.concurrent.atomic.AtomicInteger(0);

    private static final java.util.concurrent.atomic.AtomicBoolean bubbleHookOn =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    private static void installBubbleColorHook(ClassLoader app) {
        if (!bubbleHookOn.compareAndSet(false, true)) return;
        try {
            Class<?> v = Class.forName("android.view.View", false, app);
            XposedBridge.hookAllMethods(v, "setBackgroundResource", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (!themeOn()) return;
                        if (bubbleMode(cfg()) != 2) return;
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        android.view.View view = (android.view.View) o;
                        int rid = (Integer) p.args[0];
                        if (rid == 0) return;
                        String name = "";
                        try {
                            name = view.getContext().getResources().getResourceEntryName(rid);
                        } catch (Throwable ignore) { return; }
                        try {
                            if (bgProbe.getAndIncrement() < 40) {
                                log("BGRES|" + name + "|" + view.getClass().getSimpleName());
                            }
                        } catch (Throwable ignore) { }
                        if (name == null) return;
                        String low = name.toLowerCase();
                        if (!low.contains("chat_item") && !low.contains("bubble")) return;
                        if (low.contains("avatar") || low.contains("voice") || low.contains("timer")) return;
                        boolean left;
                        if (low.contains("left")) left = true;
                        else if (low.contains("right")) left = false;
                        else {
                            // 资源名不带方向：按控件位置判断（此时可能未布局，交给 post）
                            final android.view.View fv = view;
                            view.post(new Runnable() {
                                @Override public void run() { recolorBubble(fv, null); }
                            });
                            return;
                        }
                        recolorBubble(view, Boolean.valueOf(left));
                    } catch (Throwable ignore) { }
                }
            });
            XposedBridge.hookAllMethods(v, "setBackground", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (!themeOn()) return;
                        if (bubbleMode(cfg()) != 2) return;
                        if (chatAct == null) return;
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        final android.view.View view = (android.view.View) o;
                        Object d = p.args[0];
                        if (d == null) return;
                        String dn = d.getClass().getName().toLowerCase();
                        if (!dn.contains("ninepatch")) return;
                        // 排除头像/输入框等
                        String vn = view.getClass().getName().toLowerCase();
                        if (vn.contains("imageview") || vn.contains("edittext")) return;
                        view.post(new Runnable() {
                            @Override public void run() { recolorBubble(view, null); }
                        });
                    } catch (Throwable ignore) { }
                }
            });
            log("hooked bubble color");
        } catch (Throwable t) { log("bubble hook err " + t); }
    }

    /** 给聊天列表挂「子项加入」监听：新行一出现立刻上色（解决发送延迟） */


    private static void attachRowListener(final android.app.Activity act) {
        try {
            final android.view.ViewGroup list = findMsgList(act.getWindow().getDecorView());
            if (list == null) return;
            if (list.getTag(0x0f0f0f36) != null) return;
            list.setTag(0x0f0f0f36, Boolean.TRUE);
            list.setOnHierarchyChangeListener(new android.view.ViewGroup.OnHierarchyChangeListener() {
                @Override public void onChildViewAdded(android.view.View parent, android.view.View child) {
                    try { styleAttachedRow(list, child); } catch (Throwable ignore) { }
                }
                @Override public void onChildViewRemoved(android.view.View parent, android.view.View child) { }
            });
            // 已有的行也补一遍
            for (int i = 0; i < list.getChildCount(); i++) {
                try { styleAttachedRow(list, list.getChildAt(i)); } catch (Throwable ignore) { }
            }
            log("ROWL|attached");
        } catch (Throwable t) { log("ROWL|err " + t); }
    }

    /** 对刚加入的消息行上色（16ms 重试，最多 12 次） */
    private static void styleAttachedRow(final android.view.ViewGroup list, final android.view.View row) {
        if (row == null) return;
        if (!themeOn()) return;
        if (bubbleMode(cfg()) != 2) return;
        if (!inChat) return;
        // 先按消息类型过滤（文件/图片/引用等一律不动）
        int rowType = -1;
        try {
            Object posObj = list.getClass().getMethod("getChildAdapterPosition", android.view.View.class)
                    .invoke(list, row);
            int pos = posObj instanceof Integer ? (Integer) posObj : -1;
            if (pos >= 0) {
                Object ad = list.getClass().getMethod("getAdapter").invoke(list);
                Object msg = ad.getClass().getMethod("getItem", int.class).invoke(ad, pos);
                rowType = readMsgType(msg);
            }
        } catch (Throwable ignore) { }
        if (rowType > 0 && rowType != 1 && rowType != 34) return;
        final int[] tries = {0};
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        Runnable r = new Runnable() {
            @Override public void run() {
                try {
                    if (!containsAvatar(row)) return;
                    if (looksLikeFile(previewOfRow(row))) return;
                    android.view.View bubble = findBubbleView(row);
                    boolean voice = false;
                    if (bubble == null) {
                        bubble = findBubbleView2(row);
                        voice = true;
                    }
                    if (bubble != null) {
                        boolean left = !leftByAvatar(row, bubble);
                        applyBubbleStyle(bubble, left, bubbleMode(cfg()));
                        return;
                    }
                } catch (Throwable ignore) { }
                if (tries[0]++ < 12) h.postDelayed(this, 16);
            }
        };
        r.run();
    }

    /** 是否确实在「与某人的聊天界面」里 */
    private static final java.util.concurrent.atomic.AtomicBoolean adapterProbe =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    private static boolean isInChatUi() {
        try {
            // 8.0.80 的聊天页是 LauncherUI 里的 Fragment，所以用 inChat 标记 + 会话 id 判断
            android.app.Activity a = chatAct != null ? chatAct : mainAct;
            if (a == null) return false;
            if (!inChat) return false;
            if (chatTalker == null || chatTalker.length() == 0) return false;
            // 前台必须是微信主界面本身（聊天是它的 Fragment）。打开视频号/朋友圈/小程序等
            // 二级页面时 topAct 已换成别的 Activity —— 此时绝不能继续按"聊天页"处理，
            // 否则会把二级页里的列表当成消息列表（曾导致视频号评论区出现空白行）。
            android.app.Activity t = topAct;
            if (t != null && t != a) {
                String tn = t.getClass().getName();
                if (!tn.endsWith(".LauncherUI") && !tn.endsWith("ChattingUI")) return false;
            }
            return true;
        } catch (Throwable t) { return false; }
    }

    /** 读消息类型：1=普通文字，其它（3图片/34语音/43视频/48位置/49引用或链接/50通话等）不处理 */
    private static int readMsgType(Object msg) {
        if (msg == null) return -1;
        try {
            for (java.lang.reflect.Method m : msg.getClass().getMethods()) {
                if (m.getParameterTypes().length != 0) continue;
                String n = m.getName();
                if (n.equals("getType") || n.equals("e0") || n.equals("l0")) {
                    Object v = m.invoke(msg);
                    if (v instanceof Integer) return (Integer) v;
                }
            }
        } catch (Throwable ignore) { }
        try {
            Class<?> k = msg.getClass();
            while (k != null && k != Object.class) {
                for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                    String n = f.getName().toLowerCase();
                    if (f.getType() != int.class) continue;
                    if (!n.contains("type")) continue;
                    f.setAccessible(true);
                    return f.getInt(msg);
                }
                k = k.getSuperclass();
            }
        } catch (Throwable ignore) { }
        return -1;
    }

    /** 用头像位置判断左右：头像在气泡左边=对方，在右边=我 */
    private static boolean leftByAvatar(android.view.View row, android.view.View bubble) {
        try {
            java.util.ArrayList<android.widget.ImageView> ivs = new java.util.ArrayList<android.widget.ImageView>();
            collectImages(row, ivs, 0);
            android.widget.ImageView avatar = null;
            // ① 优先认类名带 Avatar 的控件（头像），避免把图片消息的缩略图当头像
            for (android.widget.ImageView iv : ivs) {
                String cn = iv.getClass().getName();
                if (cn.contains("Avatar") || cn.contains("avatar")) { avatar = iv; break; }
            }
            // ② 退而求其次：取面积最小且 >= 60px 的（头像比图片缩略图小）
            if (avatar == null) {
                int best = Integer.MAX_VALUE;
                for (android.widget.ImageView iv : ivs) {
                    int w = Math.max(iv.getWidth(), iv.getMeasuredWidth());
                    if (w >= 60 && w < best) { best = w; avatar = iv; }
                }
            }
            if (avatar == null) return true;
            int[] al = new int[2];
            int[] bl = new int[2];
            avatar.getLocationOnScreen(al);
            bubble.getLocationOnScreen(bl);
            return (al[0] + avatar.getWidth() / 2f) < (bl[0] + bubble.getWidth() / 2f);
        } catch (Throwable t) { return true; }
    }

    /** 在绘制前一刻强制固定气泡颜色（首帧就生效，无延迟） */
    private static void installNeatDrawHook(ClassLoader app) {
        try {
            Class<?> neat = Class.forName("com.tencent.mm.ui.widget.MMNeat7extView", false, app);
            XposedBridge.hookAllMethods(neat, "draw", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!bubbleArtOn()) return;
                        int mode = bubbleMode(cfg());
                        if (mode != 2) return;
                        if (!isInChatUi()) return;
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        android.view.View v = (android.view.View) o;
                        int want = 0;
                        // 找所在行（父链直到 RecyclerView 的直接子项）
                        android.view.View row = v;
                        int guard = 0;
                        while (row != null && guard++ < 8) {
                            android.view.ViewParent vp = row.getParent();
                            if (!(vp instanceof android.view.View)) break;
                            if (vp.getClass().getName().contains("RecyclerView")) break;
                            row = (android.view.View) vp;
                        }
                        if (row == null) return;
                        boolean left = leftByAvatar(row, v);
                        JSONObject cc = cfg();
                        want = left ? cc.optInt("bubbleColorLeft", 0xFFFFFFFF)
                                : cc.optInt("bubbleColorRight", 0xFF95EC69);
                        String sig = "d:" + want;
                        if (sig.equals(String.valueOf(v.getTag(0x0f0f0f02)))) return;
                        android.graphics.drawable.GradientDrawable gb = new android.graphics.drawable.GradientDrawable();
                        gb.setColor(want);
                        gb.setCornerRadius(dp(v.getContext(), 12));
                        v.setBackground(gb);
                        int lum = (((want >> 16) & 0xFF) * 299 + ((want >> 8) & 0xFF) * 587 + (want & 0xFF) * 114) / 1000;
                        if (v instanceof android.widget.TextView) {
                            int defTc = lum > 150 ? 0xFF1A1E2B : 0xFFFFFFFF;
                            int userTc = left ? cfg().optInt("bubbleTextColorLeft", defTc)
                                              : cfg().optInt("bubbleTextColorRight", defTc);
                            ((android.widget.TextView) v).setTextColor(userTc);
                        }
                        v.setTag(0x0f0f0f02, sig);
                    } catch (Throwable ignore) { }
                }
            });
            log("NEAT|draw hook");
        } catch (Throwable t) { log("NEAT|draw err " + t); }
    }

    /** 业界通用做法：Hook LayoutInflater.inflate，气泡布局一创建就换背景（零延迟） */
    private static final java.util.concurrent.atomic.AtomicBoolean inflateHookOn =
            new java.util.concurrent.atomic.AtomicBoolean(false);
    private static final java.util.Set<String> layoutProbe = java.util.Collections.synchronizedSet(new java.util.HashSet<String>());

    private static void installInflateBubbleHook(ClassLoader app) {
        if (!inflateHookOn.compareAndSet(false, true)) return;
        try {
            Class<?> li = Class.forName("android.view.LayoutInflater", false, app);
            XposedBridge.hookAllMethods(li, "inflate", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (!bubbleArtOn()) return;
                        if (bubbleMode(cfg()) != 2) return;
                        if (!inChat) return;
                        Object r = p.getResult();
                        if (!(r instanceof android.view.View)) return;
                        int layoutId = -1;
                        try { layoutId = (Integer) p.args[0]; } catch (Throwable ignore) { }
                        if (layoutId <= 0) return;
                        final android.view.View root = (android.view.View) r;
                        String name = "";
                        try {
                            name = root.getResources().getResourceEntryName(layoutId);
                        } catch (Throwable ignore) { return; }
                        if (name == null || name.length() == 0) return;
                        String low = name.toLowerCase();
                        if (low.contains("chatting") && layoutProbe.size() < 60 && layoutProbe.add(name)) {
                            log("LAYOUT|" + name);
                        }
                        boolean isBubbleLayout = low.contains("chatting_item")
                                && (low.contains("_text_") || low.contains("_bubble_") || low.contains("_voice_"))
                                && (low.contains("left") || low.contains("right"));
                        if (!isBubbleLayout) return;
                        final boolean voiceLayout = low.contains("voice");
                        styleInflatedRow(root, voiceLayout);
                        root.post(new Runnable() {
                            @Override public void run() { styleInflatedRow(root, voiceLayout); }
                        });
                    } catch (Throwable ignore) { }
                }
            });
            log("INFLATE|hooked");
        } catch (Throwable t) { log("INFLATE|err " + t); }
    }

    /** 从 MMNeat7extView 反射取文本 */
    private static CharSequence neatText(android.view.View v) {
        try {
            for (String mn : new String[]{"getText", "getContent", "getRealText"}) {
                try {
                    java.lang.reflect.Method m = v.getClass().getMethod(mn);
                    Object r = m.invoke(v);
                    if (r instanceof CharSequence) return (CharSequence) r;
                } catch (Throwable ignore) { }
            }
            Class<?> k = v.getClass();
            while (k != null && k != Object.class) {
                for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                    if (f.getType() != CharSequence.class) continue;
                    f.setAccessible(true);
                    Object r = f.get(v);
                    if (r instanceof CharSequence && ((CharSequence) r).length() > 0) return (CharSequence) r;
                }
                k = k.getSuperclass();
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 取一行内的主要文字（用于判断是否文件卡片） */
    private static String previewOfRow(android.view.View row) {
        try {
            StringBuilder sb = new StringBuilder();
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(row, all, 0);
            for (android.view.View v : all) {
                CharSequence c = null;
                if (v instanceof android.widget.TextView) {
                    c = ((android.widget.TextView) v).getText();
                } else if (v.getClass().getName().contains("MMNeat7extView")) {
                    c = neatText(v);
                }
                if (c == null || c.length() == 0) continue;
                sb.append(c).append(' ');
                if (sb.length() > 120) break;
            }
            return sb.toString();
        } catch (Throwable t) { return ""; }
    }

    /** 判断文字是否像文件/文档卡片标题 */
    private static boolean looksLikeFile(String t) {
        if (t == null) return false;
        String s2 = t.trim().toLowerCase();
        if (s2.length() == 0) return false;
        String[] ext = {".docx", ".doc", ".pdf", ".xlsx", ".xls", ".pptx", ".ppt",
                ".zip", ".rar", ".txt", ".mp4", ".mp3", ".apk", ".7z"};
        for (String e : ext) if (s2.contains(e)) return true;
        if (s2.matches("^[0-9.]+\\s*(mb|kb|gb|b)$")) return true;
        if (s2.contains("撤回了一条消息") || s2.startsWith("你撤回") || s2.contains("以下是新消息")) return true;
        if (s2.contains("继续播放") || s2.contains("视频号") || s2.contains("小程序")) return true;
        if (s2.contains("名片") || s2.contains("转账") || s2.contains("红包")) return true;
        return false;
    }

    /** 对刚 inflate 出来的消息行上色：只处理真正的文字/语音气泡 */
    private static void styleInflatedRow(android.view.View root, boolean voice) {
        try {
            // 必须有头像（排除时间、系统提示、撤回提示）
            if (!containsAvatar(root)) return;
            android.view.View bubble = voice ? findBubbleView2(root) : findBubbleView(root);
            if (bubble == null) return;
            // 排除文件卡片 / 系统提示类文字
            if (bubble instanceof android.widget.TextView) {
                CharSequence c = ((android.widget.TextView) bubble).getText();
                if (c != null && looksLikeFile(c.toString())) return;
            }
            JSONObject cc = cfg();
            boolean left = !leftByAvatar(root, bubble);
            int want = left ? cc.optInt("bubbleColorLeft", 0xFFFFFFFF)
                    : cc.optInt("bubbleColorRight", 0xFF95EC69);
            String sig = "if:" + want;
            if (sig.equals(String.valueOf(bubble.getTag(0x0f0f0f04)))) return;
            int lum = (((want >> 16) & 0xFF) * 299 + ((want >> 8) & 0xFF) * 587 + (want & 0xFF) * 114) / 1000;
            int textColor = lum > 150 ? 0xFF1A1E2B : 0xFFFFFFFF;
            if (bubble instanceof android.widget.TextView) {
                ((android.widget.TextView) bubble).setTextColor(textColor);
            } else {
                setTextColorDeep(bubble, textColor);
            }
            android.graphics.drawable.GradientDrawable gb = new android.graphics.drawable.GradientDrawable();
            gb.setColor(want);
            gb.setCornerRadius(dp(bubble.getContext(), 12));
            bubble.setBackground(gb);
            bubble.setTag(0x0f0f0f04, sig);
            bgHookCount.incrementAndGet();
        } catch (Throwable ignore) { }
    }

    // ============ 资源级气泡替换（业界最精准做法） ============
    private static int resBubbleLeft = 0, resBubbleRight = 0;
    private static final java.util.concurrent.atomic.AtomicBoolean resHookOn =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    private static void probeBubbleRes(android.content.Context ctx) {
        try {
            android.content.res.Resources r = ctx.getResources();
            Class<?> rDrawable = Class.forName("com.tencent.mm.R$drawable", false,
                    Thread.currentThread().getContextClassLoader());
            int found = 0;
            for (java.lang.reflect.Field f : rDrawable.getDeclaredFields()) {
                try {
                    if (f.getType() != int.class) continue;
                    f.setAccessible(true);
                    int id = f.getInt(null);
                    String name = r.getResourceEntryName(id);
                    if (name == null) continue;
                    String low = name.toLowerCase();
                    if (!low.contains("bubble") && !low.contains("chat_item")) continue;
                    if (found < 80) log("RESD|" + name + "=" + id);
                    found++;
                    if (resBubbleLeft == 0 && (low.contains("left") || low.contains("other"))) resBubbleLeft = id;
                    if (resBubbleRight == 0 && (low.contains("right") || low.contains("self"))) resBubbleRight = id;
                } catch (Throwable ignore) { }
            }
            log("RES|L=" + resBubbleLeft + " R=" + resBubbleRight + " total=" + found);
        } catch (Throwable t) { log("RES|probe err " + t); }
    }

    /** 钩 Resources.getDrawable：气泡资源一被读取就换成我们的纯色块 */
    private static void installBubbleResHook(ClassLoader app) {
        if (!resHookOn.compareAndSet(false, true)) return;
        try {
            Class<?> res = Class.forName("android.content.res.Resources", false, app);
            XC_MethodHook h = new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (resBubbleLeft == 0 && resBubbleRight == 0) return;
                        if (!bubbleArtOn()) return;
                        if (bubbleMode(cfg()) != 2) return;
                        if (p.args == null || p.args.length == 0) return;
                        Object a0 = p.args[0];
                        if (!(a0 instanceof Integer)) return;
                        int id = (Integer) a0;
                        boolean left;
                        if (id == resBubbleLeft) left = true;
                        else if (id == resBubbleRight) left = false;
                        else return;
                        if (!inChat) return;
                        JSONObject cc = cfg();
                        int want = left ? cc.optInt("bubbleColorLeft", 0xFFFFFFFF)
                                : cc.optInt("bubbleColorRight", 0xFF95EC69);
                        android.content.res.Resources r = (android.content.res.Resources)
                                (p.thisObject instanceof android.content.res.Resources
                                        ? p.thisObject : null);
                        if (r == null) return;
                        android.graphics.drawable.GradientDrawable gb = new android.graphics.drawable.GradientDrawable();
                        gb.setColor(want);
                        gb.setCornerRadius(12 * r.getDisplayMetrics().density);
                        p.setResult(gb);
                        bgHookCount.incrementAndGet();
                    } catch (Throwable ignore) { }
                }
            };
            try { XposedBridge.hookAllMethods(res, "getDrawable", h); } catch (Throwable ignore) { }
            try { XposedBridge.hookAllMethods(res, "getDrawableForDensity", h); } catch (Throwable ignore) { }
            log("RES|hooked");
        } catch (Throwable t) { log("RES|err " + t); }
    }

    /** 判断控件是否在聊天列表内，返回所在行 */
    private static android.view.View chatRowOf(android.view.View view) {
        try {
            android.view.View cur = view;
            int guard = 0;
            while (cur != null && guard++ < 14) {
                android.view.ViewParent vp = cur.getParent();
                if (!(vp instanceof android.view.View)) return null;
                android.view.View pv = (android.view.View) vp;
                String cn = pv.getClass().getName();
                if (cn.contains("RecyclerView")) return cur;
                cur = pv;
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 只在聊天列表内的气泡上生效的替换 */
    private static void tryStyleChatBubble(android.view.View view) {
        try {
            if (!bubbleArtOn()) return;
            if (bubbleMode(cfg()) != 2) return;
            if (!inChat) return;
            android.view.View row = chatRowOf(view);
            if (row == null) return;
            boolean left = !leftByAvatar(row, view);
            JSONObject cc = cfg();
            int want = left ? cc.optInt("bubbleColorLeft", 0xFFFFFFFF)
                    : cc.optInt("bubbleColorRight", 0xFF95EC69);
            if (applyBubbleSkin(view, left)) return;
            String sig = "bg:" + want;
            if (sig.equals(String.valueOf(view.getTag(0x0f0f0f03)))) return;
            android.graphics.drawable.GradientDrawable gb = new android.graphics.drawable.GradientDrawable();
            gb.setColor(want);
            gb.setCornerRadius(dp(view.getContext(), 12));
            view.setBackground(gb);
            int lum = (((want >> 16) & 0xFF) * 299 + ((want >> 8) & 0xFF) * 587 + (want & 0xFF) * 114) / 1000;
            if (view instanceof android.widget.TextView) {
                ((android.widget.TextView) view).setTextColor(lum > 150 ? 0xFF1A1E2B : 0xFFFFFFFF);
            }
            view.setTag(0x0f0f0f03, sig);
            bgHookCount.incrementAndGet();
        } catch (Throwable ignore) { }
    }

    /** 一次到位：在微信设置背景「之前」就把参数换成我们的颜色 */
    private static int bgSeen = 0;

    private static void installChatBgHook(ClassLoader app) {
        try {
            Class<?> v = Class.forName("android.view.View", false, app);
            XC_MethodHook h = new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (Boolean.TRUE.equals(skinGuard.get())) return;
                        if (!inChat) return;
                        if (!bubbleArtOn()) return;
                        if (bubbleMode(cfg()) != 2) return;
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        android.view.View view = (android.view.View) o;
                        if (p.args == null || p.args.length == 0) return;
                        Object d = p.args[0];
                        if (d == null) return;
                        bgSeen++;
                        if (bgSeen % 200 == 0) log("BGHIT|seen=" + bgSeen + " cnt=" + bgHookCount.get()
                                + " cls=" + d.getClass().getName());
                        if (!d.getClass().getName().contains("NinePatch")) return;
                        android.view.View row = chatRowOf(view);
                        if (row == null) return;
                        // 排除系统提示行（无头像：撤回提示、时间、以下为新消息）
                        if (!containsAvatar(row)) return;
                        // 排除文件/文档卡片、系统提示文字
                        if (view instanceof android.widget.TextView) {
                            CharSequence tc = ((android.widget.TextView) view).getText();
                            if (tc != null && looksLikeFile(tc.toString())) return;
                        }
                        boolean left = !leftByAvatar(row, view);
                        if (applyBubbleSkin(view, left)) { bgHookCount.incrementAndGet(); return; }
                        JSONObject cc = cfg();
                        int want = left ? cc.optInt("bubbleColorLeft", 0xFFFFFFFF)
                                : cc.optInt("bubbleColorRight", 0xFF95EC69);
                        android.graphics.drawable.GradientDrawable gb = new android.graphics.drawable.GradientDrawable();
                        gb.setColor(want);
                        gb.setCornerRadius(dp(view.getContext(), 12));
                        // 直接把要设置的背景换掉，微信设上去的就是我们的颜色
                        p.args[0] = gb;
                        int lum = (((want >> 16) & 0xFF) * 299 + ((want >> 8) & 0xFF) * 587 + (want & 0xFF) * 114) / 1000;
                        if (view instanceof android.widget.TextView) {
                            ((android.widget.TextView) view).setTextColor(lum > 150 ? 0xFF1A1E2B : 0xFFFFFFFF);
                        }
                        view.setTag(0x0f0f0f03, "bg:" + want);
                        bgHookCount.incrementAndGet();
                    } catch (Throwable ignore) { }
                }
            };
            try { XposedBridge.hookAllMethods(v, "setBackground", h); } catch (Throwable ignore) { }
            try { XposedBridge.hookAllMethods(v, "setBackgroundDrawable", h); } catch (Throwable ignore) { }
            log("BGHOOK|installed");
        } catch (Throwable t) { log("BGHOOK|err " + t); }
    }

    private static final java.util.concurrent.atomic.AtomicInteger bgHookCount =
            new java.util.concurrent.atomic.AtomicInteger(0);

    /** 绑定后如气泡还没生成，做几次快速重试（发送后立刻绑定常见） */
    private static void styleRowWithRetry(final android.view.View item, final Boolean isSend,
                                          final int mode, final int attempt, final boolean voice) {
        try {
            if (item == null) return;
            android.view.View bubble = voice ? findBubbleView2(item) : findBubbleView(item);
            if (bubble != null) {
                boolean left = isSend != null ? isSend.booleanValue() : !leftByAvatar(item, bubble);
                if (mode != 0) applyBubbleStyle(bubble, left, mode);
                return;
            }
            if (attempt >= 12) return;
            final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
            h.postDelayed(new Runnable() {
                @Override public void run() {
                    try { styleRowWithRetry(item, isSend, mode, attempt + 1, voice); } catch (Throwable ignore) { }
                }
            }, 16);
        } catch (Throwable ignore) { }
    }

    /** 借鉴 WeX：钩住聊天适配器 onBindViewHolder，绑定即上色 */
    private static void hookChatAdapter(Class<?> adapterCls) {
        try {
            XposedBridge.hookAllMethods(adapterCls, "onBindViewHolder", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        // 时间随绑定一次性写入：消息出现在屏幕上的同一帧就有时间，
                        // 不再等整表扫描（之前"要等一下才显示"就是时序问题）
                        // 绑定这一刻就把微信原生的纯时间行藏掉，避免和自绘时间上下并列
                        if (cfg().optBoolean("hideNativeTime", false)) {
                            try {
                                android.view.View itv1 = null;
                                Object h1 = p.args.length > 0 ? p.args[0] : null;
                                if (h1 != null) {
                                    Object v1 = h1.getClass().getField("itemView").get(h1);
                                    if (v1 instanceof android.view.View) itv1 = (android.view.View) v1;
                                }
                                if (itv1 != null) hideNativeTimeRow(itv1);
                            } catch (Throwable ignore) { }
                        }
                        if (cfg().optBoolean("msgTimeEnh", false)) {
                            int pos0 = (p.args.length > 1 && p.args[1] instanceof Integer)
                                    ? ((Integer) p.args[1]).intValue() : -1;
                            if (pos0 >= 0) {
                                android.view.View item0 = null;
                                try {
                                    Object h0 = p.args.length > 0 ? p.args[0] : null;
                                    if (h0 != null) {
                                        Object v0 = h0.getClass().getField("itemView").get(h0);
                                        if (v0 instanceof android.view.View) item0 = (android.view.View) v0;
                                    }
                                } catch (Throwable ignore) { }
                                if (item0 != null) {
                                    Object it0 = null;
                                    try {
                                        it0 = p.thisObject.getClass().getMethod("getItem", int.class)
                                                .invoke(p.thisObject, pos0);
                                    } catch (Throwable ignore) { }
                                    long ct0 = it0 != null ? readCreateTime(it0) : 0;
                                    if (ct0 > 0) {
                                        try { item0.setTag(0x0f0f0f06, Long.valueOf(ct0)); } catch (Throwable ignore) { }
                                        try {
                                            attachMsgTimeEnh(item0, ct0, readMsgType(it0), "", pos0);
                                        } catch (Throwable ignore) { }
                                    }
                                }
                            }
                        }
                    } catch (Throwable ignore) { }
                    try {
                        if (!bubbleArtOn()) return;
                        int mode = bubbleMode(cfg());
                        if (mode == 0) return;
                        if (!isInChatUi()) return;
                        Object holder = p.args.length > 0 ? p.args[0] : null;
                        int pos = p.args.length > 1 && p.args[1] instanceof Integer ? (Integer) p.args[1] : -1;
                        android.view.View item = null;
                        try {
                            android.view.ViewParent vp = null;
                            java.lang.reflect.Field f = holder.getClass().getField("itemView");
                            Object v = f.get(holder);
                            if (v instanceof android.view.View) item = (android.view.View) v;
                        } catch (Throwable ignore) { }
                        if (item == null) return;
                        Boolean isSend = null;
                        Object msgForType = null;
                        try {
                            Object ad = p.thisObject;
                            msgForType = ad.getClass().getMethod("getItem", int.class).invoke(ad, pos);
                            isSend = readIsSend(msgForType);
                        } catch (Throwable ignore) { }
                        int tp = readMsgType(msgForType);
                        if (tp > 0 && tp != 1 && tp != 34) return;   // 仅文字与语音
                        if (!containsAvatar(item)) return;            // 系统提示/撤回提示/时间
                        if (looksLikeFile(previewOfRow(item))) return; // 文件/文档卡片
                        styleRowWithRetry(item, isSend, mode, 0, tp == 34);
                    } catch (Throwable ignore) { }
                }
            });
            log("CHATAD|hooked " + adapterCls.getName());
        } catch (Throwable t) { log("CHATAD|err " + t); }
    }

    /** 借鉴 WeX 的 ChattingDataAdapter 思路：按适配器数据逐行上色，左右取自 isSend */
    private static final java.util.WeakHashMap<android.view.View, android.graphics.drawable.Drawable> kwMarks =
            new java.util.WeakHashMap<android.view.View, android.graphics.drawable.Drawable>();

    /** 命中关键词的消息打个高亮底色（不改原有背景，走 overlay） */
    private static void markKeywords(android.view.View row, String text, java.util.List<String> kws) {
        try {
            boolean hit = false;
            for (String k : kws) {
                if (k.length() > 0 && text.contains(k)) { hit = true; break; }
            }
            android.graphics.drawable.Drawable old = kwMarks.get(row);
            if (hit) {
                if (old != null) return;
                android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
                gd.setColor(0x33FFD54F);
                gd.setCornerRadius(dp(row.getContext(), 10));
                row.getOverlay().add(gd);
                kwMarks.put(row, gd);
            } else if (old != null) {
                row.getOverlay().remove(old);
                kwMarks.remove(row);
            }
        } catch (Throwable ignore) { }
    }

    private static long enhLogAt = 0;

    private static long styleLogAt = 0;


    /** 找聊天消息列表：decor → 所有窗口根 → ChatFooter 所在的真实根 */
    private static android.view.ViewGroup findChatList(android.app.Activity act) {
        try {
            android.view.ViewGroup l = findMsgList(act.getWindow().getDecorView());
            if (l != null) return l;
        } catch (Throwable ignore) { }
        try {
            for (android.view.View r : allRoots()) {
                android.view.ViewGroup l2 = findMsgList(r);
                if (l2 != null) return l2;
            }
        } catch (Throwable ignore) { }
        try {
            android.view.View f = todayAnchor;
            if (f != null) {
                android.view.ViewGroup l3 = findMsgList(f.getRootView());
                if (l3 != null) return l3;
            }
        } catch (Throwable ignore) { }
        return null;
    }

    private static int styleMiss = 0;
    private static long dbgTimeAt = 0;
    private static void styleChatRowsByAdapter(android.app.Activity act) {
        try {
            if (act == null) return;
            if (System.currentTimeMillis() - styleLogAt > 5000) {
                styleLogAt = System.currentTimeMillis();
                log("STYLE|enter " + act.getClass().getSimpleName());
            }
            // 注意：这一层原来是总开关 theme，但「每条消息时间/高亮/屏蔽」都挂在它后面，
            // 关掉主题会连带把这些功能关死。这里改成「主题 或 时间增强」任一开启就继续。
            if (!themeOn()
                    && !cfg().optBoolean("msgTimeEnh", false)
                    && !cfg().optBoolean("msgTimeAlways", false)) return;
            try {
                // 只判是否结束：过去用 hasWindowFocus() 会因通知栏/浮窗抢焦点而整段跳过，
                // 表现出来就是「时间时有时无」
                if (act.isFinishing()) return;
            } catch (Throwable ignore) { }
            int mode = bubbleMode(cfg());   // 0=气泡主题关闭：只跳过气泡外观，其余功能照常
            android.view.ViewGroup list = findChatList(act);
            if (list == null) { styleMiss++; if (styleMiss % 20 == 1) log("STYLE|no list miss=" + styleMiss); return; }
            Object adapter = null;
            try { adapter = list.getClass().getMethod("getAdapter").invoke(list); } catch (Throwable ignore) { }
            // 注意：ScrollControlRecyclerView 没有 getAdapter()，拿不到 adapter 也必须继续，
            // 否则每条消息时间/高亮全部失效（之前私聊没时间就是这个 return 造成的）
            if (adapter != null && adapterProbe.compareAndSet(false, true)) {
                log("CHATAD|" + list.getClass().getName() + " adapter=" + adapter.getClass().getName());
                try { hookChatAdapter(adapter.getClass()); } catch (Throwable ignore) { }
            }
            // 按行顺序兜底取时间：数据库最近 N 条消息（从新到旧），列表最后一行对应第 0 条
            if (chatTalker != null && chatTalker.length() > 0) lastKnownTalker = chatTalker;
            long[] ctArr = cachedTimes();
            int applied = 0;
            for (int i = 0; i < list.getChildCount(); i++) {
                android.view.View row = list.getChildAt(i);
                if (row == null) continue;
                Boolean isSend = null;
                Object msgObj = null;
                try {
                    Object posObj = list.getClass().getMethod("getChildAdapterPosition", android.view.View.class)
                            .invoke(list, row);
                    int pos = posObj instanceof Integer ? (Integer) posObj : -1;
                    if (pos >= 0) {
                        msgObj = adapter.getClass().getMethod("getItem", int.class).invoke(adapter, pos);
                        if (msgObj != null) isSend = readIsSend(msgObj);
                    }
                } catch (Throwable ignore) { }
                // 左滑引用：每行装一次触摸监听，识别水平左滑后调起微信自带的「引用」
                try {
                    if (cfg().optBoolean("swipeQuote", false)
                            && row.getTag(0x0f0f0f41) == null) {
                        row.setTag(0x0f0f0f41, Boolean.TRUE);
                        final android.view.View rowF = row;
                        row.setOnTouchListener(new android.view.View.OnTouchListener() {
                            private float x0, y0;
                            private long t0;
                            @Override public boolean onTouch(android.view.View v, android.view.MotionEvent e) {
                                try {
                                    if (e.getAction() == android.view.MotionEvent.ACTION_DOWN) {
                                        x0 = e.getRawX(); y0 = e.getRawY();
                                        t0 = System.currentTimeMillis();
                                    } else if (e.getAction() == android.view.MotionEvent.ACTION_UP) {
                                        float dx = e.getRawX() - x0;
                                        float dy = Math.abs(e.getRawY() - y0);
                                        long dt = System.currentTimeMillis() - t0;
                                        if (dx < -110 && dy < 45 && dt < 600) {
                                            try { quoteViaMenu(v); } catch (Throwable ignore) { }
                                        }
                                    }
                                } catch (Throwable ignore) { }
                                return false;   // 不拦截，滚动/长按照常
                            }
                        });
                    }
                } catch (Throwable ignore) { }

                // 头像圆裁：每行只处理一次（打标记，避免每帧遍历）
                try {
                    if (row.getTag(0x0f0f0f21) == null) {
                        roundAvatarsInRow(row);
                        row.setTag(0x0f0f0f21, Boolean.TRUE);
                    }
                } catch (Throwable ignore) { }
                // 消息进入动画（只对新出现的行做一次）
                try {
                    if (cfg().optBoolean("msgAnim", false)) {
                        Object seen = row.getTag(0x0f0f0f23);
                        if (seen == null) {
                            row.setTag(0x0f0f0f23, Boolean.TRUE);
                            float d0 = row.getResources().getDisplayMetrics().density;
                            row.setAlpha(0f);
                            row.setTranslationY(8 * d0);
                            row.animate().alpha(1f).translationY(0f).setDuration(180).start();
                        }
                    }
                } catch (Throwable ignore) { }
                // 隐藏消息头像
                try {
                    boolean ha = cfg().optBoolean("hideAvatar", false);
                    Object haTag = row.getTag(0x0f0f0f22);
                    if (haTag == null || ((Boolean) haTag).booleanValue() != ha) {
                        java.util.ArrayList<android.view.View> vs = new java.util.ArrayList<android.view.View>();
                        collectAllViews(row, vs, 0);
                        for (android.view.View vv : vs) {
                            String cn = vv.getClass().getName();
                            if (!cn.contains("Avatar")) continue;
                            vv.setVisibility(ha ? android.view.View.GONE : android.view.View.VISIBLE);
                        }
                        row.setTag(0x0f0f0f22, Boolean.valueOf(ha));
                    }
                } catch (Throwable ignore) { }
                // 屏蔽"拍了拍" / 群成员 / 指定类型 / 无关提示
                try {
                    android.widget.TextView mtvF = mainTextOf(row);
                    String txF = mtvF != null && mtvF.getText() != null ? mtvF.getText().toString() : "";
                    // 关键词高亮
                    if (cfg().optBoolean("kwHighlight", false) && txF.length() > 0) {
                        String kl = cfg().optString("kwHLWords", "");
                        if (kl.trim().length() > 0) {
                            java.util.ArrayList<String> kws = new java.util.ArrayList<String>();
                            for (String kk : kl.split(",")) { String t2 = kk.trim(); if (t2.length() > 0) kws.add(t2); }
                            markKeywords(row, txF, kws);
                        }
                    }
                    // 视图复用：如果这一行是我们上次隐藏的，先恢复可见，否则普通消息会跟着一起消失
                    try {
                        if (row.getTag(0x0f0f0f32) != null) {
                            row.setVisibility(android.view.View.VISIBLE);
                            row.setTag(0x0f0f0f32, null);
                        }
                    } catch (Throwable ignore) { }
                    long tsF = tsOfAnchor(row);
                    boolean hideRow = false;
                    String filterReason = "";
                    if (cfg().optBoolean("noPatAlert", false) && txF.contains("拍了拍")) { hideRow = true; filterReason = "拍一拍"; }
                    if (!hideRow && cfg().optBoolean("blockAtAll", false)
                            && (txF.contains("@所有人") || txF.contains("所有人"))) {
                        hideRow = true; filterReason = "@所有人";
                    }
                    if (!hideRow && cfg().optBoolean("hideSysTips", false)) {
                        if (txF.contains("文件已过期") || txF.contains("已被清理")
                                || txF.contains("加入了群聊") || txF.contains("邀请") && txF.contains("加入")
                                || txF.contains("撤回了一条消息") && false) {
                            hideRow = true; filterReason = "系统提示";
                        }
                    }
                    // 增强时间开启时，隐藏微信自带的时间行，避免一条消息上面出现两个时间
                    boolean hasAvatarRow = false;
                    try { hasAvatarRow = rowHasAvatar(row); } catch (Throwable ignore) { }
                    if (!hideRow && !hasAvatarRow && cfg().optBoolean("hideNativeTime", false)) {
                        try { hideNativeTimeRow(row); } catch (Throwable ignore) { }
                        if (isNativeTimeRow(txF)) {
                            hideRow = true; filterReason = "原生时间";
                        }
                    }
                    if (!hideRow && !hasAvatarRow && cfg().optBoolean("noSeenTip", true)
                            && (txF.contains("刚刚在看") || txF.contains("截了一张图")
                                || txF.contains("截屏了") || txF.contains("正在输入"))) {
                        hideRow = true; filterReason = "已读/截图提示";
                    }
                    if (!hideRow && txF.length() > 0) {
                        String bm = cfg().optString("blockMembers", "");
                        String ft = cfg().optString("filterTypes", "");
                        if (bm.length() > 0) {
                            String who = senderOfTs(tsF);
                            if (who != null) {
                                boolean inList = false;
                                for (String nm : bm.split(",")) {
                                    String n2 = nm.trim();
                                    if (n2.length() > 0 && who.contains(n2)) { inList = true; break; }
                                }
                                boolean white = cfg().optBoolean("blockModeWhite", false);
                                if (white ? !inList : inList) { hideRow = true; filterReason = (white ? "白名单外:" : "黑名单:") + who; }
                            }
                        }
                        if (!hideRow && ft.length() > 0 && tsF > 0) {
                            long tpF = typeOfTs(tsF);
                            for (String t2 : ft.split(",")) {
                                String s2 = t2.trim();
                                if (s2.length() > 0 && String.valueOf(tpF).equals(s2)) { hideRow = true; break; }
                            }
                        }
                    }
                    if (hideRow) {
                        row.setVisibility(android.view.View.GONE);
                        try { row.setTag(0x0f0f0f32, Boolean.TRUE); } catch (Throwable ignore) { }
                        try {
                            if (cfg().optBoolean("filterLog", false)) {
                                java.io.File lf = new java.io.File(DIR, "wxh_filter.log");
                                java.io.FileWriter fw = new java.io.FileWriter(lf, true);
                                fw.write(fmtTs(tsF) + " " + filterReason + " " + txF + "\n");
                                fw.close();
                            }
                        } catch (Throwable ignore) { }
                    }
                } catch (Throwable ignore) { }
                // 屏蔽"拍了拍"
                try {
                    if (cfg().optBoolean("noPatAlert", false)) {
                        android.widget.TextView mtv0 = mainTextOf(row);
                        if (mtv0 != null && mtv0.getText() != null
                                && mtv0.getText().toString().contains("拍了拍")) {
                            row.setVisibility(android.view.View.GONE);
                        }
                    }
                } catch (Throwable ignore) { }
                // 文本替换：优先按「这一条的时间戳」，其次按行位置，最后全局
                try {
                    loadTsRules();
                    long rowTs = tsOfAnchor(row);
                    String tTo = rowTs > 0 ? liveRulesTs.get(Long.valueOf(rowTs)) : null;
                    if (tTo == null) {
                        int pfb = list.getChildCount() - 1 - i;
                        tTo = liveRulesAt.get(atKey(chatTalker, pfb));
                    }
                    if (tTo != null) applyOneReplacement(row, tTo);
                    else applyReplacementsFile(row);
                } catch (Throwable ignore) { }
                // 时间标注：不依赖类型，每行都挂（tag 始终打，供"定位到聊天"用）
                try {
                    int idxBase = -1;
                    try {
                        int apos = posOfRow(row);
                        int acnt = -1;
                        try { acnt = (Integer) adapter.getClass().getMethod("getItemCount").invoke(adapter); }
                        catch (Throwable ignore) { }
                        if (apos >= 0 && acnt > 0) idxBase = acnt - 1 - apos;
                    } catch (Throwable ignore) { }
                    if (idxBase < 0) idxBase = list.getChildCount() - 1 - i;
                    boolean[] sendArr = null;
                    try { sendArr = cachedIsSend(); } catch (Throwable ignore) { }
                    if (ctArr != null) {
                        int idx0 = idxBase;
                        if (idx0 >= 0 && idx0 < ctArr.length && ctArr[idx0] > 0) {
                            try { row.setTag(0x0f0f0f06, Long.valueOf(ctArr[idx0])); } catch (Throwable ignore) { }
                        }
                    }
                    if (sendArr != null && idxBase >= 0 && idxBase < sendArr.length) {
                        try { row.setTag(0x0f0f0f09, Boolean.valueOf(sendArr[idxBase])); } catch (Throwable ignore) { }
                    }
                    if (cfg().optBoolean("msgTimeEnh", false)) {
                        long tsE = 0;
                        // 拿不到消息对象时，从行自己的 adapter 再取一次（列表没暴露 getAdapter 时全靠这条）
                        if (msgObj == null) {
                            try {
                                Object ad3 = adapterOfRow(row);
                                int p3 = posOfRow(row);
                                if (ad3 != null && p3 >= 0) {
                                    Object it = ad3.getClass().getMethod("getItem", int.class).invoke(ad3, p3);
                                    if (it != null) msgObj = it;
                                }
                            } catch (Throwable ignore) { }
                        }
                        // 只认「从这一行的消息对象直接读出来的时间」。
                        // 退回 DB 行序兜底一旦错位就会满屏乱时间（用户明确要求宁可不加也别错加），
                        // 所以读不到就跳过，让微信原生时间行照常显示。
                        boolean fromObj = false;
                        tsE = msgObj != null ? readCreateTime(msgObj) : 0;
                        fromObj = tsE > 0;
                        if (tsE > 0) {
                            try { row.setTag(0x0f0f0f06, Long.valueOf(tsE)); } catch (Throwable ignore) { }
                        }
                        if (fromObj) {
                            int tpE = readMsgType(msgObj);
                            String sndE = (chatTalker != null && chatTalker.endsWith("@chatroom"))
                                    ? displayOfTalker(safeSender(tsE)) : "";
                            attachMsgTimeEnh(row, tsE, tpE, sndE, i);
                        }
                    }
                } catch (Throwable ignore) { }
                int pos2 = posOfRow(row);
                Object ad2 = adapterOfRow(row);
                if (ad2 != null) adapter = ad2;
                int tp2 = readMsgType(msgObj);
                long ct2 = msgObj == null ? 0 : readCreateTime(msgObj);
                // msgObj 拿不到时，用 adapter.getItemId(pos) 反查数据库
                if (tp2 != 1 && tp2 != 34) {
                    long mid = -1;
                    try {
                        Object idv = adapter.getClass().getMethod("getItemId", int.class).invoke(adapter, pos2);
                        if (idv instanceof Long) mid = (Long) idv;
                        else if (idv instanceof Integer) mid = ((Integer) idv).longValue();
                    } catch (Throwable ignore) { }

                    if (mid > 0) {
                        try {
                            java.util.List<Object[]> rr = queryRows(
                                    "select type, createTime from message where msgId=" + mid + " limit 1", 2);
                            if (!rr.isEmpty()) {
                                tp2 = Integer.parseInt(String.valueOf(rr.get(0)[0]).trim());
                                ct2 = Long.parseLong(String.valueOf(rr.get(0)[1]).trim());

                            }
                        } catch (Throwable ignore) { }
                    }
                }
                if (tp2 != 1 && tp2 != 34) continue;   // 读不到类型也跳过，避免误伤图片/文件
                if (!containsAvatar(row)) continue;
                if (looksLikeFile(previewOfRow(row))) continue;
                if (hasBigImage(row)) continue;   // 图片消息兜底
                android.view.View bubble = findBubbleView(row);
                if (bubble == null) continue;
                boolean left = isSend != null ? isSend.booleanValue() : !leftByAvatar(row, bubble);
                applyBubbleStyle(bubble, left, mode);

                applied++;
            }
            if (applied > 0) log("ADAPTER|styled " + applied);
        } catch (Throwable t) { log("ADAPTER|err " + t); }
    }

    private static Boolean readIsSend(Object msg) {
        try {
            for (java.lang.reflect.Method m : msg.getClass().getMethods()) {
                if (m.getParameterTypes().length != 0) continue;
                String n = m.getName();
                if (n.equals("isSend") || n.equals("getIsSend") || n.equals("l1")) {
                    Object v = m.invoke(msg);
                    if (v instanceof Boolean) return (Boolean) v;
                }
            }
        } catch (Throwable ignore) { }
        try {
            Class<?> k = msg.getClass();
            while (k != null && k != Object.class) {
                for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                    String n = f.getName().toLowerCase();
                    if (f.getType() != int.class || (!n.contains("issend") && !n.equals("f"))) continue;
                    f.setAccessible(true);
                    int v = f.getInt(msg);
                    if (v == 0 || v == 1) return v == 1;
                }
                k = k.getSuperclass();
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 行内找气泡：优先 MMNeat7extView / 语音气泡，其次九宫格背景 */
    private static android.view.View findBubbleView2(android.view.View row) {
        // 语音：直接找「有背景 + 扁长条形」的容器（跳过 MMNeat7extView 文字控件）
        // 语音消息：找行内宽度较大且背景为 NinePatch/ColorDrawable 的 View
        android.view.View best = null;
        int bestArea = 0;
        java.util.ArrayList<android.view.View> stack = new java.util.ArrayList<android.view.View>();
        stack.add(row);
        int guard = 0;
        while (!stack.isEmpty() && guard++ < 300) {
            android.view.View v = stack.remove(stack.size() - 1);
            try {
                if (v.getClass().getName().toLowerCase().contains("avatar")) continue;
                android.graphics.drawable.Drawable bg = v.getBackground();
                if (bg != null
                        && v.getWidth() > dp(v.getContext(), 50)
                        && v.getHeight() > dp(v.getContext(), 22)
                        && v.getHeight() < dp(v.getContext(), 110)
                        && !v.getClass().getName().contains("MMNeat7extView")) {
                    int area = v.getWidth() * v.getHeight();
                    if (area > bestArea) { bestArea = area; best = v; }
                }
            } catch (Throwable ignore) { }
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) stack.add(g.getChildAt(i));
            }
        }
        return best;
    }

    /** 行内找气泡：优先 MMNeat7extView，其次九宫格背景 */
    private static android.view.View findBubbleView(android.view.View row) {
        android.view.View nine = null;
        int bestArea = 0;
        java.util.ArrayList<android.view.View> stack = new java.util.ArrayList<android.view.View>();
        stack.add(row);
        int guard = 0;
        while (!stack.isEmpty() && guard++ < 300) {
            android.view.View v = stack.remove(stack.size() - 1);
            try {
                if (v.getClass().getName().contains("MMNeat7extView")) return v;
                android.graphics.drawable.Drawable bg = v.getBackground();
                if (bg != null && bg.getClass().getName().toLowerCase().contains("ninepatch")) {
                    int w = Math.max(v.getWidth(), v.getMeasuredWidth());
                    int h = Math.max(v.getHeight(), v.getMeasuredHeight());
                    if (w * h >= bestArea) { bestArea = w * h; nine = v; }
                }
            } catch (Throwable ignore) { }
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) stack.add(g.getChildAt(i));
            }
        }
        return nine;
    }


    /** 根据背景亮度推荐文字色（深底白字 / 浅底黑字） */
    private static int autoTextOn(int bg) {
        int lum = (((bg >> 16) & 0xFF) * 299 + ((bg >> 8) & 0xFF) * 587 + (bg & 0xFF) * 114) / 1000;
        return lum > 150 ? 0xFF1A1E2B : 0xFFFFFFFF;
    }

    /** MMNeat7extView 不是 TextView，文字用自带 TextPaint/ColorStateList 绘制，需反射改色 */
    private static boolean paintNeatText(android.view.View v, int color) {
        try {
            if (!v.getClass().getName().contains("MMNeat7extView")) return false;
            boolean done = false;
            // 1) getPaint() -> Paint.setColor
            try {
                Object pt = v.getClass().getMethod("getPaint").invoke(v);
                if (pt instanceof android.graphics.Paint) {
                    ((android.graphics.Paint) pt).setColor(color);
                    done = true;
                }
            } catch (Throwable ignore) { }
            // 2) 内部 TextView 字段 f
            try {
                java.lang.reflect.Field f = v.getClass().getDeclaredField("f");
                f.setAccessible(true);
                Object tv = f.get(v);
                if (tv instanceof android.widget.TextView) {
                    ((android.widget.TextView) tv).setTextColor(color);
                    done = true;
                }
            } catch (Throwable ignore) { }
            // 3) ColorStateList 字段（i/m/n）
            android.content.res.ColorStateList cs = android.content.res.ColorStateList.valueOf(color);
            for (String fn : new String[]{"i", "m", "n"}) {
                try {
                    java.lang.reflect.Field f = v.getClass().getDeclaredField(fn);
                    f.setAccessible(true);
                    if (f.get(v) != null) { f.set(v, cs); done = true; }
                } catch (Throwable ignore) { }
            }
            // 4) TextPaint 字段 h
            try {
                java.lang.reflect.Field f = v.getClass().getDeclaredField("h");
                f.setAccessible(true);
                Object pt = f.get(v);
                if (pt instanceof android.graphics.Paint) {
                    ((android.graphics.Paint) pt).setColor(color);
                    done = true;
                }
            } catch (Throwable ignore) { }
            v.invalidate();
            return done;
        } catch (Throwable t) {
            return false;
        }
    }

    /** 行内是否有大尺寸图片（图片/视频消息），有则不是文字气泡 */
    private static boolean hasBigImage(android.view.View row) {
        try {
            return hasBigImage0(row, 0);
        } catch (Throwable ignore) { return false; }
    }

    private static boolean hasBigImage0(android.view.View v, int depth) {
        if (depth > 6) return false;
        int min = (int) (110 * v.getResources().getDisplayMetrics().density);
        if (v instanceof android.widget.ImageView) {
            if (v.getWidth() >= min && v.getHeight() >= min) return true;
        }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                if (hasBigImage0(g.getChildAt(i), depth + 1)) return true;
            }
        }
        return false;
    }

    /** 从行视图向上找 RecyclerView，返回其 adapter（找不到返回 null） */
    private static Object adapterOfRow(android.view.View row) {
        try {
            android.view.ViewParent vp = row.getParent();
            int guard = 0;
            while (vp != null && vp instanceof android.view.View && guard++ < 12) {
                android.view.View v = (android.view.View) vp;
                if (v.getClass().getName().contains("RecyclerView")) {
                    return v.getClass().getMethod("getAdapter").invoke(v);
                }
                vp = v.getParent();
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 从行视图向上找 RecyclerView，取该行的 adapter position */
    private static int posOfRow(android.view.View row) {
        try {
            android.view.View child = row;
            android.view.ViewParent vp = row.getParent();
            int guard = 0;
            while (vp != null && vp instanceof android.view.View && guard++ < 12) {
                android.view.View v = (android.view.View) vp;
                if (v.getClass().getName().contains("RecyclerView")) {
                    // child 是这个 RecyclerView 的直接子项
                    Object r = v.getClass().getMethod("getChildAdapterPosition", android.view.View.class).invoke(v, child);
                    if (r instanceof Integer) return (Integer) r;
                }
                child = v;
                vp = v.getParent();
            }
        } catch (Throwable ignore) { }
        return -1;
    }

    /** 读消息的 createTime（秒或毫秒），失败返回 0 */
    private static long readCreateTime(Object msg) {
        if (msg == null) return 0;
        try {
            for (java.lang.reflect.Method m : msg.getClass().getMethods()) {
                if (m.getParameterTypes().length != 0) continue;
                String n = m.getName().toLowerCase();
                if (!n.contains("createtime") && !n.contains("time")) continue;
                Object v = m.invoke(msg);
                if (v instanceof Long) return (Long) v;
                if (v instanceof Integer) return ((Integer) v).longValue();
            }
        } catch (Throwable ignore) { }
        try {
            Class<?> k = msg.getClass();
            while (k != null && k != Object.class) {
                for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                    if (f.getType() != long.class && f.getType() != int.class) continue;
                    if (!f.getName().toLowerCase().contains("createtime")) continue;
                    f.setAccessible(true);
                    Object v = f.get(msg);
                    if (v instanceof Long) return (Long) v;
                    if (v instanceof Integer) return ((Integer) v).longValue();
                }
                k = k.getSuperclass();
            }
        } catch (Throwable ignore) { }
        return 0;
    }

    /** 行内最大的 ImageView（图片/表情消息的锚点） */
    private static android.view.View findBigImageView(android.view.View row) {
        try {
            return findBigImageView0(row, 0);
        } catch (Throwable ignore) { return null; }
    }

    private static android.view.View findBigImageView0(android.view.View v, int depth) {
        if (depth > 6) return null;
        int min = (int) (90 * v.getResources().getDisplayMetrics().density);
        if (v instanceof android.widget.ImageView && v.getWidth() >= min && v.getHeight() >= min) return v;
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            android.view.View best = null;
            int bestArea = 0;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View c = findBigImageView0(g.getChildAt(i), depth + 1);
                if (c != null && c.getWidth() * c.getHeight() > bestArea) { best = c; bestArea = c.getWidth() * c.getHeight(); }
            }
            return best;
        }
        return null;
    }

    /** 用 ViewOverlay 在气泡底部绘制时间（不改变视图层级，绝不触发 RecyclerView 崩溃） */
    private static void tintBubbleText(android.view.View v, int color, int depth) {
        try {
            v.setTag(0x0f0f0f03, color);
            paintNeatText(v, color);
            if (v instanceof android.widget.TextView) {
                ((android.widget.TextView) v).setTextColor(color);
            }
            if (depth < 3 && v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    tintBubbleText(g.getChildAt(i), color, depth + 1);
                }
            }
        } catch (Throwable ignore) { }
    }

    private static int neatDrawSeen = 0, neatDrawHit = 0, neatSpanFixed = 0, tpDebug = 0;
    /** 当前正在绘制的 MMNeat7extView 的目标文字色（0=无） */
    private static final ThreadLocal<Integer> neatPaintColor = new ThreadLocal<Integer>();

    /** 绘制前强制设定气泡文字颜色（借鉴 WeX/微X 的做法：钩 draw 而不是改属性） */
    private static void installNeatTextColorHook(ClassLoader app) {
        try {
            Class<?> c = Class.forName("com.tencent.mm.ui.widget.MMNeat7extView", false, app);
            XposedBridge.hookAllMethods(c, "draw", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        android.view.View v = (android.view.View) o;
                        neatDrawSeen++;
                        Object col = v.getTag(0x0f0f0f03);
                        if (col instanceof Integer) neatDrawHit++;
                        if (neatDrawSeen % 200 == 1) log("NEATTXT|seen=" + neatDrawSeen + " hit=" + neatDrawHit + " fixed=" + neatSpanFixed);
                        if (!(col instanceof Integer)) return;
                        int color = (Integer) col;
                        android.graphics.Paint pt = null;
                        try {
                            Object r = v.getClass().getMethod("getPaint").invoke(v);
                            if (r instanceof android.graphics.Paint) {
                                pt = (android.graphics.Paint) r;
                                if (pt.getColor() != color) pt.setColor(color);
                            }
                        } catch (Throwable ignore) { }
                        // 字段 h 才是真正绘制用的 TextPaint，必须单独改
                        try {
                            java.lang.reflect.Field f = v.getClass().getDeclaredField("h");
                            f.setAccessible(true);
                            Object t = f.get(v);
                            if (t instanceof android.graphics.Paint) {
                                android.graphics.Paint tp = (android.graphics.Paint) t;
                                if (tp.getColor() != color) tp.setColor(color);
                                pt = tp;
                            }
                        } catch (Throwable ignore) { }
                        // ColorStateList 决定每帧重置后的颜色，必须无条件替换
                        try {
                            android.content.res.ColorStateList csl =
                                    android.content.res.ColorStateList.valueOf(color);
                            Class<?> cc0 = v.getClass();
                            while (cc0 != null) {
                                for (java.lang.reflect.Field f : cc0.getDeclaredFields()) {
                                    if (f.getType() != android.content.res.ColorStateList.class) continue;
                                    try { f.setAccessible(true); f.set(v, csl); } catch (Throwable ignore) { }
                                }
                                cc0 = cc0.getSuperclass();
                            }
                        } catch (Throwable ignore) { }
                        // 再遍历所有 Paint 类型字段兜底
                        try {
                            java.util.List<java.lang.reflect.Field> pfs = new java.util.ArrayList<java.lang.reflect.Field>();
                            Class<?> cw = v.getClass();
                            while (cw != null && cw != Object.class) {
                                for (java.lang.reflect.Field f : cw.getDeclaredFields()) pfs.add(f);
                                cw = cw.getSuperclass();
                            }
                            for (java.lang.reflect.Field f : pfs) {
                                if (!android.graphics.Paint.class.isAssignableFrom(f.getType())) continue;
                                f.setAccessible(true);
                                Object t = f.get(v);
                                if (t instanceof android.graphics.Paint) ((android.graphics.Paint) t).setColor(color);
                            }
                        } catch (Throwable ignore) { }
                        neatPaintColor.set(color);
                        // 微信消息文本是 Spannable，颜色常被 ForegroundColorSpan 覆盖，
                        // 这里移除所有前景色 span，并用内部 TextView 强制设色
                        try {
                            Object tvv = null;
                            try {
                                java.lang.reflect.Field ff = v.getClass().getDeclaredField("f");
                                ff.setAccessible(true);
                                tvv = ff.get(v);
                            } catch (Throwable ignore) { }
                            if (tvv == null && neatDrawHit == 1) log("NEATTXT|f is null");
                            if (tvv != null && neatDrawHit <= 3) log("NEATTXT|f=" + tvv.getClass().getName()
                                    + " cur=" + ((android.widget.TextView) tvv).getCurrentTextColor()
                                    + " want=" + color);
                            if (tvv instanceof android.widget.TextView) {
                                android.widget.TextView tv = (android.widget.TextView) tvv;
                                CharSequence cs = tv.getText();
                                if (cs instanceof android.text.Spannable) {
                                    android.text.Spannable sp = (android.text.Spannable) cs;
                                    android.text.style.ForegroundColorSpan[] arr =
                                            sp.getSpans(0, sp.length(), android.text.style.ForegroundColorSpan.class);
                                    for (android.text.style.ForegroundColorSpan fcs : arr) sp.removeSpan(fcs);
                                }
                                if (tv.getCurrentTextColor() != color) {
                                    tv.setTextColor(color);
                                    neatSpanFixed++;
                                }
                            }
                        } catch (Throwable ignore) { }
                    } catch (Throwable ignore) { }
                }
            });
            XposedBridge.hookAllMethods(c, "draw", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    neatPaintColor.remove();
                }
            });
            // 关键：NeatTextView 每帧内部可能重新 setColor，直接拦 Paint.setColor
            try {
                Class<?> pc = Class.forName("android.graphics.Paint", false, app);
                XposedBridge.hookAllMethods(pc, "setColor", new XC_MethodHook() {
                    @Override protected void beforeHookedMethod(MethodHookParam p) {
                        Integer c = neatPaintColor.get();
                        if (c != null && p.args != null && p.args.length == 1) p.args[0] = c;
                    }
                });
            } catch (Throwable ignore) { }
            // 最底层兜底：MMNeat 自绘时直接用 Canvas.drawText + 自带 TextPaint，
            // 在绘制瞬间把 paint 颜色改掉，微信无法再覆盖
            try {
                Class<?> cv = Class.forName("android.graphics.Canvas", false, app);
                XposedBridge.hookAllMethods(cv, "drawText", new XC_MethodHook() {
                    @Override protected void beforeHookedMethod(MethodHookParam p) {
                        Integer c = neatPaintColor.get();
                        if (c == null) return;
                        Object[] a = p.args;
                        for (int i = 0; i < a.length; i++) {
                            if (a[i] instanceof android.graphics.Paint) {
                                ((android.graphics.Paint) a[i]).setColor(c);
                                return;
                            }
                        }
                    }
                });
            } catch (Throwable ignore) { }
            log("NEATTXT|hooked draw");
        } catch (Throwable t) { log("NEATTXT|err " + t); }
    }

    /** 在视图树里找第一个有文字的 TextView */
    private static android.widget.TextView firstTextIn(android.view.View v) {
        try {
            if (v instanceof android.widget.TextView) {
                CharSequence cs = ((android.widget.TextView) v).getText();
                if (cs != null && cs.length() > 0) return (android.widget.TextView) v;
            }
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.widget.TextView r = firstTextIn(g.getChildAt(i));
                    if (r != null) return r;
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 强制气泡 padding：微信在布局时会重设 padding，这里钩住 setPadding 直接改参数 */
    private static void installBubblePaddingHook(ClassLoader app) {
        try {
            Class<?> v = Class.forName("android.view.View", false, app);
            XposedBridge.hookAllMethods(v, "setPadding", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (p.args == null || p.args.length != 4) return;
                        if (cfg().optInt("bubbleMode", 0) == 0) return;
                        if (!inChat) return;
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        android.view.View vv = (android.view.View) o;
                        Object tag = vv.getTag();
                        if (!"wxhBubble".equals(String.valueOf(tag))) return;
                        float d = vv.getResources().getDisplayMetrics().density;
                        // 气泡主体底部有约 8dp 的尾巴区，让内容中心对齐主体中心：
                        // 上 = 16dp，下 = 16 + 8 = 24dp（差正好等于尾巴高度的一半×2）
                        float tail = 8f * d;
                        p.args[0] = (int) (16 * d);
                        p.args[1] = (int) (16 * d);
                        p.args[2] = (int) (16 * d);
                        p.args[3] = (int) (16 * d + tail);
                        // 清掉之前可能设过的位移
                        final android.view.View bubble = vv;
                        bubble.post(new Runnable() {
                            @Override public void run() {
                                try {
                                    android.widget.TextView tv = firstTextIn(bubble);
                                    if (tv != null && tv.getTranslationY() != 0f) tv.setTranslationY(0f);
                                } catch (Throwable ignore) { }
                            }
                        });
                    } catch (Throwable ignore) { }
                }
            });
            log("BUBPAD|hooked setPadding");
        } catch (Throwable t) { log("BUBPAD|err " + t); }
    }

    /** 给气泡控件显式设 padding（左右 12dp，上 10dp，下 22dp），并在下一帧再确认一次 */
    private static void applyBubblePadding(final android.view.View v) {
        try {
            // 用固定 dp 精确控制留白：左/右 16dp、上 10dp、下 18dp（下多留给尾巴）
            final float d0 = v.getResources().getDisplayMetrics().density;
            final int l = (int) (16 * d0), t0 = (int) (10 * d0), r = (int) (16 * d0), b0 = (int) (18 * d0);
            v.setTag("wxhBubble");
            v.setPadding(l, t0, r, b0);
            v.post(new Runnable() {
                @Override public void run() {
                    try {
                        v.setPadding(l, t0, r, b0);
                        v.requestLayout();
                        log("PADPK|" + l + "/" + t0 + "/" + r + "/" + b0 + " d=" + d0);
                    } catch (Throwable ignore) { }
                }
            });
        } catch (Throwable ignore) { }
    }

    /** 给气泡外面包一层容器，背景设在容器上，高度永远跟随内容 */
    private static boolean wrapBubble(final android.view.View bubble, android.graphics.drawable.Drawable bg,
                                      int l, int r, int t, int b) {
        try {
            android.view.ViewParent vp = bubble.getParent();
            if (!(vp instanceof android.view.ViewGroup)) return false;
            final android.view.ViewGroup parent = (android.view.ViewGroup) vp;
            if (parent.getTag(0x0f0f0f3a) != null) {
                parent.setBackground(bg);
                return true;
            }
            int idx = parent.indexOfChild(bubble);
            if (idx < 0) return false;
            android.view.ViewGroup.LayoutParams lp = bubble.getLayoutParams();

            android.widget.FrameLayout wrap = new android.widget.FrameLayout(bubble.getContext());
            wrap.setTag(0x0f0f0f3a, Boolean.TRUE);
            wrap.setBackground(bg);

            parent.removeViewAt(idx);
            bubble.setBackground(null);
            bubble.setPadding(0, 0, 0, 0);
            wrap.addView(bubble, new android.widget.FrameLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                    android.view.Gravity.CENTER));
            android.view.ViewGroup.LayoutParams nlp = null;
            if (lp != null) {
                try {
                    java.lang.reflect.Constructor<?> ctor = lp.getClass().getConstructor(
                            android.view.ViewGroup.LayoutParams.class);
                    nlp = (android.view.ViewGroup.LayoutParams) ctor.newInstance(lp);
                } catch (Throwable ignore) { }
            }
            if (nlp == null) {
                nlp = new android.view.ViewGroup.LayoutParams(
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
            }
            nlp.width = android.view.ViewGroup.LayoutParams.WRAP_CONTENT;
            parent.addView(wrap, idx, nlp);
            wrap.requestLayout();
            log("WRAP|ok " + parent.getClass().getSimpleName());
            return true;
        } catch (Throwable e) {
            log("WRAP|fail " + e);
            return false;
        }
    }

    private static void applyBubbleStyle(android.view.View v, boolean left, int mode) {
        try {
            JSONObject cc = cfg();
            int want = left ? cc.optInt("bubbleColorLeft", 0xFFFFFFFF)
                    : cc.optInt("bubbleColorRight", 0xFF95EC69);
            String sig = mode + ":" + want;
            if (sig.equals(String.valueOf(v.getTag(0x0f0f0f01)))) return;   // 同一行同色不重复处理
            if (mode == 2) {
                if (applyBubbleSkin(v, left)) { v.setTag(0x0f0f0f01, sig); return; }
                int color = left ? cc.optInt("bubbleColorLeft", 0xFFFFFFFF)
                        : cc.optInt("bubbleColorRight", 0xFF95EC69);
                android.graphics.drawable.GradientDrawable gb = new android.graphics.drawable.GradientDrawable();
                gb.setColor(color);
                gb.setCornerRadius(dp(v.getContext(), 12));
                // 背景覆盖整个气泡（不回缩），底部多留 padding 给时间用
                float dd = v.getResources().getDisplayMetrics().density;
                int timeH = (int) (16 * dd);
                // 保证时间（21px，约 220px 宽）能完整显示：气泡至少 300px 宽
                try {
                    int minW = 300;
                    if (v.getMinimumWidth() < minW) {
                        v.setMinimumWidth(minW);
                        v.requestLayout();
                    }
                } catch (Throwable ignore) { }
                v.setBackground(gb);
                v.setPadding((int) (16 * dd), (int) (8 * dd), (int) (16 * dd), timeH + (int) (8 * dd));
                v.post(new Runnable() {
                    @Override public void run() {
                        try {
                            float d2 = v.getResources().getDisplayMetrics().density;
                            v.setPadding((int) (16 * d2), (int) (8 * d2), (int) (16 * d2), (int) (24 * d2));
                        } catch (Throwable ignore) { }
                    }
                });
                int lum = (((color >> 16) & 0xFF) * 299 + ((color >> 8) & 0xFF) * 587 + (color & 0xFF) * 114) / 1000;
                int defT = lum > 150 ? 0xFF1A1E2B : 0xFFFFFFFF;
                int useT = left ? cfg().optInt("bubbleTextColorLeft", defT)
                                : cfg().optInt("bubbleTextColorRight", defT);
                tintBubbleText(v, useT, 0);
                v.setTag(0x0f0f0f01, sig);
            } else {
                android.graphics.Bitmap bm = bubbleBmp(left);
                if (bm != null) {
                    byte[] chunk = left ? chunkRight : chunkLeft;
                    boolean ok = false;
                    if (chunk != null && android.graphics.NinePatch.isNinePatchChunk(chunk)) {
                        try {
                            android.graphics.drawable.NinePatchDrawable np = new android.graphics.drawable.NinePatchDrawable(
                                    v.getResources(), bm, chunk, new android.graphics.Rect(), null);
                            int pd = (int) (v.getResources().getDisplayMetrics().density);
                            // 外包一层容器承载气泡图，确保长文本也包得住
                            v.setBackground(np);
                            applyBubblePadding(v);
                            v.requestLayout();
                            v.invalidate();
                            ok = true;
                            if (imgFail.getAndIncrement() < 2) log("BUBIMG|nine ok " + (left ? "L" : "R")
                                    + " chunk=" + chunk.length);
                        } catch (Throwable t) {
                            if (imgFail.getAndIncrement() < 3) log("BUBIMG|np fail " + t);
                        }
                    }
                    if (!ok) {
                        // 退化：直接贴图拉伸
                        try {
                            android.graphics.drawable.BitmapDrawable bd =
                                    new android.graphics.drawable.BitmapDrawable(v.getResources(), bm);
                            bd.setGravity(android.view.Gravity.FILL);
                            v.setBackground(bd);
                            ok = true;
                            if (imgFail.getAndIncrement() < 3) log("BUBIMG|fallback " + (left ? "L" : "R")
                                    + " " + (chunk == null ? "nullchunk" : ("len=" + chunk.length)));
                        } catch (Throwable t) {
                            if (imgFail.getAndIncrement() < 3) log("BUBIMG|bd fail " + t);
                        }
                    }
                    if (ok) {
                        int txt = left ? 0xFF1A1E2B : 0xFFFFFFFF;
                        setTextColorDeep(v, txt);
                        v.setTag(0x0f0f0f04, "if:img:" + left);
                        bgHookCount.incrementAndGet();
                    }
                } else {
                    if (imgFail.getAndIncrement() < 3) log("BUBIMG|no bmp " + (left ? "L" : "R"));
                }
            }
        } catch (Throwable ignore) { }
    }

    /** 直接钩微信的消息文本控件：它的背景就是气泡 */
    private static final java.util.concurrent.atomic.AtomicBoolean neatHook =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    private static void installNeatBubbleHook(ClassLoader app) {
        if (!neatHook.compareAndSet(false, true)) return;
        try {
            Class<?> neat = Class.forName("com.tencent.mm.ui.widget.MMNeat7extView", false, app);
            XC_MethodHook h = new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        final android.view.View v = (android.view.View) o;
                        if (!bubbleArtOn()) return;
                        if (bubbleMode(cfg()) == 0) return;
                        v.post(new Runnable() {
                            @Override public void run() { styleNeatBubble(v); }
                        });
                    } catch (Throwable ignore) { }
                }
            };
            try { XposedBridge.hookAllMethods(neat, "setBackground", h); } catch (Throwable ignore) { }
            try { XposedBridge.hookAllMethods(neat, "setBackgroundResource", h); } catch (Throwable ignore) { }
            try { XposedBridge.hookAllMethods(neat, "setBackgroundDrawable", h); } catch (Throwable ignore) { }
            try { XposedBridge.hookAllMethods(neat, "setText", h); } catch (Throwable ignore) { }
            log("NEAT|hooked MMNeat7extView");
        } catch (Throwable t) { log("NEAT|err " + t); }
    }

    /** 给 MMNeat7extView（消息文本）套气泡 */
    private static void styleNeatBubble(android.view.View v) {
        try {
            if (v == null) return;
            if (!bubbleArtOn()) return;
            int mode = bubbleMode(cfg());
            if (mode == 0) return;
            int[] loc = new int[2];
            v.getLocationOnScreen(loc);
            int screenW = v.getResources().getDisplayMetrics().widthPixels;
            boolean left = (loc[0] + v.getWidth() / 2f) < screenW / 2f;
            JSONObject cc = cfg();
            if (mode == 2) {
                if (applyBubbleSkin(v, left)) return;
                int color = left ? cc.optInt("bubbleColorLeft", 0xFFFFFFFF)
                        : cc.optInt("bubbleColorRight", 0xFF95EC69);
                android.graphics.drawable.GradientDrawable gb = new android.graphics.drawable.GradientDrawable();
                gb.setColor(color);
                gb.setCornerRadius(dp(v.getContext(), 12));
                v.setBackground(gb);
                int lum = (((color >> 16) & 0xFF) * 299 + ((color >> 8) & 0xFF) * 587 + (color & 0xFF) * 114) / 1000;
                int defT = lum > 150 ? 0xFF1A1E2B : 0xFFFFFFFF;
                int useT = left ? cfg().optInt("bubbleTextColorLeft", defT)
                                : cfg().optInt("bubbleTextColorRight", defT);
                tintBubbleText(v, useT, 0);
            } else {
                android.graphics.Bitmap bm = bubbleBmp(left);
                if (bm != null) {
                    byte[] chunk = bm.getNinePatchChunk();
                    if (chunk != null && android.graphics.NinePatch.isNinePatchChunk(chunk)) {
                        v.setBackground(new android.graphics.drawable.NinePatchDrawable(
                                v.getResources(), bm, chunk, new android.graphics.Rect(), null));
                    }
                }
            }
            // 两种模式统一：应用用户指定的文字颜色
            int defTc2 = left ? 0xFF1A1E2B : 0xFFFFFFFF;   // 左白气泡黑字 / 右红气泡白字
            int userTc2 = left ? cfg().optInt("bubbleTextColorLeft", defTc2)
                               : cfg().optInt("bubbleTextColorRight", defTc2);
            tintBubbleText(v, userTc2, 0);
            log("NEAT|text " + (left ? "L" : "R") + " #" + Integer.toHexString(userTc2)
                    + " node=" + v.getClass().getSimpleName());
        } catch (Throwable t) { log("NEAT|err2 " + t); }
    }

    /** 一次性把聊天页行结构打进日志，用于精确定位气泡 */
    private static void dumpChatRows(final android.app.Activity act) {
        try {
            android.view.ViewGroup list = findMsgList(act.getWindow().getDecorView());
            if (list == null) { log("DUMP|no list"); return; }
            log("DUMP|list=" + list.getClass().getName() + " children=" + list.getChildCount());
            int shown = 0;
            for (int i = 0; i < list.getChildCount() && shown < 3; i++) {
                android.view.View row = list.getChildAt(i);
                if (!containsAvatar(row)) continue;
                StringBuilder sb = new StringBuilder("DUMP|row" + i + " " + row.getClass().getSimpleName()
                        + " " + row.getWidth() + "x" + row.getHeight() + " -> ");
                dumpNode(row, sb, 1, 6);
                log(sb.toString());
                shown++;
            }
            log("DUMP|done shown=" + shown);
        } catch (Throwable t) { log("DUMP|err " + t); }
    }

    private static void dumpNode(android.view.View v, StringBuilder sb, int depth, int maxDepth) {
        try {
            android.graphics.drawable.Drawable bg = v.getBackground();
            String text = "";
            if (v instanceof android.widget.TextView) {
                CharSequence c = ((android.widget.TextView) v).getText();
                if (c != null) {
                    text = c.toString().replace('\n', ' ');
                    if (text.length() > 14) text = text.substring(0, 14);
                }
            }
            sb.append('\n');
            for (int i = 0; i < depth; i++) sb.append("  ");
            sb.append(v.getClass().getSimpleName())
              .append(" [").append(v.getWidth()).append('x').append(v.getHeight()).append(']');
            if (bg != null) sb.append(" bg=").append(bg.getClass().getSimpleName());
            if (text.length() > 0) sb.append(" t=\"").append(text).append('"');
            if (depth >= maxDepth) return;
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount() && i < 6; i++) {
                    dumpNode(g.getChildAt(i), sb, depth + 1, maxDepth);
                }
            }
        } catch (Throwable ignore) { }
    }

    /** 让聊天列表重新绑定，旧消息也会走一遍气泡换色 */
    private static void refreshChatList(android.app.Activity act) {
        try {
            if (act == null) return;
            android.view.ViewGroup list = findMsgList(act.getWindow().getDecorView());
            if (list == null) return;
            Object ad = list.getClass().getMethod("getAdapter").invoke(list);
            if (ad == null) return;
            ad.getClass().getMethod("notifyDataSetChanged").invoke(ad);
            log("BUBBLECOLOR|refresh");
        } catch (Throwable t) { log("BUBBLECOLOR|refresh err " + t); }
    }

    /** 给气泡换色；left 为 null 时按位置推断 */
    private static void recolorBubble(android.view.View view, Boolean left) {
        try {
            if (view == null) return;
            android.view.ViewParent vp = view.getParent();
            boolean isLeft;
            if (left != null) isLeft = left.booleanValue();
            else {
                if (!(vp instanceof android.view.View)) return;
                int[] vl = new int[2];
                int[] pl = new int[2];
                view.getLocationOnScreen(vl);
                ((android.view.View) vp).getLocationOnScreen(pl);
                isLeft = (vl[0] + view.getWidth() / 2f) < (pl[0] + ((android.view.View) vp).getWidth() / 2f);
            }
            JSONObject cc = cfg();
            int color = isLeft ? cc.optInt("bubbleColorLeft", 0xFFFFFFFF)
                    : cc.optInt("bubbleColorRight", 0xFF95EC69);
            int lum = (((color >> 16) & 0xFF) * 299 + ((color >> 8) & 0xFF) * 587 + (color & 0xFF) * 114) / 1000;
            android.graphics.drawable.GradientDrawable gb = new android.graphics.drawable.GradientDrawable();
            gb.setColor(color);
            gb.setCornerRadius(dp(view.getContext(), 12));
            view.setBackground(gb);
            setTextColorDeep(view, lum > 150 ? 0xFF1A1E2B : 0xFFFFFFFF);
            log("BUBBLECOLOR|" + (isLeft ? "left" : "right"));
        } catch (Throwable t) { log("BUBBLECOLOR|err " + t); }
    }

    /** 判断是否是时间/系统提示（不应被当成消息气泡） */
    private static boolean isTimeText(String t) {
        if (t == null || t.length() == 0) return false;
        if (t.matches("^(昨天|前天|今天)?\\s*\\d{1,2}:\\d{2}$")) return true;
        if (t.matches("^\\d{1,2}:\\d{2}$")) return true;
        if (t.matches("^.*(月|日).*\\d{1,2}:\\d{2}.*$")) return true;
        if (t.matches("^(星期|周一|周二|周三|周四|周五|周六|周日).*")) return true;
        if (t.contains("撤回了一条消息") || t.contains("你撤回") || t.contains("以下是新消息")) return true;
        if (t.matches("^\\d{4}年.*")) return true;
        return false;
    }

    /** 气泡美化：2 开（默认）/ 0 关（原生） */
    private static int bubbleSkinStyle() {
        try {
            JSONObject c = cfg();
            if (c.has("bubbleSkin")) {
                Object v = c.get("bubbleSkin");
                if (v instanceof Boolean) return ((Boolean) v) ? 2 : 0;
                return c.optInt("bubbleSkin", 0) == 0 ? 0 : 2;
            }
            return 2;
        } catch (Throwable t) { return 2; }
    }

    private static boolean bubbleSkinOn() { return bubbleSkinStyle() != 0; }

    private static String bubbleSkinName() { return bubbleSkinStyle() == 0 ? "原生" : "开"; }

    private static boolean bubbleArtOn() {
        return themeOn() || bubbleSkinOn();
    }

    /** 气泡皮肤：只有圆角框 —— 左右各自填色 + 同色系细描边，无蜘蛛/蛛网/尾巴 */
    static class SkinBubble extends android.graphics.drawable.Drawable {
        private final float d;
        private final android.graphics.Paint fill = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
        private final android.graphics.Paint rim = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
        private final android.graphics.RectF rf = new android.graphics.RectF();

        SkinBubble(float density, int fillColor, int rimColor) {
            this.d = density <= 0 ? 1f : density;
            fill.setStyle(android.graphics.Paint.Style.FILL);
            fill.setColor(fillColor);
            rim.setStyle(android.graphics.Paint.Style.STROKE);
            rim.setStrokeWidth(1.1f * d);
            rim.setColor(rimColor);
        }

        @Override public void draw(android.graphics.Canvas c) {
            android.graphics.Rect b = getBounds();
            if (b.width() <= 0 || b.height() <= 0) return;
            float r = 12 * d;
            rf.set(b.left + 0.5f, b.top + 0.5f, b.right - 0.5f, b.bottom - 0.5f);
            c.drawRoundRect(rf, r, r, fill);
            c.drawRoundRect(rf, r, r, rim);
        }

        @Override public void setAlpha(int alpha) { fill.setAlpha(alpha); rim.setAlpha(alpha); }

        @Override public void setColorFilter(android.graphics.ColorFilter cf) {
            fill.setColorFilter(cf); rim.setColorFilter(cf);
        }

        @Override public int getOpacity() { return android.graphics.PixelFormat.TRANSLUCENT; }
    }

    private static final ThreadLocal<Boolean> skinGuard = new ThreadLocal<Boolean>();
    private static boolean bubblePaletteDone = false;

    /** 首次启用气泡美化时，把遗留的主题红/绿色值改成原生白 + 淡蓝，避免一上来就是一片红 */
    private static void ensureBubblePalette() {
        if (bubblePaletteDone) return;
        bubblePaletteDone = true;
        try {
            JSONObject c = cfg();
            if (c.optInt("bubblePalette", 0) == 1) return;
            setIntCfg("bubbleColorLeft", 0xFFFFFFFF);
            setIntCfg("bubbleColorRight", 0xFFDCEBFF);
            setIntCfg("bubblePalette", 1);
            log("BUBPAL|reset");
        } catch (Throwable ignore) { }
    }

    /** 皮肤气泡图 + 9-patch 背景（成功返回 true） */
    /** 气泡附近的祖先里有没有系统提示文字（撤回/打招呼/入群）：有就不套皮 */
    private static boolean nearSysTip(android.view.View v) {
        try {
            android.view.View anc = v;
            for (int up = 0; up < 3 && anc != null; up++) {
                java.util.ArrayList<android.widget.TextView> ts = new java.util.ArrayList<android.widget.TextView>();
                collectTexts(anc, ts, 0);
                if (ts.size() <= 6) {
                    for (android.widget.TextView t : ts) {
                        String s = String.valueOf(t.getText());
                        if (s.contains("撤回了一条消息") || s.contains("以上是") || s.contains("已添加了")
                                || s.contains("加入了群聊") || s.contains("邀请你加入了")
                                || s.contains("开启了朋友验证") || s.contains("你已添加")) return true;
                    }
                }
                android.view.ViewParent p = anc.getParent();
                anc = (p instanceof android.view.View) ? (android.view.View) p : null;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    /** 这一行（气泡所在的行）有没有头像：系统提示 / 撤回提示 / 时间行没有头像，不能套气泡皮 */
    private static boolean bubbleRowHasAvatar(android.view.View v) {
        try {
            android.view.View anc = v;
            for (int up = 0; up < 7 && anc != null; up++) {
                if (scanAvatarView(anc, 0)) return true;
                android.view.ViewParent p = anc.getParent();
                anc = (p instanceof android.view.View) ? (android.view.View) p : null;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    private static boolean scanAvatarView(android.view.View v, int d) {
        if (v == null || d > 10) return false;
        String cn = v.getClass().getName();
        if (cn.contains("Avatar") || cn.contains("avatar")) return true;
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                if (scanAvatarView(g.getChildAt(i), d + 1)) return true;
            }
        }
        return false;
    }

    private static boolean applyBubbleSkin(android.view.View v, boolean left) {
        try {
            if (!bubbleSkinOn()) return false;
            if (nearSysTip(v)) return false;
            // 居中的气泡（系统提示 / 时间）保持原生，真实消息永远靠左或靠右
            if (bubbleCentered(v, null)) return false;
            // 系统提示行（"你已添加了…"、"你撤回了一条消息" 等）没有头像，保持原生，不套气泡皮
            if (!bubbleRowHasAvatar(v)) return false;
            // 时间标签 / 系统提示不套气泡皮（用户在聊天页要原生时间样式）
            try {
                if (v instanceof android.widget.TextView) {
                    CharSequence cs = ((android.widget.TextView) v).getText();
                    if (cs != null && isTimeText(cs.toString())) return false;
                    // 系统提示（"你撤回了一条消息" / "你已添加了…" / 入群提示）保持原生
                    String sx = cs == null ? "" : cs.toString();
                    int gx = ((android.widget.TextView) v).getGravity() & android.view.Gravity.HORIZONTAL_GRAVITY_MASK;
                    boolean sysTxt = sx.contains("撤回了一条消息") || sx.contains("以上是")
                            || sx.contains("已添加了") || sx.contains("加入了群聊")
                            || sx.contains("邀请你加入了") || sx.contains("开启了朋友验证")
                            || sx.contains("你已添加") || sx.contains("以下是");
                    if (sysTxt) return false;
                    if (gx == android.view.Gravity.CENTER && !bubbleRowHasAvatar(v)) return false;
                }
            } catch (Throwable ignore) { }
            ensureBubblePalette();
            float dd = v.getResources().getDisplayMetrics().density;
            JSONObject bc = cfg();
            int fillC = left ? bc.optInt("bubbleColorLeft", 0xFFFFFFFF)
                    : bc.optInt("bubbleColorRight", 0xFF95EC69);
            int rimC = 0xFF000000 | (((fillC >> 16) & 0xFF) * 72 / 100 << 16)
                    | (((fillC >> 8) & 0xFF) * 72 / 100 << 8) | ((fillC & 0xFF) * 72 / 100);
            if (v.getTag(0x0f0f0f04) == null) {
                v.setTag(0x0f0f0f04, new int[]{v.getPaddingLeft(), v.getPaddingTop(),
                        v.getPaddingRight(), v.getPaddingBottom()});
            }
            skinGuard.set(Boolean.TRUE);
            try {
                v.setBackground(new SkinBubble(dd, fillC, rimC));
            } finally { skinGuard.set(Boolean.FALSE); }
            v.setPadding((int) (14 * dd), (int) (9 * dd), (int) (14 * dd), (int) (12 * dd));
            if (v instanceof android.widget.TextView) {
                int lum = (((fillC >> 16) & 0xFF) * 299 + ((fillC >> 8) & 0xFF) * 587
                        + (fillC & 0xFF) * 114) / 1000;
                ((android.widget.TextView) v).setTextColor(lum > 150 ? 0xFF1A1E2B : 0xFFFFFFFF);
            }
            v.setTag(0x0f0f0f03, "skin:" + fillC + ":" + left);
            v.requestLayout();
            v.invalidate();
            return true;
        } catch (Throwable t) { return false; }
    }

    /** 气泡模式：0 关 / 1 图片 / 2 纯色 */
    private static int bubbleMode(JSONObject c) {
        try {
            if (c != null && c.optBoolean("bubbleSkin", true)) return 2;
            if (c.has("bubbleMode")) return c.optInt("bubbleMode", 0);
            return 0;

        } catch (Throwable t) { return 0; }
    }

    /** 纯色气泡配色（左, 右） */
    private static int[] bubbleColors(int idx) {
        switch (idx) {
            case 0: return new int[]{0xFFFFFFFF, 0xFF95EC69};
            case 1: return new int[]{0xFFF7F7FA, 0xFF07C160};
            case 2: return new int[]{0xFFFFFFFF, 0xFF1E88E5};
            case 3: return new int[]{0xFF2C2C2E, 0xFF0A84FF};
            default: return new int[]{0xFFFFFFFF, 0xFF95EC69};
        }
    }

    /** 在聊天页给气泡套主题（定时调用，做缓存避免重复） */
    private static void themeBubblesTick(android.app.Activity act) {
        // 气泡改色已停用：此前的实现会误伤会话列表，先彻底关闭
    }

    private static boolean hasText(android.view.View v) {
        try {
            if (v instanceof android.widget.TextView) {
                CharSequence c = ((android.widget.TextView) v).getText();
                if (c != null && c.length() > 0) return true;
            }
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    if (hasText(g.getChildAt(i))) return true;
                }
            }
        } catch (Throwable ignore) { }
        return false;
    }

    private static void setTextColorDeep(android.view.View v, int color) {
        try {
            if (v instanceof android.widget.TextView) ((android.widget.TextView) v).setTextColor(color);
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) setTextColorDeep(g.getChildAt(i), color);
            }
        } catch (Throwable ignore) { }
    }

    // ================= 列表配色 / 圆角头像 =================
    private static long lastListTick = 0;

    private static int colorFromHex(String hex, int def) {
        try {
            if (hex == null || hex.length() < 6) return def;
            String h = hex.startsWith("#") ? hex.substring(1) : hex;
            if (h.length() > 6) h = h.substring(h.length() - 6);
            return (int) (Long.parseLong(h, 16) | 0xFF000000);
        } catch (Throwable t) { return def; }
    }

    /** 只在屏幕底部区域内找文字（避免匹配到标题栏） */
    private static android.widget.TextView findTextBottom(android.view.View root, final String want, final int minY) {
        final android.widget.TextView[] out = {null};
        java.util.ArrayList<android.widget.TextView> tvs = new java.util.ArrayList<android.widget.TextView>();
        collectTexts(root, tvs, 0);
        int[] loc = new int[2];
        for (android.widget.TextView tv : tvs) {
            try {
                CharSequence c = tv.getText();
                if (c == null || !want.equals(c.toString().trim())) continue;
                tv.getLocationOnScreen(loc);
                if (loc[1] < minY) continue;
                if (out[0] == null || loc[1] > 0) { out[0] = tv; break; }
            } catch (Throwable ignore) { }
        }
        return out[0];
    }

    private static int currentTabIndex(android.app.Activity act) {
        try {
            android.content.Intent it = act.getIntent();
            java.lang.reflect.Method m = act.getClass().getMethod("getCurrentTabIndex");
            m.setAccessible(true);
            Object v = m.invoke(act);
            if (v instanceof Integer) return (Integer) v;
        } catch (Throwable ignore) { }
        return 0;
    }

    /** 给聊天页 / 朋友圈页铺很淡的主题背景 */
    private static void applyPageBackground(android.app.Activity act, boolean chat) {
        try {
            if (act == null || !themeOn()) return;
            if (false) return;   // 旧方案已删除
            String path = themeBg("MainFragmentBackground");
            if (path == null) return;
            android.view.View root = act.getWindow().getDecorView();
            if (root.findViewWithTag("wxhWeld") != null) return;   // 已经焊好，别再叠一层
            android.view.View target = chat ? findMsgList(root) : findConvListView(root, 0);
            if (target == null) return;
            if (target.getTag(0x0f0f0f33) != null) return;
            android.graphics.Bitmap bm = android.graphics.BitmapFactory.decodeFile(path);
            if (bm == null) return;
            android.graphics.drawable.BitmapDrawable bd =
                    new android.graphics.drawable.BitmapDrawable(act.getResources(), bm);
            bd.setAlpha(chat ? 38 : 26);
            target.setBackground(bd);
            target.setTag(0x0f0f0f33, Boolean.TRUE);
            if (!chat) {
                try {
                    JSONObject pk = themePack();
                    if (pk != null) {
                        int bar = colorFromHex(pk.optString("ActionBarColor", ""), 0);
                        if (bar != 0) {
                            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
                            collectAllViews(root, all, 0);
                            int limitY = (int) (act.getResources().getDisplayMetrics().heightPixels * 0.14f);
                            int[] loc = new int[2];
                            for (android.view.View v : all) {
                                if (v == root) continue;
                                v.getLocationOnScreen(loc);
                                if (loc[1] > limitY) continue;
                                if (v.getWidth() < act.getResources().getDisplayMetrics().widthPixels * 0.9f) continue;
                                if (v.getHeight() <= 0 || v.getHeight() > limitY) continue;
                                if (v.getTag(0x0f0f0f34) != null) continue;
                                v.setBackgroundColor(bar);
                                v.setTag(0x0f0f0f34, Boolean.TRUE);
                            }
                        }
                    }
                } catch (Throwable ignore) { }
            }
            log("PAGEBG|" + (chat ? "chat" : "sns"));
        } catch (Throwable t) { log("PAGEBG|err " + t); }
    }

    /** 清掉主题相关标记，让下一次 tick 重新应用 */
    private static void resetThemeMarks(android.app.Activity a) {
        try {
            themedBubbles.clear();
            lastListTick = 0;
            lastBubbleTick = 0;
            final android.view.View decor = a.getWindow().getDecorView();
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(decor, all, 0);
            for (android.view.View v : all) {
                // 只清我们自己的 keyed 标记，绝不碰微信的无 key tag（会引发 ClassCastException 崩溃）
                if (v.getTag(0x0f0f0f32) != null) {
                    v.setVisibility(android.view.View.VISIBLE);
                    v.setTag(0x0f0f0f32, null);
                }
                v.setTag(0x0f0f0f31, null);
                v.setTag(0x0f0f0f33, null);
                v.setTag(0x0f0f0f34, null);
                v.setTag(0x0f0f0f37, null);
            }
            // 侧滑抽屉功能已整体移除
            try {
                if (cfg().optBoolean("", true)) showOverlayFab(a);
                else hideOverlayFab();
            } catch (Throwable ignore) { }
            // 底栏图标/文字即时重套
            final android.app.Activity fa2 = a;
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() { try { applyTabChrome(fa2); } catch (Throwable ignore) { } }
            }, 150);
            toast("已更新，若未立即生效请重进页面");
        } catch (Throwable ignore) { }
    }

    private static long lastChromeAt = 0;

    /** 底栏图标 + 隐藏文字（不依赖焦点，布局完成即执行） */
    private static void applyTabChrome(final android.app.Activity act) {
        try {
            JSONObject p = themePack();
            if (p == null || !themeOn()) return;
            boolean hideLabel = p.optBoolean("HideBottomTabLabel", false)
                    || cfg().optBoolean("thHideTabLabel", false);
            if (hideLabel) {
                android.view.View decor = act.getWindow().getDecorView();
                int screenH = act.getResources().getDisplayMetrics().heightPixels;
                String[] labels = {"微信", "通讯录", "发现", "我"};
                java.util.ArrayList<android.widget.TextView> tvs = new java.util.ArrayList<android.widget.TextView>();
                collectTexts(decor, tvs, 0);
                int[] loc = new int[2];
                for (android.widget.TextView tv : tvs) {
                    try {
                        CharSequence cs = tv.getText();
                        if (cs == null) continue;
                        String tx = cs.toString().trim();
                        if (tx.length() == 0) continue;
                        tv.getLocationOnScreen(loc);
                        if (loc[1] < screenH * 0.86f) continue;
                        for (String lb : labels) {
                            if (tx.startsWith(lb)) {        // 微信(1) / 通讯录 都命中
                                tv.setTag(0x0f0f0f61, tx);
                                tv.setText("");
                                tv.setVisibility(android.view.View.GONE);
                                hideTabLabels(tv);
                                break;
                            }
                        }
                    } catch (Throwable ignore) { }
                }
            }
        } catch (Throwable t) { log("CHROME|" + t); }
    }

    /** 给主界面挂布局监听：每次布局完成立刻套底栏主题（第一帧就是最终样子） */
    private static void attachChromeListener(final android.app.Activity act) {
        try {
            final android.view.View decor = act.getWindow().getDecorView();
            if (decor.getTag(0x0f0f0f35) != null) return;
            decor.setTag(0x0f0f0f35, Boolean.TRUE);
            decor.addOnLayoutChangeListener(new android.view.View.OnLayoutChangeListener() {
                @Override public void onLayoutChange(android.view.View v, int l, int t, int r, int b,
                                                     int ol, int ot, int or, int ob) {
                    long now = System.currentTimeMillis();
                    if (now - lastChromeAt < 300) return;
                    lastChromeAt = now;
                    try { applyTabChrome(act); } catch (Throwable ignore) { }
                    try {
                        android.view.View fab = v.findViewWithTag("wxhFab");
                        if (fab != null && fab.getParent() instanceof android.view.ViewGroup) {
                            ((android.view.ViewGroup) fab.getParent()).bringChildToFront(fab);
                        }
                    } catch (Throwable ignore) { }
                }
            });
            log("CHROME|listener attached");
        } catch (Throwable t) { log("CHROME|attach " + t); }
    }

    /** 判断控件是否在会话列表里 */
    private static boolean inConvList(android.view.View v) {
        try {
            android.view.ViewParent p0 = v.getParent();
            int guard = 0;
            while (p0 != null && guard++ < 14) {
                if (p0.getClass().getName().contains("ConversationListView")) return true;
                if (p0 instanceof android.view.View) p0 = ((android.view.View) p0).getParent();
                else return false;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    /** 判断 ImageView 是否像头像（36~84dp、接近正方形、不在图片浏览/朋友圈里） */
    private static int avatarDbg = 0;

    private static boolean looksLikeAvatar(android.view.View v) {
        try {
            int w = v.getWidth(), h = v.getHeight();
            // setImage 时还没测量，宽高为 0 —— 退回去读 LayoutParams
            if (w <= 0 || h <= 0) {
                android.view.ViewGroup.LayoutParams lp = v.getLayoutParams();
                if (lp != null && lp.width > 0 && lp.height > 0) { w = lp.width; h = lp.height; }
            }
            if (w <= 0 || h <= 0) return false;
            float d = v.getResources().getDisplayMetrics().density;
            int min = (int) (36 * d), max = (int) (84 * d);
            if (w < min || w > max) return false;
            float r = (float) w / (float) h;
            if (r < 0.78f || r > 1.28f) return false;
            android.view.ViewParent pv = v.getParent();
            int depth = 0;
            while (pv instanceof android.view.View && depth < 8) {
                String cn = pv.getClass().getName().toLowerCase();
                if (cn.contains("sns") || cn.contains("gallery") || cn.contains("imagebrowser")
                        || cn.contains("videoview") || cn.contains("preview")) return false;
                pv = ((android.view.View) pv).getParent();
                depth++;
            }
            return true;
        } catch (Throwable t) { return false; }
    }

    /** 把 ImageView 的 drawable 包成圆形绘制（不依赖测量尺寸） */
    private static class RoundDraw extends android.graphics.drawable.Drawable {
        private final android.graphics.drawable.Drawable src;
        private final android.graphics.Paint pt = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
        private final android.graphics.RectF rf = new android.graphics.RectF();
        private final android.graphics.Path clip = new android.graphics.Path();
        RoundDraw(android.graphics.drawable.Drawable d) { src = d; }
        @Override public void draw(android.graphics.Canvas c) {
            android.graphics.Rect b = getBounds();
            if (b.width() <= 0 || b.height() <= 0) return;
            int save = c.save();
            clip.reset();
            rf.set(b);
            clip.addOval(rf, android.graphics.Path.Direction.CW);
            c.clipPath(clip);
            src.setBounds(b);
            src.draw(c);
            c.restoreToCount(save);
        }
        @Override public void setAlpha(int a) { src.setAlpha(a); }
        @Override public void setColorFilter(android.graphics.ColorFilter cf) { src.setColorFilter(cf); }
        @Override public int getOpacity() { return android.graphics.PixelFormat.TRANSLUCENT; }
    }

    private static void makeRound(android.view.View iv) {
        try {
            Object mk = iv.getTag(0x0f0f0f78);
            if ("r".equals(mk)) return;
            iv.setOutlineProvider(new android.view.ViewOutlineProvider() {
                @Override public void getOutline(android.view.View v, android.graphics.Outline o) {
                    int w = v.getWidth(), h = v.getHeight();
                    if (w > 0 && h > 0) o.setOval(0, 0, w, h);
                }
            });
            iv.setClipToOutline(true);
            // 双保险：把图片本身包成圆形绘制
            if (iv instanceof android.widget.ImageView) {
                android.widget.ImageView imv = (android.widget.ImageView) iv;
                android.graphics.drawable.Drawable dd0 = imv.getDrawable();
                if (dd0 != null && !(dd0 instanceof RoundDraw)) {
                    imv.setImageDrawable(new RoundDraw(dd0));
                }
            }
            iv.setTag(0x0f0f0f78, "r");
        } catch (Throwable ignore) { }
    }

    /** 拦截头像图片设置：图一设上就立刻圆裁 */
    private static void installAvatarRound(ClassLoader app) {
        final java.util.concurrent.atomic.AtomicBoolean done =
                new java.util.concurrent.atomic.AtomicBoolean(false);
        if (!done.compareAndSet(false, true)) return;
        try {
            Class<?> iv = Class.forName("android.widget.ImageView", false, app);
            XC_MethodHook h = new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("thRoundAvatar", true)) return;
                        Object o = p.thisObject;
                        if (!(o instanceof android.view.View)) return;
                        android.view.View v = (android.view.View) o;
                        if (!(v instanceof android.widget.ImageView)) return;
                        final android.view.View vv = v;
                        // setImage 时控件还没测量（0x0），延后到布局完成再判断
                        vv.post(new Runnable() {
                            @Override public void run() {
                                try {
                                    if (inConvList(vv) || looksLikeAvatar(vv)) makeRound(vv);
                                } catch (Throwable ignore) { }
                            }
                        });
                    } catch (Throwable ignore) { }
                }
            };
            try { XposedBridge.hookAllMethods(iv, "setImageDrawable", h); } catch (Throwable ignore) { }
            try { XposedBridge.hookAllMethods(iv, "setImageBitmap", h); } catch (Throwable ignore) { }
            try { XposedBridge.hookAllMethods(iv, "setImageResource", h); } catch (Throwable ignore) { }
            log("hooked avatar round");
        } catch (Throwable t) { log("avatar round err " + t); }
    }

    /** 会话行渲染时立即套主题，避免延迟 */
    private static void applyRowTheme(android.view.View row) {
        try {
            if (row == null) return;
            if (!themeOn()) return;
            JSONObject p = themePack();
            if (p == null) return;
            if (cfg().optBoolean("thRoundAvatar", true) && p.optBoolean("UseRoundAvatar", false)) {
                if (row.getTag(0x0f0f0f31) == null) {
                    java.util.ArrayList<android.widget.ImageView> ivs = new java.util.ArrayList<android.widget.ImageView>();
                    collectImages(row, ivs, 0);
                    for (android.widget.ImageView iv : ivs) {
                        try {
                            iv.setOutlineProvider(new android.view.ViewOutlineProvider() {
                                @Override public void getOutline(android.view.View v, android.graphics.Outline o) {
                                    o.setOval(0, 0, v.getWidth(), v.getHeight());
                                }
                            });
                            iv.setClipToOutline(true);
                        } catch (Throwable ignore) { }
                    }
                    row.setTag(0x0f0f0f31, Boolean.TRUE);
                }
            }
            {
                int rowBg = colorFromHex(p.optString("FragmentItemViewBackgroundColor", ""), 0);
                if (rowBg != 0) {
                    // 主题包给的是全透明；微信里全透明会让深色文字难读，
                    // 这里改成 85% 白，既能看到一点主题图又保证可读
                    if ((rowBg >>> 24) == 0) {
                        // 主题包给的是全透明：按 thRowAlpha 决定透明度（0=完全透，能看见壁纸）
                        int ta = cfg().optInt("thRowAlpha", 0);
                        if (ta < 0) ta = 0; if (ta > 255) ta = 255;
                        row.setBackgroundColor((ta << 24) | 0x00FFFFFF);
                    } else row.setBackgroundColor(rowBg);
                }
            }
            int titleC = colorFromHex(p.optString("FragmentItemViewTitleColor", ""), 0);
            int subC = colorFromHex(p.optString("FragmentItemViewSubTitleColor", ""), 0);
            if (titleC != 0 || subC != 0) {
                java.util.ArrayList<android.widget.TextView> tvs = new java.util.ArrayList<android.widget.TextView>();
                collectTexts(row, tvs, 0);
                float maxSize = -1;
                android.widget.TextView title = null;
                for (android.widget.TextView tv : tvs) {
                    if (tv.getText() != null && tv.getTextSize() > maxSize) { maxSize = tv.getTextSize(); title = tv; }
                }
                if (titleC != 0 && title != null) title.setTextColor(titleC);
                if (subC != 0) for (android.widget.TextView tv : tvs) if (tv != title && tv.getText() != null) tv.setTextColor(subC);
            }
        } catch (Throwable ignore) { }
    }

    /** 找到底部 tab 栏（结构定位，不依赖文字） */
    private static android.view.ViewGroup findTabBar(android.view.View root, int screenH) {
        java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
        collectAllViews(root, all, 0);
        android.view.ViewGroup best = null;
        int bestTop = -1;
        int[] loc = new int[2];
        for (android.view.View v : all) {
            if (!(v instanceof android.view.ViewGroup)) continue;
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            int n = g.getChildCount();
            if (n < 4 || n > 6) continue;
            try { g.getLocationOnScreen(loc); } catch (Throwable ignore) { continue; }
            if (loc[1] < screenH * 0.86f) continue;
            if (g.getHeight() <= 0 || g.getHeight() > screenH * 0.12f) continue;
            // 每个子项里要有 ImageView
            int withIcon = 0;
            for (int i = 0; i < n; i++) {
                android.view.View c = g.getChildAt(i);
                java.util.ArrayList<android.widget.ImageView> ivs = new java.util.ArrayList<android.widget.ImageView>();
                collectImages(c, ivs, 0);
                if (!ivs.isEmpty()) withIcon++;
            }
            if (withIcon < 4) continue;
            if (loc[1] > bestTop) { bestTop = loc[1]; best = g; }
        }
        return best;
    }

    /** 用主题包里的图标替换底部 tab 图标（按顺序：微信/通讯录/发现/我） */
    private static void applyTabIcons(android.app.Activity act, JSONObject pack) {
        if (true) return;   // 底栏图标功能已删除
        try {
            if (!cfg().optBoolean("thTabIcons", false)) return;
            android.view.View decor = act.getWindow().getDecorView();
            int screenH = act.getResources().getDisplayMetrics().heightPixels;
            android.view.ViewGroup bar = findTabBar(decor, screenH);
            if (bar == null) { log("TABIC|no bar"); return; }
            String[] files = {"TabWeChat.png", "TabContacts.png", "TabDiscover.png", "TabMe.png"};
            String base = cfg().optString("themePack", DIR + "/wxh_theme") + "/icons/";
            int sel = currentTabIndex(act);
            int done = 0;
            int n = Math.min(bar.getChildCount(), files.length);
            for (int i = 0; i < n; i++) {
                android.view.View cell = bar.getChildAt(i);
                if (!(cell instanceof android.view.ViewGroup)) continue;
                java.util.ArrayList<android.widget.ImageView> ivs = new java.util.ArrayList<android.widget.ImageView>();
                collectImages(cell, ivs, 0);
                if (ivs.isEmpty()) continue;
                android.widget.ImageView iv = ivs.get(0);
                if (iv.getTag(0x0f0f0f37) != null) continue;
                java.io.File f = new java.io.File(base + files[i]);
                if (!f.isFile()) continue;
                android.graphics.Bitmap bm = android.graphics.BitmapFactory.decodeFile(f.getAbsolutePath());
                if (bm == null) continue;
                iv.setImageBitmap(bm);
                try {
                    if (cfg().optBoolean("thTabTint", false)) {
                        int col = (sel == i) ? 0xFF07C160 : 0xFF8A8A8E;
                        iv.setColorFilter(new android.graphics.PorterDuffColorFilter(col,
                                android.graphics.PorterDuff.Mode.SRC_IN));
                    } else {
                        iv.setColorFilter(null);
                    }
                } catch (Throwable ignore) { }
                iv.setTag(0x0f0f0f37, Boolean.TRUE);
                done++;
            }
            if (done > 0) log("TABIC|applied " + done + " sel=" + sel);
        } catch (Throwable t) { log("TABIC|" + t); }
    }

    /** 只在屏幕底部区域内找文字（避免匹配到标题栏） */

    private static void themeListTick(android.app.Activity act) {
        try {
            if (!themeOn()) return;
            if (act == null || !act.hasWindowFocus()) return;
            if (!themeOn()) return;
            long now = System.currentTimeMillis();
            if (now - lastListTick < 1500) return;
            lastListTick = now;
            JSONObject p = themePack();
            if (p == null) return;
            int titleC = colorFromHex(p.optString("FragmentItemViewTitleColor", ""), 0);
            int subC = colorFromHex(p.optString("FragmentItemViewSubTitleColor", ""), 0);
            boolean round = p.optBoolean("UseRoundAvatar", false) && cfg().optBoolean("thRoundAvatar", true);
            // 隐藏下拉小程序栏
            try {
                if (p.optBoolean("HidePullDownAppBrand", false)) {
                    android.view.View decor2 = act.getWindow().getDecorView();
                    java.util.ArrayList<android.view.View> all2 = new java.util.ArrayList<android.view.View>();
                    collectAllViews(decor2, all2, 0);
                    int hpx = act.getResources().getDisplayMetrics().heightPixels;
                    for (android.view.View v : all2) {
                        if (!(v instanceof android.widget.TextView)) continue;
                        CharSequence t2 = ((android.widget.TextView) v).getText();
                        if (t2 == null) continue;
                        String ts = t2.toString();
                        if (!ts.contains("最近使用") && !ts.contains("下拉")) continue;
                        int[] loc2 = new int[2];
                        v.getLocationOnScreen(loc2);
                        if (loc2[1] > hpx * 0.35f) continue;
                        android.view.View row = v;
                        for (int up = 0; up < 4 && row != null; up++) {
                            android.view.ViewParent vp = row.getParent();
                            if (!(vp instanceof android.view.View)) break;
                            row = (android.view.View) vp;
                        }
                        if (row != null) { row.setTag(0x0f0f0f32, Boolean.TRUE); row.setVisibility(android.view.View.GONE); }
                    }
                }
            } catch (Throwable ignore) { }

            // 底部 tab 文本色 / 隐藏标签
            try {
                boolean tabColorOn = p.optBoolean("TabLayoutEnable", false);
                int tabColor = colorFromHex(p.optString("TabLayoutColor", ""), 0);
                boolean hideLabel = p.optBoolean("HideBottomTabLabel", false)
                        || cfg().optBoolean("thHideTabLabel", false);
                if (tabColorOn || hideLabel) {
                    String[] labels = {"微信", "通讯录", "发现", "我"};
                    for (String lb : labels) {
                        android.widget.TextView tv = findText(act.getWindow().getDecorView(), lb);
                        if (tv == null) continue;
                        if (hideLabel) tv.setVisibility(android.view.View.GONE);
                        else {
                            if (tv.getVisibility() != android.view.View.VISIBLE) tv.setVisibility(android.view.View.VISIBLE);
                            if (tabColor != 0) tv.setTextColor(tabColor);
                        }
                    }
                }
            } catch (Throwable ignore) { }

            // 隐藏标题栏搜索 / 加号
            try {
                if (cfg().optBoolean("thHideSearch", true)) {
                    final android.view.View decor = act.getWindow().getDecorView();
                    int[] limit = {0};
                    java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
                    collectAllViews(decor, all, 0);
                    for (android.view.View v : all) {
                        CharSequence cd = v.getContentDescription();
                        if (cd == null) continue;
                        String d = cd.toString();
                        int[] loc = new int[2];
                        v.getLocationOnScreen(loc);
                        if (loc[1] > act.getResources().getDisplayMetrics().heightPixels * 0.12f) continue;
                        if (cfg().optBoolean("thHideSearch", true) && d.contains("搜索")) {
                            v.setTag(0x0f0f0f32, Boolean.TRUE);
                            v.setVisibility(android.view.View.GONE);
                        } else if (p.optBoolean("HideActionBarPlusMenu", false)
                                && (d.contains("更多") || d.contains("添加"))) {
                            v.setTag(0x0f0f0f32, Boolean.TRUE);
                            v.setVisibility(android.view.View.GONE);
                        }
                    }
                }
            } catch (Throwable ignore) { }

            android.view.View lv = findConvListView(act.getWindow().getDecorView(), 0);
            if (!(lv instanceof android.view.ViewGroup)) return;
            android.view.ViewGroup g = (android.view.ViewGroup) lv;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View row = g.getChildAt(i);
                if (row == null || row.getHeight() == 0) continue;
                java.util.ArrayList<android.widget.TextView> tvs = new java.util.ArrayList<android.widget.TextView>();
                java.util.ArrayList<android.widget.ImageView> ivs = new java.util.ArrayList<android.widget.ImageView>();
                collectTexts(row, tvs, 0);
                collectImages(row, ivs, 0);
                float maxSize = -1;
                android.widget.TextView title = null;
                for (android.widget.TextView tv : tvs) {
                    if (tv.getTextSize() > maxSize && tv.getText() != null) { maxSize = tv.getTextSize(); title = tv; }
                }
                if (titleC != 0 && title != null) title.setTextColor(titleC);
                if (subC != 0) {
                    for (android.widget.TextView tv : tvs) {
                        if (tv != title && tv.getText() != null) tv.setTextColor(subC);
                    }
                }
                // 列表项背景色（主题包 FragmentItemViewBackgroundColor）
                try {
                    if (false) {   // 列表行透明旧方案已删除
                        int rowBg = colorFromHex(p.optString("FragmentItemViewBackgroundColor", ""), 0);
                        if (rowBg != 0) row.setBackgroundColor(rowBg);
                    }
                } catch (Throwable ignore) { }

                if (round) {
                    for (android.widget.ImageView iv : ivs) {
                        if (iv.getTag(0x0f0f0f38) != null) continue;
                        try {
                            iv.setOutlineProvider(new android.view.ViewOutlineProvider() {
                                @Override public void getOutline(android.view.View v, android.graphics.Outline o) {
                                    o.setOval(0, 0, v.getWidth(), v.getHeight());
                                }
                            });
                            iv.setClipToOutline(true);
                            iv.setTag(0x0f0f0f38, Boolean.TRUE);
                        } catch (Throwable ignore) { }
                    }
                }
            }
        } catch (Throwable t) { log("THEMELIST|" + t); }
    }

    private static void collectAllViews(android.view.View v, java.util.List<android.view.View> out, int depth) {
        if (depth > 12 || v == null) return;
        out.add(v);
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) collectAllViews(g.getChildAt(i), out, depth + 1);
        }
    }

    private static void collectImages(android.view.View v, java.util.List<android.widget.ImageView> out, int depth) {
        if (depth > 8) return;
        try {
            if (v instanceof android.widget.ImageView) out.add((android.widget.ImageView) v);
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) collectImages(g.getChildAt(i), out, depth + 1);
            }
        } catch (Throwable ignore) { }
    }

    // ================= 主题抽屉 =================
    private static final java.util.concurrent.atomic.AtomicBoolean drawerInstalled =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    // 从朋友圈回来时切回「微信」页
    private static volatile boolean pendingReturnToChats = false;
    private static volatile boolean openingMoments = false;

    private static void switchToChats(android.app.Activity act) {
        try {
            android.view.View vp = findByClassLike(act.getWindow().getDecorView(), "ViewPager", 0);
            if (vp == null) return;
            java.lang.reflect.Method m = vp.getClass().getMethod("setCurrentItem", int.class, boolean.class);
            m.setAccessible(true);
            m.invoke(vp, 0, false);
            log("MOMENTS|back to chats");
        } catch (Throwable t) { log("MOMENTS|back err " + t); }
    }

    // 抽屉滑动手势
    private static float swX = 0, swY = 0;
    private static float plusLPX = 0, plusLPY = 0;
    private static long plusLPAt = 0;
    private static long swT = 0;

    private static void closeDrawer(android.app.Activity act) {
        try {
            android.view.View decor = act.getWindow().getDecorView();
            if (!(decor instanceof android.view.ViewGroup)) return;
            android.view.View w = ((android.view.ViewGroup) decor).findViewWithTag("wxhDrawerWrap");
            if (w != null) ((android.view.ViewGroup) decor).removeView(w);
        } catch (Throwable ignore) { }
    }

    private static final java.util.concurrent.atomic.AtomicBoolean swipeInstalled =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    /** 聊天列表挂生日悬浮球：LauncherUI 每次 resume 检查一次 */
    private static void installBdayPillHook(final ClassLoader app) {
        try {
            Class<?> c = Class.forName("com.tencent.mm.ui.LauncherUI", false, app);
            XposedBridge.hookAllMethods(c, "onResume", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (!(p.thisObject instanceof android.app.Activity)) return;
                        ensureBdayPill((android.app.Activity) p.thisObject);
                    } catch (Throwable ignore) { }
                }
            });
            // 切 tab 时要跟着藏/显：微信底部四个 tab 走 ViewPager.setCurrentItem
            for (String vpName : new String[]{"androidx.viewpager.widget.ViewPager",
                    "android.support.v4.view.ViewPager"}) {
                try {
                    Class<?> vp = Class.forName(vpName, false, app);
                    XposedBridge.hookAllMethods(vp, "setCurrentItem", new XC_MethodHook() {
                        @Override protected void afterHookedMethod(MethodHookParam p) {
                            try {
                                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
                                        new Runnable() {
                                            @Override public void run() { bdayPillSync(); }
                                        }, 130);
                            } catch (Throwable ignore) { }
                        }
                    });
                } catch (Throwable ignore) { }
            }
            log("BDAY|pill hook installed");
        } catch (Throwable t) { log("BDAY|pill hook err " + t); }
    }

    /** 当前是微信第几个 tab（0=聊天，1=通讯录，2=发现，3=我） */
    private static int bdayTabIndex(android.app.Activity act) {
        try {
            android.view.View vp = findByClassLike(act.getWindow().getDecorView(), "ViewPager", 0);
            if (vp == null) return 0;
            Object ci = vp.getClass().getMethod("getCurrentItem").invoke(vp);
            return ci instanceof Integer ? (Integer) ci : 0;
        } catch (Throwable t) { return 0; }
    }

    /** 只在「聊天」那一页显示生日球，其它 tab / 其它页面一律藏起来 */
    private static void bdayPillSync() {
        try {
            android.app.Activity act = bdayActRef == null ? null : bdayActRef.get();
            if (act == null || act.isFinishing()) return;
            if (!act.getClass().getName().contains("LauncherUI")) return;
            ensureBdayPill(act);
        } catch (Throwable ignore) { }
    }

    private static void installDrawerSwipe(ClassLoader app) {
        if (!swipeInstalled.compareAndSet(false, true)) return;
        try {
            Class<?> c = Class.forName("com.tencent.mm.ui.LauncherUI", false, app);
            XposedBridge.hookAllMethods(c, "dispatchTouchEvent", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!(p.thisObject instanceof android.app.Activity)) return;
                        final android.app.Activity act = (android.app.Activity) p.thisObject;
                        try { ensureBdayPill(act); } catch (Throwable ignore) { }
                        android.view.MotionEvent ev = (android.view.MotionEvent) p.args[0];
                        int a0 = ev.getActionMasked();
                        float density = act.getResources().getDisplayMetrics().density;
                        if (a0 == android.view.MotionEvent.ACTION_DOWN) {
                            swX = ev.getRawX();
                            swY = ev.getRawY();
                            swT = System.currentTimeMillis();
                            plusLPX = swX; plusLPY = swY; plusLPAt = swT;
                        } else if (a0 == android.view.MotionEvent.ACTION_UP) {
                            // 首页长按右上「＋」→ H 菜单（不吞 DOWN，短按仍是微信原生菜单）
                            try {
                                if (plusLPAt > 0) {
                                    long dtl = System.currentTimeMillis() - plusLPAt;
                                    float dxl = Math.abs(ev.getRawX() - plusLPX);
                                    float dyl = Math.abs(ev.getRawY() - plusLPY);
                                    int slW = act.getResources().getDisplayMetrics().widthPixels;
                                    int slH = act.getResources().getDisplayMetrics().heightPixels;
                                    boolean inPlus = plusLPY < slH * 0.09f && plusLPX > slW - 170 * density;
                                    plusLPAt = 0;
                                    if (dtl >= 450 && dxl < 30 * density && dyl < 30 * density && inPlus) {
                                        log("ENTRY|longpress plus menu");
                                        p.setResult(Boolean.TRUE);
                                        // 等这一轮 UP 派发完再弹面板，否则会被当「点外面」立刻取消
                                        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                            @Override public void run() {
                                                try { showPlusQuickMenu(act); } catch (Throwable ignore) { }
                                            }
                                        }, 180);
                                        return;
                                    }
                                }
                            } catch (Throwable ignore) { }
                            float dx = ev.getRawX() - swX;
                            float dy = Math.abs(ev.getRawY() - swY);
                            long dt = System.currentTimeMillis() - swT;
                            boolean open = (act.getWindow().getDecorView() instanceof android.view.ViewGroup)
                                    && ((android.view.ViewGroup) act.getWindow().getDecorView())
                                    .findViewWithTag("wxhDrawerWrap") != null;
                            if (dt < 600 && dy < 120 && Math.abs(dx) > 70 * density) {
                                if (!open && dx > 0 && swX < 40 * density) {
                                    openDrawer(act);
                                    log("DRAWER|swipe open");
                                } else if (open && dx < 0) {
                                    closeDrawer(act);
                                    log("DRAWER|swipe close");
                                }
                            }
                        }
                    } catch (Throwable ignore) { }
                }
            });
            XposedBridge.hookAllMethods(c, "onResume", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (!pendingReturnToChats) return;
                        if (!(p.thisObject instanceof android.app.Activity)) return;
                        final android.app.Activity act = (android.app.Activity) p.thisObject;
                        pendingReturnToChats = false;
                        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                            @Override public void run() { switchToChats(act); }
                        }, 350);
                    } catch (Throwable ignore) { }
                }
            });
            log("hooked drawer swipe");
        } catch (Throwable t) { log("drawer swipe err " + t); }
    }

    // ================= 悬浮球（主题包 FloatingActionButton） =================
    // ================= 悬浮球（系统悬浮窗，永不被挡） =================
    private static android.view.WindowManager fabWm = null;
    private static android.view.View fabView = null;
    private static android.view.WindowManager.LayoutParams fabLp = null;

    // 只在微信前台显示悬浮球
    private static final java.util.concurrent.atomic.AtomicBoolean lifecycleHooked =
            new java.util.concurrent.atomic.AtomicBoolean(false);
    private static int resumedCount = 0;

    /** 朋友圈页右下角：已撤回入口（点开看被作者撤回的动态） */
    private static void ensureSnsRecallFab(final android.app.Activity a) {
        try {
            if (a == null) return;
            android.view.View root = a.getWindow().getDecorView();
            if (!(root instanceof android.view.ViewGroup)) return;
            android.view.ViewGroup vg = (android.view.ViewGroup) root;
            if (vg.findViewWithTag("wxhSnsFab") != null) return;
            android.widget.TextView fab = new android.widget.TextView(a);
            fab.setText("撤回");
            fab.setTextSize(12);
            fab.setTypeface(android.graphics.Typeface.DEFAULT);
            fab.setTextColor(0xFF576B95);
            fab.setGravity(android.view.Gravity.CENTER);
            fab.setIncludeFontPadding(false);
            android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
            gd.setColor(0xFFFFFFFF);
            gd.setCornerRadius(dp(a, 4));
            gd.setStroke(dp(a, 1), 0xFFE5E5E5);
            fab.setBackground(gd);
            fab.setElevation(dp(a, 2));
            fab.setTag("wxhSnsFab");
            fab.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) { showSnsRecall(a); }
            });
            android.widget.FrameLayout.LayoutParams lp = new android.widget.FrameLayout.LayoutParams(dp(a, 52), dp(a, 40));
            lp.gravity = android.view.Gravity.RIGHT | android.view.Gravity.BOTTOM;
            lp.rightMargin = dp(a, 10);
            lp.bottomMargin = dp(a, 130);
            vg.addView(fab, lp);
            log("SNSFAB|added");
        } catch (Throwable t) { log("SNSFAB|err " + t); }
    }

    private static void installAppLifecycle(final android.app.Activity act) {
        if (!lifecycleHooked.compareAndSet(false, true)) return;
        try {
            android.app.Application app = act.getApplication();
            app.registerActivityLifecycleCallbacks(new android.app.Application.ActivityLifecycleCallbacks() {
                @Override public void onActivityCreated(android.app.Activity a, android.os.Bundle b) { }
                @Override public void onActivityStarted(android.app.Activity a) { }
                @Override public void onActivityResumed(final android.app.Activity a) {
                    try { if (a != null) mainAct = a; } catch (Throwable ignore) { }
                    try {
                        if (a != null && (a.getClass().getName().contains("SnsTimelineUI")
                                || a.getClass().getName().contains("SnsTimeLineUI"))
                                && cfg().optBoolean("snsAntiDelete", true)) ensureSnsRecallFab(a);
                    } catch (Throwable ignore) { }
                    try { applyPrivacyMask(a, false); } catch (Throwable ignore) { }
                    // 聊天页：不依赖 ChattingUIFragment.onResume（从列表点进来时它可能不重入），
                    // 每次 Activity 恢复都主动挂工具栏 + 补解析会话
                    try {
                        // 2/3 页（发现/我）是懒加载的：进 App 时 pager 只有 0/1 两个子页，
                        // 过一会儿才会创建。这里延时多刷几次，保证后两页也能拿到背景图。
                        if (a != null && a.getClass().getName().endsWith(".LauncherUI")) {
                            final android.app.Activity aa = a;
                            final android.os.Handler ph = new android.os.Handler(android.os.Looper.getMainLooper());
                            for (long d : new long[]{400, 1000, 1800, 3000, 4500, 6500}) {
                                ph.postDelayed(new Runnable() {
                                    @Override public void run() {
                                        try { applyThemePageBg(aa); } catch (Throwable ignore) { }
                                    }
                                }, d);
                            }
                        }
                        String an2 = a == null ? "" : a.getClass().getName();
                        // inChat 依赖 Fragment 钩子，从「微信」列表点进私聊时可能没触发，
                        // 这里再用界面特征兜一次
                        boolean inChatNow = inChat;
                        try {
                            if (!inChatNow) inChatNow = chatVisible(a) || isInChatUi();
                        } catch (Throwable ignore) { }
                        boolean hostChat = an2.endsWith(".LauncherUI") && inChatNow
                                && chatTalker != null && chatTalker.length() > 0;
                        boolean hostMaybe = an2.endsWith(".LauncherUI") && inChatNow;
                        if (a != null && hostMaybe && !hostChat) {
                            // 从「微信」列表进入聊天时走这里：Activity 还是 LauncherUI，
                            // 会话 id 没被 Fragment 钩子抓到 —— 用标题栏文字反查，并重试几拍。
                            final android.app.Activity ha2 = a;
                            final android.os.Handler hh = new android.os.Handler(android.os.Looper.getMainLooper());
                            hh.postDelayed(new Runnable() {
                                int tries = 0;
                                @Override public void run() {
                                    try {
                                        if (chatTalker != null && chatTalker.length() > 0) {
                                            chatAct = ha2;
                                            startTodayCount(ha2);
                                            return;
                                        }
                                        String nm2 = chatNameOfActivity(ha2);
                                        if (nm2 != null && nm2.indexOf("加载") < 0) {
                                            String id2 = wxidByName(nm2.replaceAll("\\(\\d+\\)$", "").trim());
                                            if (id2 != null && id2.length() > 0) {
                                                chatTalker = id2;
                                                chatAct = ha2;
                                                log("TALKER|title " + nm2 + " -> " + id2);
                                                startTodayCount(ha2);
                                                return;
                                            }
                                        }
                                    } catch (Throwable ignore) { }
                                    if (++tries < 8) hh.postDelayed(this, 500L);
                                    else log("TODAY|title resolve failed");
                                }
                            }, 400L);
                        }
                        if (a != null && (an2.contains("ChattingUI") || hostChat)) {
                            chatAct = a;
                            if (chatTalker == null) {
                                String nm = chatNameOfActivity(a);
                                if (nm != null && nm.indexOf("加载") < 0) {
                                    String id = wxidByName(nm.replaceAll("\\(\\d+\\)$", "").trim());
                                    if (id != null && id.length() > 0) {
                                        chatTalker = id;
                                        log("TALKER|resume " + nm + " -> " + id);
                                    }
                                }
                            }
                            startTodayCount(a);
                            ensureChatStyleLoop(a);
                        }
                    } catch (Throwable ignore) { }
                    try {
                        if (hubTest) {
                            hubTest = false;
                            log("HUBTEST|show");
                            final android.app.Activity ha = a;
                            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
                                    new Runnable() { @Override public void run() {
                                        try { showGroupHub(ha); } catch (Throwable ignore) { }
                                    } }, 1500L);
                        }
                    } catch (Throwable ignore) { }
                    try {
                        if (exportCenterTest) {
                            exportCenterTest = false;
                            log("EXPTEST|show");
                            showExportCenter(a);
                        }
                    } catch (Throwable ignore) { }
                    try {
                        if (menuTest && a != null && a.getClass().getName().contains("ChattingUI")) {
                            menuTest = false;
                            final android.app.Activity ma = a;
                            log("MENUTEST|run");
                            runMenuProbe(ma);
                        }
                    } catch (Throwable ignore) { }
                    try {
                        if (pick2Test) {
                            pick2Test = false;
                            final android.app.Activity pa = a;
                            new Thread(new Runnable() { @Override public void run() {
                                try { runPick2Probe(pa); } catch (Throwable e) { log("PICK2|err " + e); }
                            } }).start();
                        }
                    } catch (Throwable ignore) { }
                    try {
                        if (pickTest) {
                            pickTest = false;
                            log("PICKTEST|show");
                            showTalkerPicker(a, "选择会话（自检）", true, new ChatPick() {
                                @Override public void onPick(String tk, String nm) {
                                    log("PICKTEST|picked " + tk + " " + nm);
                                }
                            });
                        }
                    } catch (Throwable ignore) { }
                    try {
                        if (vuiTalker != null) {
                            String tkk = vuiTalker, nmm = vuiName;
                            vuiTalker = null; vuiName = null;
                            log("VUI|trigger " + tkk);
                            runMediaExport(a, tkk, nmm == null ? "调试导出" : nmm, true, false, true, false, 0, null);
                        }
                    } catch (Throwable ignore) { }
                    try {
                        if (a.getClass().getName().contains("LauncherUI")) {
                            topAct = a;
                            // 清掉旧方案可能在 decor 上留下的主题背景
                            try {
                                android.view.View dec0 = a.getWindow().getDecorView();
                                if ("wxhWeld".equals(String.valueOf(dec0.getTag()))
                                        || dec0.getBackground() instanceof android.graphics.drawable.BitmapDrawable) {
                                    dec0.setBackground(null);
                                    dec0.setTag(null);
                                    log("TINTWIN|decor bg cleared");
                                }
                            } catch (Throwable ignore) { }
                            boolean inChat = false;
                            try { inChat = chatVisible(a) || isInChatUi(); } catch (Throwable ignore) { }
                            if (inChat) hideTintWindow();
                            else {
                                showTintWindow(a);
                                final android.app.Activity fa = a;
                                final android.os.Handler hh2 = new android.os.Handler(android.os.Looper.getMainLooper());
                                for (long d2 : new long[]{80L, 300L, 800L}) {
                                    hh2.postDelayed(new Runnable() {
                                        @Override public void run() {
                                            try {
                                                if (!isInChatUi()) { showTintWindow(fa); }
                                            } catch (Throwable ignore) { }
                                        }
                                    }, d2);
                                }
                            }
                            log("TINTWIN|resume chat=" + inChat);
                        }
                    } catch (Throwable ignore) { }
                    try { applyNightMode(a); } catch (Throwable ignore) { }
                    // 红点入口已按用户要求移除
                    try {
                        if (cfg().optBoolean("snsBackup", false)
                                && a.getClass().getName().contains("SnsTimeLineUI")) {
                            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                @Override public void run() { cacheSnsRows(a); }
                            }, 1200L);
                        }
                        // 朋友圈内容由微信自绘，读不到文字，自动转发已停用
                        if (cfg().optBoolean("hideOn", false)
                                && a.getClass().getName().contains("LauncherUI")) {
                            startHidePulse(a);
                        }
                        // 调试：wxh_vshare2 = "src|dst" → 取最近图走系统分享
                        try {
                            final java.io.File shf = new java.io.File(mmBase() + "/files/wxh_vshare2");
                            if (shf.isFile()) {
                                byte[] bsh = readAllBytes(shf);
                                try { shf.delete(); } catch (Throwable ignore) { }
                                String line = bsh == null ? "" : new String(bsh).trim();
                                int bar2 = line.indexOf('|');
                                final String s2 = bar2 > 0 ? line.substring(0, bar2).trim() : line;
                                final String d2 = bar2 > 0 ? line.substring(bar2 + 1).trim() : "filehelper";
                                log("VSHAREF|arm " + s2 + " -> " + d2);
                                final android.app.Activity fa5 = a;
                                new Thread(new Runnable() {
                                    @Override public void run() {
                                        try {
                                            android.graphics.Bitmap bm = loadRecentImage(s2, 86400000L);
                                            log("VSHAREF|bm=" + (bm == null ? "null" : bm.getWidth() + "x" + bm.getHeight()));
                                            if (bm == null) return;
                                            final android.net.Uri u = saveBitmapToMedia(bm);
                                            if (u == null) return;
                                            new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                                                @Override public void run() { shareFileTo(fa5, d2, u, "image/png"); }
                                            });
                                        } catch (Throwable t) { log("VSHAREF|err " + t); }
                                    }
                                }).start();
                            }
                        } catch (Throwable tsh) { log("VSHAREF|outer " + tsh); }
                        // 调试：wxh_vimg 存在时测图片发送链路
                        try {
                            final java.io.File vif = new java.io.File(mmBase() + "/files/wxh_vimg");
                            if (vif.isFile()) {
                                byte[] bimg = readAllBytes(vif);
                                try { vif.delete(); } catch (Throwable ignore) { }
                                final String srcTk = bimg == null ? "" : new String(bimg).trim();
                                log("VIMG|armed src=" + srcTk);
                                final android.app.Activity fa3 = a;
                                new Thread(new Runnable() {
                                    @Override public void run() {
                                        try {
                                            android.graphics.Bitmap bm = loadRecentImage(srcTk, 86400000L);
                                            log("VIMG|load " + (bm == null ? "null" : bm.getWidth() + "x" + bm.getHeight()));
                                            if (bm == null) return;
                                            final android.net.Uri u = saveBitmapToMedia(bm);
                                            log("VIMG|uri=" + u);
                                            if (u == null) return;
                                            new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                                                @Override public void run() {
                                                    sendImageTo(fa3, "filehelper", u);
                                                }
                                            });
                                        } catch (Throwable t) { log("VIMG|err " + t); }
                                    }
                                }).start();
                            }
                        } catch (Throwable tvi) { log("VIMG|outer " + tvi); }
                        // 调试：wxh_vpick2 存在时弹出多选选择器
                        try {
                            final java.io.File pkf = new java.io.File(mmBase() + "/files/wxh_vpick2");
                            if (pkf.isFile()) {
                                try { pkf.delete(); } catch (Throwable ignore) { }
                                log("VPICK|armed " + a.getClass().getSimpleName());
                                final android.app.Activity fa2 = a;
                                fa2.runOnUiThread(new Runnable() {
                                    @Override public void run() {
                                        try {
                                            log("VPICK|calling");
                                            showTalkerPickerMulti(fa2, "选转发目标（可多选）", false, null, new ChatPickMulti() {
                                                @Override public void onPick(java.util.ArrayList<String[]> sel) {
                                                    log("VPICK|picked n=" + sel.size());
                                                }
                                            });
                                        } catch (Throwable t) { log("VPICK|err " + t); }
                                    }
                                });
                            }
                        } catch (Throwable ignore) { }
                    } catch (Throwable ignore) { }
                    resumedCount++;
                    topAct = a;
                    try {
                        try { kickChatOnce(a); } catch (Throwable ignore) { }
                        try { warmBurst(a); } catch (Throwable ignore) { }
                        try { startTintPulse(a); } catch (Throwable ignore) { }
                        try { autoRemarkNewFriends(); } catch (Throwable ignore) { }
                        try {
                            if (a.getClass().getName().contains("LauncherUI")) {
                                traceUntil = System.currentTimeMillis() + 120000L;   // 2 分钟内记录所有界面
                            }
                        } catch (Throwable ignore) { }
                        try { silentPageRefresh(a); } catch (Throwable ignore) { }
                        try {
                            if (a.getClass().getName().contains("LauncherUI")) {
                                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                    @Override public void run() { silentRebuild(a); }
                                }, 1200L);
                            }
                        } catch (Throwable ignore) { }
                        if (themeOn()) {
                            weldTheme(a);
                            try { reapplyThemeForResume(a); } catch (Throwable ignore) { }
                            // 老方案不使用行白底脉冲（clearAll 已一次性处理）
                            // 旧方案已停用：页面底图替换 / 磨砂层拦截 / 行白底清扫 / 去 ItemDecoration
                        } else unweldTheme(a);
                    } catch (Throwable ignore) { }
                    try {
                        // 悬浮球只在微信主界面显示：其余页面（视频号/朋友圈/小程序等）
                        // 一律移除，避免系统悬浮窗干扰 SurfaceView 全屏视频的合成（会黑屏）
                        boolean isMainUi = a.getClass().getName().endsWith(".LauncherUI");
                        if (isMainUi && themeOn()
                                && cfg().optBoolean("", true)) {
                            showOverlayFab(a);
                        } else if (!isMainUi) {
                            hideOverlayFab();
                        }
                        // 隐藏联系人脉冲：只在主界面启动一次
                        if (isMainUi) {
                            try { startHideContactsPulse(a); } catch (Throwable ignore) { }
                            try { installBarGuard(); } catch (Throwable ignore) { }
                            try { decorateAllTabs(a); } catch (Throwable ignore) { }
                            try { installExtraEntries(a); } catch (Throwable ignore) { }
                            try {
                                final android.app.Activity aa = a;
                                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
                                        new Runnable() { @Override public void run() {
                                            new Thread(new Runnable() { @Override public void run() {
                                                checkNoticeChanges();
                                            } }).start();
                                        } }, 4000L);
                            } catch (Throwable ignore) { }
                            // themeRowPulse 已停用：每次回首页跑 3 趟全树遍历，卡顿明显，页面底图由 applyThemePageBg 负责
                            try { setTabBgVisible(true); } catch (Throwable ignore) { }
                        } else {
                            try { setTabBgVisible(false); } catch (Throwable ignore) { }
                        }
                    } catch (Throwable ignore) { }
                }
                @Override public void onActivityPaused(android.app.Activity a) {
                    resumedCount--;
                    try { hideTintWindow(); log("TINTWIN|hide on pause"); } catch (Throwable ignore) { }
                    try { stopTintPulse(); } catch (Throwable ignore) { }
                    if (resumedCount <= 0) {
                        resumedCount = 0;
                        try { hideOverlayFab(); } catch (Throwable ignore) { }
                        try { hideTintWindow(); } catch (Throwable ignore) { }   // 切到后台/别的应用立即撤离
                        try { applyPrivacyMask(a, true); } catch (Throwable ignore) { }
                    }
                }
                @Override public void onActivityStopped(android.app.Activity a) { }
                @Override public void onActivitySaveInstanceState(android.app.Activity a, android.os.Bundle b) { }
                @Override public void onActivityDestroyed(android.app.Activity a) { }
            });
            log("LIFECYCLE|registered");
        } catch (Throwable t) { log("LIFECYCLE|err " + t); }
    }

    private static void showOverlayFab(final android.app.Activity act) {
        // 悬浮球功能已按要求删除：永不创建系统悬浮窗
        try { hideOverlayFab(); } catch (Throwable ignore) { }
        if (true) return;
        try {
            log("FAB|try theme=" + themeOn() + " =" + cfg().optBoolean("", true));
            if (!themeOn()) { log("FAB|skip theme"); return; }
            if (!cfg().optBoolean("", true)) { log("FAB|skip "); return; }
            JSONObject pack = themePack();
            if (pack == null) { log("FAB|skip pack"); return; }
            if (!pack.optBoolean("FloatingActionButtonEnable", false)) { log("FAB|skip enable"); return; }
            if (fabView != null) { log("FAB|exists"); return; }
            fabWm = (android.view.WindowManager) act.getSystemService(android.content.Context.WINDOW_SERVICE);
            final android.widget.TextView ball = new android.widget.TextView(act);
            ball.setText("H");
            ball.setTextSize(18);
            ball.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
            ball.setTextColor(0xFFFFFFFF);
            ball.setGravity(android.view.Gravity.CENTER);
            ball.setIncludeFontPadding(false);
            android.graphics.drawable.GradientDrawable fb = new android.graphics.drawable.GradientDrawable();
            fb.setShape(android.graphics.drawable.GradientDrawable.OVAL);
            fb.setColor(colorFromHex(pack.optString("FloatingActionMenuColor", "C8102E"), 0xFFC8102E));
            fb.setStroke(dp(act, 2), 0x66FFFFFF);
            ball.setBackground(fb);
            ball.setElevation(dp(act, 8));

            int sp = android.view.WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY;
            int fabDp = cfg().optInt("fabSize", 50);
            if (fabDp < 40) fabDp = 40;
            if (fabDp > 64) fabDp = 64;
            fabLp = new android.view.WindowManager.LayoutParams(dp(act, fabDp), dp(act, fabDp), sp,
                    android.view.WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
                            | android.view.WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS
                            | android.view.WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL,
                    android.graphics.PixelFormat.TRANSLUCENT);
            fabLp.gravity = android.view.Gravity.TOP | android.view.Gravity.RIGHT;
            fabLp.x = dp(act, 8);
            int screenH = act.getResources().getDisplayMetrics().heightPixels;
            int savedY = cfg().optInt("fabY", -1);
            fabLp.y = savedY > 0 ? savedY : (int) (screenH * 0.36f);

            ball.setOnTouchListener(new android.view.View.OnTouchListener() {
                float dy0 = 0;
                int y0 = 0;
                boolean moved = false;
                long t0 = 0;
                @Override public boolean onTouch(android.view.View v, android.view.MotionEvent e) {
                    switch (e.getActionMasked()) {
                        case android.view.MotionEvent.ACTION_DOWN:
                            dy0 = e.getRawY(); y0 = fabLp.y; moved = false; t0 = System.currentTimeMillis();
                            return true;
                        case android.view.MotionEvent.ACTION_MOVE: {
                            int ny = (int) (y0 + (e.getRawY() - dy0));
                            if (Math.abs(ny - y0) > 8) moved = true;
                            fabLp.y = ny;
                            try { fabWm.updateViewLayout(v, fabLp); } catch (Throwable ignore) { }
                            return true;
                        }
                        case android.view.MotionEvent.ACTION_UP:
                            if (moved) {
                                try { JSONObject o = readCfg(); o.put("fabY", fabLp.y); writeCfg(o); cfg = null; cfgAt = 0; } catch (Throwable ignore) { }
                                log("FAB|moved y=" + fabLp.y);
                            } else if (System.currentTimeMillis() - t0 < 400) {
                                showFabMenuDialog(act, pack);
                            }
                            return true;
                    }
                    return false;
                }
            });
            fabWm.addView(ball, fabLp);
            fabView = ball;
            log("FAB|overlay added y=" + fabLp.y);
        } catch (Throwable t) { log("FAB|overlay err " + t); }
    }

    private static void hideOverlayFab() {
        try {
            if (fabWm != null && fabView != null) fabWm.removeView(fabView);
        } catch (Throwable ignore) { }
        fabView = null;
        log("FAB|overlay removed");
    }

    private static void showFabMenuDialog(final android.app.Activity act, JSONObject pack) {
        try {
            org.json.JSONObject fab = pack.optJSONObject("FloatingActionButton");
            org.json.JSONArray items = fab == null ? null : fab.optJSONArray("items");
            if (items == null || items.length() == 0) return;

            final android.app.Dialog dlg = new android.app.Dialog(act,
                    android.R.style.Theme_Material_Light_NoActionBar);
            android.widget.LinearLayout wrap = new android.widget.LinearLayout(act);
            wrap.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
            bg.setColor(0xFFFFFFFF);
            bg.setCornerRadius(dp(act, 18));
            wrap.setBackground(bg);
            wrap.setPadding(0, dp(act, 6), 0, dp(act, 8));

            // 标题
            android.widget.LinearLayout head = new android.widget.LinearLayout(act);
            head.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            head.setGravity(android.view.Gravity.CENTER_VERTICAL);
            head.setPadding(dp(act, 18), dp(act, 14), dp(act, 18), dp(act, 8));
            android.widget.TextView bar = new android.widget.TextView(act);
            android.graphics.drawable.GradientDrawable bgBar = new android.graphics.drawable.GradientDrawable();
            bgBar.setColor(0xFF07C160);
            bgBar.setCornerRadius(dp(act, 2));
            bar.setBackground(bgBar);
            head.addView(bar, new android.widget.LinearLayout.LayoutParams(dp(act, 3), dp(act, 15)));
            android.widget.TextView title = new android.widget.TextView(act);
            title.setText("H");
            title.setTextSize(18);
            title.setTextColor(0xFF141418);
            title.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
            title.setPadding(dp(act, 9), 0, 0, 0);
            head.addView(title);
            android.widget.TextView sub = new android.widget.TextView(act);
            sub.setText("快捷菜单");
            sub.setTextSize(11);
            sub.setTextColor(0xFF9A9AA2);
            sub.setPadding(dp(act, 8), dp(act, 4), 0, 0);
            head.addView(sub);
            wrap.addView(head);

            android.widget.ScrollView sv = new android.widget.ScrollView(act);
            android.widget.LinearLayout list = new android.widget.LinearLayout(act);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            sv.addView(list);

            String base = cfg().optString("themePack", DIR + "/wxh_theme") + "/icons/";
            for (int i = 0; i < items.length(); i++) {
                org.json.JSONObject it = items.optJSONObject(i);
                if (it == null || !it.optBoolean("enable", true)) continue;
                String text = it.optString("text", "");
                if (text.contains("X模块") || text.contains("微模块")) text = "H 模块";
                final String type = it.optString("type", "");
                final String action = it.optString("action", "");
                final String label = text;

                android.widget.LinearLayout row = new android.widget.LinearLayout(act);
                row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                row.setPadding(dp(act, 18), dp(act, 13), dp(act, 16), dp(act, 13));
                row.setClickable(true);

                android.widget.ImageView iv = new android.widget.ImageView(act);
                try {
                    java.io.File ic = new java.io.File(base + it.optString("icon", ""));
                    if (ic.isFile()) {
                        android.graphics.Bitmap bm = android.graphics.BitmapFactory.decodeFile(ic.getAbsolutePath());
                        if (bm != null) iv.setImageBitmap(bm);
                    }
                } catch (Throwable ignore) { }
                row.addView(iv, new android.widget.LinearLayout.LayoutParams(dp(act, 20), dp(act, 20)));

                android.widget.TextView tv = new android.widget.TextView(act);
                tv.setText(text);
                tv.setTextSize(15);
                tv.setTextColor(0xFF1A1A1F);
                tv.setPadding(dp(act, 14), 0, 0, 0);
                row.addView(tv, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));

                android.widget.TextView arrow = new android.widget.TextView(act);
                arrow.setText("\u203a");
                arrow.setTextSize(16);
                arrow.setTextColor(0xFFC9C9CF);
                row.addView(arrow);

                row.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { dlg.dismiss(); } catch (Throwable ignore) { }
                        drawerAction(act, type, action, label);
                    }
                });
                list.addView(row, new android.widget.LinearLayout.LayoutParams(-1, -2));

                if (i < items.length() - 1) {
                    android.view.View line = new android.view.View(act);
                    line.setBackgroundColor(0xFFF2F2F5);
                    android.widget.LinearLayout.LayoutParams llp = new android.widget.LinearLayout.LayoutParams(-1, dp(act, 1));
                    llp.leftMargin = dp(act, 52);
                    list.addView(line, llp);
                }
            }
            wrap.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, 0, 1f));

            android.widget.TextView cancel = new android.widget.TextView(act);
            cancel.setText("取消");
            cancel.setTextSize(13);
            cancel.setTextColor(0xFF9A9AA2);
            cancel.setGravity(android.view.Gravity.CENTER);
            cancel.setPadding(0, dp(act, 10), 0, dp(act, 6));
            cancel.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) { try { dlg.dismiss(); } catch (Throwable ignore) { } }
            });
            wrap.addView(cancel, new android.widget.LinearLayout.LayoutParams(-1, -2));

            dlg.setContentView(wrap);
            dlg.show();
            android.view.Window w = dlg.getWindow();
            if (w != null) {
                w.setBackgroundDrawable(glassDrawable(act, 20));
                w.setLayout((int) (act.getResources().getDisplayMetrics().widthPixels * 0.86f),
                        (int) (act.getResources().getDisplayMetrics().heightPixels * 0.72f));
            }
        } catch (Throwable t) { log("FAB|menu err " + t); }
    }

    private static void attachFabTouch(final android.app.Activity act, final android.view.ViewGroup root,
                                       final android.view.View ball, final JSONObject pack) {
        // 统一给球加红色圆底 + 内边距，保证图标清晰可见
        try {
            android.graphics.drawable.GradientDrawable fb = new android.graphics.drawable.GradientDrawable();
            fb.setShape(android.graphics.drawable.GradientDrawable.OVAL);
            fb.setColor(colorFromHex(pack.optString("FloatingActionMenuColor", "C8102E"), 0xFFC8102E));
            fb.setStroke(dp(act, 2), 0x66FFFFFF);
            ball.setBackground(fb);
            ball.setPadding(dp(act, 12), dp(act, 12), dp(act, 12), dp(act, 12));
            ball.setElevation(dp(act, 6));
        } catch (Throwable ignore) { }
        android.widget.FrameLayout.LayoutParams lp = new android.widget.FrameLayout.LayoutParams(
                dp(act, 52), dp(act, 52));
        lp.gravity = android.view.Gravity.RIGHT | android.view.Gravity.TOP;
        int savedY = cfg().optInt("fabY", -1);
        int screenH = act.getResources().getDisplayMetrics().heightPixels;
        lp.topMargin = savedY > 0 ? savedY : (int) (screenH * 0.38f);
        lp.rightMargin = dp(act, 6);
        final android.widget.FrameLayout.LayoutParams flp = lp;
        ball.setOnTouchListener(new android.view.View.OnTouchListener() {
            float dy0 = 0;
            int top0 = 0;
            boolean moved = false;
            long downT = 0;
            @Override public boolean onTouch(android.view.View v, android.view.MotionEvent e) {
                switch (e.getActionMasked()) {
                    case android.view.MotionEvent.ACTION_DOWN:
                        dy0 = e.getRawY();
                        top0 = flp.topMargin;
                        moved = false;
                        downT = System.currentTimeMillis();
                        return true;
                    case android.view.MotionEvent.ACTION_MOVE: {
                        int nt = (int) (top0 + (e.getRawY() - dy0));
                        int maxT = act.getResources().getDisplayMetrics().heightPixels - dp(act, 120);
                        if (nt < dp(act, 80)) nt = dp(act, 80);
                        if (nt > maxT) nt = maxT;
                        if (Math.abs(nt - top0) > 8) moved = true;
                        flp.topMargin = nt;
                        v.setLayoutParams(flp);
                        return true;
                    }
                    case android.view.MotionEvent.ACTION_UP:
                        if (moved) {
                            try {
                                JSONObject o = readCfg();
                                o.put("fabY", flp.topMargin);
                                writeCfg(o);
                                cfg = null;
                                cfgAt = 0;
                            } catch (Throwable ignore) { }
                        } else if (System.currentTimeMillis() - downT < 400) {
                            openFabMenu(act, root, flp.topMargin, pack);
                        }
                        return true;
                }
                return false;
            }
        });
        root.addView(ball, flp);
        try {
            ball.bringToFront();
            ball.invalidate();
            ball.post(new Runnable() {
                @Override public void run() {
                    int[] loc = new int[2];
                    ball.getLocationOnScreen(loc);
                    log("FAB|pos " + loc[0] + "," + loc[1] + " w=" + ball.getWidth()
                            + " h=" + ball.getHeight() + " vis=" + ball.getVisibility()
                            + " parent=" + (ball.getParent() == null ? "null" : ball.getParent().getClass().getSimpleName()));
                }
            });
        } catch (Throwable ignore) { }
        log("FAB|added");
    }

    private static void openFabMenu(final android.app.Activity act, final android.view.ViewGroup root,
                                    int ballTop, JSONObject pack) {
        try {
            android.view.View old = root.findViewWithTag("wxhFabMenu");
            if (old != null) { root.removeView(old); return; }
            org.json.JSONObject fab = pack.optJSONObject("FloatingActionButton");
            org.json.JSONArray items = fab == null ? null : fab.optJSONArray("items");
            if (items == null) return;

            android.widget.LinearLayout panel = new android.widget.LinearLayout(act);
            panel.setTag("wxhFabMenu");
            panel.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
            bg.setColor(0xE61B1B22);
            bg.setCornerRadius(dp(act, 14));
            panel.setBackground(bg);
            panel.setPadding(dp(act, 8), dp(act, 8), dp(act, 8), dp(act, 8));

            for (int i = items.length() - 1; i >= 0; i--) {
                org.json.JSONObject it = items.optJSONObject(i);
                if (it == null || !it.optBoolean("enable", true)) continue;
                String t0 = it.optString("text", "");
                if (t0.contains("X模块") || t0.contains("微模块")) t0 = "H 模块";
                final String text = t0;
                final String type = it.optString("type", "");
                final String action = it.optString("action", "");
                android.widget.LinearLayout row = new android.widget.LinearLayout(act);
                row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                row.setPadding(dp(act, 8), dp(act, 8), dp(act, 10), dp(act, 8));
                android.widget.ImageView iv = new android.widget.ImageView(act);
                try {
                    java.io.File icf = new java.io.File(cfg().optString("themePack", DIR + "/wxh_theme")
                            + "/icons/" + it.optString("icon", ""));
                    if (icf.isFile()) {
                        android.graphics.Bitmap bm = android.graphics.BitmapFactory.decodeFile(icf.getAbsolutePath());
                        if (bm != null) iv.setImageBitmap(bm);
                    }
                } catch (Throwable ignore) { }
                row.addView(iv, new android.widget.LinearLayout.LayoutParams(dp(act, 20), dp(act, 20)));
                android.widget.TextView tv = new android.widget.TextView(act);
                tv.setText(text);
                tv.setTextSize(12);
                tv.setTextColor(colorFromHex(pack.optString("FloatingActionMenuTextColor", "FFFFFF"), 0xFFFFFFFF));
                tv.setPadding(dp(act, 10), 0, 0, 0);
                row.addView(tv);
                row.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try { root.removeView(panel); } catch (Throwable ignore) { }
                        drawerAction(act, type, action, text);
                    }
                });
                panel.addView(row, new android.widget.LinearLayout.LayoutParams(-2, -2));
            }

            android.widget.FrameLayout.LayoutParams plp = new android.widget.FrameLayout.LayoutParams(
                    -2, -2);
            plp.gravity = android.view.Gravity.RIGHT | android.view.Gravity.TOP;
            plp.topMargin = Math.max(dp(act, 60), ballTop - dp(act, 60));
            plp.rightMargin = dp(act, 64);
            root.addView(panel, plp);
        } catch (Throwable t) { log("FAB|menu " + t); }
    }

    private static void installDrawer(final android.app.Activity act) {
        try {
            if (act == null) return;
            if (!cfg().optBoolean("thDrawer", true)) return;
            JSONObject pack = themePack();
            if (pack == null || !pack.optBoolean("DrawerEnable", false)) return;
            if (!themeOn()) return;
            if (act.getWindow() == null) return;
            final android.view.View decor = act.getWindow().getDecorView();
            if (!(decor instanceof android.view.ViewGroup)) return;
            if (decor.findViewWithTag("wxhDrawerTab") != null) return;

            android.view.ViewGroup root = (android.view.ViewGroup) decor;
            // 左侧把手（避开右下角小微）
            android.widget.TextView tab = new android.widget.TextView(act);
            tab.setTag("wxhDrawerTab");
            tab.setText("\u2261");
            tab.setTextSize(14);
            tab.setTextColor(0xFFFFFFFF);
            tab.setGravity(android.view.Gravity.CENTER);
            android.graphics.drawable.GradientDrawable tbg = new android.graphics.drawable.GradientDrawable();
            tbg.setColor(0xFFC8102E);
            tbg.setCornerRadii(new float[]{0, 0, dp(act, 10), dp(act, 10), dp(act, 10), dp(act, 10), 0, 0});
            tab.setBackground(tbg);
            android.widget.FrameLayout.LayoutParams tlp = new android.widget.FrameLayout.LayoutParams(
                    dp(act, 22), dp(act, 56));
            tlp.gravity = android.view.Gravity.LEFT | android.view.Gravity.CENTER_VERTICAL;
            tlp.leftMargin = 0;
            tab.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) { openDrawer(act); }
            });
            root.addView(tab, tlp);
            log("DRAWER|tab added");
        } catch (Throwable t) { log("DRAWER|install " + t); }
    }

    /** 截屏并模糊（降采样 + 三次方框模糊） */
    private static android.graphics.Bitmap captureBlurred(android.app.Activity act, int scale, int radius) {
        try {
            android.view.View decor = act.getWindow().getDecorView();
            int w = decor.getWidth() / scale;
            int h = decor.getHeight() / scale;
            if (w <= 0 || h <= 0) return null;
            android.graphics.Bitmap bmp = android.graphics.Bitmap.createBitmap(w, h,
                    android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas c = new android.graphics.Canvas(bmp);
            c.scale(1f / scale, 1f / scale);
            decor.draw(c);
            int[] pix = new int[w * h];
            bmp.getPixels(pix, 0, w, 0, 0, w, h);
            for (int pass = 0; pass < 3; pass++) boxBlur(pix, w, h, radius);
            bmp.setPixels(pix, 0, w, 0, 0, w, h);
            return bmp;
        } catch (Throwable t) {
            log("BLUR|" + t);
            return null;
        }
    }

    private static void boxBlur(int[] pix, int w, int h, int r) {
        int[] tmp = new int[pix.length];
        for (int y = 0; y < h; y++) {
            int sumA = 0, sumR = 0, sumG = 0, sumB = 0, cnt = 0;
            for (int x = -r; x < w + r; x++) {
                if (x - r - 1 >= 0) {
                    int p = pix[y * w + x - r - 1];
                    sumA -= (p >>> 24); sumR -= (p >> 16) & 0xFF; sumG -= (p >> 8) & 0xFF; sumB -= p & 0xFF; cnt--;
                }
                if (x + r < w && x + r >= 0) {
                    int p = pix[y * w + x + r];
                    sumA += (p >>> 24); sumR += (p >> 16) & 0xFF; sumG += (p >> 8) & 0xFF; sumB += p & 0xFF; cnt++;
                }
                if (x >= 0 && x < w && cnt > 0) {
                    tmp[y * w + x] = ((sumA / cnt) << 24) | ((sumR / cnt) << 16) | ((sumG / cnt) << 8) | (sumB / cnt);
                }
            }
        }
        for (int x = 0; x < w; x++) {
            int sumA = 0, sumR = 0, sumG = 0, sumB = 0, cnt = 0;
            for (int y = -r; y < h + r; y++) {
                if (y - r - 1 >= 0) {
                    int p = tmp[(y - r - 1) * w + x];
                    sumA -= (p >>> 24); sumR -= (p >> 16) & 0xFF; sumG -= (p >> 8) & 0xFF; sumB -= p & 0xFF; cnt--;
                }
                if (y + r < h && y + r >= 0) {
                    int p = tmp[(y + r) * w + x];
                    sumA += (p >>> 24); sumR += (p >> 16) & 0xFF; sumG += (p >> 8) & 0xFF; sumB += p & 0xFF; cnt++;
                }
                if (y >= 0 && y < h && cnt > 0) {
                    pix[y * w + x] = ((sumA / cnt) << 24) | ((sumR / cnt) << 16) | ((sumG / cnt) << 8) | (sumB / cnt);
                }
            }
        }
    }


    /**
     * 抽屉面板背景：不透明深色底 + 主题图（crop 铺满，约 26% 亮度的强调层）。
     * 合成成一张不透明位图，保证不会透出背后的聊天列表文字。
     */
    private static android.graphics.drawable.Drawable drawerPanelBg(
            android.content.Context ctx, int w, int h) {
        try {
            if (w <= 0 || h <= 0) return new android.graphics.drawable.ColorDrawable(0xFF15161C);
            android.graphics.Bitmap out = android.graphics.Bitmap.createBitmap(
                    w, h, android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas cv = new android.graphics.Canvas(out);
            // 底部竖向渐变，深色更沉稳
            android.graphics.Paint bgp = new android.graphics.Paint();
            bgp.setShader(new android.graphics.LinearGradient(0, 0, 0, h,
                    new int[]{0xFF1E1F27, 0xFF101116}, null,
                    android.graphics.Shader.TileMode.CLAMP));
            cv.drawRect(0, 0, w, h, bgp);

            java.io.File f = new java.io.File(
                    cfg().optString("themePack", DIR + "/wxh_theme") + "/images/drawer_bg.png");
            if (!f.isFile()) {
                java.io.File alt = new java.io.File(
                        cfg().optString("themePack", DIR + "/wxh_theme") + "/images/IMG_20210114_102337102557.png");
                if (alt.isFile()) f = alt;
            }
            if (f.isFile()) {
                android.graphics.Bitmap src = android.graphics.BitmapFactory.decodeFile(f.getAbsolutePath());
                if (src != null) {
                    // center-crop：按比例裁切铺满，避免拉伸变形
                    float sc = Math.max((float) w / src.getWidth(), (float) h / src.getHeight());
                    int dw = Math.round(src.getWidth() * sc);
                    int dh = Math.round(src.getHeight() * sc);
                    int dx = (w - dw) / 2, dy = (h - dh) / 2;
                    android.graphics.Paint ip = new android.graphics.Paint();
                    ip.setAntiAlias(true);
                    ip.setAlpha(72);   // ≈28%，够看清主题又不干扰文字
                    cv.drawBitmap(src, new android.graphics.Rect(0, 0, src.getWidth(), src.getHeight()),
                            new android.graphics.Rect(dx, dy, dx + dw, dy + dh), ip);
                    src.recycle();
                }
            }
            return new android.graphics.drawable.BitmapDrawable(ctx.getResources(), out);
        } catch (Throwable t) {
            log("DRAWER|bg err " + t);
            return new android.graphics.drawable.ColorDrawable(0xFF15161C);
        }
    }

    private static void openDrawer(final android.app.Activity act) {
        try {
            final android.view.View decor = act.getWindow().getDecorView();
            if (!(decor instanceof android.view.ViewGroup)) return;
            final android.view.ViewGroup root = (android.view.ViewGroup) decor;
            if (root.findViewWithTag("wxhDrawerWrap") != null) return;
            JSONObject pack = themePack();
            int wdp = cfg().optInt("drawerWidth", 0);
            if (wdp == 0) wdp = pack == null ? 300 : pack.optInt("DrawerWidth", 300);
            if (wdp < 220) wdp = 220;
            if (wdp > 340) wdp = 340;
            final int panelW = dp(act, wdp);

            android.widget.FrameLayout wrap = new android.widget.FrameLayout(act);
            wrap.setTag("wxhDrawerWrap");

            android.view.View scrim = new android.view.View(act);
            boolean blurred = false;   // 抽屉背景图已停用，只用纯色遮罩
            try {
                JSONObject pk = pack;
                int blurR = pk == null ? 0 : pk.optInt("DrawerWholeBgBlur", 0);
                boolean want = (pk != null && (false
                        || pk.optBoolean("DrawerListBgBlur", false) || blurR > 0));
                if (want) {
                    android.graphics.Bitmap bb = captureBlurred(act, 6, 8);
                    if (bb != null) {
                        android.graphics.drawable.BitmapDrawable bd =
                                new android.graphics.drawable.BitmapDrawable(act.getResources(), bb);
                        bd.setAlpha(255);
                        scrim.setBackground(bd);
                        blurred = true;
                        log("DRAWER|blur ok " + bb.getWidth() + "x" + bb.getHeight());
                    }
                }
            } catch (Throwable ignore) { }
            if (!blurred) scrim.setBackgroundColor(0x99000000);
            scrim.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    try { root.removeView(wrap); } catch (Throwable ignore) { }
                }
            });
            wrap.addView(scrim, new android.widget.FrameLayout.LayoutParams(-1, -1));
            if (blurred) {
                android.view.View dim = new android.view.View(act);
                dim.setBackgroundColor(0x66000000);
                wrap.addView(dim, new android.widget.FrameLayout.LayoutParams(-1, -1));
            }

            android.widget.LinearLayout panel = new android.widget.LinearLayout(act);
            panel.setOrientation(android.widget.LinearLayout.VERTICAL);
            panel.setBackgroundColor(0xFF15161C);
            try {
                int scrH = decor.getHeight() > 0 ? decor.getHeight() : act.getResources().getDisplayMetrics().heightPixels;
                android.graphics.drawable.Drawable dbg = drawerPanelBg(act, panelW, scrH);
                if (dbg != null) panel.setBackground(dbg);
            } catch (Throwable ignore) { }
            panel.setPadding(0, dp(act, 28), 0, dp(act, 16));

            // 抽屉头像 / 昵称
            if (pack != null && pack.optBoolean("DrawerShowAvatar", true)) {
