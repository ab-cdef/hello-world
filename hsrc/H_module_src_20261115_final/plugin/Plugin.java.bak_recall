    /** 输入框工具条右侧常驻时钟；同一个实例每分钟才真正改一次文本，避免闪烁 */
    private static volatile android.widget.TextView clockTv = null;
    private static void updateClockText() {
        try {
            android.widget.TextView c = clockTv;
            if (c == null) return;
            String s = new java.text.SimpleDateFormat("HH:mm", java.util.Locale.US)
                    .format(new java.util.Date());
            CharSequence old = c.getText();
            if (old == null || !s.equals(old.toString())) c.setText(s);
        } catch (Throwable ignore) { }
    }

    private static void collectDeep(android.view.View v, java.util.List<android.view.View> out, int depth) {
        try {
            if (depth > 40 || v == null) return;
            out.add(v);
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) collectDeep(g.getChildAt(i), out, depth + 1);
            }
        } catch (Throwable ignore) { }
    }

    /** 在聊天输入框里画一条「今日已发 N 条消息」（挂在 ChatFooter 上，跟着输入框左边缘） */
    private static void paintCountChip(android.app.Activity act, int shown) {
        try {
            if (act == null || act.getWindow() == null) return;
            android.view.ViewGroup footerG = null;
            android.widget.EditText targetEt = null;
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectDeep(act.getWindow().getDecorView(), all, 0);
            for (android.view.View v : all) {
                if (footerG == null && v instanceof android.view.ViewGroup
                        && v.getClass().getName().contains("ChatFooter")) footerG = (android.view.ViewGroup) v;
                if (v instanceof android.widget.EditText && targetEt == null
                        && v.getVisibility() == android.view.View.VISIBLE && v.getWidth() > 0
                        && v.getHeight() > 0 && ((android.widget.EditText) v).length() == 0) {
                    targetEt = (android.widget.EditText) v;
                }
            }
            if (footerG == null || targetEt == null) return;
            android.widget.TextView chip = (android.widget.TextView) footerG.findViewWithTag("wxhCountHint");
            if (chip == null) {
                chip = new android.widget.TextView(act);
                chip.setTag("wxhCountHint");
                chip.setTextSize(12);
                chip.setTextColor(0xFF8A8A90);
                chip.setSingleLine(true);
                android.widget.FrameLayout.LayoutParams flp = new android.widget.FrameLayout.LayoutParams(-2, -2);
                flp.gravity = android.view.Gravity.LEFT | android.view.Gravity.CENTER_VERTICAL;
                footerG.addView(chip, flp);
                log("HINT|new chip footer=" + footerG.getClass().getSimpleName());
            }
            int[] etLoc = new int[2];
            int[] fLoc = new int[2];
            targetEt.getLocationInWindow(etLoc);
            footerG.getLocationInWindow(fLoc);
            int d = (int) act.getResources().getDisplayMetrics().density;
            int leftInF = etLoc[0] - fLoc[0];
            int topInF = etLoc[1] - fLoc[1] + (targetEt.getHeight() - dp(act, 16)) / 2;
            chip.setElevation(100f);
            chip.setTranslationZ(100f);
            if (chip.getLayoutParams() instanceof android.widget.FrameLayout.LayoutParams) {
                android.widget.FrameLayout.LayoutParams flp2 = (android.widget.FrameLayout.LayoutParams) chip.getLayoutParams();
                flp2.gravity = android.view.Gravity.LEFT | android.view.Gravity.TOP;
                flp2.leftMargin = leftInF + 12 * d;
                flp2.topMargin = topInF;
                chip.setLayoutParams(flp2);
            }
            String txt = "今日已发 " + shown + " 条消息";
            CharSequence cs = chip.getText();
            if (cs == null || !txt.equals(cs.toString())) {
                chip.setText(txt);
                log("HINT|chip " + txt + " L=" + leftInF + " T=" + topInF + " etH=" + targetEt.getHeight() + " fH=" + footerG.getHeight() + " vis=" + chip.getVisibility());
            }
            chip.bringToFront();
        } catch (Throwable t) { log("HINT|err " + t); }
    }

    /** 把「今日已发 N 条消息」画成小图，挂在输入框左边（微信会忽略 hint，只能这样塞进去） */
    private static android.graphics.Bitmap todayBoxBitmap(android.content.Context c, String text) {
        try {
            android.graphics.Paint p = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
            p.setColor(0xFF8A8A90);
            float sp = 12f * c.getResources().getDisplayMetrics().scaledDensity;
            p.setTextSize(sp);
            p.setTypeface(android.graphics.Typeface.DEFAULT);
            int w = (int) Math.ceil(p.measureText(text)) + (int) (4 * c.getResources().getDisplayMetrics().density);
            int h = (int) Math.ceil(-p.ascent() + p.descent());
            android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(Math.max(1, w), Math.max(1, h),
                    android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas cv = new android.graphics.Canvas(bm);
            cv.drawText(text, 0, -p.ascent(), p);
            return bm;
        } catch (Throwable t) { return null; }
    }

    /** 在聊天输入框区域显示今日消息条数 */
    private static volatile boolean todayLoopOn = false;
    private static volatile android.app.Activity todayAct = null;
    private static volatile long lastTitleTry = 0;
    private static volatile long lastTickLog = 0;
    private static volatile android.view.View todayAnchor = null;
    private static volatile long todayAttachedAt = 0;

    /** 聊天行样式自启循环：不依赖 ChattingUIFragment.onResume（列表点进来时不一定会重入） */
    private static volatile boolean styleLoopOn = false;
    private static volatile String styleSig = "";
    private static volatile long styleAt = 0;

    /** 工具栏自愈：聊天页里确认「今日已发/常用语」那行还在，不在就重启挂载 */
    private static long lastToolbarHeal = 0;
    private static void ensureToolbar(final android.app.Activity a) {
        try {
            if (a == null) return;
            if (!cfg().optBoolean("todayCount", true)) return;
            long now = System.currentTimeMillis();
            if (now - lastToolbarHeal < 1200) return;
            lastToolbarHeal = now;
            boolean alive = false;
            try {
                alive = true;   // 今日已发改到输入框提示里，不需要再挂视图
            } catch (Throwable ignore) { }
            if (alive) return;
            // 视图没了（切会话 / 重绑）：让旧循环退出，重新挂一次
            todayTv = null;
            clockTv = null;
            todayLoopOn = false;
            todayAct = null;
            log("TBAR|heal restart");
            startTodayCount(a);
        } catch (Throwable ignore) { }
    }

    private static void ensureChatStyleLoop(final android.app.Activity a) {
        if (a == null || styleLoopOn) return;
        styleLoopOn = true;
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        h.postDelayed(new Runnable() {
            int n = 0;
            @Override public void run() {
                try {
                    // 不要求 chatAct == a（从不同入口进聊天时两者可能不同），只看「是否在聊天里」
                    final android.app.Activity act2 = chatAct != null ? chatAct : a;
                    // 性能：只做一次树查找（原来要两次 + allRoots 兜底，600ms 一遍很吃 CPU）
                    android.view.ViewGroup ml0 = null;
                    if (act2 != null) {
                        try { ml0 = findChatList(act2); } catch (Throwable ignore) { }
                    }
                    boolean looksChat = ml0 != null || isInChatUi();
                    if (looksChat && act2 != null) {
                        // 只有列表内容真的变了才重排样式（首行位置 + 子项数 + 末行底边）
                        String sig = "null";
                        if (ml0 instanceof android.view.ViewGroup) {
                            android.view.ViewGroup g0 = (android.view.ViewGroup) ml0;
                            int cc = g0.getChildCount();
                            int fb = cc > 0 ? g0.getChildAt(0).getTop() : 0;
                            int lb = cc > 0 ? g0.getChildAt(cc - 1).getBottom() : 0;
                            sig = cc + ":" + fb + ":" + lb;
                        }
                        if (!sig.equals(styleSig) || System.currentTimeMillis() - styleAt > 4000) {
                            styleSig = sig;
                            styleAt = System.currentTimeMillis();
                            try { styleChatRowsByAdapter(act2); } catch (Throwable ignore) { }
                        }
                        // 原生时间颜色/格式每轮都刷：微信每次 bind 会重置，只刷一次会被盖掉
                        try { if (ml0 != null) applyNativeTimeStyle(ml0); } catch (Throwable ignore) { }
                        // 每条消息时间的 foreground 也可能被重绑清掉，每轮补回
                        try { if (ml0 != null) reapplyRowTimes(ml0); } catch (Throwable ignore) { }
                        // 工具栏自愈：切会话/重绑后那行会消失，这里补回
                        try { ensureToolbar(act2); } catch (Throwable ignore) { }
                        // 调试钩子（文件存在才跑）
                        try { maybeFollowUpTest(); } catch (Throwable ignore) { }
                        try { maybeRosterTest(); } catch (Throwable ignore) { }
                        try { maybeQuoteTest(); } catch (Throwable ignore) { }
                        try { maybeDealTest(); } catch (Throwable ignore) { }
                        try { maybeGcTest(); } catch (Throwable ignore) { }
                        try { maybeDeclineTest(); } catch (Throwable ignore) { }
                        try { maybeAdvTest(); } catch (Throwable ignore) { }
                        try { maybeProductTest(); } catch (Throwable ignore) { }
                        try { maybeWordTest(); } catch (Throwable ignore) { }
                        try { maybeDailyTest(); } catch (Throwable ignore) { }
                        try { maybeMtrendTest(); } catch (Throwable ignore) { }
                        try { maybeSgAudit(); } catch (Throwable ignore) { }
                        try { maybeContactTest(); } catch (Throwable ignore) { }
                        try { maybeBySenderTest(); } catch (Throwable ignore) { }
                        try { maybeFileListTest(); } catch (Throwable ignore) { }
                        try { maybeFavMdTest(); } catch (Throwable ignore) { }
                        try { maybeSettingsAuditTest(); } catch (Throwable ignore) { }
                        try { maybeBirthdayTest(); } catch (Throwable ignore) { }
                        try { maybeNoticeHistTest(); } catch (Throwable ignore) { }
                        try { maybeCalTest(); } catch (Throwable ignore) { }
                        try { maybeShareTest(); } catch (Throwable ignore) { }
                        try { maybeAskTest(); } catch (Throwable ignore) { }
                    }
                } catch (Throwable ignore) { }
                n++;
                if (isInChatUi() || chatAct != null || inChat || chatTalker != null) h.postDelayed(this, 800);
                else styleLoopOn = false;
            }
        }, 600);
    }

    /* ================= 崩溃日志（WeKit 的「崩溃拦截/日志重定向」） ================= */
    private static volatile boolean crashHooked = false;

    private static void installCrashLogger() {
        if (crashHooked) return;
        crashHooked = true;
        try {
            XposedBridge.hookAllMethods(java.lang.Thread.class, "setDefaultUncaughtExceptionHandler",
                    new XC_MethodHook() {
                        @Override protected void beforeHookedMethod(MethodHookParam pm) {
                            try {
                                if (pm.args == null || pm.args.length != 1) return;
                                Object h = pm.args[0];
                                if (!(h instanceof java.lang.Thread.UncaughtExceptionHandler)) return;
                                pm.args[0] = new Thread.UncaughtExceptionHandler() {
                                    private final java.lang.Thread.UncaughtExceptionHandler inner =
                                            (java.lang.Thread.UncaughtExceptionHandler) h;
                                    @Override public void uncaughtException(java.lang.Thread t, Throwable e) {
                                        try {
                                            java.io.File f = new java.io.File(DIR, "wxh_crash.log");
                                            java.io.FileWriter fw = new java.io.FileWriter(f, true);
                                            fw.write(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss",
                                                    java.util.Locale.US).format(new java.util.Date())
                                                    + " thread=" + (t == null ? "?" : t.getName())
                                                    + " " + android.util.Log.getStackTraceString(e) + "\n");
                                            fw.close();
                                            log("CRASH|" + (e == null ? "?" : e.getClass().getSimpleName()));
                                        } catch (Throwable ignore) { }
                                        try { inner.uncaughtException(t, e); } catch (Throwable ignore) { }
                                    }
                                };
                            } catch (Throwable ignore) { }
                        }
                    });
            log("CRASHHOOK|installed");
        } catch (Throwable t) { log("CRASHHOOK|err " + t); }
    }

    private static String readFlag(String path) {
        try {
            java.io.File f = new java.io.File(path);
            if (!f.isFile()) return "";
            java.io.FileInputStream in = new java.io.FileInputStream(f);
            byte[] b = new byte[(int) f.length()];
            int got = 0;
            while (got < b.length) {
                int r = in.read(b, got, b.length - got);
                if (r <= 0) break;
                got += r;
            }
            in.close();
            return new String(b, 0, got, "UTF-8").trim();
        } catch (Throwable t) { return ""; }
    }

    /** 兜底定位：长按那条消息的 createTime（时间戳拿不到时用行索引反查） */
    private static long pressedTs() {
        if (lastLongPressTs > 0) return lastLongPressTs;
        try {
            String tk = chatTalker;
            if (tk != null && lastLongPressPfb >= 0) {
                java.util.List<Object[]> rr = queryRows(
                        "select createTime from message where talker='" + escSql(tk)
                                + "' order by createTime desc limit 1 offset " + lastLongPressPfb, 1);
                if (!rr.isEmpty()) {
                    long v = Long.parseLong(String.valueOf(rr.get(0)[0]));
                    long ms = v > 100000000000L ? v : v * 1000L;
                    log("PTS|byIdx pfb=" + lastLongPressPfb + " ts=" + ms);
                    return ms;
                }
            }
        } catch (Throwable ignore) { }
        return 0;
    }

    /** 探查：朋友圈详情页能不能取到正文（决定伪赞在朋友圈是否可用） */
    private static void probeSnsText(final android.app.Activity a) {
        try {
            java.util.ArrayList<android.view.View> vs = new java.util.ArrayList<android.view.View>();
            collectAllViews(a.getWindow().getDecorView(), vs, 0);
            try {
                for (android.view.View r : allRoots()) {
                    java.util.ArrayList<android.view.View> rv = new java.util.ArrayList<android.view.View>();
                    collectAllViews(r, rv, 0);
                    if (rv.size() > vs.size()) vs = rv;
                }
            } catch (Throwable ignore) { }
            int tv = 0;
            StringBuilder sb = new StringBuilder();
            for (android.view.View v : vs) {
                if (!(v instanceof android.widget.TextView)) continue;
                CharSequence c = ((android.widget.TextView) v).getText();
                if (c == null || c.length() == 0) continue;
                tv++;
                if (sb.length() < 200) sb.append('[').append(c.length()).append(']').append(c.toString().replace("\n", " ")).append(' ');
            }
            log("SNSTEXT|views=" + vs.size() + " tvs=" + tv + " sample=" + sb);
        } catch (Throwable t) { log("SNSTEXT|err " + t); }
    }

    /** 取一条消息的可读正文（媒体转占位符） */
    private static String messageBodyOf(String talker, long ts, int limit, boolean withSender) {
        try {
            if (talker == null || ts <= 0) return null;
            java.util.List<Object[]> rr = queryRows(
                    "select ifnull(content,''), ifnull(type,0), ifnull(isSend,0) from message where talker='"
                            + escSql(talker) + "' and createTime=" + ts + " limit 1", 3);
            if (rr.isEmpty()) return null;
            Object[] r = rr.get(0);
            String c = r[0] == null ? "" : String.valueOf(r[0]);
            int tp = 0, isSend = 0;
            try { tp = Integer.parseInt(String.valueOf(r[1])) & 65535; } catch (Throwable ignore) { }
            try { isSend = Integer.parseInt(String.valueOf(r[2])); } catch (Throwable ignore) { }
            String body;
            if (tp != 1) {
                if (tp == 3) body = "[图片]";
                else if (tp == 34) body = "[语音]";
                else if (tp == 43) body = "[视频]";
                else if (tp == 47) body = "[表情]";
                else if (tp == 49) body = "[文件/链接]";
                else if (tp == 42) body = "[名片]";
                else if (tp == 48) body = "[位置]";
                else body = "[消息]";
            } else {
                String sid = senderIdOfGroupMsg(c);
                int nl = c.indexOf('\n');
                body = (sid != null && nl >= 0) ? c.substring(nl + 1) : c;
                if (body.startsWith("<")) body = "[消息]";
                if (withSender) {
                    String who;
                    if (isSend != 0) who = "我";
                    else if (sid != null) { who = senderName(sid); if (who == null || who.length() == 0) who = sid; }
                    else who = displayOfTalker(talker);
                    body = who + "：" + body;
                }
            }
            if (limit > 0 && body.length() > limit) body = body.substring(0, limit) + "…";
            return body;
        } catch (Throwable t) { return null; }
    }

    /** 朋友圈里长按动态：从锚点往上找一块有正文的区域，记一条本地赞 */
    private static boolean snsFakeFromAnchor(android.view.View anchor) {
        try {
            android.view.View cur = anchor;
            for (int up = 0; up < 10 && cur != null; up++) {
                String txt = collectText(cur);
                if (txt != null) {
                    txt = txt.trim();
                    if (txt.length() >= 12) {
                        String body = txt.length() > 120 ? txt.substring(0, 120) : txt;
                        org.json.JSONArray arr = cfg().optJSONArray("fakeLiked");
                        if (arr == null) arr = new org.json.JSONArray();
                        String when = new java.text.SimpleDateFormat("MM-dd HH:mm",
                                java.util.Locale.US).format(new java.util.Date());
                        arr.put(when + "|" + body.replace("\n", " "));
                        while (arr.length() > 300) {
                            org.json.JSONArray n2 = new org.json.JSONArray();
                            for (int i = 1; i < arr.length(); i++) n2.put(arr.optString(i));
                            arr = n2;
                        }
                        org.json.JSONObject o = readCfg();
                        o.put("fakeLiked", arr);
                        writeCfg(o);
                        cfg = null; cfgAt = 0;
                        log("SNSFAKE|ok len=" + body.length());
                        return true;
                    }
                }
                android.view.ViewParent pv = cur.getParent();
                cur = (pv instanceof android.view.View) ? (android.view.View) pv : null;
            }
        } catch (Throwable t) { log("SNSFAKE|err " + t); }
        return false;
    }

    /* ================= 聊天消息「伪赞」：本地标记，对方不可见 ================= */
    private static String chatFakeKey(String talker, long ts) { return talker + "#" + ts; }

    private static boolean chatFakeHas(String talker, long ts) {
        try {
            org.json.JSONArray a = cfg().optJSONArray("chatFakeLiked");
            if (a == null) return false;
            String k = chatFakeKey(talker, ts);
            for (int i = 0; i < a.length(); i++) {
                String one = a.optString(i, "");
                int p1 = one.indexOf('|');
                if (p1 > 0 && one.substring(0, p1).equals(k)) return true;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    private static void chatFakeToggle(final android.app.Activity a, final String talker, final long ts) {
        try {
            if (talker == null || ts <= 0) { toast("定位不到这条消息"); return; }
            if (chatFakeHas(talker, ts)) { toast("这条已经赞过了（本地）"); return; }
            String preview = "";
            String who = "对方";
            try {
                java.util.List<Object[]> rr = queryRows(
                        "select ifnull(content,''), ifnull(type,0), ifnull(isSend,0) from message where talker='"
                                + escSql(talker) + "' and createTime=" + ts + " limit 1", 3);
                if (!rr.isEmpty()) {
                    String c = rr.get(0)[0] == null ? "" : String.valueOf(rr.get(0)[0]);
                    int tp = 0, isSend = 0;
                    try { tp = Integer.parseInt(String.valueOf(rr.get(0)[1])) & 65535; } catch (Throwable ignore) { }
                    try { isSend = Integer.parseInt(String.valueOf(rr.get(0)[2])); } catch (Throwable ignore) { }
                    if (isSend != 0) who = "我";
                    else {
                        String sid = senderIdOfGroupMsg(c);
                        who = sid == null ? displayOfTalker(talker) : senderName(sid);
                        if (who == null || who.length() == 0) who = sid == null ? "对方" : sid;
                    }
                    int nl = c.indexOf('\n');
                    String body = nl >= 0 ? c.substring(nl + 1) : c;
                    if (tp != 1) body = tp == 3 ? "[图片]" : tp == 34 ? "[语音]" : tp == 43 ? "[视频]"
                            : tp == 47 ? "[表情]" : tp == 49 ? "[文件/链接]" : "[消息]";
                    preview = body.length() > 40 ? body.substring(0, 40) : body;
                }
            } catch (Throwable ignore) { }
            org.json.JSONArray arr = cfg().optJSONArray("chatFakeLiked");
            if (arr == null) arr = new org.json.JSONArray();
            String when = new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US)
                    .format(new java.util.Date(ts > 100000000000L ? ts : ts * 1000L));
            arr.put(chatFakeKey(talker, ts) + "|" + when + "|" + who + "|" + preview);
            while (arr.length() > 500) {
                org.json.JSONArray n2 = new org.json.JSONArray();
                for (int i = 1; i < arr.length(); i++) n2.put(arr.optString(i));
                arr = n2;
            }
            org.json.JSONObject o = readCfg();
            o.put("chatFakeLiked", arr);
            writeCfg(o);
            cfg = null; cfgAt = 0;
            toast("已本地赞（对方不可见）");
            log("CHATFAKE|" + talker + " " + ts + " " + who);
        } catch (Throwable t) { log("CHATFAKE|err " + t); }
    }

    private static void showChatFake(final android.app.Activity a) {
        try {
            org.json.JSONArray arr = cfg().optJSONArray("chatFakeLiked");
            if (arr == null || arr.length() == 0) { toast("还没有本地赞记录"); return; }
            StringBuilder sb = new StringBuilder();
            int shown = 0;
            for (int i = arr.length() - 1; i >= 0 && shown < 80; i--, shown++) {
                String one = arr.optString(i, "");
                String[] p = one.split("\\|", 4);
                if (p.length >= 4) sb.append(p[1]).append("  ").append(p[2]).append("：").append(p[3]).append('\n');
                else sb.append(one).append('\n');
            }
            if (arr.length() > 80) sb.append("…共 ").append(arr.length()).append(" 条");
            new android.app.AlertDialog.Builder(a)
                    .setTitle("本地赞（" + arr.length() + "）")
                    .setMessage(sb.toString())
                    .setPositiveButton("清空", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                org.json.JSONObject o = readCfg();
                                o.put("chatFakeLiked", new org.json.JSONArray());
                                writeCfg(o); cfg = null; cfgAt = 0;
                                toast("已清空");
                            } catch (Throwable ignore) { }
                        }
                    })
                    .setNegativeButton("关闭", null).show();
        } catch (Throwable t) { toast("读取失败"); }
    }

    /** 转发单条消息到指定会话（复用 sendTextTo） */
    private static void forwardOne(final android.app.Activity a, final String talker,
                                   final long ts, final String target, final String tnm) {
        new Thread(new Runnable() {
            @Override public void run() {
                String text = null;
                try {
                    java.util.List<Object[]> rr = queryRows(
                            "select ifnull(content,''), ifnull(type,0), ifnull(isSend,0) from message where talker='"
                                    + escSql(talker) + "' and createTime=" + ts + " limit 1", 3);
                    if (!rr.isEmpty()) {
                        Object[] r = rr.get(0);
                        String c = r[0] == null ? "" : String.valueOf(r[0]);
                        int tp = 0, isSend = 0;
                        try { tp = Integer.parseInt(String.valueOf(r[1])) & 65535; } catch (Throwable ignore) { }
                        try { isSend = Integer.parseInt(String.valueOf(r[2])); } catch (Throwable ignore) { }
                        String body;
                        String who;
                        if (isSend != 0) { who = "我"; body = c; }
                        else {
                            String sid = senderIdOfGroupMsg(c);
                            who = sid == null ? displayOfTalker(talker) : senderName(sid);
                            if (who == null || who.length() == 0) who = sid == null ? "对方" : sid;
                            int nl = c.indexOf('\n');
                            body = nl >= 0 ? c.substring(nl + 1) : c;
                        }
                        if (tp != 1) {
                            if (tp == 3) body = "[图片]";
                            else if (tp == 34) body = "[语音]";
                            else if (tp == 43) body = "[视频]";
                            else if (tp == 47) body = "[表情]";
                            else if (tp == 49) body = "[文件/链接]";
                            else if (tp == 42) body = "[名片]";
                            else if (tp == 48) body = "[位置]";
                            else body = "[其他消息]";
                        } else if (body.startsWith("<")) body = "[其他消息]";
                        if (body.length() > 300) body = body.substring(0, 300) + "…";
                        text = "【转发】" + who + "：" + body;
                    }
                } catch (Throwable t) { log("FWD1|err " + t); }
                if (text == null) { toast("取不到这条消息"); return; }
                final String ft = text;
                log("FWD1|" + target + " " + ft);
                a.runOnUiThread(new Runnable() { @Override public void run() {
                    toast("转发到「" + tnm + "」");
                    sendTextTo(a, target, ft);
                } });
            }
        }).start();
    }

    /* ================= 拟真引用：把「原文 + 发送人」塞进输入框 ================= */
    private static boolean insertQuoteFor(android.app.Activity a, String talker, long ts) {
        try {
            if (a == null || talker == null || ts <= 0) return false;
            java.util.List<Object[]> rr = queryRows(
                    "select ifnull(content,''), ifnull(type,0), ifnull(isSend,0) from message where talker='"
                            + escSql(talker) + "' and createTime=" + ts + " limit 1", 3);
            if (rr.isEmpty()) { log("QUOTE|no msg"); return false; }
            Object[] r = rr.get(0);
            String c = r[0] == null ? "" : String.valueOf(r[0]);
            int tp = 0, isSend = 0;
            try { tp = Integer.parseInt(String.valueOf(r[1])) & 65535; } catch (Throwable ignore) { }
            try { isSend = Integer.parseInt(String.valueOf(r[2])); } catch (Throwable ignore) { }
            String body;
            if (tp != 1) {
                if (tp == 3) body = "[图片]";
                else if (tp == 34) body = "[语音]";
                else if (tp == 43) body = "[视频]";
                else if (tp == 47) body = "[表情]";
                else if (tp == 49) body = "[文件/链接]";
                else if (tp == 42) body = "[名片]";
                else if (tp == 48) body = "[位置]";
                else body = "[消息]";
            } else {
                String sid = senderIdOfGroupMsg(c);
                int nl = c.indexOf('\n');
                body = (sid != null && nl >= 0) ? c.substring(nl + 1) : c;
                if (body.startsWith("<")) body = "[消息]";
            }
            if (body.length() > 200) body = body.substring(0, 200) + "…";
            String who;
            if (isSend != 0) who = "我";
            else {
                String sid2 = senderIdOfGroupMsg(c);
                if (sid2 != null) { who = senderName(sid2); if (who == null || who.length() == 0) who = sid2; }
                else who = displayOfTalker(talker);
            }
            String q = "「" + body + "」\n—— " + who + "：";
            android.widget.EditText et = findEditText(a.getWindow().getDecorView());
            if (et == null) { log("QUOTE|no input"); return false; }
            CharSequence cur = et.getText();
            String base = cur == null ? "" : cur.toString();
            String nv = base.length() == 0 ? q : base + "\n" + q;
            et.setText(nv);
            et.setSelection(nv.length());
            log("QUOTE|ok talker=" + talker + " who=" + who + " len=" + nv.length());
            return true;
        } catch (Throwable t) { log("QUOTE|err " + t); return false; }
    }

    /* ================= 批量转发：把最近 N 条消息逐条发到目标会话 ================= */
    private static volatile java.util.List<String> fwdQ = null;
    private static volatile String fwdTarget = null;
    private static volatile int fwdIdx = 0;
    private static volatile int fwdRetry = 0;

    private static void showForwardPicker(final android.app.Activity a) {
        final String src = chatTalker != null ? chatTalker : currentTalker();
        if (src == null || src.length() == 0) { toast("请先打开要转发的聊天"); return; }
        final String[] opts = {"最近 10 条", "最近 20 条", "最近 50 条"};
        final int[] nums = {10, 20, 50};
        new android.app.AlertDialog.Builder(a)
                .setTitle("批量转发 · 从「" + displayOfTalker(src) + "」")
                .setItems(opts, new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) {
                        final int n = nums[which];
                        showTalkerPicker(a, "转发到", false, new ChatPick() {
                            @Override public void onPick(String tk, String nm) {
                                startForward(a, src, tk, nm, n);
                            }
                        });
                    }
                })
                .setNegativeButton("取消", null).show();
    }

    private static void startForward(final android.app.Activity a, final String src,
                                     final String target, final String tnm, final int n) {
        toast("正在准备转发…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<String> out = new java.util.ArrayList<String>();
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(content,''), ifnull(type,0), ifnull(isSend,0) from message where talker='"
                                    + escSql(src) + "' order by createTime desc limit " + n, 3);
                    java.util.List<Object[]> rev = new java.util.ArrayList<Object[]>();
                    for (int i = rows.size() - 1; i >= 0; i--) rev.add(rows.get(i));
                    java.text.SimpleDateFormat f =
                            new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US);
                    for (Object[] r : rev) {
                        String c = r[0] == null ? "" : String.valueOf(r[0]);
                        int tp = 0, isSend = 0;
                        try { tp = Integer.parseInt(String.valueOf(r[1])) & 65535; } catch (Throwable ignore) { }
                        try { isSend = Integer.parseInt(String.valueOf(r[2])); } catch (Throwable ignore) { }
                        String who;
                        String body;
                        if (isSend != 0) { who = "我"; body = c; }
                        else {
                            String sid = senderIdOfGroupMsg(c);
                            who = sid == null ? displayOfTalker(src) : senderName(sid);
                            if (who == null || who.length() == 0) who = sid == null ? "对方" : sid;
                            int nl = c.indexOf('\n');
                            body = nl >= 0 ? c.substring(nl + 1) : c;
                        }
                        // 只有纯文本（type 1）取正文；其余一律占位，避免把 XML 原样发出去
                        if (tp != 1) {
                            if (tp == 3) body = "[图片]";
                            else if (tp == 34) body = "[语音]";
                            else if (tp == 43) body = "[视频]";
                            else if (tp == 47) body = "[表情]";
                            else if (tp == 49) body = "[文件/链接]";
                            else if (tp == 42) body = "[名片]";
                            else if (tp == 48) body = "[位置]";
                            else if (tp == 10000) body = "[系统提示]";
                            else body = "[其他消息]";
                        } else if (body.startsWith("<")) {
                            body = "[其他消息]";   // 兜底：非 XML 文本才发
                        }
                        if (body.length() > 300) body = body.substring(0, 300) + "…";
                        out.add("【转发】" + who + "：" + body);
                    }
                } catch (Throwable t) { log("FWDQ|build err " + t); }
                log("FWDQ|built " + out.size() + " -> " + target);
                if (out.isEmpty()) { toast("没有可转发的消息"); return; }
                fwdQ = out; fwdTarget = target; fwdIdx = 0; fwdRetry = 0;
                a.runOnUiThread(new Runnable() { @Override public void run() {
                    try {
                        android.content.Intent it = new android.content.Intent();
                        it.setClassName(a.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
                        it.putExtra("Chat_User", resolveTalker(target));
                        it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK
                                | android.content.Intent.FLAG_ACTIVITY_CLEAR_TOP
                                | android.content.Intent.FLAG_ACTIVITY_SINGLE_TOP);
                        android.content.Intent _csw = prepareChatSwitch(a, it);
                        if (_csw != null) a.startActivity(_csw);
                        toast("开始转发 " + fwdQ.size() + " 条到「" + tnm + "」");
                    } catch (Throwable t) { log("FWDQ|open err " + t); }
                } });
                pumpForward();
            }
        }).start();
    }

    private static void pumpForward() {
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        h.postDelayed(new Runnable() {
            @Override public void run() {
                try {
                    if (fwdQ == null) return;
                    android.app.Activity a = chatAct;
                    if (a == null || chatTalker == null || !chatTalker.equals(fwdTarget)) {
                        if (++fwdRetry > 24) { log("FWDQ|give up open"); toast("转发中止：打不开会话"); fwdQ = null; return; }
                        h.postDelayed(this, 500L);
                        return;
                    }
                    if (fwdIdx >= fwdQ.size()) {
                        toast("转发完成 " + fwdQ.size() + " 条");
                        log("FWDQ|done " + fwdQ.size());
                        fwdQ = null;
                        return;
                    }
                    android.view.View root = a.getWindow().getDecorView();
                    android.widget.EditText et = findEditText(root);
                    android.view.View btn = findSendButton(root);
                    if (et == null || btn == null || et.getWidth() == 0) {
                        if (++fwdRetry > 40) { log("FWDQ|give up ui"); fwdQ = null; return; }
                        h.postDelayed(this, 400L);
                        return;
                    }
                    fwdRetry = 0;
                    et.setText(fwdQ.get(fwdIdx));
                    et.setSelection(fwdQ.get(fwdIdx).length());
                    btn.performClick();
                    fwdIdx++;
                    if (fwdIdx % 5 == 0) log("FWDQ|sent " + fwdIdx + "/" + fwdQ.size());
                    h.postDelayed(this, 700L);
                } catch (Throwable t) { log("FWDQ|err " + t); fwdQ = null; }
            }
        }, 900L);
    }

    /* ================= 通用发送：打开会话 → 填入 → 点发送 ================= */
    private static volatile String sendToTalker = null;
    private static volatile String sendToText = null;
    private static volatile int sendTries = 0;
    private static volatile android.net.Uri sendImgUri = null;

    /** 供通知回复 / 自动回复 / 批量操作复用的发送入口 */
    static void sendTextTo(final android.app.Activity host, final String talker, final String text) {
        try {
            android.app.Activity a = host != null ? host : (topAct != null ? topAct : lastAct);
            if (a == null) a = mainAct;
            if (a == null) a = chatAct;
            if (a == null) a = topActivityNow();
            // 后台转发时上面全部为 null，退回 Application 上下文（带 NEW_TASK 也能拉起 Activity）
            android.content.Context ctx = a;
            if (ctx == null) ctx = ctxAny();
            if (ctx == null) { log("SEND|no ctx"); return; }
            sendToTalker = talker;
            sendToText = text;
            sendTries = 0;
            android.content.Intent it = new android.content.Intent();
            it.setClassName(ctx.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
            it.putExtra("Chat_User", resolveTalker(talker));
            // 关键：已经在聊天页时，带 SINGLE_TOP/CLEAR_TOP 会复用当前 Activity 并忽略 Chat_User，
            // 导致"发送到别的会话"实际发回原会话。这里只用 NEW_TASK，强制新建实例。
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
            android.content.Intent _csw = prepareChatSwitch(
                    (ctx instanceof android.app.Activity) ? (android.app.Activity) ctx : null, it);
            if (_csw != null) ctx.startActivity(_csw);
            log("SEND|open " + talker + " by=" + (a != null ? "act" : "appctx"));
            pumpSend();
        } catch (Throwable t) { log("SEND|err " + t); }
    }

    /** 打开目标会话后粘贴图片并发送 */
    static void sendImageTo(final android.app.Activity host, final String talker, final android.net.Uri uri) {
        try {
            android.app.Activity a = host != null ? host : (topAct != null ? topAct : lastAct);
            if (a == null) a = mainAct;
            if (a == null) a = topActivityNow();
            if (a == null) { log("SENDIMG|no activity"); return; }
            sendToTalker = talker;
            sendToText = "[图片]";
            sendImgUri = uri;
            sendTries = 0;
            android.content.Intent it = new android.content.Intent();
            it.setClassName(a.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
            it.putExtra("Chat_User", resolveTalker(talker));
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
            android.content.Intent _csw = prepareChatSwitch(a, it);
            if (_csw != null) a.startActivity(_csw);
            log("SENDIMG|open " + talker);
            pumpSend();
        } catch (Throwable t) { log("SENDIMG|err " + t); }
    }

    /** 从当前聊天页标题/输入框反推会话 id（chatTalker 未及时更新时兜底） */
    private static String currentChatTalker() {
        try {
            if (chatTalker != null && chatTalker.length() > 0) return chatTalker;
            android.app.Activity a = chatAct != null ? chatAct : topActivityNow();
            if (a == null) return null;
            android.content.Intent it = a.getIntent();
            if (it == null) return null;
            String v = it.getStringExtra("Chat_User");
            if (v != null && v.length() > 0) return v;
            String v2 = it.getStringExtra("chat_username");
            if (v2 != null && v2.length() > 0) return v2;
        } catch (Throwable ignore) { }
        return null;
    }

    private static void pumpSend() {
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        h.postDelayed(new Runnable() {
            @Override public void run() {
                try {
                    String tk = sendToTalker, tx = sendToText;
                    if (tk == null || tx == null) return;
                    if (++sendTries > 60) { log("SEND|give up chatTalker=" + chatTalker + " want=" + tk); sendToTalker = null; return; }
                    android.app.Activity a = chatAct;
                    if (a == null) a = topActivityNow();
                    boolean onTarget = a != null && a.getClass().getName().contains("ChattingUI")
                            && chatTalker != null && chatTalker.equals(tk);
                    if (!onTarget) {
                        if (sendTries == 8) log("SEND|wait chatTalker=" + chatTalker + " want=" + tk);
                        pumpSend();
                        return;
                    }
                    android.view.View root = a.getWindow().getDecorView();
                    android.widget.EditText et = findEditText(root);
                    if (et == null || et.getWidth() == 0) { pumpSend(); return; }
                    if (sendImgUri != null) {
                        android.net.Uri u = sendImgUri;
                        sendImgUri = null;
                        try {
                            android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                    a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                            cm.setPrimaryClip(android.content.ClipData.newUri(a.getContentResolver(), "wxh_image", u));
                            log("SENDIMG|clip " + u);
                            pasteAndSend(a, false);
                            log("SENDIMG|pasted " + tk);
                        } catch (Throwable t2) { log("SENDIMG|paste err " + t2); }
                        sendToTalker = null;
                        return;
                    }
                    et.setText(tx);
                    et.setSelection(tx.length());
                    final android.view.View btn = findSendButton(root);
                    if (btn == null) { pumpSend(); return; }
                    btn.performClick();
                    log("SEND|ok " + tk + " tries=" + sendTries);
                    sendToTalker = null;
                } catch (Throwable t) { log("SEND|err " + t); }
            }
        }, 400L);
    }

    /* ================= 验证钩子：长按→菜单→菜单项 链路 ================= */
    /** 直接按类名找 MMChattingListView（比 findMsgList 的头像启发式稳） */
    private static android.view.View findChattingList(android.view.View root) {
        try {
            java.util.ArrayList<Object> ls = new java.util.ArrayList<Object>();
            collectLists(root, ls);
            for (Object o : ls) {
                if (!(o instanceof android.view.ViewGroup)) continue;
                android.view.ViewGroup g = (android.view.ViewGroup) o;
                if (!g.getClass().getSimpleName().contains("MMChattingListView")) continue;
                if (g.getChildCount() > 0) return g;
            }
        } catch (Throwable ignore) { }
        return null;
    }

    private static void runMenuProbe(final android.app.Activity a) {
        runMenuProbeRetry(a, 0);
    }

    private static void runMenuProbeRetry(final android.app.Activity a, final int round) {
        try {
            android.view.View ml = findChattingList(a.getWindow().getDecorView());
            if (ml == null) ml = findMsgList(a.getWindow().getDecorView());
            if (!(ml instanceof android.view.ViewGroup)) {
                if (round < 8) {
                    new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
                            new Runnable() { @Override public void run() { runMenuProbeRetry(a, round + 1); } },
                            700L);
                    return;
                }
                // 打印所有像列表的容器，便于判断到底卡在哪
                try {
                    java.util.ArrayList<Object> ls = new java.util.ArrayList<Object>();
                    collectLists(a.getWindow().getDecorView(), ls);
                    StringBuilder sb = new StringBuilder();
                    for (Object o : ls) {
                        if (!(o instanceof android.view.ViewGroup)) continue;
                        android.view.ViewGroup g2 = (android.view.ViewGroup) o;
                        sb.append(g2.getClass().getSimpleName()).append('[')
                          .append(g2.getWidth()).append('x').append(g2.getHeight())
                          .append("c=").append(g2.getChildCount()).append("] ");
                    }
                    log("MENUTEST|no list after retries, lists=" + sb);
                } catch (Throwable ignore) { }
                return;
            }
            final android.view.ViewGroup g = (android.view.ViewGroup) ml;
            int n = g.getChildCount();
            log("MENUTEST|rows=" + n);
            if (n == 0) return;
            // 挑中间一行的最宽 TextView 当长按锚点（大概率是文字气泡）
            android.view.View target = null;
            StringBuilder dump = new StringBuilder();
            for (int i = n - 1; i >= 0 && target == null; i--) {
                android.view.View row = g.getChildAt(i);
                java.util.ArrayList<android.view.View> vs = new java.util.ArrayList<android.view.View>();
                collectAllViews(row, vs, 0);
                android.widget.TextView best = null; int bw = 0;
                for (android.view.View v : vs) {
                    if (!(v instanceof android.widget.TextView)) continue;
                    CharSequence cs = ((android.widget.TextView) v).getText();
                    if (cs == null) continue;
                    String tx = cs.toString().trim();
                    if (tx.length() == 0) continue;
                    if (dump.length() < 300) dump.append(i).append(':').append(tx.length()).append('/');
                    int w = v.getWidth();
                    if (w > bw) { bw = w; best = (android.widget.TextView) v; }
                }
                if (best != null) target = best;
            }
            log("MENUTEST|texts " + dump + " round=" + round);
            if (target == null) {
                if (round < 10) {
                    new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
                            new Runnable() { @Override public void run() { runMenuProbeRetry(a, round + 1); } },
                            800L);
                    return;
                }
                log("MENUTEST|no text row after retries");
                return;
            }
            // 从文字往上找真正「可长按」的容器（微信把长按监听挂在行/气泡容器上）
            android.view.View lc = target;
            int guard = 0;
            while (lc != null && !lc.isLongClickable() && guard++ < 8) {
                android.view.ViewParent pv = lc.getParent();
                if (!(pv instanceof android.view.View)) break;
                lc = (android.view.View) pv;
            }
            log("MENUTEST|text=" + target.getClass().getSimpleName() + " longClickable="
                    + (lc != null && lc.isLongClickable())
                    + " cls=" + (lc == null ? "null" : lc.getClass().getSimpleName()));
            // 微信用的是标准 ContextMenu（ChattingUI.onCreateContextMenu 有多处实现）。
            // performLongClick() 因为 isLongClickable()==true 会提前返回，什么都不做；
            // 直接调 showContextMenu() 才会走 onCreateContextMenu 那条路。
            final android.view.View rowV = g.getChildAt(Math.max(0, g.getChildCount() / 2));
            android.view.View reg = rowV;
            int guard2 = 0;
            while (reg != null && guard2++ < 10) {
                if (reg instanceof android.view.ViewGroup) {
                    log("MENUTEST|try " + reg.getClass().getSimpleName());
                    boolean ok = false;
                    try { ok = reg.showContextMenu(); } catch (Throwable ignore) { }
                    if (ok) { log("MENUTEST|showContextMenu ok on " + reg.getClass().getSimpleName()); break; }
                }
                android.view.ViewParent pv2 = reg.getParent();
                reg = (pv2 instanceof android.view.View) ? (android.view.View) pv2 : null;
            }
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        java.util.List<android.view.View> roots = allRoots();
                        boolean found = false;
                        for (android.view.View r : roots) {
                            java.util.ArrayList<android.view.View> vs = new java.util.ArrayList<android.view.View>();
                            collectAllViews(r, vs, 0);
                            StringBuilder sb = new StringBuilder();
                            for (android.view.View v : vs) {
                                if (!(v instanceof android.widget.TextView)) continue;
                                CharSequence cs = ((android.widget.TextView) v).getText();
                                if (cs == null) continue;
                                String tx = cs.toString().trim();
                                if (tx.length() == 0 || tx.length() > 8) continue;
                                sb.append(tx).append('/');
                                if (tx.equals("引用")) found = true;
                            }
                            if (sb.length() > 0) log("MENUTEST|root " + r.getClass().getSimpleName() + " items=" + sb);
                        }
                        log("MENUTEST|hasQuote=" + found);
                    } catch (Throwable e) { log("MENUTEST|err " + e); }
                }
            }, 2200L);
        } catch (Throwable t) { log("MENUTEST|err " + t); }
    }

    /* ================= 验证钩子：选群→选成员→出结果 链路 ================= */
    private static void runPick2Probe(android.app.Activity a) {
        try {
            String tk = chatTalker != null ? chatTalker : "12345678@chatroom";
            java.util.List<Object[]> s1 = recentSenders(tk);
            log("PICK2|senders=" + s1.size());
            if (s1.isEmpty()) { log("PICK2|no senders"); return; }
            Object[] top = s1.get(0);
            String uid = String.valueOf(top[0]);
            String unm = top[1] == null ? uid : String.valueOf(top[1]);
            log("PICK2|top=" + unm + " uid=" + uid + " n=" + top[2]);
            String[] out = new String[1];
            int hits = buildMemberMsgsCsv(tk, displayOfTalker(tk), uid, unm, out);
            log("PICK2|memberMsgs hits=" + hits + " path=" + out[0]);
        } catch (Throwable t) { log("PICK2|err " + t); }
    }

    /* ================= 群成员消息历史 ================= */
    private static void showMemberMsgs(final android.app.Activity a) {
        showTalkerPicker(a, "选一个群", true, new ChatPick() {
            @Override public void onPick(final String tk, final String nm) {
                toast("正在统计发言成员…");
                new Thread(new Runnable() {
                    @Override public void run() {
                        final java.util.List<Object[]> rows = recentSenders(tk);
                        a.runOnUiThread(new Runnable() {
                            @Override public void run() {
                                try {
                                    final android.app.Dialog[] dd = new android.app.Dialog[1];
                                    android.widget.LinearLayout box = new android.widget.LinearLayout(a);
                                    box.setOrientation(android.widget.LinearLayout.VERTICAL);
                                    android.widget.ScrollView sv = new android.widget.ScrollView(a);
                                    android.widget.LinearLayout list = new android.widget.LinearLayout(a);
                                    list.setOrientation(android.widget.LinearLayout.VERTICAL);
                                    sv.addView(list);
                                    box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 440)));
                                    for (Object[] r : rows) {
                                        final String uid = String.valueOf(r[0]);
                                        final String unm = r[1] == null ? uid : String.valueOf(r[1]);
                                        android.widget.TextView tv = new android.widget.TextView(a);
                                        tv.setText(unm + "  ·  " + r[2] + " 条");
                                        tv.setTextSize(15);
                                        tv.setTextColor(0xFF1A1A1E);
                                        tv.setPadding(dp(a, 10), dp(a, 11), dp(a, 10), dp(a, 11));
                                        tv.setOnClickListener(new android.view.View.OnClickListener() {
                                            @Override public void onClick(android.view.View v) {
                                                if (dd[0] != null) { try { dd[0].dismiss(); } catch (Throwable ignore) { } }
                                                loadMemberMsgs(a, tk, nm, uid, unm);
                                            }
                                        });
                                        list.addView(tv, new android.widget.LinearLayout.LayoutParams(-1, -2));
                                    }
                                    dd[0] = new android.app.AlertDialog.Builder(a)
                                            .setTitle("选择成员 · " + nm)
                                            .setView(box)
                                            .setNegativeButton("取消", null)
                                            .create();
                                    dd[0].show();
                                } catch (Throwable t) { log("MMSG|picker err " + t); }
                            }
                        });
                    }
                }).start();
            }
        });
    }

    /** 抽出数据层：给定 talker + 成员 uid，扫描全量并写 CSV，返回命中条数 */
    private static int buildMemberMsgsCsv(final String talker, final String gname,
                                          final String uid, final String unm, String[] outPath) {
        int n = 0;
        try {
            java.util.ArrayList<String[]> hits = new java.util.ArrayList<String[]>();
            java.text.SimpleDateFormat f =
                    new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US);
            int pageSize = 5000;
            for (int off = 0; off < 40000; off += pageSize) {
                java.util.List<Object[]> rows = queryRows(
                        "select ifnull(content,''), createTime, ifnull(type,0) from message where talker='"
                                + escSql(talker) + "' order by createTime limit " + pageSize
                                + " offset " + off, 3);
                if (rows.isEmpty()) break;
                for (Object[] r : rows) {
                    String c = r[0] == null ? "" : String.valueOf(r[0]);
                    String sid = senderIdOfGroupMsg(c);
                    if (sid == null || !sid.equals(uid)) continue;
                    long ct = 0;
                    try { ct = ctToMs(Long.parseLong(String.valueOf(r[1]))); } catch (Throwable ignore) { }
                    int tp = 0;
                    try { tp = Integer.parseInt(String.valueOf(r[2])) & 65535; } catch (Throwable ignore) { }
                    int nl = c.indexOf('\n');
                    String body = nl >= 0 ? c.substring(nl + 1) : c;
                    if (tp == 3) body = "[图片]";
                    else if (tp == 34) body = "[语音]";
                    else if (tp == 43) body = "[视频]";
                    else if (tp == 49) body = "[文件/链接]";
                    else if (body.length() > 120) body = body.substring(0, 120) + "…";
                    hits.add(new String[]{ct > 0 ? f.format(new java.util.Date(ct)) : "-", body});
                }
                if (rows.size() < pageSize) break;
            }
            n = hits.size();
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
            dir.mkdirs();
            StringBuilder csv = new StringBuilder("\uFEFF时间,内容\n");
            for (String[] h : hits) {
                csv.append(h[0]).append(',').append(h[1].replace(",", "，").replace("\n", " ")).append('\n');
            }
            java.io.File out = new java.io.File(dir, "member_msgs_" + safeName(unm) + "_"
                    + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                    .format(new java.util.Date()) + ".csv");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            fo.write(csv.toString().getBytes("UTF-8"));
            fo.close();
            if (outPath != null && outPath.length > 0) outPath[0] = out.getAbsolutePath();
            log("MMSG|" + talker + " uid=" + uid + " n=" + n + " path=" + out.getAbsolutePath());
        } catch (Throwable t) { log("MMSG|err " + t); }
        return n;
    }

    private static void loadMemberMsgs(final android.app.Activity a, final String talker, final String gname,
                                       final String uid, final String unm) {
        toast("正在查找…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<String[]> hits = new java.util.ArrayList<String[]>();
                try {
                    java.text.SimpleDateFormat f =
                            new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US);
                    int pageSize = 5000;
                    for (int off = 0; off < 40000; off += pageSize) {
                        java.util.List<Object[]> rows = queryRows(
                                "select ifnull(content,''), createTime, ifnull(type,0) from message where talker='"
                                        + escSql(talker) + "' order by createTime limit " + pageSize
                                        + " offset " + off, 3);
                        if (rows.isEmpty()) break;
                        for (Object[] r : rows) {
                            String c = r[0] == null ? "" : String.valueOf(r[0]);
                            String sid = senderIdOfGroupMsg(c);
                            if (sid == null || !sid.equals(uid)) continue;
                            long ct = 0;
                            try { ct = ctToMs(Long.parseLong(String.valueOf(r[1]))); } catch (Throwable ignore) { }
                            int tp = 0;
                            try { tp = Integer.parseInt(String.valueOf(r[2])) & 65535; } catch (Throwable ignore) { }
                            int nl = c.indexOf('\n');
                            String body = nl >= 0 ? c.substring(nl + 1) : c;
                            if (tp == 3) body = "[图片]";
                            else if (tp == 34) body = "[语音]";
                            else if (tp == 43) body = "[视频]";
                            else if (tp == 49) body = "[文件/链接]";
                            else if (body.length() > 120) body = body.substring(0, 120) + "…";
                            hits.add(new String[]{ct > 0 ? f.format(new java.util.Date(ct)) : "-", body});
                        }
                        if (rows.size() < pageSize) break;
                    }
                    // 导出 CSV
                    try {
                        java.io.File dir = new java.io.File(
                                android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
                        dir.mkdirs();
                        StringBuilder csv = new StringBuilder("\uFEFF时间,内容\n");
                        for (String[] h : hits) {
                            csv.append(h[0]).append(',').append(h[1].replace(",", "，").replace("\n", " ")).append('\n');
                        }
                        java.io.File out = new java.io.File(dir, "member_msgs_" + safeName(unm) + "_"
                                + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                                .format(new java.util.Date()) + ".csv");
                        java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
                        fo.write(csv.toString().getBytes("UTF-8"));
                        fo.close();
                        log("MMSG|" + talker + " uid=" + uid + " n=" + hits.size() + " path=" + out.getAbsolutePath());
                    } catch (Throwable ignore) { }
                } catch (Throwable t) { log("MMSG|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        StringBuilder sb = new StringBuilder();
                        int lim = Math.min(30, hits.size());
                        for (int i = hits.size() - lim; i < hits.size(); i++) {
                            String[] h = hits.get(i);
                            sb.append(h[0]).append("  ").append(h[1]).append('\n');
                        }
                        if (hits.isEmpty()) sb.append("没找到该成员的发言");
                        new android.app.AlertDialog.Builder(a)
                                .setTitle(unm + " · " + gname + "（" + hits.size() + " 条）")
                                .setMessage(sb.toString())
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    /** 左滑后：长按这一行调出菜单，再点微信自己的「引用」 */
    private static void quoteViaMenu(final android.view.View row) {
        try {
            android.app.Activity a = chatAct;
            if (a == null) return;
            final android.view.View decor = a.getWindow().getDecorView();
            row.performLongClick();
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        boolean ok = clickMenuText(decor, "引用");
                        log("SWQ|quote=" + ok);
                    } catch (Throwable ignore) { }
                }
            }, 260L);
        } catch (Throwable ignore) { }
    }

    private static long todayRefuseAt = 0;
    private static int todayNoTalkerN = 0;
    private static int todayMissN = 0;
    /** 聊天页 Activity 名：ChattingUI / ChattingMainUI 等都要认，聊天信息页要排除 */
    private static boolean isChatActName(String n) {
        if (n == null) return false;
        if (n.contains("ChattingInfo")) return false;
        return n.contains("Chatting");
    }

    private static void startTodayCount(final android.app.Activity act) {
        if (act == null) return;
        String an = act.getClass().getName();
        boolean isChatAct = isChatActName(an);
        // 8.0.80 里从「微信」列表点进聊天时，聊天是挂在 LauncherUI 里的 Fragment，
        // 不会新建 ChattingUI。此时只要会话已解析出来，就应该允许挂工具栏。
        // 8.0.80 起部分入口（如文件传输助手）用 UIPageFragmentActivity 承载，同样放行；
        // 真正的挂载点由 hasChatFooter(act) 判定，找不到输入框就不会挂任何东西。
        boolean isPageAct = an.contains("UIPageFragmentActivity");
        // 是否允许尝试挂载：只看承载页面，不再要求「会话已解析」——
        // 从列表点进聊天时 talker 往往要几百毫秒才解析出来，早期用 talker 当门槛会把工具栏整个拒掉。
        // 真正的挂载点仍由 tick 里的 ChatFooter 判定兜住，找不到输入框就什么也不挂。
        boolean isHostAct = (an.endsWith(".LauncherUI") || isPageAct);
        if (!isChatAct && !isHostAct) {
            long tr = System.currentTimeMillis();
            if (tr - todayRefuseAt > 5000) { todayRefuseAt = tr;
                log("TODAY|refuse non-chat " + an + " inChat=" + inChat + " tk=" + chatTalker); }
            return;
        }
        log("TODAY|start pid=" + android.os.Process.myPid());
        if (todayLoopOn) {
            // 已经有一个循环在跑：如果它盯的是别的 Activity（切会话了），让它退出后重启，
            // 否则新会话永远拿不到工具栏（之前私聊不显示就是这个问题）
            if (todayAct != null && todayAct != act) {
                log("TODAY|switch chat, restart loop");
                todayLoopOn = false;
            } else {
                return;
            }
        }
        todayLoopOn = true;
        todayAct = act;
        final Runnable task = new Runnable() {
            @Override public void run() {
                try {
                    long tk0 = System.currentTimeMillis();
                    if (tk0 - lastTickLog > 3000) {
                        lastTickLog = tk0;
                        log("TODAY|tick act=" + act.getClass().getSimpleName()
                                + " inChat=" + inChat + " tk=" + chatTalker);
                    }
                    boolean inChatX = inChat || isInChatUi() || chatTalker != null || hasChatFooter(act);
                    if (!inChatX) { reschedTask(this, 2000); return; }
                    // 聊天页里顺带把「行样式 + 每条消息时间」循环拉起来（不依赖 Fragment/样式循环的启动时机）
                    if (inChat || isInChatUi() || chatTalker != null) {
                        try { ensureChatStyleLoop(act); } catch (Throwable ignore) { }
                        try { applyInputHint(); } catch (Throwable ignore) { }
                    }
                    // 与入口判定保持一致：LauncherUI 承载聊天的情形（微信列表点进来）也要放行
                    String actName = act.getClass().getName();
                    boolean stillChat = isChatActName(actName)
                            || (actName.endsWith(".LauncherUI")
                                && (inChat || isInChatUi() || chatTalker != null || hasChatFooter(act)))
                            || hasChatFooter(act);
                    if (!stillChat) {
                        // 自愈：界面上能看到消息列表就认定在聊天页（分身/双开里 inChat、chatTalker 常常拿不到）
                        try {
                            boolean uiChat = findMsgList(act.getWindow().getDecorView()) != null;
                            if (!uiChat) {
                                for (android.view.View r9 : allRoots()) {
                                    if (findMsgList(r9) != null) { uiChat = true; break; }
                                }
                            }
                            if (uiChat) { stillChat = true; inChat = true; chatAct = act; }
                        } catch (Throwable ignore) { }
                    }
                    if (!stillChat) {
                        todayMissN++;
                        if (todayMissN < 8) {
                            // 刚进聊天时 inChat/talker 还没置位，别一拍就停（工具栏反复消失就是这么来的）
                            reschedTask(this, 1500);
                            return;
                        }
                        todayMissN = 0;
                    } else {
                        todayMissN = 0;
                    }
                    // 会话 id 还没解析出来时，用标题栏文字反查（限速 1 秒一次）
                    if (stillChat && (chatTalker == null || chatTalker.length() == 0)) {
                        long nowT = System.currentTimeMillis();
                        if (nowT - lastTitleTry > 1000) {
                            lastTitleTry = nowT;
                            try {
                                String tn = chatNameOfActivity(act);
                                if (tn != null) {
                                    String id = wxidByName(tn.replaceAll("\\(\\d+\\)$", "").trim());
                                    if (id != null && id.length() > 0) {
                                        chatTalker = id;
                                        log("TODAY|tk by title " + tn + " -> " + id);
                                    } else {
                                        log("TODAY|title unresolved " + tn);
                                    }
                                }
                            } catch (Throwable ignore) { }
                        }
                    }
                    if (!stillChat) {
                        todayLoopOn = false;
                        log("TODAY|stop non-chat " + act.getClass().getSimpleName()
                                + " inChat=" + inChat + " tk=" + chatTalker);
                        return;
                    }
                    if (chatAct != null && chatAct != act) {
                        if (actName.endsWith(".LauncherUI")) {
                            // 聊天挂在 LauncherUI 的 Fragment 上，chatAct 指向的是旧 Activity
                            chatAct = act;
                            log("TODAY|adopt host act");
                        } else {
                            todayLoopOn = false;
                            log("TODAY|stop stale act");
                            return;
                        }
                    }
                    android.view.View root = act.getWindow().getDecorView();
                    // 从「微信」列表点进聊天时，聊天视图不在 act 的 decor 上（实测 44 个视图、无输入框）。
                    // ChatFooter 挂上时我们会记下它，用它的根视图来定位才准。
                    if (todayAnchor != null) {
                        try {
                            android.view.View rr = todayAnchor.getRootView();
                            if (rr != null) root = rr;
                        } catch (Throwable ignore) { }
                    }
                    if (todayTv != null && todayTv.getWindowToken() == null) {
                        todayTv = null;
                    }
                    android.widget.EditText et = findEditText(root, 0);
                    // 从「微信」列表点进聊天时，聊天内容不在 LauncherUI 的 decor 里
                    // （实测 decor 只有 44 个视图，无 EditText/ChatFooter），
                    // 它在另一个窗口根上 —— 遍历所有窗口根找 ChatFooter。
                    android.view.View footerAnchor = null;
                    if (et == null) footerAnchor = findFooter(root, 0);
                    if (et == null && footerAnchor == null) {
                        for (android.view.View r2 : allRoots()) {
                            if (r2 == root) continue;
                            android.widget.EditText e2 = findEditText(r2, 0);
                            if (e2 != null) { et = e2; root = r2; break; }
                            android.view.View f2 = findFooter(r2, 0);
                            if (f2 != null) { footerAnchor = f2; root = r2; break; }
                        }
                    }
                    boolean confidentChat = inChat || isInChatUi() || chatTalker != null;
                    if (footerAnchor == null && et != null && !confidentChat && findMsgList(root) == null) {
                        // 只有输入框没有 ChatFooter，又判断不出在聊天里（多半停在搜索页）：先别挂
                        reschedTask(this, 600);
                        return;
                    }
                    if (et == null && footerAnchor == null) {
                        if (System.currentTimeMillis() - lastTodayTry > 2000) {
                            lastTodayTry = System.currentTimeMillis();
                            log("TODAY|no input found root=" + root.getClass().getSimpleName()
                                    + " act=" + act.getClass().getSimpleName()
                                    + " sv=" + root.getClass().getName()
                                    + " c=" + ((android.view.ViewGroup) root).getChildCount());
                            try {
                                android.view.ViewGroup dg = (android.view.ViewGroup) root;
                                StringBuilder sb = new StringBuilder();
                                for (int ci = 0; ci < dg.getChildCount(); ci++) {
                                    android.view.View ch = dg.getChildAt(ci);
                                    sb.append(ci).append(':').append(ch.getClass().getSimpleName());
                                    if (ch instanceof android.view.ViewGroup)
                                        sb.append('(').append(((android.view.ViewGroup) ch).getChildCount()).append(')');
                                    sb.append(' ');
                                }
                                log("TODAY|decor children " + sb);
                                java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
                                collectAllViews(root, all, 0);
                                int ets = 0, footers = 0;
                                StringBuilder cls = new StringBuilder();
                                for (android.view.View vv : all) {
                                    String c2 = vv.getClass().getName();
                                    if (vv instanceof android.widget.EditText) ets++;
                                    if (c2.contains("ChatFooter") || c2.contains("ChattingFooter")) footers++;
                                    if (c2.contains("EditText") || c2.contains("ChatFooter")) cls.append(c2).append(';');
                                }
                                log("TODAY|all=" + all.size() + " ets=" + ets + " footers=" + footers + " " + cls);
                                StringBuilder rb = new StringBuilder();
                                for (android.view.View r3 : allRoots()) {
                                    java.util.ArrayList<android.view.View> a3 = new java.util.ArrayList<android.view.View>();
                                    collectAllViews(r3, a3, 0);
                                    int e3 = 0, f3 = 0;
                                    for (android.view.View v3 : a3) {
                                        if (v3 instanceof android.widget.EditText) e3++;
                                        String c3 = v3.getClass().getName();
                                        if (c3.contains("ChatFooter") || c3.contains("ChattingFooter")) f3++;
                                    }
                                    rb.append(r3.getClass().getSimpleName()).append('/').append(a3.size())
                                      .append(":et").append(e3).append(":f").append(f3).append(' ');
                                }
                                log("TODAY|roots " + rb);
                            } catch (Throwable ignore) { }
                            if (!treeDumped) {
                                treeDumped = true;
                                try { dumpTree(root, 0, new StringBuilder()); } catch (Throwable ignore) { }
                            }
                        }
                        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(this, 400);
                        return;
                    }
                    // 向上找到竖向 LinearLayout 作为插入点，保证显示在输入框上方
                    android.view.ViewGroup box = null;
                    android.view.View cur = (android.view.View) (et != null ? et : footerAnchor);
                    android.view.View existing = null;
                    for (int up = 0; up < 10; up++) {
                        android.view.ViewParent vp = cur.getParent();
                        if (!(vp instanceof android.view.ViewGroup)) break;
                        android.view.ViewGroup g = (android.view.ViewGroup) vp;
                        existing = g.findViewWithTag("wxhTodayCount");
                        if (existing != null) break;
                        if (g instanceof android.widget.LinearLayout
                                && ((android.widget.LinearLayout) g).getOrientation()
                                   == android.widget.LinearLayout.VERTICAL) {
                            box = g;
                            break;
                        }
                        cur = g;
                    }
                    if (box == null) {
                        // 找不到竖向容器时，用 ChatFooter 的父容器（必须也是竖向）
                        try {
                            android.view.View footer = findByClass(root,
                                    "com.tencent.mm.pluginsdk.ui.chat.ChatFooter", 0);
                            if (footer != null && footer.getParent() instanceof android.view.ViewGroup) {
                                android.view.ViewGroup fp = (android.view.ViewGroup) footer.getParent();
                                if (fp instanceof android.widget.LinearLayout
                                        && ((android.widget.LinearLayout) fp).getOrientation()
                                           == android.widget.LinearLayout.VERTICAL) {
                                    box = fp;
                                }
                            }
                        } catch (Throwable ignore) { }
                    }
                    if (box == null) {
                        // 实在找不到竖向容器就等下一拍，绝不硬塞进横向输入行（会被挤成 0 宽看不见）
                        if (System.currentTimeMillis() - lastTodayTry > 3000) {
                            lastTodayTry = System.currentTimeMillis();
                            StringBuilder sb = new StringBuilder();
                            android.view.View cv = et;
                            for (int up2 = 0; up2 < 6 && cv != null; up2++) {
                                sb.append(cv.getClass().getSimpleName()).append('/');
                                android.view.ViewParent vp2 = cv.getParent();
                                cv = (vp2 instanceof android.view.View) ? (android.view.View) vp2 : null;
                            }
                            log("TODAY|no box chain=" + sb);
                        }
                        reschedTask(this, 500);
                        return;
                    }
                    if (existing == null) existing = box.findViewWithTag("wxhTodayCount");
                    if (existing != null && existing.getWindowToken() == null) {
                        try { box.removeView(existing); } catch (Throwable ignore) { }
                        existing = null;
                    }

                    if (chatTalker == null || chatTalker.length() == 0) {
                        try {
                            String nm = chatNameOfActivity(act);
                            if (nm != null && nm.length() > 0 && nm.indexOf("加载") < 0) {
                                String id = wxidByName(nm);
                                if (id == null || id.length() == 0) {
                                    String nm2 = nm.replaceAll("\\(\\d+\\)$", "").trim();
                                    if (nm2.length() > 0 && !nm2.equals(nm)) id = wxidByName(nm2);
                                }
                                if (id != null && id.length() > 0) {
                                    chatTalker = id;
                                    log("TALKER|late " + nm + " -> " + id);
                                }
                            }
                        } catch (Throwable ignore) { }
                    }
                    if (chatTalker == null || chatTalker.length() == 0) {
                        String viaAd = talkerFromAdapter(act);
                        if (viaAd != null && viaAd.length() > 0) {
                            chatTalker = viaAd;
                            log("TALKER|by adapter " + viaAd);
                        }
                    }
                    String tkX = chatTalker;
                    if (tkX == null || tkX.length() == 0) tkX = currentTalker();
                    if (tkX == null || tkX.length() == 0) tkX = lastKnownTalker;
                    final String talker = tkX == null ? "" : tkX;
                    if (talker.length() == 0) {
                        // 会话还没解析出来：等几拍；实在等不到也照样挂工具条（计数走全局，按钮点的时候再解析）
                        todayNoTalkerN++;
                        if (todayNoTalkerN < 6) { reschedTask(this, 600); return; }
                        log("TODAY|attach without talker");
                    } else {
                        todayNoTalkerN = 0;
                    }


                    // 今日已发条数改到输入框提示里显示，工具条只留功能按钮
                    todayTv = null;
                    clockTv = null;
                    try {
                        android.view.View oldRow = box.findViewWithTag("wxhTodayCount");
                        if (oldRow != null && oldRow.getParent() == box) ((android.view.ViewGroup) box).removeView(oldRow);
                    } catch (Throwable ignore) { }
                    if (cfg().optBoolean("todayCount", true)) {
                        try { applyInputHint(); } catch (Throwable ignore) { }
                    }
                    todayAttachedAt = System.currentTimeMillis();
                    inChat = true;
                    log("TODAY|hint attached pid=" + android.os.Process.myPid());

                    // 关键词话术推荐：客户问「多少钱/价格/地址」等，输入框上方出现一条可点建议
                    try {
                        if (cfg().optBoolean("recoHint", true)) {
                            long rn = System.currentTimeMillis();
                            if (rn - recoAt > 3000) {
                                recoAt = rn;
                                final String[] rr = recoForLastAsk();
                                android.widget.TextView reco = (android.widget.TextView) box.findViewWithTag("wxhReco");
                                if (rr == null) {
                                    if (reco != null) reco.setVisibility(android.view.View.GONE);
                                    if (rn - recoLogAt > 12000) { recoLogAt = rn;
                                        log("RECO|none tk=" + chatTalker + " last='" + lastAskText() + "'"); }
                                } else {
                                    if (reco == null) {
                                        reco = new android.widget.TextView(act);
                                        reco.setTag("wxhReco");
                                        reco.setTextSize(10);
                                        reco.setTextColor(0xFF2A55AA);
                                        reco.setPadding(28, 3, 28, 3);
                                        box.addView(reco, 0, new android.view.ViewGroup.LayoutParams(-1, -2));
                                    }
                                    reco.setVisibility(android.view.View.VISIBLE);
                                    String shortTxt = rr[1].length() > 20 ? rr[1].substring(0, 20) + "…" : rr[1];
                                    reco.setText("\uD83D\uDCAC 客户问「" + rr[0] + "」\u2192 " + shortTxt);
                                    final android.widget.EditText fet2 = et;
                                    reco.setOnClickListener(new android.view.View.OnClickListener() {
                                        @Override public void onClick(android.view.View v) {
                                            try {
                                                android.widget.EditText t2 = currentInput();
                                                if (t2 == null) t2 = fet2;
                                                if (t2 == null) { toast("没找到输入框"); return; }
                                                int st2 = t2.getSelectionStart();
                                                if (st2 < 0) st2 = t2.getText().length();
                                                t2.getText().insert(st2, rr[1]);
                                                toast("已插入推荐话术");
                                                log("RECO|insert " + rr[0]);
                                            } catch (Throwable ignore) { }
                                        }
                                    });
                                    log("RECO|hit " + rr[0]);
                                }
                            }
                        }
                    } catch (Throwable ignore) { }
                    // 聊天页右上角常驻 H 悬浮入口（工具栏整行被微信底栏触摸层吞掉，故独立叠在 decor 上）
                    try {
                        android.view.ViewGroup decorH = (android.view.ViewGroup) act.getWindow().getDecorView();
                        if (decorH.findViewWithTag("wxhHfab") == null) {
                            android.widget.TextView fab = new android.widget.TextView(act);
                            fab.setTag("wxhHfab");
                            fab.setText("H");
                            fab.setTextSize(13);
                            fab.setTypeface(android.graphics.Typeface.DEFAULT);
                            fab.setTextColor(0xFF576B95);
                            fab.setGravity(android.view.Gravity.CENTER);
                            fab.setIncludeFontPadding(false);
                            android.graphics.drawable.GradientDrawable fgd = new android.graphics.drawable.GradientDrawable();
                            fgd.setColor(0xFFFFFFFF);
                            fgd.setCornerRadius(dp(act, 20));
                            fgd.setStroke(dp(act, 1), 0xFFE5E5E5);
                            fab.setBackground(fgd);
                            fab.setElevation(dp(act, 2));
                            fab.setOnClickListener(new android.view.View.OnClickListener() {
                                @Override public void onClick(android.view.View v) { showSettings(act); }
                            });
                            android.widget.FrameLayout.LayoutParams flp =
                                    new android.widget.FrameLayout.LayoutParams(dp(act, 42), dp(act, 42));
                            flp.gravity = android.view.Gravity.RIGHT | android.view.Gravity.TOP;
                            flp.topMargin = dp(act, 104);
                            flp.rightMargin = dp(act, 8);
                            decorH.addView(fab, flp);
                            log("HFAB|added");
                        }
                    } catch (Throwable ignore) { }
                    // 输入框上方：常用语 / AI 回复
                    if (box.findViewWithTag("wxhChatTools") == null) {
                        android.widget.LinearLayout tools = new android.widget.LinearLayout(act);
                        tools.setTag("wxhChatTools");
                        tools.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                        tools.setGravity(android.view.Gravity.END | android.view.Gravity.CENTER_VERTICAL);
                        // 今日计数挪进这一行，与右侧入口横向对齐
                        if (todayTv != null && todayTv.getParent() == box) {
                            ((android.view.ViewGroup) box).removeView(todayTv);
                            todayTv.setGravity(android.view.Gravity.LEFT | android.view.Gravity.CENTER_VERTICAL);
                            todayTv.setVisibility(android.view.View.GONE);
                            tools.addView(todayTv, new android.widget.LinearLayout.LayoutParams(
                                    0, android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 0f));
                        }
                        final android.widget.EditText fet = et;
                        // 快捷栏统一顺序：常用语 · AI · 清未读 · 导出 · 清除修改 · @全体 · 天气 · H
                        boolean cmpBar = cfg().optBoolean("toolbarCompact", true);
                        java.util.ArrayList<String> labs = new java.util.ArrayList<String>();
                        java.util.ArrayList<Runnable> acts = new java.util.ArrayList<Runnable>();
                        labs.add("常用语");
                        acts.add(new Runnable() { @Override public void run() { showQuickPhrases(act, fet); } });
                        labs.add("AI");
                        acts.add(new Runnable() { @Override public void run() { aiGenerate(act, fet); } });
                        labs.add("清未读");
                        acts.add(new Runnable() { @Override public void run() {
                            try {
                                String tk = currentTalker();
                                if (tk != null) { markRead(tk); toast("已清本会话未读"); }
                            } catch (Throwable ignore) { }
                        } });
                        if (!cmpBar || (chatTalker != null && !chatTalker.endsWith("@chatroom"))) {
                            labs.add("导出");
                            acts.add(new Runnable() { @Override public void run() {
                                try {
                                    String tk = chatTalker != null && chatTalker.length() > 0
                                            ? chatTalker : currentTalker();
                                    if (tk == null || tk.length() == 0) { toast("还没识别到会话"); return; }
                                    showMediaExportTypes(act, displayOfTalker(tk));
                                } catch (Throwable t) { toast("打开失败"); }
                            } });
                            labs.add("清除修改");
                            acts.add(new Runnable() { @Override public void run() { clearAllEdits(act); } });
                        }
                        if (fet != null && chatTalker != null && chatTalker.endsWith("@chatroom")) {
                            labs.add("@全体");
                            acts.add(new Runnable() { @Override public void run() {
                                boolean ok = insertAtAll(act, fet);
                                toast(ok ? "已插入 @所有人（含实体），确认后发送" : "插入失败，请手动打 @ 选择");
                            } });
                            labs.add("群公告");
                            acts.add(new Runnable() { @Override public void run() {
                                try { runGroupNotices(act); } catch (Throwable t) { toast("打开失败"); }
                            } });
                        }
                        if (!cmpBar) {
                            labs.add("天气");
                            acts.add(new Runnable() { @Override public void run() { showWeather(act); } });
                        }
                        for (int ci0 = 0; ci0 < labs.size(); ci0++) {
                            android.widget.TextView chip = new android.widget.TextView(act);
                            chip.setText(labs.get(ci0));
                            chip.setTextSize(13);
                            String _lb = labs.get(ci0);
                            boolean _passive = _lb.equals("清未读") || _lb.equals("导出")
                                    || _lb.equals("清除修改") || _lb.equals("天气")
                                    || _lb.equals("@全体") || _lb.equals("群公告");
                            chip.setTextColor(_passive ? 0xFF7A7E83 : 0xFF576B95);
                            chip.setTypeface(android.graphics.Typeface.DEFAULT);
                            chip.setIncludeFontPadding(false);
                            chip.setPadding(dp(act, 4), dp(act, 5), dp(act, 4), dp(act, 5));
                            final Runnable ra = acts.get(ci0);
                            chip.setOnClickListener(new android.view.View.OnClickListener() {
                                @Override public void onClick(android.view.View v) { ra.run(); }
                            });
                            tools.addView(chip);
                        }
                        android.view.ViewGroup.LayoutParams tlp = box instanceof android.widget.LinearLayout
                                ? new android.widget.LinearLayout.LayoutParams(
                                        android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT)
                                : new android.view.ViewGroup.LayoutParams(
                                        android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                        box.addView(tools, 0, tlp);
                        try {
                            tools.setGravity(android.view.Gravity.CENTER);
                            int cntTools = tools.getChildCount();
                            for (int ci = 0; ci < cntTools; ci++) {
                                android.view.View ch = tools.getChildAt(ci);
                                if (ch.getVisibility() != android.view.View.VISIBLE) continue;
                                ch.setBackground(null);
                                android.widget.LinearLayout.LayoutParams clp =
                                        new android.widget.LinearLayout.LayoutParams(0, -2, 1f);
                                clp.setMargins(dp(act, 2), dp(act, 2), dp(act, 2), dp(act, 2));
                                ch.setLayoutParams(clp);
                            }
                        } catch (Throwable ignore) { }

android.view.ViewGroup.LayoutParams tlp2 = box instanceof android.widget.LinearLayout
                                ? new android.widget.LinearLayout.LayoutParams(
                                        android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT)
                                : new android.view.ViewGroup.LayoutParams(
                                        android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                        // 一行放 9 个 chip：单行 + 去字体额外行距；仍溢出则再压缩（不改 12sp 主字号）
                        try {
                            for (int ci = 0; ci < tools.getChildCount(); ci++) {
                                android.view.View ch = tools.getChildAt(ci);
                                if (ch instanceof android.widget.TextView && ch != todayTv) {
                                    android.widget.TextView ct = (android.widget.TextView) ch;
                                    ct.setIncludeFontPadding(false);
                                    ct.setSingleLine(true);
                                    ct.setEllipsize(null);
                                }
                            }
                        } catch (Throwable ignore) { }
                        final android.widget.LinearLayout ftools = tools;
                        tools.post(new Runnable() {
                            @Override public void run() {
                                try {
                                    int tw = ftools.getWidth();
                                    int sum = 0;
                                    for (int i = 0; i < ftools.getChildCount(); i++) {
                                        android.view.View c = ftools.getChildAt(i);
                                        if (c.getVisibility() != android.view.View.VISIBLE) continue;
                                        sum += c.getWidth();
                                    }
                                    log("TOOLBAR|w=" + tw + " sum=" + sum + " n=" + ftools.getChildCount());
                                    if (tw > 0 && sum > tw) {
                                        for (int i = 0; i < ftools.getChildCount(); i++) {
                                            android.view.View c = ftools.getChildAt(i);
                                            if (c instanceof android.widget.TextView) {
                                                ((android.widget.TextView) c).setTextSize(11);
                                                c.setPadding(2, 2, 2, 2);
                                            }
                                        }
                                        ftools.requestLayout();
                                        log("TOOLBAR|shrink sum=" + sum + " w=" + tw);
                                    }
                                } catch (Throwable t) { log("TOOLBAR|err " + t); }
                            }
                        });
                    }

                    int dbc = countAllToday(1);
                    final int shown = dbc > 0 ? dbc : readTodayCount();
                    // 今日已发只在输入框提示里显示一次，工具栏不再重复画
                    updateTodayText(shown);
                    log("TODAY|counted " + shown + " db=" + dbc);
                } catch (Throwable t) { log("TODAY|err " + t); }
                if (!cfg().optBoolean("todayCount", false)) { todayLoopOn = false; return; }
                if (!inChat && !isInChatUi()) { todayLoopOn = false; return; }
                boolean attached = false;
                try {
                    attached = act.getWindow().getDecorView().findViewWithTag("wxhChatTools") != null;
                } catch (Throwable ignore) { }
                new android.os.Handler(android.os.Looper.getMainLooper())
                        .postDelayed(this, attached ? 2000 : 600);
            }
        };
        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(task, 600);
    }


    private static volatile boolean treeDumped = false;

    private static void dumpTree(android.view.View v, int d, StringBuilder sb) {
        try {
            if (v == null || d > 28 || sb.length() > 40000) return;
            for (int i = 0; i < d; i++) sb.append(' ');
            sb.append(v.getClass().getSimpleName());
            if (v instanceof android.widget.TextView) {
                CharSequence c = ((android.widget.TextView) v).getText();
                if (c != null && c.length() > 0) {
                    String t = c.toString().replace('\n', ' ');
                    sb.append(" [").append(t.length() > 24 ? t.substring(0, 24) : t).append(']');
                }
            }
            sb.append('\n');
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) dumpTree(g.getChildAt(i), d + 1, sb);
            }
        } catch (Throwable ignore) { }
    }

    private static long lastTodayTry = 0;

    /** 钩 ChatFooter 挂载：无论从哪个入口进聊天，都会走这里 */
    private static boolean footerHookOn = false;
    private static boolean footerHookDone = false;
    private static android.app.Activity footerActRef = null;
    private static android.view.View footerLastRef = null;
    private static long footerLastAt = 0;
    private static void installFooterAttachHook(final ClassLoader app) {
        if (footerHookOn) return;
        footerHookOn = true;
        try {
            Class<?> c = Class.forName("com.tencent.mm.pluginsdk.ui.chat.ChatFooter", false, app);
            XposedBridge.hookAllMethods(c, "onAttachedToWindow", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam pm) {
                    try {
                        if (!(pm.thisObject instanceof android.view.View)) return;
                        final android.view.View fv = (android.view.View) pm.thisObject;
                        // 这个回调会被微信高频重复触发（实测 10 秒 900+ 次），只处理第一次即可，
                        // 否则每次挂工具栏又引起重排，无限循环把主线程拖死
                        // 每个聊天 Activity 只处理一次（不能整个进程只处理一次，否则后面进的聊天没有工具栏）
                        if (footerHookDone && footerActRef == chatAct) return;
                        footerHookDone = true;
                        footerActRef = chatAct;
                        footerLastRef = fv;
                        footerLastAt = System.currentTimeMillis();
                        todayAnchor = fv;
                        log("FOOTER|attached anchor");
                        android.app.Activity act = chatAct != null ? chatAct : mainAct;
                        if (act != null) {
                            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
                                    new Runnable() { @Override public void run() {
                                        android.app.Activity a2 = chatAct != null ? chatAct : mainAct;
                                        if (a2 != null && cfg().optBoolean("todayCount", false)) {
                                            try { startTodayCount(a2); } catch (Throwable ignore) { }
                                        }
                                    } }, 300L);
                        }
                    } catch (Throwable ignore) { }
                }
            });
            log("FOOTER|hook installed");
        } catch (Throwable t) { log("FOOTER|hook err " + t); footerHookOn = false; }
    }

    /** 找微信聊天输入区 ChatFooter（两种进入方式下都存在） */
    private static android.view.View findFooter(android.view.View v, int depth) {
        if (depth > 120 || v == null) return null;
        String cn = v.getClass().getName();
        if (cn.contains("ChatFooter") || cn.contains("ChattingFooter")) return v;
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View r = findFooter(g.getChildAt(i), depth + 1);
                if (r != null) return r;
            }
        }
        return null;
    }

    private static android.widget.EditText findEditText(android.view.View v, int depth) {
        if (depth > 120) return null;
        if (v instanceof android.widget.EditText) return (android.widget.EditText) v;
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.widget.EditText r = findEditText(g.getChildAt(i), depth + 1);
                if (r != null) return r;
            }
        }
        return null;
    }



    /** 关掉工具条时立刻从界面移除 */
    private static void removeChatTools(android.app.Activity a) {
        try {
            if (a == null) return;
            android.view.View root = a.getWindow().getDecorView();
            android.view.View tools = root.findViewWithTag("wxhChatTools");
            if (tools != null && tools.getParent() instanceof android.view.ViewGroup) {
                ((android.view.ViewGroup) tools.getParent()).removeView(tools);
            }
            android.view.View cnt = root.findViewWithTag("wxhTodayCount");
            if (cnt != null && cnt.getParent() instanceof android.view.ViewGroup) {
                ((android.view.ViewGroup) cnt.getParent()).removeView(cnt);
            }
            // 旧版画在输入框上的「今日已发」重复文字，清掉
            android.view.View oldHint = root.findViewWithTag("wxhCountHint");
            if (oldHint != null) oldHint.setVisibility(android.view.View.GONE);
            if (oldHint != null && oldHint.getParent() instanceof android.view.ViewGroup) {
                ((android.view.ViewGroup) oldHint.getParent()).removeView(oldHint);
            }
            todayTv = null;
            clockTv = null;
            log("TODAY|removed");
        } catch (Throwable ignore) { }
    }

    private static void reschedTask(final Runnable r, long ms) {
        try {
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(r, ms);
        } catch (Throwable ignore) { }
    }

    private static int countToday(String talker, int isSend) {
        int[] c0 = todayCounts.get(talker);
        return c0 == null ? 0 : c0[isSend == 1 ? 0 : 1];
    }

    /** 探测 createTime 单位：返回 true 表示毫秒 */
    private static boolean createTimeIsMs() {
        if (ctMsCached != null) return ctMsCached;
        try {
            Object db = dbRef;
            if (db == null) return false;
            Object cur = null;
            for (Method m : db.getClass().getMethods()) {
                if (!m.getName().equals("rawQuery")) continue;
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length != 2 || ps[0] != String.class) continue;
                Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                cur = m.invoke(db, "select max(createTime) from message", arg);
                break;
            }
            if (cur != null) {
                long mx = 0;
                if ((Boolean) cur.getClass().getMethod("moveToNext").invoke(cur))
                    mx = (Long) cur.getClass().getMethod("getLong", int.class).invoke(cur, 0);
                cur.getClass().getMethod("close").invoke(cur);
                ctMsCached = mx > 100000000000L;
                log("TODAY|unit ms=" + ctMsCached + " max=" + mx);
                return ctMsCached;
            }
        } catch (Throwable t) { log("TODAY|unit err " + t); }
        return false;
    }

    private static Boolean ctMsCached = null;

    /** 今日 0 点的时间戳（单位与 createTime 一致） */
    private static long todayStart() {
        long nowSec = System.currentTimeMillis() / 1000L;
        long startSec = nowSec - (nowSec % 86400L) - 8 * 3600L;
        return createTimeIsMs() ? startSec * 1000L : startSec;
    }

    private static int countAllToday(int isSend) {
        try {
            Object db = dbRef;
            if (db == null) return 0;
            long start = todayStart();
            Object cur = null;
            for (Method m : db.getClass().getMethods()) {
                if (!m.getName().equals("rawQuery")) continue;
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length != 2 || ps[0] != String.class) continue;
                Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                cur = m.invoke(db, "select count(*) from message where isSend=" + isSend
                        + " and createTime>=" + start, arg);
                break;
            }
            if (cur != null) {
                int n = 0;
                if ((Boolean) cur.getClass().getMethod("moveToNext").invoke(cur))
                    n = (Integer) cur.getClass().getMethod("getInt", int.class).invoke(cur, 0);
                cur.getClass().getMethod("close").invoke(cur);
                log("TODAY|dbAll=" + n + " start=" + start);
                return n;
            }
        } catch (Throwable t) { log("TODAY|dbAll err " + t); }
        return 0;
    }

