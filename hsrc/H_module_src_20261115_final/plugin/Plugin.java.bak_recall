    /* ---- 定时提醒 ---- */
    private static java.io.File remindFile() { return new java.io.File(DIR, "reminds.txt"); }

    private static void showRemindSetup(final android.app.Activity a) {
        final android.widget.EditText min = new android.widget.EditText(a);
        min.setHint("多少分钟后提醒，例如 30");
        min.setInputType(android.text.InputType.TYPE_CLASS_NUMBER);
        final android.widget.EditText msg = new android.widget.EditText(a);
        msg.setHint("提醒内容，例如：给张三回报价");
        android.widget.LinearLayout box = new android.widget.LinearLayout(a);
        box.setOrientation(android.widget.LinearLayout.VERTICAL);
        box.setPadding(dp(a, 16), dp(a, 8), dp(a, 16), dp(a, 8));
        box.addView(min);
        box.addView(msg);
        new android.app.AlertDialog.Builder(a)
                .setTitle("定时提醒")
                .setView(box)
                .setPositiveButton("设置", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        int m2;
                        try { m2 = Integer.parseInt(min.getText().toString().trim()); }
                        catch (Throwable t) { toast("分钟数填错了"); return; }
                        String text = msg.getText().toString().trim();
                        if (m2 <= 0 || text.length() == 0) { toast("分钟和内容都要填"); return; }
                        long due = System.currentTimeMillis() + m2 * 60000L;
                        try {
                            java.io.FileWriter fw = new java.io.FileWriter(remindFile(), true);
                            fw.write(due + "|" + text.replace("\n", " ") + "\n");
                            fw.close();
                            toast("已设置：" + m2 + " 分钟后提醒");
                            log("REMIND|add due=" + due + " " + text);
                        } catch (Throwable t) { toast("保存失败"); }
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static void maybeFireReminds() {
        try {
            java.io.File f = remindFile();
            if (!f.isFile()) return;
            long now = System.currentTimeMillis();
            java.util.ArrayList<String> keep = new java.util.ArrayList<String>();
            boolean fired = false;
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            String line;
            while ((line = br.readLine()) != null) {
                int bar = line.indexOf('|');
                if (bar <= 0) continue;
                long due;
                try { due = Long.parseLong(line.substring(0, bar)); } catch (Throwable t) { continue; }
                String text = line.substring(bar + 1);
                if (due <= now) {
                    alert("提醒", text);
                    log("REMIND|fire " + text);
                    fired = true;
                } else {
                    keep.add(line);
                }
            }
            br.close();
            if (fired) {
                java.io.FileWriter fw = new java.io.FileWriter(f, false);
                for (String k : keep) fw.write(k + "\n");
                fw.close();
            }
        } catch (Throwable t) { log("REMIND|err " + t); }
    }

    /** 会话列表导出 CSV（名称/类型/未读/最后时间） */
    private static void showConvListExport(final android.app.Activity a) {
        toast("正在导出…");
        new Thread(new Runnable() {
            @Override public void run() {
                StringBuilder sb = new StringBuilder();
                int n = 0;
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(username,''), ifnull(unReadCount,0), ifnull(conversationTime,0),"
                                    + " ifnull(content,'') from rconversation order by conversationTime desc", 4);
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US);
                    sb.append("\uFEFF会话名,wxid,类型,未读数,最后消息时间,最后消息摘要\n");
                    for (Object[] r : rows) {
                        String tk = String.valueOf(r[0]);
                        if (tk.length() == 0) continue;
                        long ct = pl(r[2]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        String kind = tk.endsWith("@chatroom") ? "群聊"
                                : (tk.startsWith("gh_") ? "公众号" : "私聊");
                        String last = String.valueOf(r[3]);
                        if (last.length() > 40) last = last.substring(0, 40);
                        sb.append(csv(displayOfTalker(tk))).append(',').append(csv(tk)).append(',')
                          .append(kind).append(',').append(pl(r[1])).append(',')
                          .append(csv(ct > 0 ? df.format(new java.util.Date(ct)) : ""))
                          .append(',').append(csv(last.replace("\n", " "))).append('\n');
                        n++;
                    }
                } catch (Throwable t) { log("CONVCSV|err " + t); }
                final String body = sb.toString();
                final int cnt = n;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (cnt == 0) { toast("读不到会话列表"); return; }
                        try {
                            java.io.File dir = new java.io.File(android.os.Environment
                                    .getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
                            if (!dir.exists()) dir.mkdirs();
                            java.io.File f = new java.io.File(dir,
                                    "conversations_" + System.currentTimeMillis() + ".csv");
                            java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
                            fo.write(body.getBytes("UTF-8"));
                            fo.close();
                            log("CONVCSV|n=" + cnt + " " + f.getName());
                            askShare(f);
                        } catch (Throwable t) { toast("写入失败"); }
                    }
                });
            }
        }).start();
    }

    /** 好友添加时间分布（按年/月，取自 rcontact.createTime） */
    private static void showFriendAddTime(final android.app.Activity a) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.TreeMap<String, Integer> byMonth = new java.util.TreeMap<String, Integer>();
                int zero = 0, total = 0;
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(createTime,0) from rcontact where (ifnull(type,0)&1)!=0"
                                    + " and username not like 'gh_%' and username not like '%@chatroom'"
                                    + " limit 3000", 1);
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("yyyy-MM", java.util.Locale.US);
                    for (Object[] r : rows) {
                        total++;
                        long ct = pl(r[0]);
                        if (ct <= 0) { zero++; continue; }
                        if (ct < 100000000000L) ct *= 1000L;
                        String k = df.format(new java.util.Date(ct));
                        Integer v = byMonth.get(k);
                        byMonth.put(k, v == null ? 1 : v + 1);
                    }
                } catch (Throwable t) { log("ADDT|err " + t); }
                final int fz = zero, ft = total;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (ft == 0) { toast("读不到联系人"); return; }
                        StringBuilder sb = new StringBuilder();
                        sb.append("好友总数　").append(ft).append('\n');
                        sb.append("有添加时间　").append(ft - fz).append("　无记录 ").append(fz).append("\n\n");
                        if (byMonth.isEmpty()) {
                            sb.append("本机没有记录添加时间（微信未保存该字段）");
                        } else {
                            int mx = 1;
                            for (int v : byMonth.values()) mx = Math.max(mx, v);
                            for (java.util.Map.Entry<String, Integer> e : byMonth.entrySet()) {
                                int bars = (int) Math.round((double) e.getValue() * 10 / mx);
                                StringBuilder b = new StringBuilder();
                                for (int i = 0; i < bars; i++) b.append('▇');
                                for (int i = bars; i < 10; i++) b.append('·');
                                sb.append(padRight(e.getKey(), 9)).append(b)
                                  .append(' ').append(e.getValue()).append('\n');
                            }
                        }
                        showTextDialog(a, "好友添加时间分布", sb.toString(), "friend_addtime.txt");
                    }
                });
            }
        }).start();
    }

    /** 久未联系的私聊好友（唤回清单） */
    private static void showColdFriends(final android.app.Activity a) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<String[]> list = new java.util.ArrayList<String[]>();
                int th = cfg().optInt("coldFriendDays", 30);
                if (th < 1) th = 30;
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select talker, max(createTime) from message where talker not like '%@chatroom'"
                                    + " and talker not like 'gh_%' and talker <> 'filehelper'"
                                    + " group by talker", 2);
                    long now = System.currentTimeMillis();
                    java.util.HashSet<String> friendSet = new java.util.HashSet<String>();
                    java.util.List<Object[]> fr = queryRows(
                            "select ifnull(username,'') from rcontact where (ifnull(type,0)&1)!=0"
                                    + " and username not like '%@chatroom' limit 3000", 1);
                    for (Object[] r : fr) friendSet.add(String.valueOf(r[0]));
                    for (Object[] r : rows) {
                        String tk = String.valueOf(r[0]);
                        if (!friendSet.contains(tk)) continue;      // 只统计仍是好友的
                        long ct = pl(r[1]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        if (ct <= 0) continue;
                        long days = (now - ct) / 86400000L;
                        if (days < th) continue;
                        list.add(new String[]{tk, String.valueOf(days), String.valueOf(ct)});
                    }
                    java.util.Collections.sort(list, new java.util.Comparator<String[]>() {
                        @Override public int compare(String[] x, String[] y) {
                            return Integer.parseInt(y[1]) - Integer.parseInt(x[1]);
                        }
                    });
                } catch (Throwable t) { log("COLD2|err " + t); }
                final int fth = th;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (list.isEmpty()) { toast("没有超过 " + fth + " 天没联系的私聊"); return; }
                        java.text.SimpleDateFormat df =
                                new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
                        StringBuilder sb = new StringBuilder();
                        sb.append("超过 ").append(fth).append(" 天没联系的私聊　共 ")
                          .append(list.size()).append(" 人\n\n");
                        int n = 0;
                        for (String[] it : list) {
                            if (n++ >= 80) break;
                            sb.append(padRight(it[1] + " 天", 8))
                              .append(padRight(nameOf(it[0]), 16))
                              .append("最后 ").append(df.format(new java.util.Date(pl(it[2]))))
                              .append('\n');
                        }
                        showTextDialog(a, "久未联系好友", sb.toString(), "cold_friends.txt");
                    }
                });
            }
        }).start();
    }

    /** 当前聊天导出为 Markdown（按天分组） */
    private static void exportChatMd(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || tk.length() == 0) { toast("请先在聊天里执行"); return; }
        toast("正在导出 Markdown…");
        new Thread(new Runnable() {
            @Override public void run() {
                java.io.File out = null;
                int n = 0;
                try {
                    java.io.File dir = new java.io.File(android.os.Environment
                            .getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
                    if (!dir.exists()) dir.mkdirs();
                    String safe = displayOfTalker(tk).replaceAll("[\\\\/:*?\"<>|]", "_");
                    out = new java.io.File(dir, "chatmd_" + safe + "_" + System.currentTimeMillis() + ".md");
                    java.io.BufferedWriter w = new java.io.BufferedWriter(
                            new java.io.OutputStreamWriter(new java.io.FileOutputStream(out), "UTF-8"));
                    w.write("# " + displayOfTalker(tk) + "\n\n");
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US);
                    java.text.SimpleDateFormat dayF =
                            new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
                    long lastCt = Long.MAX_VALUE;
                    String curDay = "";
                    java.util.ArrayList<String> buf = new java.util.ArrayList<String>();
                    while (true) {
                        java.util.List<Object[]> rows = queryRows(
                                "select ifnull(content,''), ifnull(type,0), ifnull(isSend,0), ifnull(createTime,0)"
                                        + " from message where talker='" + escSql(tk) + "'"
                                        + " and createTime < " + lastCt
                                        + " order by createTime desc limit 500", 4);
                        if (rows.isEmpty()) break;
                        for (Object[] r : rows) {
                            long ct = pl(r[3]);
                            if (ct < lastCt) lastCt = ct;
                            if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                            int tp = (int) pl(r[1]) & 65535;
                            String c = String.valueOf(r[0]);
                            String body;
                            if (tp == 1) {
                                int nl = c.indexOf('\n');
                                body = nl >= 0 ? c.substring(nl + 1) : c;
                            } else if (tp == 3) body = "`[图片]`";
                            else if (tp == 34) body = "`[语音]`";
                            else if (tp == 43) body = "`[视频]`";
                            else if (tp == 47) body = "`[表情]`";
                            else if (tp == 49) body = "`[文件/链接]`";
                            else if (tp == 42) body = "`[名片]`";
                            else if (tp == 48) body = "`[位置]`";
                            else if (tp == 10000) body = "> " + c;
                            else body = "`[消息]`";
                            String who = pl(r[2]) == 1 ? "**我**" : "对方";
                            String day = ct > 0 ? dayF.format(new java.util.Date(ct)) : "";
                            if (!day.equals(curDay)) {
                                curDay = day;
                                buf.add("\n## " + day + "\n");
                            }
                            buf.add("- " + (ct > 0 ? df.format(new java.util.Date(ct)).substring(11) : "--")
                                    + " " + who + "：" + body);
                            n++;
                        }
                        for (int i = buf.size() - 1; i >= 0; i--) w.write(buf.get(i) + "\n");
                        buf.clear();
                        if (rows.size() < 500) break;
                    }
                    w.close();
                } catch (Throwable t) { log("CHATMD|err " + t); }
                final java.io.File f = out;
                final int cnt = n;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (f == null || cnt == 0) { toast("没有可导出的消息"); return; }
                        log("CHATMD|n=" + cnt + " " + f.getName());
                        askShare(f);
                    }
                });
            }
        }).start();
    }

    /** 自检：把新面板依赖的查询全部跑一遍，只关心是否抛异常 */
    private static void selfTestPanels() {
        new Thread(new Runnable() {
            @Override public void run() {
                int ok = 0, bad = 0;
                String[][] cases = new String[][]{   // {名称, SQL, 期望最少行数}
                        {"labels", "select * from ContactLabel limit 50", "1"},
                        {"labelIds", "select ifnull(contactLabelIds,'') from rcontact limit 50", "1"},
                        {"initials", "select ifnull(pyInitial,'') from rcontact limit 50", "1"},
                        {"hb", "select ifnull(receiveAmount,0), ifnull(receiveTime,0) from WalletLuckyMoney limit 50", "1"},
                        {"remit", "select ifnull(isSend,0), ifnull(receiveTime,0), ifnull(locaMsgId,0) from RemittanceRecord limit 50", "1"},
                        {"types", "select (type&65535), count(*) from message group by (type&65535) limit 20", "1"},
                        {"groupMax", "select talker, max(createTime) from message where talker like '%@chatroom' group by talker limit 50", "1"},
                        {"chatroom", "select ifnull(memberlist,'') from chatroom limit 5", "1"},
                        {"msgRecent", "select ifnull(content,''), ifnull(createTime,0) from message order by createTime desc limit 50", "1"},
                        {"rconv", "select username, flag, unReadCount from rconversation limit 20", "1"},
                        {"sysmsg", "select ifnull(content,''), ifnull(createTime,0) from message where (type&65535)=10000 limit 50", "0"},
                        {"filemsg", "select ifnull(content,''), ifnull(talker,'') from message where (type&65535)=49 limit 50", "0"},
                        {"gmsg", "select ifnull(content,''), ifnull(createTime,0) from message where talker like '%@chatroom' limit 100", "0"},
                        {"friends", "select ifnull(conRemark,''), ifnull(pyInitial,'') from rcontact where (ifnull(type,0)&1)!=0 limit 100", "1"},
                        {"hbSender", "select ifnull(sender,''), ifnull(msgSvrId,0) from WalletLuckyMoney limit 50", "1"},
                        {"remitTalker", "select ifnull(talker,''), ifnull(receiverName,'') from RemittanceRecord limit 50", "1"},
                };
                for (String[] c : cases) {
                    try {
                        java.util.List<Object[]> r = queryRows(c[1], 2);
                        int need = 0;
                        try { need = Integer.parseInt(c[2]); } catch (Throwable ignore) { }
                        if (r.size() < need) {
                            log("ST|" + c[0] + " EMPTY(expect>=" + need + ") sql=" + c[1]);
                            bad++;
                        } else {
                            log("ST|" + c[0] + " ok rows=" + r.size());
                            ok++;
                        }
                    } catch (Throwable t) {
                        log("ST|" + c[0] + " ERR " + t);
                        bad++;
                    }
                }
                log("ST|done ok=" + ok + " bad=" + bad);
            }
        }).start();
    }

    /** 群互动关系（谁常接谁的话） */
    private static void showInteractionNet(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在分析…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.HashMap<String, Integer> pairs = new java.util.HashMap<String, Integer>();
                final java.util.HashMap<String, Integer> spoke = new java.util.HashMap<String, Integer>();
                try {
                    long since = sinceRaw(System.currentTimeMillis() - 30L * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(content,''), ifnull(createTime,0) from message where talker='"
                                    + escSql(tk) + "' and createTime>=" + since
                                    + " order by createTime asc limit 6000", 2);
                    String prev = null;
                    long prevCt = 0;
                    for (Object[] r : rows) {
                        String sid = senderIdOfGroupMsg(String.valueOf(r[0]));
                        if (sid == null || sid.length() == 0) continue;
                        long ct = pl(r[1]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        if (prev != null && !prev.equals(sid) && ct - prevCt < 10 * 60 * 1000L) {
                            String key = prev + ">" + sid;   // prev 说完，sid 接话
                            Integer v = pairs.get(key);
                            pairs.put(key, v == null ? 1 : v + 1);
                        }
                        Integer sv = spoke.get(sid);
                        spoke.put(sid, sv == null ? 1 : sv + 1);
                        prev = sid;
                        prevCt = ct;
                    }
                } catch (Throwable t) { log("NET|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (pairs.isEmpty()) { toast("样本不足"); return; }
                        java.util.List<java.util.Map.Entry<String, Integer>> list =
                                new java.util.ArrayList<java.util.Map.Entry<String, Integer>>(pairs.entrySet());
                        java.util.Collections.sort(list,
                                new java.util.Comparator<java.util.Map.Entry<String, Integer>>() {
                            @Override public int compare(java.util.Map.Entry<String, Integer> x,
                                                         java.util.Map.Entry<String, Integer> y) {
                                return y.getValue() - x.getValue();
                            }
                        });
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 近 30 天互动关系\n");
                        sb.append("（10 分钟内的连续发言视为接话）\n\n");
                        int n = 0;
                        for (java.util.Map.Entry<String, Integer> e : list) {
                            if (n++ >= 25) break;
                            String[] pr = e.getKey().split(">", 2);
                            if (pr.length < 2) continue;
                            sb.append(padRight(nameOf(pr[0]), 12)).append(" → ")
                              .append(padRight(nameOf(pr[1]), 12))
                              .append(e.getValue()).append(" 次\n");
                        }
                        showTextDialog(a, "群互动关系", sb.toString(), "interaction.txt");
                    }
                });
            }
        }).start();
    }

    /** 深夜消息占比（0-6 点），含夜猫子排行 */
    private static void showNightRatio(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                int night = 0, total = 0;
                final java.util.HashMap<String, Integer> per = new java.util.HashMap<String, Integer>();
                try {
                    long since = sinceRaw(System.currentTimeMillis() - 30L * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(content,''), ifnull(createTime,0) from message where talker='"
                                    + escSql(tk) + "' and createTime>=" + since + " limit 8000", 2);
                    java.util.Calendar cal = java.util.Calendar.getInstance();
                    for (Object[] r : rows) {
                        long ct = pl(r[1]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        if (ct <= 0) continue;
                        total++;
                        cal.setTimeInMillis(ct);
                        int hr = cal.get(java.util.Calendar.HOUR_OF_DAY);
                        if (hr < 6) {
                            night++;
                            String sid = senderIdOfGroupMsg(String.valueOf(r[0]));
                            if (sid != null && sid.length() > 0) {
                                Integer v = per.get(sid);
                                per.put(sid, v == null ? 1 : v + 1);
                            }
                        }
                    }
                } catch (Throwable t) { log("NIGHT|err " + t); }
                final int fn = night, ft = total;
                final java.util.HashMap<String, Integer> fp = per;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (ft == 0) { toast("没有数据"); return; }
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 近 30 天\n\n");
                        sb.append("消息总数　").append(ft).append(" 条\n");
                        sb.append("深夜（0-6 点）　").append(fn).append(" 条　")
                          .append(String.format(java.util.Locale.US, "%.1f", fn * 100.0 / ft)).append("%\n");
                        if (fn > 0) {
                            sb.append("\n【深夜发言排行】\n");
                            java.util.List<java.util.Map.Entry<String, Integer>> list =
                                    new java.util.ArrayList<java.util.Map.Entry<String, Integer>>(fp.entrySet());
                            java.util.Collections.sort(list,
                                    new java.util.Comparator<java.util.Map.Entry<String, Integer>>() {
                                @Override public int compare(java.util.Map.Entry<String, Integer> x,
                                                             java.util.Map.Entry<String, Integer> y) {
                                    return y.getValue() - x.getValue();
                                }
                            });
                            int n = 0;
                            for (java.util.Map.Entry<String, Integer> e : list) {
                                if (n++ >= 15) break;
                                sb.append("  ").append(padRight(nameOf(e.getKey()), 14))
                                  .append(e.getValue()).append(" 条\n");
                            }
                        }
                        sb.append("\n参考：深夜占比 >10% 的群通常存在刷屏或非正常作息讨论");
                        showTextDialog(a, "深夜消息占比", sb.toString(), "night_ratio.txt");
                    }
                });
            }
        }).start();
    }

    /** 消息平均响应时长（对方回你 / 你回对方） */
    private static void showReplyLatency(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || tk.length() == 0) { toast("请先在聊天里执行"); return; }
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<Long> theirReply = new java.util.ArrayList<Long>();
                final java.util.ArrayList<Long> myReply = new java.util.ArrayList<Long>();
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(isSend,0), ifnull(createTime,0) from message where talker='"
                                    + escSql(tk) + "' and (type&65535)=1 order by createTime asc limit 3000", 2);
                    long prevCt = 0;
                    int prevSend = -1;
                    for (Object[] r : rows) {
                        long ct = pl(r[1]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        int sd = (int) pl(r[0]);
                        if (ct <= 0) continue;
                        if (prevCt > 0 && prevSend >= 0 && sd != prevSend) {
                            long d = ct - prevCt;
                            if (d > 0 && d < 24L * 3600 * 1000) {
                                if (sd == 1) myReply.add(Long.valueOf(d));       // 我回对方
                                else theirReply.add(Long.valueOf(d));            // 对方回我
                            }
                        }
                        prevCt = ct;
                        prevSend = sd;
                    }
                } catch (Throwable t) { log("LAT|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (theirReply.isEmpty() && myReply.isEmpty()) { toast("样本不足"); return; }
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 响应时长（仅文字消息）\n\n");
                        sb.append("【对方回你】").append(theirReply.size()).append(" 次\n");
                        sb.append("  ").append(latStats(theirReply)).append('\n');
                        sb.append("【你回对方】").append(myReply.size()).append(" 次\n");
                        sb.append("  ").append(latStats(myReply)).append('\n');
                        sb.append("\n注：只统计相邻两条消息之间的间隔，超过 24 小时不计");
                        showTextDialog(a, "消息响应时长", sb.toString(), "reply_latency.txt");
                    }
                });
            }
        }).start();
    }

    private static String latStats(java.util.ArrayList<Long> v) {
        if (v.isEmpty()) return "--";
        java.util.ArrayList<Long> c = new java.util.ArrayList<Long>(v);
        java.util.Collections.sort(c);
        long sum = 0;
        for (long x : c) sum += x;
        long avg = sum / c.size();
        long med = c.get(c.size() / 2);
        long p90 = c.get((int) Math.min(c.size() - 1, c.size() * 0.9));
        return "平均 " + fmtDur(avg) + "　中位 " + fmtDur(med) + "　90% 在 " + fmtDur(p90) + " 内";
    }

    private static String fmtDur(long ms) {
        if (ms < 1000) return ms + "ms";
        long s = ms / 1000;
        if (s < 60) return s + "秒";
        long m = s / 60;
        if (m < 60) return m + "分" + (s % 60) + "秒";
        long h = m / 60;
        if (h < 24) return h + "小时" + (m % 60) + "分";
        return (h / 24) + "天";
    }

    /** 群消息「星期 × 小时」热力图（近 30 天） */
    private static void showWeekHourHeat(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final int[][] grid = new int[7][24];
                int total = 0;
                try {
                    long since = sinceRaw(System.currentTimeMillis() - 30L * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(createTime,0) from message where talker='" + escSql(tk)
                                    + "' and createTime>=" + since + " limit 8000", 1);
                    java.util.Calendar cal = java.util.Calendar.getInstance();
                    for (Object[] r : rows) {
                        long ct = pl(r[0]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        if (ct <= 0) continue;
                        cal.setTimeInMillis(ct);
                        int dow = cal.get(java.util.Calendar.DAY_OF_WEEK) - 1;   // 0=周日
                        int hr = cal.get(java.util.Calendar.HOUR_OF_DAY);
                        grid[dow][hr]++;
                        total++;
                    }
                } catch (Throwable t) { log("WHHEAT|err " + t); }
                final int ft = total;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (ft == 0) { toast("没有数据"); return; }
                        int mx = 1;
                        for (int[] row : grid) for (int v : row) mx = Math.max(mx, v);
                        String ramp = " ▁▂▃▄▅▆▇█";
                        String[] wd = {"日", "一", "二", "三", "四", "五", "六"};
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 近30天 ").append(ft).append(" 条\n\n");
                        sb.append("     00    06    12    18    23\n");
                        for (int d = 0; d < 7; d++) {
                            sb.append(wd[d]).append("  ");
                            for (int h = 0; h < 24; h++) {
                                int lv = (int) Math.round((double) grid[d][h] * 8 / mx);
                                if (grid[d][h] > 0 && lv == 0) lv = 1;
                                if (lv < 0) lv = 0;
                                if (lv > 8) lv = 8;
                                sb.append(ramp.charAt(lv));
                            }
                            sb.append('\n');
                        }
                        sb.append("\n图例：空格=无　▁▂▃▄▅▆▇█=由少到多");
                        showTextDialog(a, "星期×小时热力", sb.toString(), "week_hour_heat.txt");
                    }
                });
            }
        }).start();
    }

    /** 群成员统计导出 CSV（近 30 天） */
    private static void exportMemberStats(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在导出…");
        new Thread(new Runnable() {
            @Override public void run() {
                StringBuilder sb = new StringBuilder();
                int rows = 0;
                try {
                    long since = sinceRaw(System.currentTimeMillis() - 30L * 86400000L);
                    java.util.List<Object[]> all = queryRows(
                            "select ifnull(content,''), ifnull(createTime,0) from message where talker='"
                                    + escSql(tk) + "' and createTime>=" + since
                                    + " order by createTime desc limit 8000", 2);
                    java.util.HashMap<String, long[]> stat = new java.util.HashMap<String, long[]>();
                    java.util.HashMap<String, java.util.HashSet<String>> days =
                            new java.util.HashMap<String, java.util.HashSet<String>>();
                    java.text.SimpleDateFormat dk =
                            new java.text.SimpleDateFormat("yyyyMMdd", java.util.Locale.US);
                    for (Object[] r : all) {
                        String sid = senderIdOfGroupMsg(String.valueOf(r[0]));
                        if (sid == null || sid.length() == 0) continue;
                        long ct = pl(r[1]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        long[] v = stat.get(sid);
                        if (v == null) { v = new long[]{0, ct}; stat.put(sid, v); }
                        v[0]++;
                        if (ct > v[1]) v[1] = ct;
                        java.util.HashSet<String> ds = days.get(sid);
                        if (ds == null) { ds = new java.util.HashSet<String>(); days.put(sid, ds); }
                        if (ct > 0) ds.add(dk.format(new java.util.Date(ct)));
                    }
                    java.util.List<String> keys = new java.util.ArrayList<String>(stat.keySet());
                    java.util.Collections.sort(keys, new java.util.Comparator<String>() {
                        @Override public int compare(String x, String y) {
                            return Long.compare(stat.get(y)[0], stat.get(x)[0]);
                        }
                    });
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US);
                    sb.append("\uFEFF昵称,wxid,条数,活跃天数,最后发言\n");
                    for (String k : keys) {
                        long[] v = stat.get(k);
                        java.util.HashSet<String> ds = days.get(k);
                        sb.append(csv(nameOf(k))).append(',').append(csv(k)).append(',')
                          .append(v[0]).append(',').append(ds == null ? 0 : ds.size()).append(',')
                          .append(csv(v[1] > 0 ? df.format(new java.util.Date(v[1])) : ""))
                          .append('\n');
                        rows++;
                    }
                } catch (Throwable t) { log("MEXP2|err " + t); }
                final String body = sb.toString();
                final int n = rows;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (n == 0) { toast("没有数据"); return; }
                        try {
                            java.io.File dir = new java.io.File(android.os.Environment
                                    .getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
                            if (!dir.exists()) dir.mkdirs();
                            java.io.File f = new java.io.File(dir,
                                    "member_stats_" + System.currentTimeMillis() + ".csv");
                            java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
                            fo.write(body.getBytes("UTF-8"));
                            fo.close();
                            log("MEXP2|ok n=" + n + " " + f.getName());
                            askShare(f);
                        } catch (Throwable t) { toast("写入失败"); }
                    }
                });
            }
        }).start();
    }

    /** 群成员活跃天数分布（近 30 天） */
    private static void showActiveDaysDist(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.HashMap<String, java.util.HashSet<String>> dayMap =
                        new java.util.HashMap<String, java.util.HashSet<String>>();
                try {
                    long since = sinceRaw(System.currentTimeMillis() - 30L * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(content,''), ifnull(createTime,0) from message where talker='"
                                    + escSql(tk) + "' and createTime>=" + since
                                    + " order by createTime desc limit 8000", 2);
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("yyyyMMdd", java.util.Locale.US);
                    for (Object[] r : rows) {
                        String sid = senderIdOfGroupMsg(String.valueOf(r[0]));
                        if (sid == null || sid.length() == 0) continue;
                        long ct = pl(r[1]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        if (ct <= 0) continue;
                        java.util.HashSet<String> ds = dayMap.get(sid);
                        if (ds == null) { ds = new java.util.HashSet<String>(); dayMap.put(sid, ds); }
                        ds.add(df.format(new java.util.Date(ct)));
                    }
                } catch (Throwable t) { log("ADAY|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (dayMap.isEmpty()) { toast("没有数据"); return; }
                        int[] buckets = new int[6];   // 1天 / 2-3 / 4-7 / 8-15 / 16-29 / 30+
                        int total = 0;
                        for (java.util.HashSet<String> ds : dayMap.values()) {
                            int d = ds.size();
                            total++;
                            if (d <= 1) buckets[0]++;
                            else if (d <= 3) buckets[1]++;
                            else if (d <= 7) buckets[2]++;
                            else if (d <= 15) buckets[3]++;
                            else if (d <= 29) buckets[4]++;
                            else buckets[5]++;
                        }
                        String[] labels = {"只来 1 天", "2-3 天", "4-7 天", "8-15 天", "16-29 天", "30 天全勤"};
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 近 30 天活跃天数分布\n");
                        sb.append("参与发言人数　").append(total).append("\n\n");
                        int mx = 1;
                        for (int v : buckets) mx = Math.max(mx, v);
                        for (int i = 0; i < labels.length; i++) {
                            int bars = (int) Math.round((double) buckets[i] * 10 / mx);
                            StringBuilder b = new StringBuilder();
                            for (int j = 0; j < bars; j++) b.append('▇');
                            for (int j = bars; j < 10; j++) b.append('·');
                            sb.append(padRight(labels[i], 12)).append(b)
                              .append(' ').append(buckets[i]).append(" 人\n");
                        }
                        int core = buckets[3] + buckets[4] + buckets[5];
                        sb.append("\n核心成员（8 天以上）").append(core).append(" 人，占 ")
                          .append(String.format(java.util.Locale.US, "%.0f", core * 100.0 / total)).append("%");
                        showTextDialog(a, "成员活跃天数分布", sb.toString(), "active_days.txt");
                    }
                });
            }
        }).start();
    }

    /** 群聊冷场预警：连续 N 天没有消息的群 */
    private static void showColdGroups(final android.app.Activity a) {
        toast("正在扫描…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<String[]> list = new java.util.ArrayList<String[]>();
                int th = cfg().optInt("coldDays", 7);
                if (th < 1) th = 7;
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select talker, max(createTime) from message where talker like '%@chatroom'"
                                    + " group by talker", 2);
                    long now = System.currentTimeMillis();
                    for (Object[] r : rows) {
                        String tk = String.valueOf(r[0]);
                        long ct = pl(r[1]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        if (ct <= 0) continue;
                        long days = (now - ct) / 86400000L;
                        if (days < th) continue;
                        list.add(new String[]{tk, String.valueOf(days), String.valueOf(ct)});
                    }
                    java.util.Collections.sort(list, new java.util.Comparator<String[]>() {
                        @Override public int compare(String[] x, String[] y) {
                            return Integer.parseInt(y[1]) - Integer.parseInt(x[1]);
                        }
                    });
                } catch (Throwable t) { log("COLD|err " + t); }
                final int fth = th;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (list.isEmpty()) { toast("没有超过 " + fth + " 天没动静的群"); return; }
                        java.text.SimpleDateFormat df =
                                new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
                        StringBuilder sb = new StringBuilder();
                        sb.append("超过 ").append(fth).append(" 天没有消息的群　共 ")
                          .append(list.size()).append(" 个\n\n");
                        int n = 0;
                        for (String[] it : list) {
                            if (n++ >= 60) break;
                            sb.append(padRight(it[1] + " 天", 8))
                              .append(padRight(displayOfTalker(it[0]), 18))
                              .append("最后 ").append(df.format(new java.util.Date(pl(it[2]))))
                              .append('\n');
                        }
                        showTextDialog(a, "群聊冷场预警", sb.toString(), "cold_groups.txt");
                    }
                });
            }
        }).start();
    }

    /** 群成员最后发言时间表（近 90 天） */
    private static void showMemberLastSeen(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.HashMap<String, long[]> last = new java.util.HashMap<String, long[]>();  // [lastCt, count, days]
                final java.util.HashMap<String, java.util.HashSet<String>> daySet =
                        new java.util.HashMap<String, java.util.HashSet<String>>();
                try {
                    long since = sinceRaw(System.currentTimeMillis() - 90L * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(content,''), ifnull(createTime,0) from message where talker='"
                                    + escSql(tk) + "' and createTime>=" + since
                                    + " order by createTime desc limit 8000", 2);
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("yyyyMMdd", java.util.Locale.US);
                    for (Object[] r : rows) {
                        String sid = senderIdOfGroupMsg(String.valueOf(r[0]));
                        if (sid == null || sid.length() == 0) continue;
                        long ct = pl(r[1]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        if (ct <= 0) continue;
                        long[] v = last.get(sid);
                        if (v == null) { v = new long[]{ct, 1, 0}; last.put(sid, v); }
                        else { v[1]++; if (ct > v[0]) v[0] = ct; }
                        java.util.HashSet<String> ds = daySet.get(sid);
                        if (ds == null) { ds = new java.util.HashSet<String>(); daySet.put(sid, ds); }
                        ds.add(df.format(new java.util.Date(ct)));
                    }
                } catch (Throwable t) { log("MLAST|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (last.isEmpty()) { toast("没有数据"); return; }
                        java.util.List<String> keys = new java.util.ArrayList<String>(last.keySet());
                        java.util.Collections.sort(keys, new java.util.Comparator<String>() {
                            @Override public int compare(String x, String y) {
                                return Long.compare(last.get(y)[0], last.get(x)[0]);
                            }
                        });
                        java.text.SimpleDateFormat df =
                                new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US);
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 近 90 天\n");
                        sb.append("按最后发言时间排序\n\n");
                        int n = 0;
                        long nowMs = System.currentTimeMillis();
                        for (String k : keys) {
                            if (n++ >= 60) break;
                            long[] v = last.get(k);
                            java.util.HashSet<String> ds = daySet.get(k);
                            long days = (nowMs - v[0]) / 86400000L;
                            sb.append(padRight(df.format(new java.util.Date(v[0])), 13))
                              .append(padRight(nameOf(k), 14))
                              .append("  共 ").append(v[1]).append(" 条")
                              .append("  活跃 ").append(ds == null ? 0 : ds.size()).append(" 天")
                              .append("  ").append(days == 0 ? "今天" : (days + " 天前"))
                              .append('\n');
                        }
                        showTextDialog(a, "成员最后发言", sb.toString(), "member_last.txt");
                    }
                });
            }
        }).start();
    }

    /** 单会话消息备份为 txt（全量，含时间/发送人/正文） */
    private static void exportChatTxt(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || tk.length() == 0) { toast("请先在聊天里执行"); return; }
        toast("正在备份…");
        new Thread(new Runnable() {
            @Override public void run() {
                java.io.File out = null;
                int n = 0;
                try {
                    java.io.File dir = new java.io.File(android.os.Environment
                            .getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
                    if (!dir.exists()) dir.mkdirs();
                    String safe = displayOfTalker(tk).replaceAll("[\\\\/:*?\"<>|]", "_");
                    out = new java.io.File(dir, "chat_" + safe + "_" + System.currentTimeMillis() + ".txt");
                    java.io.BufferedWriter w = new java.io.BufferedWriter(
                            new java.io.OutputStreamWriter(new java.io.FileOutputStream(out), "UTF-8"));
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss", java.util.Locale.US);
                    w.write("会话：" + displayOfTalker(tk) + "\n");
                    w.write("导出时间：" + df.format(new java.util.Date()) + "\n");
                    w.write("════════════════════\n\n");
                    // 分批取，避免一次性占用过多内存
                    long lastCt = Long.MAX_VALUE;
                    while (true) {
                        java.util.List<Object[]> rows = queryRows(
                                "select ifnull(content,''), ifnull(type,0), ifnull(isSend,0), ifnull(createTime,0)"
                                        + " from message where talker='" + escSql(tk) + "'"
                                        + " and createTime < " + lastCt
                                        + " order by createTime desc limit 500", 4);
                        if (rows.isEmpty()) break;
                        java.util.ArrayList<String> buf = new java.util.ArrayList<String>();
                        for (Object[] r : rows) {
                            long ct = pl(r[3]);
                            if (ct < lastCt) lastCt = ct;
                            if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                            int tp = (int) pl(r[1]) & 65535;
                            String c = String.valueOf(r[0]);
                            String body;
                            if (tp == 1) {
                                int nl = c.indexOf('\n');
                                body = nl >= 0 ? c.substring(nl + 1) : c;
                            } else if (tp == 3) body = "[图片]";
                            else if (tp == 34) body = "[语音]";
                            else if (tp == 43) body = "[视频]";
                            else if (tp == 47) body = "[表情]";
                            else if (tp == 49) body = "[文件/链接]";
                            else if (tp == 42) body = "[名片]";
                            else if (tp == 48) body = "[位置]";
                            else if (tp == 10000) body = "[系统] " + c;
                            else body = "[消息]";
                            String who = pl(r[2]) == 1 ? "我" : "对方";
                            buf.add("[" + (ct > 0 ? df.format(new java.util.Date(ct)) : "--") + "] " + who + "：" + body);
                            n++;
                        }
                        for (int i = buf.size() - 1; i >= 0; i--) w.write(buf.get(i) + "\n");
                        if (rows.size() < 500) break;
                    }
                    w.close();
                } catch (Throwable t) { log("CHATTXT|err " + t); }
                final java.io.File f = out;
                final int cnt = n;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (f == null || cnt == 0) { toast("没有可备份的消息"); return; }
                        log("CHATTXT|n=" + cnt + " " + f.getName());
                        askShare(f);
                    }
                });
            }
        }).start();
    }

    /** 联系人首字母分布 */
    private static void showInitialDist(final android.app.Activity a) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final int[] cnt = new int[27];
                final int[] total = new int[]{0};
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(pyInitial,''), ifnull(conRemarkPYFull,'') from rcontact"
                                    + " where (ifnull(type,0)&1)!=0 and username not like 'gh_%'"
                                    + " and username not like '%@chatroom' limit 3000", 2);
                    for (Object[] r : rows) {
                        String py = String.valueOf(r[0]).trim();
                        if (py.length() == 0) py = String.valueOf(r[1]).trim();
                        total[0]++;
                        if (py.length() == 0) { cnt[26]++; continue; }
                        char c = Character.toUpperCase(py.charAt(0));
                        if (c >= 'A' && c <= 'Z') cnt[c - 'A']++;
                        else cnt[26]++;
                    }
                } catch (Throwable t) { log("INITDIST|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (total[0] == 0) { toast("读不到联系人"); return; }
                        int mx = 1;
                        for (int v : cnt) mx = Math.max(mx, v);
                        StringBuilder sb = new StringBuilder();
                        sb.append("好友总数　").append(total[0]).append("\n\n");
                        for (int i = 0; i < 26; i++) {
                            char c = (char) ('A' + i);
                            int bars = (int) Math.round((double) cnt[i] * 10 / mx);
                            StringBuilder b = new StringBuilder();
                            for (int j = 0; j < bars; j++) b.append('▇');
                            for (int j = bars; j < 10; j++) b.append('·');
                            sb.append(c).append(' ').append(b).append(' ').append(cnt[i]).append('\n');
                        }
                        sb.append("#  ·········· ").append(cnt[26]).append("（无拼音/特殊）\n");
                        showTextDialog(a, "联系人首字母分布", sb.toString(), "initial_dist.txt");
                    }
                });
            }
        }).start();
    }

    /** 聊天记录关键词定位（当前会话） */
    private static void showKeywordLocate(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || tk.length() == 0) { toast("请先在聊天里执行"); return; }
        final android.widget.EditText et = new android.widget.EditText(a);
        et.setHint("输入关键词，定位本会话的历史消息");
        new android.app.AlertDialog.Builder(a)
                .setTitle("聊天记录关键词定位")
                .setView(et)
                .setPositiveButton("搜索", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        String kw = et.getText().toString().trim();
                        if (kw.length() == 0) return;
                        doKeywordLocate(a, tk, kw);
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static void doKeywordLocate(final android.app.Activity a, final String tk, final String kw) {
        toast("搜索中…");
        new Thread(new Runnable() {
            @Override public void run() {
                final StringBuilder sb = new StringBuilder();
                final int[] n = new int[]{0};
                try {
                    String esc = escSql(kw);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(content,''), ifnull(createTime,0), ifnull(isSend,0) from message"
                                    + " where talker='" + escSql(tk) + "' and (type&65535)=1"
                                    + " and content like '%" + esc + "%'"
                                    + " order by createTime desc limit 200", 3);
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US);
                    for (Object[] r : rows) {
                        String c = String.valueOf(r[0]);
                        int nl = c.indexOf('\n');
                        String body = nl >= 0 ? c.substring(nl + 1) : c;
                        int ix = body.indexOf(kw);
                        if (ix > 40) body = "…" + body.substring(ix - 20);
                        if (body.length() > 90) body = body.substring(0, 90) + "…";
                        long ct = pl(r[1]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        n[0]++;
                        sb.append(df.format(new java.util.Date(ct)))
                          .append(pl(r[2]) == 1 ? "  我：" : "  对方：")
                          .append(body).append('\n');
                    }
                } catch (Throwable t) { log("KWLOC|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (n[0] == 0) { toast("没有找到包含「" + kw + "」的消息"); return; }
                        String head = "关键词「" + kw + "」命中 " + n[0] + " 条（最多列 200）\n\n";
                        showTextDialog(a, "关键词定位", head + sb.toString(), "keyword_locate.txt");
                    }
                });
            }
        }).start();
    }

    /** 群每日发言热力（近 30 天，按天柱状） */
    private static void showDayHeat(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final long[] days = new long[30];
                final String[] labels = new String[30];
                try {
                    long now = System.currentTimeMillis();
                    long since = sinceRaw(now - 30L * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(createTime,0) from message where talker='" + escSql(tk)
                                    + "' and createTime>=" + since + " limit 8000", 1);
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("MM-dd", java.util.Locale.US);
                    for (int i = 0; i < 30; i++) {
                        labels[i] = df.format(new java.util.Date(now - (29 - i) * 86400000L));
                    }
                    for (Object[] r : rows) {
                        long ct = pl(r[0]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        if (ct <= 0) continue;
                        long diff = (now - ct) / 86400000L;
                        int idx = 29 - (int) diff;
                        if (idx >= 0 && idx < 30) days[idx]++;
                    }
                } catch (Throwable t) { log("DAYHEAT|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        long total = 0, mx = 1;
                        for (long v : days) { total += v; mx = Math.max(mx, v); }
                        if (total == 0) { toast("没有数据"); return; }
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 近 30 天 ")
                          .append(total).append(" 条\n\n");
                        int peak = 0;
                        for (int i = 0; i < 30; i++) {
                            int bars = (int) Math.round((double) days[i] * 8 / mx);
                            StringBuilder b = new StringBuilder();
                            for (int j = 0; j < bars; j++) b.append('▇');
                            for (int j = bars; j < 8; j++) b.append('·');
                            sb.append(labels[i]).append(' ').append(b).append(' ').append(days[i]).append('\n');
                            if (days[i] > days[peak]) peak = i;
                        }
                        int quiet = 0;
                        for (long v : days) if (v == 0) quiet++;
                        sb.append("\n最活跃　").append(labels[peak]).append("（").append(days[peak]).append(" 条）");
                        sb.append("\n零消息天数　").append(quiet).append(" 天");
                        showTextDialog(a, "群每日发言热力", sb.toString(), "day_heat.txt");
                    }
                });
            }
        }).start();
    }

    /** 自动确认电脑登录：发现「确认登录」弹窗就点确认 */
    private static volatile boolean pcWatchOn = false;
    private static android.os.Handler pcWatchH = null;

    private static void startPcLoginWatch(final android.app.Activity a) {
        try {
            if (pcWatchH != null) return;
            pcWatchH = new android.os.Handler(android.os.Looper.getMainLooper());
            pcWatchH.postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        if (cfg().optBoolean("autoPcLogin", false)) {
                            tickPcLogin();
                        }
                    } catch (Throwable ignore) { }
                    try { pcWatchH.postDelayed(this, 1500L); } catch (Throwable ignore) { }
                }
            }, 2000L);
            log("PCLOGIN|watch started");
        } catch (Throwable t) { log("PCLOGIN|err " + t); }
    }

    private static void tickPcLogin() {
        try {
            for (android.view.View root : allRoots()) {
                java.util.ArrayList<android.widget.TextView> tvs =
                        new java.util.ArrayList<android.widget.TextView>();
                collectTexts(root, tvs, 0);
                boolean hasHint = false;
                for (android.widget.TextView tv : tvs) {
                    CharSequence cs = tv.getText();
                    if (cs == null) continue;
                    String t = cs.toString();
                    if (t.contains("确认登录") || t.contains("登录 Windows") || t.contains("登录电脑")) {
                        hasHint = true;
                        break;
                    }
                }
                if (!hasHint) continue;
                for (android.widget.TextView tv : tvs) {
                    CharSequence cs = tv.getText();
                    if (cs == null) continue;
                    String t = cs.toString().trim();
                    if (!t.equals("确认登录") && !t.equals("确定") && !t.equals("登录")) continue;
                    android.view.View clickable = tv;
                    for (int i = 0; i < 5 && clickable != null && !clickable.isClickable(); i++) {
                        android.view.ViewParent pp = clickable.getParent();
                        clickable = (pp instanceof android.view.View) ? (android.view.View) pp : null;
                    }
                    if (clickable == null || !clickable.isClickable()) continue;
                    clickable.performClick();
                    log("PCLOGIN|clicked " + t);
                    return;
                }
            }
        } catch (Throwable ignore) { }
    }

    /** 引用直达：从最近消息里选一条，直接填进输入框 */
    private static void showQuotePicker(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || tk.length() == 0) { toast("请先在聊天里执行"); return; }
        try {
            java.util.List<Object[]> rows = queryRows(
                    "select ifnull(content,''), ifnull(type,0), ifnull(isSend,0), ifnull(createTime,0)"
                            + " from message where talker='" + escSql(tk) + "'"
                            + " order by createTime desc limit 25", 4);
            if (rows.isEmpty()) { toast("这个会话没有消息"); return; }
            java.util.ArrayList<Long> tsList = new java.util.ArrayList<Long>();
            java.util.ArrayList<String> labels = new java.util.ArrayList<String>();
            java.text.SimpleDateFormat df =
                    new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US);
            for (Object[] r : rows) {
                long ts = pl(r[3]);
                int tp = (int) pl(r[1]) & 65535;
                String c = String.valueOf(r[0]);
                String body;
                if (tp != 1) {
                    if (tp == 3) body = "[图片]";
                    else if (tp == 34) body = "[语音]";
                    else if (tp == 43) body = "[视频]";
                    else if (tp == 47) body = "[表情]";
                    else if (tp == 49) body = "[文件/链接]";
                    else body = "[消息]";
                } else {
                    int nl = c.indexOf('\n');
                    body = nl >= 0 ? c.substring(nl + 1) : c;
                }
                if (body.length() > 30) body = body.substring(0, 30) + "…";
                String who = pl(r[2]) == 1 ? "我" : "";
                labels.add(df.format(new java.util.Date(ctToMs(ts))) + "  " + who + body);
                tsList.add(Long.valueOf(ts));
            }
            new android.app.AlertDialog.Builder(a)
                    .setTitle("选一条消息引用")
                    .setItems(labels.toArray(new String[0]),
                            new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int which) {
                            boolean ok = insertQuoteFor(a, tk, tsList.get(which).longValue());
                            toast(ok ? "已插入引用，点发送即可" : "插入失败");
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) { log("QUOTEPICK|err " + t); }
    }

    /** 解除输入框字数限制（备注/群名/签名等） */
    private static void installLenHook(ClassLoader app) {
        try {
            Class<?> et = Class.forName("android.widget.EditText", false, app);
            XposedBridge.hookAllMethods(et, "setFilters", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("unlimitLen", false)) return;
                        Object[] fs = (Object[]) p.args[0];
                        if (fs == null || fs.length == 0) return;
                        // 注意：setFilters 的参数类型是 InputFilter[]，给 Object[] 会抛
                        // IllegalArgumentException（今天闪退就是这条）
                        java.util.ArrayList<android.text.InputFilter> keep =
                                new java.util.ArrayList<android.text.InputFilter>();
                        for (Object f : fs) {
                            if (f instanceof android.text.InputFilter.LengthFilter) {
                                continue;   // 丢掉长度过滤器
                            }
                            if (f instanceof android.text.InputFilter) {
                                keep.add((android.text.InputFilter) f);
                            }
                        }
                        p.args[0] = keep.toArray(new android.text.InputFilter[0]);
                        log("LENHOOK|stripped " + (fs.length - keep.size()));
                    } catch (Throwable ignore) { }
                }
            });
            log("LENHOOK|installed");
        } catch (Throwable t) { log("LENHOOK|err " + t); }
    }

    /** 语音打包（当前会话全部语音压成 zip，可直接转发） */
    private static void showVoicePack(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || tk.length() == 0) { toast("请先在聊天里执行"); return; }
        toast("正在打包语音…");
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    java.io.File dir = new java.io.File(android.os.Environment
                            .getExternalStorageDirectory().getAbsolutePath(),
                            "Download/wxh/voicepack_" + System.currentTimeMillis());
                    if (!dir.exists()) dir.mkdirs();
                    int n = exportVoiceOf(tk, 0, dir, null);
                    final int cnt = n;
                    if (n <= 0) {
                        a.runOnUiThread(new Runnable() {
                            @Override public void run() { toast("没有找到可导出的语音"); }
                        });
                        return;
                    }
                    java.io.File[] arr = dir.listFiles();
                    java.util.ArrayList<java.io.File> files = new java.util.ArrayList<java.io.File>();
                    if (arr != null) for (java.io.File f : arr) if (f.isFile()) files.add(f);
                    final java.io.File zip = zipFiles(files, "voice_" + System.currentTimeMillis());
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            if (zip == null) { toast("压缩失败"); return; }
                            log("VOICEPACK|n=" + cnt + " " + zip.getName());
                            askShare(zip);
                        }
                    });
                } catch (Throwable t) {
                    log("VOICEPACK|err " + t);
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() { toast("打包失败：" + t); }
                    });
                }
            }
        }).start();
    }

    /** 按标签导出联系人 */
    private static void showLabelExport(final android.app.Activity a) {
        toast("正在读取标签…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<String[]> labs = new java.util.ArrayList<String[]>();
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select * from ContactLabel limit 500", 6);
                    for (Object[] r : rows) {
                        String nm = String.valueOf(r[1]);
                        if (nm.trim().length() == 0) nm = "标签#" + pl(r[0]);
                        labs.add(new String[]{String.valueOf(pl(r[0])), nm});
                    }
                } catch (Throwable t) { log("LEXP|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (labs.isEmpty()) { toast("还没有创建标签"); return; }
                        String[] items = new String[labs.size()];
                        for (int i = 0; i < labs.size(); i++) items[i] = labs.get(i)[1];
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("按标签导出联系人")
                                .setItems(items, new android.content.DialogInterface.OnClickListener() {
                                    @Override public void onClick(android.content.DialogInterface d, int which) {
                                        doLabelExport(a, labs.get(which)[0], labs.get(which)[1]);
                                    }
                                })
                                .setNegativeButton("取消", null)
                                .show();
                    }
                });
            }
        }).start();
    }

    private static void doLabelExport(final android.app.Activity a, final String labelId, final String labelName) {
        toast("正在导出…");
        new Thread(new Runnable() {
            @Override public void run() {
                final StringBuilder sb = new StringBuilder();
                final int[] n = new int[]{0};
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(username,''), ifnull(alias,''), ifnull(conRemark,''),"
                                    + " ifnull(nickname,''), ifnull(contactLabelIds,'') from rcontact"
                                    + " where (ifnull(type,0)&1)!=0 and username not like 'gh_%'"
                                    + " and username not like '%@chatroom' limit 3000", 5);
                    sb.append("\uFEFF昵称,备注,微信号,wxid,标签\n");
                    for (Object[] r : rows) {
                        String ids = String.valueOf(r[4]);
                        boolean hit = false;
                        for (String id : ids.split(",")) {
                            if (id.trim().equals(labelId)) { hit = true; break; }
                        }
                        if (!hit) continue;
                        n[0]++;
                        String nick = String.valueOf(r[3]);
                        String remark = String.valueOf(r[2]);
                        String alias = String.valueOf(r[1]);
                        sb.append(csv(nick)).append(',').append(csv(remark)).append(',')
                          .append(csv(alias)).append(',').append(csv(String.valueOf(r[0])))
                          .append(',').append(csv(labelName)).append('\n');
                    }
                } catch (Throwable t) { log("LEXP|dump err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (n[0] == 0) { toast("这个标签下没有好友"); return; }
                        try {
                            java.io.File dir = new java.io.File(android.os.Environment
                                    .getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
                            if (!dir.exists()) dir.mkdirs();
                            String safe = labelName.replaceAll("[\\\\/:*?\"<>|]", "_");
                            java.io.File f = new java.io.File(dir,
                                    "label_" + safe + "_" + System.currentTimeMillis() + ".csv");
                            java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
                            fo.write(sb.toString().getBytes("UTF-8"));
                            fo.close();
                            log("LEXP|ok n=" + n[0] + " " + f.getName());
                            askShare(f);
                        } catch (Throwable t) { toast("写入失败"); }
                    }
                });
            }
        }).start();
    }

    /** 联系人标签统计（每个标签多少人 + 无标签人数） */
    private static void showLabelStats(final android.app.Activity a) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.LinkedHashMap<String, String> idName =
                        new java.util.LinkedHashMap<String, String>();
                final java.util.LinkedHashMap<String, Integer> cnt =
                        new java.util.LinkedHashMap<String, Integer>();
                final int[] st = new int[]{0, 0};   // 好友数、无标签数
                try {
                    java.util.List<Object[]> labels = queryRows(
                            "select * from ContactLabel limit 500", 6);
                    for (Object[] r : labels) {
                        idName.put(String.valueOf(pl(r[0])), String.valueOf(r[1]));
                    }
                    log("LBL|labels=" + labels.size());
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(contactLabelIds,'') from rcontact"
                                    + " where (ifnull(type,0)&1)!=0 and username not like 'gh_%'"
                                    + " and username not like '%@chatroom' limit 3000", 1);
                    for (Object[] r : rows) {
                        String ids = String.valueOf(r[0]).trim();
                        st[0]++;
                        if (ids.length() == 0) { st[1]++; continue; }
                        for (String id : ids.split(",")) {
                            String key = id.trim();
                            if (key.length() == 0) continue;
                            String nm = idName.get(key);
                            if (nm == null || nm.length() == 0) nm = "标签#"+key;
                            Integer v = cnt.get(nm);
                            cnt.put(nm, v == null ? 1 : v + 1);
                        }
                    }
                } catch (Throwable t) { log("LBL|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (st[0] == 0) { toast("读不到联系人"); return; }
                        if (cnt.isEmpty()) { toast("还没有创建任何标签"); return; }
                        java.util.List<java.util.Map.Entry<String, Integer>> list =
                                new java.util.ArrayList<java.util.Map.Entry<String, Integer>>(cnt.entrySet());
                        java.util.Collections.sort(list, new java.util.Comparator<java.util.Map.Entry<String, Integer>>() {
                            @Override public int compare(java.util.Map.Entry<String, Integer> x,
                                                         java.util.Map.Entry<String, Integer> y) {
                                return y.getValue() - x.getValue();
                            }
                        });
                        StringBuilder sb = new StringBuilder();
                        sb.append("好友总数　").append(st[0]).append('\n');
                        sb.append("未打标签　").append(st[1])
                          .append("　(").append(String.format(java.util.Locale.US, "%.0f",
                                  st[1] * 100.0 / st[0])).append("%)\n\n");
                        sb.append("【各标签人数】\n");
                        int mx = list.get(0).getValue();
                        for (java.util.Map.Entry<String, Integer> e : list) {
                            int bars = (int) Math.round((double) e.getValue() * 10 / Math.max(mx, 1));
                            StringBuilder b = new StringBuilder();
                            for (int i = 0; i < bars; i++) b.append('▇');
                            for (int i = bars; i < 10; i++) b.append('·');
                            sb.append(padRight(e.getKey(), 14)).append(b)
                              .append(' ').append(e.getValue()).append('\n');
                        }
                        showTextDialog(a, "联系人标签统计", sb.toString(), "label_stats.txt");
                    }
                });
            }
        }).start();
    }

    /** 群活跃趋势（近 12 周，每周柱状） */
    private static void showWeekTrend(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final long[] weeks = new long[12];
                final String[] labels = new String[12];
                try {
                    long now = System.currentTimeMillis();
                    long since = sinceRaw(now - 12L * 7 * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(createTime,0) from message where talker='" + escSql(tk)
                                    + "' and createTime>=" + since + " limit 20000", 1);
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("MM-dd", java.util.Locale.US);
                    for (int i = 0; i < 12; i++) {
                        long end = now - (11 - i) * 7L * 86400000L;
                        labels[i] = df.format(new java.util.Date(end - 6L * 86400000L))
                                + "~" + df.format(new java.util.Date(end));
                    }
                    for (Object[] r : rows) {
                        long ct = pl(r[0]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        if (ct <= 0) continue;
                        long diffDays = (now - ct) / 86400000L;
                        int idx = 11 - (int) (diffDays / 7);
                        if (idx >= 0 && idx < 12) weeks[idx]++;
                    }
                } catch (Throwable t) { log("WTREND|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        long total = 0;
                        long mx = 1;
                        for (long v : weeks) { total += v; mx = Math.max(mx, v); }
                        if (total == 0) { toast("没有数据"); return; }
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 近 12 周活跃\n\n");
                        for (int i = 0; i < 12; i++) {
                            int bars = (int) Math.round((double) weeks[i] * 10 / mx);
                            StringBuilder b = new StringBuilder();
                            for (int j = 0; j < bars; j++) b.append('▇');
                            for (int j = bars; j < 10; j++) b.append('·');
                            sb.append(padRight(labels[i], 14)).append(b)
                              .append(' ').append(weeks[i]).append('\n');
                        }
                        long thisW = weeks[11], lastW = weeks[10];
                        sb.append("\n本周 ").append(thisW).append(" 条，上周 ").append(lastW).append(" 条");
                        if (lastW > 0) {
                            double pct = (thisW - lastW) * 100.0 / lastW;
                            sb.append("（").append(String.format(java.util.Locale.US, "%+.0f", pct)).append("%）");
                        }
                        showTextDialog(a, "群活跃趋势（12周）", sb.toString(), "week_trend.txt");
                    }
                });
            }
        }).start();
    }

    /** 好友备注体检：列出没备注的好友，点一下就能补备注 */
    private static void showContactHealth(final android.app.Activity a) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<String[]> list = new java.util.ArrayList<String[]>();
                final int[] st = new int[]{0, 0, 0};
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(username,''), ifnull(conRemark,''), ifnull(nickname,''), ifnull(alias,'')"
                                    + " from rcontact where (ifnull(type,0)&1)!=0"
                                    + " and username not like 'gh_%' and username not like '%@chatroom'"
                                    + " limit 3000", 4);
                    for (Object[] r : rows) {
                        String u = String.valueOf(r[0]);
                        String remark = r[1] == null ? "" : String.valueOf(r[1]).trim();
                        String nick = r[2] == null ? "" : String.valueOf(r[2]).trim();
                        String alias = r[3] == null ? "" : String.valueOf(r[3]).trim();
                        if (u.length() == 0) continue;
                        st[0]++;
                        if (remark.length() > 0) { st[1]++; continue; }
                        if (nick.length() > 0) st[2]++;
                        String show = nick.length() > 0 ? nick : (alias.length() > 0 ? alias : u);
                        list.add(new String[]{u, show});
                    }
                } catch (Throwable t) { log("CHEALTH|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (st[0] == 0) { toast("读不到联系人"); return; }
                        showContactHealthPanel(a, st[0], st[1], list);
                    }
                });
            }
        }).start();
    }

    private static void showContactHealthPanel(final android.app.Activity a, int total, int hasRemark,
                                               final java.util.ArrayList<String[]> list) {
        try {
            int no = total - hasRemark;
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 14), dp(a, 6), dp(a, 14), dp(a, 6));

            android.widget.TextView head = new android.widget.TextView(a);
            head.setText("好友 " + total + "　有备注 " + hasRemark
                    + "（" + String.format(java.util.Locale.US, "%.0f", hasRemark * 100.0 / total) + "%）"
                    + "　无备注 " + no);
            head.setTextSize(12);
            head.setTextColor(0xFF9A9AA2);
            head.setPadding(dp(a, 4), 0, 0, dp(a, 8));
            box.addView(head);

            android.widget.TextView tip = new android.widget.TextView(a);
            tip.setText(no == 0 ? "全部好友都有备注 👍" : "点一下复制昵称，去微信搜索粘贴即可（共 " + list.size() + " 位）");
            tip.setTextSize(12);
            tip.setTextColor(0xFF3B5BDB);
            tip.setPadding(dp(a, 4), 0, 0, dp(a, 8));
            box.addView(tip);

            for (int i = 0; i < list.size(); i++) {
                final String u = list.get(i)[0];
                final String show = list.get(i)[1];
                android.widget.LinearLayout card = new android.widget.LinearLayout(a);
                card.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                card.setGravity(android.view.Gravity.CENTER_VERTICAL);
                card.setBackground(roundRect(0xE2FFFFFF, dp(a, 12)));
                card.setPadding(dp(a, 14), dp(a, 12), dp(a, 14), dp(a, 12));

                android.widget.TextView nm = new android.widget.TextView(a);
                nm.setText(show);
                nm.setTextSize(15);
                nm.setTextColor(0xFF141418);
                nm.setSingleLine(true);
                nm.setEllipsize(android.text.TextUtils.TruncateAt.END);
                card.addView(nm, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));

                android.widget.TextView btn = new android.widget.TextView(a);
                btn.setText("复制");
                btn.setTextSize(12);
                btn.setTextColor(0xFF3B5BDB);
                btn.setPadding(dp(a, 10), dp(a, 4), dp(a, 10), dp(a, 4));
                btn.setBackground(roundRect(0xFFEEF2FF, dp(a, 8)));
                card.addView(btn);

                android.widget.LinearLayout.LayoutParams clp = new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                clp.bottomMargin = dp(a, 6);
                card.setLayoutParams(clp);

                final String copyText = show;
                card.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try {
                            android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                    a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                            cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", copyText));
                            toast("已复制「" + copyText + "」\n去微信搜索粘贴即可打开资料页");
                        } catch (Throwable t) { toast("复制失败"); }
                    }
                });
                box.addView(card);
            }

            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            sv.addView(box);

            new android.app.AlertDialog.Builder(a)
                    .setTitle("好友备注体检")
                    .setView(sv)
                    .setNegativeButton("关闭", null)
                    .setNeutralButton("导出名单", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                StringBuilder sb = new StringBuilder("【无备注好友】\n");
                                for (String[] it : list) sb.append(it[1]).append('\n');
                                fallbackExport(sb.toString(), "contact_health.txt");
                            } catch (Throwable t) { toast("导出失败"); }
                        }
                    })
                    .show();
        } catch (Throwable t) {
            toast("面板打开失败 " + t);
        }
    }

    /** 新好友自动备注添加时间：加好友 7 天内，把「·MM-dd」追加到备注里（只补一次） */
    private static long autoRemarkLast = 0L;

    /** 备注日期格式（用户可自定义，默认 ·MM-dd） */
    private static String autoRemarkFmt(JSONObject c) {
        String f = "";
        try { f = c == null ? "" : c.optString("autoRemarkFmt", ""); } catch (Throwable ignore) { }
        if (f == null || f.trim().length() == 0) f = " yyyy-MM-dd";
        if (f.startsWith("·")) f = " " + f.substring(1);   // 旧的「·」前缀自动改成空格
        return f;
    }

    private static java.text.SimpleDateFormat autoRemarkDf(JSONObject c) {
        try {
            return new java.text.SimpleDateFormat(autoRemarkFmt(c), java.util.Locale.US);
        } catch (Throwable t) {
            return new java.text.SimpleDateFormat(" yyyy-MM-dd", java.util.Locale.US);
        }
    }

    private static String autoRemarkSample(JSONObject c) {
        try { return autoRemarkDf(c).format(new java.util.Date()); } catch (Throwable t) { return ""; }
    }

    /** 格式选择器：6 个常用预设 + 自定义（支持 yyyy MM dd HH mm 等符号，可带前缀后缀） */
    private static void showAutoRemarkFmt(final android.app.Activity a) {
        try {
            final String[] labels = {
                    "昵称 2026-11-13（空格+年-月-日）",
                    "昵称 2026年11月13日（空格+中文）",
                    "昵称 2026年11月13日 11:20（空格+中文+时间）",
                    "昵称（2026-11-13）（括号后缀）",
                    "昵称 11-13（空格+月-日）",
                    "昵称 11月13日（空格+中文短）",
                    "自定义…"
            };
            final String[] pats = {
                    " yyyy-MM-dd", " yyyy年MM月dd日", " yyyy年MM月dd日 HH:mm",
                    "（yyyy-MM-dd）", " MM-dd", " MM月dd日"
            };
            String cur = autoRemarkFmt(cfg());
            int checked = 0;
            for (int i = 0; i < pats.length; i++) if (pats[i].equals(cur)) checked = i;
            new android.app.AlertDialog.Builder(a)
                    .setTitle("备注日期格式（当前 " + autoRemarkSample(cfg()) + "）")
                    .setSingleChoiceItems(labels, checked, new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int which) {
                            try { d.dismiss(); } catch (Throwable ignore) { }
                            if (which >= pats.length) { askAutoRemarkFmtCustom(a); return; }
                            JSONObject c = readCfg();
                            try { c.put("autoRemarkFmt", pats[which]); } catch (Throwable ignore) { }
                            writeCfg(c);
                            cfg = null; cfgAt = 0;
                            toast("格式已改为 " + pats[which]);
                            try { showAutoRemarkFmt(a); } catch (Throwable ignore) { }
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { toast("打开失败 " + t); }
    }

    private static void askAutoRemarkFmtCustom(final android.app.Activity a) {
        try {
            final android.widget.EditText et = new android.widget.EditText(a);
            et.setText(autoRemarkFmt(cfg()));
            et.setHint("如  yyyy-MM-dd 或  yyyy年MM月dd日");
            et.setTextSize(15);
            et.setSingleLine(true);
            int pad = dp(a, 16);
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(pad, dp(a, 8), pad, 0);
            box.addView(et);
            android.widget.TextView tip = new android.widget.TextView(a);
            tip.setTextSize(12);
            tip.setTextColor(0xFF8A94A6);
            tip.setText("可用：yyyy 年 / MM 月 / dd 日 / HH 时 / mm 分；开头写空格就是空格分隔，也可写前后缀，如（yyyy-MM-dd）");
            tip.setPadding(pad, dp(a, 6), pad, 0);
            box.addView(tip);
            new android.app.AlertDialog.Builder(a)
                    .setTitle("自定义日期格式")
                    .setView(box)
                    .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            String f = et.getText().toString().trim();
                            if (f.length() == 0) f = " yyyy-MM-dd";
                            try { new java.text.SimpleDateFormat(f, java.util.Locale.US); }
                            catch (Throwable bad) { toast("格式不合法，已还原默认"); f = " yyyy-MM-dd"; }
                            JSONObject c = readCfg();
                            try { c.put("autoRemarkFmt", f); } catch (Throwable ignore) { }
                            writeCfg(c);
                            cfg = null; cfgAt = 0;
                            toast("示例：" + autoRemarkSample(cfg()));
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) { toast("打开失败 " + t); }
    }

    private static void autoRemarkNewFriends() {
        try {
            final JSONObject c = cfg();
            if (c == null || !c.optBoolean("autoRemarkTime", false)) return;
            long now = System.currentTimeMillis();
            if (now - autoRemarkLast < 15000L) return;      // 15 秒最多一次
            autoRemarkLast = now;
            new Thread(new Runnable() {
                @Override public void run() { autoRemarkScan(); }
            }).start();
        } catch (Throwable ignore) { }
    }

    /** 真正扫描：只对开启后新加的好友补「·MM-dd」，已有该日期标记的跳过 */
    private static void autoRemarkScan() {
        try {
            JSONObject c = cfg();
            long now = System.currentTimeMillis();
            long since = c == null ? 0L : c.optLong("autoRemarkSince", 0L);
            if (since <= 0L) {
                if (c != null) {
                    try { c.put("autoRemarkSince", now); writeCfg(c); } catch (Throwable ignore) { }
                }
                log("AREMARK|armed since=" + now);
                return;
            }
            long from = since - 600000L;
            long recent = now - 3L * 24 * 3600 * 1000;      // 近 3 天新加的好友也补
            if (recent < from) from = recent;
            java.text.SimpleDateFormat df = autoRemarkDf(c);
            java.util.List<Object[]> rows = queryRows(
                    "select ifnull(username,''), ifnull(nickname,''), ifnull(conRemark,''),"
                            + " ifnull(createTime,0) from rcontact where (ifnull(type,0)&1)!=0"
                            + " and username not like 'gh_%' and username not like '%@chatroom'"
                            + " limit 3000", 4);
            int done = 0;
            log("AREMARK|scan-window from=" + from);
            for (Object[] r : rows) {
                String u = String.valueOf(r[0]);
                String nick = String.valueOf(r[1]);
                String rem = String.valueOf(r[2]);
                long ct = pl(r[3]);
                if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                if (ct <= 0 || ct < from) continue;
                String tag = df.format(new java.util.Date(ct));
                String probe = tag.trim();
                if (probe.length() > 0 && rem.indexOf(probe) >= 0) continue;
                String base = rem.length() > 0 ? rem : (nick.length() > 0 ? nick : u);
                String sep = tag.startsWith(" ") || tag.startsWith("（") || tag.startsWith("(") ? "" : " ";
                while (base.endsWith(" ")) base = base.substring(0, base.length() - 1);
                String next = base + sep + tag;
                if (next.length() > 32) continue;
                String esc = next.replace("'", "''");
                String escU = u.replace("'", "''");
                if (execSqlRaw("update rcontact set conRemark='" + esc
                        + "' where username='" + escU + "'")) done++;
                if (done >= 200) break;
            }
            // 兜底：新通过的好友，rcontact.createTime 往往是“发起请求”的时间，
            // 可能远早于开启时刻，所以再从 fmessage（新的朋友）里找最近通过的
            int fdone = 0;
            try {
                // 表名各版本不一样：先确认存在再查，避免每 15 秒刷一条 no such table
                String fTab = null;
                for (String cand : new String[]{"fmessage", "fmessages"}) {
                    try {
                        java.util.List<Object[]> t = queryRows(
                                "select name from sqlite_master where type='table' and name='"
                                        + cand + "'", 1);
                        if (!t.isEmpty()) { fTab = cand; break; }
                    } catch (Throwable ignore) { }
                }
                if (fTab == null) {
                    if (!fmsgMissingLogged) {
                        fmsgMissingLogged = true;
                        log("AREMARK|fmsg table missing, fallback off");
                    }
                } else {
                java.util.List<Object[]> fr = queryRows(
                        "select ifnull(username,''), ifnull(createtime,0) from " + fTab
                                + " order by createtime desc limit 40", 2);
                for (Object[] r : fr) {
                    String u = String.valueOf(r[0]);
                    long ft = pl(r[1]);
                    if (ft > 0 && ft < 100000000000L) ft *= 1000L;
                    if (u.length() == 0 || ft <= 0 || ft < from) continue;
                    String tagF = df.format(new java.util.Date(ft));
                    String probeF = tagF.trim();
                    java.util.List<Object[]> one = queryRows(
                            "select ifnull(conRemark,''), ifnull(nickname,'') from rcontact"
                                    + " where username='" + u.replace("'", "''") + "'", 2);
                    if (one.isEmpty()) continue;
                    String remF = String.valueOf(one.get(0)[0]);
                    String nickF = String.valueOf(one.get(0)[1]);
                    if (probeF.length() > 0 && remF.indexOf(probeF) >= 0) continue;
                    String baseF = remF.length() > 0 ? remF : (nickF.length() > 0 ? nickF : u);
                    String sepF = tagF.startsWith(" ") || tagF.startsWith("（") || tagF.startsWith("(") ? "" : " ";
                    while (baseF.endsWith(" ")) baseF = baseF.substring(0, baseF.length() - 1);
                    String nextF = baseF + sepF + tagF;
                    if (nextF.length() > 32) continue;
                    if (execSqlRaw("update rcontact set conRemark='" + nextF.replace("'", "''")
                            + "' where username='" + u.replace("'", "''") + "'")) fdone++;
                    if (fdone >= 40) break;
                }
                }
            } catch (Throwable ignore) { }
            log("AREMARK|scan rows=" + rows.size() + " done=" + done + " fdone=" + fdone);
            if (done + fdone > 0) { try { refreshChatList(); } catch (Throwable ignore) { } }
        } catch (Throwable t) { log("AREMARK|err " + t); }
    }

    /** 给某个好友设置备注 */
    private static void askRemarkFor(final android.app.Activity a, final String username, final String show) {
        try {
            final android.widget.EditText et = new android.widget.EditText(a);
            et.setHint("给「" + show + "」加个备注");
            et.setTextSize(15);
            et.setSingleLine(true);
            int pad = dp(a, 16);
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(pad, dp(a, 8), pad, 0);
            box.addView(et);

            new android.app.AlertDialog.Builder(a)
                    .setTitle("添加备注")
                    .setView(box)
                    .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            String remark = et.getText().toString().trim();
                            if (remark.length() == 0) { toast("备注不能为空"); return; }
                            String esc = remark.replace("'", "''");
                            String escU = username.replace("'", "''");
                            boolean ok = execSqlRaw("update rcontact set conRemark='" + esc
                                    + "' where username='" + escU + "'");
                            toast(ok ? "已备注：" + remark : "写入失败");
                            if (ok) {
                                try { refreshChatList(); } catch (Throwable ignore) { }
                                try { a.runOnUiThread(new Runnable() {
                                    @Override public void run() {
                                        new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
                                                new Runnable() { @Override public void run() {
                                                    showContactHealth(a);
                                                } }, 600);
                                    }
                                }); } catch (Throwable ignore) { }
                            }
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) { toast("打开失败 " + t); }
    }

    /** 导出兜底：写 Download/wxh 目录 */
    private static void fallbackExport(String text, String name) {
        try {
            java.io.File dir = new java.io.File("/sdcard/Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            java.io.File f = new java.io.File(dir, name);
            java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
            fo.write(text.getBytes("UTF-8"));
            fo.close();
            toast("已导出：" + f.getAbsolutePath());
        } catch (Throwable t) { toast("导出失败 " + t); }
    }

    /** 全部群的文件汇总（跨群，type 49 且带 totallen 且标题带扩展名） */
    private static void showAllGroupFiles(final android.app.Activity a) {
        toast("正在扫描…");
        new Thread(new Runnable() {
            @Override public void run() {
                StringBuilder sb = new StringBuilder();
                int n = 0;
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(talker,''), ifnull(content,''), ifnull(createTime,0) from message"
                                    + " where (type&65535)=49 and talker like '%@chatroom'"
                                    + " order by createTime desc limit 3000", 3);
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US);
                    for (Object[] r : rows) {
                        String c = String.valueOf(r[1]);
                        if (c.indexOf("<appmsg") < 0) continue;
                        String title = tagOf(c, "title");
                        if (title == null || title.length() == 0) continue;
                        String low = title.toLowerCase();
                        boolean isFile = low.endsWith(".pdf") || low.endsWith(".doc") || low.endsWith(".docx")
                                || low.endsWith(".xls") || low.endsWith(".xlsx") || low.endsWith(".ppt")
                                || low.endsWith(".pptx") || low.endsWith(".zip") || low.endsWith(".rar")
                                || low.endsWith(".txt") || low.endsWith(".csv") || low.endsWith(".apk")
                                || low.endsWith(".mp4") || low.endsWith(".mp3");
                        if (!isFile) continue;
                        long total = 0;
                        try {
                            String tl = tagOf(c, "totallen");
                            if (tl != null) total = Long.parseLong(tl.trim());
                        } catch (Throwable ignore) { }
                        if (total <= 0) continue;
                        long ct = pl(r[2]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        String size = total > 1048576 ? (total / 1048576) + "MB" : (total / 1024) + "KB";
                        n++;
                        if (n > 300) break;
                        sb.append(df.format(new java.util.Date(ct)))
                          .append("  ").append(padRight(displayOfTalker(String.valueOf(r[0])), 14))
                          .append("  ").append(padRight(title, 24))
                          .append("  ").append(size).append('\n');
                    }
                } catch (Throwable t) { log("ALLFILES|err " + t); }
                final String body = sb.toString();
                final int cnt = n;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (cnt == 0) { toast("没有找到群文件记录"); return; }
                        String head = "全部群文件 · 共 " + cnt + " 个（最近 3000 条消息内）\n\n";
                        showTextDialog(a, "群文件汇总", head + body, "all_group_files.txt");
                    }
                });
            }
        }).start();
    }

    /** 群成员首次出现时间（估算入群时间，按最近 5000 条消息回溯） */
    private static void showMemberFirstSeen(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在回溯…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.HashMap<String, Long> first = new java.util.HashMap<String, Long>();
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(content,''), ifnull(createTime,0) from message where talker='"
                                    + escSql(tk) + "' order by createTime desc limit 5000", 2);
                    for (Object[] r : rows) {
                        String sid = senderIdOfGroupMsg(String.valueOf(r[0]));
                        if (sid == null || sid.length() == 0) continue;
                        long ct = pl(r[1]);
                        if (ct <= 0) continue;
                        if (ct < 100000000000L) ct *= 1000L;
                        Long prev = first.get(sid);
                        if (prev == null || ct < prev) first.put(sid, ct);
                    }
                } catch (Throwable t) { log("FIRSTSEEN|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (first.isEmpty()) { toast("没有数据"); return; }
                        java.util.List<java.util.Map.Entry<String, Long>> list =
                                new java.util.ArrayList<java.util.Map.Entry<String, Long>>(first.entrySet());
                        java.util.Collections.sort(list, new java.util.Comparator<java.util.Map.Entry<String, Long>>() {
                            @Override public int compare(java.util.Map.Entry<String, Long> x,
                                                         java.util.Map.Entry<String, Long> y) {
                                return Long.compare(y.getValue(), x.getValue());
                            }
                        });
                        java.text.SimpleDateFormat df =
                                new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 成员首次出现（估算）\n");
                        sb.append("注：只回溯到最近 5000 条消息，老成员可能显示为更早的日期\n\n");
                        int n = 0;
                        for (java.util.Map.Entry<String, Long> e : list) {
                            if (n++ >= 60) break;
                            long days = (System.currentTimeMillis() - e.getValue()) / 86400000L;
                            sb.append(df.format(new java.util.Date(e.getValue())))
                              .append("  ").append(padRight(nameOf(e.getKey()), 14))
                              .append("   距今 ").append(days).append(" 天\n");
                        }
                        showTextDialog(a, "成员首次出现时间", sb.toString(), "first_seen.txt");
                    }
                });
            }
        }).start();
    }

    /** 群消息时段热力图（近 30 天，24 小时分布） */
    private static void showHourHeat(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final int[] hours = new int[24];
                int total = 0;
                try {
                    long since = sinceRaw(System.currentTimeMillis() - 30L * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(createTime,0) from message where talker='" + escSql(tk)
                                    + "' and createTime>=" + since + " limit 8000", 1);
                    java.util.Calendar cal = java.util.Calendar.getInstance();
                    for (Object[] r : rows) {
                        long ct = pl(r[0]);
                        if (ct <= 0) continue;
                        if (ct < 100000000000L) ct *= 1000L;
                        cal.setTimeInMillis(ct);
                        hours[cal.get(java.util.Calendar.HOUR_OF_DAY)]++;
                        total++;
                    }
                } catch (Throwable t) { log("HEAT|err " + t); }
                final int ftotal = total;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (ftotal == 0) { toast("没有数据"); return; }
                        int mx = 1;
                        for (int h : hours) mx = Math.max(mx, h);
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 近 30 天 ")
                          .append(ftotal).append(" 条\n\n");
                        for (int i = 0; i < 24; i++) {
                            int bars = (int) Math.round((double) hours[i] * 10 / mx);
                            StringBuilder b = new StringBuilder();
                            for (int j = 0; j < bars; j++) b.append('▇');
                            for (int j = bars; j < 10; j++) b.append('·');
                            sb.append(String.format(java.util.Locale.US, "%02d", i)).append(' ')
                              .append(b).append(' ').append(hours[i]).append('\n');
                        }
                        int peak = 0;
                        for (int i = 1; i < 24; i++) if (hours[i] > hours[peak]) peak = i;
                        sb.append("\n最活跃时段　").append(String.format(java.util.Locale.US, "%02d", peak))
                          .append(":00 前后（").append(hours[peak]).append(" 条）");
                        showTextDialog(a, "群消息时段分布", sb.toString(), "hour_heat.txt");
                    }
                });
            }
        }).start();
    }

    /** 群消息类型分布（近 30 天） */
    private static void showMsgTypeDist(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.LinkedHashMap<String, Integer> cnt =
                        new java.util.LinkedHashMap<String, Integer>();
                int total = 0;
                try {
                    long since = sinceRaw(System.currentTimeMillis() - 30L * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select (type&65535), count(*) from message where talker='" + escSql(tk)
                                    + "' and createTime>=" + since + " group by (type&65535)", 2);
                    for (Object[] r : rows) {
                        int t = (int) pl(r[0]);
                        int n = (int) pl(r[1]);
                        total += n;
                        String name = msgTypeName(t);
                        Integer v = cnt.get(name);
                        cnt.put(name, v == null ? n : v + n);
                    }
                } catch (Throwable t) { log("TYPEDIST|err " + t); }
                final int ft = total;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (ft == 0) { toast("没有数据"); return; }
                        java.util.List<java.util.Map.Entry<String, Integer>> list =
                                new java.util.ArrayList<java.util.Map.Entry<String, Integer>>(cnt.entrySet());
                        java.util.Collections.sort(list, new java.util.Comparator<java.util.Map.Entry<String, Integer>>() {
                            @Override public int compare(java.util.Map.Entry<String, Integer> x,
                                                         java.util.Map.Entry<String, Integer> y) {
                                return y.getValue() - x.getValue();
                            }
                        });
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 近 30 天共 ").append(ft).append(" 条\n\n");
                        for (java.util.Map.Entry<String, Integer> e : list) {
                            double pct = e.getValue() * 100.0 / ft;
                            sb.append(padRight(e.getKey(), 10))
                              .append(String.format(java.util.Locale.US, "%6d", e.getValue()))
                              .append("  ")
                              .append(String.format(java.util.Locale.US, "%5.1f", pct)).append("%\n");
                        }
                        showTextDialog(a, "群消息类型分布", sb.toString(), "type_dist.txt");
                    }
                });
            }
        }).start();
    }

    private static String msgTypeName(int t) {
        switch (t) {
            case 1: return "文字";
            case 3: return "图片";
            case 34: return "语音";
            case 42: return "名片";
            case 43: return "视频";
            case 47: return "表情";
            case 48: return "位置";
            case 49: return "链接/文件";
            case 50: return "通话";
            case 10000: return "系统提示";
            case 10002: return "系统消息";
            case 436207665: return "红包";
            case 419430449: return "转账";
            default: return "其他(" + t + ")";
        }
    }

    /** 群成员退群/入群统计（近 30 天） */
    private static void showJoinQuitStats(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                StringBuilder quit = new StringBuilder();
                StringBuilder join = new StringBuilder();
                int qn = 0, jn = 0;
                try {
                    long since = sinceRaw(System.currentTimeMillis() - 30L * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(content,''), createTime from message where talker='" + escSql(tk)
                                    + "' and (type&65535)=10000 and createTime>=" + since
                                    + " order by createTime desc limit 800", 2);
                    java.text.SimpleDateFormat df =
                            new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US);
                    for (Object[] r : rows) {
                        String c = String.valueOf(r[0]);
                        long ct = pl(r[1]);
                        if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                        String when = ct > 0 ? df.format(new java.util.Date(ct)) : "--";
                        if (c.contains("退出了群聊") || c.contains("移出群聊") || c.contains("被移出")) {
                            qn++;
                            quit.append(when).append("  ").append(extractQuotedName(c)).append('\n');
                        } else if (c.contains("加入了群聊") || c.contains("通过扫描二维码加入")) {
                            jn++;
                            join.append(when).append("  ").append(extractQuotedName(c)).append('\n');
                        }
                    }
                } catch (Throwable t) { log("JQ|err " + t); }
                final String qs = quit.toString(), js = join.toString();
                final int fqn = qn, fjn = jn;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        StringBuilder sb = new StringBuilder();
                        sb.append("近 30 天  入群 ").append(fjn).append(" 人  退群 ").append(fqn).append(" 人\n");
                        sb.append("净变化 ").append(fjn - fqn > 0 ? "+" : "").append(fjn - fqn).append("\n\n");
                        if (fqn > 0) sb.append("【退群/被移出】\n").append(qs).append('\n');
                        if (fjn > 0) sb.append("【新入群】\n").append(js);
                        if (fqn == 0 && fjn == 0) sb.append("这 30 天没有成员变动记录");
                        showTextDialog(a, displayOfTalker(tk) + " · 成员变动",
                                sb.toString(), "join_quit.txt");
                    }
                });
            }
        }).start();
    }

    /** 从「"张三"退出了群聊」这类文案里取名字 */
    private static String extractQuotedName(String c) {
        try {
            int a1 = c.indexOf('"');
            int b1 = a1 >= 0 ? c.indexOf('"', a1 + 1) : -1;
            if (a1 >= 0 && b1 > a1) return c.substring(a1 + 1, b1);
            int a2 = c.indexOf('“');
            int b2 = a2 >= 0 ? c.indexOf('”', a2 + 1) : -1;
            if (a2 >= 0 && b2 > a2) return c.substring(a2 + 1, b2);
            String t = c.replaceAll("<[^>]+>", " ").trim();
            return t.length() > 40 ? t.substring(0, 40) : t;
        } catch (Throwable t) { return "?"; }
    }

    /** 群聊关键词热度榜（近 7 天） */
    private static void showGroupHotWords(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.HashMap<String, Integer> cnt = new java.util.HashMap<String, Integer>();
                try {
                    long since = sinceRaw(System.currentTimeMillis() - 7L * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(content,'') from message where talker='" + escSql(tk)
                                    + "' and createTime>=" + since + " order by createTime desc limit 1200", 1);
                    for (Object[] r : rows) {
                        String c = String.valueOf(r[0]);
                        String sid = senderIdOfGroupMsg(c);
                        if (sid != null && c.startsWith(sid)) c = c.substring(Math.min(c.length(), sid.length() + 2));
                        c = c.replaceAll("<[^>]+>", " ").replaceAll("[\\p{Punct}\\s]+", " ");
                        if (c.length() < 4) continue;
                        for (int i = 0; i + 2 <= c.length(); i++) {
                            String g = c.substring(i, i + 2).trim();
                            if (g.length() < 2) continue;
                            if (g.matches("^[0-9a-zA-Z\\s]+$")) continue;
                            Integer v = cnt.get(g);
                            cnt.put(g, v == null ? 1 : v + 1);
                        }
                    }
                } catch (Throwable t) { log("HOT|err " + t); }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (cnt.isEmpty()) { toast("数据不足"); return; }
                        java.util.List<java.util.Map.Entry<String, Integer>> list =
                                new java.util.ArrayList<java.util.Map.Entry<String, Integer>>(cnt.entrySet());
                        java.util.Collections.sort(list, new java.util.Comparator<java.util.Map.Entry<String, Integer>>() {
                            @Override public int compare(java.util.Map.Entry<String, Integer> x,
                                                         java.util.Map.Entry<String, Integer> y) {
                                return y.getValue() - x.getValue();
                            }
                        });
                        StringBuilder sb = new StringBuilder();
                        sb.append(displayOfTalker(tk)).append(" · 近 7 天热词\n\n");
                        int n = 0;
                        int max = list.get(0).getValue();
                        for (java.util.Map.Entry<String, Integer> e : list) {
                            if (n++ >= 30) break;
                            if (e.getValue() < 3) break;
                            int bars = (int) Math.round((double) e.getValue() * 8 / Math.max(max, 1));
                            if (bars < 1) bars = 1;
                            StringBuilder b = new StringBuilder();
                            for (int i = 0; i < bars; i++) b.append('▇');
                            sb.append(padRight(e.getKey(), 8)).append(' ').append(b).append(' ')
                              .append(e.getValue()).append('\n');
                        }
                        showTextDialog(a, "群关键词热度榜", sb.toString(), "group_hotwords.txt");
                    }
                });
            }
        }).start();
    }

    /** 群文件变动提醒 */
    private static void maybeFileAlert(String talker, String content, Integer isSend) {
        try {
            if (!cfg().optBoolean("fileAlert", false)) return;
            if (talker == null || !talker.endsWith("@chatroom") || content == null) return;
            if (isSend != null && isSend.intValue() == 1) return;
            if (content.indexOf("<appmsg") < 0) return;
            String title = tagOf(content, "title");
            if (title == null || title.length() == 0) return;
            String low = title.toLowerCase();
            boolean looksFile = low.endsWith(".pdf") || low.endsWith(".doc") || low.endsWith(".docx")
                    || low.endsWith(".xls") || low.endsWith(".xlsx") || low.endsWith(".ppt")
                    || low.endsWith(".pptx") || low.endsWith(".zip") || low.endsWith(".rar")
                    || low.endsWith(".txt") || low.endsWith(".csv") || low.endsWith(".apk")
                    || low.endsWith(".mp4") || low.endsWith(".mp3");
            if (!looksFile) return;
            long total = 0;
            try {
                String tl = tagOf(content, "totallen");
                if (tl != null) total = Long.parseLong(tl.trim());
            } catch (Throwable ignore) { }
            if (total <= 0) return;
            String size = total > 1048576 ? (total / 1048576) + "MB" : (total / 1024) + "KB";
            String who = "";
            int p2 = content.indexOf(":\n");
            if (p2 > 0 && p2 < 64) {
                String sid = content.substring(0, p2).trim();
                if (sid.startsWith("wxid_") || sid.length() > 6) who = nameOf(sid);
            }
            alert(displayOfTalker(talker) + " · 群文件",
                    (who.length() > 0 ? who + "：" : "") + title + " (" + size + ")");
            log("FILEALERT|" + talker + "|" + title + "|" + size);
        } catch (Throwable t) { log("FILEALERT|err " + t); }
    }

    /** 群公告变更提醒 */
    private static void maybeNoticeChange(String talker, String content) {
        try {
            if (talker == null || !talker.endsWith("@chatroom") || content == null) return;
            if (!cfg().optBoolean("noticeAlert", true)) return;
            if (content.indexOf("群公告") < 0 && content.indexOf("公告") < 0) return;
            String body = cleanXmlText(content);
            if (body == null) body = content;
            body = body.replace("\n", " ").trim();
            if (body.length() > 200) body = body.substring(0, 200) + "…";
            String key = talker + "|" + body.hashCode();
            Long prev = noticeSeen.get(key);
            long now = System.currentTimeMillis();
            if (prev != null && now - prev < 3600000L) return;   // 一小时内同内容不重复提醒
            noticeSeen.put(key, now);
            if (noticeSeen.size() > 200) noticeSeen.clear();
            alert(displayOfTalker(talker) + " · 群公告有变", body);
            log("NOTICE|" + talker + "|" + body);
        } catch (Throwable t) { log("NOTICE|err " + t); }
    }

    /* ---- 群签到 ---- */
    private static java.io.File checkinFile(String talker) {
        String d = new java.text.SimpleDateFormat("yyyyMMdd", java.util.Locale.US)
                .format(new java.util.Date());
        String safe = talker.replaceAll("[^A-Za-z0-9]", "_");
        return new java.io.File(DIR, "checkin_" + safe + "_" + d + ".txt");
    }

    private static void maybeCheckin(String talker, String content) {
        try {
            if (!cfg().optBoolean("checkinOn", false)) return;
            if (talker == null || !talker.endsWith("@chatroom") || content == null) return;
            String kw = cfg().optString("checkinKeyword", "签到").trim();
            if (kw.length() == 0) return;
            if (!content.trim().equals(kw)) return;
            String sid = senderIdOfGroupMsg(content);
            if (sid == null || sid.length() == 0) return;
            java.io.File f = checkinFile(talker);
            java.util.ArrayList<String> ids = new java.util.ArrayList<String>();
            if (f.isFile()) {
                java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
                String line;
                while ((line = br.readLine()) != null) {
                    int bar = line.indexOf('|');
                    if (bar > 0) ids.add(line.substring(0, bar));
                }
                br.close();
            }
            if (ids.contains(sid)) {
                sendTextTo(mainAct, talker, "你今天已经签过到了");
                return;
            }
            ids.add(sid);
            java.io.FileWriter fw = new java.io.FileWriter(f, true);
            fw.write(sid + "|" + System.currentTimeMillis() + "\n");
            fw.close();
            String tpl = cfg().optString("checkinReply", "签到成功，今天第 {序号} 位 ✅");
            final String msg = tpl.replace("{序号}", String.valueOf(ids.size()))
                    .replace("{昵称}", nameOf(sid));
            final String tk = talker;
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override public void run() { try { sendTextTo(mainAct, tk, msg); } catch (Throwable ignore) { } }
            }, 1200L);
            log("CHECKIN|" + tk + " sid=" + sid + " n=" + ids.size());
        } catch (Throwable t) { log("CHECKIN|err " + t); }
    }

    private static void showCheckinPanel(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        try {
            java.io.File f = checkinFile(tk);
            if (!f.isFile()) { toast("今天还没有人签到"); return; }
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            StringBuilder sb = new StringBuilder();
            String line;
            int n = 0;
            java.text.SimpleDateFormat df = new java.text.SimpleDateFormat("HH:mm", java.util.Locale.US);
            while ((line = br.readLine()) != null) {
                int bar = line.indexOf('|');
                if (bar <= 0) continue;
                String sid = line.substring(0, bar);
                long ts = 0;
                try { ts = Long.parseLong(line.substring(bar + 1).trim()); } catch (Throwable ignore) { }
                n++;
                sb.append(n).append(". ").append(nameOf(sid));
                if (ts > 0) sb.append("  ").append(df.format(new java.util.Date(ts)));
                sb.append('\n');
            }
            br.close();
            showTextDialog(a, displayOfTalker(tk) + " · 今日签到 " + n + " 人", sb.toString(), "checkin.txt");
        } catch (Throwable t) { log("CHECKIN|panel " + t); }
    }

