            final Runnable[] paintScene = new Runnable[1];
            final Runnable[] rebuildRef = new Runnable[1];
            final Runnable[] notifyRef = new Runnable[1];
            android.widget.LinearLayout sceneWrap = new android.widget.LinearLayout(a);
            sceneWrap.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.widget.LinearLayout sceneRow = new android.widget.LinearLayout(a);
            sceneRow.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            android.widget.LinearLayout.LayoutParams lpRow = new android.widget.LinearLayout.LayoutParams(-1, -2);
            lpRow.bottomMargin = dp(a, 6);
            sceneWrap.addView(sceneRow, lpRow);
            paintScene[0] = new Runnable() {
                @Override public void run() {
                    try {
                        for (int i = 0; i < sceneViews.size(); i++) {
                            android.widget.TextView c0 = sceneViews.get(i);
                            boolean on = scene[0].equals(String.valueOf(c0.getText()));
                            android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
                            if (on) {
                                gd.setColor(0xFF07C160);
                            } else {
                                gd.setColor(0xFFF2F2F2);
                            }
                            gd.setCornerRadius(dp(a, 5));
                            c0.setBackground(gd);
                            c0.setTextColor(on ? 0xFFFFFFFF : 0xFF3B3B3B);
                        }
                    } catch (Throwable ignore) { }
                }
            };
            android.widget.LinearLayout curRow = sceneRow;
            int ci = 0;
            for (final String sc : SCENES) {
                if (ci > 0 && ci % 4 == 0) {
                    android.widget.LinearLayout nr = new android.widget.LinearLayout(a);
                    nr.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                    android.widget.LinearLayout.LayoutParams lpR2 = new android.widget.LinearLayout.LayoutParams(-1, -2);
                    lpR2.topMargin = dp(a, 4);
                    sceneWrap.addView(nr, lpR2);
                    curRow = nr;
                }
                ci++;
                android.widget.TextView chip = new android.widget.TextView(a);
                chip.setText(sc);
                chip.setTextSize(12);
                chip.setSingleLine(true);
                chip.setGravity(android.view.Gravity.CENTER);
                chip.setIncludeFontPadding(false);
                chip.setPadding(dp(a, 12), 0, dp(a, 12), 0);
                android.widget.LinearLayout.LayoutParams lpC = new android.widget.LinearLayout.LayoutParams(-2, dp(a, 30));
                lpC.rightMargin = dp(a, 8);
                chip.setLayoutParams(lpC);
                chip.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        scene[0] = sc;
                        log("SCENE|tap " + sc);
                        paintScene[0].run();
                        if (rebuildRef[0] != null) rebuildRef[0].run();
                        if (notifyRef[0] != null) notifyRef[0].run();
                    }
                });
                sceneViews.add(chip);
                curRow.addView(chip);
            }
            android.widget.LinearLayout.LayoutParams lpScene = new android.widget.LinearLayout.LayoutParams(-1, -2);
            lpScene.bottomMargin = 8;
            // 场景芯片（全部/首页/聊天…）已按要求下线：不加入面板，搜索直接跨全部分组过滤
            if (false) root.addView(sceneWrap, lpScene);
            paintScene[0].run();

            final android.widget.ListView lv = new android.widget.ListView(a);
            lv.setDivider(null);
            lv.setDividerHeight(0);
            lv.setBackgroundColor(0x00000000);
            root.addView(lv, new android.widget.LinearLayout.LayoutParams(-1, 0, 1f));

            // 分组可能存在「没被任何分组引用」的设置项（那就永远看不见），这里自动补一个「其它功能」组
            final String[][] groups;
            {
                java.util.List<String[]> gl = new java.util.ArrayList<String[]>();
                java.util.HashSet<String> ref = new java.util.HashSet<String>();
                for (String[] g : settingsGroups()) {
                    gl.add(g);
                    for (String k : g[1].split(",")) ref.add(k.trim());
                }
                StringBuilder orphan = new StringBuilder();
                for (String[] it : SETTINGS) {
                    if (!ref.contains(it[0]) && !isHidden(it[0])) orphan.append(it[0]).append(',');
                }
                if (orphan.length() > 0) {
                    orphan.setLength(orphan.length() - 1);
                    gl.add(new String[]{"其它功能", orphan.toString()});
                    log("SGAUTO|orphans=" + (orphan.toString().split(",").length));
                } else {
                    log("SGAUTO|orphans=0");
                }
                groups = gl.toArray(new String[gl.size()][]);
            }

            final java.util.HashSet<String> collapsed = new java.util.HashSet<String>();
            // 两列网格：同时只展开一个分组，点一下在下方整行铺开
            final String[] expanded = new String[]{null};
            boolean hasFoldState = false;
            // 分类表版本：换分类时版本号 +1，第一屏重置为「全部折叠」，避免一屏摊开十几组
            final int GROUPS_VER = 3;
            try {
                org.json.JSONArray ca = cfg().optJSONArray("foldCollapsed");
                if (ca != null) {
                    hasFoldState = true;
                    for (int i = 0; i < ca.length(); i++) collapsed.add(ca.getString(i));
                }
            } catch (Throwable ignore) { }
            if (cfg().optInt("groupsVer", 0) != GROUPS_VER) {
                collapsed.clear();
                for (String[] g0 : groups) collapsed.add(g0[0]);
                if (groups.length > 0) collapsed.remove(groups[0][0]);   // 首组「常用」默认展开，点开就能用
                hasFoldState = true;
                try { setIntCfg("groupsVer", GROUPS_VER); } catch (Throwable ignore) { }
            }
            if (!hasFoldState) {
                for (String[] grp0 : groups) collapsed.add(grp0[0]);
            }

            final java.util.List<Object[]> rows = new java.util.ArrayList<Object[]>();
            final Runnable[] rebuild = new Runnable[1];
            rebuild[0] = new Runnable() {
                @Override public void run() {
                    rows.clear();
                    String q = search.getText() == null ? "" : search.getText().toString().trim();
                    boolean filtering = q.length() > 0;
                    java.util.List<String[]> src = null;
                    if (!"全部".equals(scene[0])) {
                        src = new java.util.ArrayList<String[]>();
                        src.add(new String[]{scene[0] + "·能用", sceneKeys(scene[0])});
                    }
                    java.util.List<Object[]> ge = new java.util.ArrayList<Object[]>();
                    for (String[] grp : (src != null ? src : java.util.Arrays.asList(groups))) {
                        java.util.List<Integer> hit = new java.util.ArrayList<Integer>();
                        for (String k : grp[1].split(",")) {
                            if (isHidden(k.trim())) continue;
                            for (int i = 0; i < SETTINGS.length; i++) {
                                if (!SETTINGS[i][0].equals(k.trim())) continue;
                                if (filtering) {
                                    String label = SETTINGS[i][1] == null ? "" : SETTINGS[i][1];
                                    if (!label.toLowerCase().contains(q.toLowerCase())
                                            && !grp[0].toLowerCase().contains(q.toLowerCase())) continue;
                                }
                                hit.add(Integer.valueOf(i));
                                break;
                            }
                        }
                        if (filtering && hit.isEmpty()) continue;
                        boolean open = filtering || src != null || grp[0].equals(expanded[0]);
                        ge.add(new Object[]{grp[0], hit, Boolean.valueOf(open)});
                    }
                    for (int i = 0; i < ge.size(); i += 2) {
                        Object[] g1 = ge.get(i);
                        Object[] g2 = (i + 1 < ge.size()) ? ge.get(i + 1) : null;
                        rows.add(new Object[]{"GG", g1, g2});
                        for (int j = 0; j < 2; j++) {
                            Object[] gx = (j == 0) ? g1 : g2;
                            if (gx == null) continue;
                            if (!Boolean.TRUE.equals(gx[2])) continue;
                            if (!"群聊中心".equals(gx[0])) rows.add(new Object[]{"SH", gx[0]});
                            java.util.List<Integer> hit2 = (java.util.List<Integer>) gx[1];
                            boolean subOk = !filtering && "群聊中心".equals(gx[0]);
                            if (subOk) {
                                String[][] secs = groupSubSections();
                                for (String[] sec : secs) {
                                    java.util.List<Integer> sub = new java.util.ArrayList<Integer>();
                                    for (int si = 0; si < hit2.size(); si++) {
                                        Integer idx = hit2.get(si);
                                        String kk = SETTINGS[idx.intValue()][0];
                                        for (String c : sec[1].split(",")) {
                                            if (c.trim().equals(kk)) { sub.add(idx); break; }
                                        }
                                    }
                                    if (sub.isEmpty()) continue;
                                    rows.add(new Object[]{"SH", sec[0]});
                                    for (int ii = 0; ii < sub.size(); ii += 2) {
                                        Integer k1 = sub.get(ii);
                                        Integer k2 = (ii + 1 < sub.size()) ? sub.get(ii + 1) : null;
                                        rows.add(new Object[]{"II", k1, k2});
                                    }
                                }
                            } else {
                                for (int ii = 0; ii < hit2.size(); ii += 2) {
                                    Integer k1 = hit2.get(ii);
                                    Integer k2 = (ii + 1 < hit2.size()) ? hit2.get(ii + 1) : null;
                                    rows.add(new Object[]{"II", k1, k2});
                                }
                            }
                        }
                    }
                    if (filtering) {
                        java.util.List<Object[]> actRows = new java.util.ArrayList<Object[]>();
                        String ql = q.toLowerCase();
                        for (String[] ac : ACTION_INDEX) {
                            if (ac[0].toLowerCase().contains(ql)) actRows.add(new Object[]{"A", ac[0], ac[1]});
                        }
                        if (!actRows.isEmpty()) {
                            java.util.List<Object[]> merged = new java.util.ArrayList<Object[]>();
                            merged.add(new Object[]{"SH", "功能直达"});
                            merged.addAll(actRows);
                            merged.addAll(rows);
                            rows.clear();
                            rows.addAll(merged);
                        }
                    }
                }
            };

