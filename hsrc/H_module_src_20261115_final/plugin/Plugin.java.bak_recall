                .setTitle("恢复默认设置")
                .setMessage("所有开关恢复默认（防撤回、提醒、主题开启；作弊类关闭）")
                .setPositiveButton("确定", new android.content.DialogInterface.OnClickListener() {
                    @Override
                    public void onClick(android.content.DialogInterface d, int which) {
                        try {
                            JSONObject o = new JSONObject();
                            o.put("unrecallPlugin", true);
                            o.put("unrecallSysMsg", true);
                            o.put("keywordAlert", new org.json.JSONArray());
                            o.put("redPacketAlert", true);
                            o.put("groupAlert", true);
                            o.put("groupNoticeAlert", true);
                            o.put("quietStart", -1);
                            o.put("quietEnd", -1);
                            o.put("autoReply", false);
                            o.put("autoReplyText", "我在忙，稍后回复你");
                            o.put("dice", 0);
                            o.put("chatDoubleTap", true);
                            o.put("theme", true);
                            o.put("themePack", DIR + "/wxh_theme");
                            o.put("snsDoubleTap", true);
                            o.put("snsHideKeywords", new org.json.JSONArray());
                            o.put("snsHideNames", new org.json.JSONArray());
                            o.put("deviceSpoof", false);
                            o.put("autoAcceptFriend", false);
                            o.put("stepCount", 0);
                            o.put("fakeLat", 0);
                            o.put("fakeLng", 0);
                            writeCfg(o);
                            cfgAt = 0;
                            toast("已恢复默认");
                            showSettings(a);
                        } catch (Throwable t) {
                            toast("恢复失败");
                        }
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static void toggleAutoGrab(final android.app.Activity a, JSONObject c) {
        showGrabSetting(a);
    }

    /** 抢红包智能设置 */
    private static void showGrabSetting(final android.app.Activity a) {
        final boolean on = cfg().optBoolean("autoGrabRedPacket", false);
        int only = 0, skip = 0;
        try {
            org.json.JSONArray o1 = cfg().optJSONArray("grabOnly");
            only = o1 == null ? 0 : o1.length();
            org.json.JSONArray o2 = cfg().optJSONArray("grabSkip");
            skip = o2 == null ? 0 : o2.length();
        } catch (Throwable ignore) { }
        String delay = cfg().optString("grabDelay", "fast");
        String delayS = "fast".equals(delay) ? "快（0-0.8秒）" : ("mid".equals(delay) ? "中（1-4秒）" : "慢（3-8秒）");
        int cd = cfg().optInt("grabCooldown", 10);
        int pm = cfg().optInt("grabPerMin", 10);
        String hours = cfg().optString("grabHours", "all");
        String[] items = new String[]{
                "总开关：" + (on ? "开" : "关"),
                "只抢这些会话（已选 " + only + " 个，空=全部）",
                "跳过这些会话（已选 " + skip + " 个）",
                "随机延迟：" + delayS,
                "同一会话冷却：" + (cd <= 0 ? "关" : cd + " 秒"),
                "每分钟最多：" + (pm <= 0 ? "不限" : pm + " 个"),
                "生效时段：" + ("day".equals(hours) ? "8:00-23:00" : "全天"),
                "跳过专属红包：" + (cfg().optBoolean("grabSkipMine", true) ? "是" : "否"),
                "进聊天自动补抢旧红包：" + (cfg().optBoolean("claimExisting", true) ? "是" : "否"),
                "抢完自动关闭领取页：" + (cfg().optBoolean("grabAutoClose", true) ? "是" : "否"),
                "立即补抢当前聊天的红包",
                "新红包自动抢：" + (cfg().optBoolean("grabOnNew", true) ? "开（收到就抢，不用点进去）" : "关"),
                "后台补抢（不点进群也扫）：" + (cfg().optBoolean("grabOnBg", true) ? "开" : "关"),
                "私聊也补抢：" + (cfg().optBoolean("grabPrivate", true) ? "开" : "关")
        };
        new android.app.AlertDialog.Builder(a)
                .setTitle("抢红包")
                .setItems(items, new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int which) {
                        if (which == 0) { confirmGrabToggle(a, !on); return; }
                        if (which == 1) {
                            java.util.ArrayList<String> pre = new java.util.ArrayList<String>();
                            org.json.JSONArray c1 = cfg().optJSONArray("grabOnly");
                            if (c1 != null) for (int i = 0; i < c1.length(); i++) pre.add(c1.optString(i));
                            showTalkerPickerMulti(a, "只抢这些会话（可多选）", false, pre, new ChatPickMulti() {
                                @Override public void onPick(java.util.ArrayList<String[]> sel) {
                                    org.json.JSONArray out = new org.json.JSONArray();
                                    for (String[] e : sel) out.put(e[0]);
                                    setJsonCfg("grabOnly", out);
                                    showGrabSetting(a);
                                }
                            });
                            return;
                        }
                        if (which == 2) {
                            java.util.ArrayList<String> pre = new java.util.ArrayList<String>();
                            org.json.JSONArray c2 = cfg().optJSONArray("grabSkip");
                            if (c2 != null) for (int i = 0; i < c2.length(); i++) pre.add(c2.optString(i));
                            showTalkerPickerMulti(a, "跳过这些会话（可多选）", false, pre, new ChatPickMulti() {
                                @Override public void onPick(java.util.ArrayList<String[]> sel) {
                                    org.json.JSONArray out = new org.json.JSONArray();
                                    for (String[] e : sel) out.put(e[0]);
                                    setJsonCfg("grabSkip", out);
                                    showGrabSetting(a);
                                }
                            });
                            return;
                        }
                        if (which == 3) {
                            String cur = cfg().optString("grabDelay", "fast");
                            setStrCfg("grabDelay", "fast".equals(cur) ? "mid" : ("mid".equals(cur) ? "slow" : "fast"));
                            showGrabSetting(a);
                            return;
                        }
                        if (which == 4) {
                            int cur = cfg().optInt("grabCooldown", 10);
                            int nv = cur == 10 ? 30 : (cur == 30 ? 60 : (cur == 60 ? 0 : 10));
                            setIntCfg("grabCooldown", nv);
                            showGrabSetting(a);
                            return;
                        }
                        if (which == 5) {
                            int cur = cfg().optInt("grabPerMin", 10);
                            int nv = cur == 10 ? 20 : (cur == 20 ? 5 : (cur == 5 ? 0 : 10));
                            setIntCfg("grabPerMin", nv);
                            showGrabSetting(a);
                            return;
                        }
                        if (which == 6) {
                            setStrCfg("grabHours", "day".equals(cfg().optString("grabHours", "all")) ? "all" : "day");
                            showGrabSetting(a);
                            return;
                        }
                        if (which == 7) {
                            setOn("grabSkipMine", !cfg().optBoolean("grabSkipMine", true));
                            showGrabSetting(a);
                            return;
                        }
                        if (which == 8) {
                            setOn("claimExisting", !cfg().optBoolean("claimExisting", true));
                            showGrabSetting(a);
                            return;
                        }
                        if (which == 9) {
                            setOn("grabAutoClose", !cfg().optBoolean("grabAutoClose", true));
                            showGrabSetting(a);
                            return;
                        }
                        if (which == 13) {
                            setOn("grabPrivate", !cfg().optBoolean("grabPrivate", true));
                            showGrabSetting(a);
                            return;
                        }
                        if (which == 12) {
                            setOn("grabOnBg", !cfg().optBoolean("grabOnBg", true));
                            showGrabSetting(a);
                            return;
                        }
                        if (which == 11) {
                            setOn("grabOnNew", !cfg().optBoolean("grabOnNew", false));
                            showGrabSetting(a);
                            return;
                        }
                        if (which == 10) {
                            try {
                                android.app.Activity cur = chatAct != null ? chatAct
                                        : (topAct != null ? topAct : topActivityNow());
                                if (cur == null) { toast("请先打开一个聊天"); return; }
                                String tk = chatTalker;
                                if (tk == null) { toast("不在聊天页"); return; }
                                String why = grabSkipReason(tk, null);
                                if (why != null) { toast("当前会话被规则跳过：" + why); return; }
                                claimExistingPackets(cur);
                                toast("正在补抢…");
                            } catch (Throwable t) { toast("失败：" + t); }
                            return;
                        }
                    }
                })
                .setNegativeButton("关闭", null)
                .show();
    }

    private static void confirmGrabToggle(final android.app.Activity a, final boolean turnOn) {
        if (!turnOn) {
            setOn("autoGrabRedPacket", false);
            setOn("autoOpenRedPacket", false);
            toast("抢红包：关");
            showGrabSetting(a);
            return;
        }
        new android.app.AlertDialog.Builder(a)
                .setTitle("⚠ 风险提示")
                .setMessage("开启后会自动点开红包并代你点「开」领取。\n\n"
                        + "· 涉及资金操作，可能因网络或界面变化导致领取失败\n"
                        + "· 频繁自动领取可能触发微信风控\n"
                        + "· 建议设置随机延迟、冷却和每分钟上限，别抢太猛\n"
                        + "· 仅在本人设备、本人账号使用\n\n确定开启？")
                .setPositiveButton("确认开启", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        setOn("autoGrabRedPacket", true);
                        setOn("autoOpenRedPacket", true);
                        if (cfg().optString("grabPerMin", "10").length() == 0) setIntCfg("grabPerMin", 10);
                        toast("抢红包：开");
                        showGrabSetting(a);
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

