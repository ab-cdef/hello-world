    /** 高级搜索：关键词 + 仅当前会话 + 时间范围，结果可导出 CSV */
    private static void showAdvSearch(final android.app.Activity a) {
        try {
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 16), dp(a, 10), dp(a, 16), dp(a, 6));

            final android.widget.EditText kw = new android.widget.EditText(a);
            kw.setHint("关键词（留空=不限内容）");
            kw.setTextSize(13);
            box.addView(kw);

            final android.widget.CheckBox onlyCur = new android.widget.CheckBox(a);
            String curName = chatTalker == null ? "" : displayOfTalker(chatTalker);
            onlyCur.setText("只搜当前会话" + (curName.length() > 0 ? "（" + curName + "）" : "（未在聊天页，按全部）"));
            onlyCur.setChecked(chatTalker != null);
            box.addView(onlyCur);

            final String[] ranges = {"近 7 天", "近 30 天", "全部"};
            final long[] rangeMs = {7L * 86400000L, 30L * 86400000L, 0};
            final int[] pick = {1};
            android.widget.TextView rl = new android.widget.TextView(a);
            rl.setTextSize(12);
            rl.setTextColor(0xFF6B6B76);
            rl.setText("时间范围：近 30 天（点击切换）");
            rl.setPadding(0, dp(a, 8), 0, dp(a, 4));
            rl.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    pick[0] = (pick[0] + 1) % ranges.length;
                    ((android.widget.TextView) v).setText("时间范围：" + ranges[pick[0]] + "（点击切换）");
                }
            });
            box.addView(rl);

            new android.app.AlertDialog.Builder(a)
                    .setTitle("高级搜索")
                    .setView(box)
                    .setPositiveButton("搜索", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            final String k = kw.getText().toString().trim();
                            final boolean cur = onlyCur.isChecked() && chatTalker != null;
                            final long since = rangeMs[pick[0]] <= 0 ? 0
                                    : System.currentTimeMillis() - rangeMs[pick[0]];
                            new Thread(new Runnable() { @Override public void run() {
                                final int n = advSearchRun(a, k, cur, since);
                                log("ADVSEARCH|kw=" + k + " cur=" + cur + " n=" + n);
                            } }).start();
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) {
            toast("搜索面板出错：" + t);
        }
    }

    /** 执行高级搜索并展示/导出；返回命中条数 */
    private static int advSearchRun(final android.app.Activity a, String kw, boolean onlyCur, long sinceMs) {
        int n = 0;
        try {
            StringBuilder sql = new StringBuilder(
                    "select talker, createTime, ifnull(content,''), ifnull(isSend,0) from message where 1=1");
            if (kw != null && kw.length() > 0) sql.append(" and content like '%").append(escSql(kw)).append("%'");
            if (onlyCur && chatTalker != null) sql.append(" and talker='").append(escSql(chatTalker)).append("'");
            if (sinceMs > 0) sql.append(" and createTime > ").append(sinceMs);
            sql.append(" order by createTime desc limit 300");
            java.util.List<Object[]> rows = queryRows(sql.toString(), 4);
            final java.util.List<String[]> out = new java.util.ArrayList<String[]>();
            for (Object[] r : rows) {
                String tk = String.valueOf(r[0]);
                long ct = 0;
                try { ct = Long.parseLong(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                String c = String.valueOf(r[2]);
                if (c.length() > 80) c = c.substring(0, 80);
                boolean mine = "1".equals(String.valueOf(r[3]).trim());
                out.add(new String[]{String.valueOf(ct), displayOfTalker(tk), (mine ? "我：" : "") + c, tk});
            }
            n = out.size();
            // 无论有没有界面都导出 CSV（便于无界面验证 / 分享给同事）
            final String path = writeAdvCsv(kw, out);
            if (a == null) return n;
            final int fn = n;
            new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                @Override public void run() {
                    StringBuilder sb = new StringBuilder();
                    for (int i = 0; i < out.size() && i < 60; i++) {
                        String[] r = out.get(i);
                        sb.append(new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US)
                                        .format(new java.util.Date(Long.parseLong(r[0]))))
                                .append("  ").append(r[1]).append("：").append(r[2]).append("\n");
                    }
                    if (fn == 0) sb.append("没有匹配的消息");
                    new android.app.AlertDialog.Builder(a)
                            .setTitle("找到 " + fn + " 条")
                            .setMessage(sb.toString())
                            .setPositiveButton("关闭", null)
                            .setNeutralButton("已导出\n" + (path == null ? "失败" : "查看"), null)
                            .show();
                }
            });
        } catch (Throwable t) {
            log("ADVSEARCH|err " + t);
        }
        return n;
    }

    private static String writeAdvCsv(String kw, java.util.List<String[]> rows) {
        try {
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            java.io.File f = new java.io.File(dir, "search_" + stamp + ".csv");
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            fw.write("\uFEFF时间,会话,内容\n");
            for (String[] r : rows) {
                fw.write(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                        .format(new java.util.Date(Long.parseLong(r[0]))) + ","
                        + csv(r[1]) + "," + csv(r[2]) + "\n");
            }
            fw.close();
            log("ADVCSV|n=" + rows.size() + " path=" + f.getAbsolutePath());
            return f.getAbsolutePath();
        } catch (Throwable t) {
            log("ADVCSV|err " + t);
            return null;
        }
    }

    private static void searchMessages(final android.app.Activity a) {
        final android.widget.EditText et = new android.widget.EditText(a);
        et.setHint("输入关键词");
        new android.app.AlertDialog.Builder(a)
                .setTitle("搜索聊天记录")
                .setView(et)
                .setPositiveButton("搜索", new android.content.DialogInterface.OnClickListener() {
                    @Override
                    public void onClick(android.content.DialogInterface d, int w) {
                        final String kw = et.getText().toString().trim();
                        if (kw.length() == 0) { toast("请输入关键词"); return; }
                            new Thread(new Runnable() {
                            @Override
                            public void run() {
                                try {
                                    Object db = dbRef;
                                    if (db == null) {
                                        toast("数据库未就绪");
                                        return;
                                    }
                                    loadNameMap(db);
                                    Object cur = null;
                                    for (Method m : db.getClass().getMethods()) {
                                        if (!m.getName().equals("rawQuery")) continue;
                                        Class<?>[] ps = m.getParameterTypes();
                                        if (ps.length != 2 || ps[0] != String.class) continue;
                                        Object arg = (ps[1] == String[].class)
                                                ? new String[]{"%" + kw + "%"} : new Object[]{"%" + kw + "%"};
                                        m.setAccessible(true);
                                        cur = m.invoke(db, "select talker,createTime,content,msgId from message "
                                                + "where content like ? order by createTime desc limit 200", arg);
                                        break;
                                    }
                                    if (cur == null) return;
                                    final java.util.List<String[]> rows = new java.util.ArrayList<String[]>();
                                    Method mv = cur.getClass().getMethod("moveToNext");
                                    Method gs = cur.getClass().getMethod("getString", int.class);
                                    Method gl = cur.getClass().getMethod("getLong", int.class);
                                    while ((Boolean) mv.invoke(cur) && rows.size() < 200) {
                                        String talker = (String) gs.invoke(cur, 0);
                                        long t = (Long) gl.invoke(cur, 1);
                                        String c = (String) gs.invoke(cur, 2);
                                        long mid2 = 0;
                                        try { mid2 = (Long) gl.invoke(cur, 3); } catch (Throwable ignore) { }
                                        final long fMid = mid2;
                                        String who = nameMap.get(talker);
                                        if (who == null) who = talker == null ? "?" : talker;
                                        if (talker != null && talker.endsWith("@chatroom")) who += "（群）";
                                        String time = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss")
                                                .format(new java.util.Date(t * 1000));
                                        rows.add(new String[]{who, time, prettyContent(c), talker, String.valueOf(fMid)});
                                    }
                                    try {
                                        cur.getClass().getMethod("close").invoke(cur);
                                    } catch (Throwable t) {
                                    }
                                    log("SEARCH|" + kw + "|" + rows.size());
                                    a.runOnUiThread(new Runnable() {
                                        @Override
                                        public void run() {
                                            showSearchResults(a, rows, kw);
                                        }
                                    });
                                } catch (Throwable t) {
                                    log("search err " + t);
                                }
                            }
                        }).start();
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    /** 把关键词用黄底标出来 */
    private static CharSequence highlight(String text, String kw) {
        if (text == null) return "";
        if (kw == null || kw.length() == 0) return text;
        try {
            android.text.SpannableString sp = new android.text.SpannableString(text);
            String lowT = text.toLowerCase();
            String lowK = kw.toLowerCase();
            int from = 0;
            int hits = 0;
            while (hits < 30) {
                int i = lowT.indexOf(lowK, from);
                if (i < 0) break;
                sp.setSpan(new android.text.style.BackgroundColorSpan(0xFFFFE066),
                        i, i + kw.length(), android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
                sp.setSpan(new android.text.style.ForegroundColorSpan(0xFF1A1A1E),
                        i, i + kw.length(), android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
                from = i + kw.length();
                hits++;
            }
            return sp;
        } catch (Throwable t) { return text; }
    }

    private static void showSearchResults(final android.app.Activity a,
                                          final java.util.List<String[]> rows, final String kw) {
        try {
            android.app.Dialog dlg = new android.app.Dialog(a);
            dlg.requestWindowFeature(android.view.Window.FEATURE_NO_TITLE);
            android.widget.LinearLayout root = new android.widget.LinearLayout(a);
            root.setOrientation(android.widget.LinearLayout.VERTICAL);
            root.setBackgroundColor(0xFF0E0E12);
            int pad = 30;
            root.setPadding(pad, pad, pad, pad);
            android.widget.TextView t1 = new android.widget.TextView(a);
            t1.setText("搜索「" + kw + "」 · " + rows.size() + " 条");
            t1.setTextColor(0xFFFFFFFF);
            t1.setTextSize(16);
            root.addView(t1);

            android.widget.ListView lv = new android.widget.ListView(a);
            lv.setBackgroundColor(0xFF0E0E12);
            lv.setCacheColorHint(0xFF0E0E12);
            lv.setDivider(null);
            lv.setDividerHeight(0);
            root.addView(lv, new android.widget.LinearLayout.LayoutParams(-1, 0, 1f));
            lv.setAdapter(new android.widget.BaseAdapter() {
                @Override
                public int getCount() {
                    return rows.size();
                }

                @Override
                public Object getItem(int position) {
                    return rows.get(position);
                }

                @Override
                public long getItemId(int position) {
                    return position;
                }

                @Override
                public View getView(int position, View convertView, ViewGroup parent) {
                    String[] r = rows.get(position);
                    android.widget.LinearLayout box = new android.widget.LinearLayout(a);
                    box.setOrientation(android.widget.LinearLayout.VERTICAL);
                    box.setBackgroundColor(0xFF1A1A22);
                    box.setPadding(24, 22, 24, 22);
                    android.widget.TextView head = new android.widget.TextView(a);
                    head.setText(r[1] + "   " + r[0]);
                    head.setTextColor(0xFF4CC38A);
                    head.setTextSize(13);
                    android.widget.TextView body = new android.widget.TextView(a);
                    body.setTextColor(0xFFF5F5F7);
                    body.setTextSize(14);
                    // 关键词高亮：命中处用黄底黑字
                    try {
                        body.setText(highlight(r[2], kw));
                    } catch (Throwable ignore) {
                        body.setText(r[2]);
                    }
                    box.addView(head);
                    box.addView(body);
                    return box;
                }
            });
            lv.setOnItemClickListener(new android.widget.AdapterView.OnItemClickListener() {
                @Override
                public void onItemClick(android.widget.AdapterView<?> p1, View v, int position, long id) {
                    String talker = rows.get(position)[3];
                    try {
                        android.content.Intent it = new android.content.Intent();
                        it.setClassName(a.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
                        it.putExtra("Chat_User", resolveTalker(talker));
                        try {
                            String ms = rows.get(position).length > 4 ? rows.get(position)[4] : null;
                            if (ms != null) {
                                long mid4 = Long.parseLong(ms);
                                if (mid4 > 0) it.putExtra("Chat_Msg_Id", mid4);
                            }
                        } catch (Throwable ignore) { }
                        android.content.Intent _csw = prepareChatSwitch(a, it);
                        if (_csw != null) a.startActivity(_csw);
                        dlg.dismiss();
                        log("SEARCH|jump " + talker);
                    } catch (Throwable t) {
                        log("jump err " + t);
                        toast("跳转失败");
                    }
                }
            });
            android.widget.TextView close = new android.widget.TextView(a);
            close.setText("关闭");
            close.setTextColor(0xFFE23636);
            close.setTextSize(15);
            close.setGravity(android.view.Gravity.CENTER);
            close.setPadding(0, 20, 0, 10);
            close.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    dlg.dismiss();
                }
            });
            root.addView(close);
            root.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                @Override public boolean onLongClick(android.view.View v) {
                    zombieMap.clear();
                    zSel.clear();
                    zSave();
                    zRebuild();
                    toast("已清空检测结果");
                    return true;
                }
            });
            dlg.setContentView(root);
            android.view.Window w2 = dlg.getWindow();
            if (w2 != null) {
                w2.setBackgroundDrawable(roundRect(0xFF0E0E12, 36));
                android.view.WindowManager.LayoutParams wl = w2.getAttributes();
                wl.width = (int) (a.getResources().getDisplayMetrics().widthPixels * 0.94f);
                wl.height = (int) (a.getResources().getDisplayMetrics().heightPixels * 0.8f);
                w2.setAttributes(wl);
            }
            dlg.show();
        } catch (Throwable t) {
            log("showSearchResults err " + t);
        }
    }

    private static void showLog(final android.app.Activity a, String title, String file, int maxLines) {
        try {
            java.io.File f = new java.io.File(DIR, file);
            if (!f.isFile()) {
                toast("还没有记录");
                return;
            }
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.InputStreamReader(
                    new java.io.FileInputStream(f), "UTF-8"));
            java.util.ArrayList<String> lines = new java.util.ArrayList<String>();
            String line;
            while ((line = br.readLine()) != null) lines.add(line);
            br.close();
            int from = Math.max(0, lines.size() - maxLines);
            StringBuilder sb = new StringBuilder();
            for (int i = from; i < lines.size(); i++) sb.append(lines.get(i)).append('\n');
            if (lines.size() > maxLines) sb.insert(0, "（最近 " + maxLines + " 条，共 " + lines.size() + "）\n\n");
            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            android.widget.TextView tv = new android.widget.TextView(a);
            tv.setText(sb.toString());
            tv.setTextSize(12);
            tv.setTextColor(0xFFDDDDDD);
            tv.setPadding(40, 40, 40, 40);
            sv.addView(tv);
            new android.app.AlertDialog.Builder(a)
                    .setTitle(title)
                    .setView(sv)
                    .setPositiveButton("关闭", null)
                    .show();
        } catch (Throwable t) {
            log("showLog err " + t);
        }
    }


