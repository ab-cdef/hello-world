                        new android.app.AlertDialog.Builder(a)
                                .setTitle("群成员变动")
                                .setMessage(n + " 条记录\n\n"
                                        + (path[0] == null ? "没有记录或导出失败" : path[0]))
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    /** 导出完成后弹一个「分享」询问（后台线程也可调用） */
    private static void askShare(final java.io.File f) {
        try {
            if (f == null || !f.isFile()) return;
            final android.app.Activity host = mainAct != null ? mainAct : chatAct;
            if (host == null) return;
            new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                @Override public void run() {
                    showFilePreview(host, f);
                }
            });
        } catch (Throwable ignore) { }
    }

    /** 通用：弹窗显示文本，可复制/另存 */
    /** 把所有 wxid / 内部 id 从展示文本里抹掉，只留人名 */
    private static String stripIds(String s) {
        if (s == null) return "";
        try {
            s = s.replaceAll("wxid_[A-Za-z0-9_\\-]+", "");
            s = s.replaceAll("\\d+@chatroom", "");
            s = s.replaceAll("\\s{2,}", "  ");
            s = s.replaceAll("[(（]\\s*[)）]", "");
            s = s.replaceAll("[·|]\\s*$", "");
            return s;
        } catch (Throwable t) {
            return s;
        }
    }

    private static void showTextDialog(final android.app.Activity host, final String title,
                                       final String rawText, final String suggestName) {
        final String text = stripIds(rawText);
        try {
            android.widget.TextView tv = new android.widget.TextView(host);
            tv.setText(text);
            tv.setTextSize(12);
            tv.setTypeface(android.graphics.Typeface.MONOSPACE);
            tv.setTextColor(0xFF141418);
            tv.setTextIsSelectable(true);
            int pad = dp(host, 12);
            tv.setPadding(pad, pad, pad, pad);
            android.widget.ScrollView sv = new android.widget.ScrollView(host);
            sv.addView(tv);
            new android.app.AlertDialog.Builder(host)
                    .setTitle(title)
                    .setView(sv)
                    .setPositiveButton("复制", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                        host.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", text));
                                toast("已复制 " + text.length() + " 字");
                            } catch (Throwable t) { toast("复制失败"); }
                        }
                    })
                    .setNeutralButton("导出本地", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                java.io.File dir = new java.io.File(android.os.Environment
                                        .getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
                                if (!dir.exists()) dir.mkdirs();
                                java.io.File f = new java.io.File(dir, suggestName == null
                                        ? ("wxh_" + System.currentTimeMillis() + ".txt") : suggestName);
                                java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
                                fo.write(text.getBytes("UTF-8"));
                                fo.close();
                                toast("已导出：" + f.getName() + "\nDownload/wxh");
                            } catch (Throwable t) { toast("保存失败：" + t); }
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { log("TEXTDLG|err " + t); }
    }

    /** 按显示宽度补齐（中文算 2 格） */
    private static int dispLen(String s) {
        if (s == null) return 0;
        int n = 0;
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            n += (c > 0x2E80) ? 2 : 1;
        }
        return n;
    }

    private static String padRight(String s, int w) {
        StringBuilder sb = new StringBuilder(s == null ? "" : s);
        int d = w - dispLen(s);
        for (int i = 0; i < d; i++) sb.append(' ');
        return sb.toString();
    }

    /** 直接弹窗显示导出内容（文本类），带复制/分享 */
    private static void showFilePreview(final android.app.Activity host, final java.io.File f) {
        try {
            String name = f.getName().toLowerCase();
            boolean text = name.endsWith(".csv") || name.endsWith(".txt") || name.endsWith(".md")
                    || name.endsWith(".json") || name.endsWith(".log");
            if (!text) {
                new android.app.AlertDialog.Builder(host)
                        .setTitle("导出完成")
                        .setMessage(f.getName())
                        .setPositiveButton("分享", new android.content.DialogInterface.OnClickListener() {
                            @Override public void onClick(android.content.DialogInterface d, int w) {
                                shareExported(host, f);
                            }
                        })
                        .setNegativeButton("关闭", null)
                        .show();
                return;
            }
            String content = readHead(f, 200 * 1024);
            final android.widget.TextView tv = new android.widget.TextView(host);
            tv.setText(content);
            tv.setTextSize(12);
            tv.setTypeface(android.graphics.Typeface.MONOSPACE);
            tv.setTextColor(0xFF141418);
            tv.setTextIsSelectable(true);
            int pad = dp(host, 12);
            tv.setPadding(pad, pad, pad, pad);
            android.widget.ScrollView sv = new android.widget.ScrollView(host);
            sv.addView(tv);
            final String all = content;
            new android.app.AlertDialog.Builder(host)
                    .setTitle(f.getName())
                    .setView(sv)
                    .setPositiveButton("复制", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                        host.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", all));
                                toast("已复制 " + all.length() + " 字");
                            } catch (Throwable t) { toast("复制失败"); }
                        }
                    })
                    .setNeutralButton("分享", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            shareExported(host, f);
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { log("PREVIEW|err " + t); }
    }

    /** 读文件开头若干字节 */
    private static String readHead(java.io.File f, int max) {
        try {
            long len = f.length();
            int n = (int) Math.min(len, max);
            byte[] b = new byte[n];
            java.io.FileInputStream in = new java.io.FileInputStream(f);
            int got = 0;
            while (got < n) {
                int r = in.read(b, got, n - got);
                if (r <= 0) break;
                got += r;
            }
            in.close();
            String s2 = new String(b, 0, got, "UTF-8");
            if (s2.startsWith("\uFEFF")) s2 = s2.substring(1);
            if (len > max) s2 = s2 + "\n\n…（文件较大，只显示前 200KB，共 " + (len / 1024) + "KB）";
            return s2;
        } catch (Throwable t) { return "读取失败：" + t; }
    }



    /** 通过 MediaStore 找到导出的文件并发起系统分享 */
    private static boolean shareExported(android.app.Activity a, java.io.File f) {
        try {
            if (a == null || f == null || !f.isFile()) return false;
            String name = f.getName();
            android.net.Uri uri = null;
            try {
                android.database.Cursor c = a.getContentResolver().query(
                        android.provider.MediaStore.Downloads.EXTERNAL_CONTENT_URI,
                        new String[]{android.provider.MediaStore.MediaColumns._ID},
                        android.provider.MediaStore.MediaColumns.DISPLAY_NAME + "=?",
                        new String[]{name}, android.provider.MediaStore.MediaColumns.DATE_MODIFIED + " DESC");
                if (c != null) {
                    if (c.moveToFirst()) {
                        long id = c.getLong(0);
                        uri = android.content.ContentUris.withAppendedId(
                                android.provider.MediaStore.Downloads.EXTERNAL_CONTENT_URI, id);
                    }
                    c.close();
                }
            } catch (Throwable ignore) { }
            if (uri == null) {
                // 退路：用 file:// 分享（部分应用可读）
                uri = android.net.Uri.fromFile(f);
            }
            android.content.Intent it = new android.content.Intent(android.content.Intent.ACTION_SEND);
            String nm = name.toLowerCase();
            String mime = nm.endsWith(".csv") ? "text/csv"
                    : nm.endsWith(".md") ? "text/markdown"
                    : nm.endsWith(".jsonl") || nm.endsWith(".txt") || nm.endsWith(".log") ? "text/plain"
                    : nm.endsWith(".zip") ? "application/zip"
                    : nm.endsWith(".png") ? "image/png"
                    : nm.endsWith(".jpg") || nm.endsWith(".jpeg") ? "image/jpeg"
                    : nm.endsWith(".mp4") ? "video/mp4"
                    : "*/*";
            it.setType(mime);
            it.putExtra(android.content.Intent.EXTRA_STREAM, uri);
            it.putExtra(android.content.Intent.EXTRA_SUBJECT, name);
            it.addFlags(android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION);
            a.startActivity(android.content.Intent.createChooser(it, "分享 " + name));
            log("SHARE|" + name + " uri=" + uri);
            return true;
        } catch (Throwable t) {
            log("SHARE|err " + t);
            return false;
        }
    }

    /** 反射取当前顶部 Activity（不依赖内部静态字段） */
    private static android.app.Activity topActivityNow() {
        try {
            Class<?> at = Class.forName("android.app.ActivityThread");
            Object th = at.getMethod("currentActivityThread").invoke(null);
            if (th == null) return null;
            java.lang.reflect.Field f = at.getDeclaredField("mActivities");
            f.setAccessible(true);
            java.util.Map<?, ?> map = (java.util.Map<?, ?>) f.get(th);
            if (map == null) return null;
            android.app.Activity best = null;
            for (Object rec : map.values()) {
                if (rec == null) continue;
                java.lang.reflect.Field af = rec.getClass().getDeclaredField("activity");
                af.setAccessible(true);
                Object a = af.get(rec);
                if (!(a instanceof android.app.Activity)) continue;
                android.app.Activity aa = (android.app.Activity) a;
                if (aa.isFinishing() || aa.isDestroyed()) continue;
                try {
                    if (!aa.hasWindowFocus()) { if (best == null) best = aa; continue; }
                } catch (Throwable ignore) { }
                best = aa;
            }
            return best;
        } catch (Throwable t) { return null; }
    }

