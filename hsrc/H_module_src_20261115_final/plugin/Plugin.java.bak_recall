    private static void showWeeklySetting(final android.app.Activity a) {
        boolean on = cfg().optBoolean("weeklyOn", false);
        org.json.JSONArray gs = cfg().optJSONArray("weeklyGroups");
        int n = gs == null ? 0 : gs.length();
        long last = cfg().optLong("weeklyLastAt", 0);
        String lastS = last > 0
                ? new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US).format(new java.util.Date(last))
                : "还没推送过";
        new android.app.AlertDialog.Builder(a)
                .setTitle("群活跃周报")
                .setMessage("当前：" + (on ? "开（每 7 天推送一次）" : "关")
                        + "\n统计群：" + n + " 个" + "\n上次推送：" + lastS)
                .setPositiveButton(on ? "关闭" : "开启", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        setOn("weeklyOn", !cfg().optBoolean("weeklyOn", false));
                        showWeeklySetting(a);
                    }
                })
                .setNeutralButton("加入当前群", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        String tk = chatTalker;
                        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
                        org.json.JSONArray arr = cfg().optJSONArray("weeklyGroups");
                        if (arr == null) arr = new org.json.JSONArray();
                        for (int i = 0; i < arr.length(); i++) {
                            if (tk.equals(arr.optString(i))) { toast("已在该列表中"); return; }
                        }
                        arr.put(tk);
                        setJsonCfg("weeklyGroups", arr);
                        toast("已加入周报：" + displayOfTalker(tk));
                        showWeeklySetting(a);
                    }
                })
                .setNegativeButton("立即推送", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        setLongCfg("weeklyLastAt", 0);
                        toast("下次后台检查时会推送");
                    }
                })
                .show();
    }

    /** 关键词提醒管理：增删关键词 */
    private static void showKeywordManager(final android.app.Activity a) {
        try {
            org.json.JSONArray kw = cfg().optJSONArray("keywordAlert");
            final java.util.ArrayList<String> list = new java.util.ArrayList<String>();
            if (kw != null) for (int i = 0; i < kw.length(); i++) list.add(kw.optString(i, ""));
            int n = list.size();
            list.add("＋ 新增关键词");
            new android.app.AlertDialog.Builder(a)
                    .setTitle("关键词提醒（" + n + " 个）")
                    .setItems(list.toArray(new String[0]), new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int which) {
                            if (which == list.size() - 1) {
                                final android.widget.EditText et = new android.widget.EditText(a);
                                et.setHint("输入关键词，命中就推通知");
                                new android.app.AlertDialog.Builder(a)
                                        .setTitle("新增关键词")
                                        .setView(et)
                                        .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                                            @Override public void onClick(android.content.DialogInterface d2, int w2) {
                                                String k = et.getText().toString().trim();
                                                if (k.length() == 0) return;
                                                org.json.JSONArray arr = cfg().optJSONArray("keywordAlert");
                                                if (arr == null) arr = new org.json.JSONArray();
                                                arr.put(k);
                                                setJsonCfg("keywordAlert", arr);
                                                toast("已添加：" + k);
                                                showKeywordManager(a);
                                            }
                                        })
                                        .setNegativeButton("取消", null).show();
                                return;
                            }
                            final int idx = which;
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle(list.get(idx))
                                    .setItems(new String[]{"删除这个关键词"}, new android.content.DialogInterface.OnClickListener() {
                                        @Override public void onClick(android.content.DialogInterface d2, int w2) {
                                            org.json.JSONArray arr = cfg().optJSONArray("keywordAlert");
                                            if (arr == null) return;
                                            org.json.JSONArray out = new org.json.JSONArray();
                                            for (int i = 0; i < arr.length(); i++) {
                                                if (i != idx) out.put(arr.optString(i, ""));
                                            }
                                            setJsonCfg("keywordAlert", out);
                                            toast("已删除");
                                            showKeywordManager(a);
                                        }
                                    }).setNegativeButton("返回", null).show();
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { log("KWMGR|err " + t); }
    }

    /** 关键词回复规则管理：按顺序匹配，先命中先用 */
    private static void showRuleManager(final android.app.Activity a) {
        try {
            org.json.JSONArray rules = cfg().optJSONArray("autoReplyRules");
            final java.util.ArrayList<String> list = new java.util.ArrayList<String>();
            if (rules != null) for (int i = 0; i < rules.length(); i++) list.add(rules.optString(i, ""));
            list.add("＋ 新增规则");
            String[] items = list.toArray(new String[0]);
            new android.app.AlertDialog.Builder(a)
                    .setTitle("关键词自动回复（按顺序匹配，共 " + (list.size() - 1) + " 条）")
                    .setItems(items, new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int which) {
                            if (which == list.size() - 1) { addRule(a); return; }
                            final int idx = which;
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle(list.get(idx))
                                    .setItems(new String[]{"修改", "删除", "上移（提高优先级）"},
                                            new android.content.DialogInterface.OnClickListener() {
                                        @Override public void onClick(android.content.DialogInterface d2, int w2) {
                                            org.json.JSONArray arr = cfg().optJSONArray("autoReplyRules");
                                            if (arr == null) arr = new org.json.JSONArray();
                                            try {
                                                if (w2 == 0) { editRule(a, idx); return; }
                                                org.json.JSONArray out = new org.json.JSONArray();
                                                for (int i = 0; i < arr.length(); i++) {
                                                    if (i != idx) out.put(arr.optString(i, ""));
                                                }
                                                setJsonCfg("autoReplyRules", out);
                                                toast("已删除");
                                                showRuleManager(a);
                                            } catch (Throwable t) { toast("操作失败"); }
                                        }
                                    }).setNegativeButton("返回", null).show();
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { log("RULE|err " + t); }
    }

    private static void addRule(final android.app.Activity a) {
        final android.widget.EditText k = new android.widget.EditText(a);
        k.setHint("关键词，例如：价格");
        final android.widget.EditText v = new android.widget.EditText(a);
        v.setHint("回复内容，例如：稍等，我发你报价单");
        android.widget.LinearLayout box = new android.widget.LinearLayout(a);
        box.setOrientation(android.widget.LinearLayout.VERTICAL);
        box.setPadding(dp(a, 16), dp(a, 8), dp(a, 16), dp(a, 8));
        box.addView(k);
        box.addView(v);
        new android.app.AlertDialog.Builder(a)
                .setTitle("新增回复规则")
                .setView(box)
                .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        String kk = k.getText().toString().trim();
                        String vv = v.getText().toString().trim();
                        if (kk.length() == 0 || vv.length() == 0) { toast("关键词和回复都要填"); return; }
                        org.json.JSONArray arr = cfg().optJSONArray("autoReplyRules");
                        if (arr == null) arr = new org.json.JSONArray();
                        arr.put(kk + "=" + vv);
                        setJsonCfg("autoReplyRules", arr);
                        toast("已添加");
                        showRuleManager(a);
                    }
                })
                .setNegativeButton("取消", null).show();
    }

    private static void editRule(final android.app.Activity a, final int idx) {
        org.json.JSONArray arr = cfg().optJSONArray("autoReplyRules");
        if (arr == null || idx >= arr.length()) return;
        String raw = arr.optString(idx, "");
        int eq = raw.indexOf('=');
        String kk = eq > 0 ? raw.substring(0, eq) : raw;
        String vv = eq > 0 ? raw.substring(eq + 1) : "";
        final android.widget.EditText k = new android.widget.EditText(a);
        k.setText(kk);
        final android.widget.EditText v = new android.widget.EditText(a);
        v.setText(vv);
        android.widget.LinearLayout box = new android.widget.LinearLayout(a);
        box.setOrientation(android.widget.LinearLayout.VERTICAL);
        box.setPadding(dp(a, 16), dp(a, 8), dp(a, 16), dp(a, 8));
        box.addView(k);
        box.addView(v);
        new android.app.AlertDialog.Builder(a)
                .setTitle("修改规则")
                .setView(box)
                .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        org.json.JSONArray arr2 = cfg().optJSONArray("autoReplyRules");
                        if (arr2 == null) return;
                        try {
                            arr2.put(idx, k.getText().toString().trim() + "=" + v.getText().toString().trim());
                            setJsonCfg("autoReplyRules", arr2);
                            toast("已保存");
                            showRuleManager(a);
                        } catch (Throwable t) { toast("保存失败"); }
                    }
                })
                .setNegativeButton("取消", null).show();
    }

    private static void autoReply(final String talker) {
        try {
            if (!cfg().optBoolean("autoReply", false)) return;

            // ① 防串聊：当前打开的不是这个会话就跳过。
            //    以前会把回复打得别的聊天里（在 A 群收到消息、回复却发到 B 群），必须挡掉。
            if (chatTalker == null || !chatTalker.equals(talker)) {
                log("AUTOREPLY|skip not-open " + talker);
                return;
            }

            // ② 防死循环：对方发来的正是我们刚自动回的那句，不再回
            String incoming = lastIncomingText == null ? "" : lastIncomingText;
            String mine = arLastText.get(talker);
            if (mine != null && mine.length() > 0 && incoming.contains(mine)) {
                log("AUTOREPLY|skip echo");
                return;
            }

            // ③ 冷却：同一会话 N 秒内只回一次
            int cd = cfg().optInt("autoReplyCooldown", 60);
            Long lastAt = arLastAt.get(talker);
            long nowMs = System.currentTimeMillis();
            if (cd > 0 && lastAt != null && nowMs - lastAt < cd * 1000L) {
                log("AUTOREPLY|skip cooldown " + ((nowMs - lastAt) / 1000) + "s/" + cd + "s");
                return;
            }

            // ④ 群聊只在被 @ 时才回（避免在群里刷屏）
            if (talker.endsWith("@chatroom") && cfg().optBoolean("autoReplyAtOnly", true)) {
                String myId = cfg().optString("myWxid", "");
                boolean atMe = incoming.indexOf("@") >= 0
                        && (myId.length() == 0 || incoming.contains(myId)
                            || incoming.contains("@" + cfg().optString("myNick", "")));
                if (!atMe) { log("AUTOREPLY|skip group-no-at"); return; }
            }

            org.json.JSONArray only = cfg().optJSONArray("autoReplyOnly");
            if (only != null && only.length() > 0) {
                boolean ok = false;
                for (int i = 0; i < only.length(); i++) {
                    if (talker.equals(only.optString(i))) { ok = true; break; }
                }
                if (!ok) return;
            }
            String text = cfg().optString("autoReplyText", "我在忙，稍后回复你");
            // 关键词规则：autoReplyRules = ["在吗=在的", "价格=稍等发你"]
            try {
                org.json.JSONArray rules = cfg().optJSONArray("autoReplyRules");
                String last = lastIncomingText;
                if (rules != null && last != null) {
                    for (int i = 0; i < rules.length(); i++) {
                        String r = rules.optString(i, "");
                        int eq = r.indexOf('=');
                        if (eq <= 0) continue;
                        String k = r.substring(0, eq).trim();
                        String v = r.substring(eq + 1).trim();
                        if (k.length() > 0 && last.contains(k) && v.length() > 0) {
                            text = v;
                            log("AUTOREPLY|rule " + k);
                            break;
                        }
                    }
                }
            } catch (Throwable t) {
            }
            if (text.length() == 0) return;
            final String replyText = text;
            final android.app.Activity a = chatAct;
            if (a == null) return;
            int delaySec = cfg().optInt("autoReplyDelay", 0);
            if (delaySec < 0) delaySec = 0;
            if (delaySec > 60) delaySec = 60;
            final Runnable doSend = new Runnable() {
                @Override
                public void run() {
                    try {
                        View root = a.getWindow().getDecorView();
                        android.widget.EditText et = findEditText(root);
                        if (et == null) {
                            log("AUTOREPLY|no edittext");
                            return;
                        }
                        et.setText(replyText);
                        View btn = findSendButton(root);
                        if (btn == null) {
                            log("AUTOREPLY|no send button");
                            return;
                        }
                        btn.performClick();
                        arLastAt.put(talker, Long.valueOf(System.currentTimeMillis()));
                        arLastText.put(talker, replyText);
                        log("AUTOREPLY|sent to " + talker);
                    } catch (Throwable t) {
                        log("AUTOREPLY err " + t);
                    }
                }
            };
            if (delaySec <= 0) {
                a.runOnUiThread(doSend);
            } else {
                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(doSend, delaySec * 1000L);
                log("AUTOREPLY|delay " + delaySec + "s");
            }
        } catch (Throwable t) {
            log("autoReply err " + t);
        }
    }

    /** 防撤回白名单：配置为空则全部生效 */
    private static boolean revokeAllowed(String talker) {
        try {
            org.json.JSONArray only = cfg().optJSONArray("unrecallOnly");
            if (only == null || only.length() == 0) return true;
            for (int i = 0; i < only.length(); i++) {
                if (talker != null && talker.equals(only.optString(i))) return true;
            }
            return false;
        } catch (Throwable t) {
            return true;
        }
    }

    private static synchronized boolean fresh(String key) {
        long now = System.currentTimeMillis();
        Long last = recent.get(key);
        if (last != null && now - last < 15000) return false;
        recent.put(key, now);
        if (recent.size() > 200) {
            java.util.Iterator<java.util.Map.Entry<String, Long>> it = recent.entrySet().iterator();
            while (it.hasNext()) {
                if (now - it.next().getValue() > 60000) it.remove();
            }
        }
        return true;
    }

    static synchronized void log(String s) {
        try {
            if (logSize > 4 * 1024 * 1024) {
                logSize = 0;
                out = null;
                new File(LOG).delete();
            }
            if (s != null) logSize += s.length();
            if (s != null && s.startsWith("hooked")) hookCount++;
            if (out == null) {
                new File(DIR).mkdirs();
                out = new FileOutputStream(LOG, true);
            }
            out.write((s + "\n").getBytes("UTF-8"));
            out.flush();
        } catch (Throwable t) {
        }
        XposedBridge.log("WXH_PLUGIN " + s);
    }

    private static JSONObject cfg;
    private static long cfgAt;

    private static long cfgChkAt = 0;
    private static boolean forceSeenLogged = false;
    private static boolean fmsgMissingLogged = false;

    /** 分身/双开：/sdcard 在自己用户下是空的，主号文件在 emulated/0，逐个试 */
    private static File forceFile() {
        String[] cand = new String[]{
                "/storage/emulated/0/.wxh_config_force",
                "/sdcard/.wxh_config_force",
        };
        for (String p : cand) {
            try {
                File f = new File(p);
                if (f.isFile() && f.length() > 0) return f;
            } catch (Throwable ignore) { }
        }
        return new File(cand[0]);
    }

    private static synchronized JSONObject cfg() {
        long nowMs = System.currentTimeMillis();
        if (cfg != null && nowMs - cfgChkAt < 500) return cfg;   // 500ms 内不重复 stat
        cfgChkAt = nowMs;
        File f = new File(DIR, "wxh_config.json");
        // 主号（或面板“同步到分身”）在 sdcard 放了 .wxh_config_force 时，
        // 分身把自己的配置整份替换成它——分身进程写自己目录有权限，root 没有
        try {
            File force = null;   // 分身专项链路已移除：不再用 sdcard 文件整份覆盖本机配置
            long sig = 0L;
            String stamp = null;
            try {
                File st = new File(DIR, "wxh_cfgsync.stamp");
                if (st.isFile()) {
                    byte[] sb2 = new byte[(int) st.length()];
                    java.io.FileInputStream s2 = new java.io.FileInputStream(st);
                    int n2 = s2.read(sb2); s2.close();
                    stamp = new String(sb2, 0, Math.max(n2, 0), "UTF-8").trim();
                }
            } catch (Throwable ignore) { }
            if (force.isFile() && force.length() > 0 && !forceSeenLogged) {
                forceSeenLogged = true;
                log("CFG|force seen " + force.getAbsolutePath() + " len=" + force.length());
            }
            if (force.isFile() && force.length() > 0
                    && !String.valueOf(sig).equals(stamp)) {
                byte[] fb = new byte[(int) force.length()];
                java.io.FileInputStream fi = new java.io.FileInputStream(force);
                int fn = fi.read(fb);
                fi.close();
                if (fn > 0) {
                    java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
                    fo.write(fb, 0, fn); fo.flush(); fo.close();
                    try {
                        java.io.FileOutputStream s3 = new java.io.FileOutputStream(
                                new File(DIR, "wxh_cfgsync.stamp"));
                        s3.write(String.valueOf(sig).getBytes("UTF-8"));
                        s3.flush(); s3.close();
                    } catch (Throwable ignore) { }
                    cfg = null; cfgAt = 0;
                    log("CFG|force-sync bytes=" + fn);
                }
            }
        } catch (Throwable ignore) { }
        if (!f.isFile()) {
            // 双开/分身：本目录还没有配置，尝试继承主号导出的 /sdcard/.wxh_config.json
            try {
                File shared = new File("/sdcard/.wxh_config.json");
                if (shared.isFile() && shared.length() > 0) {
                    byte[] sb = new byte[(int) shared.length()];
                    FileInputStream si = new FileInputStream(shared);
                    int sn = si.read(sb);
                    si.close();
                    if (sn > 0) {
                        FileOutputStream so = new FileOutputStream(f);
                        so.write(sb, 0, sn); so.flush(); so.close();
                        log("CFG|inherited from sdcard bytes=" + sn);
                    }
                }
            } catch (Throwable ignore) { }
        }
        long t = f.lastModified();
        if (cfg != null && t == cfgAt) return cfg;
        JSONObject o = new JSONObject();
        try {
            if (f.isFile()) {
                byte[] b = new byte[(int) f.length()];
                FileInputStream in = new FileInputStream(f);
                int got = 0;
                while (got < b.length) {
                    int r = in.read(b, got, b.length - got);
                    if (r <= 0) break;
                    got += r;
                }
                in.close();
                o = new JSONObject(new String(b, "UTF-8"));
            }
        } catch (Throwable t2) {
            log("cfg err " + t2);
        }
        // 双开/分身：本目录配置缺的键，从主号导出的共享配置补齐（不覆盖本机已有值）
        try {
            File shared = new File("/storage/emulated/0/.wxh_config.json");
            if (!shared.isFile()) shared = new File("/sdcard/.wxh_config.json");
            if (shared.isFile() && shared.length() > 0) {
                byte[] sb = new byte[(int) shared.length()];
                FileInputStream si = new FileInputStream(shared);
                int sn = si.read(sb);
                si.close();
                if (sn > 0) {
                    JSONObject so = new JSONObject(new String(sb, 0, sn, "UTF-8"));
                    java.util.Iterator it = so.keys();
                    int merged = 0;
                    while (it.hasNext()) {
                        String k = String.valueOf(it.next());
                        if (!o.has(k) || o.isNull(k)) { o.put(k, so.opt(k)); merged++; }
                    }
                    if (merged > 0) log("CFG|merged " + merged + " keys from sdcard");
                }
            }
        } catch (Throwable ignore) { }
        // 双开/分身第二通道：模块 APK 内置的 wxh_shared.json（跨用户可读，作为默认值补齐）
        try {
            java.io.InputStream in0 = null;
            try {
                in0 = Plugin.class.getClassLoader().getResourceAsStream("assets/wxh_shared.json");
            } catch (Throwable ignore) { }
            if (in0 == null) {
                try {
                    java.security.CodeSource cs = Plugin.class.getProtectionDomain().getCodeSource();
                    if (cs != null && cs.getLocation() != null) {
                        String ap = cs.getLocation().getPath();
                        java.util.zip.ZipFile zf = new java.util.zip.ZipFile(new java.io.File(ap));
                        java.util.zip.ZipEntry ze = zf.getEntry("assets/wxh_shared.json");
                        if (ze != null) in0 = zf.getInputStream(ze);
                    }
                } catch (Throwable ignore) { }
            }
            if (in0 == null) {
                try {
                    android.content.Context c0 = ctxAny();
                    if (c0 != null) {
                        android.content.Context mc = c0.createPackageContext("com.h.module",
                                android.content.Context.CONTEXT_IGNORE_SECURITY);
                        in0 = mc.getAssets().open("wxh_shared.json");
                    }
                } catch (Throwable ignore) { }
            }
            if (in0 != null) {
                java.io.ByteArrayOutputStream bo = new java.io.ByteArrayOutputStream();
                byte[] buf = new byte[8192];
                int r0;
                while ((r0 = in0.read(buf)) > 0) bo.write(buf, 0, r0);
                in0.close();
                JSONObject so = new JSONObject(new String(bo.toByteArray(), "UTF-8"));
                java.util.Iterator it = so.keys();
                int merged2 = 0;
                while (it.hasNext()) {
                    String k = String.valueOf(it.next());
                    if (!o.has(k) || o.isNull(k)) { o.put(k, so.opt(k)); merged2++; }
                }
                if (merged2 > 0) log("CFG|merged " + merged2 + " keys from apk");
                // 一次性整份对齐：模块内 wxh_shared.json 更新过（体积变了）就把分身配置
                // 覆盖成主号的值，之后分身在面板里改的设置照常保留，不会被反复回滚
                try {
                    String av = String.valueOf(bo.size());
                    String last = null;
                    File st = new File(DIR, "wxh_shared.stamp");
                    if (st.isFile()) {
                        byte[] stb = new byte[(int) st.length()];
                        java.io.FileInputStream sti = new java.io.FileInputStream(st);
                        int stn = sti.read(stb); sti.close();
                        last = new String(stb, 0, Math.max(stn, 0), "UTF-8").trim();
                    }
                    if (!av.equals(last)) {
                        java.util.Iterator it2 = so.keys();
                        int ov = 0;
                        while (it2.hasNext()) {
                            String k2 = String.valueOf(it2.next());
                            if ("foldCollapsed".equals(k2) || "groupsVer".equals(k2)
                                    || "autoRemarkSince".equals(k2) || "actDone".equals(k2)) continue;
                            o.put(k2, so.opt(k2));
                            ov++;
                        }
                        try {
                            java.io.FileOutputStream w = new java.io.FileOutputStream(f);
                            w.write(o.toString().getBytes("UTF-8"));
                            w.flush(); w.close();
                        } catch (Throwable ignore) { }
                        try {
                            java.io.FileOutputStream w2 = new java.io.FileOutputStream(st);
                            w2.write(av.getBytes("UTF-8")); w2.flush(); w2.close();
                        } catch (Throwable ignore) { }
                        log("CFG|mirror apk keys=" + ov + " size=" + av);
                    }
                } catch (Throwable ignore) { }
            }
        } catch (Throwable t9) { log("CFG|apk merge err " + t9); }
        cfg = o;
        cfgAt = t;
        return o;
    }

