    private static boolean containsAvatar(View view) {
        try {
            if (view.getClass().getSimpleName().contains("Avatar")) return true;
            if (view instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) view;
                int n = Math.min(g.getChildCount(), 8);
                for (int i = 0; i < n; i++) {
                    if (containsAvatar(g.getChildAt(i))) return true;
                }
            }
        } catch (Throwable ignore) { }
        return false;
    }

    public static ViewGroup findMsgList(View view) {
        try {
            java.util.ArrayList<Object> lists = new java.util.ArrayList<Object>();
            collectLists(view, lists);
            ViewGroup best = null;
            int bestScore = 0;
            for (Object o : lists) {
                if (!(o instanceof ViewGroup)) continue;
                ViewGroup g = (ViewGroup) o;
                if (g.getClass().getName().contains("ConversationListView")) continue;
                if (g.getWidth() == 0 || g.getHeight() == 0) continue;
                int score = 0;
                for (int i = 0; i < g.getChildCount(); i++) {
                    if (containsAvatar(g.getChildAt(i))) score++;
                }
                if (score > bestScore) { bestScore = score; best = g; }
            }
            if (best != null && bestScore > 0) {
                timeDbg++;
                if (timeDbg % 20 == 2) log("MSGLIST|" + best.getClass().getSimpleName() + " rows=" + bestScore);
                return best;
            }
        } catch (Throwable ignore) { }
        return null;
    }

    public static void collectTexts(View view, java.util.List<android.widget.TextView> list, int depth) {
        if (depth > 40) return;
        try {
            if (view instanceof android.widget.TextView) list.add((android.widget.TextView) view);
            if (view instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) view;
                for (int i = 0; i < g.getChildCount(); i++) collectTexts(g.getChildAt(i), list, depth + 1);
            }
        } catch (Throwable ignore) { }
    }

    public static android.widget.TextView mainTextOf(View view) {
        try {
            java.util.ArrayList<android.widget.TextView> all = new java.util.ArrayList<android.widget.TextView>();
            collectTexts(view, all, 0);
            android.widget.TextView best = null;
            int bestScore = -1;
            for (android.widget.TextView tv : all) {
                CharSequence text = tv.getText();
                if (text == null || text.length() == 0) continue;
                int score = (tv.getBackground() != null ? 1000000 : 0)
                        + ((int) (tv.getTextSize() * 100.0f)) + Math.min(999, text.length());
                if (score > bestScore) { best = tv; bestScore = score; }
            }
            return best;
        } catch (Throwable t) { return null; }
    }

    private static String tagOf(String xml, String tag) {
        try {
            String openC = "<" + tag + "><![CDATA[";
            int i = xml.indexOf(openC);
            if (i >= 0) {
                int j = xml.indexOf("]]>", i + openC.length());
                if (j > i) return xml.substring(i + openC.length(), j).trim();
            }
            String open = "<" + tag + ">";
            int i2 = xml.indexOf(open);
            if (i2 >= 0) {
                int j2 = xml.indexOf("</" + tag + ">", i2);
                if (j2 > i2) return xml.substring(i2 + open.length(), j2).trim();
            }
        } catch (Throwable ignore) { }
        return "";
    }

    /** 取屏幕上某点的文字（简化版） */
    public static String textAt(android.app.Activity activity, float x, float y) {
        try {
            android.view.View decor = activity.getWindow().getDecorView();
            android.view.View hit = decor;
            float lx = x, ly = y;
            while (hit instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) hit;
                android.view.View found = null;
                for (int i = g.getChildCount() - 1; i >= 0; i--) {
                    android.view.View c = g.getChildAt(i);
                    if (lx >= c.getLeft() && lx <= c.getRight() && ly >= c.getTop() && ly <= c.getBottom()) {
                        found = c; break;
                    }
                }
                if (found == null) break;
                lx -= found.getLeft();
                ly -= found.getTop();
                hit = found;
            }
            android.widget.TextView mt = mainTextOf(hit);
            if (mt != null && mt.getText() != null && mt.getText().length() > 0) {
                return mt.getText().toString();
            }
            return findTextIn(hit);
        } catch (Throwable t) { return null; }
    }

