    private static void clearWhiteBg(android.view.View v, int d) {
        if (v == null || d > 3) return;
        try {
            android.graphics.drawable.Drawable bg = v.getBackground();
            if (bg instanceof android.graphics.drawable.ColorDrawable) {
                int c = ((android.graphics.drawable.ColorDrawable) bg).getColor();
                if (android.graphics.Color.alpha(c) > 200 && android.graphics.Color.red(c) > 235
                        && android.graphics.Color.green(c) > 235 && android.graphics.Color.blue(c) > 235) {
                    v.setBackground(null);
                }
            }
        } catch (Throwable ignore) { }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) clearWhiteBg(g.getChildAt(i), d + 1);
        }
    }

    private static boolean resHooked=false;
    private static final java.util.HashSet<String> resLogged=new java.util.HashSet<String>();
    private static void installResThemeHook() {
        if (true) return;   // 资源替换已删除（四页主题下线）
        if (resHooked) return; resHooked=true;
        try {
            XC_MethodHook hk=new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam pm) {
                    try {
                        if (!themeOn()) return;
                        Object th=pm.thisObject; if(!(th instanceof android.content.res.Resources)) return;
                        android.content.res.Resources r=(android.content.res.Resources)th;
                        Integer id=null; for(Object o:pm.args) if(o instanceof Integer){id=(Integer)o;break;}
                        if(id==null) return;
                        String nm=r.getResourceName(id.intValue());
                        if(nm==null||!nm.contains("bg")) return;
                        String low=nm.toLowerCase();
                        if(!(low.contains("fragment")||low.contains("main_bg")||low.contains("address")||low.contains("findmore")||low.contains("setting"))) return;
                        if(resLogged.add(nm)&&resLogged.size()<120) log("RESTHEME|"+nm);
                        int idx=0;
                        if(low.contains("address")) idx=1; else if(low.contains("findmore")) idx=2;
                        else if(low.contains("setting")) idx=3;
                        android.graphics.Bitmap bm=themeBmForPage(idx);
                        if(bm==null) return;
                        android.graphics.drawable.BitmapDrawable bd=new android.graphics.drawable.BitmapDrawable(r,bm);
                        bd.setAlpha(235);
                        pm.setResult(bd);
                    } catch (Throwable ignore) { }
                }
            };
            XposedBridge.hookAllMethods(android.content.res.Resources.class,"getDrawable",hk);
            XposedBridge.hookAllMethods(android.content.res.Resources.class,"getDrawableForDensity",hk);
            log("RESTHEME|hook installed");
        } catch (Throwable t) { log("RESTHEME|err "+t); }
    }

    /** 把整屏主题图按"屏幕坐标"绘制：让顶栏那条色带看起来就是背景的延续 */
    static class AlignedBgDrawable extends android.graphics.drawable.Drawable {
        private final android.graphics.Bitmap bm;
        private final int viewTop;
        private final android.graphics.Paint pt = new android.graphics.Paint(android.graphics.Paint.FILTER_BITMAP_FLAG);
        AlignedBgDrawable(android.graphics.Bitmap b, int top) { bm = b; viewTop = top; }

        @Override public void draw(android.graphics.Canvas canvas) {
            android.graphics.Rect b = getBounds();
            if (b.isEmpty() || bm == null || bm.isRecycled()) return;
            int save = canvas.save();
            canvas.clipRect(b);
            int sw = b.width();
            // 位图缩放到屏幕宽度；把视图自身顶部对齐到它在屏幕上的位置
            float h = bm.getHeight() * (sw / (float) bm.getWidth());
            android.graphics.RectF dst = new android.graphics.RectF(0, -viewTop, sw, h - viewTop);
            canvas.drawBitmap(bm, null, dst, pt);
            canvas.restoreToCount(save);
        }

        @Override public void setAlpha(int a) { pt.setAlpha(a); }
        @Override public void setColorFilter(android.graphics.ColorFilter cf) { pt.setColorFilter(cf); }
        @Override public int getOpacity() { return android.graphics.PixelFormat.TRANSLUCENT; }
    }
    /* ================= 反检测：让微信看不见本模块 =================
     * 三道：
     *   installHideFiles  —— hook File.listFiles/exists/delete，把我们的文件从微信视角抹掉
     *   installCleanStack —— hook Throwable.getStackTrace，滤掉 Xposed/LSPosed 栈帧
     *   installHideModule —— hook PackageManager 查询，隐藏模块与 LSPosed 包名
     * 全部 try/catch 包裹；任何异常只记日志，绝不影响微信本体。
     */

    /** 需要从微信视角隐藏的文件名关键字 */
    private static final String[] HIDE_KEYS = {".mm_data_stat", "__mm_sc", "mm_sc_", "mm_sc."};

    /** 是不是该隐藏的路径 */
    private static boolean isOurPath(Object o) {
        if (o == null) return false;
        String n;
        try { n = o.toString(); } catch (Throwable t) { return false; }
        if (n == null) return false;
        for (int i = 0; i < HIDE_KEYS.length; i++) {
            if (n.indexOf(HIDE_KEYS[i]) >= 0) return true;
        }
        return false;
    }

    /** 调用方是不是我们自己（是则不隐藏，否则我们自己读写会被挡住） */
    private static boolean calledBySelf() {
        try {
            StackTraceElement[] st = new Throwable().getStackTrace();
            int n = Math.min(st.length, 24);
            for (int i = 0; i < n; i++) {
                String c = st[i].getClassName();
                if (c == null) continue;
                if (c.startsWith("wxh.Plugin")) return true;
                if (c.indexOf("XposedBridge") >= 0) return true;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    private static void installHideFiles(ClassLoader app) {
        try {
            XposedBridge.hookAllMethods(java.io.File.class, "listFiles", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    Object r = p.getResult();
                    if (!(r instanceof java.io.File[])) return;
                    java.io.File[] arr = (java.io.File[]) r;
                    boolean dirty = false;
                    for (int i = 0; i < arr.length; i++) {
                        if (arr[i] != null && isOurPath(arr[i].getName())) { dirty = true; break; }
                    }
                    if (!dirty) return;
                    java.util.ArrayList<java.io.File> keep = new java.util.ArrayList<java.io.File>();
                    for (int i = 0; i < arr.length; i++) {
                        if (arr[i] != null && !isOurPath(arr[i].getName())) keep.add(arr[i]);
                    }
                    p.setResult(keep.toArray(new java.io.File[0]));
                }
            });
            XposedBridge.hookAllMethods(java.io.File.class, "exists", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    Object th = p.thisObject;
                    if (th == null) return;
                    if (!isOurPath(th)) return;
                    if (calledBySelf()) return;
                    p.setResult(Boolean.FALSE);
                }
            });
            XposedBridge.hookAllMethods(java.io.File.class, "length", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    Object th = p.thisObject;
                    if (th == null) return;
                    if (!isOurPath(th)) return;
                    if (calledBySelf()) return;
                    p.setResult(Long.valueOf(0));
                }
            });
            log("ANTI|hideFiles ok");
        } catch (Throwable t) { log("ANTI|hideFiles err " + t); }
    }

    private static void installCleanStack(ClassLoader app) {
        try {
            XposedBridge.hookAllMethods(java.lang.Throwable.class, "getStackTrace", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    Object r = p.getResult();
                    if (!(r instanceof StackTraceElement[])) return;
                    StackTraceElement[] st = (StackTraceElement[]) r;
                    boolean hit = false;
                    for (int i = 0; i < st.length; i++) {
                        String c = st[i] == null ? null : st[i].getClassName();
                        if (c == null) continue;
                        if (c.indexOf("de.robv.android.xposed") >= 0
                                || c.indexOf("XposedBridge") >= 0
                                || c.indexOf("XposedHelpers") >= 0
                                || c.indexOf("lspd") >= 0
                                || c.indexOf("LSPosed") >= 0
                                || c.indexOf("wxh.Plugin") >= 0) { hit = true; break; }
                    }
                    if (!hit) return;
                    java.util.ArrayList<StackTraceElement> keep = new java.util.ArrayList<StackTraceElement>();
                    for (int i = 0; i < st.length; i++) {
                        String c = st[i] == null ? null : st[i].getClassName();
                        if (c == null) { keep.add(st[i]); continue; }
                        if (c.indexOf("de.robv.android.xposed") >= 0
                                || c.indexOf("XposedBridge") >= 0
                                || c.indexOf("XposedHelpers") >= 0
                                || c.indexOf("lspd") >= 0
                                || c.indexOf("LSPosed") >= 0
                                || c.indexOf("wxh.Plugin") >= 0) continue;
                        keep.add(st[i]);
                    }
                    p.setResult(keep.toArray(new StackTraceElement[0]));
                }
            });
            log("ANTI|cleanStack ok");
        } catch (Throwable t) { log("ANTI|cleanStack err " + t); }
    }

    private static final String[] HIDE_PKGS = { "github.shadowbaby.wechatxposed.hook", "org.lsposed.manager", "org.lsposed.lspatch" };

    private static boolean isHiddenPkg(String n) {
        if (n == null) return false;
        for (int i = 0; i < HIDE_PKGS.length; i++) {
            if (HIDE_PKGS[i].equals(n)) return true;
        }
        return false;
    }

    private static void installHideModule(ClassLoader app) {
        try {
            Class<?> pmCls = Class.forName("android.app.ApplicationPackageManager");
            XposedBridge.hookAllMethods(pmCls, "getInstalledPackages", new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    Object r = p.getResult();
                    if (!(r instanceof java.util.List)) return;
                    java.util.List<?> li = (java.util.List<?>) r;
                    boolean dirty = false;
                    for (int i = 0; i < li.size(); i++) {
                        Object o = li.get(i);
                        if (o == null) continue;
                        try {
                            Object v = o.getClass().getField("packageName").get(o);
                            if (isHiddenPkg((String) v)) { dirty = true; break; }
                        } catch (Throwable ignore) { }
                    }
                    if (!dirty) return;
                    java.util.ArrayList<Object> keep = new java.util.ArrayList<Object>();
                    for (int i = 0; i < li.size(); i++) {
                        Object o = li.get(i);
                        boolean drop = false;
                        if (o != null) {
                            try {
                                Object v = o.getClass().getField("packageName").get(o);
                                drop = isHiddenPkg((String) v);
                            } catch (Throwable ignore) { }
                        }
                        if (!drop) keep.add(o);
                    }
                    p.setResult(keep);
                }
            });
            log("ANTI|hideModule ok");
        } catch (Throwable t) { log("ANTI|hideModule err " + t); }
    }

