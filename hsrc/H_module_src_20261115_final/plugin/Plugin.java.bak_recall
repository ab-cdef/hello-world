    /** 在发布页找「原图」勾选项，未勾选就点一下 */
    private static void tapOriginalBox(android.app.Activity a) {
        try {
            android.view.View decor = a.getWindow().getDecorView();
            java.util.ArrayList<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectAllViews(decor, all, 0);
            for (android.view.View v : all) {
                CharSequence tx = null;
                if (v instanceof android.widget.TextView) tx = ((android.widget.TextView) v).getText();
                if (tx == null) continue;
                String s0 = tx.toString().trim();
                if (!s0.equals("原图") && !s0.equals("原图 ") && !s0.startsWith("原图(")) continue;
                if (v.getTag(0x0f0f0f92) != null) return;      // 只处理一次
                v.setTag(0x0f0f0f92, "done");
                // 找可点击的祖先（勾选框通常是整行）
                android.view.View clickable = v;
                for (int i = 0; i < 4 && clickable != null; i++) {
                    if (clickable.isClickable()) break;
                    android.view.ViewParent pv = clickable.getParent();
                    clickable = (pv instanceof android.view.View) ? (android.view.View) pv : null;
                }
                if (clickable != null) {
                    clickable.performClick();
                    log("SNSORIG|clicked " + clickable.getClass().getSimpleName());
                }
                return;
            }
        } catch (Throwable ignore) { }
    }

