            nameEt.setHint("名称");
            nameEt.setTextSize(13);
            box.addView(nameEt);
            final android.widget.EditText specEt = new android.widget.EditText(a);
            specEt.setHint("规格（可空）");
            specEt.setTextSize(13);
            box.addView(specEt);
            final android.widget.EditText priceEt = new android.widget.EditText(a);
            priceEt.setHint("单价（数字）");
            priceEt.setTextSize(13);
