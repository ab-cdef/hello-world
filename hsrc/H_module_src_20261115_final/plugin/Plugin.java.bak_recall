                    {"导出语音", "voice"},
                    {"聊天记录导出 Markdown", "md"},
                    {"一键导出套餐（记录+明细+类型+报告）", "bundle"},
                    {"群分析", "sec"},
                    {"群成员发言明细（CSV，选群）", "mstats"},
                    {"群活跃报告（Top10 + 时段，Markdown）", "greport"},
                    {"群成员变动导出（Markdown）", "chgmd"},
