            search.addTextChangedListener(new android.text.TextWatcher() {
                @Override public void beforeTextChanged(CharSequence s0, int st, int c, int af) { }
                @Override public void onTextChanged(CharSequence s0, int st, int b, int c) { }
                @Override public void afterTextChanged(android.text.Editable e) {
                    String q = e == null ? "" : e.toString().trim();
                    boolean[] secShow = new boolean[secViews.size()];
                    for (int i = 0; i < rowViews.size(); i++) {
                        boolean show = q.length() == 0 || rowLabels.get(i).contains(q);
                        rowViews.get(i).setVisibility(show ? android.view.View.VISIBLE : android.view.View.GONE);
