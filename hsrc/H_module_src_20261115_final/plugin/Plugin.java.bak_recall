        } catch (Throwable t) {
            log("noBg err " + t);
        }
    }



    private static void writeStatus() {
        try {
            JSONObject o = new JSONObject();
            o.put("time", new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date()));
            o.put("pid", android.os.Process.myPid());
            JSONObject c = cfg();
            o.put("unrecall", c.optBoolean("unrecall", false));
            o.put("keywordAlert", c.optJSONArray("keywordAlert"));
            o.put("dice", c.optInt("dice", 0));
            o.put("theme", c.optBoolean("theme", false));
            o.put("groupAlert", c.optBoolean("groupAlert", false));
            o.put("autoAcceptFriend", c.optBoolean("autoAcceptFriend", false));
            java.io.FileOutputStream fo = new java.io.FileOutputStream(DIR + "/wxh_status.json");
            fo.write(o.toString(2).getBytes("UTF-8"));
            fo.close();
        } catch (Throwable t) {
            log("status err " + t);
        }
    }

    private static void dumpSysMsgRow() {
        try {
            ClassLoader app = Plugin.class.getClassLoader();
            try {
                Class<?> probe = Class.forName("wxh.Probe", true, Plugin.class.getClassLoader());
                Object l = probe.getMethod("getAppLoader").invoke(null);
                if (l instanceof ClassLoader) app = (ClassLoader) l;
            } catch (Throwable t0) {
            }
            Object f = Class.forName("w41.i9", false, app).getMethod("b").invoke(null);
            Object store = f.getClass().getMethod("v").invoke(f);
            Object cur = store.getClass().getMethod("Fa", String.class)
                    .invoke(store, "select * from message where type=10000 order by createTime desc limit 1");
            android.database.Cursor c = (android.database.Cursor) cur;
            if (c != null && c.moveToFirst()) {
                StringBuilder sb = new StringBuilder();
                String[] cols = c.getColumnNames();
                for (int i = 0; i < cols.length; i++) {
                    String v;
                    try {
                        v = c.getString(i);
                    } catch (Throwable t) {
                        v = "?";
                    }
                    sb.append(cols[i]).append('=').append(v).append(" | ");
                }
                log("SYSMSCHEMA|" + sb);
            } else {
                log("SYSMSCHEMA|none");
            }
            if (c != null) c.close();
        } catch (Throwable t) {
            log("SYSMSCHEMA err " + t);
        }
    }


    private static android.app.Activity lastTopAct = null;

    /** 反射拿当前前台 Activity：不依赖任何生命周期钩子，分身/双开同样可用 */
    private static android.app.Activity currentTopActivity() {
        try {
            Class<?> at = Class.forName("android.app.ActivityThread");
            Object th = at.getMethod("currentActivityThread").invoke(null);
            java.lang.reflect.Field f = at.getDeclaredField("mActivities");
            f.setAccessible(true);
            Object map = f.get(th);
            java.lang.reflect.Method mv = map.getClass().getMethod("values");
            java.util.Collection<?> vals = (java.util.Collection<?>) mv.invoke(map);
            android.app.Activity best = null;
            for (Object rec : vals) {
                try {
                    java.lang.reflect.Field af = rec.getClass().getDeclaredField("activity");
                    af.setAccessible(true);
                    android.app.Activity a2 = (android.app.Activity) af.get(rec);
                    if (a2 == null || a2.isFinishing()) continue;
                    boolean paused = false;
                    try {
                        java.lang.reflect.Field rf = rec.getClass().getDeclaredField("paused");
                        rf.setAccessible(true);
                        paused = rf.getBoolean(rec);
                    } catch (Throwable ignore) { }
                    if (!paused) return a2;
                    if (best == null) best = a2;
                } catch (Throwable ignore) { }
            }
            return best;
        } catch (Throwable t) { return null; }
    }

    private static Runnable healPulse = null;
    private static int healTick = 0;

    /** 自愈脉冲：每 2 秒把聊天页的工具栏/消息时间/气泡拉一次，不依赖 Fragment/Activity 生命周期钩子
     *  （分身、双开里这些钩子可能装不上或触发不到，导致「面板能开、功能全无」） */
    private static void bootSelfHealPulse(final ClassLoader app) {
        if (healPulse != null) return;
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        healPulse = new Runnable() {
            @Override public void run() {
                try {
                    android.app.Activity a = currentTopActivity();
                    if (a == null) a = lastTopAct;
                    if (a != null && !a.isFinishing()) {
                        lastTopAct = a;
                        try { installAppLifecycle(a); } catch (Throwable ignore) { }
                        String an = a.getClass().getName();
                        boolean host = an.contains("ChattingUI") || an.endsWith(".LauncherUI")
                                || an.contains("UIPageFragmentActivity");
                        boolean chatNow = false;
                        try {
                            chatNow = inChat || isInChatUi() || (chatTalker != null && chatTalker.length() > 0)
                                    || hasChatFooter(a);
                        } catch (Throwable ignore) { }
                        if (host) {
                            try { startTodayCount(a); } catch (Throwable ignore) { }
                            try { ensureChatStyleLoop(a); } catch (Throwable ignore) { }
                            try { applyInputHint(); } catch (Throwable ignore) { }
                            try { if (bubbleSkinOn() && isChattingPage(a)) resprayBubbleSkin(a); } catch (Throwable ignore) { }
                        }
                        if (++healTick % 5 == 0) {
                            boolean footerNow = false;
                        try { footerNow = hasChatFooter(a); } catch (Throwable ignore) { }
                        log("HEAL|tick act=" + a.getClass().getSimpleName() + " chat=" + chatNow + " footer=" + footerNow
                                + " skin=" + bubbleSkinOn()
                                    + " tk=" + chatTalker + " mode=" + bubbleMode(cfg()));
                        }
                    }
                } catch (Throwable ignore) { }
                try { h.postDelayed(this, 2000); } catch (Throwable ignore) { }
            }
        };
        h.postDelayed(healPulse, 800);
        log("HEAL|pulse started");
    }

    public static void install() {
        log("install v2");
        // 只在微信主进程生效：小程序等子进程不需要这些 UI 钩子，跑了反而会崩
        try {
            String pn = (String) Class.forName("android.app.ActivityThread")
                    .getMethod("currentProcessName").invoke(null);
            if (pn != null && !wxPkg().equals(pn) && !pn.startsWith(wxPkg() + ":") && !pn.endsWith(":push")) {
                log("skip process " + pn);
                return;
            }
        } catch (Throwable ignore) { }
        try {
            ClassLoader app = null;
            try {
                Class<?> probe = Class.forName("wxh.Probe", true, Plugin.class.getClassLoader());
                app = (ClassLoader) probe.getMethod("getAppLoader").invoke(null);
                log("probe loader=" + (app == null ? "null" : app.getClass().getName()));
            } catch (Throwable t) {
                log("get probe loader err " + t);
            }
            if (app == null) app = Plugin.class.getClassLoader();
            appCl = app;
            log("app loader=" + app.getClass().getName());
            // ===== 卡密门禁：未激活则只装设置入口，其余功能一律不装 =====
            boolean licOk = false;
            try {
                if (cfg().optBoolean("licenseSkip", false)) {
                    licOk = true;
                    log("LIC|skip (licenseSkip=true)");
                } else {
                    wxh.License.init(app, new java.io.File(DIR));
                    licOk = wxh.License.isOk();
                    log("LIC|init device=" + wxh.License.deviceId() + " ok=" + licOk
                            + " msg=" + wxh.License.msg());
                }
            } catch (Throwable t) { log("LIC|init err " + t); licOk = false; }
            try { installPlusTouchHook(app); } catch (Throwable ignore) { }
            if (!licOk) {
                log("LIC|features LOCKED - 未激活，所有功能已停用");
                return;
            }
            if (wxh.License.debugged()) {
                log("SIG|检测到调试器，功能已停用");
                return;
            }
            if (!wxh.License.signatureOk(ctxAny())) {
                log("SIG|非官方安装包，功能已停用");
                toast("安装包已被修改，请安装官方版本");
                return;
            }
            if (wxh.License.needUpdate) { log("LIC|features LOCKED - 需强制更新"); return; }
            if (cfg().has("masterOn") && !cfg().optBoolean("masterOn", false)) {
                log("LIC|features LOCKED - 总开关未开启（H 设置→启用模块功能）");
                return;
            }
            log("LIC|features ENABLED");
        log("STIP|guard v3 active");
            try { bootSelfHealPulse(app); } catch (Throwable t) { log("HEAL|boot err " + t); }
            try { wxh.License.checkVersion(mainAct); } catch (Throwable ignore) { }
            // ===== 以下为功能安装 =====
            try { maybeRunVideoSelfTest(); } catch (Throwable ignore) { }
            try {
                Class<?> c = Class.forName("lm.g7", false, app);
                for (final Method m : c.getDeclaredMethods()) {
                    Class<?>[] ps = m.getParameterTypes();
                    if (m.getName().equals("convertFrom") && ps.length == 2
                            && ps[0] == ContentValues.class && ps[1] == boolean.class) {
                        m.setAccessible(true);
                        XposedBridge.hookMethod(m, new XC_MethodHook() {
                            @Override
                            protected void afterHookedMethod(MethodHookParam p) {
                                try {
                                    Object msg = p.thisObject;
                                    int type = getInt(msg, "field_type");
                                    int isSend = getInt(msg, "field_isSend");
                                    if (isSend != 0) return;
                                    log("MSG|type=" + type + "|isSend=" + isSend + "|talker=" + getStr(msg, "field_talker") + "|len=" + (getStr(msg, "field_content") == null ? 0 : getStr(msg, "field_content").length()));
                                    String talker = getStr(msg, "field_talker");
                                    String content = getStr(msg, "field_content");
                                    if (talker != null && talker.length() > 0
                                            && !talker.endsWith("@placeholder_foldgroup")) qrTalker = talker;
                                    try {
                                        if (type == 34 && cfg().optBoolean("autoSaveVoice", false)) {
                                            scheduleAutoSave(talker, 34);
                                        } else if (type == 43 && cfg().optBoolean("autoSaveVideo", false)) {
                                            scheduleAutoSave(talker, 43);
                                        }
                                    } catch (Throwable ignore) { }
                                    if (inQuietHours()) {
                                        log("QUIET|skip alert " + talker);
                                        return;
                                    }
                                    // 群消息静音：非 @ 我 的群消息一律不提醒
                                if (talker != null && talker.endsWith("@chatroom")
                                        && cfg().optBoolean("groupQuiet", false)) {
                                    boolean atMeNow = false;
                                    String nick = cfg().optString("myNick", "");
                                    if (content != null && content.contains("@")) {
                                        atMeNow = content.contains("@所有人") || content.contains("@全体成员")
                                                || (nick.length() > 0 && content.contains("@" + nick));
                                    }
                                    if (!atMeNow && type != TYPE_REDPACKET) {
                                        return;
                                    }
                                }
                                // 群内 @ 我
                                if (talker != null && talker.endsWith("@chatroom")
                                        && cfg().optBoolean("atMeAlert", true)
                                        && content != null && content.contains("@")) {
                                    String nick = cfg().optString("myNick", "");
                                    boolean atAll = content.contains("@所有人") || content.contains("@全体成员");
                                    boolean atMe = nick.length() > 0 && content.contains("@" + nick);
                                    if (atAll || atMe) {
                                        alert(atAll ? "群公告@" : "有人@你", shortOf(content));
                                        log("ATME|" + talker + "|" + (atAll ? "all" : nick));
                                    }
                                }
                                if (type == TYPE_REDPACKET && cfg().optBoolean("autoOpenRedPacket", false)) {
                                    autoOpenPacket(talker);
                                }
                                if (type == TYPE_REDPACKET && cfg().optBoolean("redPacketAlert", true)) {
                                        log("REDPACKET|" + talker + "|" + (content == null ? "" : content.replace('\n', ' ')));
                                        alert("收到红包", shortOf(content));
                                        return;
                                    }
                                    // 关键词提醒
                                    try {
                                        org.json.JSONArray kw = cfg().optJSONArray("keywordAlert");
                                        if (kw == null || kw.length() == 0 || content == null) return;
                                        for (int i = 0; i < kw.length(); i++) {
                                            String k = kw.optString(i, "");
                                            if (k.length() > 0 && content.contains(k)) {
                                                log("KEYWORD|" + talker + "|" + k);
                                                alert("关键词[" + k + "]", shortOf(content));
                                                return;
                                            }
                                        }
                                    } catch (Throwable t) {
                                    }
                                } catch (Throwable t) {
                                    log("err " + t);
                                }
                            }
                        });
                        log("hooked lm.g7." + m.getName());
                    }
                }
            } catch (Throwable t) { log("lmg7 skip " + t); }
            installSnsAutoPlay(app);
