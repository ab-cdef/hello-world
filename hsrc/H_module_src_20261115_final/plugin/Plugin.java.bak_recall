    /** 把天气内容发到当前聊天 */
    private static void sendWeatherToChat(final String city, final String txt) {
        final String tk = currentTalker();
        if (tk == null || tk.length() == 0) { toast("没有打开的聊天"); return; }
        final android.app.Activity act = topActivityNow();
        String body = txt == null ? "" : txt.trim();
        if (body.length() > 800) body = body.substring(0, 800) + "…";
        final String msg = "【" + city + " 天气】\n" + body;
        new Thread(new Runnable() {
            @Override public void run() {
                try { sendTextTo(act, tk, msg); log("WEATHER|sent " + city + " -> " + tk); }
                catch (Throwable t) { log("WEATHER|err " + t); }
            }
        }).start();
        toast("已发送到聊天");
    }

    private static String httpGet(String url) throws Exception {
        java.net.HttpURLConnection c = (java.net.HttpURLConnection) new java.net.URL(url).openConnection();
        c.setConnectTimeout(8000);
        c.setReadTimeout(8000);
        c.setRequestProperty("User-Agent", "wxh");
        java.io.InputStream in = c.getInputStream();
        java.io.ByteArrayOutputStream bo = new java.io.ByteArrayOutputStream();
        byte[] buf = new byte[4096];
        int r;
        while ((r = in.read(buf)) > 0) bo.write(buf, 0, r);
        in.close();
        c.disconnect();
        return new String(bo.toByteArray(), "UTF-8");
    }

    private static String fetchWeather(String city) {
        try {
            String g = httpGet("https://geocoding-api.open-meteo.com/v1/search?count=1&language=zh&name="
                    + java.net.URLEncoder.encode(city, "UTF-8"));
            org.json.JSONObject gj = new org.json.JSONObject(g);
            org.json.JSONArray res = gj.optJSONArray("results");
            if (res == null || res.length() == 0) return "找不到城市：" + city;
            org.json.JSONObject r0 = res.getJSONObject(0);
            double lat = r0.optDouble("latitude"), lon = r0.optDouble("longitude");
            String nm = r0.optString("name", city);

            String w = httpGet("https://api.open-meteo.com/v1/forecast?latitude=" + lat + "&longitude=" + lon
                    + "&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m"
                    + "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max"
                    + "&timezone=Asia%2FShanghai&forecast_days=4");
            org.json.JSONObject wj = new org.json.JSONObject(w);
            org.json.JSONObject cur = wj.optJSONObject("current");
            StringBuilder sb = new StringBuilder();
            if (cur != null) {
                sb.append("当前  ").append(cur.optDouble("temperature_2m")).append("°C  ")
                  .append(weatherText(cur.optInt("weather_code")))
                  .append("  湿度 ").append(cur.optInt("relative_humidity_2m")).append("%")
                  .append("  风 ").append(cur.optDouble("wind_speed_10m")).append("km/h\n\n");
            }
            org.json.JSONObject d = wj.optJSONObject("daily");
            if (d != null) {
                org.json.JSONArray t = d.optJSONArray("time");
                org.json.JSONArray hi = d.optJSONArray("temperature_2m_max");
                org.json.JSONArray lo = d.optJSONArray("temperature_2m_min");
                org.json.JSONArray wc = d.optJSONArray("weather_code");
                org.json.JSONArray pp = d.optJSONArray("precipitation_probability_max");
                for (int i = 0; i < (t == null ? 0 : t.length()); i++) {
                    sb.append(t.optString(i)).append("  ")
                      .append(weatherText(wc == null ? 0 : wc.optInt(i))).append("  ")
                      .append(lo == null ? "" : lo.optDouble(i)).append("~")
                      .append(hi == null ? "" : hi.optDouble(i)).append("°C")
                      .append(pp == null ? "" : ("  降水 " + pp.optInt(i) + "%"))
                      .append('\n');
                }
            }
            sb.append("\n").append(nm).append("  数据来源 Open-Meteo");
            return sb.toString();
        } catch (Throwable t) {
            log("WEATHER|err " + t);
            return "查询失败：" + t;
        }
    }

    private static String weatherText(int code) {
        if (code == 0) return "晴";
        if (code <= 2) return "多云";
        if (code == 3) return "阴";
        if (code <= 48) return "雾";
        if (code <= 57) return "毛毛雨";
        if (code <= 67) return "雨";
        if (code <= 77) return "雪";
        if (code <= 82) return "阵雨";
        if (code <= 86) return "阵雪";
        if (code <= 99) return "雷阵雨";
        return "未知";
    }

    /* ---- 群成员活跃度周对比 ---- */
    private static void showWeekCompare(final android.app.Activity a) {
        final String tk = chatTalker;
        if (tk == null || !tk.endsWith("@chatroom")) { toast("请先在群聊里执行"); return; }
        toast("正在对比本周与上周…");
        new Thread(new Runnable() {
            @Override public void run() {
                java.util.LinkedHashMap<String, Integer> thisWeek =
                        new java.util.LinkedHashMap<String, Integer>();
                java.util.LinkedHashMap<String, Integer> lastWeek =
                        new java.util.LinkedHashMap<String, Integer>();
                try {
                    long now = System.currentTimeMillis();
                    long sinceThis = sinceRaw(now - 7L * 86400000L);
                    long sinceLast = sinceRaw(now - 14L * 86400000L);
                    java.util.List<Object[]> rows = queryRows(
                            "select ifnull(content,''), createTime from message where talker='"
                                    + escSql(tk) + "' and createTime>=" + sinceLast
                                    + " order by createTime desc limit 5000", 2);
                    for (Object[] r : rows) {
                        long ct = pl(r[1]);
                        String sid = senderIdOfGroupMsg(String.valueOf(r[0]));
                        if (sid == null || sid.length() == 0) continue;
                        if (ct >= sinceThis) {
                            Integer v = thisWeek.get(sid);
                            thisWeek.put(sid, v == null ? 1 : v + 1);
                        } else {
                            Integer v = lastWeek.get(sid);
                            lastWeek.put(sid, v == null ? 1 : v + 1);
                        }
                    }
                } catch (Throwable t) { log("WCMP|err " + t); }
                final java.util.LinkedHashMap<String, Integer> tw = thisWeek;
                final java.util.LinkedHashMap<String, Integer> lw = lastWeek;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        java.util.LinkedHashSet<String> all = new java.util.LinkedHashSet<String>();
                        all.addAll(tw.keySet());
                        all.addAll(lw.keySet());
                        if (all.isEmpty()) { toast("这两周没有发言记录"); return; }
                        java.util.ArrayList<String> keys = new java.util.ArrayList<String>(all);
                        java.util.Collections.sort(keys, new java.util.Comparator<String>() {
                            @Override public int compare(String x, String y) {
                                return (tw.get(y) == null ? 0 : tw.get(y))
                                        - (tw.get(x) == null ? 0 : tw.get(x));
                            }
                        });
                        StringBuilder sb = new StringBuilder();
                        sb.append("本周 vs 上周（发言条数）\n\n");
                        int up = 0, down = 0, same = 0;
                        for (String k : keys) {
                            int n1 = tw.get(k) == null ? 0 : tw.get(k);
                            int n2 = lw.get(k) == null ? 0 : lw.get(k);
                            if (n1 > n2) up++; else if (n1 < n2) down++; else same++;
                            if (n1 == 0 && n2 == 0) continue;
                            String mark = n1 > n2 ? "↑" : (n1 < n2 ? "↓" : "=");
                            sb.append(mark).append(' ').append(nameOf(k))
                              .append("  ").append(n1).append(" ← ").append(n2).append('\n');
                        }
                        sb.append("\n升温 ").append(up).append(" 人　降温 ").append(down)
                          .append(" 人　持平 ").append(same).append(" 人");
                        showTextDialog(a, displayOfTalker(tk) + " · 周对比", sb.toString(), "week_compare.txt");
                    }
                });
            }
        }).start();
    }

    /* ---- 收支数据加载（报表共用） ---- */
    private static java.util.ArrayList<MoneyRec> loadMoneyRecs() {
        java.util.ArrayList<MoneyRec> list = new java.util.ArrayList<MoneyRec>();
        try {
            java.util.List<Object[]> hb = queryRows(
                    "select ifnull(receiveAmount,0), ifnull(receiveTime,0), ifnull(sender,''),"
                            + " ifnull(msgSvrId,0) from WalletLuckyMoney order by receiveTime desc limit 1000", 4);
            for (Object[] r : hb) {
                MoneyRec m = new MoneyRec();
                m.kind = "红包";
                m.cent = pl(r[0]);
                m.timeMs = pl(r[1]);
                if (m.timeMs > 0 && m.timeMs < 100000000000L) m.timeMs *= 1000L;
                String sender = r[2] == null ? "" : String.valueOf(r[2]).trim();
                m.isSend = sender.length() > 0 && sender.equals(myWxidCached());
                String[] mi = msgInfoOfSvr(pl(r[3]));
                m.talker = mi[0].length() > 0 ? mi[0] : sender;
                m.who = mi[1].length() > 0 ? nameOf(mi[1]) : nameOf(sender);
                m.status = "已领取";
                list.add(m);
            }
            java.util.List<Object[]> tr = queryRows(
                    "select ifnull(isSend,0), ifnull(receiveTime,0), ifnull(locaMsgId,0), ifnull(talker,'')"
                            + " from RemittanceRecord order by receiveTime desc limit 1000", 4);
            for (Object[] r : tr) {
                MoneyRec m = new MoneyRec();
                m.kind = "转账";
                m.isSend = pl(r[0]) == 1;
                m.timeMs = pl(r[1]);
                if (m.timeMs > 0 && m.timeMs < 100000000000L) m.timeMs *= 1000L;
                m.talker = r[3] == null ? "" : String.valueOf(r[3]).trim();
                m.who = nameOf(m.talker);
                m.cent = transferCentOfMsg(pl(r[2]));
                m.status = "";
                list.add(m);
            }
        } catch (Throwable t) { log("MREC|err " + t); }
        return list;
    }

    /* ---- 收支趋势（字符柱状图） ---- */
    private static void showTrend(final android.app.Activity a) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.TreeMap<String, long[]> by = new java.util.TreeMap<String, long[]>();
                for (MoneyRec m : loadMoneyRecs()) {
                    if (m.timeMs <= 0) continue;
                    String k = monthKey(m.timeMs);
                    long[] v = by.get(k);
                    if (v == null) { v = new long[2]; by.put(k, v); }
                    if (m.isSend) v[1] += m.cent; else v[0] += m.cent;
                }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (by.isEmpty()) { toast("没有数据"); return; }
                        long max = 1;
                        for (long[] v : by.values()) max = Math.max(max, Math.max(v[0], v[1]));
                        StringBuilder sb = new StringBuilder();
                        sb.append("月份      收入  支出\n");
                        for (java.util.Map.Entry<String, long[]> e : by.entrySet()) {
                            long[] v = e.getValue();
                            sb.append(e.getKey()).append("  ")
                              .append(bar(v[0], max)).append(" 收").append(fmtMoney(v[0])).append("\n")
                              .append("          ")
                              .append(bar(v[1], max)).append(" 支").append(fmtMoney(v[1])).append("\n");
                        }
                        showTextDialog(a, "收支趋势", sb.toString(), "trend.txt");
                    }
                });
            }
        }).start();
    }

    private static String bar(long v, long max) {
        try {
            int n = (int) Math.round((double) v * 10 / Math.max(max, 1));
            if (v > 0 && n == 0) n = 1;
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < n; i++) sb.append('█');
            for (int i = n; i < 10; i++) sb.append('·');
            return sb.toString();
        } catch (Throwable t) { return "··········"; }
    }

    /* ---- 对手方排行 ---- */
    private static void showCounterparty(final android.app.Activity a) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.LinkedHashMap<String, long[]> agg = new java.util.LinkedHashMap<String, long[]>();
                final java.util.LinkedHashMap<String, Integer> cnt = new java.util.LinkedHashMap<String, Integer>();
                for (MoneyRec m : loadMoneyRecs()) {
                    String k = m.talker == null ? "" : m.talker;
                    if (k.length() == 0) continue;
                    long[] v = agg.get(k);
                    if (v == null) { v = new long[2]; agg.put(k, v); }
                    v[m.isSend ? 1 : 0] += m.cent;
                    Integer c = cnt.get(k);
                    cnt.put(k, c == null ? 1 : c + 1);
                }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (agg.isEmpty()) { toast("没有数据"); return; }
                        java.util.List<String> keys = new java.util.ArrayList<String>(agg.keySet());
                        java.util.Collections.sort(keys, new java.util.Comparator<String>() {
                            @Override public int compare(String x, String y) {
                                long[] a1 = agg.get(x), b1 = agg.get(y);
                                return Long.compare(a1[0] + a1[1], b1[0] + b1[1]);
                            }
                        });
                        java.util.Collections.reverse(keys);
                        StringBuilder sb = new StringBuilder();
                        sb.append("按往来总额排序（前 30）\n\n");
                        int n = 0;
                        for (String k : keys) {
                            if (n++ >= 30) break;
                            long[] v = agg.get(k);
                            sb.append(n).append(". ").append(nameOf(k)).append('\n')
                              .append("   收 ").append(fmtMoney(v[0]))
                              .append("  支 ").append(fmtMoney(v[1]))
                              .append("  共 ").append(cnt.get(k)).append(" 笔\n");
                        }
                        showTextDialog(a, "对手方排行", sb.toString(), "counterparty.txt");
                    }
                });
            }
        }).start();
    }

    /* ---- 账单分类（红包/转账 × 群/私聊） ---- */
    private static void showCategoryReport(final android.app.Activity a) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final long[] hbIn = new long[1], hbOut = new long[1], trIn = new long[1], trOut = new long[1];
                final int[] cHb = new int[1], cTr = new int[1];
                for (MoneyRec m : loadMoneyRecs()) {
                    if ("红包".equals(m.kind)) {
                        cHb[0]++;
                        if (m.isSend) hbOut[0] += m.cent; else hbIn[0] += m.cent;
                    } else {
                        cTr[0]++;
                        if (m.isSend) trOut[0] += m.cent; else trIn[0] += m.cent;
                    }
                }
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        StringBuilder sb = new StringBuilder();
                        sb.append("【红包】").append(cHb[0]).append(" 笔\n")
                          .append("  收入  ").append(fmtMoney(hbIn[0])).append('\n')
                          .append("  支出  ").append(fmtMoney(hbOut[0])).append("\n\n")
                          .append("【转账】").append(cTr[0]).append(" 笔\n")
                          .append("  收入  ").append(fmtMoney(trIn[0])).append('\n')
                          .append("  支出  ").append(fmtMoney(trOut[0])).append("\n\n")
                          .append("【合计】\n")
                          .append("  总收入 ").append(fmtMoney(hbIn[0] + trIn[0])).append('\n')
                          .append("  总支出 ").append(fmtMoney(hbOut[0] + trOut[0])).append('\n')
                          .append("  净额   ").append(fmtMoney(hbIn[0] + trIn[0] - hbOut[0] - trOut[0]));
                        showTextDialog(a, "账单分类", sb.toString(), "category.txt");
                    }
                });
            }
        }).start();
    }

    /* ---- 红包收支明细 ---- */
    private static void showRedPacketDetail(final android.app.Activity a) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final StringBuilder sb = new StringBuilder();
                int n = 0;
                long in = 0, out = 0;
                for (MoneyRec m : loadMoneyRecs()) {
                    if (!"红包".equals(m.kind)) continue;
                    n++;
                    if (m.isSend) out += m.cent; else in += m.cent;
                    sb.append(m.timeMs > 0
                            ? new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US)
                                    .format(new java.util.Date(m.timeMs))
                            : "--")
                      .append(m.isSend ? "  发出 " : "  收到 ").append(fmtMoney(m.cent))
                      .append("  ").append(m.who).append('\n');
                }
                final String head = "红包共 " + n + " 笔　收入 " + fmtMoney(in) + "　发出 " + fmtMoney(out) + "\n\n";
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (sb.length() == 0) { toast("没有红包记录"); return; }
                        showTextDialog(a, "红包收支明细", head + sb.toString(), "redpacket_detail.txt");
                    }
