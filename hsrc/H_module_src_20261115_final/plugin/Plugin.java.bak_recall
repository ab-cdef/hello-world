                    while ((n = in.read(buf)) > 0) bo.write(buf, 0, n);
                    in.close();
                    org.json.JSONObject pk = new org.json.JSONObject(bo.toString("UTF-8"));
                    org.json.JSONArray arr = pk.optJSONArray(keys[Math.abs(idx) % keys.length]);
                    if (arr != null && arr.length() > 0) {
