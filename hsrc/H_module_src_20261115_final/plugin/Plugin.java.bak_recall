                    java.util.List<Object[]> rowsU = queryRows(
                            "select username, unReadCount from rconversation where unReadCount>0", 2);
                    java.util.HashMap<String, Integer> cur = new java.util.HashMap<String, Integer>();
                    for (Object[] r0 : rowsU) {
                        if (r0[0] == null) continue;
                        int v0 = 0;
                        try { v0 = Integer.parseInt(String.valueOf(r0[1]).trim()); } catch (Throwable ignore) { }
                        cur.put(String.valueOf(r0[0]), v0);
                    }
                    org.json.JSONObject marks = null;
                    org.json.JSONObject marksCfg = null;
                    try {
                        marksCfg = readCfg();
                        marks = marksCfg.optJSONObject("readMarks");
                    } catch (Throwable ignore) { }
                    boolean markDirty = false;
                    // 有已读标记、但数据库又冒出未读：只有出现更新的消息才恢复
                    java.util.HashMap<String, Integer> eff = new java.util.HashMap<String, Integer>();
                    for (java.util.Map.Entry<String, Integer> e0 : cur.entrySet()) {
                        String id0 = e0.getKey();
                        int raw = e0.getValue() == null ? 0 : e0.getValue();
                        if (marks != null && marks.has(id0) && raw > 0) {
                            long ts = marks.optLong(id0, 0);
                            long latest = 0;
                            try {
                                java.util.List<Object[]> q0 = queryRows(
                                        "select max(createTime) from message where talker='" + id0 + "'", 1);
                                if (!q0.isEmpty() && q0.get(0)[0] != null) {
                                    latest = Long.parseLong(String.valueOf(q0.get(0)[0]).trim());
                                }
                            } catch (Throwable ignore) { }
                            if (latest > ts) {
                                marks.remove(id0);
                                markDirty = true;
                                eff.put(id0, raw);
                            } else {
                                eff.put(id0, 0);
                            }
                        } else {
                            eff.put(id0, raw);
                        }
                    }
                    if (markDirty && marksCfg != null) {
                        try {
                            marksCfg.put("readMarks", marks);
                            writeCfg(marksCfg);
                            cfg = null;
                            cfgAt = 0;
                        } catch (Throwable ignore) { }
                    }
                    boolean changed = false;
                    for (int k0 = 0; k0 < ids.length; k0++) {
                        String id0 = ids[k0];
                        int nv = eff.containsKey(id0) ? eff.get(id0) : 0;
                        int ov = 0;
                        try { ov = Integer.parseInt(unreads[k0]); } catch (Throwable ignore) { }
                        if (nv != ov) { unreads[k0] = String.valueOf(nv); changed = true; }
                    }
                    boolean chipChanged = false;
                    for (java.util.Map.Entry<String, Integer> e0 : hubUnread.entrySet()) {
                        String id0 = e0.getKey();
                        int nv = eff.containsKey(id0) ? eff.get(id0) : 0;
                        if (nv != (e0.getValue() == null ? 0 : e0.getValue())) {
                            e0.setValue(Integer.valueOf(nv));
                            chipChanged = true;
                        }
                    }
                    if (changed && adRef[0] != null) adRef[0].notifyDataSetChanged();
                    if (chipChanged) refreshGroupBadges(a);
                } catch (Throwable t) { log("TICK|" + t); }
                try { hubTick.postDelayed(this, 2000); } catch (Throwable ignore) { }
            }
        }, 2000);
    }

    // ================= 定时发送 =================

    private static final java.util.concurrent.atomic.AtomicBoolean schedStarted =
            new java.util.concurrent.atomic.AtomicBoolean(false);
    private static volatile boolean snsTimeHooked = false;
    private static volatile String snsFmtCache = "";
    private static long snsFmtAt = 0L;

    private static void installSnsTimeFmt(ClassLoader app) {
        if (snsTimeHooked) return;
        try {
            java.lang.reflect.Method mSetText = android.widget.TextView.class
                    .getDeclaredMethod("setText", CharSequence.class);
            mSetText.setAccessible(true);
            XposedBridge.hookMethod(mSetText, new XC_MethodHook() {
                        @Override protected void beforeHookedMethod(MethodHookParam param) {
                            try {
                                android.app.Activity act = mainAct;
                                if (act == null) return;
                                String cn = act.getClass().getName();
                                if (!cn.contains("SnsTimelineUI") && !cn.contains("SnsTimeLineUI")) return;
                                long tick = System.currentTimeMillis();
                                if (tick - snsFmtAt > 1500L) {
                                    snsFmtCache = cfg().optString("snsTimeFmt", "");
                                    snsFmtAt = tick;
                                }
                                final String sp = snsFmtCache;
                                if (sp.length() == 0) return;
                                Object a0 = param.args[0];
                                if (!(a0 instanceof CharSequence)) return;
                                CharSequence nv = snsTimeFormat((CharSequence) a0, sp);
                                if (nv != null && !nv.toString().contentEquals((CharSequence) a0)) {
                                    param.args[0] = nv;
                                }
                            } catch (Throwable ignore) { }
                        }
                    });
            snsTimeHooked = true;
            log("SNSTIME|hook ok");
        } catch (Throwable t) { log("SNSTIME|hook err " + t); }
    }

    /** 朋友圈列表的原生相对时间 -> 用户选的格式；解析不出来就返回 null（保持原生） */
    private static CharSequence snsTimeFormat(CharSequence cs, String pattern) {
        try {
            String s = cs.toString().trim();
            if (s.length() == 0 || s.length() > 16) return null;
            long now = System.currentTimeMillis();
            long t = 0L;
            if (s.equals("刚刚") || s.equals("刚才")) {
                t = now;
            } else if (s.endsWith("秒前")) {
                t = now - Long.parseLong(s.substring(0, s.length() - 2)) * 1000L;
            } else if (s.endsWith("分钟前")) {
                t = now - Long.parseLong(s.substring(0, s.length() - 3)) * 60000L;
            } else if (s.endsWith("小时前")) {
                t = now - Long.parseLong(s.substring(0, s.length() - 3)) * 3600000L;
            } else if (s.equals("昨天")) {
                t = now - 86400000L;
            } else if (s.equals("前天")) {
                t = now - 172800000L;
            } else if (s.endsWith("天前")) {
                t = now - Long.parseLong(s.substring(0, s.length() - 2)) * 86400000L;
            } else if (s.endsWith("周前")) {
                t = now - Long.parseLong(s.substring(0, s.length() - 2)) * 604800000L;
            } else {
                java.util.regex.Matcher mf = java.util.regex.Pattern
                        .compile("(\\d{1,4})年(\\d{1,2})月(\\d{1,2})日").matcher(s);
                java.util.regex.Matcher ms = java.util.regex.Pattern
                        .compile("(\\d{1,2})月(\\d{1,2})日").matcher(s);
                java.util.Calendar c = java.util.Calendar.getInstance();
                c.set(java.util.Calendar.MILLISECOND, 0);
                c.set(java.util.Calendar.SECOND, 0);
                c.set(java.util.Calendar.MINUTE, 0);
                c.set(java.util.Calendar.HOUR_OF_DAY, 0);
                if (mf.matches()) {
                    c.set(Integer.parseInt(mf.group(1)), Integer.parseInt(mf.group(2)) - 1,
                            Integer.parseInt(mf.group(3)));
                    t = c.getTimeInMillis();
                } else if (ms.matches()) {
                    c.set(Integer.parseInt(ms.group(1)) - 1, Integer.parseInt(ms.group(2)));
                    t = c.getTimeInMillis();
                    if (t > now) t -= 365L * 86400000L;
                }
            }
            if (t <= 0) return null;
            java.text.SimpleDateFormat df =
                    new java.text.SimpleDateFormat(pattern, java.util.Locale.CHINA);
            return df.format(new java.util.Date(t));
        } catch (Throwable t) {
            return null;
        }
    }

    private static volatile android.app.Activity mainAct = null;

    private static void startScheduler() {
        if (!schedStarted.compareAndSet(false, true)) return;
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        h.postDelayed(new Runnable() {
            @Override public void run() {
                try { runDueSchedules(); } catch (Throwable t) { log("SCHED|" + t); }
                try { notifyFollowUpIfDue(); } catch (Throwable ignore) { }
                try { notifyNewChatsIfDue(); } catch (Throwable ignore) { }
                try { notifyDeclineIfDue(); } catch (Throwable ignore) { }
                try { notifyBirthdayIfDue(); } catch (Throwable ignore) { }
                try { h.postDelayed(this, 20000); } catch (Throwable ignore) { }
            }
        }, 8000);
    }

    private static void runDueSchedules() {
        try {
            if (blastQueue != null) return;
            org.json.JSONObject o = readCfg();
            org.json.JSONArray arr = o.optJSONArray("schedMsgs");
            if (arr == null || arr.length() == 0) return;
            long now = System.currentTimeMillis();
            int due = -1;
            for (int i = 0; i < arr.length(); i++) {
                org.json.JSONObject t = arr.optJSONObject(i);
                if (t != null && t.optLong("at", 0) <= now) { due = i; break; }
            }
            if (due < 0) return;
            android.app.Activity host = chatAct != null ? chatAct : mainAct;
            log("SCHED|due " + due + " host=" + (host == null ? "null" : host.getClass().getSimpleName())
                    + " focus=" + (host != null && host.hasWindowFocus()));
            if (host == null || !host.hasWindowFocus()) {
                log("SCHED|wait foreground");
                return;
            }
            org.json.JSONObject task = arr.optJSONObject(due);
            final String talker = task.optString("t", "");
            final String text = task.optString("x", "");
            if (task.optBoolean("d", false)) {
                try {
                    org.json.JSONObject again = new org.json.JSONObject();
                    again.put("t", talker);
                    again.put("x", text);
                    again.put("at", task.optLong("at", now) + 86400000L);
                    again.put("d", true);
                    arr.put(again);
                } catch (Throwable ignore) { }
            }
            arr.remove(due);
            o.put("schedMsgs", arr);
            writeCfg(o);
            cfg = null;
            cfgAt = 0;
            if (talker.length() == 0 || text.length() == 0) return;
            log("SCHED|fire " + talker + " len=" + text.length());
            toast("定时发送：" + resolveName(talker));
            // 用 sendTextTo（只用 FLAG_ACTIVITY_NEW_TASK），避免"停在别的聊天时发错会话"
            sendTextTo(host, talker, text);
        } catch (Throwable t) { log("SCHED|err " + t); }
    }

    static volatile String schedInitText = null;

    private static void showScheduleDialog(final android.app.Activity a) {
        final android.app.Dialog dlg = new android.app.Dialog(a, android.R.style.Theme_Material_Light_NoActionBar);
        final android.widget.LinearLayout wrap = new android.widget.LinearLayout(a);
        wrap.setOrientation(android.widget.LinearLayout.VERTICAL);
        wrap.setBackground(roundRect(0xE2FFFFFF, dp(a, 18)));
        wrap.setPadding(dp(a, 16), dp(a, 14), dp(a, 16), dp(a, 10));

        android.widget.TextView title = new android.widget.TextView(a);
        title.setText("定时发送");
        title.setTextSize(16);
        title.setTextColor(0xFF141418);
        title.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
        wrap.addView(title);

        final String[] targetId = new String[]{chatTalker};
        final android.widget.TextView target = new android.widget.TextView(a);
        target.setTextSize(13);
        target.setTextColor(0xFF6A6A73);
        target.setPadding(0, dp(a, 8), 0, dp(a, 4));
        target.setText("目标：" + (targetId[0] == null ? "点击选择" : resolveName(targetId[0])));
        target.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                showTalkerPicker(a, "发送到", false, new ChatPick() {
                    @Override public void onPick(String tk, String nm) {
                        targetId[0] = tk;
                        target.setText("目标：" + nm);
                    }
                });
            }
        });
        wrap.addView(target);

        final long[] whenAt = new long[]{0};
        final android.widget.TextView whenLbl = new android.widget.TextView(a);
        whenLbl.setTextSize(13);
        whenLbl.setTextColor(0xFF3C6EFF);
        whenLbl.setPadding(0, dp(a, 6), 0, dp(a, 6));
        whenLbl.setText("发送时间：点下面快捷按钮，或输入 HH:mm");
        wrap.addView(whenLbl);

        android.widget.LinearLayout quick = new android.widget.LinearLayout(a);
        quick.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        String[] qNames = {"+5分", "+30分", "+1小时", "明天9点"};
        long[] qAdd = {5 * 60000L, 30 * 60000L, 3600000L, -1L};
        for (int qi = 0; qi < qNames.length; qi++) {
            final int idx = qi;
            android.widget.TextView b = new android.widget.TextView(a);
            b.setText(qNames[qi]);
            b.setTextSize(12);
            b.setTextColor(0xFF2A5BD7);
            b.setGravity(android.view.Gravity.CENTER);
            b.setBackground(roundRect(0xFFE8EEFF, dp(a, 10)));
            b.setPadding(dp(a, 6), dp(a, 7), dp(a, 6), dp(a, 7));
            android.widget.LinearLayout.LayoutParams lp =
                    new android.widget.LinearLayout.LayoutParams(0, -2, 1f);
            lp.rightMargin = dp(a, 6);
            b.setLayoutParams(lp);
            b.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    long t;
                    if (qAdd[idx] < 0) {
                        java.util.Calendar c = java.util.Calendar.getInstance();
                        c.add(java.util.Calendar.DAY_OF_MONTH, 1);
                        c.set(java.util.Calendar.HOUR_OF_DAY, 9);
                        c.set(java.util.Calendar.MINUTE, 0);
                        c.set(java.util.Calendar.SECOND, 0);
                        t = c.getTimeInMillis();
                    } else {
                        t = System.currentTimeMillis() + qAdd[idx];
                    }
                    whenAt[0] = t;
                    whenLbl.setText("发送时间：" + new java.text.SimpleDateFormat(
                            "MM-dd HH:mm", java.util.Locale.US).format(new java.util.Date(t)));
                }
            });
            quick.addView(b);
        }
        wrap.addView(quick);

        final android.widget.EditText hhmm = new android.widget.EditText(a);
        hhmm.setHint("或输入 HH:mm（今天该时刻，已过则算明天）");
        hhmm.setSingleLine(true);
        hhmm.setTextSize(13);
        wrap.addView(hhmm, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 42)));

        final android.widget.EditText msg = new android.widget.EditText(a);
        msg.setHint("要发送的内容");
        msg.setTextSize(13);
        try {
            if (schedInitText != null && schedInitText.length() > 0) {
                msg.setText(schedInitText);
                msg.setSelection(schedInitText.length());
            }
            schedInitText = null;
        } catch (Throwable ignore) { }
        wrap.addView(msg, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 62)));

        final android.widget.CheckBox daily = new android.widget.CheckBox(a);
        daily.setText("每天重复");
        daily.setTextSize(12);
        wrap.addView(daily);

        final android.widget.TextView list = new android.widget.TextView(a);
        list.setTextSize(12);
        list.setTextColor(0xFF8A8A93);
        list.setPadding(0, dp(a, 6), 0, dp(a, 4));
        wrap.addView(list, new android.widget.LinearLayout.LayoutParams(-1, 0, 1f));

        final java.lang.Runnable refresh = new Runnable() {
            @Override public void run() {
                try {
                    org.json.JSONArray arr = readCfg().optJSONArray("schedMsgs");
                    StringBuilder sb = new StringBuilder("待发送任务（点一条可删除）");
                    if (arr == null || arr.length() == 0) sb.append("\n  暂无");
                    else {
                        long now = System.currentTimeMillis();
                        for (int i = 0; i < arr.length(); i++) {
                            org.json.JSONObject t = arr.optJSONObject(i);
                            if (t == null) continue;
                            long at = t.optLong("at", 0);
                            long left = at - now;
                            String rel = left < 0 ? "（已过期，等前台）"
                                    : (left < 60000 ? (left / 1000 + " 秒后")
                                    : (left < 3600000 ? (left / 60000 + " 分钟后")
                                    : (left / 3600000 + " 小时后")));
                            sb.append("\n").append(new java.text.SimpleDateFormat(
                                    "MM-dd HH:mm", java.util.Locale.US).format(new java.util.Date(at)))
                              .append("  ").append(resolveName(t.optString("t")))
                              .append("  ").append(t.optString("x")).append("  ").append(rel)
                              .append(t.optBoolean("d", false) ? " 每天" : "");
                        }
                    }
                    list.setText(sb.toString());
                } catch (Throwable ignore) { }
            }
        };
        refresh.run();
        list.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                try {
                    final org.json.JSONArray arr = readCfg().optJSONArray("schedMsgs");
                    if (arr == null || arr.length() == 0) { toast("没有任务"); return; }
                    final String[] items = new String[arr.length()];
                    for (int i = 0; i < arr.length(); i++) {
                        org.json.JSONObject t = arr.optJSONObject(i);
                        items[i] = new java.text.SimpleDateFormat("MM-dd HH:mm")
                                .format(new java.util.Date(t.optLong("at")))
                                + "  " + resolveName(t.optString("t")) + "  " + t.optString("x");
                    }
                    new android.app.AlertDialog.Builder(a)
                            .setTitle("点一条删除")
                            .setItems(items, new android.content.DialogInterface.OnClickListener() {
                                @Override public void onClick(android.content.DialogInterface d, int w) {
                                    try {
                                        org.json.JSONObject o = readCfg();
                                        org.json.JSONArray cur = o.optJSONArray("schedMsgs");
                                        org.json.JSONArray na = new org.json.JSONArray();
                                        for (int i = 0; i < cur.length(); i++) if (i != w) na.put(cur.get(i));
                                        o.put("schedMsgs", na);
                                        writeCfg(o);
                                        cfg = null; cfgAt = 0;
                                        refresh.run();
                                        toast("已删除");
                                    } catch (Throwable ignore) { }
                                }
                            }).show();
                } catch (Throwable ignore) { }
            }
        });

        android.widget.LinearLayout btns = new android.widget.LinearLayout(a);
        btns.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        android.widget.TextView cancel = new android.widget.TextView(a);
        cancel.setText("取消");
        cancel.setTextSize(14);
        cancel.setGravity(android.view.Gravity.CENTER);
        cancel.setPadding(0, dp(a, 10), 0, dp(a, 10));
        cancel.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) { dlg.dismiss(); }
        });
        android.widget.TextView ok = new android.widget.TextView(a);
        ok.setText("确定");
        ok.setTextSize(14);
        ok.setTextColor(0xFF2A5BD7);
        ok.setGravity(android.view.Gravity.CENTER);
        ok.setPadding(0, dp(a, 10), 0, dp(a, 10));
        ok.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                try {
                    String tk = targetId[0];
                    String tx = msg.getText().toString().trim();
                    if (tk == null || tk.length() == 0) { toast("先选目标会话"); return; }
                    if (tx.length() == 0) { toast("先填内容"); return; }
                    long at = whenAt[0];
                    String hh = hhmm.getText().toString().trim();
                    if (hh.length() > 0) {
                        String[] p = hh.split(":");
                        if (p.length != 2) { toast("时间格式要 HH:mm"); return; }
                        try {
                            int H = Integer.parseInt(p[0].trim());
                            int M = Integer.parseInt(p[1].trim());
                            if (H < 0 || H > 23 || M < 0 || M > 59) { toast("时间不合法"); return; }
                            java.util.Calendar c = java.util.Calendar.getInstance();
                            c.set(java.util.Calendar.HOUR_OF_DAY, H);
                            c.set(java.util.Calendar.MINUTE, M);
                            c.set(java.util.Calendar.SECOND, 0);
                            if (c.getTimeInMillis() <= System.currentTimeMillis())
                                c.add(java.util.Calendar.DAY_OF_MONTH, 1);
                            at = c.getTimeInMillis();
                        } catch (Throwable e) { toast("时间格式要 HH:mm"); return; }
                    }
                    if (at <= 0) { toast("先选发送时间"); return; }
                    org.json.JSONObject o = readCfg();
                    org.json.JSONArray arr = o.optJSONArray("schedMsgs");
                    if (arr == null) arr = new org.json.JSONArray();
                    if (arr.length() >= 50) { toast("任务太多，先删几条"); return; }
                    org.json.JSONObject t = new org.json.JSONObject();
                    t.put("t", tk);
                    t.put("x", tx);
                    t.put("at", at);
                    t.put("d", daily.isChecked());
                    arr.put(t);
                    o.put("schedMsgs", arr);
                    writeCfg(o);
                    cfg = null; cfgAt = 0;
                    toast("已加入定时：" + new java.text.SimpleDateFormat("MM-dd HH:mm",
                            java.util.Locale.US).format(new java.util.Date(at)));
                    log("SCHED|add " + tk + " at=" + at + " daily=" + daily.isChecked());
                    dlg.dismiss();
                } catch (Throwable t) { toast("保存失败"); }
            }
        });
        btns.addView(cancel, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
        btns.addView(ok, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
        wrap.addView(btns);

        dlg.setContentView(wrap);
        dlg.show();
        try {
            android.view.Window w = dlg.getWindow();
            if (w != null) {
                w.setBackgroundDrawable(glassDrawable(a, 20));
                w.setLayout((int) (a.getResources().getDisplayMetrics().widthPixels * 0.94f),
                        (int) (a.getResources().getDisplayMetrics().heightPixels * 0.78f));
            }
        } catch (Throwable ignore) { }
    }

    // ================= 语音导出 =================

    private static void exportChatVoice(final android.app.Activity a) {
        final String talker = chatTalker;
        if (talker == null) { toast("先打开一个聊天"); return; }
        toast("正在扫描语音…");
        new Thread(new Runnable() {
            @Override public void run() {
                int copied = 0, missing = 0;
                String err = null;
                try {
                    java.util.List<Object[]> rows = queryRows(
                            "select msgId from message where talker='" + talker + "' and type=34", 1);
                    java.util.HashSet<String> want = new java.util.HashSet<String>();
                    for (Object[] r : rows) {
                        if (r[0] != null) want.add(String.valueOf(r[0]).trim());
                    }
                    java.io.File mm = new java.io.File(mmBase() + "/MicroMsg");
                    java.io.File out = new java.io.File(
                            android.os.Environment.getExternalStorageDirectory(),
                            "Android/data/com.tencent.mm/files/wxh_voice/" + talker.replace('@', '_').replace(':', '_'));
                    out.mkdirs();
                    java.util.ArrayList<java.io.File> dirs = new java.util.ArrayList<java.io.File>();
                    java.io.File[] hs = mm.listFiles();
                    if (hs != null) {
                        for (java.io.File h2 : hs) {
                            java.io.File v2 = new java.io.File(h2, "voice2");
                            if (v2.isDirectory()) dirs.add(v2);
                        }
                    }
                    for (java.io.File v2 : dirs) {
                        java.util.ArrayList<java.io.File> stack = new java.util.ArrayList<java.io.File>();
                        stack.add(v2);
                        while (!stack.isEmpty()) {
                            java.io.File d = stack.remove(stack.size() - 1);
                            java.io.File[] fs = d.listFiles();
                            if (fs == null) continue;
                            for (java.io.File f : fs) {
                                if (f.isDirectory()) { stack.add(f); continue; }
                                String nm = f.getName();
                                if (!nm.startsWith("msg_") || !nm.endsWith(".amr")) continue;
                                String id = nm.substring(4, nm.length() - 4);
                                if (!want.contains(id)) continue;
                                java.io.File dst = new java.io.File(out, nm);
                                try {
                                    java.io.FileInputStream in = new java.io.FileInputStream(f);
                                    java.io.FileOutputStream fo = new java.io.FileOutputStream(dst);
                                    byte[] buf = new byte[8192];
                                    int n;
                                    while ((n = in.read(buf)) > 0) fo.write(buf, 0, n);
                                    in.close();
                                    fo.close();
                                    copied++;
                                    want.remove(id);
                                } catch (Throwable e) { err = String.valueOf(e); }
                            }
                        }
                    }
                    missing = want.size();
                } catch (Throwable t) {
                    err = String.valueOf(t);
                }
                final int c2 = copied, m2 = missing;
                final String e2 = err;
                log("VOICE|export copied=" + c2 + " missing=" + m2 + " err=" + e2);
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        toast("语音导出 " + c2 + " 条，缺失 " + m2 + (e2 == null ? "" : "，" + e2));
                    }
                });
            }
        }).start();
    }

    /** 群发：当前排队 */
    private static java.util.List<String> blastQueue = null;
    private static String blastText = null;
    private static int blastTotal = 0, blastDone = 0;
    private static final java.util.HashSet<String> blastRetried = new java.util.HashSet<String>();

    /** 列出所有会话（群 + 好友） */
    private static java.util.List<String[]> allConversations() {
        java.util.List<String[]> out = new java.util.ArrayList<String[]>();
        try {
            java.util.List<Object[]> rows = queryRows("select username from rconversation", 1);
            for (Object[] r : rows) {
                String u = r[0] == null ? null : String.valueOf(r[0]);
                if (u == null || u.length() == 0) continue;
                if (u.startsWith("gh_") || u.contains("@openim")) continue;
                out.add(new String[]{u, resolveName(u), u.endsWith("@chatroom") ? "1" : "0"});
            }
        } catch (Throwable t) { log("BLAST|list " + t); }
        return out;
    }

    private static void showBlastDialog(final android.app.Activity a) {
        toast("正在读取会话…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.List<String[]> convs = allConversations();
                a.runOnUiThread(new Runnable() {
                    @Override public void run() { buildBlastUI(a, convs); }
                });
            }
        }).start();
    }

    private static void buildBlastUI(final android.app.Activity a, final java.util.List<String[]> convs) {
        if (convs.isEmpty()) { toast("没有可发送的会话"); return; }
        final java.util.HashSet<String> sel = new java.util.HashSet<String>();
        final java.util.ArrayList<Integer> show = new java.util.ArrayList<Integer>();
        for (int i = 0; i < convs.size(); i++) show.add(i);

        final android.widget.EditText msg = new android.widget.EditText(a);
        msg.setHint("输入要群发的内容");
        msg.setTextSize(14);
        msg.setSingleLine(false);

        final android.widget.EditText search = new android.widget.EditText(a);
        search.setHint("搜索会话");
        search.setSingleLine(true);
        search.setTextSize(13);

        final android.widget.TextView cnt = new android.widget.TextView(a);
        cnt.setTextSize(13);
        cnt.setTextColor(0xFF666666);

        final android.widget.ListView lv = new android.widget.ListView(a);
        lv.setDivider(null);
        lv.setDividerHeight(0);
        final android.widget.BaseAdapter[] adRef = new android.widget.BaseAdapter[1];
        android.widget.BaseAdapter adapter = new android.widget.BaseAdapter() {
            @Override public int getCount() { return show.size(); }
            @Override public Object getItem(int i) { return convs.get(show.get(i))[0]; }
            @Override public long getItemId(int i) { return i; }
            @Override public android.view.View getView(int i, android.view.View cv, android.view.ViewGroup parent) {
                android.widget.LinearLayout row;
                if (cv instanceof android.widget.LinearLayout) row = (android.widget.LinearLayout) cv;
                else {
                    row = new android.widget.LinearLayout(a);
                    row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                    row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                    row.setPadding(dp(a, 14), dp(a, 10), dp(a, 14), dp(a, 10));
                    android.widget.TextView k = new android.widget.TextView(a);
                    k.setTag("k");
                    k.setTextSize(16);
                    row.addView(k, new android.widget.LinearLayout.LayoutParams(dp(a, 26), -2));
                    android.widget.TextView n = new android.widget.TextView(a);
                    n.setTag("n");
                    n.setTextSize(14);
                    n.setTextColor(0xFF1A1A1F);
                    n.setSingleLine(true);
                    row.addView(n, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
                    android.widget.TextView t = new android.widget.TextView(a);
                    t.setTag("t");
                    t.setTextSize(10);
                    t.setTextColor(0xFFAAAAAA);
                    row.addView(t);
                }
                final int gi = show.get(i);
                String[] c = convs.get(gi);
                boolean on = sel.contains(c[0]);
                android.widget.TextView k = (android.widget.TextView) row.findViewWithTag("k");
                android.widget.TextView n = (android.widget.TextView) row.findViewWithTag("n");
                android.widget.TextView t = (android.widget.TextView) row.findViewWithTag("t");
                k.setText(on ? "\u25cf" : "\u25cb");
                k.setTextColor(on ? 0xFF07C160 : 0xFFCCCCCC);
                n.setText(c[1]);
                t.setText("1".equals(c[2]) ? "群" : "好友");
                row.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        String id = convs.get(gi)[0];
                        if (!sel.remove(id)) sel.add(id);
                        if (adRef[0] != null) adRef[0].notifyDataSetChanged();
                        cnt.setText("已选 " + sel.size() + " 个");
                    }
                });
                return row;
            }
        };
        adRef[0] = adapter;
        lv.setAdapter(adapter);

        search.addTextChangedListener(new android.text.TextWatcher() {
            @Override public void beforeTextChanged(CharSequence s, int st, int c, int af) { }
            @Override public void onTextChanged(CharSequence s, int st, int b, int c) { }
            @Override public void afterTextChanged(android.text.Editable e) {
                String kw = e == null ? "" : e.toString().trim().toLowerCase();
                show.clear();
                for (int i = 0; i < convs.size(); i++) {
                    if (kw.length() == 0 || convs.get(i)[1].toLowerCase().contains(kw)) show.add(i);
                }
                if (adRef[0] != null) adRef[0].notifyDataSetChanged();
            }
        });

        cnt.setText("已选 0 个");
        android.widget.LinearLayout bottom = new android.widget.LinearLayout(a);
        bottom.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        bottom.setGravity(android.view.Gravity.CENTER_VERTICAL);
        bottom.setPadding(dp(a, 14), dp(a, 8), dp(a, 14), dp(a, 8));
        bottom.addView(cnt, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
        final android.widget.TextView btn = hubChip(a, "开始群发", true);
        bottom.addView(btn);

        android.widget.LinearLayout wrap = new android.widget.LinearLayout(a);
        wrap.setOrientation(android.widget.LinearLayout.VERTICAL);
        wrap.setBackground(roundRect(0xE2FFFFFF, dp(a, 18)));
        android.widget.TextView title = new android.widget.TextView(a);
        title.setText("群发助手");
        title.setTextSize(16);
        title.setTextColor(0xFF141418);
        title.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
        title.setPadding(dp(a, 16), dp(a, 14), dp(a, 16), dp(a, 6));
        wrap.addView(title);
        wrap.addView(msg, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 68)));
        wrap.addView(search, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 42)));
        wrap.addView(lv, new android.widget.LinearLayout.LayoutParams(-1, 0, 1f));
        wrap.addView(bottom, new android.widget.LinearLayout.LayoutParams(-1, -2));

        final android.app.Dialog dlg = new android.app.Dialog(a, android.R.style.Theme_Material_Light_NoActionBar);
        dlg.setContentView(wrap);
        dlg.show();
        try {
            android.view.Window w = dlg.getWindow();
            if (w != null) {
                w.setBackgroundDrawable(glassDrawable(a, 20));
                w.setLayout((int) (a.getResources().getDisplayMetrics().widthPixels * 0.92f),
                        (int) (a.getResources().getDisplayMetrics().heightPixels * 0.8f));
            }
        } catch (Throwable ignore) { }

        btn.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                String text = msg.getText().toString();
                if (text.trim().length() == 0) { toast("先输入内容"); return; }
                if (sel.isEmpty()) { toast("先选择会话"); return; }
                try { dlg.dismiss(); } catch (Throwable ignore) { }
                startBlast(a, new java.util.ArrayList<String>(sel), text);
            }
        });
    }

    private static void startBlast(android.app.Activity a, java.util.List<String> ids, String text) {
        blastQueue = ids;
        blastRetried.clear();
        blastText = text;
        blastTotal = ids.size();
        blastDone = 0;
        log("BLAST|start " + blastTotal);
        toast("开始群发 " + blastTotal + " 个会话");
        nextBlast(a);
    }

    private static void nextBlast(final android.app.Activity a) {
        if (blastQueue == null) return;
        if (blastQueue.isEmpty()) {
            toast("群发完成 " + blastDone + "/" + blastTotal);
            log("BLAST|done " + blastDone + "/" + blastTotal);
            blastQueue = null;
            return;
        }
        if (blastQueue.size() > 60) { toast("队列过长，已中止"); blastQueue = null; return; }
        final String id = blastQueue.remove(0);
        try {
            android.content.Intent it = new android.content.Intent();
            it.setClassName(a.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
            it.putExtra("Chat_User", resolveTalker(id));
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK
                    | android.content.Intent.FLAG_ACTIVITY_CLEAR_TOP
                    | android.content.Intent.FLAG_ACTIVITY_SINGLE_TOP);
            android.content.Intent _csw = prepareChatSwitch(a, it);
            if (_csw != null) a.startActivity(_csw);
        } catch (Throwable t) {
            log("BLAST|open " + id + " " + t);
            nextBlast(a);
            return;
        }
        waitAndSend(a, id, 0);
    }

    private static void waitAndSend(final android.app.Activity host, final String id, final int round) {
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        h.postDelayed(new Runnable() {
            @Override public void run() {
                try {
                    if (blastQueue == null) return;
                    if (round > 12) {
                        if (!blastRetried.contains(id)) {
                            blastRetried.add(id);
                            log("BLAST|retry " + id);
                            blastQueue.add(0, id);
                        } else {
                            log("BLAST|timeout " + id);
                        }
                        nextBlast(host);
                        return;
                    }
                    android.app.Activity ca = chatAct;
                    if (ca == null || chatTalker == null || !id.equals(chatTalker)) {
                        waitAndSend(host, id, round + 1);
                        return;
                    }
                    android.view.View root = ca.getWindow().getDecorView();
                    final android.widget.EditText et = findEditText(root);
                    if (et == null) { waitAndSend(host, id, round + 1); return; }
                    et.setText(blastText);
                    android.view.View btn = findSendButton(root);
                    if (btn == null) { waitAndSend(host, id, round + 1); return; }
                    btn.performClick();
                    blastDone++;
                    log("BLAST|sent " + id + " " + blastDone + "/" + blastTotal);
                    h.postDelayed(new Runnable() {
                        @Override public void run() { nextBlast(host); }
                    }, 900);
                } catch (Throwable t) {
                    log("BLAST|err " + t);
                    nextBlast(host);
                }
            }
        }, round == 0 ? 1200 : 400);
    }

    /** 批量：把选中的群加入某个分组 */
    private static void assignSelected(final android.app.Activity a) {
        if (hubSelected.isEmpty()) { toast("\u5148\u52fe\u9009\u7fa4"); return; }
        final org.json.JSONArray ar = foldGroupsOf();
        if (ar.length() == 0) {
            askNewGroupIds(a, new java.util.ArrayList<String>(hubSelected));
            return;
        }
        final String[] items = new String[ar.length() + 1];
        for (int i = 0; i < ar.length(); i++) {
            org.json.JSONObject g = ar.optJSONObject(i);
            String nm = g == null ? ("\u5206\u7ec4" + (i + 1)) : g.optString("name", "\u5206\u7ec4" + (i + 1));
            items[i] = nm + "\uff08" + idsOfGroup(ar, i).size() + "\uff09";
        }
        items[ar.length()] = "\uff0b \u65b0\u5efa\u5206\u7ec4";
        new android.app.AlertDialog.Builder(a)
            .setTitle("\u628a\u9009\u4e2d\u7684 " + hubSelected.size() + " \u4e2a\u7fa4\u52a0\u5165\u2026")
            .setItems(items, new android.content.DialogInterface.OnClickListener() {
                @Override public void onClick(android.content.DialogInterface d, int w) {
                    if (w == ar.length()) {
                        askNewGroupIds(a, new java.util.ArrayList<String>(hubSelected));
                        return;
                    }
                    try {
                        org.json.JSONObject g = ar.getJSONObject(w);
                        java.util.Set<String> cur = idsOfGroup(ar, w);
                        cur.addAll(hubSelected);
                        org.json.JSONArray na = new org.json.JSONArray();
                        for (String s2 : cur) na.put(s2);
                        g.put("ids", na);
                        ar.put(w, g);
                    } catch (Throwable ignore) { }
                    saveFoldGroups(ar);
                    toast("\u5df2\u52a0\u5165 " + hubSelected.size() + " \u4e2a\u7fa4");
                    hubSelected.clear();
                    hubSelectMode = false;
                    buildGroupHub(a);
                }
            })
            .setNegativeButton("\u53d6\u6d88", null)
            .show();
    }

    /** 新建分组并批量放入 */
    private static void askNewGroupIds(final android.app.Activity a, final java.util.List<String> ids) {
        final android.widget.EditText et = new android.widget.EditText(a);
        et.setHint("\u5982\uff1a\u5de5\u4f5c\u7fa4 / \u5bb6\u4eba / \u9879\u76eeA");
        et.setSingleLine(true);
        new android.app.AlertDialog.Builder(a)
            .setTitle("\u65b0\u5efa\u5206\u7ec4\u5e76\u52a0\u5165 " + ids.size() + " \u4e2a\u7fa4")
            .setView(et)
            .setPositiveButton("\u521b\u5efa", new android.content.DialogInterface.OnClickListener() {
                @Override public void onClick(android.content.DialogInterface d, int w) {
                    String nm = et.getText().toString().trim();
                    if (nm.length() == 0) { toast("\u540d\u5b57\u4e0d\u80fd\u4e3a\u7a7a"); return; }
                    org.json.JSONArray ar = foldGroupsOf();
                    try {
                        org.json.JSONObject g = new org.json.JSONObject();
                        g.put("name", nm);
                        org.json.JSONArray ja = new org.json.JSONArray();
                        for (String s2 : ids) ja.put(s2);
                        g.put("ids", ja);
                        ar.put(g);
                    } catch (Throwable ignore) { }
                    saveFoldGroups(ar);
                    hubFilter = ar.length() - 1;
                    hubSelected.clear();
                    hubSelectMode = false;
                    toast("\u5df2\u521b\u5efa\u300c" + nm + "\u300d");
                    if (hubGs != null) buildGroupHub(a);
                }
            })
            .setNegativeButton("\u53d6\u6d88", null)
            .show();
    }

    /** 长按群：选择归入哪些分组 */
    private static void showAssignDialog(final android.app.Activity a, final String id, final String nm) {
        final org.json.JSONArray ar = foldGroupsOf();
        if (ar.length() == 0) { askNewGroup(a, id); return; }
        final String[] names = new String[ar.length()];
        final boolean[] checked = new boolean[ar.length()];
        for (int i = 0; i < ar.length(); i++) {
            org.json.JSONObject g = ar.optJSONObject(i);
            names[i] = g == null ? ("分组" + (i + 1)) : g.optString("name", "分组" + (i + 1));
            checked[i] = idsOfGroup(ar, i).contains(id);
        }
        new android.app.AlertDialog.Builder(a)
            .setTitle("「" + nm + "」归到哪些分组")
            .setMultiChoiceItems(names, checked, new android.content.DialogInterface.OnMultiChoiceClickListener() {
                @Override public void onClick(android.content.DialogInterface d, int which, boolean isChecked) {
                    checked[which] = isChecked;
                }
            })
            .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                @Override public void onClick(android.content.DialogInterface d, int w) {
                    for (int i = 0; i < ar.length(); i++) {
                        try {
                            org.json.JSONObject g = ar.getJSONObject(i);
                            java.util.Set<String> cur = idsOfGroup(ar, i);
                            if (checked[i]) cur.add(id); else cur.remove(id);
                            org.json.JSONArray na = new org.json.JSONArray();
                            for (String s : cur) na.put(s);
                            g.put("ids", na);
                            ar.put(i, g);
                        } catch (Throwable ignore) { }
                    }
                    saveFoldGroups(ar);
                    toast("已更新分组");
                    buildGroupHub(a);
                }
            })
            .setNeutralButton("新建分组", new android.content.DialogInterface.OnClickListener() {
                @Override public void onClick(android.content.DialogInterface d, int w) { askNewGroup(a, id); }
            })
            .setNegativeButton("取消", null)
            .show();
    }

    /** 新建分组；withId 非空时顺便把该群放进去 */
    private static void askNewGroup(final android.app.Activity a, final String withId) {
        final android.widget.EditText et = new android.widget.EditText(a);
        et.setHint("如：工作群 / 家人 / 项目A");
        et.setSingleLine(true);
        new android.app.AlertDialog.Builder(a)
            .setTitle("新建分组")
            .setView(et)
            .setPositiveButton("创建", new android.content.DialogInterface.OnClickListener() {
                @Override public void onClick(android.content.DialogInterface d, int w) {
                    String nm = et.getText().toString().trim();
                    if (nm.length() == 0) { toast("名字不能为空"); return; }
                    org.json.JSONArray ar = foldGroupsOf();
                    try {
                        org.json.JSONObject g = new org.json.JSONObject();
                        g.put("name", nm);
                        org.json.JSONArray ids = new org.json.JSONArray();
                        if (withId != null) ids.put(withId);
                        g.put("ids", ids);
                        ar.put(g);
                    } catch (Throwable ignore) { }
                    saveFoldGroups(ar);
                    hubFilter = ar.length() - 1;
                    toast("已创建分组「" + nm + "」");
                    if (hubGs != null) buildGroupHub(a);
                }
            })
            .setNegativeButton("取消", null)
            .show();
    }

    /** 长按分组名：重命名 / 管理成员 / 删除 */
    private static void manageGroup(final android.app.Activity a, final int idx) {
        final org.json.JSONArray ar = foldGroupsOf();
        if (idx < 0 || idx >= ar.length()) return;
        final String nm = ar.optJSONObject(idx).optString("name", "分组");
        new android.app.AlertDialog.Builder(a)
            .setTitle(nm + " · " + idsOfGroup(ar, idx).size() + " 个群")
            .setItems(new String[]{"批量管理群（多选）", "重命名", "删除分组"},
                new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        if (w == 0) pickGroupMembers(a, idx);
                        else if (w == 1) renameGroup(a, idx);
                        else deleteGroup(a, idx);
                    }
                })
            .show();
    }

    private static void renameGroup(final android.app.Activity a, final int idx) {
        final org.json.JSONArray ar = foldGroupsOf();
        if (idx < 0 || idx >= ar.length()) return;
        final android.widget.EditText et = new android.widget.EditText(a);
        et.setText(ar.optJSONObject(idx).optString("name", ""));
        et.setSingleLine(true);
        new android.app.AlertDialog.Builder(a)
            .setTitle("重命名分组")
            .setView(et)
            .setPositiveButton("确定", new android.content.DialogInterface.OnClickListener() {
                @Override public void onClick(android.content.DialogInterface d, int w) {
                    String nm = et.getText().toString().trim();
                    if (nm.length() == 0) { toast("名字不能为空"); return; }
                    try {
                        org.json.JSONObject g = ar.getJSONObject(idx);
                        g.put("name", nm);
                        ar.put(idx, g);
                    } catch (Throwable ignore) { }
                    saveFoldGroups(ar);
                    buildGroupHub(a);
                }
            })
            .setNegativeButton("取消", null)
            .show();
    }

    private static void deleteGroup(final android.app.Activity a, final int idx) {
        final org.json.JSONArray ar = foldGroupsOf();
        if (idx < 0 || idx >= ar.length()) return;
        final String nm = ar.optJSONObject(idx).optString("name", "分组");
        new android.app.AlertDialog.Builder(a)
            .setTitle("删除分组")
            .setMessage("删除「" + nm + "」？群本身不受影响，只是不再归类。")
            .setPositiveButton("删除", new android.content.DialogInterface.OnClickListener() {
                @Override public void onClick(android.content.DialogInterface d, int w) {
                    org.json.JSONArray na = new org.json.JSONArray();
                    for (int i = 0; i < ar.length(); i++) {
                        if (i == idx) continue;
                        try { na.put(ar.get(i)); } catch (Throwable ignore) { }
                    }
                    saveFoldGroups(na);
                    hubFilter = -1;
                    buildGroupHub(a);
                }
            })
            .setNegativeButton("取消", null)
            .show();
    }

    /** 多选群成员（带搜索） */
    private static void pickGroupMembers(final android.app.Activity a, final int idx) {
        if (hubGs == null || hubGs.isEmpty()) { toast("群列表为空"); return; }
        final org.json.JSONArray ar = foldGroupsOf();
        if (idx < 0 || idx >= ar.length()) return;
        org.json.JSONObject go = ar.optJSONObject(idx);
        final String gname = go == null ? "分组" : go.optString("name", "分组");
        final int total = hubGs.size();
        final boolean[] checked = new boolean[total];
        java.util.Set<String> cur = idsOfGroup(ar, idx);
        for (int i = 0; i < total; i++) checked[i] = cur.contains(hubGs.get(i)[0]);

        final java.util.ArrayList<Integer> show = new java.util.ArrayList<Integer>();
        for (int i = 0; i < total; i++) show.add(i);

        final android.widget.EditText et = new android.widget.EditText(a);
        et.setHint("搜索群名");
        et.setSingleLine(true);
        et.setTextSize(14);
        et.setBackgroundColor(0xFFF4F5F7);

        final android.widget.TextView cnt = new android.widget.TextView(a);
        cnt.setTextSize(13);
        cnt.setTextColor(0xFF666666);
        cnt.setPadding(dp(a, 16), 0, 0, 0);

        final android.widget.ListView lv = new android.widget.ListView(a);
        lv.setDivider(null);
        lv.setDividerHeight(0);
        lv.setBackgroundColor(0xFFFFFFFF);

        final android.widget.BaseAdapter[] adRef2 = new android.widget.BaseAdapter[1];
        android.widget.BaseAdapter adapter = new android.widget.BaseAdapter() {
            @Override public int getCount() { return show.size(); }
            @Override public Object getItem(int i) { return hubGs.get(show.get(i))[0]; }
            @Override public long getItemId(int i) { return i; }
            @Override public android.view.View getView(int i, android.view.View cv, android.view.ViewGroup parent) {
                android.widget.LinearLayout row;
                if (cv instanceof android.widget.LinearLayout) {
                    row = (android.widget.LinearLayout) cv;
                } else {
                    row = new android.widget.LinearLayout(a);
                    row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                    row.setPadding(dp(a, 16), dp(a, 12), dp(a, 16), dp(a, 12));
                    row.setBackgroundColor(0xFFFFFFFF);
                    row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                    android.widget.TextView chk = new android.widget.TextView(a);
                    chk.setTag("k");
                    chk.setTextSize(17);
                    chk.setGravity(android.view.Gravity.CENTER);
                    row.addView(chk, new android.widget.LinearLayout.LayoutParams(dp(a, 30), dp(a, 30)));
                    android.widget.TextView nm = new android.widget.TextView(a);
                    nm.setTag("n");
                    nm.setTextSize(15);
                    nm.setTextColor(0xFF222222);
                    nm.setSingleLine(true);
                    row.addView(nm, new android.widget.LinearLayout.LayoutParams(0,
                            android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
                }
                final int gi = show.get(i);
                android.widget.TextView chk = (android.widget.TextView) row.findViewWithTag("k");
                android.widget.TextView nm = (android.widget.TextView) row.findViewWithTag("n");
                nm.setText(hubGs.get(gi)[1]);
                boolean on = checked[gi];
                chk.setText(on ? "\u25cf" : "\u25cb");
                chk.setTextColor(on ? 0xFF3E7BFA : 0xFFCCCCCC);
                row.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try {
                            checked[gi] = !checked[gi];
                            if (adRef2[0] != null) adRef2[0].notifyDataSetChanged();
                            cnt.setText(countText());
                        } catch (Throwable t) { log("PICK|toggle " + t); }
                    }
                });
                return row;
            }

            private String countText() {
                int n = 0;
                for (int k = 0; k < total; k++) if (checked[k]) n++;
                return "已选 " + n + " 个";
            }

            private void dummy() { }
        };
        adRef2[0] = adapter;
        lv.setAdapter(adapter);

        et.addTextChangedListener(new android.text.TextWatcher() {
            @Override public void beforeTextChanged(CharSequence s2, int st, int c, int af) { }
            @Override public void onTextChanged(CharSequence s2, int st, int b, int c) { }
            @Override public void afterTextChanged(android.text.Editable e2) {
                try {
                    String kw = e2 == null ? "" : e2.toString().trim().toLowerCase();
                    show.clear();
                    for (int i = 0; i < total; i++) {
                        String nm = hubGs.get(i)[1];
                        if (nm == null) nm = "";
                        if (kw.length() == 0 || nm.toLowerCase().contains(kw)) show.add(i);
                    }
                    if (adRef2[0] != null) adRef2[0].notifyDataSetChanged();
                } catch (Throwable t) { log("PICK|search " + t); }
            }
        });

        int selNow = 0;
        for (int i = 0; i < total; i++) if (checked[i]) selNow++;
        cnt.setText("已选 " + selNow + " 个");

        // 底部按钮
        android.widget.LinearLayout bottom = new android.widget.LinearLayout(a);
        bottom.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        bottom.setGravity(android.view.Gravity.CENTER_VERTICAL);
        bottom.setPadding(dp(a, 16), dp(a, 8), dp(a, 16), dp(a, 10));
        bottom.addView(cnt, new android.widget.LinearLayout.LayoutParams(0,
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
        final android.widget.TextView btnAll = hubChip(a, "全选结果", false);
        btnAll.setTextColor(0xFF3E7BFA);
        btnAll.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                for (int k = 0; k < show.size(); k++) checked[show.get(k)] = true;
                if (adRef2[0] != null) adRef2[0].notifyDataSetChanged();
                int n = 0;
                for (int k = 0; k < total; k++) if (checked[k]) n++;
                cnt.setText("已选 " + n + " 个");
            }
        });
        bottom.addView(btnAll);
        final android.widget.TextView btnSave = hubChip(a, "保存", true);
        bottom.addView(btnSave);

        android.widget.LinearLayout wrap = new android.widget.LinearLayout(a);
        wrap.setOrientation(android.widget.LinearLayout.VERTICAL);
        wrap.setBackgroundColor(0xFFFFFFFF);
        final android.app.Dialog[] dlgRef = new android.app.Dialog[1];
        android.widget.LinearLayout titleRow = new android.widget.LinearLayout(a);
        titleRow.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        titleRow.setGravity(android.view.Gravity.CENTER_VERTICAL);
        titleRow.setPadding(dp(a, 16), dp(a, 12), dp(a, 12), dp(a, 6));
        android.widget.TextView title = new android.widget.TextView(a);
        title.setText("「" + gname + "」添加群");
        title.setTextSize(16);
        title.setTextColor(0xFF111111);
        titleRow.addView(title, new android.widget.LinearLayout.LayoutParams(0,
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
        android.widget.TextView btnRename = hubChip(a, "改名", false);
        btnRename.setTextColor(0xFF666666);
        btnRename.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                try { if (dlgRef[0] != null) dlgRef[0].dismiss(); } catch (Throwable ignore) { }
                renameGroup(a, idx);
            }
        });
        titleRow.addView(btnRename);
        android.widget.TextView btnDel = hubChip(a, "删除", false);
        btnDel.setTextColor(0xFFE54D4D);
        btnDel.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                try { if (dlgRef[0] != null) dlgRef[0].dismiss(); } catch (Throwable ignore) { }
                deleteGroup(a, idx);
            }
        });
        titleRow.addView(btnDel);
        wrap.addView(titleRow);
        wrap.addView(et, new android.widget.LinearLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(a, 40)));
        android.widget.LinearLayout.LayoutParams elp = (android.widget.LinearLayout.LayoutParams) et.getLayoutParams();
        elp.leftMargin = dp(a, 16);
        elp.rightMargin = dp(a, 16);
        wrap.addView(lv, new android.widget.LinearLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
        wrap.addView(bottom, new android.widget.LinearLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.MATCH_PARENT, android.view.ViewGroup.LayoutParams.WRAP_CONTENT));

        final android.app.Dialog dlg = new android.app.Dialog(a, android.R.style.Theme_Material_Light_NoActionBar);
        dlg.setContentView(wrap);
        dlg.show();
        dlgRef[0] = dlg;
        try {
            android.view.Window w = dlg.getWindow();
            if (w != null) {
                w.setLayout(android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                        (int) (a.getResources().getDisplayMetrics().heightPixels * 0.82));
            }
        } catch (Throwable ignore) { }

        btnSave.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                try {
                    org.json.JSONArray ar2 = foldGroupsOf();
                    org.json.JSONObject g = ar2.getJSONObject(idx);
                    org.json.JSONArray ids = new org.json.JSONArray();
                    int n = 0;
                    for (int i = 0; i < total; i++) {
                        if (checked[i]) { ids.put(hubGs.get(i)[0]); n++; }
                    }
                    g.put("ids", ids);
                    ar2.put(idx, g);
                    saveFoldGroups(ar2);
                    toast("「" + gname + "」共 " + n + " 个群");
                } catch (Throwable t) { toast("保存失败 " + t); }
                try { dlg.dismiss(); } catch (Throwable ignore) { }
                buildGroupHub(a);
            }
        });
    }

    /** 关键词 → 推荐话术。默认规则可按需改，存在 cfg.recoRules（"关键词|话术" 数组）时优先用它 */
    private static String[][] recoRules() {
        try {
            org.json.JSONArray a = cfg().optJSONArray("recoRules");
            if (a != null && a.length() > 0) {
                String[][] r = new String[a.length()][];
                for (int i = 0; i < a.length(); i++) {
                    String v = a.optString(i, "");
                    int p1 = v.indexOf('|');
                    if (p1 <= 0) continue;
                    r[i] = new String[]{v.substring(0, p1), v.substring(p1 + 1)};
                }
                return r;
            }
        } catch (Throwable ignore) { }
        return new String[][]{
                {"多少钱", "您好，我这边给您报个价，方便的话说一下用量，我按量给最优价 👍"},
                {"价格", "您好，具体价格看规格和数量，您想了解哪一款？我发您详细报价单"},
                {"怎么卖", "您好，我们按件/按批发价走，量大有优惠，您大概需要多少？"},
                {"报价", "好的，我整理一份报价给您，稍等两分钟"},
                {"优惠", "这几天有活动，量大可以申请额外折扣，您计划什么时候要？"},
                {"地址", "我们在XX，支持发货上门，您发我具体地址我看看运费"},
                {"发货", "今天下单当天可以发出，物流单号出来后我发您"},
                {"在吗", "在的，您说 👍"}
        };
    }

    private static String lastAskText() {
        try {
            if (chatTalker == null) return "";
            java.util.List<Object[]> r = queryRows(
                    "select ifnull(content,'') from message where talker='" + escSql(chatTalker)
                            + "' and isSend=0 order by createTime desc limit 1", 1);
            if (r.isEmpty()) return "(无对方消息)";
            String t = String.valueOf(r.get(0)[0]);
            return t.length() > 30 ? t.substring(0, 30) : t;
        } catch (Throwable ignore) { return "(err)"; }
    }

    /** 找出「客户最后问的话」，命中关键词就返回 {关键词, 话术}，否则 null */
    private static String[] recoForLastAsk() {
        try {
            if (chatTalker == null || chatTalker.endsWith("@chatroom")) return null;
            java.util.List<Object[]> r = queryRows(
                    "select ifnull(content,'') from message where talker='" + escSql(chatTalker)
                            + "' and isSend=0 order by createTime desc limit 1", 1);
            if (r.isEmpty()) return null;
            String txt = String.valueOf(r.get(0)[0]);
            if (txt == null || txt.length() == 0) return null;
            for (String[] rule : recoRules()) {
                if (rule == null || rule.length < 2) continue;
                if (txt.contains(rule[0])) return rule;
            }
        } catch (Throwable ignore) { }
        return null;
    }

    private static long recoAt = 0;
    private static long recoLogAt = 0;

    /** 产品库：每项 "名称|规格|单价"（配置文件 products 数组） */
    private static java.util.List<String[]> productList() {
        java.util.List<String[]> out = new java.util.ArrayList<String[]>();
        try {
            org.json.JSONArray a = cfg().optJSONArray("products");
            if (a != null) for (int i = 0; i < a.length(); i++) {
                String v = a.optString(i, "");
                String[] p = v.split("\\|");
                if (p.length >= 1 && p[0].trim().length() > 0) {
                    out.add(new String[]{
                            p[0].trim(),
                            p.length > 1 ? p[1].trim() : "",
                            p.length > 2 ? p[2].trim() : ""
                    });
                }
            }
        } catch (Throwable ignore) { }
        return out;
    }

    /** 生成报价单文本 */
    private static String buildQuote(java.util.List<String[]> picked) {
        StringBuilder sb = new StringBuilder("【报价单】\n");
        double total = 0;
        int no = 0;
        for (String[] it : picked) {
            no++;
            String price = it[2].length() == 0 ? (it[1].length() == 0 ? "" : it[1]) : it[2];
            String spec = it[2].length() == 0 ? "" : it[1];
            sb.append(no).append(". ").append(it[0]);
            if (spec.length() > 0) sb.append("（").append(spec).append("）");
            if (price.length() > 0) {
                sb.append("  ￥").append(price);
                try { total += Double.parseDouble(price.replaceAll("[^0-9.]", "")); } catch (Throwable ignore) { }
            }
            sb.append('\n');
        }
        if (total > 0) sb.append("合计：￥").append(total == Math.rint(total)
                ? String.valueOf((long) total) : String.format(java.util.Locale.US, "%.2f", total)).append('\n');
        sb.append("（价格有效期 3 天，含税，运费另计）");
        return sb.toString();
    }

    private static java.io.File dealsFile() { return new java.io.File(DIR, "deals.jsonl"); }

    private static void addDeal(String cust, String prod, double amt) {
        try {
            org.json.JSONObject o = new org.json.JSONObject();
            o.put("ts", System.currentTimeMillis());
            o.put("cust", cust == null ? "" : cust);
            o.put("prod", prod == null ? "" : prod);
            o.put("amt", amt);
            java.io.FileWriter fw = new java.io.FileWriter(dealsFile(), true);
            fw.write(o.toString() + "\n");
            fw.close();
            log("DEAL|add cust=" + cust + " amt=" + amt);
        } catch (Throwable t) {
            log("DEAL|err " + t);
        }
    }

    /** 返回 {本月单数, 本月金额, 上月单数, 上月金额, 累计单数, 累计金额} */
    private static String[] dealStats() {
        int nCur = 0, nPrev = 0, nAll = 0;
        double aCur = 0, aPrev = 0, aAll = 0;
        try {
            java.io.File f = dealsFile();
            if (f.exists()) {
                java.text.SimpleDateFormat ym = new java.text.SimpleDateFormat("yyyy-MM", java.util.Locale.US);
                String cur = ym.format(new java.util.Date());
                String prev = ym.format(new java.util.Date(System.currentTimeMillis() - 30L * 86400000L));
                java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
                String ln;
                while ((ln = br.readLine()) != null) {
                    ln = ln.trim();
                    if (ln.length() == 0) continue;
                    try {
                        org.json.JSONObject o = new org.json.JSONObject(ln);
                        long ts = o.optLong("ts", 0);
                        double amt = o.optDouble("amt", 0);
                        String m = ym.format(new java.util.Date(ts));
                        nAll++; aAll += amt;
                        if (m.equals(cur)) { nCur++; aCur += amt; }
                        else if (m.equals(prev)) { nPrev++; aPrev += amt; }
                    } catch (Throwable ignore) { }
                }
                br.close();
            }
        } catch (Throwable ignore) { }
        return new String[]{String.valueOf(nCur), fmtMoney(aCur), String.valueOf(nPrev), fmtMoney(aPrev),
                String.valueOf(nAll), fmtMoney(aAll)};
    }

    private static String fmtMoney(double v) {
        return v == Math.rint(v) ? String.valueOf((long) v)
                : String.format(java.util.Locale.US, "%.2f", v);
    }

    private static void showDealLog(final android.app.Activity a) {
        try {
            String[] st = dealStats();
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 16), dp(a, 10), dp(a, 16), dp(a, 6));

            android.widget.TextView sum = new android.widget.TextView(a);
            sum.setTextSize(13);
            sum.setTextColor(0xFF2E7D32);
            sum.setText("本月 " + st[0] + " 单 / ￥" + st[1]
                    + "\n上月 " + st[2] + " 单 / ￥" + st[3]
                    + "\n累计 " + st[4] + " 单 / ￥" + st[5]);
            box.addView(sum);

            final android.widget.EditText cust = new android.widget.EditText(a);
            cust.setHint("客户名（可空）");
            cust.setTextSize(13);
            box.addView(cust);
            final android.widget.EditText prod = new android.widget.EditText(a);
            prod.setHint("产品 / 内容");
            prod.setTextSize(13);
            box.addView(prod);
            final android.widget.EditText amt = new android.widget.EditText(a);
            amt.setHint("金额（数字）");
            amt.setTextSize(13);
            amt.setInputType(android.text.InputType.TYPE_CLASS_NUMBER
                    | android.text.InputType.TYPE_NUMBER_FLAG_DECIMAL);
            box.addView(amt);

            new android.app.AlertDialog.Builder(a)
                    .setTitle("成交登记")
                    .setView(box)
                    .setPositiveButton("记一笔", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            double v = 0;
                            try { v = Double.parseDouble(amt.getText().toString().trim()); } catch (Throwable ignore) { }
                            if (v <= 0) { toast("请填金额"); return; }
                            addDeal(cust.getText().toString().trim(), prod.getText().toString().trim(), v);
                            String[] s2 = dealStats();
                            toast("已记录\n本月 " + s2[0] + " 单 / ￥" + s2[1]);
                        }
                    })
                    .setNeutralButton("导出 CSV", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            exportDeals();
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) {
            toast("成交面板出错：" + t);
        }
    }

    private static void exportDeals() {
        try {
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            java.io.File out = new java.io.File(dir, "deals_" + stamp + ".csv");
            java.io.FileWriter fw = new java.io.FileWriter(out, false);
            fw.write("\uFEFF时间,客户,产品,金额\n");
            java.io.File f = dealsFile();
            int n = 0;
            if (f.exists()) {
                java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
                String ln;
                while ((ln = br.readLine()) != null) {
                    ln = ln.trim();
                    if (ln.length() == 0) continue;
                    try {
                        org.json.JSONObject o = new org.json.JSONObject(ln);
                        fw.write(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                                        .format(new java.util.Date(o.optLong("ts", 0))) + ","
                                + csv(o.optString("cust", "")) + "," + csv(o.optString("prod", "")) + ","
                                + fmtMoney(o.optDouble("amt", 0)) + "\n");
                        n++;
                    } catch (Throwable ignore) { }
                }
                br.close();
            }
            fw.close();
            toast("已导出 " + n + " 条成交记录\n" + out.getAbsolutePath());
            askShare(out);
            log("DEALEXPORT|n=" + n + " path=" + out.getAbsolutePath());
        } catch (Throwable t) {
            log("DEALEXPORT|err " + t);
        }
    }

    private static void showQuoteGen(final android.app.Activity a) {
        try {
            final java.util.List<String[]> ps = productList();
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            box.setPadding(dp(a, 16), dp(a, 10), dp(a, 16), dp(a, 6));

            final android.widget.EditText add = new android.widget.EditText(a);
            add.setHint("新增产品，格式：名称|规格|单价");
            add.setTextSize(13);
            box.addView(add);
            android.widget.TextView tip = new android.widget.TextView(a);
            tip.setTextSize(11);
            tip.setTextColor(0xFF9A9AA3);
            tip.setText("例：保温杯|500ml|39.9    （勾选后点生成，文本自动插入输入框）");
            box.addView(tip);

            final android.widget.ListView lv = new android.widget.ListView(a);
            final java.util.ArrayList<String> names = new java.util.ArrayList<String>();
            for (String[] it : ps) {
                names.add(it[0] + (it[1].length() > 0 ? "（" + it[1] + "）" : "")
                        + (it[2].length() > 0 ? "  ￥" + it[2] : ""));
            }
            lv.setAdapter(new android.widget.ArrayAdapter<String>(a,
                    android.R.layout.simple_list_item_multiple_choice, names));
            lv.setChoiceMode(android.widget.ListView.CHOICE_MODE_MULTIPLE);
            box.addView(lv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 240)));

            new android.app.AlertDialog.Builder(a)
                    .setTitle("报价单生成")
                    .setView(box)
                    .setPositiveButton("生成并插入", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            java.util.List<String[]> picked = new java.util.ArrayList<String[]>();
                            for (int i = 0; i < ps.size(); i++) if (lv.isItemChecked(i)) picked.add(ps.get(i));
                            if (picked.isEmpty()) { toast("至少勾一个产品"); return; }
                            String txt = buildQuote(picked);
                            android.widget.EditText et2 = currentInput();
                            if (et2 == null) { toast("请先进入聊天页"); return; }
                            int st = et2.getSelectionStart();
                            if (st < 0) st = et2.getText().length();
                            et2.getText().insert(st, txt);
                            toast("报价单已插入");
                            log("QUOTE|n=" + picked.size() + " len=" + txt.length());
                        }
                    })
                    .setNeutralButton("保存新品类", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            String v = add.getText() == null ? "" : add.getText().toString().trim();
                            if (v.length() == 0) { toast("请输入产品"); return; }
                            try {
                                JSONObject o = readCfg();
                                org.json.JSONArray arr = o.optJSONArray("products");
                                if (arr == null) arr = new org.json.JSONArray();
                                arr.put(v);
                                o.put("products", arr);
                                writeCfg(o);
                                cfg = null; cfgAt = 0; cfgChkAt = 0;
                                toast("已保存：" + v);
                            } catch (Throwable t) { toast("保存失败"); }
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) {
            toast("报价单面板出错：" + t);
        }
    }

    /**
     * 群活跃度下降预警：每天一次，比较「近 7 天」和「近 30 天摊到 7 天」，
     * 近 7 天不足预期的 50% 且 30 天总量 >= 30 条 → 判定降温。
     */
    private static long declineAt = 0;
    private static String declineSig = "";

    private static void notifyDeclineIfDue() {
        try {
            if (!cfg().optBoolean("declineWarn", false)) return;
            long now = System.currentTimeMillis();
            if (now - declineAt < 24 * 3600L * 1000L) return;
            declineAt = now;
            if (inQuietHours()) { log("GDECLINE|quiet"); return; }

            long s7 = now - 7L * 86400000L;
            long s30 = now - 30L * 86400000L;
            java.util.HashMap<String, Integer> c7 = new java.util.HashMap<String, Integer>();
            java.util.HashMap<String, Integer> c30 = new java.util.HashMap<String, Integer>();
            for (Object[] r : queryRows("select talker, count(*) from message where createTime > "
                    + s30 + " group by talker", 2)) {
                String tk = String.valueOf(r[0]);
                if (!tk.endsWith("@chatroom")) continue;
                int n = 0;
                try { n = Integer.parseInt(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                c30.put(tk, Integer.valueOf(n));
            }
            for (Object[] r : queryRows("select talker, count(*) from message where createTime > "
                    + s7 + " group by talker", 2)) {
                String tk = String.valueOf(r[0]);
                int n = 0;
                try { n = Integer.parseInt(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                c7.put(tk, Integer.valueOf(n));
            }
            java.util.List<String[]> hits = new java.util.ArrayList<String[]>();
            for (String tk : c30.keySet()) {
                int n30 = c30.get(tk).intValue();
                if (n30 < 30) continue;
                int n7 = c7.containsKey(tk) ? c7.get(tk).intValue() : 0;
                double expect = n30 * 7.0 / 30.0;
                if (n7 < expect * 0.5) {
                    int drop = (int) Math.round((1 - n7 / Math.max(expect, 1)) * 100);
                    hits.add(new String[]{tk, displayOfTalker(tk), String.valueOf(n7),
                            String.valueOf(n30), String.valueOf(drop)});
                }
            }
            java.util.Collections.sort(hits, new java.util.Comparator<String[]>() {
                @Override public int compare(String[] a, String[] b) {
                    return Integer.parseInt(b[3]) - Integer.parseInt(a[3]);
                }
            });
            if (hits.isEmpty()) { log("GDECLINE|none"); return; }
            StringBuilder sig = new StringBuilder();
            StringBuilder body = new StringBuilder();
            for (int i = 0; i < hits.size(); i++) {
                sig.append(hits.get(i)[0]).append(':').append(hits.get(i)[2]).append(';');
                if (i < 3) {
                    if (body.length() > 0) body.append('、');
                    body.append(hits.get(i)[1]).append("（-").append(hits.get(i)[4]).append("%）");
                }
            }
            if (sig.toString().equals(declineSig)) { log("GDECLINE|same"); return; }
            declineSig = sig.toString();
            notifyLocal(mainAct != null ? mainAct : chatAct,
                    "群活跃度下降 " + hits.size() + " 个",
                    body + (hits.size() > 3 ? " 等" : "") + " · 近 7 天明显变冷");
            log("GDECLINE|n=" + hits.size() + " body=" + body);
        } catch (Throwable t) {
            log("GDECLINE|err " + t);
        }
    }

