/** 插件：红包提醒。由 Probe.loadPlugin() 从 /data/data/com.tencent.mm/files/wxh_plugin.dex 加载。 */
public final class Plugin {
    private static final String DIR = mmBase() + "/files";

    /** 微信数据根目录：主号 /data/data/com.tencent.mm；分身（多用户）自动换成 /data/user/<id>/com.tencent.mm */
    /** 当前运行的微信包名（主号或分身/克隆），用于拉起页面、发 Intent */
    public static String wxPkg() {
        try {
            android.app.Application app = android.app.AndroidAppHelper.currentApplication();
            if (app != null) {
                String pn = app.getPackageName();
                if (pn != null && pn.length() > 0) return pn;
            }
        } catch (Throwable ignore) { }
        return "com.tencent.mm";
    }

    public static String mmBase() {
        try {
            android.app.Application app = android.app.AndroidAppHelper.currentApplication();
            if (app != null) {
                String p = app.getFilesDir().getAbsolutePath();
                if (p != null && p.endsWith("/files")) return p.substring(0, p.length() - "/files".length());
            }
        } catch (Throwable ignore) { }
        try {
            int user = android.os.Process.myUid() / 100000;
            if (user > 0) return "/data/user/" + user + "/com.tencent.mm";
        } catch (Throwable ignore) { }
        return "/data/data/com.tencent.mm";
    }


