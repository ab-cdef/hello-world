    /** 真正干活的：扫描并写 CSV，返回条目数（无界面可调） */
    private static int buildFollowUp(int hours, android.app.Activity a) {
        int n = 0;
        try {
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            java.io.File out = new java.io.File(dir, "followup_" + stamp + ".csv");
            java.io.FileWriter fw = new java.io.FileWriter(out, false);
            fw.write("\uFEFF会话,类型,最后发言时间,未回小时,最后内容,发送人\n");
            long now = System.currentTimeMillis();
            long th = hours * 3600L * 1000L;
            java.util.List<Object[]> rows = queryRows(
                    "select username, conversationTime from rconversation"
                            + " where username not like 'gh_%' and username not in ('filehelper','weixin')"
                            + " order by conversationTime desc limit 300", 2);
            for (Object[] r : rows) {
                String tk = String.valueOf(r[0]);
                long ct = 0;
                try { ct = Long.parseLong(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                if (ct <= 0 || now - ct < th) continue;
                java.util.List<Object[]> last = queryRows(
                        "select isSend, createTime, content, type from message where talker='"
                                + tk.replace("'", "''") + "' order by createTime desc limit 1", 4);
                if (last.isEmpty()) continue;
                String isSend = String.valueOf(last.get(0)[0]).trim();
                if (!"1".equals(isSend)) continue;              // 最后一条不是我发的 → 不需要跟进
                long lct = 0;
                try { lct = Long.parseLong(String.valueOf(last.get(0)[1]).trim()); } catch (Throwable ignore) { }
                if (lct > 0 && lct < 100000000000L) lct *= 1000L;
                String content = String.valueOf(last.get(0)[2]);
                if (content == null) content = "";
                if (content.length() > 60) content = content.substring(0, 60);
                if (content.startsWith("<")) content = "[非文本]";
                int type = 1;
                try { type = Integer.parseInt(String.valueOf(last.get(0)[3]).trim()); } catch (Throwable ignore) { }
                if (type != 1) content = "[" + typeLabel(type) + "]";
                long waitH = (now - lct) / 3600000L;
                String kind = tk.endsWith("@chatroom") ? "群" : "私聊";
                String name = displayOfTalker(tk);
                fw.write(csv(name) + "," + kind + ","
                        + new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US)
                                .format(new java.util.Date(lct)) + ","
                        + waitH + "," + csv(content) + ",\n");
                n++;
            }
            fw.close();
            log("FOLLOWUP|hours=" + hours + " n=" + n + " path=" + out.getAbsolutePath());
            if (a != null) toast("待跟进 " + n + " 个\n" + out.getAbsolutePath());
        } catch (Throwable t) {
            log("FOLLOWUP|err " + t);
        }
        return n;
    }

    private static String csv(String v) {
        if (v == null) return "";
        return v.replace(',', '，').replace('\n', ' ');
    }

    private static java.util.Map<String, String> nameMap = new java.util.HashMap<String, String>();

    private static void loadNameMap(Object db) {
        if (!nameMap.isEmpty()) return;
        try {
            Object cur = null;
            for (Method m : db.getClass().getMethods()) {
                if (!m.getName().equals("rawQuery")) continue;
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length != 2 || ps[0] != String.class) continue;
                Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                m.setAccessible(true);
                cur = m.invoke(db, "select username,nickname,conRemark from rcontact", arg);
                break;
            }
            if (cur == null) return;
            Method mv = cur.getClass().getMethod("moveToNext");
            Method gs = cur.getClass().getMethod("getString", int.class);
            while ((Boolean) mv.invoke(cur)) {
                String u = (String) gs.invoke(cur, 0);
                String nick = (String) gs.invoke(cur, 1);
                String rm = (String) gs.invoke(cur, 2);
                if (u == null) continue;
                String label = (rm != null && rm.length() > 0) ? rm : nick;
                nameMap.put(u, label == null ? u : label);
            }
            try {
                cur.getClass().getMethod("close").invoke(cur);
            } catch (Throwable t) {
            }
        } catch (Throwable t) {
        }
    }

    /** 把 XML 内容转成可读文字 */
    private static String prettyContent(String c) {
        if (c == null) return "";
        String t = c;
        if (t.contains(":<msg")) t = t.substring(t.indexOf(":<msg") + 1);
        if (t.contains("<msg")) {
            String title = tagOf(t, "title");
            if (title.length() > 0) return "[链接] " + title;
            String des = tagOf(t, "des");
            if (des.length() > 0) return des;
            return "[卡片消息]";
        }
        // 处理 HTML 实体
        t = t.replace("&#x0A;", " ").replace("&#x0a;", " ").replace("&lt;", "<").replace("&gt;", ">")
             .replace("&amp;", "&").replace("&quot;", "\"");
        t = t.replaceAll("&#x[0-9A-Fa-f]{2};", " ");
        // 旧前缀逻辑（已由 lastMsgOf 统一处理）
        try {
            int ip = -1;
            if (ip > 0 && ip < 60) {
                String head = t.substring(0, ip);
                if (head.startsWith("wxid_") || head.endsWith("@chatroom") || head.contains("openim")) {
                    String nm2 = null;
                    if (nameMap != null) nm2 = nameMap.get(head);
                    if (nm2 == null) {
                        java.util.List<Object[]> rr2 = queryRows(
                            "select conRemark, nickname from rcontact where username='" + head + "'", 2);
                        if (!rr2.isEmpty()) {
                            Object a1 = rr2.get(0)[0], a2 = rr2.get(0)[1];
                            if (a1 != null && String.valueOf(a1).length() > 0) nm2 = String.valueOf(a1);
                            else if (a2 != null && String.valueOf(a2).length() > 0) nm2 = String.valueOf(a2);
                        }
                    }
                    if (nm2 != null && nm2.length() > 0) t = nm2 + ":" + t.substring(ip + 1);
                }
            }
        } catch (Throwable ignore) { }
        t = t.replaceAll("<[^>]+>", " ");
        t = t.replace('\n', ' ').trim();
        if (t.length() > 80) t = t.substring(0, 80);
        return t;
    }

    /** 当前聊天标题（优先取界面上的标题，其次查库） */
    private static String currentChatName() {
        try {
            android.app.Activity ca = chatAct;
            if (ca != null) {
                try {
                    CharSequence t = ca.getTitle();
                    if (t != null && t.length() > 0 && !t.toString().contains("微信")) return t.toString();
                } catch (Throwable ignore) { }
                // 顶部标题栏：屏幕上方 15% 区域内字号最大的文本
                android.view.View decor = ca.getWindow().getDecorView();
                int limitY = (int) (ca.getResources().getDisplayMetrics().heightPixels * 0.16f);
                String best = null;
                float bestSize = -1;
                java.util.ArrayList<android.widget.TextView> tvs = new java.util.ArrayList<android.widget.TextView>();
                collectTexts(decor, tvs, 0);
                int[] loc = new int[2];
                for (android.widget.TextView tv : tvs) {
                    try {
                        if (tv.getText() == null || tv.getText().length() == 0) continue;
                        tv.getLocationOnScreen(loc);
                        if (loc[1] > limitY) continue;
                        if (tv.getTextSize() > bestSize) { bestSize = tv.getTextSize(); best = tv.getText().toString(); }
                    } catch (Throwable ignore) { }
                }
                if (best != null && best.length() > 0) return best;
            }
        } catch (Throwable ignore) { }
        String tk = currentTalker();
        return tk == null ? "" : resolveName(tk);
    }

    /** 取当前聊天真正在用的输入框 */
    private static android.widget.EditText currentInput() {
        try {
            android.app.Activity ca = chatAct;
            if (ca == null) return null;
            return findEditText(ca.getWindow().getDecorView());
        } catch (Throwable t) { return null; }
    }

    private static void copyText(android.content.Context c, String txt) {
        try {
            android.content.ClipboardManager cm = (android.content.ClipboardManager)
                    c.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
            cm.setPrimaryClip(android.content.ClipData.newPlainText("H", txt));
            toast("已复制，粘贴即可");
        } catch (Throwable t) { toast("复制失败"); }
    }

    private static boolean fillInput(final android.widget.EditText fallback, String txt) {
        try {
            android.widget.EditText target = currentInput();
            if (target == null) target = fallback;
            if (target == null) return false;
            int st = target.getSelectionStart();
            if (st < 0) st = target.getText().length();
            target.getText().insert(st, txt);
            target.setSelection(st + txt.length());
            target.requestFocus();
            try {
                android.view.inputmethod.InputMethodManager imm =
                        (android.view.inputmethod.InputMethodManager)
                                target.getContext().getSystemService(android.content.Context.INPUT_METHOD_SERVICE);
                if (imm != null) imm.showSoftInput(target, 0);
            } catch (Throwable ignore) { }
            toast("已填入输入框");
            return true;
        } catch (Throwable t) { log("AI|fill " + t); return false; }
    }

    /** 保存一条 AI 生成记录 */
    private static void saveAiHistory(final String talker, final String analysis,
                                      final java.util.ArrayList<String> opts) {
        try {
            JSONObject o = readCfg();
            org.json.JSONArray arr = o.optJSONArray("aiHistory");
            if (arr == null) arr = new org.json.JSONArray();
            org.json.JSONObject item = new JSONObject();
            item.put("t", System.currentTimeMillis());
            item.put("c", resolveName(talker));
            item.put("a", analysis == null ? "" : analysis);
            org.json.JSONArray os = new org.json.JSONArray();
            for (String s0 : opts) os.put(s0);
            item.put("o", os);
            arr.put(item);
            while (arr.length() > 50) arr.remove(0);
            o.put("aiHistory", arr);
            writeCfg(o);
            cfg = null;
            cfgAt = 0;
        } catch (Throwable t) { log("AIHIST|" + t); }
    }

    private static void showAiHistory(final android.app.Activity a) {
        try {
            org.json.JSONArray arr = cfg().optJSONArray("aiHistory");
            if (arr == null || arr.length() == 0) { toast("还没有记录"); return; }
            StringBuilder sb = new StringBuilder();
            java.text.SimpleDateFormat f = new java.text.SimpleDateFormat("MM-dd HH:mm");
            for (int i = arr.length() - 1; i >= 0; i--) {
                org.json.JSONObject it = arr.optJSONObject(i);
                if (it == null) continue;
                sb.append(f.format(new java.util.Date(it.optLong("t")))).append("  ")
                  .append(it.optString("c")).append('\n');
                String an = it.optString("a", "");
                if (an.length() > 0) sb.append("  ").append(an).append('\n');
                org.json.JSONArray os = it.optJSONArray("o");
                if (os != null) for (int k = 0; k < os.length(); k++) {
                    sb.append("  · ").append(os.optString(k)).append('\n');
                }
                sb.append('\n');
            }
            android.widget.TextView tv = new android.widget.TextView(a);
            tv.setText(sb.toString());
            tv.setTextSize(11);
            tv.setTextColor(0xFF333333);
            tv.setPadding(dp(a, 14), dp(a, 12), dp(a, 14), dp(a, 12));
            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            sv.addView(tv);
            new android.app.AlertDialog.Builder(a)
                    .setTitle("AI 回复历史")
                    .setView(sv)
                    .setPositiveButton("关闭", null)
                    .setNeutralButton("清空", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                JSONObject o = readCfg();
                                o.put("aiHistory", new org.json.JSONArray());
                                writeCfg(o);
                                cfg = null;
                                cfgAt = 0;
                                toast("已清空");
                            } catch (Throwable ignore) { }
                        }
                    })
                    .show();
        } catch (Throwable t) { toast("读取失败"); }
    }

    /** AI 候选回复选择面板（与分析依据、AI 分析同屏） */
    private static void showAiChooser(final android.app.Activity a, final android.widget.EditText et,
                                      final java.util.ArrayList<String> opts, final String ctx,
                                      final java.util.LinkedHashMap<String, String> fields,
                                      final String talker, final String targetMsg) {
        try {
            android.widget.LinearLayout wrap = new android.widget.LinearLayout(a);
            wrap.setOrientation(android.widget.LinearLayout.VERTICAL);
            wrap.setBackground(roundRect(0xE2FFFFFF, dp(a, 18)));
            wrap.setPadding(dp(a, 14), dp(a, 12), dp(a, 14), dp(a, 10));

            android.widget.LinearLayout head = new android.widget.LinearLayout(a);
            head.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            head.setGravity(android.view.Gravity.CENTER_VERTICAL);
            android.widget.TextView bar = new android.widget.TextView(a);
            bar.setBackground(roundRect(0xFF07C160, dp(a, 2)));
            head.addView(bar, new android.widget.LinearLayout.LayoutParams(dp(a, 3), dp(a, 14)));
            android.widget.TextView title = new android.widget.TextView(a);
            title.setText("选择回复");
            title.setTextSize(15);
            title.setTextColor(0xFF141418);
            title.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
            title.setPadding(dp(a, 8), 0, 0, 0);
            head.addView(title);
            wrap.addView(head);

            android.widget.TextView who = new android.widget.TextView(a);
            String tkShow = resolveRowTalker();
            who.setText("会话：" + (tkShow != null && tkShow.length() > 0
                    ? displayOfTalker(tkShow) : currentChatName()));
            who.setTextSize(11);
            who.setTextColor(0xFF9A9AA2);
            who.setPadding(dp(a, 11), dp(a, 4), 0, 0);
            wrap.addView(who);
            if (targetMsg != null && !fields.isEmpty()) {
                android.widget.TextView focusTv = new android.widget.TextView(a);
                String fx = targetMsg.trim().replace('\n', ' ');
                if (fx.length() > 60) fx = fx.substring(0, 60) + "…";
                boolean mineFlag = isMyMessage(tkShow, lastLongPressTs, targetMsg);
                focusTv.setText((mineFlag ? "针对我这条：" : "针对这条：") + fx);
                focusTv.setTextSize(11);
                focusTv.setTextColor(0xFFC8102E);
                focusTv.setPadding(dp(a, 11), dp(a, 2), 0, 0);
                wrap.addView(focusTv);
            }

            // 1. AI 分析
            if (fields != null && !fields.isEmpty()) {
                android.widget.TextView at2 = new android.widget.TextView(a);
                at2.setText("AI 分析");
                at2.setTextSize(11);
                at2.setTextColor(0xFF9A9AA2);
                at2.setPadding(dp(a, 11), dp(a, 8), 0, dp(a, 4));
                wrap.addView(at2);

                android.widget.LinearLayout card = new android.widget.LinearLayout(a);
                card.setOrientation(android.widget.LinearLayout.VERTICAL);
                android.graphics.drawable.GradientDrawable abg = new android.graphics.drawable.GradientDrawable();
                abg.setColor(0xFFFFF6F7);
                abg.setCornerRadius(dp(a, 10));
                abg.setStroke(dp(a, 1), 0xFFF6DDE0);
                card.setBackground(abg);
                card.setPadding(dp(a, 12), dp(a, 6), dp(a, 12), dp(a, 6));

                String[] order = {"话题", "意图", "情绪", "潜台词", "建议", "分析"};
                for (String k : order) {
                    String v = fields.get(k);
                    if (v == null || v.length() == 0) continue;
                    android.widget.LinearLayout line = new android.widget.LinearLayout(a);
                    line.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                    line.setPadding(0, dp(a, 4), 0, dp(a, 4));
                    android.widget.TextView lb = new android.widget.TextView(a);
                    lb.setText(k);
                    lb.setTextSize(12);
                    lb.setTextColor(0xFFD7263D);
                    lb.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);
                    line.addView(lb, new android.widget.LinearLayout.LayoutParams(dp(a, 52), -2));
                    android.widget.TextView vt = new android.widget.TextView(a);
                    vt.setText(v);
                    vt.setTextSize(13);
                    vt.setTextColor(0xFF2A2A31);
                    vt.setLineSpacing(0, 1.18f);
                    line.addView(vt, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
                    card.addView(line);
                }
                wrap.addView(card);
            }

            // 2. 分析依据（折叠显示，避免过长）
            final android.widget.TextView sub = new android.widget.TextView(a);
            sub.setText("▸ 分析依据（点开）");
            sub.setTextSize(11);
            sub.setTextColor(0xFF9A9AA2);
            sub.setPadding(dp(a, 11), dp(a, 8), 0, dp(a, 2));
            final android.widget.ScrollView sv = new android.widget.ScrollView(a);
            android.widget.TextView ctxTv = new android.widget.TextView(a);
            ctxTv.setText(ctx == null || ctx.length() == 0 ? "（无历史消息）" : ctx);
            ctxTv.setTextSize(11);
            ctxTv.setTextColor(0xFF6A6A73);
            ctxTv.setLineSpacing(0, 1.15f);
            ctxTv.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));
            android.graphics.drawable.GradientDrawable cbg = new android.graphics.drawable.GradientDrawable();
            cbg.setColor(0xFFF4F4F7);
            cbg.setCornerRadius(dp(a, 10));
            ctxTv.setBackground(cbg);
            sv.addView(ctxTv);
            sv.setVisibility(android.view.View.GONE);
            wrap.addView(sub);
            wrap.addView(sv, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(a, 96)));
            final android.widget.ScrollView fsv = sv;
            final android.widget.TextView fsub = sub;
            fsub.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    boolean show = fsv.getVisibility() != android.view.View.VISIBLE;
                    fsv.setVisibility(show ? android.view.View.VISIBLE : android.view.View.GONE);
                    fsub.setText(show ? "▾ 分析依据" : "▸ 分析依据（点开）");
                }
            });

            // 3. 候选回复
            String lastLine = targetMsg == null ? "" : targetMsg.trim();
            try {
                if (lastLine.length() > 0) throw new RuntimeException("skip");
                String[] cl = (ctx == null ? "" : ctx).split("\n");
                for (int i = cl.length - 1; i >= 0; i--) {
                    if (cl[i].startsWith("对方:")) { lastLine = cl[i].substring(3).trim(); break; }
                }
            } catch (Throwable ignore) { }
            if (lastLine.length() > 0) {
                android.widget.TextView tg = new android.widget.TextView(a);
                tg.setText("回应：" + lastLine);
                tg.setTextSize(12);
                tg.setTextColor(0xFF6A6A73);
                tg.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));
                android.graphics.drawable.GradientDrawable tbg = new android.graphics.drawable.GradientDrawable();
                tbg.setColor(0xFFF1F5FF);
                tbg.setCornerRadius(dp(a, 10));
                tg.setBackground(tbg);
                android.widget.LinearLayout.LayoutParams tlp2 = new android.widget.LinearLayout.LayoutParams(
                        android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                        android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
                tlp2.topMargin = dp(a, 8);
                wrap.addView(tg, tlp2);
            }
            android.widget.EditText noteEt = new android.widget.EditText(a);
            noteEt.setHint("补充说明（可选）：我和对方的关系、当前情况，例如「这是我上级，正在催我交日报」");
            noteEt.setTextSize(11);
            noteEt.setTextColor(0xFF2A2A31);
            noteEt.setHintTextColor(0xFF9A9AA2);
            noteEt.setPadding(dp(a, 12), dp(a, 8), dp(a, 12), dp(a, 8));
            noteEt.setBackground(roundRect(0xFFF3F7FF, dp(a, 10)));
            noteEt.setMinLines(1);
            noteEt.setMaxLines(4);
            noteEt.setText(aiExtraNote == null ? "" : aiExtraNote);
            noteEt.addTextChangedListener(new android.text.TextWatcher() {
                @Override public void beforeTextChanged(CharSequence s2, int st, int c, int a2) { }
                @Override public void onTextChanged(CharSequence s2, int st, int b2, int c) { }
                @Override public void afterTextChanged(android.text.Editable e2) {
                    aiExtraNote = e2 == null ? "" : e2.toString().trim();
                }
            });
            android.widget.LinearLayout.LayoutParams nlp2 = new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
            nlp2.topMargin = dp(a, 8);
            wrap.addView(noteEt, nlp2);

            android.widget.TextView optTitle = new android.widget.TextView(a);
            optTitle.setText("选一条填入");
            optTitle.setTextSize(11);
            optTitle.setTextColor(0xFF9A9AA2);
            optTitle.setPadding(dp(a, 11), dp(a, 10), 0, dp(a, 2));
            wrap.addView(optTitle);

            final android.app.Dialog[] dr = new android.app.Dialog[1];
            final String[] CATS = {"稳重", "热情", "幽默", "共情", "专业", "委婉拒绝"};

            final android.widget.HorizontalScrollView catSv = new android.widget.HorizontalScrollView(a);
            catSv.setHorizontalScrollBarEnabled(false);
            final android.widget.LinearLayout catRow = new android.widget.LinearLayout(a);
            catRow.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            catSv.addView(catRow);
            wrap.addView(catSv, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(a, 40)));

            final android.widget.LinearLayout repliesBox = new android.widget.LinearLayout(a);
            repliesBox.setOrientation(android.widget.LinearLayout.VERTICAL);
            wrap.addView(repliesBox);

            final String[] curCat = {"稳重"};
            final java.util.HashMap<String, java.util.ArrayList<String>> catCache =
                    new java.util.HashMap<String, java.util.ArrayList<String>>();
            catCache.put("稳重", new java.util.ArrayList<String>(opts));

            final Runnable[] refresh = new Runnable[1];
            refresh[0] = new Runnable() {
                @Override public void run() {
                    try {
                        catRow.removeAllViews();
                        for (final String c : CATS) {
                            android.widget.TextView chip = new android.widget.TextView(a);
                            boolean on = c.equals(curCat[0]);
                            chip.setText(c);
                            chip.setTextSize(12);
                            chip.setTextColor(on ? 0xFFFFFFFF : 0xFF6A6A73);
                            chip.setPadding(dp(a, 12), dp(a, 6), dp(a, 12), dp(a, 6));
                            android.graphics.drawable.GradientDrawable cg = new android.graphics.drawable.GradientDrawable();
                            cg.setCornerRadius(dp(a, 14));
                            cg.setColor(on ? 0xFFC8102E : 0xFFF2F2F5);
                            chip.setBackground(cg);
                            android.widget.LinearLayout.LayoutParams clp =
                                    new android.widget.LinearLayout.LayoutParams(-2, -2);
                            clp.rightMargin = dp(a, 8);
                            chip.setOnClickListener(new android.view.View.OnClickListener() {
                                @Override public void onClick(android.view.View v) {
                                    if (c.equals(curCat[0])) return;
                                    curCat[0] = c;
                                    refresh[0].run();
                                }
                            });
                            catRow.addView(chip, clp);
                        }
                        java.util.ArrayList<String> cached = catCache.get(curCat[0]);
                        if (cached != null && !cached.isEmpty()) {
                            renderReplyOptions(a, repliesBox, et, cached, dr);
                        } else {
                            repliesBox.removeAllViews();
                            android.widget.TextView loading = new android.widget.TextView(a);
                            loading.setText("正在生成「" + curCat[0] + "」风格…");
                            loading.setTextSize(12);
                            loading.setTextColor(0xFF9A9AA2);
                            loading.setPadding(dp(a, 12), dp(a, 10), 0, dp(a, 6));
                            repliesBox.addView(loading);
                            fetchCat(a, et, talker, targetMsg, curCat[0], catCache,
                                    repliesBox, dr, refresh[0]);
                        }
                    } catch (Throwable t) { log("AI|cat refresh err " + t); }
                }
            };
            refresh[0].run();

            android.widget.LinearLayout bar2 = new android.widget.LinearLayout(a);
            bar2.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            bar2.setGravity(android.view.Gravity.END);
            bar2.setPadding(0, dp(a, 10), 0, 0);
            android.widget.TextView again = hubChip(a, "换一批", false);
            again.setTextColor(0xFF07C160);
            final android.app.Dialog[] dd = dr;
            again.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    final String cat = curCat[0];
                    try {
                        repliesBox.removeAllViews();
                        android.widget.TextView loading = new android.widget.TextView(a);
                        loading.setText("正在换「" + cat + "」的五条…");
                        loading.setTextSize(12);
                        loading.setTextColor(0xFF9A9AA2);
                        loading.setPadding(dp(a, 12), dp(a, 10), 0, dp(a, 6));
                        repliesBox.addView(loading);
                    } catch (Throwable ignore) { }
                    fetchCat(a, et, talker, targetMsg, cat, catCache, repliesBox, dr, refresh[0]);
                }
            });
            bar2.addView(again);
            android.widget.TextView cancel = hubChip(a, "取消", false);
            cancel.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    try { if (dd[0] != null) dd[0].dismiss(); } catch (Throwable ignore) { }
                }
            });
            bar2.addView(cancel);
            wrap.addView(bar2);

            android.app.Dialog dlg = new android.app.Dialog(a, android.R.style.Theme_Material_Light_NoActionBar);
            dlg.setContentView(wrap);
            dlg.show();
            dr[0] = dlg;
            android.view.Window w = dlg.getWindow();
            if (w != null) {
                w.setBackgroundDrawable(glassDrawable(a, 20));
                w.setLayout((int) (a.getResources().getDisplayMetrics().widthPixels * 0.92f),
                        android.view.WindowManager.LayoutParams.WRAP_CONTENT);
            }
        } catch (Throwable t) { log("AI|chooser " + t); }
    }

    /** 读取最近聊天上下文 */
    private static String buildChatContext(String talker, int limit) {
        StringBuilder sb = new StringBuilder();
        try {
            long t0 = System.currentTimeMillis();
            java.util.List<Object[]> q = queryRows(
                    "select content, isSend from message where talker='" + talker
                            + "' order by createTime desc limit " + limit, 2);
            for (int i = q.size() - 1; i >= 0; i--) {
                Object c0 = q.get(i)[0];
                if (c0 == null) continue;
                String txt = prettyContent(String.valueOf(c0));
                if (txt == null || txt.length() == 0) continue;
                if (txt.length() > 120) txt = txt.substring(0, 120) + "…";
                boolean mine = false;
                try { mine = "1".equals(String.valueOf(q.get(i)[1])); } catch (Throwable ignore) { }
                sb.append(mine ? "我: " : "对方: ").append(txt).append('\n');
            }
            log("AI|ctx ms=" + (System.currentTimeMillis() - t0) + " n=" + q.size());
        } catch (Throwable t) { log("AI|ctx " + t); }
        return sb.toString().trim();
    }

    /** 当前聊天会话 id（从 Activity Intent 取，最可靠） */
    private static volatile String lastKnownTalker = null;

    /** 当前界面是否挂着聊天底栏（ChatFooter）：绕开 inChat/chatTalker 未及时赋值的情况 */
    private static boolean hasChatFooter(android.app.Activity a) {
        try {
            if (a == null) return false;
            android.view.View d = a.getWindow().getDecorView();
            return scanFooter(d, 0);
        } catch (Throwable t) { return false; }
    }

    private static boolean scanFooter(android.view.View v, int dep) {
        if (v == null || dep > 18) return false;
        String cn = v.getClass().getName();
        if (cn.contains("ChatFooter")) return v.getVisibility() == android.view.View.VISIBLE;
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                if (scanFooter(g.getChildAt(i), dep + 1)) return true;
            }
        }
        return false;
    }

    private static String currentTalker() {
        try {
            android.app.Activity ca = chatAct;
            if (ca != null) {
                // 1) Fragment 参数（最准）
                String live = liveTalker(ca);
                if (live != null && live.length() > 0) return live;
                // 2) Activity 记录
                String byAct = talkerOfActivity(ca);
                if (byAct != null && byAct.length() > 0) return byAct;
                // 3) intent
                android.content.Intent it = ca.getIntent();
                if (it != null) {
                    String u = it.getStringExtra("Chat_User");
                    if (u != null && u.length() > 0) return u;
                }
            }
        } catch (Throwable ignore) { }
        if (chatTalker != null && chatTalker.length() > 0) return chatTalker;
        try {
            android.app.Activity ca = chatAct;
            if (ca != null) {
                String nm = chatNameOfActivity(ca);
                String byName = nm == null ? null : wxidByName(nm);
                if (byName != null && byName.length() > 0) return byName;
            }
        } catch (Throwable ignore) { }
        return lastKnownTalker;
    }

    /** 用"这条消息的时间"反查它属于哪个会话 —— 长消息/位置错乱时最可靠 */
    private static String talkerByTs(long tsMs) {
        try {
            if (tsMs <= 0) return null;
            long sec = tsMs > 100000000000L ? tsMs / 1000L : tsMs;
            java.util.List<Object[]> rr = queryRows("select talker from message where createTime between "
                    + (sec - 2) + " and " + (sec + 2) + " limit 1", 1);
            if (!rr.isEmpty() && rr.get(0)[0] != null) {
                String t = String.valueOf(rr.get(0)[0]).trim();
                if (t.length() > 0) return t;
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** AI 回复：先分析聊天，再给候选，只填入不发送 */
    private static void aiGenerate(final android.app.Activity a, final android.widget.EditText et) {
        aiGenerate(a, et, null);
    }

    private static void aiGenerate(final android.app.Activity a, final android.widget.EditText et,
                                   final String targetMsg) {
        final String key = cfg().optString("aiKey", "").trim();
        if (key.length() == 0) {
            toast("先在 H 设置里填 AI Key");
            showAiSettings(a);
            return;
        }
        String tk0 = chatTalker;
        if (tk0 == null || tk0.length() == 0) tk0 = currentTalker();
        if (tk0 == null || tk0.length() == 0) tk0 = resolveRowTalker();
        if (tk0 == null || tk0.length() == 0) tk0 = lastKnownTalker;
        final String talker = tk0;      // 允许为空：单条分析不依赖会话
        if (targetMsg == null || targetMsg.trim().length() == 0) lastAiMine = false;
        lastAiFocus = targetMsg;
        log("AI|talker=" + talker + " chatTalker=" + chatTalker
                + " chatAct=" + (chatAct == null ? "null" : "ok") + " ts=" + lastLongPressTs);
        toast("AI 分析中…");
        new Thread(new Runnable() {
            @Override public void run() {
                java.util.ArrayList<String> opts = new java.util.ArrayList<String>();
                final java.util.LinkedHashMap<String, String> fields =
                        new java.util.LinkedHashMap<String, String>();
                String err = null;
                String ctxShown = "";
                try {
                    boolean single = targetMsg != null && targetMsg.trim().length() > 0;
                    String ctx;
                    if (single) {
                        // 只分析长按的那一条：不需要会话上下文
                        ctx = "（本次只分析这一条消息，不参考其它聊天内容）";
                    } else {
                        ctx = talker == null ? "" : buildChatContext(talker, 40);
                        if (ctx.length() == 0) {
                            ctx = contextFromVisibleRows();
                            log("AI|ctx fallback rows len=" + ctx.length());
                        }
                        log("AI|general talker=" + talker + " ctxLen=" + ctx.length());
                    }
                    ctxShown = ctx;
                    if (ctx.length() == 0 && !single) {
                        err = "这个会话没有可分析的聊天记录";
                    } else {
                        String fmt = "你是一个懂人情世故的微信聊天助手，帮用户看懂对话并拟回复。"
                                + "聊天记录可能包含多个话题，请先用一句话判断【当前正在聊的话题】，只针对当前话题分析，"
                                + "更早的内容只作为背景，不要混进结论。\n"
                                + "严格按下面格式输出，不要多余内容：\n"
                                + "关系：<我和对方是什么关系，如同事/上级/客户/朋友/家人，20字内>\n"
                                + "情况：<当前具体场景，如催进度/约饭/请假/闲聊，20字内>\n"
                                + "话题：<当前在聊什么，20字内>\n"
                                + "意图：<对方真正想表达什么，30字内>\n"
                                + "情绪：<对方情绪与强度，20字内>\n"
                                + "潜台词：<没说出口但能感觉到的意思，30字内>\n"
                                + "建议：<我该怎么回，策略一句话，30字内>\n"
                                + "回复1：<不超过25字，口语化>\n"
                                + "回复2：<换一种语气>\n"
                                + "回复3：<再换一种语气>\n"
                                + "要求：三条回复都必须紧扣对方最后一句话里的具体内容（人、事、地点、数字、物品），"
                                + "能直接接上话；禁止『好的』『哈哈』『在的』这类空泛回复，也不要答非所问。";
                        String persona = cfg().optString("aiPrompt", "").trim();
                        if (persona.length() > 0 && !persona.contains("严格按下面格式")) {
                            fmt = fmt + "\n补充要求：" + persona;
                        }
                        String lastIn = "";
                        try {
                            java.util.List<Object[]> q1 = queryRows(
                                    "select content from message where talker='" + talker
                                            + "' and isSend=0 order by createTime desc limit 1", 1);
                            if (!q1.isEmpty() && q1.get(0)[0] != null) {
                                lastIn = prettyContent(String.valueOf(q1.get(0)[0]));
                            }
                        } catch (Throwable ignore) { }
                        String focus = targetMsg != null && targetMsg.trim().length() > 0 ? targetMsg.trim() : lastIn;
                        final boolean isSingle = targetMsg != null && targetMsg.trim().length() > 0;
                        boolean mineByRow = false;
                        try {
                            android.view.View av = lastLongPressView == null ? null : lastLongPressView.get();
                            if (av != null) mineByRow = !leftByAvatar(av, av);
                        } catch (Throwable ignore) { }
                        boolean singleMine = isSingle && (mineByRow
                                || isMyMessage(talker, lastLongPressTs, targetMsg));
                        lastAiMine = singleMine;
                        lastAiFocus = (focus == null || focus.length() == 0) ? targetMsg : focus;
                        try {
                            StringBuilder ab = new StringBuilder();
                            for (String kk : new String[]{"关系", "情况", "话题", "意图", "情绪",
                                    "潜台词", "效果", "缺失", "建议"}) {
                                String vv = fields.get(kk);
                                if (vv != null && vv.length() > 0) ab.append(kk).append("：").append(vv).append('\n');
                            }
                            lastAiAnalysis = ab.toString().trim();
                        } catch (Throwable ignore) { }
                        log("AI|single=" + isSingle + " mineRow=" + mineByRow + " mine=" + singleMine);
                        if (singleMine) {
                            fmt = "你是一个懂人情世故的微信聊天助手。用户选中了【自己刚发出去的一条消息】，"
                                + "请判断这条消息的效果，并给出可以接着补一句的候选，让表达更完整得体。"
                                + "\n严格按下面格式输出，不要多余内容：\n"
                                + "关系：<我和对方是什么关系，20字内>\n"
                                + "情况：<当前具体场景，20字内>\n"
                                + "话题：<我这句话在说什么，20字内>\n"
                                + "意图：<我想让对方接收到的意思，30字内>\n"
                                + "效果：<对方可能怎么理解，20字内>\n"
                                + "缺失：<还差哪点没说清，30字内>\n"
                                + "建议：<下一句该怎么补，策略一句话，30字内>\n"
                                + "候选|稳重：<可以接着发的补充，不超过25字>\n"
                                + "候选|直接：<...>\n"
                                + "候选|幽默：<...>\n"
                                + "候选|简短：<...>\n"
                                + "要求：给 2~4 条，每条标注一种性格（稳重/直接/幽默/简短/热情任选），"
                                + "都要像我自己接着说的，不要像在回答对方；紧扣我这句话里的具体内容。";
                        } else if (targetMsg != null && targetMsg.trim().length() > 0) {
                            fmt = "你是一个懂人情世故的微信聊天助手。用户只选中了一条消息，请只针对这一条给出判断和回复写法，"
                                + "不要假设其它前后文。\n严格按下面格式输出，不要多余内容：\n"
                                + "关系：<我和对方是什么关系，20字内>\n"
                                + "情况：<当前具体场景，20字内>\n"
                                + "话题：<这句话在说什么，20字内>\n"
                                + "意图：<对方真正想表达什么，30字内>\n"
                                + "情绪：<对方情绪与强度，20字内>\n"
                                + "潜台词：<没说出口的意思，30字内>\n"
                                + "建议：<我该怎么回，策略一句话，30字内>\n"
                                + "候选|稳重：<不超过25字>\n"
                                + "候选|热情：<...>\n"
                                + "候选|幽默：<...>\n"
                                + "候选|简短：<...>\n"
                                + "要求：给 2~4 条，每条标注一种性格（稳重/热情/幽默/简短/直接任选），"
                                + "必须紧扣这句话里的具体内容（人、事、地点、数字、物品），能直接接上话。";
                        }
                        String userMsg;
                        if (isSingle) {
                            userMsg = singleMine
                                    ? "我（自己）刚发出去的这句话：\n" + focus
                                        + "\n\n请只针对我这句话，给出我下一句可以补充的候选。"
                                    : "对方发来的这句话：\n" + focus
                                        + "\n\n请只针对这一句，给出我该怎么回复的候选。";
                        } else {
                            userMsg = "聊天记录：\n" + ctx
                                    + (focus.length() > 0 ? "\n\n需要我回应的是对方最后这句：" + focus : "")
                                    + "\n\n请紧扣最后这句给出回复。";
                        }
                        String raw = callAiRaw(fmt, userMsg);
                        String[] lines = raw.split("\n");
                        for (String ln : lines) {
                            String v = ln.trim();
                            if (v.length() == 0) continue;
                            String label = null, body = null;
                            int c1 = v.indexOf('：');
                            if (c1 < 0) c1 = v.indexOf(':');
                            if (c1 > 0 && c1 <= 6) {
                                label = v.substring(0, c1).replace("*", "").trim();
                                body = v.substring(c1 + 1).trim();
                            }
                            if (label != null && (label.equals("话题") || label.equals("意图") || label.equals("情绪")
                                    || label.equals("潜台词") || label.equals("建议") || label.equals("分析")
                                    || label.equals("效果") || label.equals("缺失") || label.equals("判断")
                                    || label.equals("关系") || label.equals("情况") || label.equals("场景"))) {
                                if (body != null && body.length() > 0) fields.put(label, body);
                                continue;
                            }
                            String t2 = v;
                            boolean isReply = t2.startsWith("回复") || t2.startsWith("候选")
                                    || t2.matches("^[0-9]+[.、)].*");
                            if (!isReply) continue;
                            if (t2.startsWith("候选")) t2 = t2.substring(2).trim();
                            if (t2.startsWith("|")) {
                                int pp = t2.indexOf('：');
                                if (pp < 0) pp = t2.indexOf(':');
                                if (pp > 1) t2 = t2.substring(1, pp).trim() + "|" + t2.substring(pp + 1).trim();
                                else t2 = t2.substring(1).trim();
                            }
                            int c2 = t2.indexOf('：');
                            if (c2 < 0) c2 = t2.indexOf(':');
                            if (c2 > 0 && c2 < 8) t2 = t2.substring(c2 + 1).trim();
                            else t2 = t2.replaceFirst("^回复[0-9]?", "").trim();
                            t2 = t2.replaceFirst("^[0-9]+[.、)]\\s*", "");
                            t2 = t2.replaceFirst("^[-*•]\\s*", "");
                            t2 = t2.replaceFirst("^[\"“]", "").replaceFirst("[\"”]$", "");
                            if (t2.length() > 0) opts.add(t2);
                        }
                        if (opts.isEmpty()) err = "AI 没有给出候选回复";
                    }
                } catch (Throwable t) {
                    err = String.valueOf(t);
                }
                final java.util.ArrayList<String> fo = opts;
                final String fe = err, fctx = ctxShown;
                final String ftarget = targetMsg;
                final java.util.LinkedHashMap<String, String> ff = fields;
                log("AI|cands " + fo.size() + " fields=" + ff + (fe == null ? "" : " err=" + fe));
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (fo.isEmpty()) {
                            toast("AI 失败：" + (fe == null ? "无结果" : fe));
                            return;
                        }
                        try { saveAiHistory(talker, fields.get("话题"), fo); } catch (Throwable ignore) { }
                        showAiChooser(a, et, fo, fctx, ff, talker, ftarget);
                    }
                });
            }
        }).start();
    }

    private static String callAi(String prompt) throws Exception {
        return callAiRaw(cfg().optString("aiPrompt",
                "你是用户本人，在微信上回复对方。语气自然口语化，简短克制，不超过30字，不要引号，不要解释。"), prompt);
    }

    private static String callAiRaw(String sys, String prompt) throws Exception {
        String base = cfg().optString("aiBase", "https://api.deepseek.com/v1/chat/completions").trim();
        String key = cfg().optString("aiKey", "").trim();
        String model = cfg().optString("aiModel", "deepseek-chat").trim();
        org.json.JSONObject body = new org.json.JSONObject();
        body.put("model", model);
        org.json.JSONArray msgs = new org.json.JSONArray();
        org.json.JSONObject m1 = new org.json.JSONObject();
        m1.put("role", "system");
        m1.put("content", sys);
        msgs.put(m1);
        org.json.JSONObject m2 = new org.json.JSONObject();
        m2.put("role", "user");
        m2.put("content", prompt);
        msgs.put(m2);
        body.put("messages", msgs);
        body.put("temperature", 0.8);
        body.put("max_tokens", 700);

        java.net.HttpURLConnection c = (java.net.HttpURLConnection) new java.net.URL(base).openConnection();
        c.setRequestMethod("POST");
        c.setConnectTimeout(15000);
        c.setReadTimeout(30000);
        c.setDoOutput(true);
        c.setRequestProperty("Content-Type", "application/json; charset=utf-8");
        c.setRequestProperty("Authorization", "Bearer " + key);
        java.io.OutputStream os = c.getOutputStream();
        os.write(body.toString().getBytes("UTF-8"));
        os.close();
        int code = c.getResponseCode();
        java.io.InputStream is = code >= 400 ? c.getErrorStream() : c.getInputStream();
        if (is == null) throw new Exception("HTTP " + code);
        java.io.ByteArrayOutputStream bo = new java.io.ByteArrayOutputStream();
        byte[] buf = new byte[4096];
        int n;
        while ((n = is.read(buf)) > 0) bo.write(buf, 0, n);
        is.close();
        String resp = new String(bo.toByteArray(), "UTF-8");
        if (code >= 400) throw new Exception("HTTP " + code + " " + (resp.length() > 120 ? resp.substring(0, 120) : resp));
        org.json.JSONObject jo = new org.json.JSONObject(resp);
        org.json.JSONArray ch = jo.optJSONArray("choices");
        if (ch == null || ch.length() == 0) throw new Exception("无 choices");
        org.json.JSONObject c0 = ch.optJSONObject(0);
        org.json.JSONObject msg = c0 == null ? null : c0.optJSONObject("message");
        String content = msg == null ? null : msg.optString("content", "");
        if (content == null) content = "";
        content = content.trim();
        if (content.startsWith("\"") && content.endsWith("\"") && content.length() > 1) {
            content = content.substring(1, content.length() - 1);
        }
        return content;
    }

    private static void showAiSettings(final android.app.Activity a) {
        try {
