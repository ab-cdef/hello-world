                                } else if (cfg().optBoolean("unrecallNotify", false)) {
                                    alert("撤回提醒", String.valueOf(rep == null ? "对方撤回了一条消息" : rep) + "（原消息已保留）");
                                }
                                p.setResult(null);
                                log("UNRECALL_BLOCK|" + who);
                            }
                            if (!cfg().optBoolean("groupAlert", false)) return;
                            Object a1 = p.args[1];
                            if (!(a1 instanceof Map)) return;
                            Map<?, ?> mm = (Map<?, ?>) a1;
                            if (mm.containsKey(".sysmsg.revokemsg.newmsgid")) {
                                Object who = mm.get(".sysmsg.revokemsg.session");
                                Object rep = mm.get(".sysmsg.revokemsg.replacemsg");
                                try {
                                    java.io.FileOutputStream fo = new java.io.FileOutputStream(DIR + "/wxh_unrecall.log", true);
                                    String line = new java.text.SimpleDateFormat("MM-dd HH:mm:ss").format(new java.util.Date())
                                            + "|" + who + "|" + rep + "\n";
                                    fo.write(line.getBytes("UTF-8"));
                                    fo.close();
                                } catch (Throwable t4) {
                                }
                                if (cfg().optBoolean("unrecallSysMsg", true) && who != null) {
                                    String rp = rep == null ? "对方撤回了一条消息" : String.valueOf(rep);
                                    long mid = 0;
                                    try {
