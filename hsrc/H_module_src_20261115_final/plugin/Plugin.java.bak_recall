    /* ================= 最近导出的文件 ================= */
    private static void showRecentExports(final android.app.Activity a) {
        try {
            java.io.File root = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
            java.util.ArrayList<java.io.File> files = new java.util.ArrayList<java.io.File>();
            collectFiles(root, files, 0);
            java.util.Collections.sort(files, new java.util.Comparator<java.io.File>() {
                @Override public int compare(java.io.File x, java.io.File y) {
                    return Long.compare(y.lastModified(), x.lastModified());
                }
            });
            int lim = Math.min(files.size(), 15);
            if (lim == 0) { toast("还没有导出过文件"); return; }
            java.text.SimpleDateFormat f =
                    new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US);
            final android.app.Dialog[] dd = new android.app.Dialog[1];
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.widget.ScrollView sv = new android.widget.ScrollView(a);
            android.widget.LinearLayout list = new android.widget.LinearLayout(a);
            list.setOrientation(android.widget.LinearLayout.VERTICAL);
            sv.addView(list);
            box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 440)));
            for (int i = 0; i < lim; i++) {
                final java.io.File x = files.get(i);
                android.widget.TextView tv = new android.widget.TextView(a);
                tv.setText(x.getName() + "\n" + humanSize(x.length()) + " · "
                        + f.format(new java.util.Date(x.lastModified())));
                tv.setTextSize(13);
                tv.setTextColor(0xFF1A1A1E);
                tv.setPadding(dp(a, 12), dp(a, 10), dp(a, 12), dp(a, 10));
                android.graphics.drawable.GradientDrawable g = new android.graphics.drawable.GradientDrawable();
                g.setColor(0xF7FFFFFF);
                g.setCornerRadius(dp(a, 10));
                tv.setBackground(g);
                android.widget.LinearLayout.LayoutParams lp =
                        new android.widget.LinearLayout.LayoutParams(-1, -2);
                lp.bottomMargin = dp(a, 6);
                tv.setLayoutParams(lp);
                tv.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        try {
                            android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                    a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                            cm.setPrimaryClip(android.content.ClipData.newPlainText("h", x.getAbsolutePath()));
                            toast("路径已复制\n" + x.getAbsolutePath());
                        } catch (Throwable t) { toast("复制失败"); }
                    }
                });
                tv.setOnLongClickListener(new android.view.View.OnLongClickListener() {
                    @Override public boolean onLongClick(android.view.View v) {
                        boolean ok = shareExported(a, x);
                        if (!ok) toast("分享失败（文件可能不在 Download/wxh 下）");
                        return true;
                    }
                });
                list.addView(tv);
            }
            dd[0] = new android.app.AlertDialog.Builder(a)
                    .setTitle("最近导出（" + lim + "/" + files.size() + "）")
                    .setView(box)
                    .setNegativeButton("关闭", null)
                    .create();
            dd[0].show();
            log("RECENT|shown=" + lim + " total=" + files.size());
        } catch (Throwable t) { log("RECENT|err " + t); }
    }

    /* ================= 一键导出套餐 =================
     * 一次跑完四个：聊天记录 Markdown / 发言明细 CSV / 类型分布 CSV / 活跃报告 MD。
     */
    /** 把若干文件打进一个 zip（存到 Download/wxh），返回 zip 文件 */
    private static java.io.File zipFiles(java.util.ArrayList<java.io.File> files, String baseName) {
        try {
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String safe = baseName.replaceAll("[\\\\/:*?\"<>|]", "_");
            java.io.File zip = new java.io.File(dir, safe + "_" + new java.text.SimpleDateFormat(
                    "yyyyMMdd_HHmmss", java.util.Locale.US).format(new java.util.Date()) + ".zip");
            java.util.zip.ZipOutputStream zos = new java.util.zip.ZipOutputStream(
                    new java.io.BufferedOutputStream(new java.io.FileOutputStream(zip)));
            byte[] buf = new byte[8192];
            int n = 0;
            for (java.io.File f : files) {
                if (f == null || !f.isFile() || f.getAbsolutePath().equals(zip.getAbsolutePath())) continue;
                java.io.InputStream is = new java.io.FileInputStream(f);
                zos.putNextEntry(new java.util.zip.ZipEntry(f.getName()));
                int r;
                while ((r = is.read(buf)) > 0) zos.write(buf, 0, r);
                zos.closeEntry();
                is.close();
                n++;
            }
            zos.close();
            log("ZIP|files=" + n + " size=" + zip.length() + " path=" + zip.getAbsolutePath());
            if (n == 0) { zip.delete(); return null; }
            return zip;
        } catch (Throwable t) {
            log("ZIP|err " + t);
            return null;
        }
    }

    private static java.io.File lastBundleZip = null;

    private static java.util.ArrayList<String> exportBundle(String talker) {
        java.util.ArrayList<String> out = new java.util.ArrayList<String>();
        try {
            String nm = displayOfTalker(talker);
            log("BUNDLE|start " + talker + " " + nm);
            String[] p1 = new String[1];
            int n1 = exportChatMarkdown(talker, p1);
            out.add("聊天记录 Markdown：" + n1 + " 条\n" + (p1[0] == null ? "失败" : p1[0]));

            String[] p2 = new String[1];
            int[] r2 = memberStatsCore(talker, p2);
            out.add("发言明细 CSV：" + r2[1] + " 人\n" + (p2[0] == null ? "失败" : p2[0]));

            String[] p3 = new String[1];
            msgTypeStats(talker, p3);
            out.add("类型分布 CSV\n" + (p3[0] == null ? "失败" : p3[0]));

            String[] p4 = new String[1];
            int n4 = buildGroupReport(talker, p4);
            out.add("活跃报告 MD：" + n4 + " 人\n" + (p4[0] == null ? "失败" : p4[0]));

            java.util.ArrayList<java.io.File> files = new java.util.ArrayList<java.io.File>();
            for (String pp : new String[]{p1[0], p2[0], p3[0], p4[0]}) {
                if (pp != null && pp.length() > 0) files.add(new java.io.File(pp));
            }
            java.io.File zip = zipFiles(files, "bundle_" + nm);
            if (zip != null) {
                out.add("打包 ZIP：" + files.size() + " 个文件\n" + zip.getAbsolutePath());
                lastBundleZip = zip;
            }
            log("BUNDLE|done " + talker + " ok=" + out.size());
        } catch (Throwable t) { log("BUNDLE|err " + t); }
        return out;
    }

    private static void runExportBundle(final android.app.Activity a, final String talker, final String name) {
        toast("开始导出套餐…");
        new Thread(new Runnable() {
