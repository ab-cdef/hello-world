                    texts.addView(name);
                    card.addView(texts, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));

                    final String rowKey = SETTINGS[idx][0];
                    final String rowLabel = label;
                    boolean isBool = "开".equals(val) || "关".equals(val);
                    // 值槽：开关和短数字都放进同宽的槽里，左右两列的值都从同一条竖线开始
                    int slotW = dp(a, 72);
                    if (isBool) {
                        android.widget.FrameLayout slot = new android.widget.FrameLayout(a);
                        slot.setLayoutParams(new android.widget.LinearLayout.LayoutParams(slotW, dp(a, 26)));
                        android.widget.FrameLayout.LayoutParams flp =
                                new android.widget.FrameLayout.LayoutParams(dp(a, 46), dp(a, 26));
                        flp.gravity = android.view.Gravity.LEFT | android.view.Gravity.CENTER_VERTICAL;
                        slot.addView(new HToggle(a, "开".equals(val)), flp);
                        card.addView(slot);
                    } else if (val.length() > 0) {
                        final String[][] opts = optionListOf(rowKey);
                        // 有选项：当前值做成可点的胶囊，一眼看出现在是哪个档
                        android.widget.TextView pill = new android.widget.TextView(a);
                        pill.setText(val);
                        pill.setTextSize(12);
                        pill.setTextColor(0xFF7A7E83);
                        pill.setMaxLines(2);
                        pill.setEllipsize(android.text.TextUtils.TruncateAt.END);
                        pill.setPadding(dp(a, 8), dp(a, 4), dp(a, 8), dp(a, 4));
                        if (opts == null) {
                            pill.setBackground(null);
                        } else {
                            pill.setBackground(roundRect(0xFFF2F2F2, dp(a, 4)));
                            card.setOnClickListener(new android.view.View.OnClickListener() {
                                @Override public void onClick(android.view.View v) {
                                    showOptionDialog(a, rowLabel, rowKey, opts);
                                }
                            });
                        }
                        if (rowKey.indexOf("TimeFmtSel") > 0 && val.indexOf(' ') > 0) {
                            pill.setText(val.replace(' ', '\n'));
                        }
                        if (val.length() <= 10) {
                            pill.setMaxWidth(slotW);
                            android.widget.FrameLayout slot = new android.widget.FrameLayout(a);
                            slot.setLayoutParams(new android.widget.LinearLayout.LayoutParams(slotW, -2));
                            android.widget.FrameLayout.LayoutParams flp =
                                    new android.widget.FrameLayout.LayoutParams(-2, -2);
                            flp.gravity = android.view.Gravity.LEFT | android.view.Gravity.CENTER_VERTICAL;
                            slot.addView(pill, flp);
                            card.addView(slot);
