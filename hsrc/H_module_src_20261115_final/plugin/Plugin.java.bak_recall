    /** 从聊天消息列表 adapter 的 item 里取 talker（列表点进聊天时最可靠） */
    private static String talkerFromAdapter(android.app.Activity a) {
        try {
            android.view.View list = findMsgList(curAct(a).getWindow().getDecorView());
            if (list == null) return null;
            Object adapter = null;
            try { adapter = list.getClass().getMethod("getAdapter").invoke(list); } catch (Throwable ignore) { }
            if (adapter == null) {
                for (java.lang.reflect.Field f : list.getClass().getDeclaredFields()) {
                    String tn = f.getType().getName();
                    if (android.widget.BaseAdapter.class.isAssignableFrom(f.getType())
                            || tn.contains("RecyclerView$Adapter")
                            || tn.endsWith(".r0")) {
                        f.setAccessible(true);
                        adapter = f.get(list);
                        if (adapter != null) break;
                    }
                }
            }
            if (adapter == null) return null;
            int count = 0;
            try {
                Object c = adapter.getClass().getMethod("getItemCount").invoke(adapter);
                if (c instanceof Integer) count = (Integer) c;
            } catch (Throwable ignore) { }
            if (count <= 0) {
                try {
                    Object c = adapter.getClass().getMethod("getCount").invoke(adapter);
                    if (c instanceof Integer) count = (Integer) c;
                } catch (Throwable ignore) { }
            }
            for (int i = 0; i < Math.min(count, 6); i++) {
                Object item = null;
                try { item = adapter.getClass().getMethod("getItem", int.class).invoke(adapter, i); } catch (Throwable ignore) { }
                if (item == null) continue;
                try {
                    Object tk = item.getClass().getMethod("getTalker").invoke(item);
                    if (tk instanceof String && ((String) tk).length() > 0) return (String) tk;
                } catch (Throwable ignore) { }
                Class<?> k = item.getClass();
                while (k != null && k != Object.class) {
                    for (java.lang.reflect.Field f : k.getDeclaredFields()) {
                        if (f.getType() != String.class) continue;
                        if (!f.getName().toLowerCase().contains("talker")) continue;
                        f.setAccessible(true);
                        Object v = f.get(item);
                        if (v instanceof String && ((String) v).length() > 0) return (String) v;
                    }
                    k = k.getSuperclass();
                }
            }
        } catch (Throwable t) {
            log("TALKER|adapter err " + t);
        }
        return null;
    }

    private static void captureTalker(Object fragment) {
        try {
            Object args = fragment.getClass().getMethod("getArguments").invoke(fragment);
            if (args instanceof android.os.Bundle) {
                android.os.Bundle b = (android.os.Bundle) args;
                for (String k : new String[]{"Chat_User", "chat_User", "talker", "Chat_UserName"}) {
                    String v = b.getString(k);
                    if (v != null && v.length() > 0) {
                        chatTalker = v;
                        return;
                    }
                }
            }
        } catch (Throwable t) {
        }
        try {
            for (java.lang.reflect.Field f : fragment.getClass().getDeclaredFields()) {
                if (f.getType() == String.class && f.getName().toLowerCase().contains("talker")) {
                    f.setAccessible(true);
                    Object v = f.get(fragment);
                    if (v instanceof String && ((String) v).length() > 0) {
                        chatTalker = (String) v;
                        return;
                    }
                }
            }
        } catch (Throwable t) {
        }
        // 兜底 1：Activity intent
        try {
            Object act = fragment.getClass().getMethod("getActivity").invoke(fragment);
            if (act instanceof android.app.Activity) {
                android.app.Activity aa = (android.app.Activity) act;
                android.content.Intent it = aa.getIntent();
                if (it != null) {
                    String u = it.getStringExtra("Chat_User");
                    if (u != null && u.length() > 0) {
                        chatTalker = u;
                        log("TALKER|by intent " + u);
                        return;
                    }
                }
                // 兜底 2：Fragment 参数反射
                String lv = liveTalker(aa);
                if (lv != null && lv.length() > 0) {
                    chatTalker = lv;
                    log("TALKER|by live " + lv);
                    return;
                }
                // 兜底 3：标题文字 → 反查 wxid
                String nm = chatNameOfActivity(aa);
                if (nm != null && nm.length() > 0) {
                    String id = wxidByName(nm);
                    if (id != null && id.length() > 0) {
                        chatTalker = id;
                        log("TALKER|by name " + nm + " -> " + id);
                        return;
                    }
                    log("TALKER|name unresolved " + nm);
                }
            }
        } catch (Throwable ignore) { }
    }

    private static void exportChat(final android.app.Activity a) {
        try {
            final String talker = chatTalker;
            if (talker == null) {
                toast("请先打开要导出的聊天");
                return;
            }
            Object f = Class.forName("w41.i9", false, appCl != null ? appCl : Plugin.class.getClassLoader()).getMethod("b").invoke(null);
            final Object store = f.getClass().getMethod("v").invoke(f);
            Object db = dbRef != null ? dbRef : msgDb;
            if (db == null) {
                try {
                    for (java.lang.reflect.Field df : store.getClass().getDeclaredFields()) {
                        if (df.getType().getName().contains("SQLiteDatabase")) {
                            df.setAccessible(true);
                            db = df.get(store);
                            if (db != null) break;
                        }
                    }
                } catch (Throwable t) {
                }
            }
            if (db == null) {
                toast("拿不到数据库，请先收发一条消息再试");
                return;
            }
            final Object fdb = db;
            new Thread(new Runnable() {
                @Override
                public void run() {
                    try {
                        Object cur = null;
                        for (Method m : fdb.getClass().getMethods()) {
                            if (!m.getName().equals("rawQuery")) continue;
                            Class<?>[] ps = m.getParameterTypes();
                            if (ps.length != 2 || ps[0] != String.class) continue;
                            Object arg = (ps[1] == String[].class)
                                    ? new String[]{talker} : new Object[]{talker};
                            m.setAccessible(true);
                            cur = m.invoke(fdb,
                                    "select createTime,isSend,talker,content,type from message "
                                            + "where talker=? order by createTime asc", arg);
                            break;
                        }
                        if (cur == null) {
                            log("EXPORT|no query");
                            return;
                        }
                        StringBuilder sb = new StringBuilder();
                        sb.append("# 聊天记录导出\n");
                        sb.append("# 会话: ").append(talker).append('\n');
                        sb.append("# 时间: ")
                                .append(new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date()))
                                .append("\n\n");
                        Method mv = cur.getClass().getMethod("moveToNext");
                        Method gs = cur.getClass().getMethod("getString", int.class);
                        Method gl = cur.getClass().getMethod("getLong", int.class);
                        Method gi = cur.getClass().getMethod("getInt", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            long t = (Long) gl.invoke(cur, 0);
                            int isSend = (Integer) gi.invoke(cur, 1);
                            String content = (String) gs.invoke(cur, 3);
                            int type = (Integer) gi.invoke(cur, 4);
                            String who = isSend == 1 ? "我" : "对方";
                            sb.append(new java.text.SimpleDateFormat("MM-dd HH:mm")
                                    .format(new java.util.Date(t * 1000))).append(' ');
                            sb.append(who).append(": ");
                            if (type == 10000) sb.append("[系统] ");
                            sb.append(content == null ? "" : content.replace('\n', ' '));
                            sb.append('\n');
                        }
                        try {
                            cur.getClass().getMethod("close").invoke(cur);
                        } catch (Throwable t) {
                        }
                        String name = DIR + "/export_" + talker.replaceAll("[^a-zA-Z0-9@._-]", "_") + ".txt";
                        java.io.FileOutputStream fo = new java.io.FileOutputStream(name);
                        fo.write(sb.toString().getBytes("UTF-8"));
                        fo.close();
                        log("EXPORT|" + name + "|" + sb.length());
                        final String fn = name;
                        a.runOnUiThread(new Runnable() {
                            @Override
                            public void run() {
                                toast("已导出：" + fn);
                            }
                        });
                    } catch (Throwable t) {
                        Throwable c = t.getCause() != null ? t.getCause() : t;
                        log("EXPORT err " + c);
                    }
                }
            }).start();
        } catch (Throwable t) {
            log("exportChat err " + t);
        }
    }


    private static volatile android.app.Activity chatAct = null;

    private static android.graphics.drawable.Drawable bubbleLeft, bubbleRight;
    private static boolean bubbleLoaded = false;
    private static final ThreadLocal<Boolean> bubbleBusy = new ThreadLocal<Boolean>();

    private static android.graphics.drawable.Drawable loadNine(String path) {
        try {
            android.graphics.Bitmap bm = android.graphics.BitmapFactory.decodeFile(path);
            if (bm == null) return null;
            // .9.png 第 1 行/列是标记线，裁掉后才是真正的图像
            int w = bm.getWidth(), h = bm.getHeight();
            if (w > 4 && h > 4) {
                bm = android.graphics.Bitmap.createBitmap(bm, 1, 1, w - 2, h - 2);
            }
            android.graphics.drawable.BitmapDrawable bd = new android.graphics.drawable.BitmapDrawable(bm);
            bd.setAntiAlias(true);
            return bd;
        } catch (Throwable t) {
            log("bubble load err " + t);
            return null;
        }
    }

    /** 用头像位置判断左右：头像在气泡右边 => 自己发的（右气泡） */
    private static Boolean bubbleSideByAvatar(View bubble) {
        try {
            View row = bubble;
            for (int i = 0; i < 4; i++) {
                if (!(row.getParent() instanceof View)) break;
                row = (View) row.getParent();
            }
            android.widget.ImageView av = findAvatarIn(row);
            if (av == null || av.getWidth() <= 0 || bubble.getWidth() <= 0) return null;
            int avCx = (av.getLeft() + av.getRight()) / 2;
            int bCx = (bubble.getLeft() + bubble.getRight()) / 2;
            return avCx > bCx;
        } catch (Throwable t) {
            return null;
        }
    }

    private static android.widget.ImageView findAvatarIn(View v) {
        try {
            if (v instanceof android.widget.ImageView && !(v instanceof android.widget.TextView)) {
                if (v.getWidth() > 60 && v.getWidth() < 260
                        && Math.abs(v.getWidth() - v.getHeight()) < 60) {
                    return (android.widget.ImageView) v;
                }
            }
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.widget.ImageView r = findAvatarIn(g.getChildAt(i));
                    if (r != null) return r;
                }
            }
        } catch (Throwable t) {
        }
        return null;
    }

    private static boolean insideFooter(View v) {
        try {
            android.view.ViewParent p = v.getParent();
            int d = 0;
            while (p != null && d++ < 15) {
                if (p instanceof View) {
                    String cn = p.getClass().getName();
                    if (cn.contains("ChatFooter") || cn.contains("ChattingFooter")) return true;
                }
                p = p.getParent();
            }
        } catch (Throwable t) {
        }
        return false;
    }

    /** 是不是聊天气泡：LinearLayout 里必须有非空文字的 TextView，且宽度不是全屏 */
    private static boolean isBubbleLike(View v) {
        try {
            if (v.getWidth() < 80 || v.getHeight() < 40) return false;
            View root = v.getRootView();
            if (root != null && root.getWidth() > 0 && v.getWidth() > root.getWidth() * 0.9f) return false;
            android.widget.TextView tv = mainTextOf(v);
            if (tv == null) return false;
            CharSequence cs = tv.getText();
            return cs != null && cs.length() > 0;
        } catch (Throwable t) {
            return false;
        }
    }

    /** 消息行里一定有头像：往上找 3 层，看看兄弟节点里有没有头像大小的 ImageView */
    private static boolean hasAvatarNearby(View bubble) {
        try {
            View cur = bubble;
            for (int up = 0; up < 4; up++) {
                android.view.ViewParent vp = cur.getParent();
                if (!(vp instanceof ViewGroup)) return false;
                ViewGroup parent = (ViewGroup) vp;
                for (int i = 0; i < parent.getChildCount(); i++) {
                    View sib = parent.getChildAt(i);
                    if (sib == cur) continue;
                    if (findAvatarIn(sib) != null) return true;
                }
                cur = parent;
            }
        } catch (Throwable t) {
        }
        return false;
    }

    /** 气泡容器里必须有带文字的 TextView */
    private static boolean hasTextChild(View bubble) {
        try {
            java.util.List<android.widget.TextView> all = new java.util.ArrayList<android.widget.TextView>();
            collectTexts(bubble, all, 0);
            for (android.widget.TextView tv : all) {
                CharSequence cs = tv.getText();
                if (cs != null && cs.length() > 0) return true;
            }
        } catch (Throwable t) {
        }
        return false;
    }

    /** 直接对 drawable 取样判断左右：白色=左，绿色=右 */
    private static int sideByDrawable(android.graphics.drawable.Drawable d) {
        try {
            if (d == null) return 0;
            if (d == bubbleLeft) return 1;
            if (d == bubbleRight) return 2;
            int w = Math.max(1, Math.min(60, d.getIntrinsicWidth()));
            int h = Math.max(1, Math.min(60, d.getIntrinsicHeight()));
            android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(w, h, android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas cv = new android.graphics.Canvas(bm);
            d.setBounds(0, 0, w, h);
            d.draw(cv);
            int col = bm.getPixel(w / 2, h / 2);
            bm.recycle();
            int r = (col >> 16) & 0xFF, g = (col >> 8) & 0xFF, b = col & 0xFF;
            if (g > 150 && g > r + 15 && g > b + 15) return 2;   // 绿色 = 自己（右）
            if (r > 180 && g > 180 && b > 180) return 1;          // 白色 = 对方（左）
            return 0;
        } catch (Throwable t) {
            return 0;
        }
    }

    /** 按原气泡背景色判断左右：白色(浅色)=左/对方，绿色=右/自己 */
    private static int sideByBgColor(android.widget.TextView tv) {
        try {
            android.graphics.drawable.Drawable d = tv.getBackground();
            if (d == null) return 0;
            if (d == bubbleLeft) return 1;
            if (d == bubbleRight) return 2;
            int col = 0;
            if (d instanceof android.graphics.drawable.ColorDrawable) {
                col = ((android.graphics.drawable.ColorDrawable) d).getColor();
            } else {
                android.graphics.Bitmap bm = android.graphics.Bitmap.createBitmap(
                        Math.max(1, d.getIntrinsicWidth()), Math.max(1, d.getIntrinsicHeight()),
                        android.graphics.Bitmap.Config.ARGB_8888);
                android.graphics.Canvas cv = new android.graphics.Canvas(bm);
                d.setBounds(0, 0, bm.getWidth(), bm.getHeight());
                d.draw(cv);
                col = bm.getPixel(bm.getWidth() / 2, bm.getHeight() / 2);
                bm.recycle();
            }
            int r = (col >> 16) & 0xFF, g = (col >> 8) & 0xFF, b = col & 0xFF;
            int a = (col >>> 24) & 0xFF;
            if (a < 40) return 0;
            // 绿色系（微信自己的气泡 #95EC69 附近）
            if (g > 150 && g > r + 20 && g > b + 20) return 2;
            // 白色/浅色（对方的白气泡）
            if (r > 190 && g > 190 && b > 190) return 1;
            return 0;
        } catch (Throwable t) {
            return 0;
        }
    }

    /** 是否在聊天消息列表内（区别于会话列表） */
    private static boolean insideChatMsgList(View v) {
        try {
            android.view.ViewParent p = v.getParent();
            int d = 0;
            while (p != null && d++ < 16) {
                if (p instanceof View) {
                    String cn = p.getClass().getName();
                    // 只认消息列表滚容器（标题栏虽是 ChattingUI 的一部分，但不在这个容器里）
                    if (cn.contains("ScrollControl") || cn.contains("ChattingUIGroupInner")) return true;
                    if (cn.contains("MvvmConversation") || cn.contains("ConversationListView")) return false;
                }
                p = p.getParent();
            }
        } catch (Throwable t) {
        }
        return false;
    }

    private static boolean insideList(View v) {
        try {
            android.view.ViewParent p = v.getParent();
            int depth = 0;
            while (p != null && depth++ < 12) {
                if (p instanceof View) {
                    String cn = p.getClass().getName();
                    if (cn.contains("RecyclerView") || cn.contains("ListView")) return true;
                }
                p = p.getParent();
            }
        } catch (Throwable t) {
        }
        return false;
    }

    private static final java.util.IdentityHashMap<Object, Boolean> bubbleSide = new java.util.IdentityHashMap<Object, Boolean>();
    private static int bubbleSeen = 0;

    /** 首次学习左右映射，之后同步替换 */
    private static void learnBubble(final View v, final android.graphics.drawable.Drawable orig) {
        try {
            if (Boolean.TRUE.equals(bubbleBusy.get())) return;
            if (!bubbleLoaded) {
                bubbleLoaded = true;
                String base = cfg().optString("themePack", DIR + "/wxh_theme") + "/images/";
                bubbleLeft = loadNine(base + "left_bubble.9.png");
                bubbleRight = loadNine(base + "right_bubble.9.png");
                log("BUBBLE|loaded L=" + (bubbleLeft != null) + " R=" + (bubbleRight != null));
            }
            if (bubbleLeft == null || bubbleRight == null) return;
            Boolean side = bubbleSide.get(orig);
            if (side == null) {
                v.postDelayed(new Runnable() {
                    @Override
                    public void run() {
                        try {
                            if (!insideList(v) || insideFooter(v)) return;
                            View root = v.getRootView();
                            if (root == null || root.getWidth() <= 0) return;
                            if (v.getWidth() <= 0) {
                                v.postDelayed(this, 120);
                                return;
                            }
                            Boolean byAv = bubbleSideByAvatar(v);
                            int cx = (v.getLeft() + v.getRight()) / 2;
                            boolean right = byAv != null ? byAv.booleanValue() : (cx > root.getWidth() / 2);
                            bubbleSide.put(orig, right);
                            log("BUBBLE|learn " + (right ? "R" : "L"));
                            bubbleBusy.set(Boolean.TRUE);
                            v.setBackgroundDrawable(right ? bubbleRight : bubbleLeft);
                            bubbleBusy.set(Boolean.FALSE);
                        } catch (Throwable t) {
                        }
                    }
                }, 150);
                return;
            }
            if (!v.isAttachedToWindow() || !insideList(v) || insideFooter(v)) {
                v.post(new Runnable() {
                    @Override
                    public void run() {
                        try {
                            if (!insideList(v) || insideFooter(v)) return;
                            bubbleBusy.set(Boolean.TRUE);
                            v.setBackgroundDrawable(side ? bubbleRight : bubbleLeft);
                            bubbleBusy.set(Boolean.FALSE);
                        } catch (Throwable t) {
                            bubbleBusy.set(Boolean.FALSE);
                        }
                    }
                });
                return;
            }
            bubbleBusy.set(Boolean.TRUE);
            v.setBackgroundDrawable(side ? bubbleRight : bubbleLeft);
            bubbleBusy.set(Boolean.FALSE);
        } catch (Throwable t) {
            bubbleBusy.set(Boolean.FALSE);
            log("learnBubble err " + t);
        }
    }

    /** 同步替换：按布局方向判断左右，并重算 padding */
    private static void replaceBubble(View v, android.graphics.drawable.Drawable orig) {
        try {
            if (Boolean.TRUE.equals(bubbleBusy.get())) return;
            if (!bubbleLoaded) {
                bubbleLoaded = true;
                String base = cfg().optString("themePack", DIR + "/wxh_theme") + "/images/";
                bubbleLeft = loadNine(base + "left_bubble.9.png");
                bubbleRight = loadNine(base + "right_bubble.9.png");
                log("BUBBLE|loaded L=" + (bubbleLeft != null) + " R=" + (bubbleRight != null));
            }
            if (bubbleLeft == null && bubbleRight == null) return;
            Boolean side = bubbleSide.get(orig);
            if (side == null) {
                boolean right = false;
                try {
                    Object lp = v.getLayoutParams();
                    if (lp instanceof android.widget.LinearLayout.LayoutParams) {
                        right = (((android.widget.LinearLayout.LayoutParams) lp).gravity & android.view.Gravity.RIGHT) != 0;
                    } else if (lp instanceof android.widget.FrameLayout.LayoutParams) {
                        right = (((android.widget.FrameLayout.LayoutParams) lp).gravity & android.view.Gravity.RIGHT) != 0;
                    }
                } catch (Throwable t) {
                }
                side = right;
                bubbleSide.put(orig, side);
                log("BUBBLE|pair " + (bubbleSeen++) + " -> " + (right ? "R" : "L"));
            }
            android.graphics.drawable.Drawable d = side ? bubbleRight : bubbleLeft;
            if (d == null) return;
            bubbleBusy.set(Boolean.TRUE);
            v.setBackgroundDrawable(d);
            android.graphics.Rect r = new android.graphics.Rect();
            d.getPadding(r);
            v.setPadding(r.left, r.top, r.right, r.bottom);
            bubbleBusy.set(Boolean.FALSE);
        } catch (Throwable t) {
            bubbleBusy.set(Boolean.FALSE);
            log("replaceBubble err " + t);
        }
    }

    private static void applyBubble(final View v) {
        try {
            if (Boolean.TRUE.equals(bubbleBusy.get())) return;
            if (!bubbleLoaded) {
                bubbleLoaded = true;
                String base = cfg().optString("themePack", DIR + "/wxh_theme") + "/images/";
                bubbleLeft = loadNine(base + "left_bubble.9.png");
                bubbleRight = loadNine(base + "right_bubble.9.png");
                log("BUBBLE|loaded L=" + (bubbleLeft != null) + " R=" + (bubbleRight != null));
            }
            if (bubbleLeft == null && bubbleRight == null) return;
            v.post(new Runnable() {
                @Override
                public void run() {
                    try {
                        if (!insideList(v)) return;
                        View root = v.getRootView();
                        int screen = root == null ? 0 : root.getWidth();
                        if (screen <= 0) return;
                        int cx = (v.getLeft() + v.getRight()) / 2;
                        android.graphics.drawable.Drawable d = cx < screen / 2 ? bubbleLeft : bubbleRight;
                        if (d == null) return;
                        bubbleBusy.set(Boolean.TRUE);
                        v.setBackgroundDrawable(d);
                        bubbleBusy.set(Boolean.FALSE);
                    } catch (Throwable t) {
                        bubbleBusy.set(Boolean.FALSE);
                    }
                }
            });
        } catch (Throwable t) {
            log("applyBubble err " + t);
        }
    }

    /** 往聊天里插一条系统消息（显示在原消息下方） */
    private static boolean insertSysMsg(String talker, long msgId, String text) {
        try {
            ClassLoader app = Plugin.class.getClassLoader();
            try {
                Class<?> probe = Class.forName("wxh.Probe", true, Plugin.class.getClassLoader());
                Object l = probe.getMethod("getAppLoader").invoke(null);
                if (l instanceof ClassLoader) app = (ClassLoader) l;
            } catch (Throwable t0) {
            }
            Object f = Class.forName("w41.i9", false, app).getMethod("b").invoke(null);
            Object store = f.getClass().getMethod("v").invoke(f);
            Class<?> f9 = Class.forName("com.tencent.mm.storage.f9", false, app);
            Object msg = null;
            try {
                Object orig = store.getClass().getMethod("U3", String.class, long.class)
                        .invoke(store, talker, msgId);
                if (orig != null) {
                    for (Method cm : f9.getDeclaredMethods()) {
                        if (cm.getName().equals("E1") && cm.getParameterTypes().length == 1) {
                            cm.setAccessible(true);
                            msg = cm.invoke(null, orig);
                            log("SYSMSG|cloned");
                            break;
                        }
                    }
                }
            } catch (Throwable t1) {
                log("SYSMSG clone err " + t1);
            }
            if (msg == null) msg = f9.newInstance();
            set(msg, "field_talker", talker);
            set(msg, "field_content", text);
            setInt(msg, "field_type", 10000);
            setInt(msg, "field_isSend", 0);
            setInt(msg, "field_status", 6);
            setInt(msg, "field_isShowTimer", 0);
            setLong(msg, "field_createTime", System.currentTimeMillis());
            setLong(msg, "field_msgId", 0);
            set(msg, "field_msgSource", "wxh");
            set(msg, "field_reserved", "wxh");
            Object r = null;
            try {
                Object ha = store.getClass().getMethod("Ha", msg.getClass()).invoke(store, msg);
                log("SYSMSG|used Ha()=" + ha);
                if (ha != null && ((Number) ha).longValue() > 0) r = ha;
            } catch (Throwable t8) {
                log("SYSMSG Ha err " + t8);
            }
            try {
                Class<?> f0 = Class.forName("gg5.f0", false, app);
                for (Method m : store.getClass().getMethods()) {
                    if (!m.getName().equals("insert")) continue;
                    Class<?>[] ps = m.getParameterTypes();
                    if (ps.length == 1 && ps[0].isAssignableFrom(msg.getClass())) {
                        m.setAccessible(true);
                        r = m.invoke(store, msg);
                        log("SYSMSG|used insert(f0)");
                        break;
                    }
                }
            } catch (Throwable t7) {
                log("SYSMSG insert err " + t7);
            }
            if (r == null) {
                for (Method m : store.getClass().getMethods()) {
                    if (!m.getName().equals("a")) continue;
                    Class<?>[] ps = m.getParameterTypes();
                    if (ps.length == 3 && ps[0].isAssignableFrom(msg.getClass())
                            && ps[1] == boolean.class && ps[2] == boolean.class) {
                        m.setAccessible(true);
                        r = m.invoke(store, msg, false, true);
                        log("SYSMSG|used a(f9,ZZ)");
                        break;
                    }
                }
            }
            log("SYSMSG|inserted|" + talker + "|" + text + "|r=" + r);
            try {
                boolean ok = r != null && !(r instanceof Boolean);
                if (ok) {
                    store.getClass().getMethod("doNotify").invoke(store);
                    log("SYSMSG|notified");
                }
            } catch (Throwable t9) {
                log("SYSMSG notify err " + t9);
            }
            return true;
        } catch (Throwable t) {
            log("SYSMSG err " + t);
            return false;
        }
    }

