    private static android.view.View findByClassLike(android.view.View v, String like, int depth) {
        if (depth > 12) return null;
        try {
            if (v.getClass().getName().contains(like)) return v;
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.view.View r = findByClassLike(g.getChildAt(i), like, depth + 1);
                    if (r != null) return r;
                }
            }
        } catch (Throwable ignore) { }
        return null;
    }

    /** 找到文字后，点它最近的可点击祖先（微信的点击监听挂在整行上） */
    private static boolean clickAncestor(android.view.View v) {
        try {
            android.view.View cur = v;
            for (int i = 0; i < 8 && cur != null; i++) {
                if (cur.hasOnClickListeners()) {
                    cur.performClick();
                    return true;
                }
                android.view.ViewParent p0 = cur.getParent();
                cur = p0 instanceof android.view.View ? (android.view.View) p0 : null;
            }
            return v.performClick();
        } catch (Throwable t) { return false; }
    }

    /** 通过点击底部「发现」→「朋友圈」进入，兼容 8.0.80（无公开 Activity） */
    private static void openMoments(final android.app.Activity a) {
        if (openingMoments) return;
        openingMoments = true;
        try {
            final android.view.View decor = a.getWindow().getDecorView();
            // 优先用 ViewPager 直接切到「发现」，避免点击动画和闪烁
            boolean switched = false;
            try {
                android.view.View vp = findByClassLike(decor, "ViewPager", 0);
                if (vp != null) {
                    java.lang.reflect.Method m = vp.getClass().getMethod("setCurrentItem", int.class, boolean.class);
                    m.setAccessible(true);
                    Object cur0 = null;
                    try { cur0 = vp.getClass().getMethod("getCurrentItem").invoke(vp); } catch (Throwable ignore) { }
                    m.invoke(vp, 2, false);
                    Object cur1 = null;
                    try { cur1 = vp.getClass().getMethod("getCurrentItem").invoke(vp); } catch (Throwable ignore) { }
                    switched = true;
                    log("MOMENTS|pager " + vp.getClass().getName() + " " + cur0 + "->" + cur1);
                }
            } catch (Throwable ignore) { }
            android.widget.TextView tab = switched ? null : findText(decor, "发现");
            if (tab != null) {
                tab.performClick();
                log("MOMENTS|tab clicked");
            } else if (!switched) {
                toast("没找到「发现」");
                return;
            }
            final android.os.Handler hh = new android.os.Handler(android.os.Looper.getMainLooper());
            final int[] tries = {0};
            hh.postDelayed(new Runnable() {
                @Override public void run() {
                    try {
                        android.app.Activity ca = mainAct != null ? mainAct : a;
                        android.widget.TextView row = findText(ca.getWindow().getDecorView(), "朋友圈");
                        if (row != null) {
                            boolean ok = clickAncestor(row);
                            log("MOMENTS|entry clicked tries=" + tries[0] + " ok=" + ok);
                            openingMoments = false;
                            return;
                        }
                        tries[0]++;
                        if (tries[0] < 6) {
                            hh.postDelayed(this, 150);
                        } else {
                            toast("请手动点「发现 → 朋友圈」");
                            log("MOMENTS|entry not found");
                        }
                        openingMoments = false;
                    } catch (Throwable t) { log("MOMENTS|" + t); }
                }
            }, 150);
            pendingReturnToChats = true;
        } catch (Throwable t) { log("MOMENTS|" + t); }
    }

    private static void drawerAction(android.app.Activity a, String type, String action, String text) {
        try {
            if ("wx_config_mark_read".equals(type)) { clearAllUnread(); refreshConvList(a); toast("已全部标为已读"); return; }
            if ("wx_config_app".equals(type) || "settings".equals(type)) { showSettings(a); return; }
            String cls = null;
            if ("timeline".equals(type)) { openMoments(a); return; }
            else if ("walletcoin".equals(type)) cls = "com.tencent.mm.plugin.offline.ui.WalletOfflineCoinPurseUI";
            else if ("wallet".equals(type)) cls = "com.tencent.mm.plugin.mall.ui.MallIndexUIv2";
            else if ("scan".equals(type)) cls = "com.tencent.mm.plugin.scanner.ui.BaseScanUI";
            else if ("favorite".equals(type)) cls = "com.tencent.mm.plugin.fav.ui.FavoriteIndexUI";
            else if ("appbrand".equals(type)) cls = "com.tencent.mm.plugin.appbrand.ui.AppBrandLauncherUI";
            else if ("qrcode".equals(type)) cls = "com.tencent.mm.plugin.setting.ui.setting.SelfQRCodeUI";
            else if ("snsuser".equals(type)) cls = "com.tencent.mm.plugin.sns.ui.SnsUserUI";
            else if ("shake".equals(type)) cls = "com.tencent.mm.plugin.shake.ui.ShakeReportUI";
            else if ("custom".equals(type) && action != null && action.contains(".")) cls = action;
            if (cls == null) { toast(text + " 暂不支持"); return; }
            try {
                android.content.Intent it = new android.content.Intent();
                it.setClassName(a.getPackageName(), cls);
                it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
                a.startActivity(it);
            } catch (Throwable t1) {
                String alt = null;
                if ("wallet".equals(type)) alt = "com.tencent.mm.plugin.mall.ui.MallIndexUI";
                if (alt != null) {
                    android.content.Intent it2 = new android.content.Intent();
                    it2.setClassName(a.getPackageName(), alt);
                    it2.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
                    a.startActivity(it2);
                } else {
                    throw t1;
                }
            }
        } catch (Throwable t) {
            toast(text + " 打开失败");
            log("DRAWER|act " + t);
        }
    }

    private static synchronized JSONObject themePack() {
        try {
            File f = new File(cfg().optString("themePack", DIR + "/wxh_theme"), "settings.json");
            long t = f.lastModified();
            if (pack != null && t == packAt) return pack;
            if (!f.isFile()) return null;
            FileInputStream in = new FileInputStream(f);
            byte[] b = new byte[(int) f.length()];
            int got = 0;
            while (got < b.length) {
                int r = in.read(b, got, b.length - got);
                if (r <= 0) break;
                got += r;
            }
            in.close();
            pack = new JSONObject(new String(b, "UTF-8"));
            packAt = t;
            return pack;
        } catch (Throwable t) {
            log("themePack err " + t);
            return null;
        }
    }




    private static final java.util.ArrayList<java.lang.ref.WeakReference<android.view.View>> themeRoots =
            new java.util.ArrayList<java.lang.ref.WeakReference<android.view.View>>();
    private static android.os.Handler themePulse = null;
    private static long themePulseAt = 0;

    /** 每 300ms 把四页里新冒出来的行白底再清一遍（微信会在 bind 时把背景贴回去） */
    private static void ensureRowPulse() {
        if (THEME_SAFE_OFF) return;   // 稳定模式：不改微信外观

        if (themePulse != null) return;
        themePulseAt = System.currentTimeMillis();
        themePulse = new android.os.Handler(android.os.Looper.getMainLooper());
        themePulse.post(new Runnable() {
            @Override public void run() {
                try {
                    if (TABS_THEME_OFF) return;   // 四页主题关闭
                    for (int i = themeRoots.size() - 1; i >= 0; i--) {
                        android.view.View v = themeRoots.get(i) == null ? null : themeRoots.get(i).get();
                        if (v == null) { themeRoots.remove(i); continue; }
                        if (!v.isAttachedToWindow()) continue;
                        if (v.getVisibility() != android.view.View.VISIBLE) continue;
                        int n = clearBgsDeep(v);
                        if (n > 0 && System.currentTimeMillis() - rowPulseLogAt > 3000) {
                            rowPulseLogAt = System.currentTimeMillis();
                            log("ROWSCRUB|" + v.getClass().getSimpleName() + "|" + n);
                        }
                    }
                } catch (Throwable ignore) { }
                try {
                    if (topAct != null && System.currentTimeMillis() - pageBgAt > 10) {
                        pageBgAt = System.currentTimeMillis();
                        applyThemePageBg(topAct);   // 每 30ms 确认四页底图（首帧对齐）
                    }
                } catch (Throwable ignore) { }
                // 原来固定 300ms 全树 clearBgsDeep；改成前 2 分钟 1200ms、之后 5000ms，
                // 背景稳定后没必要一直全树遍历
                if (themePulse != null) {
                    long life = System.currentTimeMillis() - themePulseAt;
                    themePulse.postDelayed(this, life < 120000L ? 1200L : 5000L);
                }
            }
        });
    }

    private static long rowPulseLogAt = 0;
    private static long pageBgAt = 0;



    /** 每帧绘制前清一次底（绘制前完成 → 不会看到白块闪） */
    private static void installPreDrawClean(final android.view.View root) {
        if (THEME_SAFE_OFF) return;   // 稳定模式：不改微信外观

        try {
            if (root == null) return;
            if (root.getTag(0x0f0f0f39) != null) return;
            root.setTag(0x0f0f0f39, Boolean.TRUE);
            root.getViewTreeObserver().addOnPreDrawListener(new android.view.ViewTreeObserver.OnPreDrawListener() {
                @Override public boolean onPreDraw() {
                    // 稳定性优先：每帧清扫会导致列表重绘错乱（文字重影/乱码），
                    // 改为 1200ms 节流且只在页面静止时做一次轻度清理
                    try {
                        long now = System.currentTimeMillis();
                        if (now - preDrawAt < 1200) return true;
                        if (root.getScrollY() != 0) return true;
                        preDrawAt = now;
                        for (java.lang.ref.WeakReference<android.view.View> r : themeRoots) {
                            if (r != null && r.get() == root) {
                                clearBgsDeep(root);
                                break;
                            }
                        }
                    } catch (Throwable ignore) { }
                    return true;
                }
            });
            log("PREDRAW|installed " + root.getClass().getSimpleName());
        } catch (Throwable ignore) { }
    }

    /** 判断某个 View 是否挂在四页主题根之下 */
    private static boolean underThemeRoot(android.view.View v) {
        try {
            for (int depth = 0; v != null && depth < 24; depth++) {
                for (java.lang.ref.WeakReference<android.view.View> r : themeRoots) {
                    if (r != null && r.get() == v) return true;
                }
                android.view.ViewParent p = v.getParent();
                v = (p instanceof android.view.View) ? (android.view.View) p : null;
            }
        } catch (Throwable ignore) { }
        return false;
    }

    /** 行一绑定就清背景（在绘制之前完成，所以不会闪白） */
    private static void installRowBindHook(ClassLoader app) {
        String[] names = { "androidx.recyclerview.widget.RecyclerView$Adapter",
                "android.support.v7.widget.RecyclerView$Adapter" };
        int ok = 0;
        for (final String cn : names) {
            try {
                Class<?> c = Class.forName(cn, false, app);
                XposedBridge.hookAllMethods(c, "onBindViewHolder", new XC_MethodHook() {
                    @Override protected void afterHookedMethod(MethodHookParam p) {
                        try {
                            if (p.args == null || p.args.length < 1) return;
                            Object vh = p.args[0];
                            if (vh == null) return;
                            java.lang.reflect.Field f = vh.getClass().getField("itemView");
                            Object iv = f.get(vh);
                            if (!(iv instanceof android.view.View)) return;
                            final android.view.View item = (android.view.View) iv;
                            if (!underThemeRoot(item)) return;
                            clearBgsDeep(item);
                            log("ROWBIND|" + item.getClass().getSimpleName());
                        } catch (Throwable ignore) { }
                    }
                });
                ok++;
            } catch (Throwable ignore) { }
        }
        log("hooked row bind x" + ok);
    }

    /** 上一版同款：递归清空页面内所有子控件背景，让 fragment 底图透出来（不动文字/图标内容） */

    /** 把状态栏/标题栏那条灰底清成透明，让主题图透上来（只对四个 tab 页生效） */
    private static volatile long lastTopBandAt = 0;


    /** 当前是否在四个 tab 页（非聊天、非二级页） */
    private static volatile boolean tabThemeActive = false;

    /** 顶部 13% 区域 + 接近满宽 → 认为是状态栏/标题栏那条灰底 */
    private static boolean isTopBandView(android.view.View v) {
        try {
            android.app.Activity a = topAct;
            if (a == null) return false;
            int sw = a.getResources().getDisplayMetrics().widthPixels;
            int sh = a.getResources().getDisplayMetrics().heightPixels;
            if (v.getWidth() < sw * 0.8f) return false;
            int[] pos = new int[2];
            v.getLocationInWindow(pos);
            return pos[1] < sh * 0.13f;
        } catch (Throwable ignore) { return false; }
    }

    private static void clearTopBand(android.app.Activity a) {

        // 标题栏那一行保持微信原生外观，不再处理（用户要求）
        if (true) return;
        if (a == null) return;
        long now = System.currentTimeMillis();
        if (now - lastTopBandAt >= 400) {           // 只节流状态栏色，色带每帧都清
            lastTopBandAt = now;
            try {
                android.view.Window w = a.getWindow();
                if (w != null && android.os.Build.VERSION.SDK_INT >= 21) {
                    w.setStatusBarColor(0x00000000);    // 状态栏透明
                }
            } catch (Throwable ignore) { }
        }

        try {
            android.view.View decor = a.getWindow() == null ? null : a.getWindow().getDecorView();
            if (decor == null) return;
            int sw = a.getResources().getDisplayMetrics().widthPixels;
            int sh = a.getResources().getDisplayMetrics().heightPixels;
            int limit = (int) (sh * 0.16f);                          // 顶部 13% 视为标题区
            clearBandIn(decor, 0, sw, limit, a);
        } catch (Throwable ignore) { }
    }

    private static void clearBandIn(android.view.View v, int depth, int sw, int limit, android.app.Activity a) {
        if (v == null || depth > 8) return;
        if (!(v instanceof android.view.ViewGroup)) return;
        android.view.ViewGroup g = (android.view.ViewGroup) v;
        for (int i = 0; i < g.getChildCount(); i++) {
            android.view.View c = null;
            try { c = g.getChildAt(i); } catch (Throwable ignore) { continue; }
            if (c == null) continue;
            try {
                if (c.getVisibility() == android.view.View.VISIBLE && c.getHeight() > 0) {
                    int[] pos = new int[2];
                    c.getLocationInWindow(pos);
                    boolean inTop = pos[1] < limit;
                    boolean wide = c.getWidth() >= sw * 0.7f;
                    if (inTop && wide) {
                        // 直接清成透明，让页面主题图透上来；
                        // 不再用"按坐标贴切片"的方式（坐标/位图失效时会花屏成乱码）
                        try { if (c.getBackground() != null) c.setBackground(null); } catch (Throwable ignore) { }
                        try { if (c.getForeground() != null) c.setForeground(null); } catch (Throwable ignore) { }
                    }
                }
            } catch (Throwable ignore) { }
            clearBandIn(c, depth + 1, sw, limit, a);
        }
    }

    private static int clearBgsDeep(android.view.View v) {
        if (v == null) return 0;
        int sh = v.getResources().getDisplayMetrics().heightPixels;
        int limit = (int) (sh * 0.17f);      // 顶部 17% 是标题/状态栏区，保持原生
        return clearBgsDeep2(v, limit, 0);
    }

    private static int clearBgsDeep2(android.view.View v, int limit, int depth) {
        if (v == null || depth > 24) return 0;
        int n = 0;
        try {
            if (v instanceof android.view.ViewGroup) {
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                int[] loc = new int[2];
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.view.View c = g.getChildAt(i);
                    try {
                        c.getLocationOnScreen(loc);
                        boolean inTopBand = (loc[1] + c.getHeight()) <= limit;
                        if (!inTopBand) {
                            String cn = c.getClass().getName();
                            if (!cn.contains("TextureView") && !cn.contains("VideoView")) {
                                if (c.getBackground() != null) {
                                    c.setBackground(null);
                                    n++;
                                }
                            }
                        }
                    } catch (Throwable ignore) { }
                    n += clearBgsDeep2(c, limit, depth + 1);
                }
            }
        } catch (Throwable ignore) { }
        return n;
    }

    /** 主题包四页图：settings.json 里没有配置时，按文件名顺序回退取 IMG_* */

    private static final java.util.HashMap<String, android.graphics.Bitmap> frostCache =
            new java.util.HashMap<String, android.graphics.Bitmap>();

    /** 给背景图铺一层半透明白（磨砂感），alpha 0~255 */
    private static android.graphics.Bitmap frostWith(android.graphics.Bitmap src, int whiteA) {
        if (src == null) return null;
        if (whiteA <= 0) return src;
        try {
            String k = src.getWidth() + "x" + src.getHeight() + "#" + whiteA + "#" + src.hashCode();
            android.graphics.Bitmap c = frostCache.get(k);
            if (c != null) return c;
            android.graphics.Bitmap bm = src.copy(android.graphics.Bitmap.Config.ARGB_8888, true);
            android.graphics.Canvas cv = new android.graphics.Canvas(bm);
            cv.drawColor((whiteA << 24) | 0x00FFFFFF);
            frostCache.put(k, bm);
            if (frostCache.size() > 8) frostCache.clear();
            return bm;
        } catch (Throwable t) { return src; }
    }


    /** 把页面顶部那条标题栏刷成白（对齐「微信」页的观感） */
    private static int whitenTopBand(android.view.View root, android.app.Activity act) {
        int n = 0;
        try {
            int sw = act.getResources().getDisplayMetrics().widthPixels;
            int sh = act.getResources().getDisplayMetrics().heightPixels;
            int statusH = 0;
            try {
                int id = act.getResources().getIdentifier("status_bar_height", "dimen", "android");
                if (id > 0) statusH = act.getResources().getDimensionPixelSize(id);
            } catch (Throwable ignore) { }
            java.util.ArrayList<android.view.View> q = new java.util.ArrayList<android.view.View>();
            q.add(root);
            int guard = 0;
            while (!q.isEmpty() && guard++ < 500) {
                android.view.View v = q.remove(0);
                try {
                    int[] loc = new int[2];
                    v.getLocationOnScreen(loc);
                    int w = v.getWidth(), h = v.getHeight();
                    boolean topBand = loc[1] <= statusH + dp(act, 8) && h > dp(act, 24) && h <= dp(act, 190)
                            && w >= (int) (sw * 0.85);
                    if (topBand) {
                        v.setBackgroundColor(0x00000000);
                        n++;
                    }
                } catch (Throwable ignore) { }
                if (v instanceof android.view.ViewGroup) {
                    android.view.ViewGroup g = (android.view.ViewGroup) v;
                    for (int i = 0; i < g.getChildCount(); i++) q.add(g.getChildAt(i));
                }
            }
        } catch (Throwable ignore) { }
        return n;
    }

    private static String themePageImg(String key) {
        try {
            int iu = key.startsWith("Main") ? 0
                    : key.startsWith("Contact") ? 1
                    : key.startsWith("Discover") ? 2 : 3;
            java.io.File uf = new java.io.File(DIR + "/tab_bg_" + iu + ".jpg");
            if (uf.isFile()) return uf.getAbsolutePath();
        } catch (Throwable ignore) { }
        try {
            int i1 = key.startsWith("Main") ? 0
                    : key.startsWith("Contact") ? 1
                    : key.startsWith("Discover") ? 2 : 3;
            String ov = cfg().optString("pageImg" + i1, "");
            if (ov != null && ov.length() > 0) {
                java.io.File f1 = new java.io.File(cfg().optString("themePack", DIR + "/wxh_theme") + "/images", ov);
                if (f1.exists()) return f1.getAbsolutePath();
            }
        } catch (Throwable ignore) { }
        try {
            int i0 = key.startsWith("Main") ? 0
                    : key.startsWith("Contact") ? 1
                    : key.startsWith("Discover") ? 2 : 3;
            java.io.File d0 = new java.io.File(cfg().optString("themePack", DIR + "/wxh_theme") + "/images");
            String[] e0 = {".jpg", ".png", ".jpeg", ".webp"};
            for (String e : e0) {
                java.io.File pf0 = new java.io.File(d0, "page" + i0 + e);
                if (pf0.exists()) return pf0.getAbsolutePath();
            }
        } catch (Throwable ignore) { }
        String v = themeBg(key);
        if (v != null) return v;
        try {
            int idx = key.startsWith("Main") ? 0
                    : key.startsWith("Contact") ? 1
                    : key.startsWith("Discover") ? 2 : 3;
            java.io.File dir = new java.io.File(cfg().optString("themePack", DIR + "/wxh_theme") + "/images");
            String[] fs = dir.list();
            if (fs == null) return null;
            // 优先用 page0..page3（用户指定的四页图），否则回退 IMG_*
            String[] exts = {".jpg", ".png", ".jpeg", ".webp"};
            for (String e : exts) {
                java.io.File pf = new java.io.File(dir, "page" + idx + e);
                if (pf.exists()) return pf.getAbsolutePath();
            }
            java.util.ArrayList<String> imgs = new java.util.ArrayList<String>();
            for (String f : fs) {
                if (f.startsWith("IMG_") && (f.endsWith(".png") || f.endsWith(".jpg"))) imgs.add(f);
            }
            if (imgs.isEmpty()) return null;
            java.util.Collections.sort(imgs);
            return dir.getAbsolutePath() + "/" + imgs.get(Math.min(idx, imgs.size() - 1));
        } catch (Throwable t) { return null; }
    }

    private static String themeBg(String key) {
        try {
            // 四个 tab 页背景：page0~page3 优先（统一入口，所有调用方都吃这个）
            if (key.endsWith("FragmentBackground")) {
                int i0 = key.startsWith("Main") ? 0
                        : key.startsWith("Contact") ? 1
                        : key.startsWith("Discover") ? 2 : 3;
                java.io.File d0 = new java.io.File(cfg().optString("themePack", DIR + "/wxh_theme") + "/images");
                String[] e0 = {".jpg", ".png", ".jpeg", ".webp"};
                for (String e : e0) {
                    java.io.File pf0 = new java.io.File(d0, "page" + i0 + e);
                    if (pf0.exists()) return pf0.getAbsolutePath();
                }
            }
        } catch (Throwable ignore) { }
        try {
            JSONObject p = themePack();
            if (p == null || !p.optBoolean(key + "Enable", false)) return null;
            org.json.JSONArray arr = p.optJSONArray(key);
            if (arr == null || arr.length() == 0) return null;
            JSONObject o = arr.optJSONObject(0);
            if (o == null) return null;
            String img = o.optString("p", "");
            if (img.length() == 0) return null;
            return cfg().optString("themePack", DIR + "/wxh_theme") + "/images/" + img;
        } catch (Throwable t) {
            return null;
        }
    }


    /** 隐藏联系人：在会话列表 / 通讯录里把命中名单的行直接隐藏（只在本机） */
    private static void applyHideContacts(android.app.Activity a) {
        try {
            if (a == null) return;
            if (!a.getClass().getName().endsWith("LauncherUI")) return;
            if (isInChatUi()) return;
            String raw = cfg().optString("hideContacts", "");
            if (raw == null) return;
            raw = raw.trim();
            if (raw.length() == 0) return;
            final String[] names = raw.split("[,，;；]");
            if (names.length == 0) return;
            final android.view.View decor = a.getWindow().getDecorView();
            java.util.ArrayList<android.view.View> lists = new java.util.ArrayList<android.view.View>();
            collectListViews(decor, lists, 0);
            for (android.view.View lv : lists) {
                if (!(lv instanceof android.view.ViewGroup)) continue;
                android.view.ViewGroup g = (android.view.ViewGroup) lv;
                for (int i = 0; i < g.getChildCount(); i++) {
                    android.view.View row = g.getChildAt(i);
                    if (row == null) continue;
                    Object tag = row.getTag(0x0f0f0f30);
                    if (tag != null) continue;      // 已处理过
                    String txt = collectText(row);
                    if (txt.length() == 0) continue;
                    for (String n0 : names) {
                        String n = n0.trim();
                        if (n.length() == 0) continue;
                        if (txt.contains(n)) {
                            row.setTag(0x0f0f0f30, "hidden");
                            row.setVisibility(android.view.View.GONE);
                            log("HIDEC|" + n);
                            break;
                        }
                    }
                }
            }
        } catch (Throwable ignore) { }
    }

    /** 收集列表类容器（RecyclerView / ListView） */
    private static void collectListViews(android.view.View v, java.util.List<android.view.View> out, int d) {
        if (v == null || d > 8 || out.size() > 12) return;
        try {
            if (v instanceof android.view.ViewGroup) {
                String cn = v.getClass().getSimpleName();
                if (cn.contains("RecyclerView") || cn.contains("ListView")) out.add(v);
                android.view.ViewGroup g = (android.view.ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) collectListViews(g.getChildAt(i), out, d + 1);
            }
        } catch (Throwable ignore) { }
    }

    private static Runnable hideContactsPulse = null;
    private static void startHideContactsPulse(final android.app.Activity a) {
        if (hideContactsPulse != null) return;
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        hideContactsPulse = new Runnable() {
            @Override public void run() {
                try { applyHideContacts(a); } catch (Throwable ignore) { }
                try { beautifyConvList(a); } catch (Throwable ignore) { }
                try { hideOtherDeviceBanner(a); } catch (Throwable ignore) { }
                try { applyMeSimplify(a); } catch (Throwable ignore) { }
                try { floatTabBar(a); } catch (Throwable ignore) { }
                try { hideDiscoverItems(a); } catch (Throwable ignore) { }
                try {
                    if (cfg().optBoolean("pressEffect", false)) {
                        android.view.View lv0 = findConvListView(a.getWindow().getDecorView(), 0);
                        if (lv0 instanceof android.view.ViewGroup) applyPressEffect((android.view.ViewGroup) lv0);
                    }
                } catch (Throwable ignore) { }
                try { hideRecentPage(a); } catch (Throwable ignore) { }
                try { h.postDelayed(this, 600); } catch (Throwable ignore) { }
            }
        };
        h.postDelayed(hideContactsPulse, 400);
    }

    private static void applyTheme(Object activity) {
        try {
            if (activity instanceof android.app.Activity) {
                String an = activity.getClass().getName();
                if (an.contains("Chatting") || an.contains("chatting")) return;
                mainAct = (android.app.Activity) activity;
                try {
                    final android.app.Activity fa = (android.app.Activity) activity;
                    try {
                        if (fa.getClass().getName().contains("LauncherUI")) {
                            if (resBubbleLeft == 0 && resBubbleRight == 0) probeBubbleRes(fa);
                            if (zQueue == null && !zQueueProbing.getAndSet(true)) {
                                new Thread(new Runnable() {
                                    @Override public void run() {
                                        try { sceneQueue(); } catch (Throwable ignore) { }
                                    }
                                }).start();
                            }
                            try { installAppLifecycle(fa); } catch (Throwable ignore) { }
                            try { showOverlayFab(fa); } catch (Throwable ignore) { }
                            attachChromeListener(fa);
                            try {
                                final JSONObject pk = themePack();
                                if (pk != null) {
                                    final android.os.Handler th = new android.os.Handler(android.os.Looper.getMainLooper());
                                    final int[] tries = {0};
                                    th.postDelayed(new Runnable() {
                                        @Override public void run() {
                                            tries[0]++;
                                            if (tries[0] < 12) th.postDelayed(this, 120);
                                        }
                                    }, 60);
                                }
                            } catch (Throwable ignore) { }
                        }
                    } catch (Throwable ignore) { }
                    final android.os.Handler lh = new android.os.Handler(android.os.Looper.getMainLooper());
                    lh.postDelayed(new Runnable() {
                        @Override public void run() {
                            try { themeListTick(fa); } catch (Throwable ignore) { }
                            try { lh.postDelayed(this, 2000); } catch (Throwable ignore) { }
                        }
                    }, 1200);
                } catch (Throwable ignore) { }
            }
        } catch (Throwable t) {
            log("applyTheme err " + t);
        }
    }

    private static int cleared = 0;

    private static final java.util.WeakHashMap<Object, Boolean> running = new java.util.WeakHashMap<Object, Boolean>();
    private static final java.util.WeakHashMap<Object, Boolean> themed = new java.util.WeakHashMap<Object, Boolean>();
    private static final ThreadLocal<Boolean> applying = new ThreadLocal<Boolean>();

    private static void installNoBackground(ClassLoader app) {
        try {
            Class<?> v = Class.forName("android.view.View", false, app);
            XC_MethodHook h = new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (Boolean.TRUE.equals(applying.get())) return;
                        // —— 透明气泡（与主题同原理：拦截微信设背景，直接换成半透明）——
                        // —— 聊天气泡（文字气泡就是 TextView，这条路径已验证可用）——
                        if (inChat) {
                            Object ob = p.thisObject;
                            if (ob instanceof android.widget.TextView
                                    && !(ob instanceof android.widget.EditText)) {
                                android.widget.TextView tv = (android.widget.TextView) ob;
                                CharSequence cs = tv.getText();
                                if (cs != null && cs.length() > 0 && cs.length() <= 500
                                        && tv.getWidth() > 0
                                        && tv.getParent() instanceof android.view.ViewGroup
                                        && !insideFooter(tv) && insideList(tv)) {
                                    // 气泡主题总开关：bubbleMode=0 时一律保留微信原生气泡，避免聊天框变透明
                                    int bm0 = bubbleMode(cfg());
