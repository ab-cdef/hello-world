                        }
                        if (!themeOn()) return;
                        Object o = p.thisObject;
                        if (!(o instanceof View)) return;
                        android.content.Context cc0 = ((View) o).getContext();
                        if (cc0 instanceof android.app.Activity) {
                            String cn0 = cc0.getClass().getName();
