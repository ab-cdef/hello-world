        new android.app.AlertDialog.Builder(a)
                .setTitle("清空已有卡密？")
                .setMessage("将删除本机保存的卡密与授权缓存。\n清空后所有付费功能立即失效，需要重新输入卡密才能使用。\n\n当前卡密：" + wxh.License.curCode())
                .setPositiveButton("确定清空", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        wxh.License.clearAll();
                        toast("已清空卡密");
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    /** 授权状态面板 */
    private static void showLicense(final android.app.Activity a) {
        String dev = "未知";
        boolean ok = false;
        String msg = "";
        long exp = 0;
        try {
            dev = wxh.License.deviceId();
            ok = wxh.License.isOk();
            msg = wxh.License.msg();
            exp = wxh.License.expire();
        } catch (Throwable t) { log("LIC|panel err " + t); }

        StringBuilder sb = new StringBuilder();
        sb.append("设备码\n  ").append(dev).append("\n\n");
        sb.append("状态\n  ").append(ok ? "已激活" : "未激活");
        if (msg != null && msg.length() > 0) sb.append("（").append(msg).append("）");
        sb.append("\n\n");
        if (exp > 0) {
            java.text.SimpleDateFormat f = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.CHINA);
            sb.append("到期\n  ").append(f.format(new java.util.Date(exp * 1000L))).append("\n\n");
        }
        String code = "";
        try { code = wxh.License.readCode(); } catch (Throwable ignore) { }
        sb.append("卡密\n  ").append(code == null || code.length() == 0 ? "（未填写）" : code);

        new android.app.AlertDialog.Builder(a)
                .setTitle("授权状态")
                .setMessage(sb.toString())
                .setPositiveButton("激活 / 换卡", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        wxh.License.askCode(a, "输入卡密");
                    }
                })
                .setNeutralButton("复制设备码", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        try {
                            android.content.ClipboardManager cm =
                                    (android.content.ClipboardManager) a.getSystemService("clipboard");
                            cm.setPrimaryClip(android.content.ClipData.newPlainText("dev", wxh.License.deviceId()));
                            toast("设备码已复制");
                        } catch (Throwable ignore) { }
                    }
                })
                .setNegativeButton("清空卡密", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) {
                        showClearLicConfirm(a);
                    }
                })
                .show();
    }

}
