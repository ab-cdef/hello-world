                                                                } catch (Throwable t) { toast("保存失败"); }
                                                                d2.dismiss();
                                                            }
                                                        }).show();
                                        break;
                                    }
                                    case 2:
                                        setOn("closeVibrate", !vb);
                                        break;
                                    case 3:
                                        askText(a, "密友专属自动回复", "留空则关闭；10 分钟内只回一次", "closeReply");
                                        break;
                                    case 4:
                                        showCloseFriendLog(a);
                                        break;
                                    case 5:
                                        try {
                                            JSONObject o = readCfg();
                                            o.put("closeFriends", new org.json.JSONArray());
                                            writeCfg(o);
                                            cfg = null; cfgAt = 0;
                                            toast("已清空密友名单");
                                        } catch (Throwable t) { toast("清空失败"); }
                                        break;
                                }
                            } catch (Throwable t) { toast("操作失败：" + t); }
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { toast("打开失败：" + t); }
    }

    private static int closeLogLines() {
        try {
            java.io.File f = new java.io.File(DIR + "/close_friends.log");
            if (!f.isFile()) return 0;
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            int n = 0;
            while (br.readLine() != null && n < 9999) n++;
            br.close();
            return n;
        } catch (Throwable t) { return 0; }
    }

    private static void showCloseFriendLog(android.app.Activity a) {
        try {
            java.io.File f = new java.io.File(DIR + "/close_friends.log");
            if (!f.isFile() || f.length() == 0) { toast("还没有密友消息"); return; }
            java.util.ArrayList<String> ls = new java.util.ArrayList<String>();
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(f));
            String l;
            while ((l = br.readLine()) != null) ls.add(l);
            br.close();
            StringBuilder sb = new StringBuilder();
            int st = Math.max(0, ls.size() - 40);
            for (int i = ls.size() - 1; i >= st; i--) sb.append(ls.get(i)).append("\n");
            alert("最近密友消息（" + ls.size() + " 条）", sb.toString());
        } catch (Throwable t) { toast("读取失败：" + t); }
    }

