    private static void showUnrecallList(final android.app.Activity a) {
        try {
            java.io.File f = new java.io.File(DIR, "wxh_unrecall.log");
            if (!f.isFile()) {
                toast("还没有撤回记录");
                return;
            }
            java.io.BufferedReader br = new java.io.BufferedReader(new java.io.InputStreamReader(
                    new java.io.FileInputStream(f), "UTF-8"));
            java.util.ArrayList<String> lines = new java.util.ArrayList<String>();
            String line;
            while ((line = br.readLine()) != null) {
                if (line.trim().length() > 0) lines.add(line);
            }
            br.close();
            if (lines.isEmpty()) {
                toast("还没有撤回记录");
                return;
            }
            final java.util.ArrayList<String> rows = new java.util.ArrayList<String>();
            for (int i = lines.size() - 1; i >= 0 && rows.size() < 300; i--) rows.add(lines.get(i));
            final String[] items = new String[rows.size()];
            for (int i = 0; i < rows.size(); i++) items[i] = prettyUnrecall(rows.get(i));
            new android.app.AlertDialog.Builder(a)
                    .setTitle("撤回记录（点击定位）")
                    .setItems(items, new android.content.DialogInterface.OnClickListener() {
                        @Override
                        public void onClick(android.content.DialogInterface d, int which) {
                            openChatAt(a, rows.get(which));
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) {
            log("showUnrecallList err " + t);
            toast("读取失败");
        }
    }

    /** 简单美化一条记录 */
    private static String prettyUnrecall(String raw) {
        try {
            String[] p = raw.split("\\|");
            if (p.length >= 4) {
                String time = p[0].length() > 15 ? p[0].substring(5, 16) : p[0];
                String talker = p.length > 1 ? displayOfTalker(p[1]) : "";
                String text = p[p.length - 1];
                if (text.length() > 24) text = text.substring(0, 24) + "…";
                return time + "  " + talker + "  " + text;
            }
        } catch (Throwable t) {
        }
        return raw.length() > 60 ? raw.substring(0, 60) : raw;
    }

    /** 打开会话并尝试高亮目标消息 */
    private static void openChatAt(final android.app.Activity a, final String raw) {
        try {
            String[] p = raw.split("\\|");
            String talker = null, text = null, mid = null;
            for (String seg : p) {
                String t2 = seg.trim();
                if (t2.endsWith("@chatroom") || t2.startsWith("wxid_")) talker = t2;
                else if (t2.matches("\\d{8,}")) mid = t2;
            }
            if (talker == null && p.length > 1) talker = p[1];
            text = p.length > 0 ? p[p.length - 1] : null;
            final String fText = text;
            if (talker == null || talker.length() == 0) {
                toast("记录里没有会话信息");
                return;
            }
            android.content.Intent it = new android.content.Intent();
            it.setClassName(a.getPackageName(), "com.tencent.mm.ui.chatting.ChattingUI");
            it.putExtra("Chat_User", resolveTalker(talker));
            if (mid != null) {
                try {
                    it.putExtra("Chat_Msg_Id", Long.parseLong(mid));
                } catch (Throwable t) {
                }
            }
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK);
            android.content.Intent _csw = prepareChatSwitch(a, it);
            if (_csw != null) a.startActivity(_csw);
            // 等界面加载后高亮匹配的消息
            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                @Override
                public void run() {
                    // 官方跳转已定位；如未生效再做一次兜底高亮
                    highlightMessage(fText);
                }
            }, 1500);
        } catch (Throwable t) {
            log("openChatAt err " + t);
            toast("打开聊天失败");
        }
    }

    /** 自动向上翻页寻找目标消息，找到后高亮 */
    private static void autoFindMessage(final String text) {
        new Thread(new Runnable() {
            @Override
            public void run() {
                for (int round = 0; round < 60; round++) {
                    final int rnd = round;
                    final boolean[] hit = new boolean[]{false};
                    try {
                        android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
                        final java.util.concurrent.CountDownLatch latch =
                                new java.util.concurrent.CountDownLatch(1);
                        h.post(new Runnable() {
                            @Override
                            public void run() {
                                try {
                                    if (chatAct == null || chatAct.getWindow() == null) return;
                                    ViewGroup list = findMsgList(chatAct.getWindow().getDecorView());
                                    if (list == null) return;
                                    String target = text == null ? "" : text.replace("（已撤回）", "").trim();
                                    if (target.length() > 30) target = target.substring(0, 30);
                                    for (int i = 0; i < list.getChildCount(); i++) {
                                        View row = list.getChildAt(i);
                                        if (row == null) continue;
                                        android.widget.TextView tv = mainTextOf(row);
                                        if (tv == null) continue;
                                        String t = tv.getText().toString().trim();
                                        if (t.length() == 0) continue;
                                        if (t.contains(target) || (target.length() > 3 && target.contains(t))) {
                                            final View frow = row;
                                            frow.setBackgroundColor(0x55E23636);
                                            list.requestChildFocus(frow, frow);
                                            new android.os.Handler(android.os.Looper.getMainLooper())
                                                    .postDelayed(new Runnable() {
                                                        @Override
                                                        public void run() {
                                                            frow.setBackgroundColor(0x00000000);
                                                        }
                                                    }, 3000);
                                            hit[0] = true;
                                            log("FIND|hit round=" + rnd);
                                            return;
                                        }
                                    }
                                } finally {
                                    latch.countDown();
                                }
                            }
                        });
                        latch.await(2, java.util.concurrent.TimeUnit.SECONDS);
                        if (hit[0]) return;
                        // 向上翻一页
                        final java.util.concurrent.CountDownLatch l2 =
                                new java.util.concurrent.CountDownLatch(1);
                        new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                            @Override
                            public void run() {
                                try {
                                    if (chatAct == null || chatAct.getWindow() == null) return;
                                    ViewGroup list = findMsgList(chatAct.getWindow().getDecorView());
                                    if (list instanceof android.view.ViewGroup) {
                                        list.dispatchTouchEvent(android.view.MotionEvent.obtain(
                                                0, 0, android.view.MotionEvent.ACTION_DOWN,
                                                list.getWidth() / 2f, list.getHeight() * 0.3f, 0));
                                        list.dispatchTouchEvent(android.view.MotionEvent.obtain(
                                                0, 200, android.view.MotionEvent.ACTION_MOVE,
                                                list.getWidth() / 2f, list.getHeight() * 0.9f, 0));
                                        list.dispatchTouchEvent(android.view.MotionEvent.obtain(
                                                0, 260, android.view.MotionEvent.ACTION_UP,
                                                list.getWidth() / 2f, list.getHeight() * 0.9f, 0));
                                    }
                                } catch (Throwable t) {
                                } finally {
                                    l2.countDown();
                                }
                            }
                        });
                        l2.await(2, java.util.concurrent.TimeUnit.SECONDS);
                        Thread.sleep(500);
                    } catch (Throwable t) {
                    }
                }
                log("FIND|giveup");
            }
        }).start();
    }

    /** 在聊天列表里找到内容匹配的行并闪烁高亮 */
    private static void highlightMessage(final String text) {
        try {
            if (text == null || chatAct == null || chatAct.getWindow() == null) return;
            ViewGroup list = findMsgList(chatAct.getWindow().getDecorView());
            if (list == null) return;
            String target = text.replace("（已撤回）", "").trim();
            if (target.length() > 30) target = target.substring(0, 30);
            for (int i = 0; i < list.getChildCount(); i++) {
                View row = list.getChildAt(i);
                if (row == null) continue;
                android.widget.TextView tv = mainTextOf(row);
                if (tv == null) continue;
                String t = tv.getText().toString().trim();
                if (t.length() == 0) continue;
                if (t.contains(target) || target.contains(t)) {
                    final View frow = row;
                    frow.setBackgroundColor(0x55E23636);
                    new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                        @Override
                        public void run() {
                            frow.setBackgroundColor(0x00000000);
                        }
                    }, 2200);
                    list.requestChildFocus(frow, frow);
                    log("HILITE|found");
                    return;
                }
            }
            log("HILITE|not visible");
        } catch (Throwable t) {
            log("HILITE|err " + t);
        }
    }



    /** 探测微信打开的数据库文件路径，并捕获表情库句柄 */
    private static void installDbProbe(ClassLoader app) {
        try {
            int hooked = 0;
            for (String cn : new String[]{"com.tencent.wcdb.database.SQLiteDatabase",
                    "android.database.sqlite.SQLiteDatabase"}) {
                try {
                    Class<?> c = Class.forName(cn, false, app);
                    for (java.lang.reflect.Method m : c.getDeclaredMethods()) {
                        if (!m.getName().toLowerCase().contains("openorcreate")) continue;
                        final int idx = 0;
                        XposedBridge.hookMethod(m, new XC_MethodHook() {
                            @Override
                            protected void afterHookedMethod(MethodHookParam p) {
                                try {
                                    Object a0 = p.args.length > 0 ? p.args[0] : null;
                                    String path = String.valueOf(a0);
                                    if (dbLogLeft <= 0) return;
                                    if (!path.contains(".db")) return;
                                    dbLogLeft--;
                                    log("DBOPEN|" + path);
                                    if (path.contains("emoji")) {
                                        emojiDb = p.getResult();
                                        log("DBOPEN|emoji captured");
                                    }
                                } catch (Throwable t) {
                                }
                            }
                        });
                        hooked++;
                    }
                } catch (Throwable t) {
                }
            }
            log("hooked db probe n=" + hooked);
        } catch (Throwable t) {
            log("db probe err " + t);
        }
    }

    /** 列出表情库内容（需要 emojiDb 已捕获） */
    private static void listEmojis(final android.app.Activity a) {
        new Thread(new Runnable() {
            public void run() {
                try {
                    Object db = emojiDb;
                    if (db == null) {
                        toast("表情库未打开：请先打开表情面板再试");
                        return;
                    }
                    Object cur = db.getClass().getMethod("rawQuery", String.class, String[].class)
                            .invoke(db, "select name from sqlite_master where type='table'", new String[0]);
                    StringBuilder sb = new StringBuilder();
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            sb.append((String) gs.invoke(cur, 0)).append('\n');
                        }
                    }
                    final String txt = sb.length() == 0 ? "空" : sb.toString();
                    a.runOnUiThread(new Runnable() {
                        public void run() {
                            new android.app.AlertDialog.Builder(a).setTitle("表情库表")
                                    .setMessage(txt).setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) {
                    log("EMOJI|err " + t);
                }
            }
        }).start();
    }


    /** 编辑自动回复规则 */
    private static void editReplyRules(final android.app.Activity a) {
        try {
            final android.widget.EditText et = new android.widget.EditText(a);
            et.setText(joinArr(cfg().optJSONArray("autoReplyRules")));
            et.setHint("在吗=在的，价格=稍等发你");
            et.setMinLines(3);
            new android.app.AlertDialog.Builder(a)
                    .setTitle("自动回复规则")
                    .setMessage("每行一条，格式：关键词=回复")
                    .setView(et)
                    .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                        @Override
                        public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                JSONObject o = readCfg();
                                org.json.JSONArray arr = new org.json.JSONArray();
                                for (String line : et.getText().toString().split("\\n")) {
                                    if (line.trim().length() > 0) arr.put(line.trim());
                                }
                                o.put("autoReplyRules", arr);
                                writeCfg(o);
                                toast("已保存 " + arr.length() + " 条规则");
                            } catch (Throwable t) {
                                toast("保存失败");
                            }
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) {
            log("editReplyRules err " + t);
        }
    }

    private static String joinArr(org.json.JSONArray arr) {
        StringBuilder sb = new StringBuilder();
        if (arr != null) {
            for (int i = 0; i < arr.length(); i++) {
                if (sb.length() > 0) sb.append('\n');
                sb.append(arr.optString(i));
            }
        }
        return sb.toString();
    }

    /** 导出表情包：把 MicroMsg/<hash>/emoji 下的文件复制出来 */
    private static void exportEmojis(final android.app.Activity a) {
        new Thread(new Runnable() {
            public void run() {
                try {
                    java.io.File base = null;
                    java.io.File mm = new java.io.File("/data/user/0/com.tencent.mm/MicroMsg");
                    java.io.File[] dirs = mm.listFiles();
                    if (dirs != null) {
                        for (java.io.File d : dirs) {
                            java.io.File e = new java.io.File(d, "emoji");
                            if (e.isDirectory() && e.list() != null && e.list().length > 10) {
                                base = e;
                                break;
                            }
                        }
                    }
                    if (base == null) {
                        toast("没找到表情目录");
                        return;
                    }
                    final java.io.File out = new java.io.File(DIR, "emoji_export");
                    out.mkdirs();
                    java.io.File[] fs = base.listFiles();
                    int n = 0;
                    if (fs != null) {
                        for (java.io.File f : fs) {
                            if (!f.isFile() || f.length() < 200) continue;
                            try {
                                java.io.FileInputStream in = new java.io.FileInputStream(f);
                                byte[] buf = new byte[(int) Math.min(f.length(), 4 * 1024 * 1024)];
                                int read = in.read(buf);
                                in.close();
                                if (read <= 0) continue;
                                String ext = ".gif";
                                if (buf[0] == (byte) 0x89 && buf[1] == 'P') ext = ".png";
                                else if (buf[0] == (byte) 0xFF && buf[1] == (byte) 0xD8) ext = ".jpg";
                                else if (!(buf[0] == 'G' && buf[1] == 'I')) continue;
                                java.io.FileOutputStream fo = new java.io.FileOutputStream(
                                        new java.io.File(out, f.getName() + ext));
                                fo.write(buf, 0, read);
                                fo.close();
                                n++;
                            } catch (Throwable t) {
                            }
                        }
                    }
                    log("EMOJI_EXPORT|n=" + n + " dir=" + out);
                    final int cnt = n;
                    a.runOnUiThread(new Runnable() {
                        public void run() {
                            new android.app.AlertDialog.Builder(a).setTitle("导出表情包")
                                    .setMessage("已导出 " + cnt + " 个表情\n目录：\n" + out.getAbsolutePath())
                                    .setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) {
                    log("EMOJI_EXPORT|err " + t);
                }
            }
        }).start();
    }


    /** 一键清除所有未读（会话红点/数字） */
    private static void clearUnread(final android.app.Activity a) {
        new Thread(new Runnable() {
            public void run() {
                try {
                    Object h = msgDbHandle();
                    if (h == null) {
                        toast("数据库未就绪");
                        return;
                    }
                    // 1) 数据库层：未读计数清零
                    int n = 0;
                    try {
                        Object c1 = h.getClass().getMethod("B", String.class, String[].class)
                                .invoke(h, "update rconversation set unReadCount=0, isSend=0, "
                                        + "flag=replace(flag,'1','0') where unReadCount<>0", new String[0]);
                        try {
                            c1.getClass().getMethod("close").invoke(c1);
                        } catch (Throwable t) {
                        }
                        n = 1;
                    } catch (Throwable t) {
                        log("UNREAD|sql1 err " + t);
                    }
                    try {
                        Object c2 = h.getClass().getMethod("B", String.class, String[].class)
                                .invoke(h, "update message set isUnread=0 where isUnread=1", new String[0]);
                        try {
                            c2.getClass().getMethod("close").invoke(c2);
                        } catch (Throwable t) {
                        }
                    } catch (Throwable t) {
                        log("UNREAD|sql2 err " + t);
                    }
                    log("UNREAD|done");
                    // 2) 通知层：清掉通知栏
                    try {
                        android.app.NotificationManager nm = (android.app.NotificationManager)
                                a.getSystemService(android.app.Activity.NOTIFICATION_SERVICE);
                        nm.cancelAll();
                    } catch (Throwable t) {
                    }
                    // 3) 界面层：刷新会话列表
                    a.runOnUiThread(new Runnable() {
                        public void run() {
                            try {
                                ViewGroup rv = null;
                                View root = a.getWindow().getDecorView();
                                rv = findMsgList(root);
                                if (rv != null) {
                                    rv.requestLayout();
                                    rv.invalidate();
                                }
                                toast("已清除未读");
                            } catch (Throwable t) {
                            }
                        }
                    });
                } catch (Throwable t) {
                    log("UNREAD|err " + t);
                }
            }
        }).start();
    }

    /** 导出群聊列表 */
    private static void exportGroups(final android.app.Activity a) {
        new Thread(new Runnable() {
            public void run() {
                try {
                    Object h = msgDbHandle();
                    if (h == null) {
                        toast("数据库未就绪");
                        return;
                    }
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select r.username,r.nickname,r.conRemark,c.memberlist "
                                    + "from rcontact r left join chatroom c on c.chatroomname=r.username "
                                    + "where r.username like '%@chatroom'", new String[0]);
                    StringBuilder sb = new StringBuilder("群名称,群ID,成员数\n");
                    int n = 0;
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            String u = (String) gs.invoke(cur, 0);
                            String nk = (String) gs.invoke(cur, 1);
                            String rm = (String) gs.invoke(cur, 2);
                            String ml = (String) gs.invoke(cur, 3);
                            int cnt = 0;
                            if (ml != null) for (String x : ml.split(";")) if (x.trim().length() > 0) cnt++;
                            String name = (rm != null && rm.trim().length() > 0) ? rm.trim()
                                    : ((nk != null && nk.trim().length() > 0) ? nk.trim() : u);
                            sb.append(name.replace(",", "，")).append(',').append(u).append(',')
                                    .append(cnt).append('\n');
                            n++;
                        }
                        try {
                            cur.getClass().getMethod("close").invoke(cur);
                        } catch (Throwable t) {
                        }
                    }
                    String fn = DIR + "/groups.csv";
                    java.io.FileOutputStream fo = new java.io.FileOutputStream(fn);
                    fo.write(sb.toString().getBytes("UTF-8"));
                    fo.close();
                    log("EXPORT_GROUPS|n=" + n);
                    final String msg = "已导出 " + n + " 个群\n" + fn;
                    a.runOnUiThread(new Runnable() {
                        public void run() {
                            new android.app.AlertDialog.Builder(a).setTitle("导出群聊")
                                    .setMessage(msg).setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) {
                    log("EXPORT_GROUPS|err " + t);
                }
            }
        }).start();
    }

    /** 导出标签及成员数 */
    private static void exportLabels(final android.app.Activity a) {
        new Thread(new Runnable() {
            public void run() {
                try {
                    Object h = msgDbHandle();
                    if (h == null) {
                        toast("数据库未就绪");
                        return;
                    }
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select labelName,labelID from ContactLabel", new String[0]);
                    StringBuilder sb = new StringBuilder("标签,ID\n");
                    int n = 0;
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        java.lang.reflect.Method gi = cur.getClass().getMethod("getInt", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            String nm = (String) gs.invoke(cur, 0);
                            int id = 0;
                            try {
                                id = (Integer) gi.invoke(cur, 1);
                            } catch (Throwable t) {
                            }
                            sb.append(nm == null ? "" : nm).append(',').append(id).append('\n');
                            n++;
                        }
                        try {
                            cur.getClass().getMethod("close").invoke(cur);
                        } catch (Throwable t) {
                        }
                    }
                    String fn = DIR + "/labels.csv";
                    java.io.FileOutputStream fo = new java.io.FileOutputStream(fn);
                    fo.write(sb.toString().getBytes("UTF-8"));
                    fo.close();
                    log("EXPORT_LABELS|n=" + n);
                    final String msg = "已导出 " + n + " 个标签\n" + fn;
                    a.runOnUiThread(new Runnable() {
                        public void run() {
                            new android.app.AlertDialog.Builder(a).setTitle("导出标签")
                                    .setMessage(msg).setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) {
                    log("EXPORT_LABELS|err " + t);
                }
            }
        }).start();
    }

    /** 找出很久没聊天的联系人（沉默好友） */
    /** 统计：各会话消息量 Top20 */
    private static void topTalkers(final android.app.Activity a) {
        new Thread(new Runnable() {
            public void run() {
                try {
                    Object h = msgDbHandle();
                    if (h == null) {
                        toast("数据库未就绪");
                        return;
                    }
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select talker,count(*) from message group by talker "
                                    + "order by count(*) desc limit 20", new String[0]);
                    StringBuilder sb = new StringBuilder();
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            String t2 = (String) gs.invoke(cur, 0);
                            long c = (Long) gl.invoke(cur, 1);
                            sb.append(displayOfTalker(t2)).append("  ").append(c).append(" 条\n");
                        }
                        try {
                            cur.getClass().getMethod("close").invoke(cur);
                        } catch (Throwable t) {
                        }
                    }
                    final String txt = sb.length() == 0 ? "没有数据" : sb.toString();
                    a.runOnUiThread(new Runnable() {
                        public void run() {
                            android.widget.ScrollView sv = new android.widget.ScrollView(a);
                            android.widget.TextView tv = new android.widget.TextView(a);
                            tv.setText(txt);
                            tv.setTextSize(13);
                            tv.setPadding(30, 30, 30, 30);
                            sv.addView(tv);
                            new android.app.AlertDialog.Builder(a).setTitle("消息量 Top20")
                                    .setView(sv).setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) {
                    log("TOP|err " + t);
                }
            }
        }).start();
    }

    /** 统计：今天消息数 */
    private static void todayStat(final android.app.Activity a) {
        new Thread(new Runnable() {
            public void run() {
                try {
                    Object h = msgDbHandle();
                    if (h == null) {
                        toast("数据库未就绪");
                        return;
                    }
                    long start = (System.currentTimeMillis() / 1000 / 86400) * 86400;
                    Object cur = h.getClass().getMethod("B", String.class, String[].class)
                            .invoke(h, "select count(*) from message where createTime>=?",
                                    new String[]{String.valueOf(start)});
                    long c = 0;
                    if (cur != null) {
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                        if ((Boolean) mv.invoke(cur)) c = (Long) gl.invoke(cur, 0);
                        try {
                            cur.getClass().getMethod("close").invoke(cur);
                        } catch (Throwable t) {
                        }
                    }
                    final String txt = "今天共 " + c + " 条消息";
                    a.runOnUiThread(new Runnable() {
                        public void run() {
                            new android.app.AlertDialog.Builder(a).setTitle("今日消息")
                                    .setMessage(txt).setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) {
                    log("TODAY|err " + t);
                }
            }
        }).start();
    }

    /** 清理：删除 30 天前的撤回/提醒日志 */
    private static void trimLogs(final android.app.Activity a) {
        int removed = 0;
        try {
            long cut = System.currentTimeMillis() - 30L * 24 * 3600 * 1000;
            for (String fn : new String[]{"wxh_unrecall.log", "wxh_alerts.log"}) {
                java.io.File f = new java.io.File(DIR, fn);
                if (!f.isFile()) continue;
                java.util.List<String> keep = new java.util.ArrayList<String>();
                java.io.BufferedReader br = new java.io.BufferedReader(
                        new java.io.InputStreamReader(new java.io.FileInputStream(f), "UTF-8"));
                String l;
                while ((l = br.readLine()) != null) {
                    boolean old = false;
                    try {
                        String ts = l.substring(0, 19);
                        long t = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss")
                                .parse(ts).getTime();
                        old = t < cut;
                    } catch (Throwable tt) {
                    }
                    if (old) removed++;
                    else keep.add(l);
                }
                br.close();
                java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
                StringBuilder sb = new StringBuilder();
                for (String k : keep) sb.append(k).append('\n');
                fo.write(sb.toString().getBytes("UTF-8"));
                fo.close();
            }
            toast("已清理 " + removed + " 条旧记录");
        } catch (Throwable t) {
            toast("清理失败");
        }
    }

    /** 清空所有日志 */
    private static void clearLogs(final android.app.Activity a) {
        String[] fs = {"wxh_unrecall.log", "wxh_alerts.log", "wxh_plugin.log"};
        int n = 0;
        for (String f : fs) {
            try {
                java.io.File file = new java.io.File(DIR, f);
                if (file.isFile() && file.delete()) n++;
            } catch (Throwable t) {
            }
        }
        toast("已清空 " + n + " 个日志文件");
    }

