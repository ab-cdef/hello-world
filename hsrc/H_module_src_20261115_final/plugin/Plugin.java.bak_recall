                    }
                    holder.addView(card, new android.widget.LinearLayout.LayoutParams(
                            android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                            android.view.ViewGroup.LayoutParams.WRAP_CONTENT));
                    android.view.View dv = new android.view.View(a);
                    dv.setBackgroundColor(0xFFEDEDED);
                    holder.addView(dv, new android.widget.LinearLayout.LayoutParams(
                            android.view.ViewGroup.LayoutParams.MATCH_PARENT, dp(a, 1)));
                    holder.setClickable(true);
                    holder.setOnClickListener(new android.view.View.OnClickListener() {
