    private static void pickGroupMembers(final android.app.Activity a, String groupLabel,
                                         final java.util.LinkedHashSet<String> selected) {
        try {
            java.util.List<String> members = new java.util.ArrayList<String>();
            Object db = dbRef;
            Object cur = null;
            if (db != null) {
                for (Method m : db.getClass().getMethods()) {
                    if (!m.getName().equals("rawQuery")) continue;
                    Class<?>[] ps = m.getParameterTypes();
                    if (ps.length != 2 || ps[0] != String.class) continue;
                    Object arg = (ps[1] == String[].class) ? new String[]{groupLabel} : new Object[]{groupLabel};
                    m.setAccessible(true);
                    try {
                        cur = m.invoke(db, "select memberlist from chatroom where chatroomname in "
                                + "(select username from rcontact where nickname=? or conRemark=?)", arg);
                    } catch (Throwable t) {
                        cur = null;
                    }
                    break;
                }
            }
            if (cur == null) {
                toast("读不到群成员，先用搜索选人");
                return;
            }
            Method mv = cur.getClass().getMethod("moveToNext");
            Method gs = cur.getClass().getMethod("getString", int.class);
            if ((Boolean) mv.invoke(cur)) {
                String list = (String) gs.invoke(cur, 0);
                if (list != null) {
                    for (String u : list.split(";")) {
                        if (u.trim().length() > 0) members.add(u.trim());
                    }
                }
            }
            try {
                cur.getClass().getMethod("close").invoke(cur);
            } catch (Throwable t) {
            }
            log("group members=" + members.size());
            toast("群成员 " + members.size() + " 人（暂时只能用昵称搜索添加）");
            pickLikeFriends(a);
        } catch (Throwable t) {
            log("pickGroupMembers err " + t);
            toast("读群成员失败");
        }
    }

    private static void logTablesAsync(final Object db) {
        new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    Object cur = null;
                    for (Method m : db.getClass().getMethods()) {
                        if (!m.getName().equals("rawQuery")) continue;
                        Class<?>[] ps = m.getParameterTypes();
                        if (ps.length != 2 || ps[0] != String.class) continue;
                        Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                        m.setAccessible(true);
                        cur = m.invoke(db, "select name from sqlite_master where type='table'", arg);
                        break;
                    }
                    if (cur == null) return;
                    StringBuilder sb = new StringBuilder();
                    Method mv = cur.getClass().getMethod("moveToNext");
                    Method gs = cur.getClass().getMethod("getString", int.class);
                    while ((Boolean) mv.invoke(cur)) {
                        String n = (String) gs.invoke(cur, 0);
                        if (n != null) sb.append(n).append(' ');
                    }
                    try {
                        cur.getClass().getMethod("close").invoke(cur);
                    } catch (Throwable t) {
                    }
                    log("TABLES|" + sb);
                } catch (Throwable t) {
                    log("logTables err " + t);
                }
            }
        }).start();
    }

    /** 探测数据库表名（诊断用） */
    private static void probeTables(final android.app.Activity a) {
        try {
            final Object db = dbRef;
            if (db == null) {
                toast("数据库未就绪");
                return;
            }
                new Thread(new Runnable() {
                @Override
                public void run() {
                    try {
                        Object cur = null;
                        for (Method m : db.getClass().getMethods()) {
                            if (!m.getName().equals("rawQuery")) continue;
                            Class<?>[] ps = m.getParameterTypes();
                            if (ps.length != 2 || ps[0] != String.class) continue;
                            Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                            m.setAccessible(true);
                            cur = m.invoke(db, "select name from sqlite_master where type='table'", arg);
                            break;
                        }
                        if (cur == null) return;
                        StringBuilder sb = new StringBuilder();
                        Method mv = cur.getClass().getMethod("moveToNext");
                        Method gs = cur.getClass().getMethod("getString", int.class);
                        while ((Boolean) mv.invoke(cur)) {
                            String n = (String) gs.invoke(cur, 0);
                            if (n != null && (n.toLowerCase().contains("fav")
                                    || n.toLowerCase().contains("emoji")
                                    || n.toLowerCase().contains("sns"))) {
                                sb.append(n).append(' ');
                            }
                        }
                        try {
                            cur.getClass().getMethod("close").invoke(cur);
                        } catch (Throwable t) {
                        }
                        log("TABLES|" + sb);
                    } catch (Throwable t) {
                        log("probeTables err " + t);
                    }
                }
            }).start();
        } catch (Throwable t) {
            log("probeTables outer " + t);
        }
    }

    /** 导出红包/转账记录 */
    /** 一条红包/转账记录 */
    private static class MoneyRec {
        String kind;      // "红包" / "转账"
        long timeMs;
        long cent;        // 金额（分）
        String talker;    // 会话 id（群或人）
        String who;       // 对方显示名
        boolean isSend;
        String receiver;  // 领取人
        String status;    // 状态文字
        String id;
    }

    private static void exportPacketRecords(final android.app.Activity a) {
        try {
            if (dbRef == null) { toast("数据库未就绪，先收发一条消息"); return; }
            toast("正在整理…");
            new Thread(new Runnable() {
                @Override public void run() {
                    final java.util.ArrayList<MoneyRec> list = new java.util.ArrayList<MoneyRec>();
                    try { probeMoneyTables(dbRef); } catch (Throwable ignore) { }
                    // ---- 红包：WalletLuckyMoney ----
                    try {
                        java.util.List<Object[]> rows = queryRows(
                                "select ifnull(receiveAmount,0), ifnull(receiveTime,0), ifnull(sender,''),"
                                        + " ifnull(receiveStatus,0), ifnull(msgSvrId,0), ifnull(mNativeUrl,'')"
                                        + " from WalletLuckyMoney order by receiveTime desc limit 200", 6);
                        for (Object[] r : rows) {
                            MoneyRec m = new MoneyRec();
                            m.kind = "红包";
                            try { m.cent = Long.parseLong(String.valueOf(r[0]).trim()); } catch (Throwable ignore) { }
                            try { m.timeMs = Long.parseLong(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                            if (m.timeMs > 0 && m.timeMs < 100000000000L) m.timeMs *= 1000L;
                            String sender = r[2] == null ? "" : String.valueOf(r[2]).trim();
                            int st = 0;
                            try { st = Integer.parseInt(String.valueOf(r[3]).trim()); } catch (Throwable ignore) { }
                            m.status = (st == 1 || st == 2 || st == 3) ? "已领取"
                                    : (st == 4 ? "已退回" : (st == 0 ? "未领取" : ""));
                            long svr = 0;
                            try { svr = Long.parseLong(String.valueOf(r[4]).trim()); } catch (Throwable ignore) { }
                            m.id = r[5] == null ? "" : String.valueOf(r[5]);
                            m.isSend = sender != null && myWxidCached().length() > 0 && sender.equals(myWxidCached());
                            m.who = nameOf(sender);
                            // 用 msgSvrId 反查会话 + 群里的发送人
                            String[] mi = msgInfoOfSvr(svr);
                            String tk = mi[0];
                            if (tk.length() > 0) m.talker = tk; else m.talker = sender;
                            if (mi[1].length() > 0) m.who = nameOf(mi[1]);
                            m.receiver = "";
                            list.add(m);
                        }
                    } catch (Throwable t) { log("PKTREC|lucky err " + t); }
                    // ---- 转账：RemittanceRecord ----
                    try {
                        java.util.List<Object[]> rows = queryRows(
                                "select ifnull(transferId,''), ifnull(receiveStatus,0), ifnull(isSend,0),"
                                        + " ifnull(talker,''), ifnull(receiverName,''), ifnull(receiveTime,0),"
                                        + " ifnull(locaMsgId,0)"
                                        + " from RemittanceRecord order by receiveTime desc limit 200", 7);
                        for (Object[] r : rows) {
                            MoneyRec m = new MoneyRec();
                            m.kind = "转账";
                            m.id = r[0] == null ? "" : String.valueOf(r[0]);
                            int st = 0;
                            try { st = Integer.parseInt(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                            int isSend = 0;
                            try { isSend = Integer.parseInt(String.valueOf(r[2]).trim()); } catch (Throwable ignore) { }
                            m.isSend = isSend == 1;
                            m.talker = r[3] == null ? "" : String.valueOf(r[3]).trim();
                            m.who = nameOf(m.talker);
                            m.receiver = nameOf(r[4] == null ? "" : String.valueOf(r[4]).trim());
                            try { m.timeMs = Long.parseLong(String.valueOf(r[5]).trim()); } catch (Throwable ignore) { }
                            if (m.timeMs > 0 && m.timeMs < 100000000000L) m.timeMs *= 1000L;
                            if (m.timeMs <= 0) {
                                try {
                                    long locaId2 = Long.parseLong(String.valueOf(r[6]).trim());
                                    java.util.List<Object[]> tr = queryRows(
                                            "select ifnull(createTime,0) from message where msgId=" + locaId2 + " limit 1", 1);
                                    if (!tr.isEmpty()) {
                                        long ct2 = Long.parseLong(String.valueOf(tr.get(0)[0]).trim());
                                        if (ct2 > 0 && ct2 < 100000000000L) ct2 *= 1000L;
                                        m.timeMs = ct2;
                                    }
                                } catch (Throwable ignore) { }
                            }
                            m.status = (st == 1 || st == 2 || st == 3) ? "已收款"
                                    : (st == 4 ? "已退回" : (st == 0 ? "待收款" : ""));
                            // 金额不在表里，从对应消息的 XML 里取
                            try {
                                long locaId = Long.parseLong(String.valueOf(r[6]).trim());
                                m.cent = transferCentOfMsg(locaId);
                            } catch (Throwable ignore) { }
                            list.add(m);
                        }
                    } catch (Throwable t) { log("PKTREC|remit err " + t); }

                    final String[] tabs = {"全部", "群聊", "私聊"};
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() { showMoneyPanel(a, list, tabs); }
                    });
                    log("PKTREC|rows=" + list.size());
                }
            }).start();
        } catch (Throwable t) {
            log("exportPacketRecords err " + t);
        }
    }

    private static String myWxidCached() {
        try {
            String v = cfg().optString("myWxid", "");
            if (v != null && v.length() > 0) return v;
        } catch (Throwable ignore) { }
        return "";
    }

    /** 从转账消息 XML 里取金额（返回分） */
    private static long transferCentOfMsg(long msgId) {
        try {
            if (msgId <= 0) return 0;
            java.util.List<Object[]> r = queryRows(
                    "select ifnull(content,'') from message where msgId=" + msgId + " limit 1", 1);
            if (r.isEmpty()) return 0;
            String c = String.valueOf(r.get(0)[0]);
            // <feedesc>￥12.00</feedesc> 或 ￥12.00
            int i = c.indexOf("feedesc");
            String seg = i >= 0 ? c.substring(i, Math.min(c.length(), i + 120)) : c;
            StringBuilder num = new StringBuilder();
            boolean started = false;
            for (int k = 0; k < seg.length(); k++) {
                char ch = seg.charAt(k);
                if (ch >= '0' && ch <= '9') { num.append(ch); started = true; }
                else if (started && ch == '.') num.append(ch);
                else if (started) break;
            }
            if (num.length() == 0) return 0;
            double yuan = Double.parseDouble(num.toString());
            return Math.round(yuan * 100);
        } catch (Throwable t) { return 0; }
    }

    /** 返回 {talker, 发送人wxid} */
    private static String[] msgInfoOfSvr(long svr) {
        try {
            if (svr <= 0) return new String[]{"", ""};
            java.util.List<Object[]> r = queryRows(
                    "select ifnull(talker,''), ifnull(content,'') from message where msgSvrId=" + svr + " limit 1", 2);
            if (!r.isEmpty()) {
                Object[] row0 = r.get(0);
                String tk = row0[0] == null ? "" : String.valueOf(row0[0]);
                String ct = row0[1] == null ? "" : String.valueOf(row0[1]);
                String sid = "";
                int p = ct.indexOf(":\n");
                if (p > 0 && p < 64) {
                    String cand = ct.substring(0, p).trim();
                    if (cand.startsWith("wxid_") || cand.indexOf('@') < 0) sid = cand;
                }
                return new String[]{tk, sid};
            }
        } catch (Throwable ignore) { }
        return new String[]{"", ""};
    }

    private static String talkerOfMsgSvr(long svr) {
        try {
            if (svr <= 0) return "";
            java.util.List<Object[]> r = queryRows(
                    "select talker from message where msgSvrId=" + svr + " limit 1", 1);
            if (!r.isEmpty() && r.get(0)[0] != null) return String.valueOf(r.get(0)[0]);
        } catch (Throwable ignore) { }
        return "";
    }

    /** 面板：全部 / 群聊 / 私聊 三个切换 */
    private static void showMoneyPanel(final android.app.Activity host,
                                       final java.util.ArrayList<MoneyRec> list, final String[] tabs) {
        try {
            final android.widget.TextView tv = new android.widget.TextView(host);
            tv.setTextSize(12);
            tv.setTypeface(android.graphics.Typeface.MONOSPACE);
            tv.setTextColor(0xFF141418);
            tv.setTextIsSelectable(true);
            int pad = dp(host, 12);
            tv.setPadding(pad, pad, pad, pad);
            android.widget.ScrollView sv = new android.widget.ScrollView(host);
            sv.addView(tv);

            android.widget.LinearLayout box = new android.widget.LinearLayout(host);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            android.widget.LinearLayout bar = new android.widget.LinearLayout(host);
            bar.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            bar.setPadding(dp(host, 8), dp(host, 6), dp(host, 8), dp(host, 6));
            final android.widget.TextView[] btns = new android.widget.TextView[tabs.length];
            final int[] cur = new int[]{0};
            final long[] fromMs = new long[]{0};
            final long[] toMs = new long[]{0};
            final Runnable render = new Runnable() {
                @Override public void run() {
                    int idx = cur[0];
                    java.util.ArrayList<MoneyRec> sel = new java.util.ArrayList<MoneyRec>();
                    for (MoneyRec m : list) {
                        boolean isGroup = m.talker != null && m.talker.endsWith("@chatroom");
                        if (idx == 1 && !isGroup) continue;
                        if (idx == 2 && isGroup) continue;
                        if (fromMs[0] > 0 && m.timeMs > 0 && m.timeMs < fromMs[0]) continue;
                        if (toMs[0] > 0 && m.timeMs > 0 && m.timeMs > toMs[0] + 86400000L) continue;
                        sel.add(m);
                    }
                    java.util.Collections.sort(sel, new java.util.Comparator<MoneyRec>() {
                        @Override public int compare(MoneyRec x, MoneyRec y) {
                            return Long.compare(y.timeMs, x.timeMs);
                        }
                    });
                    java.text.SimpleDateFormat df = new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US);
                    StringBuilder sb = new StringBuilder();
                    long sumHb = 0, sumOut = 0, sumIn = 0;
                    for (MoneyRec m : sel) {
                        if ("红包".equals(m.kind)) sumHb += m.cent;
                        if (m.isSend) sumOut += m.cent; else sumIn += m.cent;
                    }
                    sb.append("共 ").append(sel.size()).append(" 条　红包 ")
                      .append(fmtMoney(sumHb)).append("　支出 ").append(fmtMoney(sumOut))
                      .append("　收入 ").append(fmtMoney(sumIn)).append("\n\n");
                    String lastKind = "";
                    for (MoneyRec m : sel) {
                        String sec = m.kind + (m.isSend ? " · 支出" : " · 收入");
                        if (!sec.equals(lastKind)) {
                            sb.append("══ ").append(sec).append(" ══\n");
                            lastKind = sec;
                        }
                        String tkName = nameOf(m.talker);
                        boolean isGroup = m.talker != null && m.talker.endsWith("@chatroom");
                        sb.append(m.timeMs > 0 ? df.format(new java.util.Date(m.timeMs)) : "--");
                        sb.append("  ");
                        if (m.cent > 0) sb.append(fmtMoney(m.cent));
                        sb.append("\n  ");
                        if (isGroup) sb.append("[群] ").append(tkName).append(" · ");
                        sb.append(m.isSend ? "我 → " : "来自 ");
                        sb.append(m.who);
                        if (m.status != null && m.status.length() > 0) {
                            sb.append("\n  ").append(m.status);
                        }
                        if (m.receiver != null && m.receiver.length() > 0 && !m.receiver.equals(m.who)) {
                            sb.append("　领取人 ").append(m.receiver);
                        }
                        sb.append("\n\n");
                    }
                    if (sel.isEmpty()) sb.append("这一类还没有记录。\n");
                    tv.setText(sb.toString());
                    for (int i = 0; i < btns.length; i++) {
                        btns[i].setTextColor(i == idx ? 0xFFC8102E : 0xFF6B6B76);
                        btns[i].setTypeface(null, i == idx
                                ? android.graphics.Typeface.BOLD : android.graphics.Typeface.NORMAL);
                    }
                }
            };
            for (int i = 0; i < tabs.length; i++) {
                final int idx = i;
                android.widget.TextView b = new android.widget.TextView(host);
                b.setText(tabs[i]);
                b.setTextSize(15);
                b.setPadding(dp(host, 14), dp(host, 8), dp(host, 14), dp(host, 8));
                b.setOnClickListener(new android.view.View.OnClickListener() {
                    @Override public void onClick(android.view.View v) {
                        cur[0] = idx;
                        render.run();
                        sv.scrollTo(0, 0);
                    }
                });
                btns[i] = b;
                bar.addView(b);
            }
            box.addView(bar, new android.widget.LinearLayout.LayoutParams(-1, -2));

            final android.widget.TextView fromBtn = new android.widget.TextView(host);
            fromBtn.setText("起始日期");
            fromBtn.setTextSize(13);
            fromBtn.setTextColor(0xFF1A6BC8);
            fromBtn.setPadding(dp(host, 12), dp(host, 4), dp(host, 12), dp(host, 6));
            final android.widget.TextView toBtn = new android.widget.TextView(host);
            toBtn.setText("结束日期");
            toBtn.setTextSize(13);
            toBtn.setTextColor(0xFF1A6BC8);
            toBtn.setPadding(dp(host, 12), dp(host, 4), dp(host, 12), dp(host, 6));
            android.widget.TextView clrBtn = new android.widget.TextView(host);
            clrBtn.setText("清除");
            clrBtn.setTextSize(13);
            clrBtn.setTextColor(0xFF9A9AA2);
            clrBtn.setPadding(dp(host, 12), dp(host, 4), dp(host, 12), dp(host, 6));
            android.widget.LinearLayout dateBar = new android.widget.LinearLayout(host);
            dateBar.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            dateBar.addView(fromBtn);
            dateBar.addView(toBtn);
            dateBar.addView(clrBtn);
            box.addView(dateBar, new android.widget.LinearLayout.LayoutParams(-1, -2));

            final java.text.SimpleDateFormat dfy = new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US);
            fromBtn.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    java.util.Calendar c = java.util.Calendar.getInstance();
                    if (fromMs[0] > 0) c.setTimeInMillis(fromMs[0]);
                    new android.app.DatePickerDialog(host, new android.app.DatePickerDialog.OnDateSetListener() {
                        @Override public void onDateSet(android.widget.DatePicker dp2, int y, int mo, int d) {
                            java.util.Calendar c2 = java.util.Calendar.getInstance();
                            c2.set(y, mo, d, 0, 0, 0);
                            fromMs[0] = c2.getTimeInMillis();
                            fromBtn.setText(dfy.format(new java.util.Date(fromMs[0])));
                            render.run();
                        }
                    }, c.get(java.util.Calendar.YEAR), c.get(java.util.Calendar.MONTH),
                            c.get(java.util.Calendar.DAY_OF_MONTH)).show();
                }
            });
            toBtn.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    java.util.Calendar c = java.util.Calendar.getInstance();
                    if (toMs[0] > 0) c.setTimeInMillis(toMs[0]);
                    new android.app.DatePickerDialog(host, new android.app.DatePickerDialog.OnDateSetListener() {
                        @Override public void onDateSet(android.widget.DatePicker dp2, int y, int mo, int d) {
                            java.util.Calendar c2 = java.util.Calendar.getInstance();
                            c2.set(y, mo, d, 0, 0, 0);
                            toMs[0] = c2.getTimeInMillis();
                            toBtn.setText(dfy.format(new java.util.Date(toMs[0])));
                            render.run();
                        }
                    }, c.get(java.util.Calendar.YEAR), c.get(java.util.Calendar.MONTH),
                            c.get(java.util.Calendar.DAY_OF_MONTH)).show();
                }
            });
            clrBtn.setOnClickListener(new android.view.View.OnClickListener() {
                @Override public void onClick(android.view.View v) {
                    fromMs[0] = 0;
                    toMs[0] = 0;
                    fromBtn.setText("起始日期");
                    toBtn.setText("结束日期");
                    render.run();
                }
            });

            box.addView(sv, new android.widget.LinearLayout.LayoutParams(-1, dp(host, 420)));
            render.run();

            final String[] all = new String[1];
            all[0] = tv.getText().toString();
            new android.app.AlertDialog.Builder(host)
                    .setTitle("红包 / 转账记录")
                    .setView(box)
                    .setPositiveButton("复制", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                android.content.ClipboardManager cm = (android.content.ClipboardManager)
                                        host.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                                cm.setPrimaryClip(android.content.ClipData.newPlainText("wxh", tv.getText().toString()));
                                toast("已复制");
                            } catch (Throwable t) { }
                        }
                    })
                    .setNeutralButton("导出本地", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            try {
                                java.io.File dir = new java.io.File(android.os.Environment
                                        .getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
                                if (!dir.exists()) dir.mkdirs();
                                java.io.File f = new java.io.File(dir, "money_records_"
                                        + new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                                        .format(new java.util.Date()) + ".txt");
                                java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
                                fo.write(tv.getText().toString().getBytes("UTF-8"));
                                fo.close();
                                toast("已导出：" + f.getName());
                            } catch (Throwable t) { toast("导出失败：" + t); }
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) { log("MONEYPANEL|err " + t); }
    }

    private static void showWelcomeSetting(final android.app.Activity a) {
