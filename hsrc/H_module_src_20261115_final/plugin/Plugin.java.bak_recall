    /** 解析好友申请 XML 并同意 */
    private static void tryAcceptFriend(String content, String talker) {
        try {
            String enc = pick(content, "encryptusername");
            String ticket = pick(content, "ticket");
            String sceneS = pick(content, "scene");
            if (enc == null || ticket == null) {
                log("FRIENDREQ|noluck|" + content);
                return;
            }
            int scene = 0;
            try {
                scene = Integer.parseInt(sceneS);
            } catch (Throwable t) {
            }
            log("FRIENDREQ|" + talker + "|" + enc + "|scene=" + scene);
            if (!cfg().optBoolean("autoAcceptFriend", false)) return;
            Class<?> i9 = Class.forName("w41.i9", false, appCl != null ? appCl : Plugin.class.getClassLoader());
            Object dispatcher = i9.getMethod("e").invoke(null);
            Class<?> r3 = Class.forName("com.tencent.mm.pluginsdk.model.r3", false, Plugin.class.getClassLoader());
            Object sceneObj = r3.getConstructor(int.class, String.class, String.class, int.class)
                    .newInstance(3, enc, ticket, scene);
            Class<?> n1 = Class.forName("com.tencent.mm.modelbase.n1", false, Plugin.class.getClassLoader());
            dispatcher.getClass().getMethod("g", n1).invoke(dispatcher, sceneObj);
            log("FRIENDACCEPT|sent|" + enc);
        } catch (Throwable t) {
            log("friend accept err " + t);
        }
    }

    private static String pick(String xml, String tag) {
        try {
            int i = xml.indexOf("<" + tag + ">");
            if (i < 0) return null;
            int j = xml.indexOf("</" + tag + ">", i);
            if (j < 0) return null;
            return xml.substring(i + tag.length() + 2, j);
        } catch (Throwable t) {
            return null;
        }
    }

    /** 艾特清换行：@ 之后微信爱塞换行，发送前把尾部空白和换行去掉 */
    private static void installAtClean(ClassLoader app) {
        try {
            Class<?> et = Class.forName("android.widget.EditText", false, app);
            XposedBridge.hookAllMethods(et, "setText", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("atCleanNewline", false)) return;
                        if (!inChat) return;
                        if (p.args == null || p.args.length < 1 || p.args[0] == null) return;
                        if (!(p.args[0] instanceof CharSequence)) return;
                        String s = ((CharSequence) p.args[0]).toString();
                        if (s.length() == 0 || !s.contains("@")) return;
                        int end = s.length();
                        while (end > 0) {
                            char ch = s.charAt(end - 1);
                            if (ch == '\n' || ch == '\r' || ch == ' ' || ch == '\u3000') end--; else break;
                        }
                        if (end == s.length()) return;
                        p.args[0] = s.substring(0, end);
                        log("ATCLEAN|trim " + s.length() + "->" + end);
                    } catch (Throwable ignore) { }
                }
            });
            log("hooked EditText.setText (atClean)");
        } catch (Throwable ignore) { }
    }

    /** 表情包：本地表情目录一键发到好友，移植自 FunBox 的表情面板思路 */
    private static final String EMOJI_DIR = "/sdcard/Android/data/com.h.module/files/wxh_emoji";

    private static void showEmojiPanel(final android.app.Activity a) {
        try {
            final java.util.List<String> names = new java.util.ArrayList<String>();
            try {
                android.database.Cursor c = a.getContentResolver().query(
                        android.net.Uri.parse("content://com.h.module.emoji/list"),
                        null, null, null, null);
                if (c != null) {
                    while (c.moveToNext()) {
                        String n = c.getString(0);
                        if (n != null && n.length() > 0) names.add(n);
                    }
                    c.close();
                }
            } catch (Throwable t) {
                log("EMOJI|query err " + t);
            }
            log("EMOJI|count=" + names.size());
            if (names.isEmpty()) {
                toast("表情目录是空的：" + EMOJI_DIR);
                return;
            }
            final String[] arr = names.toArray(new String[0]);
            new android.app.AlertDialog.Builder(a)
                    .setTitle("表情包")
                    .setItems(arr, new android.content.DialogInterface.OnClickListener() {
                        @Override
                        public void onClick(android.content.DialogInterface d, int which) {
                            sendEmoji(a, arr[which]);
                        }
                    })
                    .setNegativeButton("关闭", null)
                    .show();
        } catch (Throwable t) {
            log("EMOJI|err " + t);
            toast("表情包打开失败");
        }
    }

    private static void sendEmoji(android.app.Activity a, String name) {
        try {
            android.content.Intent it = new android.content.Intent(android.content.Intent.ACTION_SEND);
            it.setType("image/*");
            it.putExtra(android.content.Intent.EXTRA_STREAM,
                    android.net.Uri.parse("content://com.h.module.emoji/" + android.net.Uri.encode(name)));
            it.addFlags(android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION);
            it.setPackage(wxPkg());
            a.startActivity(it);
            log("EMOJI|send " + name);
        } catch (Throwable t) {
            log("EMOJI|send err " + t);
            toast("发送失败：" + t);
        }
    }

    private static void installChatDoubleTap(ClassLoader app) {
        try {
            Class<?> c = Class.forName("com.tencent.mm.ui.chatting.ChattingUI", false, app);
            for (final Method m : c.getDeclaredMethods()) {
                if (!m.getName().equals("onResume") || m.getParameterTypes().length != 0) continue;
                m.setAccessible(true);
                XposedBridge.hookMethod(m, new XC_MethodHook() {
                    @Override
                    protected void afterHookedMethod(MethodHookParam p) {
                        try {
                            if (!(p.thisObject instanceof android.app.Activity)) return;
                            final android.app.Activity a = (android.app.Activity) p.thisObject;
                            log("hooked ChattingUI.onResume (dispatch prepared)");
                        } catch (Throwable t) {
                            log("chat tap err " + t);
                        }
                    }
                });
            }
        } catch (Throwable t) {
            log("chat double tap err " + t);
        }
    }

    private static volatile boolean inChat = false;
    private static volatile String chatTalker = null;

    /** 今日收发计数：talker -> {sent, recv} */
    private static final java.util.concurrent.ConcurrentHashMap<String, int[]> todayCounts =
            new java.util.concurrent.ConcurrentHashMap<String, int[]>();
    private static final java.util.concurrent.ConcurrentHashMap<String, Long> lastMsgFp =
            new java.util.concurrent.ConcurrentHashMap<String, Long>();
    private static volatile android.widget.TextView todayTv = null;
    /** 今日已发送总数（全局，跨会话） */
    private static final java.util.concurrent.atomic.AtomicInteger todaySentTotal =
            new java.util.concurrent.atomic.AtomicInteger(0);
