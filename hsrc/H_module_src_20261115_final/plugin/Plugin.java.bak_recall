    private static java.util.ArrayList<String[]> msgTypeStats(String talker, String[] outPath) {
        java.util.ArrayList<String[]> out = new java.util.ArrayList<String[]>();
        try {
            long[] cnt = new long[12];
            String[] names = {"文字", "图片", "语音", "视频", "文件", "表情", "位置", "名片",
                    "链接", "系统提示", "其他", "合计"};
            long total = 0;
            int pageSize = 5000;
            for (int off = 0; ; off += pageSize) {
                java.util.List<Object[]> rows = queryRows(
                        "select ifnull(type,0), ifnull(content,'') from message where talker='"
                                + escSql(talker) + "' order by createTime limit " + pageSize
                                + " offset " + off, 2);
                if (rows.isEmpty()) break;
                for (Object[] r : rows) {
                    int type = 0;
                    try { type = Integer.parseInt(String.valueOf(r[0])); } catch (Throwable ignore) { }
                    String c = r[1] == null ? "" : String.valueOf(r[1]);
                    int base = type & 65535;
                    total++;
                    if (base == 1) cnt[0]++;
                    else if (base == 3) cnt[1]++;
                    else if (base == 34) cnt[2]++;
                    else if (base == 43) cnt[3]++;
                    else if (base == 47) cnt[5]++;
                    else if (base == 48) cnt[6]++;
                    else if (base == 42) cnt[7]++;
                    else if (base == 10000) cnt[9]++;
                    else if (base == 49) {
                        String appType = cleanXmlText(tagOf(c, "type"));
                        if ("5".equals(appType != null ? appType.trim() : "")) cnt[8]++;
                        else cnt[4]++;
                    } else cnt[10]++;
                }
                if (rows.size() < pageSize) break;
                if (off > 2000000) break;
            }
            cnt[11] = total;
            for (int i = 0; i < names.length; i++) {
                String pct = total > 0 ? String.format(java.util.Locale.US, "%.1f%%", cnt[i] * 100.0 / total) : "-";
                out.add(new String[]{names[i], String.valueOf(cnt[i]), pct});
            }
            try {
                java.io.File dir = new java.io.File(
                        android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
                dir.mkdirs();
                StringBuilder csv = new StringBuilder("\uFEFF类型,数量,占比\n");
                for (String[] l : out) csv.append(l[0]).append(',').append(l[1]).append(',').append(l[2]).append('\n');
                java.io.File f = new java.io.File(dir, "type_stats_" + safeName(displayOfTalker(talker))
                        + "_" + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                        .format(new java.util.Date()) + ".csv");
                java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
                fo.write(csv.toString().getBytes("UTF-8"));
                fo.close();
                if (outPath != null && outPath.length > 0) outPath[0] = f.getAbsolutePath();
            } catch (Throwable t) { log("MTYPE|csv err " + t); }
            StringBuilder lg = new StringBuilder();
            for (String[] l : out) lg.append(l[0]).append('=').append(l[1]).append(' ');
            log("MTYPE|talker=" + talker + " " + lg);
        } catch (Throwable t) { log("MTYPE|err " + t); }
        return out;
    }

    private static void runMsgTypeStats(final android.app.Activity a, final String talker, final String name) {
        toast("正在统计…");
        new Thread(new Runnable() {
            @Override public void run() {
                final String[] path = new String[1];
                final java.util.ArrayList<String[]> st = msgTypeStats(talker, path);
                a.runOnUiThread(new Runnable() {
