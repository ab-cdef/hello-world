    private static void askDice(final android.app.Activity a) {
        final String[] opts = {"关闭", "1 点", "2 点", "3 点", "4 点", "5 点", "6 点"};
        int cur = cfg().optInt("dice", 0);
        new android.app.AlertDialog.Builder(a)
                .setTitle("骰子作弊")
                .setSingleChoiceItems(opts, cur < 0 ? 0 : cur, new android.content.DialogInterface.OnClickListener() {
                    @Override
                    public void onClick(android.content.DialogInterface d, int which) {
                        try {
                            JSONObject o = readCfg();
                            o.put("dice", which);
                            writeCfg(o);
                            cfgAt = 0;
                            d.dismiss();
                            showSettings(a);
                        } catch (Throwable t) {
                        }
                    }
                })
                .show();
    }

    private static void askNumber(final android.app.Activity a, String title, String hint, final String key) {
        final android.widget.EditText et = new android.widget.EditText(a);
        et.setHint(hint);
        int cur = cfg().optInt(key, 0);
        if (cur > 0) et.setText(String.valueOf(cur));
        new android.app.AlertDialog.Builder(a)
                .setTitle(title)
                .setView(et)
                .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                    @Override
                    public void onClick(android.content.DialogInterface d, int which) {
                        try {
                            int v = Integer.parseInt(et.getText().toString().trim());
                            JSONObject o = readCfg();
                            o.put(key, v);
                            writeCfg(o);
                            cfgAt = 0;
                            showSettings(a);
                        } catch (Throwable t) {
                            toast("请输入数字，0 表示关闭");
                        }
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static void askLocation(final android.app.Activity a) {
        android.widget.LinearLayout ll = new android.widget.LinearLayout(a);
        ll.setOrientation(android.widget.LinearLayout.VERTICAL);
        final android.widget.EditText lat = new android.widget.EditText(a);
        lat.setHint("纬度，如 23.1291");
        final android.widget.EditText lng = new android.widget.EditText(a);
        lng.setHint("经度，如 113.2644");
        double cl = cfg().optDouble("fakeLat", 0);
        double cg = cfg().optDouble("fakeLng", 0);
        if (cl != 0) lat.setText(String.valueOf(cl));
        if (cg != 0) lng.setText(String.valueOf(cg));
        ll.addView(lat);
        ll.addView(lng);
        new android.app.AlertDialog.Builder(a)
                .setTitle("虚拟定位（0 表示关闭）")
                .setView(ll)
                .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                    @Override
                    public void onClick(android.content.DialogInterface d, int which) {
                        try {
                            JSONObject o = readCfg();
                            o.put("fakeLat", Double.parseDouble(lat.getText().toString().trim()));
                            o.put("fakeLng", Double.parseDouble(lng.getText().toString().trim()));
                            writeCfg(o);
                            cfgAt = 0;
                            showSettings(a);
                        } catch (Throwable t) {
                            toast("请输入正确坐标");
                        }
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static void askCsv(final android.app.Activity a, String title, String hint, final String key) {
        final android.widget.EditText et = new android.widget.EditText(a);
        org.json.JSONArray arr = cfg().optJSONArray(key);
        StringBuilder sb = new StringBuilder();
        if (arr != null) {
            for (int i = 0; i < arr.length(); i++) {
                if (sb.length() > 0) sb.append(',');
                sb.append(arr.optString(i));
            }
        }
        et.setText(sb.toString());
        et.setHint(hint + "，英文逗号分隔，留空=关闭");
        new android.app.AlertDialog.Builder(a)
                .setTitle(title)
                .setView(et)
                .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                    @Override
                    public void onClick(android.content.DialogInterface d, int which) {
                        try {
                            JSONObject o = readCfg();
                            org.json.JSONArray list = new org.json.JSONArray();
                            for (String k : et.getText().toString().split(",")) {
                                String t2 = k.trim();
                                if (t2.length() > 0) list.put(t2);
                            }
                            o.put(key, list);
                            writeCfg(o);
                            cfgAt = 0;
                            showSettings(a);
                        } catch (Throwable t) {
                            toast("保存失败");
                        }
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    /** 扫描好友：导出 rcontact 的 type 分布与疑似非好友 */
    /** 加载好友列表（昵称） */
    private static Object findDbIn(Object store) {
        try {
            Class<?> c = store.getClass();
            while (c != null && c != Object.class) {
                for (java.lang.reflect.Field f : c.getDeclaredFields()) {
                    if (f.getType().getName().contains("SQLiteDatabase")) {
                        f.setAccessible(true);
                        Object v = f.get(store);
                        if (v != null) return v;
                    }
                }
                c = c.getSuperclass();
            }
        } catch (Throwable t) {
        }
        return null;
    }

    private static java.util.List<String> loadFriendNames() {
        java.util.List<String> out = new java.util.ArrayList<String>();
        try {
            Object db = dbRef;
            if (db == null) {
                try {
                    Object f = Class.forName("w41.i9", false, appCl).getMethod("b").invoke(null);
                    Object store = f.getClass().getMethod("v").invoke(f);
                    db = findDbIn(store);
                    if (db != null) dbRef = db;
                    log("loadFriendNames|db from store=" + (db != null));
                } catch (Throwable t) {
                    log("loadFriendNames|store err " + t);
                }
            }
            if (db == null) {
                log("loadFriendNames|no db");
                return out;
            }
            Object cur = null;
            for (Method m : db.getClass().getMethods()) {
                if (!m.getName().equals("rawQuery")) continue;
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length != 2 || ps[0] != String.class) continue;
                Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                m.setAccessible(true);
                cur = m.invoke(db, "select username,nickname,conRemark,type from rcontact", arg);
                break;
            }
            if (cur == null) return out;
            Method mv = cur.getClass().getMethod("moveToNext");
            Method gs = cur.getClass().getMethod("getString", int.class);
            Method gi = cur.getClass().getMethod("getInt", int.class);
            java.util.HashSet<String> seen = new java.util.HashSet<String>();
            while ((Boolean) mv.invoke(cur)) {
                String u = (String) gs.invoke(cur, 0);
                String n = (String) gs.invoke(cur, 1);
                String rm = (String) gs.invoke(cur, 2);
                int t = (Integer) gi.invoke(cur, 3);
                if (u == null) continue;
                if (u.endsWith("@chatroom") || u.startsWith("gh_") || u.contains("@app")
                        || u.equals("filehelper") || u.startsWith("weixin")) continue;
                if ((t & 1) == 0) continue;
                String label = (rm != null && rm.length() > 0) ? rm : (n == null ? u : n);
                if (label.length() == 0) continue;
                if (seen.add(label)) out.add(label);
            }
            try {
                cur.getClass().getMethod("close").invoke(cur);
            } catch (Throwable t) {
            }
            java.util.Collections.sort(out);
        } catch (Throwable t) {
            log("loadFriendNames err " + t);
        }
        return out;
    }

    private static java.util.List<String> loadGroupNames() {
        java.util.List<String> out = new java.util.ArrayList<String>();
        try {
            Object db = dbRef;
            if (db == null) return out;
            Object cur = null;
            for (Method m : db.getClass().getMethods()) {
                if (!m.getName().equals("rawQuery")) continue;
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length != 2 || ps[0] != String.class) continue;
                Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                m.setAccessible(true);
                cur = m.invoke(db, "select username,nickname,conRemark from rcontact where username like '%@chatroom'", arg);
                break;
            }
            if (cur == null) return out;
            Method mv = cur.getClass().getMethod("moveToNext");
            Method gs = cur.getClass().getMethod("getString", int.class);
            while ((Boolean) mv.invoke(cur)) {
                String rm = (String) gs.invoke(cur, 2);
                String n = (String) gs.invoke(cur, 1);
                String label = (rm != null && rm.length() > 0) ? rm : n;
                if (label != null && label.length() > 0) out.add(label);
            }
            try {
                cur.getClass().getMethod("close").invoke(cur);
            } catch (Throwable t) {
            }
            java.util.Collections.sort(out);
        } catch (Throwable t) {
            log("loadGroupNames err " + t);
        }
        return out;
    }

    /** 好友选择器（支持搜索/随机），写入指定配置键 */
    private static void pickFriendsFor(final android.app.Activity a, final String cfgKey, final String title) {
        try {
            final java.util.List<String> all = loadFriendNames();
            if (all.isEmpty()) {
                toast("没读到好友列表，先收发一条消息再试");
                return;
            }
            final java.util.LinkedHashSet<String> selected = new java.util.LinkedHashSet<String>();
            org.json.JSONArray cur = cfg().optJSONArray(cfgKey);
            if (cur != null) {
                for (int i = 0; i < cur.length(); i++) selected.add(cur.optString(i));
            }
            android.widget.LinearLayout box = new android.widget.LinearLayout(a);
            box.setOrientation(android.widget.LinearLayout.VERTICAL);
            final android.widget.EditText search = new android.widget.EditText(a);
            search.setHint("搜索好友昵称");
            box.addView(search);
            final android.widget.ListView lv = new android.widget.ListView(a);
            lv.setLayoutParams(new android.widget.LinearLayout.LayoutParams(
                    android.widget.LinearLayout.LayoutParams.MATCH_PARENT, 900));
            box.addView(lv);
            final java.util.List<String> shown = new java.util.ArrayList<String>(all);
            final android.widget.ArrayAdapter<String> adapter = new android.widget.ArrayAdapter<String>(
                    a, android.R.layout.simple_list_item_multiple_choice, shown);
            lv.setAdapter(adapter);
            lv.setChoiceMode(android.widget.ListView.CHOICE_MODE_MULTIPLE);
            for (int i = 0; i < shown.size(); i++) lv.setItemChecked(i, selected.contains(shown.get(i)));
            lv.setOnItemClickListener(new android.widget.AdapterView.OnItemClickListener() {
                @Override
                public void onItemClick(android.widget.AdapterView<?> p1, View v, int pos, long id) {
                    String s2 = shown.get(pos);
                    if (lv.isItemChecked(pos)) selected.add(s2);
                    else selected.remove(s2);
                }
            });
            search.addTextChangedListener(new android.text.TextWatcher() {
                @Override
                public void beforeTextChanged(CharSequence s1, int st, int c, int af) {
                }

                @Override
                public void onTextChanged(CharSequence s1, int st, int b, int c) {
                    String q = s1.toString().trim();
                    shown.clear();
                    for (String n : all) {
                        if (q.length() == 0 || n.contains(q)) shown.add(n);
                    }
                    adapter.notifyDataSetChanged();
                    for (int i = 0; i < shown.size(); i++) lv.setItemChecked(i, selected.contains(shown.get(i)));
                }

                @Override
                public void afterTextChanged(android.text.Editable s1) {
                }
            });
            android.widget.LinearLayout bar = new android.widget.LinearLayout(a);
            bar.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            android.widget.Button btnAll = new android.widget.Button(a);
            btnAll.setText("全选");
            android.widget.Button btnNone = new android.widget.Button(a);
            btnNone.setText("清空");
            android.widget.Button btnRand = new android.widget.Button(a);
            btnRand.setText("随机");
            bar.addView(btnAll, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
            bar.addView(btnNone, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
            bar.addView(btnRand, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
            box.addView(bar);

            final android.app.AlertDialog dlg = new android.app.AlertDialog.Builder(a)
                    .setTitle(title + " · 已选 " + selected.size() + " / " + all.size())
                    .setView(box)
                    .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                        @Override
                        public void onClick(android.content.DialogInterface d, int which) {
                            try {
                                JSONObject o = readCfg();
                                org.json.JSONArray arr = new org.json.JSONArray();
                                for (String n : selected) arr.put(n);
                                o.put(cfgKey, arr);
                                if ("snsLikeNames".equals(cfgKey)) o.put("snsAutoLike", arr.length() > 0);
                                writeCfg(o);
                                cfgAt = 0;
                                toast("已保存 " + arr.length() + " 人");
                                showSettings(a);
                            } catch (Throwable t) {
                                toast("保存失败");
                            }
                        }
                    })
                    .setNegativeButton("取消", null)
                    .create();
            btnAll.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    selected.addAll(shown);
                    for (int i = 0; i < shown.size(); i++) lv.setItemChecked(i, true);
                    dlg.setTitle(title + " · 已选 " + selected.size() + " / " + all.size());
                }
            });
            btnNone.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    selected.clear();
                    for (int i = 0; i < shown.size(); i++) lv.setItemChecked(i, false);
                    dlg.setTitle(title + " · 已选 0 / " + all.size());
                }
            });
            btnRand.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    final android.widget.EditText et = new android.widget.EditText(a);
                    et.setHint("随机选几个？");
                    new android.app.AlertDialog.Builder(a)
                            .setTitle("随机选人")
                            .setView(et)
                            .setPositiveButton("确定", new android.content.DialogInterface.OnClickListener() {
                                @Override
                                public void onClick(android.content.DialogInterface d2, int w2) {
                                    try {
                                        int n = Integer.parseInt(et.getText().toString().trim());
                                        if (n <= 0) return;
                                        java.util.List<String> pool = new java.util.ArrayList<String>(shown);
                                        java.util.Collections.shuffle(pool);
                                        selected.clear();
                                        for (int i = 0; i < Math.min(n, pool.size()); i++) selected.add(pool.get(i));
                                        for (int i = 0; i < shown.size(); i++) lv.setItemChecked(i, selected.contains(shown.get(i)));
                                        dlg.setTitle(title + " · 已选 " + selected.size() + " / " + all.size());
                                        toast("随机选中 " + selected.size() + " 人");
                                    } catch (Throwable t) {
                                        toast("请输入数字");
                                    }
                                }
                            })
                            .setNegativeButton("取消", null)
                            .show();
                }
            });
            dlg.show();
        } catch (Throwable t) {
            log("pickFriendsFor err " + t);
        }
    }

