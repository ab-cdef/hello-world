    }


    /* ================= 原生消息时间：格式 / 颜色 ================= */
    private static final java.util.regex.Pattern TIME_PAT =
            java.util.regex.Pattern.compile(
                "^\\s*(昨天|前天|今天|星期[一二三四五六日天]|周[一二三四五六日天])?\\s*"
              + "(\\d{4}[/\\-年.]\\d{1,2}[/\\-月.]\\d{1,2}日?|\\d{1,2}月\\d{1,2}日)?\\s*"
              + "\\d{1,2}:\\d{2}(:\\d{2})?\\s*$");

    /* ================= 全量归档：所有会话的图片 / 语音 / 视频 =================
     * 一次性把所有会话来一遍，增量（同名同大小跳过），可随时取消。
     * 输出：Download/wxh/archive/<会话>/images|voice|video
     */
    private static void showArchiveAll(final android.app.Activity a) {
        try {
            long free = 0;
            try {
                android.os.StatFs sf = new android.os.StatFs(
                        android.os.Environment.getExternalStorageDirectory().getAbsolutePath());
                free = sf.getAvailableBytes() / (1024 * 1024);
            } catch (Throwable ignore) { }
            new android.app.AlertDialog.Builder(a)
                    .setTitle("全量归档")
                    .setMessage("把全部会话的图片、语音、视频归档到\nDownload/wxh/archive/<会话>/\n\n"
                            + "已经导出过（同名同大小）的会自动跳过，可以随时取消。\n"
                            + "剩余空间约 " + free + " MB。")
                    .setPositiveButton("开始", new android.content.DialogInterface.OnClickListener() {
                        @Override public void onClick(android.content.DialogInterface d, int w) {
                            startArchiveAll(a, 0);
                        }
                    })
                    .setNegativeButton("取消", null).show();
        } catch (Throwable t) { toast("打开失败"); }
    }

    /** 返回 {会话数, 图片, 语音, 视频, 错误码}；archiveStage 供 UI 显示当前会话 */
    static volatile String archiveStage = "";

    private static int[] archiveChats(int limit, String[] stage) {
        int chats = 0, ni = 0, nv = 0, nm = 0, err = -1;
        try {
            java.io.File root = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh/archive");
            root.mkdirs();
            java.util.List<Object[]> rows = queryRows(
                    "select username from rconversation where username is not null"
                            + " and username != '' order by conversationTime desc", 1);
            log("ARCHIVE|chats=" + rows.size() + " limit=" + limit);
            for (Object[] r : rows) {
                if (expCancel) break;
                String tk = r[0] == null ? "" : String.valueOf(r[0]);
                if (tk.length() == 0) continue;
                String nm2 = displayOfTalker(tk);
                archiveStage = "正在归档：" + nm2;
                if (stage != null && stage.length > 0) stage[0] = archiveStage;
                java.io.File base = new java.io.File(root, safeName(nm2));
                java.io.File di = new java.io.File(base, "images");
                java.io.File dv = new java.io.File(base, "voice");
                java.io.File dm = new java.io.File(base, "video");
                di.mkdirs(); dv.mkdirs(); dm.mkdirs();
                int n1 = exportImages(tk, 0, di, null);
                int n2 = exportVoiceOf(tk, 0, dv, null);
                int n3 = exportVideoOfX(tk, 0, dm, false, null);
                ni += n1; nv += n2; nm += n3;
                chats++;
                log("ARCHIVE|" + tk + " img=" + n1 + " voice=" + n2 + " video=" + n3);
                if (limit > 0 && chats >= limit) break;
            }
        } catch (Throwable t) {
            err = 1;
            log("ARCHIVE|err " + t);
        }
        return new int[]{chats, ni, nv, nm, err};
    }

    private static void startArchiveAll(final android.app.Activity a, final int limit) {
        expReset();
        final android.widget.TextView tv = new android.widget.TextView(a);
        tv.setText("准备中…");
        tv.setTextSize(15);
        tv.setPadding(dp(a, 20), dp(a, 18), dp(a, 20), dp(a, 8));
        android.widget.ProgressBar pb = new android.widget.ProgressBar(a);
        pb.setIndeterminate(true);
        android.widget.LinearLayout box = new android.widget.LinearLayout(a);
        box.setOrientation(android.widget.LinearLayout.VERTICAL);
        box.addView(tv);
        box.addView(pb);
        final android.app.AlertDialog dlg = new android.app.AlertDialog.Builder(a)
                .setTitle("正在归档全部会话")
                .setView(box)
                .setNegativeButton("取消", new android.content.DialogInterface.OnClickListener() {
                    @Override public void onClick(android.content.DialogInterface d, int w) { expCancel = true; }
                })
                .setCancelable(false)
                .create();
        dlg.show();

        final boolean[] live = {true};
        final String[] stage = {"准备中"};
        new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
            @Override public void run() {
                if (!live[0]) return;
                tv.setText(stage[0] + "\n已处理 " + expSeen + " 条 · 导出 " + expGot + " · 跳过 " + expSkip);
                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(this, 500);
            }
        });

        new Thread(new Runnable() {
            @Override public void run() {
                int[] res = archiveChats(limit, stage);
                final int fc = res[0], fi = res[1], fv = res[2], fm = res[3];
                String err = res[4] < 0 ? null : "err=" + res[4];
                final String fe = err;
                log("ARCHIVE|done chats=" + fc + " img=" + fi + " voice=" + fv + " video=" + fm
                        + " skip=" + expSkip + " cancel=" + expCancel);
                live[0] = false;
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        try { dlg.dismiss(); } catch (Throwable ignore) { }
                        try {
                            notifyLocal(a, expCancel ? "归档已取消" : "归档完成",
                                    "会话 " + fc + " 个 · 图片 " + fi + " · 语音 " + fv + " · 视频 " + fm);
                        } catch (Throwable ignore) { }
                        new android.app.AlertDialog.Builder(a)
                                .setTitle(expCancel ? "已取消" : "归档完成")
                                .setMessage((fe != null ? "出错：" + fe + "\n\n" : "")
                                        + "会话 " + fc + " 个\n图片 " + fi + " · 语音 " + fv
                                        + " · 视频 " + fm + "\n跳过（已存在）" + expSkip + " 个\n\n"
                                        + "Download/wxh/archive/")
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    /* ================= 自动保存收到的语音 / 视频 =================
     * 语音在收到时就会落到 MicroMsg/<hash>/voice2/，视频要等下载。
     * 复用导出器（带增量跳过），所以同一条消息不会重复写文件。
     */
    private static final java.util.HashMap<String, Long> autoSaveAt = new java.util.HashMap<String, Long>();

    /** 新消息到达后延迟执行，等微信把文件落盘 */
    private static void scheduleAutoSave(final String talker, final int type) {
        try {
            if (talker == null || talker.length() == 0) return;
            if (!talker.endsWith("@chatroom") && talker.startsWith("gh_")) return;   // 公众号跳过
            final String kind = type == 34 ? "voice" : "video";
            final String key = talker + "#" + kind;
            synchronized (autoSaveAt) {
                Long last = autoSaveAt.get(key);
                long now = System.currentTimeMillis();
                if (last != null && now - last < 30000) return;                       // 30 秒内同一会话只跑一次
                autoSaveAt.put(key, now);
                if (autoSaveAt.size() > 200) autoSaveAt.clear();
            }
            new Thread(new Runnable() {
                @Override public void run() {
                    try { Thread.sleep(6000); } catch (Throwable ignore) { }
                    try {
                        java.io.File base = new java.io.File(
                                android.os.Environment.getExternalStorageDirectory(),
                                "Download/wxh/auto/" + safeName(displayOfTalker(talker)));
                        long sinceMs = System.currentTimeMillis() - 3600L * 1000L;
                        int n;
                        if ("voice".equals(kind)) {
                            java.io.File d = new java.io.File(base, "voice");
                            d.mkdirs();
                            n = exportVoiceOf(talker, sinceMs, d, null);
                        } else {
                            java.io.File d = new java.io.File(base, "video");
                            d.mkdirs();
                            n = exportVideoOfX(talker, sinceMs, d, false, null);
                        }
                        if (n > 0) log("AUTOSAVE|" + kind + " " + talker + " ok=" + n);
                    } catch (Throwable t) { log("AUTOSAVE|err " + t); }
                }
            }).start();
        } catch (Throwable ignore) { }
    }

    /* ================= 聊天输入框提示文字 ================= */
    private static final String[] INPUT_HINTS = {"", "__today", "说点什么…", "在忙，稍后回复"};

    private static void cycleInputHint() {
        try {
            String cur = readCfg().optString("inputHint", "");
            int idx = 0;
            for (int i = 0; i < INPUT_HINTS.length; i++) {
                if (INPUT_HINTS[i].equals(cur)) { idx = i; break; }
            }
            idx = (idx + 1) % INPUT_HINTS.length;
            setStrCfg("inputHint", INPUT_HINTS[idx]);
            toast(INPUT_HINTS[idx].length() == 0 ? "输入框提示文字：关"
                    : ("__today".equals(INPUT_HINTS[idx]) ? "输入框提示：今日已发送消息总数" : "输入框提示：" + INPUT_HINTS[idx]));
        } catch (Throwable t) { toast("设置失败"); }
    }

    private static void applyInputHint() {
        try {
            String mode = cfg().optString("inputHint", "");
            android.widget.EditText et = currentInput();
            if (et == null) return;
            // 「今日已发送消息总数」模式：提示文字 = 今日已发条数
            if ("__today".equals(mode) || cfg().optBoolean("todayCount", true)) {
                String hint = "今日已发 " + todaySendCount() + " 条消息";
                CharSequence cur = et.getHint();
                if (cur != null && hint.contentEquals(cur)) return;
                et.setHint(hint);
                et.setTag(0x0f0f0f51, Boolean.TRUE);
                return;
            }
            if (mode.length() == 0) {
                if (et.getTag(0x0f0f0f51) != null) { et.setHint(null); et.setTag(0x0f0f0f51, null); }
                return;
            }
            CharSequence cur = et.getHint();
            if (cur != null && mode.contentEquals(cur)) return;
            et.setHint(mode);
            et.setTag(0x0f0f0f51, Boolean.TRUE);
        } catch (Throwable ignore) { }
    }

    /** 今天 00:00 的毫秒时间戳 */
    private static long todayStartMs() {
        java.util.Calendar c = java.util.Calendar.getInstance();
        c.set(java.util.Calendar.HOUR_OF_DAY, 0);
        c.set(java.util.Calendar.MINUTE, 0);
        c.set(java.util.Calendar.SECOND, 0);
        c.set(java.util.Calendar.MILLISECOND, 0);
        return c.getTimeInMillis();
    }

    /** 今日已发送的消息条数（自己发的、非系统提示） */
    private static int todaySendCount() {
        try {
            long start = todayStartMs();
            java.util.List<Object[]> r = queryRows(
                    "select count(1) from message where isSend=1 and createTime>=" + sinceRaw(start)
                            + " and (type & 65535) not in (10000,10002)", 1);
            if (r != null && r.size() > 0 && r.get(0)[0] != null) {
                return Integer.parseInt(String.valueOf(r.get(0)[0]));
            }
        } catch (Throwable ignore) { }
        return 0;
    }

    private static void applyNativeTimeStyle(android.view.View list) {
        try {
            if (!(list instanceof android.view.ViewGroup)) return;
            String fmt = cfg().optString("ntTimeFmt", "");
            // 时间颜色统一走灰色：历史配置 ntTimeColorInt=-65530(≈#FF0006 纯红) 曾把部分时间
            // 反复染成红字，这里不再读 ntTimeColorInt / ntTimeColor，一律用统一时间色
            String col = String.format("#%06X", msgTimeColor() & 0xFFFFFF);
            android.view.ViewGroup g = (android.view.ViewGroup) list;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View row = g.getChildAt(i);
                java.util.List<android.view.View> all = new java.util.ArrayList<android.view.View>();
                collectViews(row, all, 0);
                Long ts = null;
                for (android.view.View v : all) {
                    if (!(v instanceof android.widget.TextView)) continue;
                    CharSequence cs = ((android.widget.TextView) v).getText();
                    if (cs == null) continue;
                    String t = cs.toString();
                    if (!TIME_PAT.matcher(t).matches()) continue;
                    android.widget.TextView tv = (android.widget.TextView) v;
                    int nsize = cfg().optInt("ntTimeSize", 0);
                    if (nsize > 0) {
                        try { tv.setTextSize(android.util.TypedValue.COMPLEX_UNIT_SP, nsize); } catch (Throwable ignore) { }
                    }
                    if (fmt.length() > 0) {
                        if (ts == null) {
                            long tsv = 0;
                            try {
                                Object o = row.getTag(0x0f0f0f06);
                                if (o instanceof Long) tsv = (Long) o;
                            } catch (Throwable ignore) { }
                            if (tsv <= 0) {
                                // 从原文解析：只有时分秒时用今天
                                tsv = parseTimeText(t);
                            }
                            ts = tsv;
                        }
                        if (ts != null && ts > 0) {
                            try {
                                String nv = new java.text.SimpleDateFormat(fmt, java.util.Locale.US)
                                        .format(new java.util.Date(ts));
                                if (!nv.equals(t)) tv.setText(nv);
                            } catch (Throwable ignore) { }
                        }
                    }
                    // 颜色放在最后：微信的时间文本带 ForegroundColorSpan，span 会压过 setTextColor，
                    // 所以先把 span 清掉（改成纯文本）再上色，颜色设置才真的有效
                    if (col.length() == 7 && col.startsWith("#")) {
                        try {
                            CharSequence cs2 = tv.getText();
                            if (cs2 instanceof android.text.Spanned) {
                                String plain = cs2.toString();
                                tv.setText(plain);
                            }
                            tv.setTextColor(android.graphics.Color.parseColor(col));
                            if (ntLogAt == 0) {
                                ntLogAt = 1;
                                log("NTTIME|tv=" + tv.getClass().getName() + " txt=" + tv.getText()
                                        + " col=" + col + " parent=" + (tv.getParent() == null ? "null"
                                        : tv.getParent().getClass().getName()));
                            }
                        } catch (Throwable ignore) { }
                    }
                }
            }
        } catch (Throwable t) { }
    }

    private static long parseTimeText(String t) {
        try {
            String s = t.trim().replace('年', '-').replace('月', '-').replace("日", "");
            String[] ps = {"yyyy-M-d H:m:s", "yyyy-M-d H:m", "yyyy/M/d H:m:s", "yyyy/M/d H:m",
                    "M-d H:m:s", "M-d H:m", "H:m:s", "H:m"};
            for (String p : ps) {
                try {
                    java.text.SimpleDateFormat f =
                            new java.text.SimpleDateFormat(p, java.util.Locale.US);
                    f.setLenient(false);
                    java.util.Date d = f.parse(s);
                    if (d == null) continue;
                    long v = d.getTime();
                    if (p.startsWith("H") || p.startsWith("M-d")) {
                        java.util.Calendar c = java.util.Calendar.getInstance();
                        java.util.Calendar o = java.util.Calendar.getInstance();
                        o.setTimeInMillis(v);
                        c.set(java.util.Calendar.HOUR_OF_DAY, o.get(java.util.Calendar.HOUR_OF_DAY));
                        c.set(java.util.Calendar.MINUTE, o.get(java.util.Calendar.MINUTE));
                        c.set(java.util.Calendar.SECOND, o.get(java.util.Calendar.SECOND));
                        if (p.startsWith("M-d")) {
                            c.set(java.util.Calendar.MONTH, o.get(java.util.Calendar.MONTH));
                            c.set(java.util.Calendar.DAY_OF_MONTH, o.get(java.util.Calendar.DAY_OF_MONTH));
                        }
                        return c.getTimeInMillis();
                    }
                    return v;
                } catch (Throwable ignore) { }
            }
        } catch (Throwable ignore) { }
        return 0;
    }


