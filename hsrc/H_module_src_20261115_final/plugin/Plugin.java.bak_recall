    private static void installFakeLike(ClassLoader app) {
        try {
            Class<?> queue = Class.forName("com.tencent.mm.modelbase.s1", false, app);
            XposedBridge.hookAllMethods(queue, "g", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        // 只在「刚做了伪赞」的 1.5 秒窗口内兜底拦截，平时完全放行，避免把真点赞/评论/发布一起挡掉
                        if (System.currentTimeMillis() > fakeBlockUntil) return;
                        Object scene = p.args[0];
                        if (scene == null) return;
                        String cn = scene.getClass().getName();
                        if (!cn.contains("sns.model")) return;
                        log("FAKELIKE|blocked " + cn);
                        p.setResult(Boolean.TRUE);
                    } catch (Throwable t) {
                    }
                }
            });
            log("hooked fake like blocker");
        } catch (Throwable t) {
            log("fakeLike err " + t);
        }
    }

    private static void installGrabCallback(ClassLoader app) {
        try {
            Class<?> n6 = Class.forName("com.tencent.mm.plugin.luckymoney.model.n6", false, app);
            XposedBridge.hookAllMethods(n6, "onGYNetEnd", new XC_MethodHook() {
                @Override
                protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        Object self = p.thisObject;
                        if (!myQuery.remove(self)) return;
                        String timing = (String) getFieldByName(self, "P");
                        log("GRAB|query back timing=" + timing);
                        Object msgType = getFieldByName(self, "h");
                        Object ch = getFieldByName(self, "i");
                        Object sendId = getFieldByName(self, "m");
                        Object nativeUrl = getFieldByName(self, "n");
                        claimNow(toInt(msgType, 1), toInt(ch, 1),
                                String.valueOf(sendId), String.valueOf(nativeUrl), timing,
                                pendingTalker != null ? pendingTalker : "");
                    } catch (Throwable t) {
                        log("GRAB cb err " + t);
                    }
                }
            });
            log("hooked n6.onGYNetEnd");
            Class<?> h6 = Class.forName("com.tencent.mm.plugin.luckymoney.model.h6", false, app);
            XposedBridge.hookAllMethods(h6, "onGYNetEnd", new XC_MethodHook() {
                @Override
                protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        Object[] a = p.args;
                        StringBuilder sb = new StringBuilder("GRABRESP|");
                        for (Object o : a) {
                            String v = String.valueOf(o);
                            if (v.length() > 600) v = v.substring(0, 600);
                            sb.append('[').append(v).append(']');
                        }
                        log(sb.toString());
                    } catch (Throwable t) {
                    }
                }
            });
            log("hooked h6.onGYNetEnd");
            // 记录微信自己构造 h6 时的真实参数
            for (java.lang.reflect.Constructor<?> ct : h6.getDeclaredConstructors()) {
                ct.setAccessible(true);
                XposedBridge.hookMethod(ct, new XC_MethodHook() {
                @Override
                protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("grabTrace", true)) return;
                        StringBuilder sb = new StringBuilder("H6CTOR|");
                        for (Object o : p.args) {
                            String v = String.valueOf(o);
                            if (v.length() > 80) v = v.substring(0, 80);
                            sb.append('[').append(v).append(']');
                        }
                        log(sb.toString());
                    } catch (Throwable t) {
                    }
                }
                });
            }
            log("hooked h6 ctor");
        } catch (Throwable t) {
            log("grab cb install err " + t);
        }
    }

    private static Object getFieldByName(Object o, String n) {
        try {
            Class<?> c = o.getClass();
            while (c != null) {
                for (java.lang.reflect.Field f : c.getDeclaredFields()) {
                    if (f.getName().equals(n)) {
                        f.setAccessible(true);
                        return f.get(o);
                    }
                }
                c = c.getSuperclass();
            }
        } catch (Throwable t) {
        }
        return null;
    }

    private static int toInt(Object o, int def) {
        return o instanceof Integer ? (Integer) o : def;
    }

    private static void claimNow(int msgType, int channelId, String sendId, String nativeUrl, String timing, String talker) {
        try {
            String headImg = "";
            String nick = "";
            try {
                Class<?> l1 = Class.forName("com.tencent.mm.plugin.luckymoney.model.o5", false, appCl);
                headImg = String.valueOf(l1.getMethod("l").invoke(null));
            } catch (Throwable t) {
            }
            try {
                Class<?> u0 = Class.forName("w41.z1", false, appCl);
                nick = String.valueOf(u0.getMethod("m").invoke(null));
            } catch (Throwable t) {
            }
            Class<?> h6 = Class.forName("com.tencent.mm.plugin.luckymoney.model.h6", false, appCl);
            Object scene = null;
            for (java.lang.reflect.Constructor<?> c : h6.getConstructors()) {
                Class<?>[] ps = c.getParameterTypes();
                if (ps.length != 9) continue;
                scene = c.newInstance(msgType, channelId, sendId, nativeUrl,
                        headImg, nick, talker, "v1.0", timing);
                break;
            }
            if (scene == null) {
                log("GRAB|no h6 ctor");
                return;
            }
            Object queue = Class.forName("w41.i9", false, appCl).getMethod("e").invoke(null);
            for (Method m : queue.getClass().getMethods()) {
                if (!m.getName().equals("g") || m.getParameterCount() != 1) continue;
                if (!m.getParameterTypes()[0].isInstance(scene)) continue;
                m.setAccessible(true);
                m.invoke(queue, scene);
                log("GRAB|claim sent");
                return;
            }
            log("GRAB|no dispatcher");
        } catch (Throwable t) {
            log("claimNow err " + t);
        }
    }

    /* ================= 红包：直接打开领取页（采用「自动抢红包 1.0.2」方案） ================= */

    /** 红包通知的标题与正文：群显示「群名 · 发送人」，正文用祝福语 */
    private static String[] redPacketTitleBody(String content, String talker) {
        String title = "";
        String body = "";
        try {
            String raw = content == null ? "" : content;
            String sender = null;
            int p = raw.indexOf(":\n");
            if (p > 0 && p < 64) {
                String sid = raw.substring(0, p).trim();
                if (sid.startsWith("wxid_")) { sender = sid; raw = raw.substring(p + 2); }
            }
            String senderName = "";
            if (sender != null) {
                String sn = displayOfTalker(sender);
                if (sn != null && !sn.startsWith("wxid_")) senderName = sn.trim();
            }
            if (senderName.length() == 0) {
                String nm = extractNick(content);
                if (nm != null && nm.trim().length() > 0 && !nm.startsWith("wxid_")) senderName = nm.trim();
            }
            boolean isGroup = talker != null && talker.endsWith("@chatroom");
            String groupName = "";
            if (isGroup) {
                String gn = displayOfTalker(talker);
                if (gn != null && !gn.startsWith("wxid_")) groupName = gn.trim();
            }
            if (isGroup) {
                if (groupName.length() > 0 && senderName.length() > 0) title = groupName + " · " + senderName;
                else if (groupName.length() > 0) title = groupName;
                else if (senderName.length() > 0) title = senderName;
                else title = "群红包";
            } else {
                if (senderName.length() > 0) title = senderName;
                else {
                    String dn = displayOfTalker(talker);
                    title = (dn != null && !dn.startsWith("wxid_") && dn.length() > 0) ? dn : "收到红包";
                }
            }
            String wish = cleanXmlText(tagOf(raw, "sendertitle"));
            if (wish == null || wish.trim().length() == 0) wish = cleanXmlText(tagOf(raw, "wishing"));
            if (wish == null || wish.trim().length() == 0) wish = "恭喜发财，大吉大利";
            body = wish.trim();
            if (body.startsWith("<")) body = "点击查看红包";
        } catch (Throwable t) { body = "点击查看红包"; }
        return new String[]{title, body};
    }

    /** 收到红包立刻抢（不做冷却/限流，只按 nativeurl 去重） */
    /** 触发文件存在时，把最近几条 gh_ 消息原文转储出来，用于确认支付报文真实格式 */
    static boolean payDumpDone = false;

    static void payDumpGhIfNeeded() {
        if (payDumpDone) return;
        try {
            if (!new File(DIR, "wxh_paydump").isFile()) { payDumpDone = true; return; }
        } catch (Throwable t) { return; }
        payDumpDone = true;
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    Object db = dbRef != null ? dbRef : msgDb;
                    if (db == null) { log("PAYD|no db"); return; }
                    Object cur = null;
                    for (java.lang.reflect.Method m : db.getClass().getMethods()) {
                        if (!m.getName().equals("rawQuery")) continue;
                        Class<?>[] ps = m.getParameterTypes();
                        if (ps.length != 2 || ps[0] != String.class) continue;
                        Object arg = (ps[1] == String[].class) ? new String[]{} : new Object[]{};
                        m.setAccessible(true);
                        cur = m.invoke(db, "select talker,type,createTime,content from message "
                                + "where talker like 'gh_%' order by createTime desc limit 8", arg);
                        break;
                    }
                    if (cur == null) { log("PAYD|no query"); return; }
                    java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                    java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                    java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                    java.lang.reflect.Method gi = cur.getClass().getMethod("getInt", int.class);
                    StringBuilder sb = new StringBuilder();
                    while ((Boolean) mv.invoke(cur)) {
                        String tk = (String) gs.invoke(cur, 0);
                        int ty = (Integer) gi.invoke(cur, 1);
                        long ct = (Long) gl.invoke(cur, 2);
                        String ct2 = (String) gs.invoke(cur, 3);
                        sb.append("=== ").append(tk).append(" type=").append(ty)
                          .append(" time=").append(ct).append('\n');
                        if (ct2 != null) sb.append(ct2.length() > 6000 ? ct2.substring(0, 6000) : ct2);
                        sb.append("\n\n");
                    }
                    try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                    FileOutputStream o = new FileOutputStream(new File(DIR, "wxh_paydump.txt"));
                    o.write(sb.toString().getBytes("UTF-8"));
                    o.close();
                    log("PAYD|done len=" + sb.length());
                } catch (Throwable t) {
                    log("PAYD|err " + t);
                }
            }
        }, "wxh-paydump").start();
    }

    // ============ 支付到账兜底扫描（不依赖 insert 钩子）============
    private static final java.util.HashSet<Long> PAY_SCANED = new java.util.HashSet<Long>();
    private static boolean payScanStarted = false;

    static void startPayScan() {
        if (payScanStarted) return;
        payScanStarted = true;
        new Thread(new Runnable() {
            @Override public void run() {
                long last = System.currentTimeMillis() - 3600000L;   // 启动回看 1 小时
                while (true) {
                    try { Thread.sleep(15000L); } catch (Throwable ignore) { }
                    try {
                        if (!cfg().optBoolean("payHook", true)) continue;
                        try { if (!wxh.License.isOk()) continue; } catch (Throwable ignore) { }
                        Object db = dbRef != null ? dbRef : msgDb;
                        if (db == null) continue;
                        Object cur = null;
                        for (java.lang.reflect.Method m : db.getClass().getMethods()) {
                            if (!m.getName().equals("rawQuery")) continue;
                            Class<?>[] ps = m.getParameterTypes();
                            if (ps.length != 2 || ps[0] != String.class) continue;
                            Object arg = (ps[1] == String[].class)
                                    ? (Object) new String[]{String.valueOf(last)}
                                    : (Object) new Object[]{String.valueOf(last)};
                            m.setAccessible(true);
                            cur = m.invoke(db, "select talker,createTime,content from message "
                                    + "where createTime>? and (content like '%\u4e2a\u4eba\u6536\u6b3e\u7801\u5230\u8d26%'"
                                    + " or content like '%\u5fae\u4fe1\u652f\u4ed8\u6536\u6b3e%'"
                                    + " or content like '%<totalfee>%'"
                                    + " or content like '%\u6536\u6b3e\u5230\u8d26%') "
                                    + "order by createTime asc limit 30", arg);
                            break;
                        }
                        if (cur == null) continue;
                        java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                        java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                        java.lang.reflect.Method gl = cur.getClass().getMethod("getLong", int.class);
                        long maxCt = last;
                        while ((Boolean) mv.invoke(cur)) {
                            String tk = (String) gs.invoke(cur, 0);
                            long ct = ((Number) gl.invoke(cur, 1)).longValue();
                            if (ct > maxCt) maxCt = ct;
                            String ct2 = (String) gs.invoke(cur, 2);
                            if (ct2 == null || ct2.length() == 0) continue;
                            synchronized (PAY_SCANED) {
                                if (PAY_SCANED.contains(ct)) continue;
                                PAY_SCANED.add(ct);
                                if (PAY_SCANED.size() > 300) PAY_SCANED.clear();
                            }
                            double amt = payAmountOf(ct2);
                            if (amt <= 0) continue;
                            if (tk != null && tk.equals("weixin")) { /* 服务通知，保留 */ }
                            log("PAYSCAN|hit tk=" + tk + " ct=" + ct + " amt=" + amt);
                            if (System.currentTimeMillis() - ct > 3600000L) continue;  // 超过1小时的历史不补发
                            payUpload(amt, ct2);
                        }
                        try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                        if (maxCt > last) last = maxCt + 1;
                    } catch (Throwable t) {
                        log("PAYSCAN|err " + t);
                    }
                }
            }
        }, "wxh-payscan").start();
        log("PAYSCAN|started");
    }

    // ==================== 支付到账上报（卡密自动发货） ====================
    private static long payLastAt = 0L;
    private static final java.util.ArrayList<String> PAY_SEEN = new java.util.ArrayList<String>();

    /** 从微信支付到账里解析金额，解析不到返回 -1 */
    static double payAmountOf(String content) {
        if (content == null || content.length() == 0) return -1;
        // 1) 纯文本样式："微信支付收款 15.00 元"
        java.util.regex.Matcher m = java.util.regex.Pattern
                .compile("(?:收款到账|收款|到账|收入|转账|向你付款|已收款)[^0-9]{0,12}([0-9]+(?:\\.[0-9]{1,2})?)\\s*元?")
                .matcher(content);
        if (m.find()) return Double.parseDouble(m.group(1));
        // 2) XML 里的 <paysubtype>1</paysubtype> + <totalfee>1500</totalfee>（单位分）
        if (content.indexOf("<totalfee>") >= 0) {
            try {
                String fee = tagOf(content, "totalfee");
                if (fee != null && fee.length() > 0) {
                    int sub = 1;
                    String sb = tagOf(content, "paysubtype");
                    if (sb != null && sb.length() > 0) sub = Integer.parseInt(sb.trim());
                    double v = Double.parseDouble(fee.trim()) / 100.0;
                    // paysubtype 1 = 收款；其他类型（付款/退款）不上报
                    if (sub == 1) return v;
                }
            } catch (Throwable ignore) { }
        }
        // 3) appmsg 标题 / 描述里的 "收款到账 15.00 元"
        for (String tag : new String[]{"title", "des", "digest"}) {
            String ttl = cleanXmlText(tagOf(content, tag));
            if (ttl != null && ttl.length() > 0) {
                java.util.regex.Matcher m2 = java.util.regex.Pattern
                        .compile("([0-9]+(?:\\.[0-9]{1,2})?)\\s*元").matcher(ttl);
                if (m2.find()) return Double.parseDouble(m2.group(1));
            }
        }
        // 4) 全文里的 ¥ / ￥ 金额（仅在有收款语义时，避免误抓）
        if (content.contains("收款") || content.contains("到账") || content.contains("已收钱")) {
            java.util.regex.Matcher m3 = java.util.regex.Pattern
                    .compile("[\u00a5\uffe5]\\s*([0-9]+(?:\\.[0-9]{1,2})?)").matcher(content);
            if (m3.find()) return Double.parseDouble(m3.group(1));
        }
        return -1;
    }

    /** 判断是不是「到账」类消息。返回金额，不是则 -1 */
    static double payHitAmount(String talker, Integer type, Integer isSend, String content) {
        if (isSend != null && isSend.intValue() != 0) return -1;   // 只处理收到的
        if (content == null || content.length() == 0) return -1;
        boolean payChannel = (talker != null && (talker.equals("weixin") || talker.startsWith("gh_") ));
        boolean xmlPay = content.indexOf("<totalfee>") >= 0
                && (content.indexOf("paysubtype") >= 0 || content.indexOf("<appmsg>") >= 0);
        boolean txtPay = content.indexOf("微信支付收款") >= 0 || content.indexOf("收款到账") >= 0;
        if (!payChannel && !xmlPay && !txtPay) return -1;
        double v = payAmountOf(content);
        if (v <= 0) {
            if (content.indexOf("\u6536\u6b3e") >= 0 || content.indexOf("\u5230\u8d26") >= 0
                    || content.indexOf("\u5fae\u4fe1\u652f\u4ed8") >= 0) {
                log("PAY|nomatch tk=" + talker + " len=" + content.length()
                        + " head=" + content.substring(0, Math.min(300, content.length())).replace('\n', ' '));
            }
            return -1;
        }
        log("PAY|hit talker=" + talker + " amt=" + v + " type=" + type);
        return v;
    }

    /** 上报到服务器（子线程），不阻塞微信 */
    static void payUpload(final double amount, final String raw) {
        String base = cfg().optString("payServer", wxh.License.SERVER);
        if (base.endsWith("/")) base = base.substring(0, base.length() - 1);
        final String url = base + "/api/payhook";
        final long ts = System.currentTimeMillis() / 1000L;
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    String sec = wxh.License.SECRET;
                    String amtStr = String.format(java.util.Locale.US, "%.2f", amount);
                    String dev = "";
                    try { dev = wxh.License.deviceId(); } catch (Throwable ignore) { }
                    if (dev == null) dev = "";
                    // 新协议：签名绑定设备码，服务端会校验该设备是否绑着有效卡密
                    String sig = hmacSha256Hex(sec, amtStr + "|" + ts + "|" + dev);
                    org.json.JSONObject body = new org.json.JSONObject();
                    body.put("amount", amount);
                    body.put("ts", ts);
                    body.put("sign", sig);
                    body.put("device", dev);
                    body.put("raw", raw.length() > 1500 ? raw.substring(0, 1500) : raw);
                    java.net.HttpURLConnection c =
                            (java.net.HttpURLConnection) new java.net.URL(url).openConnection();
                    c.setRequestMethod("POST");
                    c.setConnectTimeout(10000);
                    c.setReadTimeout(15000);
                    c.setDoOutput(true);
                    c.setRequestProperty("Content-Type", "application/json; charset=utf-8");
                    java.io.OutputStream os = c.getOutputStream();
                    os.write(body.toString().getBytes("UTF-8"));
                    os.close();
                    int code = c.getResponseCode();
                    java.io.InputStream is = code >= 400 ? c.getErrorStream() : c.getInputStream();
                    if (is == null) { log("PAY|up http=" + code); return; }
                    java.io.ByteArrayOutputStream bo = new java.io.ByteArrayOutputStream();
                    byte[] buf = new byte[2048];
                    int n;
                    while ((n = is.read(buf)) > 0) bo.write(buf, 0, n);
                    is.close();
                    log("PAY|up http=" + code + " resp=" + bo.toString("UTF-8"));
                } catch (Throwable t) {
                    log("PAY|up err " + t);
                }
            }
        }, "wxh-pay").start();
    }

    static String hmacSha256Hex(String key, String data) throws Exception {
        javax.crypto.Mac mac = javax.crypto.Mac.getInstance("HmacSHA256");
        mac.init(new javax.crypto.spec.SecretKeySpec(key.getBytes("UTF-8"), "HmacSHA256"));
        byte[] d = mac.doFinal(data.getBytes("UTF-8"));
        StringBuilder sb = new StringBuilder();
        for (byte b : d) sb.append(String.format("%02x", b));
        return sb.toString();
    }

    /** 消息钩子里调用：命中则上报（去重） */
    static void payMaybe(String talker, Integer type, Integer isSend, String content) {
        try {
            if (!cfg().optBoolean("payHook", true)) return;
            double amt = payHitAmount(talker, type, isSend, content);
            if (amt <= 0) return;
            long now = System.currentTimeMillis();
            if (now - payLastAt < 800L) { log("PAY|skip dup-window"); return; }
            payLastAt = now;
            String key = String.format(java.util.Locale.US, "%.2f|", amt)
                    + (content == null ? "" : content.substring(0, Math.min(80, content.length())));
            synchronized (PAY_SEEN) {
                if (PAY_SEEN.contains(key)) { log("PAY|skip seen"); return; }
                PAY_SEEN.add(key);
                if (PAY_SEEN.size() > 40) PAY_SEEN.remove(0);
            }
            payUpload(amt, content == null ? "" : content);
        } catch (Throwable t) {
            log("PAY|maybe err " + t);
        }
    }


    /** 设置里点「支付上报自检」：解析测试串 + 可选真实上报 0.01 元用于联调 */
    static void paySelfTest(final android.app.Activity a) {
        try {
            String demo = "微信支付\n收款到账 15.00 元\n付款方备注:30165029";
            double v = payAmountOf(demo);
