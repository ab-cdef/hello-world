    private static void openByRecord(final android.app.Activity a, String ftk,
                                     org.json.JSONObject o0, String ftx) {
        try {
            String id = ftk;
            if (id == null || id.length() == 0) {
                String nm = "";
                try { nm = o0.optString("talker", ""); } catch (Throwable t3) { }
                id = wxidByName(nm);
                if (id == null || id.length() == 0) {
                    android.content.ClipboardManager cm2 = (android.content.ClipboardManager)
                            a.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
                    cm2.setPrimaryClip(android.content.ClipData.newPlainText("wxh", ftx));
                    toast("旧记录没有会话 id（已复制信息）");
                    return;
                }
            }
            zOpenChat(a, id);
        } catch (Throwable t) { toast("跳转失败"); }
    }


    /* ================= 长按文件消息 → 存文件 ================= */

    private static String briefOf(String s) {
        if (s == null) return "null";
        String t = s.replace("\n", " ");
        return t.length() > 300 ? t.substring(0, 300) : t;
    }





    private static long rowTsOf(android.view.View a) {
        try {
            if (a == null) return 0;
            android.view.View r = rowOf(a);
            if (r == null) r = a;
            Object t = r.getTag(0x0f0f0f06);
            if (t instanceof Long) return (Long) t;
            if (t instanceof Integer) return ((Integer) t).longValue();
        } catch (Throwable ignore) { }
        return 0;
    }

    private static String fileNameOf(String content) {
        if (content == null) return null;
        String t = cleanXmlText(tagOf(content, "title"));
        if (t == null || t.length() == 0) t = cleanXmlText(tagOf(content, "filename"));
        if (t == null || t.length() == 0) {
            String c = content.trim();
            if (isFileName(c)) t = c;
        }
        if (t == null || t.length() == 0) return null;
        return t.trim();
    }

    private static boolean isFileName(String t) {
        if (t == null) return false;
        String u = t.trim().toLowerCase();
        if (u.length() < 5 || u.length() > 120) return false;
        return u.matches(".*\\.(pdf|doc|docx|xls|xlsx|ppt|pptx|txt|rar|zip|7z|apk|csv|mp3|mp4|wps|ofd|et|dps)$");
    }

    /** 从被长按的那一行里找带扩展名的文字当文件名 */
    private static String fileNameFromRow(android.view.View anchor) {
        try {
            if (anchor == null) return null;
            android.view.View row = rowOf(anchor);
            if (row == null) row = anchor;
            java.util.List<android.view.View> all = new java.util.ArrayList<android.view.View>();
            collectViews(row, all, 0);
            String best = null;
            for (android.view.View v : all) {
                if (!(v instanceof android.widget.TextView)) continue;
                CharSequence cs = ((android.widget.TextView) v).getText();
                if (cs == null) continue;
                String t = cs.toString();
                if (isFileName(t) && (best == null || t.length() > best.length())) best = t.trim();
            }
            if (best != null) log("GRPSAVE|from row text " + best);
            return best;
        } catch (Throwable t) { log("GRPSAVE|row scan err " + t); }
        return null;
    }

    private static void saveFileOfPressed(final android.app.Activity a) {
        try {
            if (a == null) { toast("没有界面"); return; }
            long ts = lastLongPressTs;
            if (ts <= 0) ts = rowTsOf(lastLongPressView == null ? null : lastLongPressView.get());
            if (ts <= 0) ts = rowTsOf(menuAnchorView);
            if (ts <= 0) ts = System.currentTimeMillis();
            android.view.View anchor = lastLongPressView == null ? null : lastLongPressView.get();
            if (anchor == null) anchor = menuAnchorView;
            log("GRPSAVE|anchor=" + (anchor == null ? "null" : anchor.getClass().getSimpleName()));
            String content = textByAdapter(anchor);
            log("GRPSAVE|adapter=" + briefOf(content));
            String title = fileNameOf(content);
            if (title == null) title = fileNameFromRow(anchor);
            if (title == null) {
                // 跨会话按时间戳找（完全不依赖 talker 定位）
                final Object h = msgDbHandle();
                if (h == null) { toast("数据库未就绪"); return; }
                boolean ms = ts > 100000000000L;
                long base = ms ? ts : ts / 1000L;
                Object cur = h.getClass().getMethod("B", String.class, String[].class)
                        .invoke(h, "select talker, content from message where createTime between "
                                + (base - 8) + " and " + (base + 8)
                                + " order by abs(createTime-" + base + ") asc limit 40", new String[0]);
                if (cur != null) {
                    java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
                    java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
                    while ((Boolean) mv.invoke(cur)) {
                        String c2 = (String) gs.invoke(cur, 1);
                        String t2 = fileNameOf(c2);
                        log("GRPSAVE|db " + gs.invoke(cur, 0) + " -> " + t2 + " | " + briefOf(c2));
                        if (t2 != null && t2.length() > 2) { title = t2; break; }
                    }
                    try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
                }
            }
            if (title == null || title.length() == 0) { toast("这条不是文件消息"); return; }
            log("GRPSAVE|pressed " + title);
            saveGroupFile(a, title);
        } catch (Throwable t) {
            log("GRPSAVE|pressed err " + t);
            toast("存文件失败");
        }
    }


    /** 触发微信下载：点一下长按的那条消息（打开文件 → 触发下载） */

    /** 把窗口设成全透明（用户看不到），用于存文件时压掉微信的文件预览页 */
    private static void hideWindow(android.app.Activity a) {
        try {
            android.view.Window w = a.getWindow();
            if (w == null) return;
            android.view.WindowManager.LayoutParams lp = w.getAttributes();
            lp.alpha = 0f;
            lp.dimAmount = 0f;
            w.setAttributes(lp);
        } catch (Throwable t) { log("GRPSAVE|hide err " + t); }
    }

    private static void triggerPressedOpen() {
        try {
            android.view.View v = lastLongPressView == null ? null : lastLongPressView.get();
            if (v == null) { log("GRPSAVE|no pressed view"); return; }
            android.view.View cur = v;
            for (int i = 0; i < 6; i++) {
                if (cur == null) break;
                if (cur.isClickable()) {
                    final android.view.View fv = cur;
                    final android.app.Activity chatA = (chatAct != null ? chatAct : lastAct);
                    fv.post(new Runnable() {
                        @Override public void run() {
                            try {
                                fv.performClick();
                                log("GRPSAVE|click to download " + fv.getClass().getSimpleName());
                                // 打开文件查看器后自动关闭，回到聊天（下载在后台继续）
                                for (long dl : new long[]{600L, 1200L}) {
                                    fv.postDelayed(new Runnable() {
                                        @Override public void run() {
                                            try {
                                                android.app.Activity t0 = topAct;
                                                if (t0 != null && chatA != null && t0 != chatA) {
                                                    String cn = t0.getClass().getName();
                                                    if (!cn.endsWith(".LauncherUI")) {
                                                        t0.finish();
                                                        log("GRPSAVE|auto close " + cn);
                                                    }
                                                }
                                            } catch (Throwable t) { }
                                        }
                                    }, dl);
                                }
                            } catch (Throwable t) { log("GRPSAVE|click err " + t); }
                        }
                    });
                    return;
                }
                if (!(cur.getParent() instanceof android.view.View)) break;
                cur = (android.view.View) cur.getParent();
            }
            log("GRPSAVE|no clickable ancestor");
        } catch (Throwable t) { log("GRPSAVE|trigger err " + t); }
    }

    private static void saveGroupFile(final android.app.Activity a, final String name) {
        if (name == null || name.length() == 0) { toast("文件名为空"); return; }
        toast("正在查找文件…");
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    java.io.File dataDir = new java.io.File(mmBase() + "/MicroMsg");
                    java.io.File found = findInAttach(dataDir, name);
                    if (found == null) found = findFile(dataDir, name, 0, new int[]{0});
                    if (found == null) {
                        // 未下载：先触发微信下载，再轮询等待文件落地（最多 40 秒）
                        log("GRPSAVE|notfound, trigger download " + name);
                        savingFile = true;
                        a.runOnUiThread(new Runnable() {
                            @Override public void run() {
                                toast("未下载，正在后台下载…");
                                triggerPressedOpen();
                            }
                        });
                        long deadline = System.currentTimeMillis() + 45000L;
                        while (System.currentTimeMillis() < deadline && found == null) {
                            try { Thread.sleep(600); } catch (Throwable ignore) { }
                            found = findInAttach(dataDir, name);
                            if (found == null) found = findFile(dataDir, name, 0, new int[]{0});
                        }
                        savingFile = false;
                        final android.app.Activity vw = saverViewer;
                        saverViewer = null;
                        a.runOnUiThread(new Runnable() {
                            @Override public void run() {
                                try { if (vw != null) { vw.finish(); log("GRPSAVE|viewer closed"); } } catch (Throwable t) { }
                            }
                        });
                    }
                    if (found == null) {
                        a.runOnUiThread(new Runnable() {
                            @Override public void run() {
                                toast("文件未下载成功（可能已过期或需要手动点开）");
                            }
                        });
                        log("GRPSAVE|notfound " + name);
                        return;
                    }
                    java.io.File dir = new java.io.File(android.os.Environment.getExternalStorageDirectory(),
                            "Download/wxh/files");
                    dir.mkdirs();
                    java.io.File out = new java.io.File(dir, name);
                    if (out.exists()) out = new java.io.File(dir,
                            System.currentTimeMillis() % 100000 + "_" + name);
                    java.io.FileInputStream in = new java.io.FileInputStream(found);
                    java.io.FileOutputStream fos = new java.io.FileOutputStream(out);
                    byte[] buf = new byte[8192];
                    int r;
                    while ((r = in.read(buf)) > 0) fos.write(buf, 0, r);
                    fos.close();
                    in.close();
                    final String path = out.getAbsolutePath();
                    log("GRPSAVE|ok " + path + " from " + found.getAbsolutePath());
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() {
                            new android.app.AlertDialog.Builder(a)
                                    .setTitle("已保存")
                                    .setMessage(path)
                                    .setPositiveButton("好", null).show();
                        }
                    });
                } catch (Throwable t) {
                    savingFile = false;
                    saverViewer = null;
                    log("GRPSAVE|err " + t);
                    a.runOnUiThread(new Runnable() {
                        @Override public void run() { toast("保存失败：" + "见日志"); }
                    });
                } finally {
                    savingFile = false;
                }
            }
        }).start();
    }


    /** 微信 8.0.80 已下载文件在 MicroMsg/<hash>/attachment/ 下，名字可能带 "1_" 前缀 */
    private static java.io.File findInAttach(java.io.File microMsg, String name) {
        try {
            java.io.File[] hs = microMsg.listFiles();
            if (hs == null) return null;
            for (java.io.File h : hs) {
                if (!h.isDirectory()) continue;
                java.io.File att = new java.io.File(h, "attachment");
                if (!att.isDirectory()) continue;
                java.io.File[] fs = att.listFiles();
                if (fs == null) continue;
                for (java.io.File f : fs) {
                    if (!f.isFile()) continue;
                    String fn = f.getName();
                    if (fn.equals(name) || fn.endsWith(name)) return f;
                    // 去掉 "1_" 这类前缀再比一次
                    String bare = fn.replaceFirst("^[0-9]{1,3}_", "");
                    if (bare.equals(name) || bare.endsWith(name)) return f;
                    // 行文字被省略号截断时按前缀匹配
                    int dots = name.indexOf("...");
                    if (dots > 4) {
                        String key = name.substring(0, dots);
                        if (bare.startsWith(key) || fn.endsWith(key)) return f;
                    }
                }
            }
        } catch (Throwable t) { log("GRPSAVE|attach scan err " + t); }
        return null;
    }

    /** 在 MicroMsg 里按文件名递归查找（限深度、限文件数） */
    private static java.io.File findFile(java.io.File dir, String name, int depth, int[] budget) {
        if (dir == null || budget[0] > 20000 || depth > 7) return null;
        java.io.File[] fs = dir.listFiles();
        if (fs == null) return null;
        for (java.io.File f : fs) {
            budget[0]++;
            if (budget[0] > 20000) return null;
            if (f.isDirectory()) {
                java.io.File r = findFile(f, name, depth + 1, budget);
                if (r != null) return r;
            } else if (name.equals(f.getName()) || f.getName().endsWith(name)) {
                return f;
            }
        }
        return null;
    }

    private static void showGroupFiles(final android.app.Activity a) {
        try {
