    /** 每人近 7 天 / 近 30 天发言数 + 趋势，导出 CSV */
    private static int buildMemberTrend(String talker) {
        int out = 0;
        try {
            long now = System.currentTimeMillis();
            long s7 = now - 7L * 86400000L;
            long s30 = now - 30L * 86400000L;
            java.util.LinkedHashMap<String, int[]> m = new java.util.LinkedHashMap<String, int[]>();
            java.util.LinkedHashMap<String, Long> last = new java.util.LinkedHashMap<String, Long>();
            java.util.List<Object[]> rows = queryRows(
                    "select ifnull(content,''), createTime, ifnull(isSend,0) from message where talker='"
                            + escSql(talker) + "' and createTime > " + s30
                            + " order by createTime desc limit 5000", 3);
            for (Object[] r : rows) {
                String c = String.valueOf(r[0]);
                long ct = 0;
                try { ct = Long.parseLong(String.valueOf(r[1]).trim()); } catch (Throwable ignore) { }
                if (ct > 0 && ct < 100000000000L) ct *= 1000L;
                boolean mine = "1".equals(String.valueOf(r[2]).trim());
                String sid = mine ? "__me__" : senderIdOfGroupMsg(c);
                if (sid == null || sid.length() == 0) continue;
                int[] v = m.get(sid);
                if (v == null) { v = new int[]{0, 0}; m.put(sid, v); }
                v[0]++;                                   // 30 天
                if (ct > s7) v[1]++;                      // 7 天
                if (!last.containsKey(sid)) last.put(sid, Long.valueOf(ct));
            }
            java.util.List<Object[]> out2 = new java.util.ArrayList<Object[]>();
            for (String sid : m.keySet()) {
                int[] v = m.get(sid);
                double expect = v[0] * 7.0 / 30.0;
                String trend;
                int chg = 0;
                if (v[0] < 5) trend = "样本少";
                else if (v[1] > expect * 1.3) { trend = "升温"; chg = (int) Math.round((v[1] / Math.max(expect, 1) - 1) * 100); }
                else if (v[1] < expect * 0.6) { trend = "降温"; chg = -(int) Math.round((1 - v[1] / Math.max(expect, 1)) * 100); }
                else trend = "平稳";
                String nm = "__me__".equals(sid) ? "我" : displayOfTalker(sid);
                out2.add(new Object[]{nm, sid, Integer.valueOf(v[0]), Integer.valueOf(v[1]), trend, Integer.valueOf(chg),
                        last.get(sid)});
            }
            java.util.Collections.sort(out2, new java.util.Comparator<Object[]>() {
                @Override public int compare(Object[] a, Object[] b) {
                    return ((Integer) b[2]) - ((Integer) a[2]);
                }
            });
            java.io.File dir = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory().getAbsolutePath(), "Download/wxh");
            if (!dir.exists()) dir.mkdirs();
            String stamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmm", java.util.Locale.US)
                    .format(new java.util.Date());
            java.io.File f = new java.io.File(dir, "member_trend_" + csv(displayOfTalker(talker)) + "_" + stamp + ".csv");
            java.io.FileWriter fw = new java.io.FileWriter(f, false);
            fw.write("\uFEFF排名,成员,微信号,近30天,近7天,趋势,变化%,最后发言\n");
            int rank = 0;
            for (Object[] r : out2) {
                rank++;
                long lt = r[6] == null ? 0 : ((Long) r[6]).longValue();
                fw.write(rank + "," + csv((String) r[0]) + "," + csv((String) r[1]) + ","
                        + r[2] + "," + r[3] + "," + r[4] + ","
                        + (((Integer) r[5]).intValue() > 0 ? "+" : "")
                        + r[5] + ","
                        + (lt <= 0 ? "" : new java.text.SimpleDateFormat("MM-dd HH:mm", java.util.Locale.US)
                                .format(new java.util.Date(lt))) + "\n");
            }
            fw.close();
            out = out2.size();
            askShare(f);
            log("MTREND2|talker=" + talker + " n=" + out + " path=" + f.getAbsolutePath());
        } catch (Throwable t) {
            log("MTREND2|err " + t);
        }
        return out;
    }

