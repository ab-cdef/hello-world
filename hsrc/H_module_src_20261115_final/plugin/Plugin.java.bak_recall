        } catch (Throwable t) { log("toggleFold err " + t); }
    }


    /** iOS 风格开关：开=蜘蛛红，关=浅灰，带 160ms 滑动过渡 */
    static class HToggle extends android.view.View {
        private final android.graphics.Paint trackPaint = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
        private final android.graphics.Paint knobPaint = new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
        private final android.graphics.RectF rf = new android.graphics.RectF();
        private float pos;
        private boolean on;

        HToggle(android.content.Context c, boolean isOn) {
            super(c);
            on = isOn;
            pos = isOn ? 1f : 0f;
            knobPaint.setColor(0xFFFFFFFF);
        }

        void setOnState(boolean v) {
            if (on == v) return;
            on = v;
            animateTo(v ? 1f : 0f);
        }

        private float dp(float v) {
            return v * getResources().getDisplayMetrics().density;
        }

        private void animateTo(final float to) {
            try {
                android.animation.ValueAnimator va = android.animation.ValueAnimator.ofFloat(pos, to);
                va.setDuration(160);
                va.addUpdateListener(new android.animation.ValueAnimator.AnimatorUpdateListener() {
                    @Override public void onAnimationUpdate(android.animation.ValueAnimator an) {
                        pos = ((Float) an.getAnimatedValue()).floatValue();
                        invalidate();
                    }
                });
                va.start();
            } catch (Throwable t) {
                pos = to;
                invalidate();
            }
        }

        @Override protected void onMeasure(int wSpec, int hSpec) {
            setMeasuredDimension((int) dp(46), (int) dp(26));
        }

        @Override protected void onDraw(android.graphics.Canvas c) {
            float w = getWidth(), h = getHeight();
            float rad = h / 2f;
            // 轨道颜色：关 0xFFE5E5E5 -> 开 0xFF07C160
            int off = 0xFFE5E5E5, onC = 0xFF07C160;
            int r0 = (off >> 16) & 0xFF, g0 = (off >> 8) & 0xFF, b0 = off & 0xFF;
            int r1 = (onC >> 16) & 0xFF, g1 = (onC >> 8) & 0xFF, b1 = onC & 0xFF;
            int col = 0xFF000000 | ((int) (r0 + (r1 - r0) * pos) << 16)
                    | ((int) (g0 + (g1 - g0) * pos) << 8) | (int) (b0 + (b1 - b0) * pos);
            trackPaint.setColor(col);
            rf.set(0, 0, w, h);
            c.drawRoundRect(rf, rad, rad, trackPaint);
            float pad = dp(3);
            float kr = rad - pad;
            float cx = pad + kr + (w - 2f * (pad + kr)) * pos;
            c.drawCircle(cx, h / 2f, kr, knobPaint);
        }
    }

    /** 圆圈指示：选中红色实心，未选绿色实心 */
    private static android.widget.FrameLayout makeRing(android.content.Context c, boolean filled) {
        android.widget.FrameLayout ring = new android.widget.FrameLayout(c);
        android.graphics.drawable.GradientDrawable rg = new android.graphics.drawable.GradientDrawable();
        rg.setShape(android.graphics.drawable.GradientDrawable.OVAL);
        rg.setColor(filled ? 0xFF07C160 : 0xFF2E9E5B);
        ring.setBackground(rg);
        return ring;
    }

    private static String todayTag() {
        return new java.text.SimpleDateFormat("yyyyMMdd", java.util.Locale.US)
                .format(new java.util.Date());
    }

    private static boolean actionDoneToday(String key) {
        try {
            org.json.JSONObject o = cfg().optJSONObject("actDone");
            if (o == null) return false;
            return todayTag().equals(o.optString(key, ""));
        } catch (Throwable t) { return false; }
    }

    private static void markActionDone(String key) {
        try {
            org.json.JSONObject o = readCfg();
            org.json.JSONObject d = o.optJSONObject("actDone");
            if (d == null) d = new org.json.JSONObject();
            d.put(key, todayTag());
            o.put("actDone", d);
            writeCfg(o);
            cfg = null;
            cfgAt = 0;
        } catch (Throwable t) { }
    }

    private static int dp(android.content.Context c, int v) {
        return (int) (v * c.getResources().getDisplayMetrics().density + 0.5f);
    }

    private static android.view.View findConvListView(android.view.View v, int depth) {
        if (depth > 16) return null;
        if (v.getClass().getSimpleName().contains("ConversationListView")) return v;
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View r = findConvListView(g.getChildAt(i), depth + 1);
                if (r != null) return r;
            }
        }
        return null;
    }
    // ================= 恢复块（误删后补回） =================
    private static volatile String pendingTalker;
    private static float lpX;
    private static float lpY;
    private static long lpDownMs;
    private static volatile boolean fakeLike;
    private static volatile long fakeBlockUntil = 0;
    private static volatile long fakeMissAt = 0;
