                                        h.getClass().getMethod("execSQL", String.class)
                                                .invoke(h, "update rconversation set unReadCount=0 where username='"
                                                        + tk0.replace("'", "''") + "'");
                                        log("AUTOREAD|" + tk0);
                                    } catch (Throwable t) { log("AUTOREAD|err " + t); }
                                }
                            }, 700L);
                        }
                    } catch (Throwable ignore) { }
                    todayTv = null;
                    log("chat state on talker=" + chatTalker);
                    // 聊天状态确定后再启动行样式循环（Activity 恢复时 inChat 可能还没置真）
                    try {
                        android.app.Activity ca9 = chatAct != null ? chatAct : lastAct;
                        if (ca9 != null) ensureChatStyleLoop(ca9);
                    } catch (Throwable ignore) { }
                    try { hideTintWindow(); } catch (Throwable ignore) { }
                    try { probeChatFooter(appCl); } catch (Throwable ignore) { }
                    try {
                        final android.app.Activity ca6 = chatAct;
                        if (ca6 != null) {
                            final android.os.Handler h6 = new android.os.Handler(android.os.Looper.getMainLooper());
                            h6.postDelayed(new Runnable() {
                                int n = 0;
                                @Override public void run() {
                                    try {
                                        if (isInChatUi()) {
                                            // 视图被回收/切会话后可能出现「循环还在跑但工具栏没了」，这里兜底重挂
                                            try {
                                                boolean lost = todayTv == null
                                                        || todayTv.getParent() == null;
                                                if (todayLoopOn
                                                        && System.currentTimeMillis() - todayAttachedAt > 3000
                                                        && lost) {
                                                    todayLoopOn = false;
                                                    log("TODAY|re-attach (view gone)");
                                                }
                                            } catch (Throwable ignore) { }
                                            if (!todayLoopOn && cfg().optBoolean("todayCount", false)) {
                                                try { startTodayCount(ca6); } catch (Throwable ignore) { }
                                            }
                                            // 性能：行样式/时间统一交给 ensureChatStyleLoop(600ms, 带变更检测)，
                                            // 这里只留「一次就够」的工作，避免每 400ms 重复全树遍历 + DB 查询
                                            if (n < 3) {
                                                try { attachRowListener(ca6); } catch (Throwable ignore) { }
                                                try { applyInputHint(); } catch (Throwable ignore) { }
                                                try { attachFooterLongPress(ca6); } catch (Throwable ignore) { }
                                                try { diagImgDb(msgDbHandle()); } catch (Throwable ignore) { }
                                                try { prefetchHistory(chatTalker); } catch (Throwable ignore) { }
                                                try { diagEmojiOnce(); } catch (Throwable ignore) { }
                                                try { diagEmojiInfo(); } catch (Throwable ignore) { }
                                            }
                                        }
                                    } catch (Throwable ignore) { }
                                    n++;
                                    // 保持 250ms 轻量刷新（只遍历可见行），新消息时间无延迟
                                    if (n < 1200 && chatAct == ca6) h6.postDelayed(this, 1400);
                                }
                            }, 400);
                        }
                    } catch (Throwable ignore) { }

                    try {
                        final android.app.Activity ca1 = chatAct;
                        if (ca1 != null) {

                            if (cfg().optBoolean("bubbleDebug", false)) {
                                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                    @Override public void run() { dumpChatRows(ca1); }
                                }, 2200);
                            }
                        }
                    } catch (Throwable ignore) { }
                    try {
                        final android.app.Activity ca0 = chatAct;
                        if (ca0 != null) {
                            final android.os.Handler bh = new android.os.Handler(android.os.Looper.getMainLooper());
                            bh.postDelayed(new Runnable() {
                                @Override public void run() {
                                    try { themeBubblesTick(ca0); } catch (Throwable ignore) { }
                                    try { applyChatFloat(ca0); } catch (Throwable ignore) { }
                                }
                            }, 1200);
                        }
                    } catch (Throwable ignore) { }
                    if (chatAct != null) {
                        try { claimExistingPackets(chatAct); } catch (Throwable ignore) { }
                        try { probeConvColumns(); } catch (Throwable ignore) { }
                        try { if (!selfTestDone) { selfTestDone = true; selfTestPanels(); } } catch (Throwable ignore) { }
                        try { maybeFlagTest(); } catch (Throwable ignore) { }
                        try { maybeOpenBatch(chatAct); } catch (Throwable ignore) { }
                        try { if (!selfTestDone) { selfTestDone = true; selfTestPanels(); } } catch (Throwable ignore) { }
                        try { maybeZombieProbe(); } catch (Throwable ignore) { }
                        try {
                            long nowBg = System.currentTimeMillis();
                            if (nowBg - bgScanAt > 90000L) { bgScanAt = nowBg; bgGrabScanWhenReady(); }
                        } catch (Throwable ignore) { }
                        if (false) {   // 旧的时间循环已废弃，改用 msgTimeEnh
                            new Thread(new Runnable() {
                                @Override
                                public void run() {
                                    loadChatTimes(chatTalker);
                                }
                            }).start();
                            startTimeLoop2(chatAct);
                        }
                        // 气泡只走 setBackgroundDrawable 精确替换，不轮询
                        boolean tcOn = cfg().optBoolean("todayCount", false);
                        log("TODAY|gate todayCount=" + tcOn);
                        if (tcOn) startTodayCount(chatAct);
                    }
                }
            });
            XposedBridge.hookAllMethods(f, "onPause", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    inChat = false;
                    log("chat state off");
                    try {
                        final android.app.Activity ca = chatAct;
                        if (ca != null && ca.getClass().getName().contains("LauncherUI")) {
                            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(new Runnable() {
                                @Override public void run() {
                                    try {
                                        if (topAct == ca) { showTintWindow(ca); log("TINTWIN|restore after chat"); }
                                        else log("TINTWIN|skip restore, top!=chatAct");
                                    } catch (Throwable ignore) { }
                                }
                            }, 120L);
                        }
                    } catch (Throwable ignore) { }
                }
            });
            log("hooked ChattingUIFragment state");
        } catch (Throwable t) {
            log("chat state err " + t);
        }
    }

    private static void installChatDispatch(ClassLoader app) {
        try {
            Class<?> c = Class.forName("android.app.Activity", false, app);
            final long[] last = {0};
            XposedBridge.hookAllMethods(c, "dispatchTouchEvent", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        Object self = p.thisObject;
                        if (!(self instanceof android.app.Activity)) return;
                        Object e = p.args[0];
                        if (!(e instanceof android.view.MotionEvent)) return;
                        android.view.MotionEvent ev = (android.view.MotionEvent) e;
                        // 长按改文字已改走消息菜单「改字」，此处移除（会误抓 contentDescription）
                        if (!cfg().optBoolean("chatDoubleTap", true)) return;
                        if (!inChat) return;
                        if (ev.getAction() == android.view.MotionEvent.ACTION_DOWN && ev.getY() < 260) {
                            long now = System.currentTimeMillis();
                            if (now - last[0] < 320) {
                                Object act = p.thisObject;
                                if (act instanceof android.app.Activity) {
                                    Object rv = findRecycler(((android.app.Activity) act).getWindow().getDecorView());
                                    if (rv != null) {
                                        rv.getClass().getMethod("scrollToPosition", int.class).invoke(rv, 0);
                                        log("CHAT|double tap scroll top");
                                        last[0] = 0;
                                        return;
                                    }
                                }
                            }
                            last[0] = now;
                        }
                    } catch (Throwable t) {
                    }
                }
            });
            log("hooked Activity.dispatchTouchEvent (chat)");
        } catch (Throwable t) {
            log("chat dispatch err " + t);
        }
    }

    private static volatile boolean inSns = false;

    private static boolean hasAdLabel(View v) {
        try {
            if (v instanceof android.widget.TextView) {
                CharSequence t = ((android.widget.TextView) v).getText();
                if (t != null) {
                    String s2 = t.toString().trim();
                    if (s2.equals("广告") || s2.equals("廣告") || s2.equalsIgnoreCase("ad")) return true;
                }
            }
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    if (hasAdLabel(g.getChildAt(i))) return true;
                }
            }
        } catch (Throwable t) {
        }
        return false;
    }

    /* ================= 探查：朋友圈 feed 项里的控件资源名 ================= */
    private static void exploreSnsFeed(final android.app.Activity a) {
        exploreSnsRetry(a, 0);
    }

    private static void exploreSnsRetry(final android.app.Activity a, final int round) {
        try {
            java.util.ArrayList<android.view.View> own = new java.util.ArrayList<android.view.View>();
            collectAllViews(a.getWindow().getDecorView(), own, 0);
            log("SNSX|round=" + round + " own=" + own.size());
            if (own.size() < 25 && round < 12) {
                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
                        new Runnable() { @Override public void run() { exploreSnsRetry(a, round + 1); } },
                        1500L);
                return;
            }
        } catch (Throwable ignore) { }
        try {
            java.util.ArrayList<android.view.View> vs = new java.util.ArrayList<android.view.View>();
            collectAllViews(a.getWindow().getDecorView(), vs, 0);

            // 朋友圈 feed 可能不在 Activity 自己的 decor 里：遍历所有窗口根，挑 ImageView 最多的
            try {
                java.util.List<android.view.View> rs3 = allRoots();
                int bestImg = -1;
                java.util.ArrayList<android.view.View> bestVs = null;
                for (android.view.View r : rs3) {
                    java.util.ArrayList<android.view.View> rv3 = new java.util.ArrayList<android.view.View>();
                    collectAllViews(r, rv3, 0);
                    int ni3 = 0;
                    for (android.view.View v3 : rv3) if (v3 instanceof android.widget.ImageView) ni3++;
                    if (ni3 > bestImg) { bestImg = ni3; bestVs = rv3; }
                }
                if (bestVs != null && bestImg > 1) {
                    vs = bestVs;
                    log("SNSX|picked root with " + bestImg + " images");
                }
            } catch (Throwable ignore) { }
            log("SNSX|total=" + vs.size());
            StringBuilder tree = new StringBuilder();
            for (android.view.View v : vs) {
                tree.append(v.getClass().getSimpleName());
                if (v instanceof android.view.ViewGroup)
                    tree.append('(').append(((android.view.ViewGroup) v).getChildCount()).append(')');
                tree.append('/');
                if (tree.length() > 600) break;
            }
            log("SNSX|tree " + tree);
            try {
                java.util.List<android.view.View> rs = allRoots();
                log("SNSX|roots=" + rs.size());
                for (android.view.View r : rs) {
                    java.util.ArrayList<android.view.View> rv = new java.util.ArrayList<android.view.View>();
                    collectAllViews(r, rv, 0);
                    log("SNSX|root " + r.getClass().getSimpleName() + " views=" + rv.size());
                }
            } catch (Throwable ignore) { }
            StringBuilder imgs = new StringBuilder();
            int ni = 0;
            java.util.HashSet<String> seen = new java.util.HashSet<String>();
            for (android.view.View v : vs) {
                if (!(v instanceof android.widget.ImageView)) continue;
                String rid = "?";
                try {
                    int id = v.getId();
                    if (id != 0) rid = v.getResources().getResourceName(id);
                } catch (Throwable ignore) { }
                String cd = "";
                try {
                    CharSequence c = v.getContentDescription();
                    if (c != null) cd = c.toString();
                } catch (Throwable ignore) { }
                String key = rid + "|" + cd;
                if (!seen.add(key)) continue;
                imgs.append(rid).append("{cd=").append(cd).append("} ");
                if (++ni >= 40) break;
            }
            log("SNSX|imgs " + imgs);
            // 再 dump 所有 TextView 的资源名 + 文本前几个字（点赞按钮可能是图标字体）
            StringBuilder tvs = new StringBuilder();
            int nt = 0;
            java.util.HashSet<String> seen2 = new java.util.HashSet<String>();
            for (android.view.View v : vs) {
                if (!(v instanceof android.widget.TextView)) continue;
                String rid = "?";
                try {
                    int id = v.getId();
                    if (id != 0) rid = v.getResources().getResourceName(id);
                } catch (Throwable ignore) { }
                if (rid.equals("?")) continue;
                if (!seen2.add(rid)) continue;
                CharSequence tx = ((android.widget.TextView) v).getText();
                String ts = tx == null ? "" : tx.toString();
                if (ts.length() > 6) ts = ts.substring(0, 6);
                tvs.append(rid).append("=\"").append(ts).append("\" ");
                if (++nt >= 30) break;
            }
            log("SNSX|tvs " + tvs);
            StringBuilder cds = new StringBuilder();
            int nc = 0;
            for (android.view.View v : vs) {
                CharSequence c = null;
                try { c = v.getContentDescription(); } catch (Throwable ignore) { }
                if (c == null || c.length() == 0) continue;
                String cs = c.toString();
                if (cs.length() > 12) continue;
                if (!seen.add("cd:" + cs)) continue;
                cds.append(cs).append('/');
                if (++nc >= 30) break;
            }
            log("SNSX|cds " + cds);
        } catch (Throwable t) { log("SNSX|err " + t); }
    }

    /** 朋友圈指定好友自动点赞 */
    private static void snsAutoLike(View item) {
        try {
            org.json.JSONArray names = cfg().optJSONArray("snsLikeNames");
            if (names == null || names.length() == 0) return;
            String txt = collectText(item);
            boolean match = false;
            for (int i = 0; i < names.length(); i++) {
                String n = names.optString(i, "");
                if (n.length() > 0 && txt.contains(n)) { match = true; break; }
            }
            if (!match) return;
            if (txt.contains("已赞")) return;
            View like = findLikeButton(item);
            if (like == null) {
                log("SNSLIKE|no button for " + names.optString(0));
                return;
            }
            boolean fake = cfg().optBoolean("fakeLike", false);
            if (fake) {
                org.json.JSONArray fn = cfg().optJSONArray("fakeLikeNames");
                if (fn != null && fn.length() > 0) {
                    boolean hit = false;
                    for (int i = 0; i < fn.length(); i++) {
                        String n = fn.optString(i, "");
                        if (n.length() > 0 && txt.contains(n)) { hit = true; break; }
                    }
                    fake = hit;
                }
            }
            if (fake) {
                // 伪赞：不点按钮 —— 不发请求，对方就不会收到"XX 赞了"，本地留一条记录
                fakeLike = false;
                try {
                    org.json.JSONArray fl = cfg().optJSONArray("fakeLiked");
                    if (fl == null) fl = new org.json.JSONArray();
                    fl.put(System.currentTimeMillis() + "|" + names.optString(0));
                    while (fl.length() > 300) {
                        org.json.JSONArray n2 = new org.json.JSONArray();
                        for (int i = 1; i < fl.length(); i++) n2.put(fl.optString(i));
                        fl = n2;
                    }
                    org.json.JSONObject o = readCfg();
                    o.put("fakeLiked", fl);
                    writeCfg(o);
                    cfg = null; cfgAt = 0;
                } catch (Throwable ignore) { }
                toast("伪赞：仅本地记录，对方无感知");
                log("SNSLIKE|fake " + names.optString(0));
                return;
            }
            like.performClick();
            log("SNSLIKE|clicked " + item.getClass().getSimpleName());
        } catch (Throwable t) {
            log("snsAutoLike err " + t);
        }
    }

    /** 打印一张卡片的控件结构：类名/id名/描述/文本/可点击，用来定位「赞」按钮 */
    private static String dumpCard(View v) {
        StringBuilder sb = new StringBuilder();
        try {
            java.util.ArrayList<View> all = new java.util.ArrayList<View>();
            collectSnsViews(v, all, 0);
            int n = 0;
            for (int i = 0; i < all.size(); i++) {
                View c = all.get(i);
                if (!c.isShown()) continue;
                sb.append(c.getClass().getSimpleName());
                try {
                    if (c.getId() != 0) {
                        String rn = c.getResources().getResourceName(c.getId());
                        sb.append('#').append(rn.substring(rn.indexOf('/') + 1));
                    }
                } catch (Throwable ignore) { }
                CharSequence cd = null;
                try { cd = c.getContentDescription(); } catch (Throwable ignore) { }
                if (cd != null && cd.length() > 0) sb.append("(cd=").append(cd).append(')');
                if (c instanceof android.widget.TextView) {
                    CharSequence t = ((android.widget.TextView) c).getText();
                    if (t != null && t.length() > 0) {
                        String ts = t.toString();
                        sb.append('"').append(ts.length() > 8 ? ts.substring(0, 8) : ts).append('"');
                    }
                }
                if (c.isClickable()) sb.append('*');
                sb.append(' ');
                if (++n >= 28 || sb.length() > 700) break;
            }
        } catch (Throwable ignore) { }
        return sb.toString();
    }

    /** 采集一张卡片里的 contentDescription / 资源名，用于诊断「赞」按钮找不到的情况 */
    private static String descsOf(View v) {
        StringBuilder sb = new StringBuilder();
        try {
            java.util.ArrayList<View> all = new java.util.ArrayList<View>();
            collectViews(v, all, 0);
            for (int i = 0; i < all.size() && sb.length() < 220; i++) {
                View c = all.get(i);
                try {
                    CharSequence cd = c.getContentDescription();
                    if (cd != null && cd.length() > 0 && cd.length() < 10) sb.append("cd:").append(cd).append(' ');
                } catch (Throwable ignore) { }
                try {
                    if (c.getId() != 0) {
                        String rn = c.getResources().getResourceName(c.getId());
                        if (rn != null) sb.append("id:").append(rn.substring(rn.indexOf('/') + 1)).append(' ');
                    }
                } catch (Throwable ignore) { }
                if (sb.length() > 200) break;
            }
        } catch (Throwable ignore) { }
        return sb.toString();
    }

    private static void collectViews(View v, java.util.List<View> out, int depth) {
        if (depth > 6 || out.size() > 40) return;
        out.add(v);
        if (v instanceof ViewGroup) {
            ViewGroup g = (ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) collectViews(g.getChildAt(i), out, depth + 1);
        }
    }

    private static View findLikeButton(View v) {
        try {
            CharSequence cd = v.getContentDescription();
            if (cd != null) {
                String cs = cd.toString();
                if (cs.equals("赞") || cs.contains("点赞")) return v;
            }
            // 新版朋友圈（ImproveSnsTimelineUI）的点赞按钮是无文字的图标，
            // 按资源名判断：id 名里含 like / praise / digg 的都算
            try {
                int rid = v.getId();
                if (rid != 0) {
                    String rn = v.getResources().getResourceName(rid);
                    if (rn != null) {
                        String low = rn.toLowerCase();
                        if (low.contains("like") || low.contains("praise") || low.contains("digg")
                                || low.contains("_zan")) return v;
                    }
                }
            } catch (Throwable ignore) { }
            if (v instanceof android.widget.TextView) {
                CharSequence t = ((android.widget.TextView) v).getText();
                if (t != null && "赞".equals(t.toString().trim())) return v;
            }
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    View r = findLikeButton(g.getChildAt(i));
                    if (r != null) return r;
                }
            }
        } catch (Throwable t) {
        }
        return null;
    }

    private static String snsKeywordHit(View v) {
        try {
            String txt = collectText(v);
            if (txt.length() == 0) return null;
            org.json.JSONArray kw = cfg().optJSONArray("snsHideKeywords");
            if (kw != null) {
                for (int i = 0; i < kw.length(); i++) {
                    String k = kw.optString(i, "");
                    if (k.length() > 0 && txt.contains(k)) return k;
                }
            }
            org.json.JSONArray names = cfg().optJSONArray("snsHideNames");
            if (names != null) {
                for (int i = 0; i < names.length(); i++) {
                    String k = names.optString(i, "");
                    if (k.length() > 0 && txt.contains(k)) return k;
                }
            }
        } catch (Throwable t) {
        }
        return null;
    }

    private static String collectText(View v) {
        StringBuilder sb = new StringBuilder();
        try {
            if (v instanceof android.widget.TextView) {
                CharSequence t = ((android.widget.TextView) v).getText();
                if (t != null) sb.append(t).append(' ');
            }
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) sb.append(collectText(g.getChildAt(i)));
            }
        } catch (Throwable t) {
        }
        return sb.toString();
    }

    private static void installSnsAdBlock(ClassLoader app) {
        if (true) return;   // 朋友圈去广告功能已删除
        try {
            Class<?> c = Class.forName("com.tencent.mm.plugin.sns.ui.SnsTimeLineUI", false, app);
            // 不再在 onPause 移除：切页面（摇一摇/朋友圈等）后悬浮球会消失
            // 进程结束时系统自动回收该窗口
            XposedBridge.hookAllMethods(c, "onResume", new XC_MethodHook() {
                @Override
                protected void afterHookedMethod(final MethodHookParam p) {
                    try {
                        if (!(p.thisObject instanceof android.app.Activity)) return;
                        final android.app.Activity a = (android.app.Activity) p.thisObject;
                        inSns = true;
                        try {
                            java.io.File xf = new java.io.File(mmBase() + "/files/wxh_vsns");
                            if (xf.isFile()) {
                                xf.delete();
                                log("SNSX|armed-run");
                                a.getWindow().getDecorView().postDelayed(new Runnable() {
                                    @Override public void run() { exploreSnsFeed(a); }
                                }, 2500L);
                            }
                        } catch (Throwable ignore) { }
                        final Handler h = new Handler(Looper.getMainLooper());
                        h.post(new Runnable() {
                            int n = 0;
                            @Override
                            public void run() {
                                try {
                                    if (!inSns || n++ > 2400) return;
                                    boolean noAd = cfg().optBoolean("snsNoAd", false)
                                            || cfg().optBoolean("snsAdOff", false);
                                    {
                                        java.util.List<Object> lists = new java.util.ArrayList<Object>();
                                        collectLists(a.getWindow().getDecorView(), lists);
                                        for (Object o : lists) {
                                            ViewGroup g = (ViewGroup) o;
                                            for (int i = 0; i < g.getChildCount(); i++) {
                                                View ch = g.getChildAt(i);
                                                if (ch.getVisibility() != View.VISIBLE) continue;
                                                if (noAd && hasAdLabel(ch)) {
                                                    ch.setVisibility(View.GONE);
                                                    log("SNSAD|hidden");
                                                    continue;
                                                }
                                                if (cfg().optBoolean("snsAutoLike", false)) snsAutoLike(ch);
                                                snsAutoFakeLike(ch);
                                                try {
                                                    org.json.JSONArray fl = cfg().optJSONArray("fakeLiked");
                                                    if (fl != null && fl.length() > 0) {
                                                        String k2 = String.valueOf(collectText(ch).hashCode());
                                                        for (int q = 0; q < fl.length(); q++) {
                                                            String one = fl.optString(q);
                        int bar = one.indexOf('|');
                        if (bar > 0) one = one.substring(0, bar);
                        if (k2.equals(one)) {
                                                                markLiked(ch);
                                                                break;
                                                            }
                                                        }
                                                    }
                                                } catch (Throwable t3) {
                                                }
                                                String bad = snsKeywordHit(ch);
                                                if (bad != null) {
                                                    ch.setVisibility(View.GONE);
                                                    log("SNSKW|hidden by " + bad);
                                                }
                                            }
                                        }
                                    }
                                    h.postDelayed(this, 400);
                                } catch (Throwable t) {
                                }
                            }
                        });
                    } catch (Throwable t) {
                        log("snsad err " + t);
                    }
                }
            });
            XposedBridge.hookAllMethods(c, "onPause", new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    inSns = false;
                }
            });
            log("hooked SnsTimeLineUI ad block");
        } catch (Throwable t) {
            log("sns ad err " + t);
        }
    }

    private static void installSnsDoubleTap(ClassLoader app) {
        try {
            Class<?> c = Class.forName("com.tencent.mm.plugin.sns.ui.SnsTimeLineUI", false, app);
            for (final Method m : c.getDeclaredMethods()) {
                if (!m.getName().equals("onResume") || m.getParameterTypes().length != 0) continue;
                log("sns found onResume");
                m.setAccessible(true);
                XposedBridge.hookMethod(m, new XC_MethodHook() {
                    @Override
                    protected void afterHookedMethod(MethodHookParam p) {
                        try {
                            if (!(p.thisObject instanceof android.app.Activity)) return;
                            final android.app.Activity a = (android.app.Activity) p.thisObject;
                            final View root = a.getWindow().getDecorView();
                            final long[] last = {0};
                            root.setOnTouchListener(new View.OnTouchListener() {
                                @Override
                                public boolean onTouch(View v, android.view.MotionEvent e) {
                                    try {
                                        if (e.getAction() == android.view.MotionEvent.ACTION_DOWN && e.getY() < 260) {
                                            long now = System.currentTimeMillis();
                                            if (now - last[0] < 320) {
                                                Object rv = findRecycler(root);
                                                if (rv != null) {
                                                    rv.getClass().getMethod("scrollToPosition", int.class).invoke(rv, 0);
                                                    log("SNS|double tap scroll top");
                                                }
                                                last[0] = 0;
                                                return true;
                                            }
                                            last[0] = now;
                                        }
                                    } catch (Throwable t) {
                                    }
                                    return false;
                                }
                            });
                            log("hooked SnsTimeLineUI.onResume (double tap)");
                        } catch (Throwable t) {
                            log("sns tap err " + t);
                        }
                    }
                });
            }
        } catch (Throwable t) {
            log("sns double tap err " + t);
        }
    }

    private static void collectLists(View v, java.util.List<Object> out) {
        try {
            String cn = v.getClass().getName();
            if (cn.contains("RecyclerView") || cn.contains("ListView")) out.add(v);
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) collectLists(g.getChildAt(i), out);
            }
        } catch (Throwable t) {
        }
    }

    private static Object findRecycler(View v) {
        try {
            String cn = v.getClass().getName();
            if (cn.contains("RecyclerView")) return v;
            if (v instanceof ViewGroup) {
                ViewGroup g = (ViewGroup) v;
                for (int i = 0; i < g.getChildCount(); i++) {
                    Object r = findRecycler(g.getChildAt(i));
                    if (r != null) return r;
                }
            }
        } catch (Throwable t) {
        }
        return null;
    }

