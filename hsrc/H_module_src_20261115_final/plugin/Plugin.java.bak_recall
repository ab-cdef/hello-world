    /** 带搜索的联系人选择器（勾选列表） */
    private static void pickPeopleSearch(final android.app.Activity a, final String title, final String cfgKey) {
        try {
            final java.util.List<String[]> contacts = loadContacts();
            if (contacts.isEmpty()) {
                toast("没读到联系人，请先在聊天页收发一条消息");
                return;
            }
            final java.util.LinkedHashSet<String> sel = new java.util.LinkedHashSet<String>();
            org.json.JSONArray cur = cfg().optJSONArray(cfgKey);
            if (cur != null) for (int i = 0; i < cur.length(); i++) sel.add(cur.optString(i));

            final android.app.Dialog dlg = new android.app.Dialog(a);
            dlg.requestWindowFeature(android.view.Window.FEATURE_NO_TITLE);
            android.widget.LinearLayout rootL = new android.widget.LinearLayout(a);
            rootL.setOrientation(android.widget.LinearLayout.VERTICAL);
            rootL.setBackgroundColor(0xFFFFFFFF);
            int pad = 28;
            rootL.setPadding(pad, pad, pad, pad);

            final android.widget.TextView tTitle = new android.widget.TextView(a);
            tTitle.setText(title + "  (已选 0)");
            tTitle.setTextColor(0xFF111114);
            tTitle.setTextSize(17);
            tTitle.setPadding(0, 0, 0, 16);
            rootL.addView(tTitle);

            final android.widget.EditText et = new android.widget.EditText(a);
            et.setHint("搜索昵称或备注");
            et.setSingleLine(true);
            et.setTextColor(0xFF111114);
            et.setHintTextColor(0xFF6B6B76);
            et.setBackgroundColor(0xFFEDEDF2);
            et.setPadding(24, 18, 24, 18);
            rootL.addView(et);

            final java.util.List<Integer> shown = new java.util.ArrayList<Integer>();
            final android.widget.ArrayAdapter<String> ad = new android.widget.ArrayAdapter<String>(
                    a, android.R.layout.simple_list_item_multiple_choice) {
                @Override
                public View getView(int position, View convertView, android.view.ViewGroup parent) {
                    View v = super.getView(position, convertView, parent);
                    if (v instanceof android.widget.TextView) {
                        android.widget.TextView tv = (android.widget.TextView) v;
                        tv.setTextColor(0xFF111114);
                        tv.setTextSize(15);
                        tv.setPadding(24, 26, 24, 26);
                    }
                    return v;
                }
            };
            final android.widget.ListView lv = new android.widget.ListView(a);
            lv.setChoiceMode(android.widget.ListView.CHOICE_MODE_MULTIPLE);
            lv.setBackgroundColor(0xFFFFFFFF);
            lv.setDivider(new android.graphics.drawable.ColorDrawable(0xFFE0E0E6));
            lv.setDividerHeight(1);
            lv.setAdapter(ad);
            rootL.addView(lv, new android.widget.LinearLayout.LayoutParams(
                    android.view.ViewGroup.LayoutParams.MATCH_PARENT, 900));

            final Runnable rebuild = new Runnable() {
                @Override
                public void run() {
                    String q = et.getText().toString().trim().toLowerCase();
                    shown.clear();
                    ad.clear();
                    for (int i = 0; i < contacts.size(); i++) {
                        String[] c = contacts.get(i);
                        String disp = c[1];
                        String u = c[0];
                        if (q.length() > 0
                                && !disp.toLowerCase().contains(q)
                                && !u.toLowerCase().contains(q)) continue;
                        shown.add(i);
                        ad.add(disp);
                    }
                    ad.notifyDataSetChanged();
                    for (int k = 0; k < shown.size(); k++) {
                        lv.setItemChecked(k, sel.contains(contacts.get(shown.get(k))[0]));
                    }
                    tTitle.setText(title + "  (已选 " + sel.size() + ")");
                }
            };

            lv.setOnItemClickListener(new android.widget.AdapterView.OnItemClickListener() {
                @Override
                public void onItemClick(android.widget.AdapterView<?> parent, View view, int position, long id) {
                    if (position < 0 || position >= shown.size()) return;
                    String u = contacts.get(shown.get(position))[0];
                    if (sel.contains(u)) sel.remove(u);
                    else sel.add(u);
                    tTitle.setText(title + "  (已选 " + sel.size() + ")");
                }
            });

            et.addTextChangedListener(new android.text.TextWatcher() {
                public void beforeTextChanged(CharSequence s, int st, int c, int af) {
                }

                public void onTextChanged(CharSequence s, int st, int b, int c) {
                }

                public void afterTextChanged(android.text.Editable s) {
                    rebuild.run();
                }
            });

            android.widget.LinearLayout bar = new android.widget.LinearLayout(a);
            bar.setOrientation(android.widget.LinearLayout.HORIZONTAL);
            bar.setPadding(0, 16, 0, 0);
            android.widget.Button bAll = new android.widget.Button(a);
            bAll.setText("全选");
            bAll.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    for (int k : shown) sel.add(contacts.get(k)[0]);
                    rebuild.run();
                }
            });
            android.widget.Button bNone = new android.widget.Button(a);
            bNone.setText("清空");
            bNone.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    sel.clear();
                    rebuild.run();
                }
            });
            android.widget.Button bOk = new android.widget.Button(a);
            bOk.setText("保存");
            bOk.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    try {
                        JSONObject o = readCfg();
                        org.json.JSONArray arr = new org.json.JSONArray();
                        for (String u : sel) arr.put(u);
                        o.put(cfgKey, arr);
                        writeCfg(o);
                        cfgAt = 0;
                        dlg.dismiss();
                        toast("已保存 " + arr.length() + " 人");
                        showSettings(a);
                    } catch (Throwable t) {
                        toast("保存失败");
                    }
                }
            });
            android.widget.Button bTag = new android.widget.Button(a);
            bTag.setText("按标签导入");
            bTag.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    importFromTag(a, sel, tTitle, title);
                }
            });
            bar.addView(bTag, new android.widget.LinearLayout.LayoutParams(0, -2, 1));
            android.widget.Button bGrp = new android.widget.Button(a);
            bGrp.setText("从群导入");
            bGrp.setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    importFromGroup(a, sel, lv, ad, shown, contacts, tTitle, title);
                }
            });
            bar.addView(bGrp, new android.widget.LinearLayout.LayoutParams(0, -2, 1));
            bar.addView(bAll, new android.widget.LinearLayout.LayoutParams(0, -2, 1));
            bar.addView(bNone, new android.widget.LinearLayout.LayoutParams(0, -2, 1));
            bar.addView(bOk, new android.widget.LinearLayout.LayoutParams(0, -2, 1));
            rootL.addView(bar);

            dlg.setContentView(rootL);
            dlg.setOnShowListener(new android.content.DialogInterface.OnShowListener() {
                @Override
                public void onShow(android.content.DialogInterface d) {
                    try {
                        dlg.getWindow().setBackgroundDrawable(
                                new android.graphics.drawable.ColorDrawable(0xFFFFFFFF));
                    } catch (Throwable t) {
                    }
                }
            });
            rebuild.run();
            dlg.show();
        } catch (Throwable t) {
            log("pickPeopleSearch err " + t);
            toast("面板打开失败");
        }
    }

    /** 按标签导入联系人 */
    private static void importFromTag(final android.app.Activity a, final java.util.Set<String> sel,
                                      final android.widget.TextView tTitle, final String title) {
        try {
            Object handle = msgDbHandle();
            if (handle == null) {
                toast("数据库未就绪");
                return;
            }
            Object cur = handle.getClass().getMethod("B", String.class, String[].class)
                    .invoke(handle, "select labelName,labelID from ContactLabel order by labelName",
                            new String[0]);
            if (cur == null) {
                toast("没有标签");
                return;
            }
            final java.util.List<String> names = new java.util.ArrayList<String>();
            final java.util.List<String> ids = new java.util.ArrayList<String>();
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
            java.lang.reflect.Method gi = cur.getClass().getMethod("getInt", int.class);
            while ((Boolean) mv.invoke(cur)) {
                names.add((String) gs.invoke(cur, 0));
                try {
                    ids.add(String.valueOf((Integer) gi.invoke(cur, 1)));
                } catch (Throwable t) {
                    ids.add("0");
                }
            }
            try {
                cur.getClass().getMethod("close").invoke(cur);
            } catch (Throwable t) {
            }
            if (names.isEmpty()) {
                toast("没有标签");
                return;
            }
            final boolean[] chk = new boolean[names.size()];
            new android.app.AlertDialog.Builder(a)
                    .setTitle("选择标签")
                    .setMultiChoiceItems(names.toArray(new String[0]), chk,
                            new android.content.DialogInterface.OnMultiChoiceClickListener() {
                                @Override
                                public void onClick(android.content.DialogInterface d, int which, boolean isChecked) {
                                    chk[which] = isChecked;
                                }
                            })
                    .setPositiveButton("导入", new android.content.DialogInterface.OnClickListener() {
                        @Override
                        public void onClick(android.content.DialogInterface d, int which) {
                            int added = 0, tags = 0;
                            for (int i = 0; i < chk.length; i++) {
                                if (!chk[i]) continue;
                                tags++;
                                added += importTagMembers(ids.get(i), sel);
                            }
                            toast("导入 " + tags + " 个标签，新增 " + added + " 人");
                            tTitle.setText(title + "  (已选 " + sel.size() + ")");
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) {
            log("importFromTag err " + t);
            toast("标签读取失败");
        }
    }

    private static int importTagMembers(String labelId, java.util.Set<String> sel) {
        int added = 0;
        try {
            Object handle = msgDbHandle();
            if (handle == null) return 0;
            Object cur = handle.getClass().getMethod("B", String.class, String[].class)
                    .invoke(handle, "select username from rcontact where labelIdList like ?",
                            new String[]{"%," + labelId + ",%"});
            if (cur == null) return 0;
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
            while ((Boolean) mv.invoke(cur)) {
                String u = (String) gs.invoke(cur, 0);
                if (u != null && u.length() > 0 && !u.endsWith("@chatroom")) {
                    if (sel.add(u.trim())) added++;
                }
            }
            try {
                cur.getClass().getMethod("close").invoke(cur);
            } catch (Throwable t) {
            }
        } catch (Throwable t) {
            log("importTagMembers err " + t);
        }
        return added;
    }

    /** 从群聊导入成员到选择集合 */
    private static void importFromGroup(final android.app.Activity a, final java.util.Set<String> sel,
                                        final android.widget.ListView lv, final android.widget.ArrayAdapter<String> ad,
                                        final java.util.List<Integer> shown, final java.util.List<String[]> contacts,
                                        final android.widget.TextView tTitle, final String title) {
        try {
            Object handle = msgDbHandle();
            if (handle == null) {
                toast("数据库未就绪");
                return;
            }
            Object cur = handle.getClass().getMethod("B", String.class, String[].class)
                    .invoke(handle, "select username,nickname,conRemark from rcontact "
                            + "where username like '%@chatroom' order by conRemark,nickname", new String[0]);
            if (cur == null) {
                toast("没有群聊");
                return;
            }
            final java.util.List<String> names = new java.util.ArrayList<String>();
            final java.util.List<String> ids = new java.util.ArrayList<String>();
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
            while ((Boolean) mv.invoke(cur)) {
                String u = (String) gs.invoke(cur, 0);
                String n = (String) gs.invoke(cur, 1);
                String r = (String) gs.invoke(cur, 2);
                String disp = (r != null && r.trim().length() > 0) ? r.trim()
                        : ((n != null && n.trim().length() > 0) ? n.trim() : u);
                ids.add(u);
                names.add(disp);
            }
            try {
                cur.getClass().getMethod("close").invoke(cur);
            } catch (Throwable t) {
            }
            if (names.isEmpty()) {
                toast("没有群聊");
                return;
            }
            final boolean[] chk = new boolean[names.size()];
            new android.app.AlertDialog.Builder(a)
                    .setTitle("选择群（导入全部成员）")
                    .setMultiChoiceItems(names.toArray(new String[0]), chk,
                            new android.content.DialogInterface.OnMultiChoiceClickListener() {
                                @Override
                                public void onClick(android.content.DialogInterface d, int which, boolean isChecked) {
                                    chk[which] = isChecked;
                                }
                            })
                    .setPositiveButton("导入", new android.content.DialogInterface.OnClickListener() {
                        @Override
                        public void onClick(android.content.DialogInterface d, int which) {
                            int groups = 0, added = 0;
                            for (int i = 0; i < chk.length; i++) {
                                if (!chk[i]) continue;
                                groups++;
                                added += importGroupMembers(ids.get(i), sel);
                            }
                            toast("导入 " + groups + " 个群，新增 " + added + " 人");
                            tTitle.setText(title + "  (已选 " + sel.size() + ")");
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) {
            log("importFromGroup err " + t);
            toast("导入失败");
        }
    }

    /** 读群成员并加入集合，返回新增数量 */
    private static int importGroupMembers(String chatroomId, java.util.Set<String> sel) {
        int added = 0;
        try {
            Object handle = msgDbHandle();
            if (handle == null) return 0;
            Object cur = handle.getClass().getMethod("B", String.class, String[].class)
                    .invoke(handle, "select memberlist from chatroom where chatroomname=? limit 1",
                            new String[]{chatroomId});
            if (cur == null) return 0;
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
            if ((Boolean) mv.invoke(cur)) {
                String list = (String) gs.invoke(cur, 0);
                if (list != null) {
                    for (String m : list.split(";")) {
                        String u = m.trim();
                        if (u.length() > 0 && !u.endsWith("@chatroom")) {
                            if (sel.add(u)) added++;
                        }
                    }
                }
            }
            try {
                cur.getClass().getMethod("close").invoke(cur);
            } catch (Throwable t) {
            }
        } catch (Throwable t) {
            log("importGroupMembers err " + t);
        }
        return added;
    }

    private static void pickPeople(final android.app.Activity a, final String title, final String cfgKey) {
        try {
            final java.util.List<String[]> contacts = loadContacts();
            if (contacts.isEmpty()) {
                toast("没读到联系人，请先在聊天页收发一条消息");
                return;
            }
            final java.util.List<String> all = new java.util.ArrayList<String>();
            for (String[] c : contacts) all.add(c[0]);
            final java.util.LinkedHashSet<String> sel = new java.util.LinkedHashSet<String>();
            org.json.JSONArray cur = cfg().optJSONArray(cfgKey);
            if (cur != null) {
                for (int i = 0; i < cur.length(); i++) sel.add(cur.optString(i));
            }
            final String[] labels = new String[contacts.size()];
            for (int i = 0; i < contacts.size(); i++) {
                String u = contacts.get(i)[0];
                String d = contacts.get(i)[1];
                labels[i] = d;
            }
            final String[] values = all.toArray(new String[0]);
            final boolean[] checked = new boolean[labels.length];
            for (int i = 0; i < labels.length; i++) checked[i] = sel.contains(values[i]);
            new android.app.AlertDialog.Builder(a)
                    .setTitle(title + "（" + labels.length + "）")
                    .setMultiChoiceItems(labels, checked, new android.content.DialogInterface.OnMultiChoiceClickListener() {
                        @Override
                        public void onClick(android.content.DialogInterface d, int which, boolean isChecked) {
                            checked[which] = isChecked;
                        }
                    })
                    .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                        @Override
                        public void onClick(android.content.DialogInterface d, int which) {
                            try {
                                JSONObject o = readCfg();
                                org.json.JSONArray arr = new org.json.JSONArray();
                                for (int i = 0; i < labels.length; i++) {
                                    if (checked[i]) arr.put(values[i]);
                                }
                                o.put(cfgKey, arr);
                                writeCfg(o);
                                cfgAt = 0;
                                toast("已保存 " + arr.length() + " 人");
                                showSettings(a);
                            } catch (Throwable t) {
                                toast("保存失败");
                            }
                        }
                    })
                    .setNegativeButton("取消", null)
                    .show();
        } catch (Throwable t) {
            log("pickPeople err " + t);
        }
    }

    private static void saveLikeNames(final android.app.Activity a, java.util.LinkedHashSet<String> selected) {
        try {
            JSONObject o = readCfg();
            org.json.JSONArray arr = new org.json.JSONArray();
            for (String n : selected) arr.put(n);
            o.put("snsLikeNames", arr);
            o.put("snsAutoLike", arr.length() > 0);
            writeCfg(o);
            cfgAt = 0;
            toast("已保存 " + arr.length() + " 位好友");
            showSettings(a);
        } catch (Throwable t) {
            toast("保存失败");
        }
    }

    private static void pickFromGroup(final android.app.Activity a, final java.util.LinkedHashSet<String> selected) {
        try {
            final java.util.List<String> groups = loadGroupNames();
            if (groups.isEmpty()) {
                toast("没有读到群聊");
