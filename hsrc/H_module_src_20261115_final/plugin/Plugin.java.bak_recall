        });
    }
    static volatile String weekMdPath = null;

    private static java.util.ArrayList<String> buildWeeklyReview() {
        java.util.ArrayList<String> out = new java.util.ArrayList<String>();
        try {
            long now = System.currentTimeMillis();
            long d7 = now - 7L * 86400000L;
            long since = sinceRaw(d7);

            long total = 0, mine = 0;
            try {
                java.util.List<Object[]> r = queryRows(
                        "select count(*) from message where createTime>=" + since, 1);
                if (!r.isEmpty() && r.get(0)[0] != null) total = Long.parseLong(String.valueOf(r.get(0)[0]));
                java.util.List<Object[]> r2 = queryRows(
                        "select count(*) from message where createTime>=" + since + " and isSend=1", 1);
                if (!r2.isEmpty() && r2.get(0)[0] != null) mine = Long.parseLong(String.valueOf(r2.get(0)[0]));
            } catch (Throwable t) { log("WEEK|count err " + t); }

            java.util.ArrayList<Object[]> top = new java.util.ArrayList<Object[]>();
            try {
                java.util.List<Object[]> r = queryRows(
                        "select talker, count(*) c from message where createTime>=" + since
                                + " group by talker order by c desc limit 5", 2);
                for (Object[] x : r) {
                    if (x[0] == null) continue;
                    int c = 0;
                    try { c = Integer.parseInt(String.valueOf(x[1])); } catch (Throwable ignore) { }
                    top.add(new Object[]{String.valueOf(x[0]), c});
                }
            } catch (Throwable t) { log("WEEK|top err " + t); }

            int newChats = 0;
            try {
                java.util.List<Object[]> fm = queryRows(
                        "select talker, min(createTime) from message group by talker", 2);
                for (Object[] a3 : fm) {
                    if (a3[1] == null) continue;
                    long v = 0;
                    try { v = ctToMs(Long.parseLong(String.valueOf(a3[1]))); } catch (Throwable ignore) { }
                    if (v >= d7) newChats++;
                }
            } catch (Throwable t) { log("WEEK|new err " + t); }

            // @我 未回复（同步内联计算，collectAtMe 是异步的不能用）
            int atMe = 0, atMeUnreplied = 0;
            try {
                String[] me = selfIdNick();
                String myId2 = me[0], myNick2 = me[1];
                java.util.ArrayList<long[]> hits = new java.util.ArrayList<long[]>();
                java.util.ArrayList<String> hitTalkers = new java.util.ArrayList<String>();
                java.util.List<Object[]> rows2 = queryRows(
                        "select talker, content, createTime from message where talker like '%@chatroom'"
                                + " and isSend=0 and createTime>=" + since
                                + " order by createTime desc limit 3000", 3);
                for (Object[] r3 : rows2) {
                    String tk2 = r3[0] == null ? "" : String.valueOf(r3[0]);
                    String c2 = r3[1] == null ? "" : String.valueOf(r3[1]);
                    if (tk2.length() == 0 || c2.length() == 0) continue;
                    boolean hit = false;
                    if (myId2.length() > 0 && c2.contains("<atuserlist>") && c2.indexOf(myId2) >= 0) hit = true;
                    if (!hit && myNick2.length() > 0 && c2.indexOf("@" + myNick2) >= 0) hit = true;
                    if (!hit) continue;
                    long ct2 = 0;
                    try { ct2 = ctToMs(Long.parseLong(String.valueOf(r3[2]))); } catch (Throwable ignore) { }
                    hits.add(new long[]{ct2});
                    hitTalkers.add(tk2);
                    if (hits.size() >= 300) break;
                }
                atMe = hits.size();
                if (atMe > 0) {
                    java.util.HashMap<String, java.util.ArrayList<Long>> tmp2 =
                            new java.util.HashMap<String, java.util.ArrayList<Long>>();
                    java.util.List<Object[]> sent2 = queryRows(
                            "select talker, createTime from message where isSend=1 and talker like '%@chatroom'"
                                    + " and createTime>=" + since + " order by createTime", 2);
                    for (Object[] sr : sent2) {
                        if (sr[0] == null || sr[1] == null) continue;
                        long v = 0;
                        try { v = ctToMs(Long.parseLong(String.valueOf(sr[1]))); } catch (Throwable ignore) { }
                        String t2 = String.valueOf(sr[0]);
                        java.util.ArrayList<Long> l = tmp2.get(t2);
                        if (l == null) { l = new java.util.ArrayList<Long>(); tmp2.put(t2, l); }
                        l.add(v);
                    }
                    int replied = 0;
                    for (int i = 0; i < hits.size(); i++) {
                        long ctMs2 = hits.get(i)[0];
                        java.util.ArrayList<Long> l = tmp2.get(hitTalkers.get(i));
                        if (l == null) continue;
                        long best = Long.MAX_VALUE;
                        for (Long v : l) if (v > ctMs2 && v < best) best = v;
                        if (best != Long.MAX_VALUE && best - ctMs2 <= 86400000L) replied++;
                    }
                    atMeUnreplied = atMe - replied;
                }
            } catch (Throwable t) { log("WEEK|atme err " + t); }

            out.add("消息总量：" + total + " 条（我发出 " + mine + " 条）");
            out.add("本周新增会话：" + newChats + " 个");
            out.add("群里 @我：" + atMe + " 条，其中未回复 " + atMeUnreplied + " 条");
            StringBuilder tb = new StringBuilder("最活跃：");
            for (int i = 0; i < Math.min(3, top.size()); i++) {
                Object[] x = top.get(i);
                if (i > 0) tb.append(" · ");
                tb.append(displayOfTalker(String.valueOf(x[0]))).append(' ').append(x[1]);
            }
            if (top.isEmpty()) tb.append("近 7 天没有消息");
            out.add(tb.toString());

            // 近 14 天消息量曲线（按天分桶，纯文本字符画）
            try {
                java.util.TreeMap<String, Integer> byDay = new java.util.TreeMap<String, Integer>();
                java.text.SimpleDateFormat df =
                        new java.text.SimpleDateFormat("MM-dd", java.util.Locale.US);
                long d14 = now - 14L * 86400000L;
                int pageSize2 = 5000;
                for (int off = 0; ; off += pageSize2) {
                    java.util.List<Object[]> rows = queryRows(
                            "select createTime from message where createTime>=" + sinceRaw(d14)
                                    + " order by createTime limit " + pageSize2 + " offset " + off, 1);
                    if (rows.isEmpty()) break;
                    for (Object[] r0 : rows) {
                        long t0 = 0;
                        try { t0 = ctToMs(Long.parseLong(String.valueOf(r0[0]))); } catch (Throwable ignore) { }
                        if (t0 <= 0) continue;
                        String key = df.format(new java.util.Date(t0));
                        Integer c0 = byDay.get(key);
                        byDay.put(key, c0 == null ? 1 : c0 + 1);
                    }
                    if (rows.size() < pageSize2) break;
                    if (off > 2000000) break;
                }
                if (!byDay.isEmpty()) {
                    int mn = Integer.MAX_VALUE, mx = 0, peak = 0;
                    String peakDay = "";
                    String ramp = "▁▂▃▄▅▆▇█";
                    StringBuilder line = new StringBuilder();
                    for (java.util.Map.Entry<String, Integer> e : byDay.entrySet()) {
                        int v = e.getValue();
                        if (v < mn) mn = v;
                        if (v > mx) { mx = v; peakDay = e.getKey(); }
                    }
                    for (java.util.Map.Entry<String, Integer> e : byDay.entrySet()) {
                        int v = e.getValue();
                        int idx = (mx == mn) ? 3 : (int) Math.round((v - mn) * 7.0 / (mx - mn));
                        if (idx < 0) idx = 0;
                        if (idx > 7) idx = 7;
                        line.append(ramp.charAt(idx));
                    }
                    out.add("消息量曲线（近 " + byDay.size() + " 天）：`" + line + "`  峰值 "
                            + peakDay + " " + mx + " 条");
                }
            } catch (Throwable t) { log("WEEK|curve err " + t); }

            // 群活跃变化：本周 vs 上周（按会话比较，阈值 10 条起算，避免小样本）
            try {
                java.util.HashMap<String, Integer> c7 = new java.util.HashMap<String, Integer>();
                java.util.HashMap<String, Integer> c14 = new java.util.HashMap<String, Integer>();
                java.util.List<Object[]> q7 = queryRows(
                        "select talker, count(*) c from message where createTime>=" + since
                                + " and talker like '%@chatroom' group by talker", 2);
                for (Object[] a7 : q7) {
                    if (a7[0] == null) continue;
                    try { c7.put(String.valueOf(a7[0]), Integer.parseInt(String.valueOf(a7[1]))); }
                    catch (Throwable ignore) { }
                }
                java.util.List<Object[]> q14 = queryRows(
                        "select talker, count(*) c from message where createTime>=" + sinceRaw(now - 14L * 86400000L)
                                + " and talker like '%@chatroom' group by talker", 2);
                for (Object[] a14 : q14) {
                    if (a14[0] == null) continue;
                    try { c14.put(String.valueOf(a14[0]), Integer.parseInt(String.valueOf(a14[1]))); }
                    catch (Throwable ignore) { }
                }
                java.util.ArrayList<Object[]> changes = new java.util.ArrayList<Object[]>();
                for (String tk3 : c14.keySet()) {
                    int prev = c14.get(tk3) - (c7.containsKey(tk3) ? c7.get(tk3) : 0);
                    int cur = c7.containsKey(tk3) ? c7.get(tk3) : 0;
                    if (prev < 10 && cur < 10) continue;
                    String tag = null;
                    if (prev >= 10 && cur > prev * 1.3) tag = "升温";
                    else if (prev >= 10 && cur < prev * 0.6) tag = "降温";
                    if (tag != null) {
                        int pct = prev > 0 ? (int) Math.round((cur - prev) * 100.0 / prev) : 0;
                        changes.add(new Object[]{displayOfTalker(tk3), tag, pct, cur});
                    }
                }
                if (!changes.isEmpty()) {
                    java.util.Collections.sort(changes, new java.util.Comparator<Object[]>() {
                        @Override public int compare(Object[] x, Object[] y) {
                            return Math.abs((Integer) y[2]) - Math.abs((Integer) x[2]);
                        }
                    });
                    StringBuilder cb = new StringBuilder("群活跃变化：");
                    for (int i = 0; i < Math.min(3, changes.size()); i++) {
                        Object[] c4 = changes.get(i);
                        if (i > 0) cb.append(" · ");
                        cb.append(c4[0]).append(' ').append(c4[1])
                          .append('(').append(((Integer) c4[2]) > 0 ? "+" : "").append(c4[2]).append("%)");
                    }
                    out.add(cb.toString());
                } else {
                    out.add("群活跃变化：本周没有明显升温/降温的群");
                }
            } catch (Throwable t) { log("WEEK|trend err " + t); }

            try {
                StringBuilder md = new StringBuilder("# 本周回顾\n\n> "
                        + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
                        .format(new java.util.Date()) + " · 近 7 天\n\n");
                for (String l : out) md.append("- ").append(l).append('\n');
                java.io.File dir = new java.io.File(
                        android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
                dir.mkdirs();
                java.io.File f = new java.io.File(dir, "weekly_"
                        + new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US)
                        .format(new java.util.Date()) + ".md");
                java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
                fo.write(md.toString().getBytes("UTF-8"));
                fo.close();
                weekMdPath = f.getAbsolutePath();
            } catch (Throwable t) { log("WEEK|md err " + t); }
            askShare(new java.io.File(weekMdPath));
            log("WEEK|md=" + weekMdPath);
            log("WEEK|total=" + total + " mine=" + mine + " newChats=" + newChats
                    + " atMe=" + atMe + " atMeUnreplied=" + atMeUnreplied
                    + " top=" + (top.isEmpty() ? "-" : displayOfTalker(String.valueOf(top.get(0)[0]))
                    + ":" + top.get(0)[1]));
        } catch (Throwable t) { log("WEEK|err " + t); }
        return out;
    }

    private static void showWeeklyReview(final android.app.Activity a) {
        toast("正在汇总…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<String> lines = buildWeeklyReview();
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        StringBuilder sb = new StringBuilder();
                        for (String l : lines) sb.append("· ").append(l).append("\n");
                        if (weekMdPath != null) sb.append("\n已保存：").append(weekMdPath);
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("本周回顾（近 7 天）")
                                .setMessage(sb.toString())
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    /* ================= 导出文件索引 =================
     * 扫 Download/wxh 下所有导出产物，按类型分组生成 index.md（含大小、时间），方便找文件。
     */
    private static String humanSize(long b) {
        if (b < 1024) return b + " B";
        if (b < 1024 * 1024) return String.format(java.util.Locale.US, "%.1f KB", b / 1024.0);
        if (b < 1024L * 1024 * 1024) return String.format(java.util.Locale.US, "%.1f MB", b / 1048576.0);
        return String.format(java.util.Locale.US, "%.2f GB", b / 1073741824.0);
    }

    private static void collectFiles(java.io.File d, java.util.List<java.io.File> out, int depth) {
        if (d == null || depth > 4) return;
        java.io.File[] fs;
        try { fs = d.listFiles(); } catch (Throwable t) { return; }
        if (fs == null) return;
        for (java.io.File f : fs) {
            if (f == null) continue;
            if (f.isDirectory()) collectFiles(f, out, depth + 1);
            else if (f.isFile()) out.add(f);
        }
    }

    private static int buildExportIndex(String[] outPath) {
        int n = 0;
        try {
            java.io.File root = new java.io.File(
                    android.os.Environment.getExternalStorageDirectory(), "Download/wxh");
            if (!root.isDirectory()) { log("INDEX|no dir"); return 0; }
            java.util.ArrayList<java.io.File> files = new java.util.ArrayList<java.io.File>();
            collectFiles(root, files, 0);
            n = files.size();

            String[][] groups = {
                    {"CSV 表格", "csv"},
                    {"Markdown 记录", "md"},
                    {"压缩包", "zip"},
                    {"图片", "jpg,png,webp,gif"},
                    {"语音", "amr,mp3,m4a,silk"},
                    {"视频", "mp4,mov"},
                    {"文本/日志", "txt,log,json"},
            };
            java.text.SimpleDateFormat f =
                    new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US);
            StringBuilder md = new StringBuilder();
            long totalBytes = 0;
            for (java.io.File x : files) totalBytes += x.length();
            md.append("# 导出文件索引\n\n");
            md.append("> 生成时间：").append(f.format(new java.util.Date()))
              .append(" · 目录：`Download/wxh` · 共 ").append(n).append(" 个文件，")
              .append(humanSize(totalBytes)).append("\n\n");

            java.util.HashSet<java.io.File> used = new java.util.HashSet<java.io.File>();
            for (String[] g : groups) {
                String[] exts = g[1].split(",");
                java.util.ArrayList<java.io.File> hit = new java.util.ArrayList<java.io.File>();
                for (java.io.File x : files) {
                    if (used.contains(x)) continue;
                    String nm = x.getName().toLowerCase(java.util.Locale.US);
                    for (String e : exts) {
                        if (nm.endsWith("." + e)) { hit.add(x); used.add(x); break; }
                    }
                }
                if (hit.isEmpty()) continue;
                java.util.Collections.sort(hit, new java.util.Comparator<java.io.File>() {
                    @Override public int compare(java.io.File a2, java.io.File b2) {
                        return Long.compare(b2.lastModified(), a2.lastModified());
                    }
                });
                md.append("## ").append(g[0]).append("（").append(hit.size()).append("）\n\n");
                int lim = Math.min(hit.size(), 200);
                for (int i = 0; i < lim; i++) {
                    java.io.File x = hit.get(i);
                    String rel = x.getAbsolutePath();
                    if (rel.startsWith(root.getAbsolutePath())) rel = rel.substring(root.getAbsolutePath().length() + 1);
                    md.append("- `").append(rel).append("` · ").append(humanSize(x.length()))
                      .append(" · ").append(f.format(new java.util.Date(x.lastModified()))).append('\n');
                }
                if (hit.size() > lim) md.append("\n> 还有 ").append(hit.size() - lim).append(" 个未列出\n");
                md.append('\n');
            }
            java.util.ArrayList<java.io.File> other = new java.util.ArrayList<java.io.File>();
            for (java.io.File x : files) if (!used.contains(x)) other.add(x);
            if (!other.isEmpty()) {
                md.append("## 其他（").append(other.size()).append("）\n\n");
                int lim = Math.min(other.size(), 100);
                for (int i = 0; i < lim; i++) {
                    java.io.File x = other.get(i);
                    String rel = x.getAbsolutePath();
                    if (rel.startsWith(root.getAbsolutePath())) rel = rel.substring(root.getAbsolutePath().length() + 1);
                    md.append("- `").append(rel).append("` · ").append(humanSize(x.length())).append('\n');
                }
                md.append('\n');
            }

            java.io.File out = new java.io.File(root, "index.md");
            java.io.FileOutputStream fo = new java.io.FileOutputStream(out);
            fo.write(md.toString().getBytes("UTF-8"));
            fo.close();
            if (outPath != null && outPath.length > 0) outPath[0] = out.getAbsolutePath();
            askShare(out);
            log("INDEX|files=" + n + " size=" + humanSize(totalBytes) + " path=" + out.getAbsolutePath());
        } catch (Throwable t) { log("INDEX|err " + t); }
        return n;
    }

    private static void runExportIndex(final android.app.Activity a) {
        toast("正在生成索引…");
        new Thread(new Runnable() {
            @Override public void run() {
                final String[] path = new String[1];
                final int n = buildExportIndex(path);
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        new android.app.AlertDialog.Builder(a)
                                .setTitle("索引已生成")
                                .setMessage("共 " + n + " 个文件\n\n" + (path[0] == null ? "写入失败" : path[0]))
                                .setPositiveButton("好", null).show();
                    }
                });
            }
        }).start();
    }

    /* ================= 聊天记录导出为 Markdown ================= */
    private interface ChatPick { void onPick(String talker, String name); }

    private static void rememberTalker(String tk, String nm) {
        try {
            setStrCfg("lastExportTalker", tk == null ? "" : tk);
            setStrCfg("lastExportName", nm == null ? "" : nm);
        } catch (Throwable ignore) { }
    }

    /** 通用会话选择器：顶部带「上次选过」快捷项 */
    /** 多选回调 */
    private interface ChatPickMulti { void onPick(java.util.ArrayList<String[]> sel); }

    private static java.util.HashMap<String, String> pickNameMap = null;
    private static long pickNameAt = 0;

    /** 一次性把 username->显示名 建表，避免逐行查库 */
    private static java.util.HashMap<String, String> pickNameMap() {
        long now = System.currentTimeMillis();
        if (pickNameMap != null && now - pickNameAt < 60000) return pickNameMap;
        java.util.HashMap<String, String> m = new java.util.HashMap<String, String>();
        try {
            java.util.List<Object[]> rows = queryRows(
                    "select username, ifnull(conRemark,''), ifnull(nickname,'') from rcontact limit 3000", 3);
            for (Object[] r : rows) {
                if (r[0] == null) continue;
                String u = String.valueOf(r[0]);
                String rm = r[1] == null ? "" : String.valueOf(r[1]).trim();
                String nk = r[2] == null ? "" : String.valueOf(r[2]).trim();
                String nm = rm.length() > 0 ? rm : nk;
                if (nm.length() > 0) m.put(u, nm);
            }
        } catch (Throwable ignore) { }
        pickNameMap = m;
        pickNameAt = now;
        return m;
    }

    /** 统一的会话选择器：搜索 + 多选 + 全选 + 取消 */
    private static void showPickDialog(final android.app.Activity a, final String title,
                                       final boolean groupsOnly, final boolean multi,
                                       final java.util.ArrayList<String> preset,
                                       final ChatPick cb, final ChatPickMulti cbMulti) {
        toast("正在读取会话…");
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.ArrayList<String[]> all = new java.util.ArrayList<String[]>();
                try {
                    java.util.HashMap<String, String> names = pickNameMap();
                    log("PICK|names=" + names.size());
                    java.util.HashSet<String> seen = new java.util.HashSet<String>();
                    java.util.List<Object[]> rows = queryRows(
                            "select username from rconversation where username is not null and username != ''"
                                    + (groupsOnly ? " and username like '%@chatroom'" : "")
                                    + " order by conversationTime desc limit 300", 1);
                    for (Object[] r : rows) {
                        String u = r[0] == null ? "" : String.valueOf(r[0]);
                        if (u.length() == 0 || !seen.add(u)) continue;
                        String nm = names.get(u);
                        if (nm == null || nm.length() == 0) nm = u;
                        all.add(new String[]{u, (u.endsWith("@chatroom") ? "群 · " : "") + nm});
                    }
                    if (!groupsOnly) {
                        // 通讯录好友（可能有没聊过的客户）
                        java.util.List<Object[]> fs = queryRows(
                                "select username from rcontact where username not like '%@chatroom'"
                                        + " and username not like 'gh_%' and (ifnull(type,0) & 1) != 0 limit 800", 1);
                        for (Object[] r : fs) {
                            String u = r[0] == null ? "" : String.valueOf(r[0]);
                            if (u.length() == 0 || !seen.add(u)) continue;
                            String nm = names.get(u);
                            if (nm == null || nm.length() == 0) nm = u;
                            all.add(new String[]{u, (u.endsWith("@chatroom") ? "群 · " : "") + nm});
                        }
                    }
                    if (all.isEmpty()) {
                        // 会话表被清空过，退回用消息表里的 talker
                        java.util.List<Object[]> ms = queryRows(
                                "select distinct talker from message where talker is not null"
                                        + (groupsOnly ? " and talker like '%@chatroom'" : "")
                                        + " order by createTime desc limit 300", 1);
                        for (Object[] r : ms) {
                            String u = r[0] == null ? "" : String.valueOf(r[0]);
                            if (u.length() == 0 || !seen.add(u)) continue;
                            if (!groupsOnly && (u.startsWith("gh_") || u.equals("filehelper"))) continue;
                            String nm = names.get(u);
                            if (nm == null || nm.length() == 0) nm = u;
                            all.add(new String[]{u, (u.endsWith("@chatroom") ? "群 · " : "") + nm});
                        }
                        log("PICK|fallback msg talkers=" + all.size());
                    }
                } catch (Throwable t) { log("PICK|load err " + t); }

                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        try {
                            log("PICK|build n=" + all.size());
                            pickCache = all;
                            pickCacheAt = System.currentTimeMillis();
                            buildPickUi(a, title, multi, preset, all, cb, cbMulti);
                        }
                        catch (Throwable t) { log("PICK|ui err " + t); }
                    }
                });
            }
        }).start();
    }

    private static void buildPickUi(final android.app.Activity a, final String title,
                                    final boolean multi, final java.util.ArrayList<String> preset,
                                    final java.util.ArrayList<String[]> all,
                                    final ChatPick cb, final ChatPickMulti cbMulti) {
        final android.app.Dialog[] dd = new android.app.Dialog[1];
        final java.util.HashSet<String> sel = new java.util.HashSet<String>();
        if (preset != null) sel.addAll(preset);

        android.widget.LinearLayout box = new android.widget.LinearLayout(a);
        box.setOrientation(android.widget.LinearLayout.VERTICAL);

        final android.widget.EditText search = new android.widget.EditText(a);
        search.setHint("搜索昵称 / 备注 / 微信号");
        search.setTextSize(15);
        search.setSingleLine(true);
        box.addView(search, new android.widget.LinearLayout.LayoutParams(-1, -2));

        final android.widget.TextView info = new android.widget.TextView(a);
        info.setTextSize(13);
        info.setTextColor(0xFF6B6B76);
        android.widget.LinearLayout bar = new android.widget.LinearLayout(a);
        bar.setOrientation(android.widget.LinearLayout.HORIZONTAL);
        bar.setPadding(dp(a, 8), 0, dp(a, 8), 0);
        android.widget.TextView btnAll = new android.widget.TextView(a);
        btnAll.setText("全选");
        btnAll.setTextSize(14);
        btnAll.setTextColor(0xFF1A6BC8);
        btnAll.setPadding(dp(a, 8), dp(a, 8), dp(a, 8), dp(a, 8));
        android.widget.TextView btnNone = new android.widget.TextView(a);
        btnNone.setText("清空");
        btnNone.setTextSize(14);
        btnNone.setTextColor(0xFF1A6BC8);
        btnNone.setPadding(dp(a, 8), dp(a, 8), dp(a, 8), dp(a, 8));
        bar.addView(btnAll);
        bar.addView(btnNone);
        bar.addView(info, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
        if (multi) box.addView(bar, new android.widget.LinearLayout.LayoutParams(-1, -2));

        // 当前可见（过滤后）的数据
        final java.util.ArrayList<String[]> shown = new java.util.ArrayList<String[]>();
        shown.addAll(all);

        final android.widget.ListView lv = new android.widget.ListView(a);
        lv.setDivider(null);
        lv.setScrollingCacheEnabled(false);
        lv.setAnimationCacheEnabled(false);
        lv.setOverScrollMode(android.view.View.OVER_SCROLL_NEVER);
        box.addView(lv, new android.widget.LinearLayout.LayoutParams(-1, dp(a, 420)));

        final android.graphics.drawable.GradientDrawable dotOn = new android.graphics.drawable.GradientDrawable();
        dotOn.setShape(android.graphics.drawable.GradientDrawable.OVAL);
        dotOn.setColor(0xFF07C160);
        final android.graphics.drawable.GradientDrawable dotOff = new android.graphics.drawable.GradientDrawable();
        dotOff.setShape(android.graphics.drawable.GradientDrawable.OVAL);
        dotOff.setColor(0xFF2E9E5B);

        final android.widget.BaseAdapter adapter = new android.widget.BaseAdapter() {
            @Override public int getCount() { return shown.size(); }
            @Override public Object getItem(int i) { return i >= 0 && i < shown.size() ? shown.get(i) : null; }
            @Override public long getItemId(int i) { return i; }
            @Override public android.view.View getView(int pos, android.view.View convert, android.view.ViewGroup parent) {
                android.widget.LinearLayout row;
                android.widget.TextView nameTv;
                android.view.View dot;
                if (convert instanceof android.widget.LinearLayout) {
                    row = (android.widget.LinearLayout) convert;
                    nameTv = (android.widget.TextView) row.getChildAt(0);
                    dot = row.getChildAt(1);
                } else {
                    row = new android.widget.LinearLayout(a);
                    row.setOrientation(android.widget.LinearLayout.HORIZONTAL);
                    row.setGravity(android.view.Gravity.CENTER_VERTICAL);
                    row.setPadding(dp(a, 10), dp(a, 11), dp(a, 10), dp(a, 11));
                    nameTv = new android.widget.TextView(a);
                    nameTv.setTextSize(15);
                    nameTv.setTextColor(0xFF1A1A1E);
                    row.addView(nameTv, new android.widget.LinearLayout.LayoutParams(0, -2, 1f));
                    dot = new android.view.View(a);
                    row.addView(dot, new android.widget.LinearLayout.LayoutParams(dp(a, 16), dp(a, 16)));
                }
                if (pos < 0 || pos >= shown.size()) return row;
                String[] e = shown.get(pos);
                final String tk = e[0], nm = e[1];
                nameTv.setText(nm);
                dot.setBackground(sel.contains(tk) ? dotOn : dotOff);
                if (!multi) {
                    // 绑定只更新引用，不新建监听器对象
                    row.setOnClickListener(new android.view.View.OnClickListener() {
                        @Override public void onClick(android.view.View v) {
                            if (dd[0] != null) { try { dd[0].dismiss(); } catch (Throwable ignore) { } }
                            rememberTalker(tk, nm);
                            cb.onPick(tk, nm);
                        }
                    });
                }
                return row;
            }
        };
        lv.setAdapter(adapter);
        lv.setOnItemClickListener(new android.widget.AdapterView.OnItemClickListener() {
            @Override public void onItemClick(android.widget.AdapterView<?> pv, android.view.View v, int pos, long id) {
                if (pos < 0 || pos >= shown.size()) return;
                String tk2 = shown.get(pos)[0];
                if (sel.contains(tk2)) sel.remove(tk2); else sel.add(tk2);
                adapter.notifyDataSetChanged();
                info.setText("已选 " + sel.size() + " 个 / 共 " + shown.size());
            }
        });

        final Runnable applyFilter = new Runnable() {
            @Override public void run() {
                try {
                    String kw = search.getText().toString().trim().toLowerCase();
                    shown.clear();
                    if (kw.length() == 0) {
                        shown.addAll(all);
                    } else {
                        for (String[] e : all) {
                            if ((e[1] + " " + e[0]).toLowerCase().contains(kw)) shown.add(e);
                        }
                    }
                    adapter.notifyDataSetChanged();
                    info.setText("已选 " + sel.size() + " 个 / 共 " + shown.size());
                } catch (Throwable t) { log("PICK|filter " + t); }
            }
        };
        applyFilter.run();

        final android.os.Handler sh = new android.os.Handler(android.os.Looper.getMainLooper());
        search.addTextChangedListener(new android.text.TextWatcher() {
            @Override public void beforeTextChanged(CharSequence s2, int st, int c, int af) { }
            @Override public void onTextChanged(CharSequence s2, int st, int b, int c) { }
            @Override public void afterTextChanged(android.text.Editable e) {
                sh.removeCallbacks(applyFilter);
                sh.postDelayed(applyFilter, 200L);
            }
        });
        btnAll.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                for (String[] e : shown) sel.add(e[0]);
                adapter.notifyDataSetChanged();
                info.setText("已选 " + sel.size() + " 个 / 共 " + shown.size());
            }
        });
        btnNone.setOnClickListener(new android.view.View.OnClickListener() {
            @Override public void onClick(android.view.View v) {
                sel.clear();
                adapter.notifyDataSetChanged();
                info.setText("已选 0 个 / 共 " + shown.size());
            }
        });

        final android.app.AlertDialog.Builder b = new android.app.AlertDialog.Builder(a)
                .setTitle(title)
                .setView(box)
                .setNegativeButton("取消", null);
        if (multi) {
            b.setPositiveButton("确定", new android.content.DialogInterface.OnClickListener() {
                @Override public void onClick(android.content.DialogInterface d, int w) {
                    java.util.ArrayList<String[]> out = new java.util.ArrayList<String[]>();
                    for (String[] e : all) {
                        if (sel.contains(e[0])) out.add(e);
                    }
                    for (String x : sel) {
                        boolean has = false;
                        for (String[] e2 : out) if (e2[0].equals(x)) has = true;
                        if (!has) out.add(new String[]{x, displayOfTalker(x)});
                    }
                    if (cbMulti != null) cbMulti.onPick(out);
                }
            });
        }
        dd[0] = b.create();
        dd[0].show();
    }

