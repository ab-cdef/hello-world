    /** 找顶部标题栏容器（ActionBar 容器） */
    /** 图片上叠一层白纱，让整体明度和「白底行块」一致（薄纱效果） */
    private static android.graphics.Bitmap whiteVeil(android.graphics.Bitmap src) {
        try {
            int w = src.getWidth(), h = src.getHeight();
            if (w <= 0 || h <= 0) return src;
            int a = cfg().optInt("veilAlpha", 190);   // 白纱强度，越大越接近行块白
            android.graphics.Bitmap out = android.graphics.Bitmap.createBitmap(
                    w, h, android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas cv = new android.graphics.Canvas(out);
            cv.drawBitmap(src, 0, 0, null);
            android.graphics.Paint pt = new android.graphics.Paint();
            pt.setColor(android.graphics.Color.argb(Math.max(0, Math.min(255, a)), 255, 255, 255));
            cv.drawRect(0, 0, w, h, pt);
            return out;
        } catch (Throwable t) { return src; }
    }

    /** 给主题图叠一层「和图片同色系的薄纱」：取平均色，按 alpha 盖在图上 */
    private static android.graphics.Bitmap tintedVeil(android.graphics.Bitmap src) {
        try {
            int w = src.getWidth(), h = src.getHeight();
            if (w <= 0 || h <= 0) return src;
            long r = 0, g = 0, b = 0; int n = 0;
            int stepX = Math.max(1, w / 24), stepY = Math.max(1, h / 24);
            for (int y = 0; y < h; y += stepY) {
                for (int x = 0; x < w; x += stepX) {
                    int c = src.getPixel(x, y);
                    r += (c >> 16) & 0xFF; g += (c >> 8) & 0xFF; b += c & 0xFF; n++;
                }
            }
            if (n == 0) return src;
            int ar = (int) (r / n), ag = (int) (g / n), ab = (int) (b / n);
            int veil = cfg().optInt("veilAlpha", 120);
            android.graphics.Bitmap out = android.graphics.Bitmap.createBitmap(
                    w, h, android.graphics.Bitmap.Config.ARGB_8888);
            android.graphics.Canvas cv = new android.graphics.Canvas(out);
            cv.drawBitmap(src, 0, 0, null);
            android.graphics.Paint pt = new android.graphics.Paint();
            pt.setColor(android.graphics.Color.argb(Math.min(255, Math.max(0, veil)), ar, ag, ab));
            cv.drawRect(0, 0, w, h, pt);
            log("VEIL|avg=#" + Integer.toHexString((ar << 16) | (ag << 8) | ab) + " a=" + veil);
            return out;
        } catch (Throwable t) { return src; }
    }

    private static android.view.View findHeaderBar(android.view.View v, int depth) {
        if (v == null || depth > 24) return null;
        String cn = v.getClass().getName();
        // 注意：ActionBarOverlayLayout 是整屏容器（高度=屏幕高），不能当标题栏
        if (cn.contains("ActionBarContainer") || cn.endsWith(".Toolbar")
                || cn.endsWith("Toolbar")) {
            if (v.getHeight() > 0 && v.getWidth() > 0) return v;
        }
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View r = findHeaderBar(g.getChildAt(i), depth + 1);
                if (r != null) return r;
            }
        }
        return null;
    }

    /** 找底部 tab 栏容器 */
    private static android.view.View findTabBarSolid(android.view.View v, int depth) {
        if (v == null || depth > 30) return null;
        String cn = v.getClass().getName();
        if (cn.contains("BottomTabView") || cn.contains("LauncherUIBottomTab")) return v;
        if (v instanceof android.view.ViewGroup) {
            android.view.ViewGroup g = (android.view.ViewGroup) v;
            for (int i = 0; i < g.getChildCount(); i++) {
                android.view.View r = findTabBarSolid(g.getChildAt(i), depth + 1);
                if (r != null) return r;
            }
        }
        return null;
    }


