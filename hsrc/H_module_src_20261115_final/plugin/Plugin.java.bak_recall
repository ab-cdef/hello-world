    private static java.util.HashSet<String> hiddenNames() {
        java.util.HashSet<String> out = new java.util.HashSet<String>();
        try {
            org.json.JSONArray arr = cfg().optJSONArray("hideFriends");
            if (arr != null) {
                for (int i = 0; i < arr.length(); i++) {
                    String v = arr.optString(i, "");
                    int bar = v.indexOf('|');
                    String nm = bar >= 0 ? v.substring(bar + 1) : v;
                    if (nm.trim().length() > 0) out.add(nm.trim());
                }
            }
        } catch (Throwable ignore) { }
        return out;
    }

