                                        mid = Long.parseLong(String.valueOf(rm.get(".sysmsg.revokemsg.newmsgid")));
                                    } catch (Throwable t6) {
                                    }
                                    markRevoked(String.valueOf(who), mid);
                                    try { insertSysMsg(String.valueOf(who), mid, "「防撤回」" + rp); } catch (Throwable ignore) { }
                                    reapplyNow();
                                    if (mid > 0 && cfg().optBoolean("recallBackup", true)) {
