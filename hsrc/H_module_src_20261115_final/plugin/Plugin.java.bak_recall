                            StringBuilder sb2 = new StringBuilder();
                            for (int i = 0; i < gv.getChildCount(); i++) {
                                android.view.View ch = gv.getChildAt(i);
                                sb2.append(ch.getClass().getSimpleName()).append("[").append(ch.getWidth())
                                        .append("x").append(ch.getHeight()).append("] ");
                            }
                            log("DLG|decor children " + sb2);
                        }
                    } catch (Throwable ignore) { }
                    try {
                        android.view.View dv = a.getWindow().getDecorView();
                        dv.setFocusableInTouchMode(true);
                        dv.requestFocus();
                    } catch (Throwable ignore) { }
                }
            });
            dlg.show();
        } catch (Throwable t) {
            log("settings dialog err " + t);
