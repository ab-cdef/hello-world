    private static int exportVideoOf(String talker, long sinceMs, java.io.File dir) {
        return exportVideoOfX(talker, sinceMs, dir, false, null);
    }

    private static int exportVideoOfX(String talker, long sinceMs, java.io.File dir, boolean dry, String senderId) {
        int ok = 0, miss = 0, dup = 0;
        try {
            String sql = "select msgSvrId, ifnull(imgPath,''), ifnull(content,''), createTime from message"
                    + " where talker='" + escSql(talker) + "' and (type & 65535)=43"
                    + (sinceMs > 0 ? " and createTime>=" + sinceRaw(sinceMs) : "")
                    + " order by createTime";
            java.util.List<Object[]> rows = queryRows(sql, 4);
            if (rows.isEmpty()) {
                log("MEXP|video no message");
                return 0;
            }

            // 建索引：12 位时间键 -> 缓存文件列表
            java.io.File mm = new java.io.File(mmBase() + "/MicroMsg");
            java.util.HashMap<String, java.util.ArrayList<java.io.File>> idx =
                    new java.util.HashMap<String, java.util.ArrayList<java.io.File>>();
            int scanned = 0;
            try {
                java.io.File[] hs = mm.listFiles();
                if (hs != null) for (java.io.File h : hs) {
                    if (!h.isDirectory()) continue;
                    java.io.File v = new java.io.File(h, "video");
                    if (!v.isDirectory()) continue;
                    java.io.File[] fs = v.listFiles();
                    if (fs == null) continue;
                    for (java.io.File f : fs) {
                        if (f == null || !f.isFile()) continue;
                        String nm = f.getName();
                        if (!isVideoExt(nm)) continue;
                        String k = videoKeyOf(nm);
                        if (k == null) continue;
                        scanned++;
                        String t12 = k.substring(0, 12);
                        java.util.ArrayList<java.io.File> l = idx.get(t12);
                        if (l == null) { l = new java.util.ArrayList<java.io.File>(); idx.put(t12, l); }
                        l.add(f);
                    }
                }
            } catch (Throwable t) { log("MEXP|video scan err " + t); }

            if (idx.isEmpty()) {
                log("MEXP|video no cache files=" + scanned);
                return 0;
            }

            java.text.SimpleDateFormat fmt =
                    new java.text.SimpleDateFormat("yyyyMMdd_HHmmss", java.util.Locale.US);
            java.util.HashSet<String> used = new java.util.HashSet<String>();

            for (Object[] r : rows) {
                if (expCancel) break;
                expSeen++;
                try {
                    long ctRaw = 0;
                    try { ctRaw = Long.parseLong(String.valueOf(r[3])); } catch (Throwable ignore) { }
                    if (ctRaw <= 0) { miss++; continue; }
                    long ct = ctToSec(ctRaw);
                    String content = r[2] == null ? "" : String.valueOf(r[2]);
                    if (!passSender(content, senderId)) continue;

                    // 只认精确命中：消息时间 == 缓存文件名前 12 位（yyMMddHHmmss）
                    java.util.ArrayList<java.io.File> cand = idx.get(videoTimeKey(ct));
                    if (cand == null || cand.isEmpty()) { miss++; expMiss("视频", ctRaw, "缓存里没有这个时间的文件"); continue; }
                    java.io.File src = pickVideo(cand);
                    if (src == null) { dup++; miss++; expMiss("视频", ctRaw, "同秒有多条视频，无法确定是哪条"); continue; }
                    if (!src.isFile() || src.length() < 4096) { miss++; expMiss("视频", ctRaw, "缓存文件损坏"); continue; }
                    if (!used.add(src.getAbsolutePath())) { miss++; expMiss("视频", ctRaw, "同一文件已被前一条占用"); continue; }

                    if (dry) { ok++; expGot++; continue; }

                    String ext = ".mp4";
                    String low = src.getName().toLowerCase(java.util.Locale.US);
                    if (low.endsWith(".mov")) ext = ".mov";
                    else if (low.endsWith(".m4v")) ext = ".m4v";
                    else if (low.endsWith(".ts")) ext = ".ts";
                    String bid = fmt.format(new java.util.Date(ct * 1000L));
                    java.io.File base = new java.io.File(dir, bid + ext);
                    if (alreadyExported(base, src.length())) { expSkip++; continue; }
                    java.io.File dst = base.exists() ? uniqueDst(dir, bid, ext) : base;
                    boolean wrote = false;
                    try {
                        copyFile(src, dst);
                        wrote = true;
                    } catch (Throwable ce) {
                        // 目录被外部删过时 FUSE 会报 EEXIST：换一个名字再试一次
                        try {
                            dst = uniqueDst(dir, bid + "_r", ext);
                            copyFile(src, dst);
                            wrote = true;
                        } catch (Throwable ce2) {
                            log("MEXP|video write fail " + ce2 + " dst=" + dst);
                        }
                    }
                    if (!wrote) { miss++; continue; }
                    ok++;
                    expGot++;
                    log("MEXP|video ok " + src.getName() + " by=" + senderIdOfGroupMsg(content) + " -> " + dst.getName());
                } catch (Throwable te) { miss++; log("MEXP|video row err " + te + " dir=" + dir); }
            }
        } catch (Throwable t) { log("MEXP|video err " + t); }
        log("MEXP|video ok=" + ok + " miss=" + miss + " ambiguous=" + dup);
        return ok;
    }

    /** 无 UI 的真实导出（调试用）：talker|显示名 */
    private static void exportMedia(final android.app.Activity a) {
        final String talker = chatTalker;
        if (talker == null || talker.length() == 0) { toast("请先打开一个聊天"); return; }
        new Thread(new Runnable() {
            @Override public void run() {
                java.util.List<String> urls = new java.util.ArrayList<String>();
                int n = 0;
                try {
                    Object db = dbRef;
                    Object cur = null;
                    for (Method m : db.getClass().getMethods()) {
                        if (!m.getName().equals("rawQuery")) continue;
                        Class<?>[] ps = m.getParameterTypes();
                        if (ps.length != 2 || ps[0] != String.class) continue;
                        Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                        cur = m.invoke(db,
                            "select imgPath from message where talker='" + talker +
                            "' and imgPath is not null and imgPath != '' order by createTime desc limit 500", arg);
                        break;
                    }
                    if (cur != null) {
                        while ((Boolean) cur.getClass().getMethod("moveToNext").invoke(cur)) {
                            String pth = (String) cur.getClass().getMethod("getString", int.class).invoke(cur, 0);
                            if (pth != null && pth.length() > 3) urls.add(pth);
                        }
                        cur.getClass().getMethod("close").invoke(cur);
                    }
                } catch (Throwable t) { log("MEDIA|query err " + t); }
                java.io.File dir = new java.io.File(mmBase() + "/files/media_export");
                dir.mkdirs();
                for (String src : urls) {
                    try {
                        java.io.File f = new java.io.File(src);
                        if (!f.exists()) continue;
                        java.io.File dst = new java.io.File(dir, f.getName());
                        java.io.FileInputStream in = new java.io.FileInputStream(f);
                        java.io.FileOutputStream out = new java.io.FileOutputStream(dst);
                        byte[] buf = new byte[8192];
                        int r;
                        while ((r = in.read(buf)) > 0) out.write(buf, 0, r);
                        in.close(); out.close();
                        n++;
                    } catch (Throwable t) { }
                }
                final int cnt = n;
                toast("已导出 " + cnt + " 个文件\n" + dir.getAbsolutePath());
                log("MEDIA|done " + cnt);
            }
        }).start();
    }


    /** 把当前聊天导出成可直接用浏览器打开的 HTML */
    private static void exportChatHtml(final android.app.Activity a) {
        final String talker = chatTalker;
        if (talker == null || talker.length() == 0) { toast("请先打开一个聊天"); return; }
        new Thread(new Runnable() {
            @Override public void run() {
                StringBuilder sb = new StringBuilder();
                sb.append("<!DOCTYPE html><html><head><meta charset='utf-8'>")
                  .append("<meta name='viewport' content='width=device-width,initial-scale=1'>")
                  .append("<title>聊天记录 ").append(talker).append("</title>")
                  .append("<style>body{background:#f5f5f5;font-family:-apple-system,sans-serif;margin:0;padding:12px}")
                  .append(".m{max-width:76%;margin:8px 0;padding:9px 12px;border-radius:8px;font-size:15px;line-height:1.5;word-break:break-all}")
                  .append(".l{background:#fff;color:#111}.r{background:#95ec69;color:#111;margin-left:auto}")
                  .append(".t{font-size:11px;color:#999;margin:2px 6px}")
                  .append(".recall{color:#c00;font-weight:bold}")
                  .append("</style></head><body>");
                int n = 0;
                try {
                    Object db = dbRef;
                    Object cur = null;
                    for (Method m : db.getClass().getMethods()) {
                        if (!m.getName().equals("rawQuery")) continue;
                        Class<?>[] ps = m.getParameterTypes();
                        if (ps.length != 2 || ps[0] != String.class) continue;
                        Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                        cur = m.invoke(db,
                            "select content,isSend,createTime,type from message where talker='" + talker +
                            "' order by createTime asc limit 3000", arg);
                        break;
                    }
                    if (cur != null) {
                        while ((Boolean) cur.getClass().getMethod("moveToNext").invoke(cur)) {
                            String c = (String) cur.getClass().getMethod("getString", int.class).invoke(cur, 0);
                            int isSend = (Integer) cur.getClass().getMethod("getInt", int.class).invoke(cur, 1);
                            long ct = (Long) cur.getClass().getMethod("getLong", int.class).invoke(cur, 2);
                            if (c == null) c = "";
                            if (c.startsWith("<?xml") || c.startsWith("<msg")) {
                                int t = c.indexOf("<title>");
                                if (t > 0) {
                                    int e = c.indexOf("</title>", t);
                                    if (e > t) c = "[链接] " + c.substring(t + 7, e);
                                    else c = "[卡片消息]";
                                } else c = "[非文本消息]";
                            }
                            boolean recalled = c.contains("（已撤回）");
                            sb.append("<div class='m ").append(isSend == 1 ? "r" : "l")
                              .append(recalled ? " recall" : "").append("'>")
                              .append(esc(c)).append("</div>")
                              .append("<div class='t'>").append(fmt(ct))
                              .append(isSend == 1 ? " 我" : "").append("</div>");
                            n++;
                        }
                        cur.getClass().getMethod("close").invoke(cur);
                    }
                } catch (Throwable t) { log("HTML|err " + t); }
                sb.append("</body></html>");
                final String path = mmBase() + "/files/chat_" +
                        Math.abs(talker.hashCode()) + ".html";
                try {
                    java.io.FileOutputStream fo = new java.io.FileOutputStream(path);
                    fo.write(sb.toString().getBytes("UTF-8"));
                    fo.close();
                } catch (Throwable t) { log("HTML|write err " + t); }
                final int cnt = n;
                toast("已导出 " + cnt + " 条消息\n" + path);
                log("HTML|done " + cnt + " " + path);
            }
        }).start();
    }



    /** 清理微信缓存目录（不动聊天记录数据库） */
    // ================= 自动清理缓存 =================
    private static final java.util.concurrent.atomic.AtomicBoolean autoCleanStarted =
            new java.util.concurrent.atomic.AtomicBoolean(false);

    private static long dirSize(java.io.File f, int depth) {
        if (f == null || depth > 6) return 0;
        try {
            if (f.isFile()) return f.length();
            java.io.File[] cs = f.listFiles();
            if (cs == null) return 0;
            long sum = 0;
            for (java.io.File c : cs) sum += dirSize(c, depth + 1);
            return sum;
        } catch (Throwable t) { return 0; }
    }

    private static long wechatCacheSize() {
        String base = mmBase() + "";
        String[] targets = {base + "/cache", base + "/appbrand", base + "/files/remark", base + "/files/avatar"};
        long sum = 0;
        for (String t : targets) sum += dirSize(new java.io.File(t), 0);
        return sum;
    }

    private static void startAutoClean() {
        if (!autoCleanStarted.compareAndSet(false, true)) return;
        final android.os.Handler h = new android.os.Handler(android.os.Looper.getMainLooper());
        h.postDelayed(new Runnable() {
            @Override public void run() {
                try { autoCleanTick(); } catch (Throwable t) { log("ACLEAN|" + t); }
                try { h.postDelayed(this, 3 * 60 * 60 * 1000L); } catch (Throwable ignore) { }
            }
        }, 90 * 1000L);
    }

    private static void autoCleanTick() {
        if (!cfg().optBoolean("autoClean", false)) return;
        int limitMb = cfg().optInt("autoCleanMb", 300);
        if (limitMb < 50) limitMb = 50;
        long size = wechatCacheSize();
        long limit = (long) limitMb * 1024L * 1024L;
        if (size <= limit) return;
        String base = mmBase() + "";
        String[] targets = {base + "/cache", base + "/appbrand", base + "/files/remark", base + "/files/avatar"};
        long freed = 0;
        int files = 0;
        for (String t : targets) {
            long[] r = wipe(new java.io.File(t), 0);
            freed += r[0];
            files += (int) r[1];
        }
        log("ACLEAN|freed=" + freed + " files=" + files + " before=" + size);
    }

    private static void cleanCache(final android.app.Activity a) {
        new android.app.AlertDialog.Builder(a)
            .setTitle("清理微信缓存")
            .setMessage("将清理以下目录中的文件：\n\n"
                    + "· cache/（临时缓存）\n"
                    + "· appbrand/（小程序缓存）\n"
                    + "· 语音/图片缩略图缓存\n\n"
                    + "不会删除聊天记录、收藏、已保存的图片视频。")
            .setPositiveButton("开始清理", new android.content.DialogInterface.OnClickListener() {
                @Override public void onClick(android.content.DialogInterface d, int w) {
                    new Thread(new Runnable() {
                        @Override public void run() {
                            String base = mmBase() + "";
                            String[] targets = {
                                    base + "/cache",
                                    base + "/appbrand",
                                    base + "/files/remark",
                                    base + "/files/avatar",
                            };
                            long freed = 0;
                            int files = 0;
                            for (String t : targets) {
                                long[] r = wipe(new java.io.File(t), 0);
                                freed += r[0];
                                files += (int) r[1];
                            }
                            final String msg = "已清理 " + files + " 个文件\n释放 " + human(freed);
                            toast(msg);
                            log("CLEAN|" + msg.replace('\n', ' '));
                        }
                    }).start();
                }
            })
            .setNegativeButton("取消", null)
            .show();
    }

    /** 递归删除目录内容（不删目录本身），返回 {字节数, 文件数} */
    private static long[] wipe(java.io.File f, int depth) {
        long bytes = 0;
        int files = 0;
        if (f == null || !f.exists() || depth > 8) return new long[]{bytes, files};
        java.io.File[] list = f.listFiles();
        if (list == null) return new long[]{bytes, files};
        for (java.io.File c : list) {
            try {
                if (c.isDirectory()) {
                    long[] r = wipe(c, depth + 1);
                    bytes += r[0];
                    files += (int) r[1];
                    c.delete();
                } else {
                    long len = c.length();
                    if (c.delete()) {
                        bytes += len;
                        files++;
                    }
                }
            } catch (Throwable t) { }
        }
        return new long[]{bytes, files};
    }

    /** 批量导出所有会话的聊天记录（每个会话一个 txt） */
    private static void exportAllChats(final android.app.Activity a) {
        new android.app.AlertDialog.Builder(a)
            .setTitle("批量导出所有会话")
            .setItems(new String[]{"最近 1 天", "最近 7 天", "最近 30 天", "全部"}, new android.content.DialogInterface.OnClickListener() {
                @Override public void onClick(android.content.DialogInterface d, int w) {
                    long days = w == 0 ? 1 : (w == 1 ? 7 : (w == 2 ? 30 : 3650));
                    doExportAll(a, days);
                }
            })
            .show();
    }

    private static void doExportAll(final android.app.Activity a, final long days) {
        new Thread(new Runnable() {
            @Override public void run() {
                long since = System.currentTimeMillis() / 1000L - days * 86400L;
                java.io.File dir = new java.io.File(mmBase() + "/files/export_all");
                dir.mkdirs();
                int chats = 0, msgs = 0;
                try {
                    Object db = dbRef;
                    java.util.List<String> talkers = new java.util.ArrayList<String>();
                    Object cur = null;
                    for (Method m : db.getClass().getMethods()) {
                        if (!m.getName().equals("rawQuery")) continue;
                        Class<?>[] ps = m.getParameterTypes();
                        if (ps.length != 2 || ps[0] != String.class) continue;
                        Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                        cur = m.invoke(db, "select distinct talker from message where createTime>" + since, arg);
                        break;
                    }
                    if (cur != null) {
                        while ((Boolean) cur.getClass().getMethod("moveToNext").invoke(cur)) {
                            String t = (String) cur.getClass().getMethod("getString", int.class).invoke(cur, 0);
                            if (t != null && t.length() > 0) talkers.add(t);
                        }
                        cur.getClass().getMethod("close").invoke(cur);
                    }
                    for (String tk : talkers) {
                        StringBuilder sb = new StringBuilder();
                        sb.append("# 会话: ").append(tk).append('\n');
                        Object c2 = null;
                        for (Method m : db.getClass().getMethods()) {
                            if (!m.getName().equals("rawQuery")) continue;
                            Class<?>[] ps = m.getParameterTypes();
                            if (ps.length != 2 || ps[0] != String.class) continue;
                            Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                            c2 = m.invoke(db, "select content,isSend,createTime,type from message where talker='"
                                    + tk + "' and createTime>" + since + " order by createTime asc", arg);
                            break;
                        }
                        if (c2 == null) continue;
                        int n = 0;
                        while ((Boolean) c2.getClass().getMethod("moveToNext").invoke(c2)) {
                            String c = (String) c2.getClass().getMethod("getString", int.class).invoke(c2, 0);
                            int isSend = (Integer) c2.getClass().getMethod("getInt", int.class).invoke(c2, 1);
                            long ct = (Long) c2.getClass().getMethod("getLong", int.class).invoke(c2, 2);
                            if (c == null) c = "";
                            if (c.startsWith("<?xml") || c.startsWith("<msg")) c = "[非文本消息]";
                            sb.append('[').append(fmt(ct)).append("] ")
                              .append(isSend == 1 ? "我: " : "对方: ").append(c).append('\n');
                            n++;
                        }
                        c2.getClass().getMethod("close").invoke(c2);
                        if (n > 0) {
                            java.io.FileOutputStream fo = new java.io.FileOutputStream(
                                    new java.io.File(dir, "chat_" + Math.abs(tk.hashCode()) + ".txt"));
                            fo.write(sb.toString().getBytes("UTF-8"));
                            fo.close();
                            chats++;
                            msgs += n;
                        }
                    }
                } catch (Throwable t) { log("EXALL|err " + t); }
                final String msg = "已导出 " + chats + " 个会话\n共 " + msgs + " 条消息\n" + dir.getAbsolutePath();
                toast(msg);
                log("EXALL|done " + chats + " chats " + msgs + " msgs");
            }
        }).start();
    }

    private static android.widget.TextView findTodayTv() {
        try {
            if (todayTv != null && todayTv.getWindowToken() != null) return todayTv;
            android.app.Activity a = chatAct;
            if (a == null) return null;
            android.view.View r = a.getWindow().getDecorView();
            android.view.View v = r.findViewWithTag("wxhTodayText");
            if (v instanceof android.widget.TextView) {
                todayTv = (android.widget.TextView) v;
                return todayTv;
            }
            v = r.findViewWithTag("wxhTodayCount");
            if (v instanceof android.widget.TextView) {
                todayTv = (android.widget.TextView) v;
                return todayTv;
            }
        } catch (Throwable t) { }
        return null;
    }

    private static final Object TODAY_LOCK = new Object();
    private static java.io.File todayCountFile() {
        return new java.io.File(mmBase() + "/files/wxh_today.txt");
    }

    /** 读今日计数（跨进程共享） */
    private static int readTodayCount() {
        try {
            java.io.File f = todayCountFile();
            if (!f.isFile()) return 0;
            java.io.FileInputStream in = new java.io.FileInputStream(f);
            byte[] b = new byte[(int) f.length()];
            int r = in.read(b);
            in.close();
            if (r <= 0) return 0;
            String[] p = new String(b, 0, r, "UTF-8").trim().split("\\|");
            if (p.length < 2) return 0;
            String day = new java.text.SimpleDateFormat("yyyyMMdd").format(new java.util.Date());
            if (!day.equals(p[0])) return 0;
            return Integer.parseInt(p[1]);
        } catch (Throwable t) { return 0; }
    }

    /** 今日计数 +1 并写回，返回新值 */
    private static int bumpTodayCount() {
        synchronized (TODAY_LOCK) {
            int cur = readTodayCount();
            int nv = cur + 1;
            try {
                java.io.FileOutputStream fo = new java.io.FileOutputStream(todayCountFile());
                String day = new java.text.SimpleDateFormat("yyyyMMdd").format(new java.util.Date());
                fo.write((day + "|" + nv).getBytes("UTF-8"));
                fo.close();
            } catch (Throwable t) { log("TODAY|write err " + t); }
            return nv;
        }
    }



    /** 简单查询（依赖 dbRef） */
    /** 列数未知时用这个：按游标真实列数读取 */
    private static java.util.List<Object[]> queryRowsAll(String sql) {
        java.util.List<Object[]> out = new java.util.ArrayList<Object[]>();
        Object db = dbRef;
        if (db == null) { try { ensureDb(); } catch (Throwable ignore) { } db = dbRef; }
        if (db == null) return out;
        Object cur = null;
        try {
            for (java.lang.reflect.Method m : db.getClass().getMethods()) {
                if (!m.getName().equals("rawQuery")) continue;
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length != 2 || ps[0] != String.class) continue;
                Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                cur = m.invoke(db, sql, arg);
                break;
            }
            if (cur == null) return out;
            java.lang.reflect.Method mv = cur.getClass().getMethod("moveToNext");
            java.lang.reflect.Method gs = cur.getClass().getMethod("getString", int.class);
            java.lang.reflect.Method gc = cur.getClass().getMethod("getColumnCount");
            int n = (Integer) gc.invoke(cur);
            while ((Boolean) mv.invoke(cur)) {
                Object[] r = new Object[n];
                for (int i = 0; i < n; i++) {
                    try { r[i] = gs.invoke(cur, i); } catch (Throwable ignore) { }
                }
                out.add(r);
                if (out.size() > 5000) break;
            }
            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
        } catch (Throwable t) { log("QRYA|err " + t + " cause=" + t.getCause()); }
        return out;
    }

    private static java.util.List<Object[]> queryRows(String sql, int cols) {
        java.util.List<Object[]> out = new java.util.ArrayList<Object[]>();
        Object db = dbRef;
        if (db == null) {
            long nowMs = System.currentTimeMillis();
            if (nowMs - lastEnsureDbTry > 2000) {
                lastEnsureDbTry = nowMs;
                try { db = ensureDb(); } catch (Throwable ignore) { }
            }
            db = dbRef;
        }
        if (db == null) return out;
        Object cur = null;
        try {
            for (Method m : db.getClass().getMethods()) {
                if (!m.getName().equals("rawQuery")) continue;
                Class<?>[] ps = m.getParameterTypes();
                if (ps.length != 2 || ps[0] != String.class) continue;
                Object arg = (ps[1] == String[].class) ? new String[0] : new Object[0];
                cur = m.invoke(db, sql, arg);
                break;
            }
            if (cur == null) return out;
            Method mv = cur.getClass().getMethod("moveToNext");
            Method gs = cur.getClass().getMethod("getString", int.class);
            while ((Boolean) mv.invoke(cur)) {
                Object[] r = new Object[cols];
                for (int i = 0; i < cols; i++) {
                    try { r[i] = gs.invoke(cur, i); } catch (Throwable ignore) { }
                }
                out.add(r);
                if (out.size() > 5000) break;
            }
            try { cur.getClass().getMethod("close").invoke(cur); } catch (Throwable ignore) { }
        } catch (Throwable t) { log("QRY|err " + t + " | cause=" + t.getCause()); }
        return out;
    }
    /** 从会话适配器取所有群 */
    /** 群名解析：缓存 → 联系人表 → 兜底 id */
    private static String resolveName(String u) {
        if (u == null) return "";
        String nm = groupNames.get(u);
        if (nm != null && nm.length() > 0 && !nm.equals(u)) return nm;
        if (nameMap != null) {
            String v = nameMap.get(u);
            if (v != null && v.trim().length() > 0) {
                groupNames.put(u, v.trim());
                return v.trim();
            }
        }
        try {
            java.util.List<Object[]> rr = queryRows(
                    "select conRemark, nickname from rcontact where username='" + u + "'", 2);
            if (!rr.isEmpty()) {
                Object v1 = rr.get(0)[0], v2 = rr.get(0)[1];
                if (v1 != null && String.valueOf(v1).trim().length() > 0) nm = String.valueOf(v1).trim();
                else if (v2 != null && String.valueOf(v2).trim().length() > 0) nm = String.valueOf(v2).trim();
            }
        } catch (Throwable ignore) { }
        if (nm == null || nm.length() == 0 || nm.contains("@chatroom")) nm = u;
        if (!nm.equals(u)) groupNames.put(u, nm);
        return nm;
    }
    /** 显示名/群名 → 可跳转的 username；已是 id 就原样返回。跳转前统一过一遍，避免跳错会话 */
    private static String resolveTalker(String raw) {
        if (raw == null) return null;
        String t = raw.trim();
        if (t.length() == 0) return t;
        if (t.endsWith("@chatroom") || t.startsWith("wxid_") || t.startsWith("gh_")
                || t.endsWith("@openim") || t.endsWith("@imopen")) return t;
        if (t.indexOf('@') >= 0 && t.indexOf(' ') < 0) return t;
        String q = t.replace("'", "''");
        try {
            java.util.List<Object[]> r1 = queryRows(
                    "select username from rcontact where username<>'" + q + "' and (conRemark='" + q
                            + "' or nickname='" + q + "') limit 1", 1);
            if (!r1.isEmpty() && r1.get(0)[0] != null) {
                String u = String.valueOf(r1.get(0)[0]);
                if (u.length() > 0) { log("TALKER|" + t + " => " + u); return u; }
            }
            java.util.List<Object[]> r2 = queryRows(
                    "select username from rcontact where (conRemark like '%" + q
                            + "%' or nickname like '%" + q + "%') order by length(conRemark) asc limit 1", 1);
            if (!r2.isEmpty() && r2.get(0)[0] != null) {
                String u2 = String.valueOf(r2.get(0)[0]);
                if (u2.length() > 0) { log("TALKER|" + t + " ~> " + u2); return u2; }
            }
        } catch (Throwable t2) { log("TALKER|err " + t2); }
        log("TALKER|unresolved " + t);
        return t;
    }

    /** 切会话前先判断：目标不是当前会话时，微信会把 intent 丢给现有实例(不跳)，
     *  所以先结束当前聊天页，400ms 后新起目标会话；返回 null 表示调用方不要再 startActivity */
    private static android.content.Intent prepareChatSwitch(final android.app.Activity a,
                                                             final android.content.Intent it) {
        try {
            String t0 = null;
            try { t0 = it.getStringExtra("Chat_User"); } catch (Throwable ignore) { }
            final String t = t0;
            String old = chatTalker;
            if (t == null || t.length() == 0) return it;
            if (old == null || old.length() == 0 || old.equals(t)) return it;
            if (a == null || a.isFinishing()) return it;
            // 微信 ChattingUI 已在前台时，只带 NEW_TASK 的 intent 会被现有实例吞掉（点了不跳）。
            // 必须 NEW_TASK | CLEAR_TASK 清栈重建，才能真的切到目标会话（真机验证有效）。
            it.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK
                    | android.content.Intent.FLAG_ACTIVITY_CLEAR_TASK);
            log("GOTO|switch " + old + " -> " + t);
            return it;
        } catch (Throwable e) { log("GOTO|prep " + e); return it; }
    }


    /** 直接查库补全所有群（不依赖会话列表适配器） */
    private static void fillGroupsFromDb(java.util.List<String[]> out) {
        try {
            java.util.List<Object[]> rows = queryRows(
                    "select username, ifnull(unReadCount,0) from rconversation"
                            + " where username like '%@chatroom' order by conversationTime desc limit 500", 2);
            java.util.HashSet<String> have = new java.util.HashSet<String>();
            for (String[] r0 : out) have.add(r0[0]);
            for (Object[] r0 : rows) {
                String u0 = r0[0] == null ? null : String.valueOf(r0[0]);
                if (u0 == null || !u0.endsWith("@chatroom") || have.contains(u0)) continue;
                have.add(u0);
                String un0 = r0[1] != null ? String.valueOf(r0[1]) : "0";
                out.add(new String[]{u0, resolveName(u0), un0, ""});
            }
            log("CGFILLDB|n=" + out.size());
        } catch (Throwable t) { log("CGFILLDB|err " + t); }
    }

    private static java.util.List<String[]> convGroups() {
        java.util.List<String[]> out = new java.util.ArrayList<String[]>();
        Object ad = lastConvAdapter;
        if (ad == null) { fillGroupsFromDb(out); return out; }
        try {
            Method gc = null, gi = null;
            for (Method m : ad.getClass().getMethods()) {
                if (m.getName().equals("getCount") && m.getParameterTypes().length == 0) gc = m;
                if (m.getName().equals("getItem") && m.getParameterTypes().length == 1
                        && m.getParameterTypes()[0] == int.class) gi = m;
            }
            if (gc == null || gi == null) return out;
            gc.setAccessible(true); gi.setAccessible(true);
            int n = (Integer) gc.invoke(ad);
            for (int i = 0; i < n && i < 500; i++) {
                Object c = null;
                try { c = gi.invoke(ad, i); } catch (Throwable ignore) { continue; }
                if (c == null) continue;
                String u = null;
                try { u = (String) c.getClass().getMethod("h1").invoke(c); } catch (Throwable ignore) { }
                if (u == null || !u.endsWith("@chatroom")) continue;
                if (probeConvOnce.compareAndSet(false, true)) {
                    StringBuilder pb = new StringBuilder();
                    for (Method mm : c.getClass().getMethods()) {
                        if (mm.getParameterTypes().length != 0) continue;
                        if (mm.getReturnType() != String.class) continue;
                        if (mm.getDeclaringClass() == Object.class) continue;
                        try {
                            mm.setAccessible(true);
                            Object rv = mm.invoke(c);
                            if (rv != null && ((String) rv).length() > 0 && ((String) rv).length() < 40) {
                                pb.append(mm.getName()).append('=').append(rv).append(" | ");
                            }
                        } catch (Throwable ignore) { }
                    }
                    log("CONVPROBE|" + pb);
                }
                String nm = groupNames.get(u);
                if (nm == null || nm.length() == 0) {
                    log("CGT|" + u + " dbRef=" + (dbRef != null));
                    if (probeCols.compareAndSet(false, true)) {
                        java.util.List<Object[]> cols = queryRows("PRAGMA table_info(rcontact)", 2);
                        StringBuilder cb = new StringBuilder();
                        for (Object[] cr : cols) cb.append(cr[1]).append(',');
                        log("COLS|" + cb);
                    }
                    java.util.List<Object[]> rr = queryRows(
                        "select nickname, conRemark from rcontact where username='" + u + "'", 2);
                    if (!rr.isEmpty()) {
                        Object v1 = rr.get(0)[0], v2 = rr.get(0)[1];
                        if (v2 != null && String.valueOf(v2).length() > 0) nm = String.valueOf(v2);
                        else if (v1 != null && String.valueOf(v1).length() > 0) nm = String.valueOf(v1);
                    }
                }
                if (nm == null || nm.length() == 0 || nm.contains("@chatroom")) nm = u;
                String unread = "0";
                String lastMsg = "";
                try {
                    java.util.List<Object[]> ur = queryRows(
                        "select unReadCount from rconversation where username='" + u + "'", 1);
                    if (!ur.isEmpty() && ur.get(0)[0] != null) unread = String.valueOf(ur.get(0)[0]);
                    lastMsg = lastMsgOf(u);
                    if (out.size() < 4) log("LM|" + u + "|" + lastMsg);
                } catch (Throwable ignore) { }
                out.add(new String[]{u, nm, unread, lastMsg});
            }
            // 适配器只暴露已加载会话，用数据库补全所有群
            try {
                java.util.HashSet<String> have = new java.util.HashSet<String>();
                for (String[] r0 : out) have.add(r0[0]);
                java.util.List<Object[]> rows = queryRows(
                    "select username, unReadCount from rconversation where username like '%@chatroom'", 2);
                int added = 0;
                for (Object[] r0 : rows) {
                    String u0 = r0[0] == null ? null : String.valueOf(r0[0]);
                    if (u0 == null || !u0.endsWith("@chatroom") || have.contains(u0)) continue;
                    have.add(u0);
                    String un0 = r0.length > 1 && r0[1] != null ? String.valueOf(r0[1]) : "0";
                    out.add(new String[]{u0, resolveName(u0), un0, lastMsgOf(u0)});
                    added++;
                }
                if (added > 0) log("CGFILL|+" + added + " total=" + out.size());
            } catch (Throwable ignore) { }
        } catch (Throwable t) { log("CG|err " + t); }
        return out;
    }


    /** 构建「非群聊」索引映射（后台线程执行，UI 只读结果） */
    private static void rebuildConvMapAsync(final Object ad) {
        if (convBuilding) return;
        convBuilding = true;
        new Thread(new Runnable() {
            @Override public void run() {
                try {
                    java.util.List<Integer> m = new java.util.ArrayList<Integer>();
                    int groups = 0;
                    Method gc = null, gi = null;
                    for (Method mm : ad.getClass().getMethods()) {
                        if (mm.getName().equals("getCount") && mm.getParameterTypes().length == 0) gc = mm;
                        if (mm.getName().equals("getItem") && mm.getParameterTypes().length == 1
                                && mm.getParameterTypes()[0] == int.class) gi = mm;
                    }
                    if (gc == null || gi == null) return;
                    gc.setAccessible(true); gi.setAccessible(true);
                    rebuilding = true;
                    int n;
                    try { n = (Integer) gc.invoke(ad); } finally { rebuilding = false; }
                    if (n > 1000) n = 1000;
                    for (int i = 0; i < n; i++) {
                        Object c = null;
                        try {
                            rebuilding = true;
                            try { c = gi.invoke(ad, i); } finally { rebuilding = false; }
                        } catch (Throwable ignore) { m.add(i); continue; }
                        String u = null;
                        if (c != null) {
                            try { u = (String) c.getClass().getMethod("h1").invoke(c); } catch (Throwable ignore) { }
                        }
                        if (u != null && miyouHidden(u)) continue;   // 密友：不进会话列表（群聊折叠开启时走这里）
                        if (u != null && u.endsWith("@chatroom")) {
                            groups++;
                            if (groupNames.get(u) == null) {
                                String nm = null;
                                try {
                                    Object rv = c.getClass().getMethod("A0").invoke(c);
                                    if (rv instanceof String && ((String) rv).length() > 0
                                            && !((String) rv).contains("@chatroom")) nm = (String) rv;
                                } catch (Throwable ignore) { }
                                if (nm == null) {
                                    java.util.List<Object[]> rr = queryRows(
                                        "select nickname, conRemark from rcontact where username='" + u + "'", 2);
                                    if (!rr.isEmpty()) {
                                        Object v1 = rr.get(0)[0], v2 = rr.get(0)[1];
                                        if (v2 != null && String.valueOf(v2).length() > 0) nm = String.valueOf(v2);
                                        else if (v1 != null && String.valueOf(v1).length() > 0) nm = String.valueOf(v1);
                                    }
                                }
                                if (nm != null) { groupNames.put(u, nm); log("GNC|" + u + "=" + nm); }
                            }
                            continue;
                        }
                        m.add(i);
                    }
                    convMap = m;
                    if (groups > convGroupsTotal) convGroupsTotal = groups;
                    convMapAt = System.currentTimeMillis();
                    log("CM|built n=" + n + " keep=" + m.size() + " groups=" + groups);
                } catch (Throwable t) {
                    log("CM|err " + t);
                } finally {
                    convBuilding = false;
                }
            }
        }).start();
    }

    private static int groupCount() {
        if (convGroupsTotal > 0) return convGroupsTotal;
        return convGroups().size();
    }

    /** 从微信头像缓存加载群头像 */
    private static android.graphics.Bitmap loadAvatarBitmap(String talker) {
        try {
            java.security.MessageDigest md = java.security.MessageDigest.getInstance("MD5");
            byte[] dg = md.digest(talker.getBytes("UTF-8"));
            StringBuilder sb = new StringBuilder();
            for (byte b : dg) sb.append(String.format("%02x", b));
            String h = sb.toString();
            java.io.File mm = new java.io.File(mmBase() + "/MicroMsg");
            java.io.File[] dirs = mm.listFiles();
            if (dirs == null) return null;
            for (java.io.File dir : dirs) {
                if (!dir.isDirectory()) continue;
                java.io.File base = new java.io.File(dir, "avatar/" + h.substring(0, 2) + "/" + h.substring(2, 4));
                java.io.File fh = new java.io.File(base, "user_hd_" + h + ".png");
                if (fh.isFile()) {
                    android.graphics.Bitmap bmp = android.graphics.BitmapFactory.decodeFile(fh.getAbsolutePath());
                    if (bmp != null) return bmp;
                }
                java.io.File f1 = new java.io.File(base, "user_" + h + ".png");
                if (f1.isFile()) return android.graphics.BitmapFactory.decodeFile(f1.getAbsolutePath());
                java.io.File f2 = new java.io.File(base, h + ".png");
                if (f2.isFile()) return android.graphics.BitmapFactory.decodeFile(f2.getAbsolutePath());
                java.io.File f3 = new java.io.File(base, "user_" + h + ".jpg");
                if (f3.isFile()) return android.graphics.BitmapFactory.decodeFile(f3.getAbsolutePath());
                java.io.File hd = new java.io.File(dir, "avatar_hd/" + h.substring(0, 2) + "/" + h.substring(2, 4));
                java.io.File f4 = new java.io.File(hd, "user_" + h + ".png");
                if (f4.isFile()) return android.graphics.BitmapFactory.decodeFile(f4.getAbsolutePath());
                java.io.File f5 = new java.io.File(hd, "user_" + h + ".jpg");
                if (f5.isFile()) return android.graphics.BitmapFactory.decodeFile(f5.getAbsolutePath());
            }
        } catch (Throwable t) { }
        return null;
    }

    /** 群聊总览：像会话列表一样显示所有群 */

    /** 清零会话未读 */
    private static void dbExec(String sql) {
        try {
            Object db = dbRef;
            if (db == null) return;
            Method ex = null;
            for (Method mm : db.getClass().getMethods()) {
                if (mm.getName().equals("execSQL") && mm.getParameterTypes().length >= 1
                        && mm.getParameterTypes()[0] == String.class) { ex = mm; break; }
            }
            if (ex == null) return;
            ex.setAccessible(true);
            Object[] args = new Object[ex.getParameterTypes().length];
            args[0] = sql;
            ex.invoke(db, args);
        } catch (Throwable t) { log("EXEC|err " + t); }
    }

    /** 记录「我读过」的会话，微信把未读写回来时用来自愈 */
    private static void saveReadMark(String talker) {
        try {
            JSONObject o = readCfg();
            JSONObject marks = o.optJSONObject("readMarks");
            if (marks == null) marks = new JSONObject();
            marks.put(talker, System.currentTimeMillis() / 1000L);
            if (marks.length() > 200) {
                java.util.Iterator<String> it = marks.keys();
                java.util.ArrayList<String> all = new java.util.ArrayList<String>();
                while (it.hasNext()) all.add(it.next());
                for (int i = 0; i < all.size() - 200; i++) marks.remove(all.get(i));
            }
            o.put("readMarks", marks);
            writeCfg(o);
            cfg = null;
            cfgAt = 0;
        } catch (Throwable t) { log("MARK|save " + t); }
    }

    /** 清理微信写回的未读（只在没有新消息时归零） */
    private static void applyReadMarks(java.util.List<String[]> gs) {
        try {
            JSONObject o = readCfg();
            JSONObject marks = o.optJSONObject("readMarks");
            if (marks == null || marks.length() == 0) return;
            java.util.Iterator<String> it = marks.keys();
            java.util.ArrayList<String> del = new java.util.ArrayList<String>();
            while (it.hasNext()) {
                String id = it.next();
                long ts = marks.optLong(id, 0);
                if (ts <= 0) { del.add(id); continue; }
                long latest = 0;
                java.util.List<Object[]> q = queryRows(
                        "select max(createTime) from message where talker='" + id + "'", 1);
                if (!q.isEmpty() && q.get(0)[0] != null) {
                    try { latest = Long.parseLong(String.valueOf(q.get(0)[0]).trim()); } catch (Throwable ignore) { }
                }
                if (latest > ts) { del.add(id); continue; }
                dbExec("update rconversation set unReadCount=0 where username='" + id + "'");
                if (gs != null) {
                    for (String[] row : gs) {
                        if (row[0].equals(id) && row.length > 2) row[2] = "0";
                    }
                }
            }
            if (!del.isEmpty()) {
                for (String d : del) marks.remove(d);
                o.put("readMarks", marks);
                writeCfg(o);
                cfg = null;
                cfgAt = 0;
            }
        } catch (Throwable t) { log("MARK|apply " + t); }
    }

    private static void markRead(String talker) {
        try {
            dbExec("update rconversation set unReadCount=0 where username='" + talker + "'");
            java.util.List<Object[]> chk = queryRows(
                    "select unReadCount from rconversation where username='" + talker + "'", 1);
            log("MARK|read " + talker + " after=" + (chk.isEmpty() ? "?" : chk.get(0)[0]));
            saveReadMark(talker);
        } catch (Throwable t) { log("MARK|err " + t); }
    }

    private static android.app.Dialog hubDialog;
    private static java.util.List<String[]> hubGs;
    private static int hubFilter = -1;
    private static boolean hubSelectMode = false;
    private static boolean hubUnreadFirst = false;
    private static boolean hubSortMode = false;
    private static android.widget.TextView dragView;
    private static int dragFrom = -1, dragTarget = -1;
    private static float dragDownX, dragW;
    private static boolean dragJustEnded = false;
    private static final java.util.ArrayList<android.widget.TextView> hubChipViews =
            new java.util.ArrayList<android.widget.TextView>();
    private static final java.util.ArrayList<Integer> hubChipKinds = new java.util.ArrayList<Integer>();
    private static final java.util.ArrayList<String> hubChipNames = new java.util.ArrayList<String>();
    private static final java.util.HashMap<String, Integer> hubUnread = new java.util.HashMap<String, Integer>();
    private static final java.util.HashSet<String> hubSelected = new java.util.HashSet<String>();

    private static org.json.JSONArray foldGroupsOf() {
        try {
            org.json.JSONArray ar = cfg().optJSONArray("foldGroups");
            if (ar == null) ar = new org.json.JSONArray();
            return ar;
        } catch (Throwable t) { return new org.json.JSONArray(); }
    }

    private static java.util.Set<String> idsOfGroup(org.json.JSONArray ar, int idx) {
        java.util.HashSet<String> set = new java.util.HashSet<String>();
        try {
            org.json.JSONObject g = ar.optJSONObject(idx);
            if (g == null) return set;
            org.json.JSONArray ids = g.optJSONArray("ids");
            for (int i = 0; ids != null && i < ids.length(); i++) set.add(ids.getString(i));
        } catch (Throwable ignore) { }
        return set;
    }

    private static java.util.Set<String> allAssigned(org.json.JSONArray ar) {
        java.util.HashSet<String> set = new java.util.HashSet<String>();
        for (int i = 0; i < ar.length(); i++) set.addAll(idsOfGroup(ar, i));
        return set;
    }

    private static void saveFoldGroups(org.json.JSONArray ar) {
        try {
            org.json.JSONObject o = readCfg();
            o.put("foldGroups", ar);
            writeCfg(o);
            cfgAt = 0;
            cfg = null;
        } catch (Throwable t) { log("FG|save " + t); }
    }

    private static android.widget.TextView hubChip(final android.app.Activity a, String txt, boolean on) {
        android.widget.TextView tv = new android.widget.TextView(a);
        tv.setText(txt);
        tv.setTextSize(12);
        tv.setSingleLine(true);
        tv.setEllipsize(android.text.TextUtils.TruncateAt.END);
        tv.setMaxWidth(dp(a, 140));
        tv.setGravity(android.view.Gravity.CENTER);
        tv.setIncludeFontPadding(false);
        tv.setPadding(dp(a, 12), 0, dp(a, 12), 0);
        android.graphics.drawable.GradientDrawable gd = new android.graphics.drawable.GradientDrawable();
        if (on) {
            gd.setColors(new int[]{0xFF07C160, 0xFF06AD56});
            gd.setOrientation(android.graphics.drawable.GradientDrawable.Orientation.LEFT_RIGHT);
        } else {
            gd.setColor(0xFFF3F3F6);
        }
        gd.setCornerRadius(dp(a, 16));
        if (!on) {
            try { gd.setStroke(dp(a, 1), 0xFFE8E8EC); } catch (Throwable ignore) { }
        }
        tv.setBackground(gd);
        tv.setTextColor(on ? 0xFFFFFFFF : 0xFF3C3C43);
        android.widget.LinearLayout.LayoutParams lp = new android.widget.LinearLayout.LayoutParams(
                android.view.ViewGroup.LayoutParams.WRAP_CONTENT, dp(a, 30));
        lp.rightMargin = dp(a, 8);
        tv.setLayoutParams(lp);
        return tv;
    }

    private static void showGroupHub(final android.app.Activity a) {
        new Thread(new Runnable() {
            @Override public void run() {
                final java.util.List<String[]> gs = convGroups();
                a.runOnUiThread(new Runnable() {
                    @Override public void run() {
                        if (gs.isEmpty()) { toast("没有找到群聊"); return; }
                        hubGs = gs;
                        hubSelectMode = false;
                        hubSortMode = false;
                        buildGroupHub(a);
                    }
                });
            }
        }).start();
    }

    private static void dragBegin(android.app.Activity a, android.view.ViewGroup chips,
            java.util.ArrayList<android.widget.TextView> gchips,
            android.widget.TextView v, float rawX) {
        dragView = v;
        dragFrom = gchips.indexOf(v);
        dragTarget = dragFrom;
        dragDownX = rawX;
        dragW = v.getWidth() + dp(a, 6);
        try {
            v.animate().scaleX(1.08f).scaleY(1.08f).alpha(0.95f).setDuration(90).start();
            v.setElevation(dp(a, 10));
        } catch (Throwable ignore) { }

    }

    private static void dragMove(android.app.Activity a, android.view.ViewGroup chips,
            java.util.ArrayList<android.widget.TextView> gchips, float rawX) {
        if (dragView == null) return;
        try {
            dragView.setTranslationX(rawX - dragDownX);
            int[] ploc = new int[2];
            chips.getLocationOnScreen(ploc);
            float localX = rawX - ploc[0];
            int target = dragFrom;
            for (int k = 0; k < gchips.size(); k++) {
                if (k == dragFrom) continue;
                android.widget.TextView c = gchips.get(k);
                float center = c.getLeft() + c.getWidth() / 2f;
                if (k < dragFrom && localX < center) { target = k; break; }
                if (k > dragFrom && localX > center) target = k;
            }
            dragTarget = target;
            for (int k = 0; k < gchips.size(); k++) {
                android.widget.TextView c = gchips.get(k);
                if (c == dragView) continue;
                float want = 0;
                if (dragFrom < dragTarget && k > dragFrom && k <= dragTarget) want = -dragW;
                else if (dragTarget < dragFrom && k >= dragTarget && k < dragFrom) want = dragW;
                if (Math.abs(c.getTranslationX() - want) > 1f) {
                    c.animate().translationX(want).setDuration(110).start();
                }
            }
        } catch (Throwable t) { log("DRAG|move " + t); }
    }

    private static void dragEnd(android.app.Activity a, org.json.JSONArray ar,
            java.util.ArrayList<android.widget.TextView> gchips,
            java.util.ArrayList<Integer> gorder, boolean commit) {
        try {
            if (dragView != null) {
                dragView.animate().scaleX(1f).scaleY(1f).alpha(1f).setDuration(90).start();
                dragView.setElevation(0);
            }
            for (int k = 0; k < gchips.size(); k++) {
                android.widget.TextView c = gchips.get(k);
                if (c != dragView) c.animate().translationX(0).setDuration(110).start();
            }
            if (commit) {
                java.util.ArrayList<Integer> no = new java.util.ArrayList<Integer>(gorder);
                if (dragFrom >= 0 && dragFrom < no.size() && dragTarget >= 0 && dragTarget < no.size()) {
                    Integer mv = no.remove(dragFrom);
                    no.add(dragTarget, mv);
                }
                org.json.JSONArray na = new org.json.JSONArray();
                for (int k = 0; k < no.size(); k++) {
                    try { na.put(ar.getJSONObject(no.get(k))); } catch (Throwable ignore) { }
                }
                saveFoldGroups(na);
                if (hubFilter >= 0) {
                    int ni = no.indexOf(hubFilter);
                    if (ni >= 0) hubFilter = ni;
                }
                toast("分组顺序已保存");
            }
        } catch (Throwable t) { log("DRAG|end " + t); }
        dragView = null;
        dragFrom = -1;
        dragTarget = -1;
    }

    /** 红色未读徽标 */
    public static class BadgeSpan extends android.text.style.ReplacementSpan {
        private final int bg;
        private final float density;
        public BadgeSpan(int bg, float density) { this.bg = bg; this.density = density; }
        @Override public int getSize(android.graphics.Paint paint, CharSequence text, int start, int end, android.graphics.Paint.FontMetricsInt fm) {
            float tw = paint.measureText(text, start, end);
            float h = paint.getTextSize() * 1.15f;
            float w = Math.max(h, tw + 8 * density);
            if (fm != null) { fm.ascent = -(int) (h * 0.72f); fm.descent = (int) (h * 0.28f); }
            return (int) (w + 4 * density);
        }
        @Override public void draw(android.graphics.Canvas canvas, CharSequence text, int start, int end,
                                   float x, int top, int y, int bottom, android.graphics.Paint paint) {
            float tw = paint.measureText(text, start, end);
            float h = paint.getTextSize() * 1.15f;
            float w = Math.max(h, tw + 8 * density);
            float cy = (top + bottom) / 2f;
            android.graphics.Paint p2 = new android.graphics.Paint(paint);
            p2.setAntiAlias(true);
            p2.setStyle(android.graphics.Paint.Style.FILL);
            p2.setColor(bg);
            android.graphics.RectF rf = new android.graphics.RectF(x + 2 * density, cy - h / 2f,
                    x + 2 * density + w, cy + h / 2f);
            canvas.drawRoundRect(rf, h / 2f, h / 2f, p2);
            p2.setColor(0xFFFFFFFF);
            p2.setTextSize(h * 0.72f);
            p2.setTextAlign(android.graphics.Paint.Align.CENTER);
            canvas.drawText(text, start, end, rf.centerX(), cy - (p2.descent() + p2.ascent()) / 2f, p2);
        }
    }

    private static int unreadOfGroup(org.json.JSONArray ar, int idx) {
        int sum = 0;
        java.util.Set<String> ids = idsOfGroup(ar, idx);
        for (String id : ids) {
            Integer v = hubUnread.get(id);
            if (v != null) sum += v;
        }
        return sum;
    }

    private static int unreadAll() {
        int sum = 0;
        for (Integer v : hubUnread.values()) if (v != null) sum += v;
        return sum;
    }

    private static int unreadUnassigned(org.json.JSONArray ar) {
        java.util.Set<String> assigned = allAssigned(ar);
        int sum = 0;
        for (java.util.Map.Entry<String, Integer> e : hubUnread.entrySet()) {
            if (!assigned.contains(e.getKey()) && e.getValue() != null) sum += e.getValue();
        }
        return sum;
    }

    private static void setChipLabel(android.widget.TextView tv, String name, int unread) {
        try {
            if (tv == null) return;
            if (unread <= 0) { tv.setText(name); return; }
            String num = unread > 99 ? "99+" : String.valueOf(unread);
            android.text.SpannableString ss = new android.text.SpannableString(name + " " + num);
            int st = name.length() + 1;
            ss.setSpan(new BadgeSpan(0xFFFA3C3C, tv.getResources().getDisplayMetrics().density),
                    st, ss.length(), android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
            tv.setText(ss);
        } catch (Throwable t) { try { tv.setText(name); } catch (Throwable ignore) { } }
    }

    /** 读完后刷新分组标签红点 */
    private static void refreshGroupBadges(android.app.Activity a) {
        try {
            org.json.JSONArray ar = foldGroupsOf();
            for (int i = 0; i < hubChipViews.size(); i++) {
                android.widget.TextView tv = hubChipViews.get(i);
                if (tv == null) continue;
                int kind = i < hubChipKinds.size() ? hubChipKinds.get(i) : -1;
                String nm = i < hubChipNames.size() ? hubChipNames.get(i) : "";
                int un;
                if (kind == -1) un = unreadAll();
                else if (kind == -2) un = unreadUnassigned(ar);
                else un = unreadOfGroup(ar, kind);
                setChipLabel(tv, nm, un);
            }
        } catch (Throwable t) { log("BADGE|" + t); }
    }

    /** 自动换行布局：分组标签一行放不下就折行，不用横向滑动 */
    public static class FlowLayout extends android.view.ViewGroup {
        private final int colGap;
        private final int rowGap;
        public FlowLayout(android.content.Context c) {
            super(c);
            float d = c.getResources().getDisplayMetrics().density;
            colGap = (int) (8 * d);
            rowGap = (int) (8 * d);
        }
        @Override protected android.view.ViewGroup.LayoutParams generateDefaultLayoutParams() {
            return new android.view.ViewGroup.MarginLayoutParams(
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
                    android.view.ViewGroup.LayoutParams.WRAP_CONTENT);
        }
        @Override public android.view.ViewGroup.LayoutParams generateLayoutParams(android.view.ViewGroup.LayoutParams p) {
            return new android.view.ViewGroup.MarginLayoutParams(p);
        }
        @Override protected boolean checkLayoutParams(android.view.ViewGroup.LayoutParams p) {
            return p instanceof android.view.ViewGroup.MarginLayoutParams;
        }
        private android.view.ViewGroup.MarginLayoutParams mlp(android.view.View c) {
            android.view.ViewGroup.LayoutParams lp = c.getLayoutParams();
            if (lp instanceof android.view.ViewGroup.MarginLayoutParams) return (android.view.ViewGroup.MarginLayoutParams) lp;
            android.view.ViewGroup.MarginLayoutParams m = new android.view.ViewGroup.MarginLayoutParams(lp);
            c.setLayoutParams(m);
            return m;
        }
        /** 按行分组：返回每行的 [起点index, 终点index(不含), 行宽, 行高] */
        private int[] rowsOf(int limit) {
            java.util.ArrayList<Integer> rowIdx = new java.util.ArrayList<Integer>();
            java.util.ArrayList<Integer> rowS = new java.util.ArrayList<Integer>();
            java.util.ArrayList<Integer> rowE = new java.util.ArrayList<Integer>();
            java.util.ArrayList<Integer> rowW = new java.util.ArrayList<Integer>();
            java.util.ArrayList<Integer> rowH = new java.util.ArrayList<Integer>();
            int x = 0, w0 = 0, h0 = 0, startI = -1;
            for (int i = 0; i <= getChildCount(); i++) {
                boolean end = (i == getChildCount());
                android.view.View c = end ? null : getChildAt(i);
                if (!end && (c == null || c.getVisibility() == GONE)) continue;
                int w = 0, hh = 0;
                if (!end) {
                    android.view.ViewGroup.MarginLayoutParams m = mlp(c);
                    w = c.getMeasuredWidth() + m.leftMargin + m.rightMargin;
                    hh = c.getMeasuredHeight() + m.topMargin + m.bottomMargin;
                }
                if (!end && startI < 0) { startI = i; w0 = 0; h0 = 0; }
                if (!end && x > 0 && x + w > limit) {
                    rowS.add(startI); rowE.add(i); rowW.add(w0); rowH.add(h0);
                    startI = i; w0 = 0; h0 = 0; x = 0;
                }
                if (!end) {
                    x += w + colGap;
                    w0 = x - colGap;
                    if (hh > h0) h0 = hh;
                } else if (startI >= 0) {
                    rowS.add(startI); rowE.add(getChildCount()); rowW.add(w0); rowH.add(h0);
                }
            }
            int[] out = new int[rowS.size() * 4];
            for (int k = 0; k < rowS.size(); k++) {
                out[k * 4] = rowS.get(k);
                out[k * 4 + 1] = rowE.get(k);
                out[k * 4 + 2] = rowW.get(k);
                out[k * 4 + 3] = rowH.get(k);
            }
            return out;
        }
        @Override protected void onMeasure(int wSpec, int hSpec) {
            int width = android.view.View.MeasureSpec.getSize(wSpec);
            if (android.view.View.MeasureSpec.getMode(wSpec) == android.view.View.MeasureSpec.UNSPECIFIED) width = 1080;
            int limit = width - getPaddingLeft() - getPaddingRight();
            if (limit < 0) limit = 0;
            for (int i = 0; i < getChildCount(); i++) {
                android.view.View c = getChildAt(i);
                if (c == null || c.getVisibility() == GONE) continue;
                c.measure(android.view.View.MeasureSpec.makeMeasureSpec(limit, android.view.View.MeasureSpec.AT_MOST),
                        android.view.View.MeasureSpec.makeMeasureSpec(0, android.view.View.MeasureSpec.UNSPECIFIED));
            }
            int[] rows = rowsOf(limit);
            int h = getPaddingTop() + getPaddingBottom();
            for (int k = 0; k < rows.length / 4; k++) {
                h += rows[k * 4 + 3];
                if (k > 0) h += rowGap;
            }
            int height = (android.view.View.MeasureSpec.getMode(hSpec) == android.view.View.MeasureSpec.EXACTLY)
                    ? android.view.View.MeasureSpec.getSize(hSpec) : h;
            setMeasuredDimension(width, height);
        }
        @Override protected void onLayout(boolean changed, int l, int t, int r, int b) {
            int limit = getWidth() - getPaddingLeft() - getPaddingRight();
            int[] rows = rowsOf(limit);
            int y = getPaddingTop();
            for (int k = 0; k < rows.length / 4; k++) {
                int s0 = rows[k * 4], e0 = rows[k * 4 + 1], rowH = rows[k * 4 + 3];
                int x = getPaddingLeft();
                for (int i = s0; i < e0; i++) {
                    android.view.View c = getChildAt(i);
                    if (c == null || c.getVisibility() == GONE) continue;
                    android.view.ViewGroup.MarginLayoutParams m = mlp(c);
                    int cw = c.getMeasuredWidth(), chh = c.getMeasuredHeight();
                    // 行内垂直居中，行高统一
                    int top = y + (rowH - (chh + m.topMargin + m.bottomMargin)) / 2 + m.topMargin;
                    c.layout(x + m.leftMargin, top, x + m.leftMargin + cw, top + chh);
                    x += cw + m.leftMargin + m.rightMargin + colGap;
                }
                y += rowH + rowGap;
            }
        }
    }

    /** 按当前分组过滤重建弹窗 */
    private static void buildGroupHub(final android.app.Activity a) {
        final java.util.List<String[]> gs = hubGs;
        if (gs == null || gs.isEmpty()) { toast("没有找到群聊"); return; }
        if (hubDialog != null) {
            try { hubDialog.dismiss(); } catch (Throwable ignore) { }
            hubDialog = null;
        }
        final org.json.JSONArray ar = foldGroupsOf();
        if (hubFilter >= ar.length()) hubFilter = -1;

        hubChipViews.clear();
        hubChipKinds.clear();
        hubChipNames.clear();
        hubUnread.clear();
        org.json.JSONObject hubMarks = null;
        try { hubMarks = readCfg().optJSONObject("readMarks"); } catch (Throwable ignore) { }
        for (int i = 0; i < gs.size(); i++) {
            int un0 = 0;
            try { if (gs.get(i).length > 2) un0 = Integer.parseInt(gs.get(i)[2]); } catch (Throwable ignore) { }
            try {
                if (hubMarks != null && hubMarks.has(gs.get(i)[0])) un0 = 0;
            } catch (Throwable ignore) { }
            hubUnread.put(gs.get(i)[0], un0);
        }
        java.util.Set<String> members = hubFilter >= 0 ? idsOfGroup(ar, hubFilter) : null;
        java.util.Set<String> assigned = allAssigned(ar);
