    private static void askKeywords(final android.app.Activity a) {
        final android.widget.EditText et = new android.widget.EditText(a);
        org.json.JSONArray kw = cfg().optJSONArray("keywordAlert");
        StringBuilder sb = new StringBuilder();
        if (kw != null) {
            for (int i = 0; i < kw.length(); i++) {
                if (sb.length() > 0) sb.append(',');
                sb.append(kw.optString(i));
            }
        }
        et.setText(sb.toString());
        et.setHint("多个关键词用英文逗号分隔");
        new android.app.AlertDialog.Builder(a)
                .setTitle("关键词提醒")
                .setView(et)
                .setPositiveButton("保存", new android.content.DialogInterface.OnClickListener() {
                    @Override
                    public void onClick(android.content.DialogInterface d, int which) {
                        try {
                            JSONObject o = readCfg();
                            org.json.JSONArray arr = new org.json.JSONArray();
                            for (String k : et.getText().toString().split(",")) {
                                String t2 = k.trim();
                                if (t2.length() > 0) arr.put(t2);
                            }
                            o.put("keywordAlert", arr);
                            writeCfg(o);
                            cfgAt = 0;
                            showSettings(a);
                        } catch (Throwable t) {
                            toast("保存失败");
                        }
                    }
                })
                .setNegativeButton("取消", null)
                .show();
    }

    private static JSONObject readCfg() {
        try {
            File f = new File(DIR, "wxh_config.json");
            FileInputStream in = new FileInputStream(f);
            byte[] b = new byte[(int) f.length()];
            int got = 0;
            while (got < b.length) {
                int r = in.read(b, got, b.length - got);
                if (r <= 0) break;
                got += r;
            }
            in.close();
            return new JSONObject(new String(b, "UTF-8"));
        } catch (Throwable t) {
            return new JSONObject();
        }
    }

    private static void writeCfg(JSONObject o) {
        File f = new File(DIR, "wxh_config.json");
        try {
            java.io.FileOutputStream fo = new java.io.FileOutputStream(f);
            fo.write(o.toString(2).getBytes("UTF-8"));
            fo.close();
        } catch (Throwable t) {
            log("writeCfg err " + t);
            try {
                f.delete();
                java.io.FileOutputStream fo2 = new java.io.FileOutputStream(f);
                fo2.write(o.toString(2).getBytes("UTF-8"));
                fo2.close();
                log("writeCfg recovered by recreate");
            } catch (Throwable t2) {
                log("writeCfg err2 " + t2);
            }
        }
        // 分身导出于此已移除：配置只保存在本机微信目录
    }

    private static final ThreadLocal<Boolean> skipPlus = new ThreadLocal<Boolean>();

    /** 加号菜单：H 风格 */
    /** 一键清除所有会话未读，返回清除数量 */
    private static int clearAllUnread() {
        int n = 0;
        try {
            java.util.List<Object[]> rows = queryRows(
                    "select username from rconversation where unReadCount>0", 1);
            long now = System.currentTimeMillis() / 1000L;
            JSONObject o = readCfg();
            JSONObject marks = o.optJSONObject("readMarks");
            if (marks == null) marks = new JSONObject();
            for (Object[] r : rows) {
                if (r[0] == null) continue;
                marks.put(String.valueOf(r[0]), now);
                n++;
            }
            if (n > 0) dbExec("update rconversation set unReadCount=0 where unReadCount>0");
            o.put("readMarks", marks);
            writeCfg(o);
            cfg = null;
            cfgAt = 0;
        } catch (Throwable t) { log("CLEARUNREAD|" + t); }
        return n;
    }

