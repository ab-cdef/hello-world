                                log("GROUP_JOIN|" + room + "|" + who);
                                alert("入群申请", String.valueOf(who));
                            }
                        } catch (Throwable t) {
                        }
                    }
                });
                log("hooked w41.u.j7 (group)");
            }
        } catch (Throwable t) {
            log("group err " + t);
        }
    }

    private static void bindDb(Object o, String how) {
        try {
            if (o == null || dbRef != null) return;
            Object pv = o.getClass().getMethod("getPath").invoke(o);
            if (!(pv instanceof String)) return;
            String path = (String) pv;
            if (path == null || !path.contains("EnMicroMsg")) return;
            dbRef = o;
            log("DBREF|" + how + " " + path);
            logTablesAsync(o);
        } catch (Throwable ignore) { }
    }

    private static boolean remarkSelfWrite = false;

    /** 通过好友的瞬间就写备注时间：拦 rcontact 的 insert/update，命中好友行就补日期 */
    private static void installRemarkOnFriend(ClassLoader app) {
        try {
            Class<?> db = Class.forName("com.tencent.wcdb.database.SQLiteDatabase", false, app);
            XC_MethodHook h = new XC_MethodHook() {
                @Override protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (remarkSelfWrite) return;
                        if (p.args == null || p.args.length < 2) return;
                        if (!"rcontact".equals(String.valueOf(p.args[0]))) return;
                        String table = String.valueOf(p.args[0]);
                        if (!"rcontact".equals(table)) return;
                        String u = null;
                        if ("update".equals(p.method.getName()) && p.args.length >= 3) {
                            u = pickUsername(String.valueOf(p.args[2]));
                        }
                        Object vals = p.args[1];
                        if (vals instanceof android.content.ContentValues) {
                            android.content.ContentValues cv = (android.content.ContentValues) vals;
                            if (u == null) { try { u = cv.getAsString("username"); } catch (Throwable ignore) { } }
                            String rk = null;
                            try { rk = cv.getAsString("conRemark"); } catch (Throwable ignore) { }
                            if (rk == null) return;     // 这次写入不涉及备注，说明是加好友动作
                        }
                        if (u == null) return;
                        remarkTagForUser(u);
                    } catch (Throwable ignore) { }
                }
            };
            XposedBridge.hookAllMethods(db, "update", h);
            XposedBridge.hookAllMethods(db, "insert", h);
            log("hooked remarkOnFriend");
        } catch (Throwable t) {
            log("remarkOnFriend err " + t);
        }
    }

    private static String pickUsername(String where) {
        try {
            if (where == null) return null;
            int i = where.indexOf("username=");
            if (i < 0) return null;
            String rest = where.substring(i + 9).trim();
            char q = rest.charAt(0);
            if (q != '\'' && q != '"') return null;
            int e = rest.indexOf(q, 1);
            if (e < 0) return null;
            return rest.substring(1, e);
        } catch (Throwable t) { return null; }
    }

    /** 给单个好友补日期标记（已是好友、且备注里没有该日期才写） */
    private static void remarkTagForUser(String u) {
        if (u == null || u.length() == 0) return;
        if (u.endsWith("@chatroom") || u.startsWith("gh_")) return;
        try {
            JSONObject c = cfg();
            if (c == null || !c.optBoolean("autoRemarkTime", false)) return;
            String tag = autoRemarkDf(c).format(new java.util.Date());
            String probe = tag.trim();
            java.util.List<Object[]> one = queryRows(
                    "select ifnull(conRemark,''), ifnull(nickname,''), ifnull(type,0) from rcontact"
                            + " where username='" + u.replace("'", "''") + "'", 3);
            if (one.isEmpty()) return;
            if ((pl(one.get(0)[2]) & 1) == 0) return;      // 还不是好友
            String rem = String.valueOf(one.get(0)[0]);
            if (probe.length() > 0 && rem.indexOf(probe) >= 0) return;
            String nick = String.valueOf(one.get(0)[1]);
            String base = rem.length() > 0 ? rem : (nick.length() > 0 ? nick : u);
            String sep = tag.startsWith(" ") || tag.startsWith("（") || tag.startsWith("(") ? "" : " ";
            while (base.endsWith(" ")) base = base.substring(0, base.length() - 1);
            String next = base + sep + tag;
            if (next.length() > 32) return;
            remarkSelfWrite = true;
            try {
                execSqlRaw("update rcontact set conRemark='" + next.replace("'", "''")
                        + "' where username='" + u.replace("'", "''") + "'");
            } finally { remarkSelfWrite = false; }
            log("AREMARK|pass " + u + " -> " + next);
            try { refreshChatList(); } catch (Throwable ignore) { }
        } catch (Throwable ignore) { }
    }

    /** 消息防删除 */
    private static void installAntiDelete(ClassLoader app) {
        try {
            Class<?> db = Class.forName("com.tencent.wcdb.database.SQLiteDatabase", false, app);
            XposedBridge.hookAllMethods(db, "delete", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("snsAntiDelete", true)) return;
                        if (p.args.length < 2 || p.args[0] == null) return;
                        String table = String.valueOf(p.args[0]);
                        // 朋友圈防删除：Sns 相关表在删除前先把整行内容落盘（本机留存）
                        String tl = table.toLowerCase();
                        if (tl.contains("sns")) {
                            try { backupSnsRow(p.thisObject, table, p.args); } catch (Throwable ignore) { }
                            // 动态常挂：把删除改成不删，时间线里这条继续挂着
                            if (tl.contains("snsinfo") && cfg().optBoolean("snsKeepAlive", false)) {
                                p.setResult(Integer.valueOf(0));
                                log("SNSKEEP|block delete " + table);
                            }
                            return;
                        }
                        // 普通消息的删除不再拦截：防撤回已保证消息不被撤回抹掉，
                        // 这里拦 DB 会导致自己长按删除也删不掉，反而更难用。
                    } catch (Throwable ignore) { }
                }
            });
            XposedBridge.hookAllMethods(db, "execSQL", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("snsAntiDelete", true)) return;
                        if (p.args.length < 1 || !(p.args[0] instanceof String)) return;
                        String sql = ((String) p.args[0]).trim();
                        String low = sql.toLowerCase();
                        // 朋友圈的删除很多走 execSQL("delete from SnsInfo ...")，这条路径原来漏了
                        if (low.startsWith("delete from") && low.contains("sns")) {
                            String body = sql.substring(sql.toLowerCase().indexOf("from") + 4).trim();
                            String table = body;
                            String where = "";
                            int sp = body.indexOf(' ');
                            if (sp > 0) { table = body.substring(0, sp); where = body.substring(sp + 1).trim(); }
                            if (table.toLowerCase().startsWith("if")) return;   // "if exists" 之类，跳过
                            where = where.replaceFirst("(?i)^where\\s+", "");
                            String[] wargs = null;
                            if (p.args.length > 1 && p.args[1] instanceof Object[]) {
                                Object[] oa = (Object[]) p.args[1];
                                String[] sa = new String[oa.length];
                                for (int i = 0; i < oa.length; i++) sa[i] = oa[i] == null ? null : String.valueOf(oa[i]);
                                wargs = sa;
                            }
                            try { backupSnsRow(p.thisObject, table, new Object[]{table, where, wargs}); }
                            catch (Throwable ignore) { }
                            // 动态常挂：SQL 删除同样拦掉
                            if (table.toLowerCase().contains("snsinfo") && cfg().optBoolean("snsKeepAlive", false)) {
                                p.setResult(null);
                                log("SNSKEEP|block sql " + table);
                            }
                            return;
                        }
                        return;   // 消息删除交给防撤回/原生处理
                    } catch (Throwable ignore) { }
                }
            });
            log("hooked antiDelete");
        } catch (Throwable t) { log("antidel err " + t); }
    }

    private static void installDb(ClassLoader app) {
        try {
            Class<?> db = Class.forName("com.tencent.wcdb.database.SQLiteDatabase", false, app);
            // 任何 rawQuery 都记录 DB 实例，保证 dbRef 尽早可用
            try {
                XposedBridge.hookAllMethods(db, "openDatabase", new XC_MethodHook() {
                    @Override protected void afterHookedMethod(MethodHookParam p) {
                        bindDb(p.getResult(), "openDatabase");
                    }
                });
                try {
                    XposedBridge.hookAllMethods(db, "openOrCreateDatabase", new XC_MethodHook() {
                        @Override protected void afterHookedMethod(MethodHookParam p) {
                            bindDb(p.getResult(), "openOrCreate");
                        }
                    });
                } catch (Throwable ignore) { }
                XposedBridge.hookAllMethods(db, "open", new XC_MethodHook() {
                    @Override protected void afterHookedMethod(MethodHookParam p) {
                        Object r = p.getResult();
                        if (r != null && r != p.thisObject) bindDb(r, "open");
                        else bindDb(p.thisObject, "open2");
                    }
                });
                log("DBHOOK|open hooked");
            } catch (Throwable t) { log("DBHOOK|err " + t); }
            XposedBridge.hookAllMethods(db, "rawQuery", new XC_MethodHook() {
                @Override protected void beforeHookedMethod(MethodHookParam p) {
                    try {
                        if (p.thisObject != null && dbRef == null && !dbProbing) {
                            String path = null;
                            try {
                                Object pv = p.thisObject.getClass().getMethod("getPath").invoke(p.thisObject);
                                if (pv instanceof String) path = (String) pv;
                            } catch (Throwable ignore) { }
                            if (path != null && path.contains("EnMicroMsg")) {
                                dbRef = p.thisObject;
                                log("DBREF|main " + path);
                            } else {
                                // 记下候选（getPath 拿不到时靠后面实探）
                                synchronized (dbCandidates) {
                                    boolean dup = false;
                                    for (Object o : dbCandidates) if (o == p.thisObject) { dup = true; break; }
                                    if (!dup && dbCandidates.size() < 12) dbCandidates.add(p.thisObject);
                                }
                            }
                        }
                    } catch (Throwable ignore) { }
                }
            });
            XC_MethodHook h = new XC_MethodHook() {
                @Override
                protected void beforeHookedMethod(MethodHookParam p) {
                    try {

                        ContentValues cv = null;
                        String table = null;
                        for (Object a : p.args) {
                            if (a instanceof ContentValues) cv = (ContentValues) a;
                            else if (a instanceof String && table == null) table = (String) a;
                        }
                        if (cv == null || table == null) return;
                        if (!table.contains("message")) return;
                        if (p.thisObject != null) {
                            try {
                                Object pv = p.thisObject.getClass().getMethod("getPath").invoke(p.thisObject);
                                if (pv instanceof String && ((String) pv).contains("EnMicroMsg")) {
                                    if (dbRef == null) {
                                        dbRef = p.thisObject;
                                        logTablesAsync(dbRef);
                                        log("DBREF|from insert " + pv);
                                    }
                                }
                            } catch (Throwable ignore) { }
                        }
                        Integer type = cv.getAsInteger("type");
                        String content = cv.getAsString("content");
                        String talker = cv.getAsString("talker");
                        Integer isSend = cv.getAsInteger("isSend");
                        log("DBMSG|pid=" + android.os.Process.myPid() + "|" + table + "|" + type + "|" + isSend + "|" + talker + "|" + (content == null ? 0 : content.length()));
                        // 红包：在去重逻辑之前处理，保证任何情况下都能触发
                        try {
                            if (type != null && type.intValue() == TYPE_REDPACKET
                                    && isSend != null && isSend.intValue() == 0 && content != null) {
                                lastRedPacketContent = content;
                                lastRedPacketIsSend = false;
                                String nm2 = "收到红包";
                                String body2 = "点击查看红包";
                                try {
                                    String[] tb = redPacketTitleBody(content, talker);
                                    if (tb != null && tb.length >= 2 && tb[0] != null) nm2 = tb[0];
                                    if (tb != null && tb.length >= 2 && tb[1] != null) body2 = tb[1];
                                } catch (Throwable ignore) { }
                                // 通知失败绝不能影响抢包
                                try {
                                    if (cfg().optBoolean("redPacketAlert", true)) alert(nm2 + " 的红包", body2);
                                } catch (Throwable ignore) { }
                                log("REDPACKET|" + talker + "|" + nm2 + "|" + body2);
                                log("GRAB|early hit onOpen=" + cfg().optBoolean("autoOpenRedPacket", true));
                                if (cfg().optBoolean("autoOpenRedPacket", true)) grabNow(talker, content);
                                else log("GRAB|skip autoOpen=false");
                                redPktHandledAt = System.currentTimeMillis();
                            }
                        } catch (Throwable t2) { log("GRAB|early err " + t2); }
                        try {
                            if (type != null && (type.intValue() & 0xFFFF) == 10000) {
                                maybeWelcome(talker, content);
                                maybeNoticeChange(talker, content);
                            }
                            if (type != null && (type.intValue() & 0xFFFF) == 1
                                    && isSend != null && isSend.intValue() == 0) {
                                maybeCheckin(talker, content);
                            }
                            if (type != null && (type.intValue() & 0xFFFF) == 49) {
                                maybeFileAlert(talker, content, isSend);
                            }
                        } catch (Throwable ignore) { }
                        // 任意消息入库都顺带扫一下未领红包（90 秒节流），后台也能补抢
                        try {
                            long nowBg2 = System.currentTimeMillis();
                            if (nowBg2 - bgScanAt > 90000L) { bgScanAt = nowBg2; bgGrabScanWhenReady(); }
                        } catch (Throwable ignore) { }
                        try { monitorHit(talker, type, content, isSend, cv.getAsLong("createTime")); }
                        catch (Throwable ignore) { }
                        try { payDumpGhIfNeeded(); } catch (Throwable ignore) { }
                        try { payMaybe(talker, type, isSend, content); }
                        catch (Throwable ignore) { }
                        try { ttsMaybe(talker, type, content, isSend); }
                        catch (Throwable ignore) { }
                        try { autoForward(talker, type, content, isSend,
                                cv.getAsString("imgPath"), cv.getAsLong("msgSvrId")); }
                        catch (Throwable ignore) { }
                        try {
                            if (type != null && (type.intValue() & 0xFFFF) == 49 && content != null
                                    && isSend != null && isSend == 0) {
                                log("GRPFILE|probe len=" + content.length() + " head="
                                        + content.substring(0, Math.min(240, content.length()))
                                                .replace('\n', ' '));
                                String ttl = cleanXmlText(tagOf(content, "title"));
                                String ap = cleanXmlText(tagOf(content, "type"));
                                String ext = cleanXmlText(tagOf(content, "fileext"));
                                boolean isFile = "6".equals(ap) || "74".equals(ap)
                                        || (ext != null && ext.length() > 0);
                                if (isFile && ttl != null && ttl.length() > 0) {
                                    String len = cleanXmlText(tagOf(content, "totallen"));
                                    Long ctL = cv.getAsLong("createTime");
                                    recordGroupFile(talker, content, ttl, len, ctL == null ? 0L : ctL.longValue());
                                }
                            }
                        } catch (Throwable ignore) { }
                        try {
                            if (cfg().optBoolean("autoSaveImg", false) && type != null && type == 3
                                    && isSend != null && isSend == 0 && talker != null) {
                                final String ftk = talker;
                                final Long ct = cv.getAsLong("createTime");
                                new Thread(new Runnable() {
                                    @Override public void run() {
                                        try { autoSaveImage(ftk, ct == null ? 0L : ct.longValue(), content); }
                                        catch (Throwable t) { log("AUTOSAVE|err " + t); }
                                    }
                                }).start();
                            }
                        } catch (Throwable ignore) { }
                        // 群邀请 / 朋友圈评论 探测
                        try {
                            if (content != null && content.length() > 8
                                    && (content.contains("邀请你加入群聊") || content.contains("invite")
                                        || content.contains("comment") || content.contains("snscomment"))) {
                                String low = content.toLowerCase();
                                if (low.contains("sns") || low.contains("comment")) {
                                    log("SNSMSG|" + (content.length() > 600 ? content.substring(0, 600) : content));
                                } else {
                                    log("INVITE|" + (content.length() > 600 ? content.substring(0, 600) : content));
                                }
                            }
                        } catch (Throwable ignore) { }
                        if (talker != null && isSend != null) {
                            try { kickStyleSoon(); } catch (Throwable ignore) { }
                            Long ctVal = cv.getAsLong("createTime");
                            String fp = talker + "|" + isSend + "|" + (ctVal != null ? String.valueOf(ctVal)
                                    : (content == null ? String.valueOf(System.nanoTime()) : content.substring(0, Math.min(40, content.length()))));
                            long nowMs = System.currentTimeMillis();
                            Long prev = lastMsgFp.get(fp);
                            if (prev == null || nowMs - prev > 3000) {
                                lastMsgFp.put(fp, nowMs);
                                if (lastMsgFp.size() > 300) lastMsgFp.clear();
                                int[] cnt = todayCounts.get(talker);
                                if (cnt == null) { cnt = new int[]{0, 0}; todayCounts.put(talker, cnt); }
                                if (isSend.intValue() == 1) {
                                    cnt[0]++;
                                    final int total = bumpTodayCount();
                                    todaySentTotal.set(total);
                                    log("TODAY|inc pid=" + android.os.Process.myPid() + " total=" + total);
                                    if (todayTv != null) {
                                        new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
                                            @Override public void run() {
                                                if (todayTv != null) updateTodayText(total);
                                            }
                                        });
                                    }
                                }
                            }
                        }
                        if (type != null && type.intValue() == 10000) {
                            StringBuilder sb = new StringBuilder("SYSCV|");
                            for (java.util.Map.Entry<String, Object> en : cv.valueSet()) {
                                String v = String.valueOf(en.getValue());
                                if (v.length() > 60) v = v.substring(0, 60);
                                sb.append(en.getKey()).append('=').append(v).append(" | ");
                            }
                            log(sb.toString());
                        }
                        if ((isSend != null && isSend.intValue() == 0) || cfg().optBoolean("keywordIncludeSelf", false)) {
                            if (content == null) return;
                            if (type != null && type.intValue() == 37) {
                                tryAcceptFriend(content, talker);
                                return;
                            }
                            if (type != null && type.intValue() == 1) {
                                lastIncomingText = content;
                                autoReply(talker);
                            }
                            if (cfg().optBoolean("bubbleTransparent", false) && inChat) {
                                try {
                                    final android.app.Activity ba = chatAct;
                                    if (ba != null) ba.runOnUiThread(new Runnable() {
                                        @Override
                                        public void run() {
                                            applyTransparentBubbles(ba);
                                        }
                                    });
                                } catch (Throwable t) {
                                }
                            }
                            if (isCloseFriendEx(talker)) {
                                if (!fresh("close|" + talker + "|" + content.hashCode())) return;
                                closeFriendNotice(talker, content);
                                return;
                            }
                            if (!fresh(table + "|" + talker + "|" + type + "|" + content.hashCode())) return;
                            if (type != null && type.intValue() == TYPE_REDPACKET) {
                                if (System.currentTimeMillis() - redPktHandledAt < 5000L) return;
                                lastRedPacketContent = content;   // 抢包要用到这条原文
                                String nick = extractNick(content);
                                if (nick == null) nick = "";
                                if (nick.trim().length() == 0 || nick.startsWith("wxid_")) {
                                    String dn = displayOfTalker(talker);
                                    nick = (dn != null && dn.length() > 0) ? dn : "";
                                }
                                log("REDPACKET|" + talker + "|" + nick);
                                if (cfg().optBoolean("silentGrab", false)) {
                                    silentGrab(content, talker);
                                }
                                if (cfg().optBoolean("redPacketAlert", true)) {
                                    String[] tb2 = redPacketTitleBody(content, talker);
                                    alert(tb2[0] + " 的红包", tb2[1]);
                                }
                                // 关键：这条路径一定会跑到，抢包从这里发起
                                try {
                                    if (cfg().optBoolean("autoOpenRedPacket", true)) autoOpenPacket(talker);
                                    else log("GRAB|skip autoOpen=false");
                                } catch (Throwable ignore) { }
                                return;
                            }
                            org.json.JSONArray kw = cfg().optJSONArray("keywordAlert");
                            if (kw != null) {
                                for (int i = 0; i < kw.length(); i++) {
                                    String k = kw.optString(i, "");
                                    if (k.length() > 0 && content.contains(k)) {
                                        log("KEYWORD|" + k + "|" + talker + "|" + shortOf(content));
                                        alert("关键词[" + k + "]", shortOf(content));
                                        return;
                                    }
                                }
                            }
                        }
                    } catch (Throwable t) {
                    }
                }
            };
            int n = 0;
            for (Method m : db.getDeclaredMethods()) {
                String nm = m.getName();
                if (nm.equals("insert") || nm.equals("insertWithOnConflict")
                        || nm.equals("insertOrThrow") || nm.equals("replace")
                        || nm.equals("replaceOrThrow")) {
                    m.setAccessible(true);
                    XposedBridge.hookMethod(m, h);
                    n++;
                }
            }
            log("hooked SQLiteDatabase insert x" + n);
            try { startPayScan(); } catch (Throwable ignore) { }
        } catch (Throwable t) {
            log("db err " + t);
        }
    }

    private static void installResProbe(ClassLoader app) {
        try {
            Class<?> res = Class.forName("android.content.res.Resources", false, app);
            XposedBridge.hookAllMethods(res, "getDrawable", new XC_MethodHook() {
                @Override
                protected void afterHookedMethod(MethodHookParam p) {
                    try {
                        if (!cfg().optBoolean("bubbleProbe", false)) return;
                        Object id = p.args[0];
                        if (!(id instanceof Integer)) return;
                        Object self = p.thisObject;
                        String name = (String) res.getMethod("getResourceName", int.class)
                                .invoke(self, (Integer) id);
                        if (name == null) return;
                        if (!inChat) return;
                        Object d = p.getResult();
                        if (d instanceof android.graphics.drawable.NinePatchDrawable) {
                            android.graphics.drawable.Drawable dd = (android.graphics.drawable.Drawable) d;
                            log("RES9|" + Integer.toHexString((Integer) id) + "|" + name
                                    + "|dw=" + dd.getIntrinsicWidth() + "|dh=" + dd.getIntrinsicHeight());
                        }
                    } catch (Throwable t) {
                    }
                }
            });
            log("hooked Resources.getDrawable");
        } catch (Throwable t) {
            log("res probe err " + t);
        }
    }

