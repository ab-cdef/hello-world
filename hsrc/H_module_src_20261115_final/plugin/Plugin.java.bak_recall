                        if (rebuilding) return;
                        Object self = p.thisObject;
                        lastConvAdapter = self;
                        java.util.List<Integer> mp0 = convMap;
                        if (mp0 == null || mp0.isEmpty()
                                || System.currentTimeMillis() - convMapAt > 5000) {
                            rebuildConvMapAsync(self);
                        }
                        if (mp0 == null || mp0.isEmpty()) return;
                        int newCount = mp0.size() + 1;
                        p.setResult(newCount);
                        if (lastConvCount != newCount) {
                            lastConvCount = newCount;
                            final android.app.Activity a0 = chatAct;
                            if (a0 != null) {
                                a0.getWindow().getDecorView().post(new Runnable() {
                                    @Override public void run() {
                                        try {
                                            android.view.View lv0 = findConvListView(a0.getWindow().getDecorView(), 0);
